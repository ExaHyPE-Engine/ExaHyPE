cmake_minimum_required(VERSION 3.27)

{% if CMAKE_C_COMPILER is defined and CMAKE_C_COMPILER != "" -%}
if(NOT DEFINED CMAKE_C_COMPILER)
  set(CMAKE_C_COMPILER "{{CMAKE_C_COMPILER}}")
endif()
{% endif -%}

{% if CMAKE_CXX_COMPILER is defined and CMAKE_CXX_COMPILER != "" -%}
if(NOT DEFINED CMAKE_CXX_COMPILER)
  set(CMAKE_CXX_COMPILER "{{CMAKE_CXX_COMPILER}}")
endif()
{% endif -%}

{% if CMAKE_FORTRAN_COMPILER is defined and CMAKE_FORTRAN_COMPILER != "" -%}
if(NOT DEFINED CMAKE_Fortran_COMPILER)
  set(CMAKE_Fortran_COMPILER "{{CMAKE_FORTRAN_COMPILER}}")
endif()
{% endif -%}

# CMAKE_NOT_USING_CONFIG_FLAGS stops CMake from caching flags for its predefined build types.
set(CMAKE_NOT_USING_CONFIG_FLAGS TRUE)
project({{EXECUTABLENAME}}
  LANGUAGES
    C
    CXX
)

{% if CMAKE_BUILD_DIR is defined and CMAKE_BUILD_DIR != "" -%}
list(APPEND CMAKE_PREFIX_PATH "{{CMAKE_BUILD_DIR}}")
{% endif -%}

file(WRITE "${PROJECT_BINARY_DIR}/.gitignore" "*")

find_package(Peano CONFIG REQUIRED)

{% if FORTRAN_SOURCES or GENERATED_FORTRAN_SOURCES -%}
# Parallel HDF5 requests MPI bindings for every enabled language, so resolve Peano's C and C++
# dependencies before enabling Fortran.
enable_language(Fortran)
if(IPO_SUPPORTED)
  check_ipo_supported(RESULT IPO_SUPPORTED LANGUAGES Fortran)
endif()
{% endif -%}

set(CMAKE_BUILD_TYPE "" CACHE INTERNAL "")
set(CMAKE_EXPORT_COMPILE_COMMANDS ON)

list(APPEND H_HEADERS
{% for item in H_HEADERS %}
  "{{item}}"
{% endfor %}
)

list(APPEND CXX_SOURCES
{% for item in CXX_SOURCES %}
  "{{item}}"
{% endfor %}
)

list(APPEND FORTRAN_SOURCES
{% for item in FORTRAN_SOURCES %}
  "{{item}}"
{% endfor %}
)

list(APPEND GENERATED_H_HEADERS
{% for item in GENERATED_H_HEADERS %}
  "{{item}}"
{% endfor %}
)

list(APPEND GENERATED_CXX_SOURCES
{% for item in GENERATED_CXX_SOURCES %}
  "{{item}}"
{% endfor %}
)

list(APPEND GENERATED_FORTRAN_SOURCES
{% for item in GENERATED_FORTRAN_SOURCES %}
  "{{item}}"
{% endfor %}
)

list(APPEND GENERATED_GPU_SOURCES
{% for item in GENERATED_GPU_SOURCES %}
  "{{item}}"
{% endfor %}
)

list(APPEND GENERATED_COMPILE_DEFINITIONS
{% for item in GENERATED_COMPILE_DEFINITIONS %}
  "{{ item }}"
{% endfor %}
)

list(APPEND GENERATED_COMPILE_OPTIONS
{% for item in GENERATED_COMPILE_OPTIONS %}
  "{{ item }}"
{% endfor %}
)

{% for include_dir in GENERATED_INCLUDE_DIRECTORIES %}
if(IS_ABSOLUTE "{{ include_dir }}")
  list(APPEND GENERATED_INCLUDE_DIRECTORIES "{{ include_dir }}")
else()
  list(APPEND GENERATED_INCLUDE_DIRECTORIES "${CMAKE_CURRENT_SOURCE_DIR}/{{ include_dir }}")
endif()
{% endfor %}
list(APPEND GENERATED_INCLUDE_DIRECTORIES "${CMAKE_CURRENT_SOURCE_DIR}")

list(APPEND GENERATED_LINK_LIBRARIES
{% for item in GENERATED_LINK_LIBRARIES %}
  "{{ item }}"
{% endfor %}
)

list(APPEND GENERATED_LINK_OPTIONS
{% for item in GENERATED_LINK_OPTIONS %}
  "{{ item }}"
{% endfor %}
)

set(PEANO_RUNTIME_TARGET "Peano::PeanoRuntime{{MODE}}{{DIMENSIONS}}D")
if(NOT TARGET ${PEANO_RUNTIME_TARGET})
  message(FATAL_ERROR "Peano package does not provide ${PEANO_RUNTIME_TARGET}. Check that the core build includes mode {{MODE}} and dimension {{DIMENSIONS}}.")
endif()

# Set the GPU language on the generated kernels (GENERATED_GPU_SOURCES) at directory scope before
# the target is created, so the detected GPU compiler survives until generate time.
peano_enable_gpu_language(${GENERATED_GPU_SOURCES})

peano_add_target(
  TYPE EXECUTABLE
  NAME {{EXECUTABLENAME}}
  MODE {{MODE}}
  DIMENSION {{DIMENSIONS}}
  NO_INSTALL
  SOURCES
    ${H_HEADERS}
    ${CXX_SOURCES}
    ${FORTRAN_SOURCES}
  GENERATED_SOURCES
    ${GENERATED_H_HEADERS}
    ${GENERATED_CXX_SOURCES}
    ${GENERATED_FORTRAN_SOURCES}
  COMPILE_DEFINITIONS
    ${GENERATED_COMPILE_DEFINITIONS}
  COMPILE_OPTIONS
    ${GENERATED_COMPILE_OPTIONS}
  INCLUDE_DIRECTORIES
    ${GENERATED_INCLUDE_DIRECTORIES}
  LINK_LIBRARIES
    ${PEANO_RUNTIME_TARGET}
    ${GENERATED_LINK_LIBRARIES}
  LINK_OPTIONS
    ${GENERATED_LINK_OPTIONS}
  OUTPUT_DIRECTORY "${CMAKE_CURRENT_SOURCE_DIR}"
)

{% if FORTRAN_SOURCES or GENERATED_FORTRAN_SOURCES -%}
# The executable is linked with the C++ driver, which does not add the Fortran runtime libraries,
# so forward them explicitly. Classic Flang and nvfortran inject an empty OpenMP stub (libompstub)
# into their implicit link libraries, which is pulled in ahead of the real OpenMP runtime and turns
# every parallel region into an empty one, so it is stripped here.
set(PEANO_FORTRAN_IMPLICIT_LINK_LIBRARIES ${CMAKE_Fortran_IMPLICIT_LINK_LIBRARIES})
list(REMOVE_ITEM PEANO_FORTRAN_IMPLICIT_LINK_LIBRARIES ompstub libompstub)
target_link_libraries({{EXECUTABLENAME}} PRIVATE ${PEANO_FORTRAN_IMPLICIT_LINK_LIBRARIES})

find_package(OpenMP REQUIRED COMPONENTS Fortran)
target_link_libraries({{EXECUTABLENAME}} PRIVATE OpenMP::OpenMP_Fortran)

# Some MPI installations omit Fortran bindings, so link them only when the probe creates a target.
find_package(MPI QUIET COMPONENTS Fortran)
if(TARGET MPI::MPI_Fortran)
  target_link_libraries({{EXECUTABLENAME}} PRIVATE MPI::MPI_Fortran)
endif()

target_compile_options({{EXECUTABLENAME}} PRIVATE
  $<$<AND:$<COMPILE_LANGUAGE:Fortran>,$<Fortran_COMPILER_ID:GNU>>:-ffat-lto-objects>
)
{% endif -%}
