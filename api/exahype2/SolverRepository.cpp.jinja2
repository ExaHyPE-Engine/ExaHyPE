#include "SolverRepository.h"

#include "exahype2/SolverRepository.h"
#include "exahype2/runner/RuntimeParameters.h"
#include "exahype2/runner/Statistics.h"
#include "peano4/CellConnectivity.h"
#include "peano4/Regrid.h"
#include "peano4/Spacetree.h"
{% for solver in SOLVERS %}
{{ NAMESPACE | join("::") }}::{{ solver[0] }} {{ NAMESPACE | join("::") }}::{{ solver[1] }};
{%- endfor %}

namespace {
  ::exahype2::SolverRepository solverRepository{
{%- for solver in SOLVERS %}
    {{ NAMESPACE | join("::") }}::{{ solver[1] }}{{ "," if not loop.last }}
{%- endfor %}
  };

  const peano4::CellConnectivity& getCellConnectivity() {
    return ::peano4::Spacetree::getInstance().getCellConnectivity();
  }
} // namespace

void {{ NAMESPACE | join("::") }}::startSimulation() {
{%- for coupling in COUPLINGS %}
  {{ coupling.FIRST }}.coupleWith(
    {{ coupling.SECOND }},
    std::vector<double>{ {{ coupling.FROM_SECOND | join(", ") }} },
    std::vector<double>{ {{ coupling.FROM_FIRST | join(", ") }} }
  );
{%- endfor %}
  solverRepository.startSimulation();
}

void {{ NAMESPACE | join("::") }}::finishSimulation() { solverRepository.finishSimulation(); }

void {{ NAMESPACE | join("::") }}::allocate() { solverRepository.allocate(getCellConnectivity()); }

::tarch::AllocatedBytes {{ NAMESPACE | join("::") }}::getAllocatedBytes() { return solverRepository.getAllocatedBytes(); }

void {{ NAMESPACE | join("::") }}::requestRefinementForGridConstruction() {
  solverRepository.requestRefinementForGridConstruction(getCellConnectivity());
}

void {{ NAMESPACE | join("::") }}::initialise() { solverRepository.initialise(getCellConnectivity()); }

void {{ NAMESPACE | join("::") }}::performTimeStep() { solverRepository.performTimeStep(getCellConnectivity()); }

void {{ NAMESPACE | join("::") }}::regrid(const peano4::Regrid& regrid) { solverRepository.regrid(getCellConnectivity(), regrid); }

void {{ NAMESPACE | join("::") }}::plot() {
  solverRepository.plot(
    getCellConnectivity(),
    ::exahype2::runner::RuntimeParameters::getInstance().getPlotFormat(),
    ::exahype2::runner::RuntimeParameters::getInstance().getOutputPath()
  );
}

void {{ NAMESPACE | join("::") }}::addLocalValuesToGlobalReduction(::tarch::mpi::ReductionRecord& record) {
  solverRepository.addLocalValuesToGlobalReduction(record);
}

void {{ NAMESPACE | join("::") }}::readValuesFromGlobalReduction(const ::tarch::mpi::ReductionRecord& record) {
  solverRepository.readValuesFromGlobalReduction(record);
}

const std::vector<peano4::RefinementRequest>& {{ NAMESPACE | join("::") }}::getRefinementRequests() {
  return solverRepository.getRefinementRequests();
}

double {{ NAMESPACE | join("::") }}::getMinTimeStamp() { return solverRepository.getMinTimeStamp(); }

double {{ NAMESPACE | join("::") }}::getMaxTimeStamp() { return solverRepository.getMaxTimeStamp(); }

std::uint64_t {{ NAMESPACE | join("::") }}::getNumberOfSolverCells() { return solverRepository.getNumberOfSolverCells(getCellConnectivity()); }

std::uint64_t {{ NAMESPACE | join("::") }}::getNumberOfCellDoFs() { return solverRepository.getNumberOfCellDoFs(getCellConnectivity()); }

::exahype2::runner::SolverStatistics {{ NAMESPACE | join("::") }}::getSolverStatistics() {
  ::exahype2::runner::SolverStatistics result;
{%- for solver in SOLVERS %}
  result.push_back(
    ::exahype2::runner::makeSolverStatistics(
      "{{ solver[0] }}",
      {{ solver[1] }},
{%- if solver[3] %}
      [](std::vector<::exahype2::runner::SolverStatistic>& additionalStatistics) {
        {{ solver[1] }}.appendTracerStatistics(additionalStatistics);
      }
{%- else %}
      []([[maybe_unused]] const std::vector<::exahype2::runner::SolverStatistic>& additionalStatistics) {}
{%- endif %}
    )
  );
{%- endfor %}
  return result;
}

::exahype2::runner::ConfigurationSummary {{ NAMESPACE | join("::") }}::getConfigurationSummary() {
  ::exahype2::runner::ConfigurationSummary result;
{%- for solver in SOLVERS %}
  {
    ::exahype2::runner::ConfigurationEntries configurationEntries;
{%- for statistic_label, statistic_value in solver[2] %}
    configurationEntries.emplace_back("{{ statistic_label }}", "{{ statistic_value }}");
{%- endfor %}
    configurationEntries.emplace_back("Degrees of Freedom", std::to_string({{ solver[1] }}.getNumberOfDoFs()));
    result.emplace_back("Solver \"{{ solver[0] }}\"", std::move(configurationEntries));
  }
{%- endfor %}
  return result;
}
