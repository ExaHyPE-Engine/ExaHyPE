#include "tarch/instrumentation/Debug.h"
#include "tarch/la/Vector.h"
{%- for particle_name in TRACERS %}
#include "vertexdata/{{ particle_name }}Set.h"
{%- endfor %}
{% for solver in SOLVERS %}
{{ NAMESPACE[:-1] | join("::") }}::{{ solver[0] }} {{ NAMESPACE | join("::") }}::{{ solver[1] }};
{%- endfor %}

namespace {
  ::exahype2::SolverRepository solverRepository{
{%- for solver in SOLVERS %}
    {{ NAMESPACE | join("::") }}::{{ solver[1] }}{{ "," if not loop.last }}
{%- endfor %}
  };
} // namespace

bool {{ NAMESPACE | join("::") }}::mayPlot() { return solverRepository.mayPlot(); }

::runner::SolverStatistics {{ NAMESPACE | join("::") }}::getSolverStatistics() {
  ::runner::SolverStatistics result;
{%- for solver in SOLVERS %}
{%- if solver[2] | length > 0 %}
  result.push_back(
    ::runner::makeSolverStatistics(
      "{{ solver[0] }}",
      {{ solver[1] }},
      [](std::vector<::runner::SolverStatistic>& additionalStatistics) {
{%- for particle_name in solver[2] %}
        additionalStatistics.push_back(
          ::runner::makeCountStatistic(
            "{{ particle_name }}",
            ::{{ NAMESPACE[:-1] | join("::") }}::vertexdata::{{ particle_name }}Set::getTotalNumberOfParticles()
          )
        );
{%- endfor %}
      }
    )
  );
{%- else %}
  result.push_back(
    ::runner::makeSolverStatistics(
      "{{ solver[0] }}",
      {{ solver[1] }},
      []([[maybe_unused]] const std::vector<::runner::SolverStatistic>& additionalStatistics) {}
    )
  );
{%- endif %}
{%- endfor %}
  const auto particleStatistics = getParticleStatistics();
  result.insert(result.end(), particleStatistics.begin(), particleStatistics.end());
  return result;
}

::runner::ConfigurationSummary {{ NAMESPACE | join("::") }}::getConfigurationSummary() {
  ::runner::ConfigurationSummary result;
{%- for solver in SOLVERS %}
  {
    ::runner::ConfigurationEntries configurationEntries;
{%- for statistic_label, statistic_value in solver[3] %}
    configurationEntries.emplace_back("{{ statistic_label }}", "{{ statistic_value }}");
{%- endfor %}
    configurationEntries.emplace_back("Degrees of Freedom", std::to_string({{ solver[1] }}.getNumberOfDoFs()));
    result.emplace_back("Solver \"{{ solver[0] }}\"", std::move(configurationEntries));
  }
{%- endfor %}
  return result;
}

::runner::SolverStatistics {{ NAMESPACE | join("::") }}::getParticleStatistics() {
  ::runner::SolverStatistics result;
{%- for particle_name in PROJECT_TRACERS %}
  result.push_back(
    ::runner::makeParticleStatistics(
      "{{ particle_name }}",
      ::{{ NAMESPACE[:-1] | join("::") }}::vertexdata::{{ particle_name }}Set::getTotalNumberOfParticles()
    )
  );
{%- endfor %}
  return result;
}

bool {{ NAMESPACE | join("::") }}::isFirstGridSweepOfTimeStep() {
  return solverRepository.isFirstGridSweepOfTimeStep();
}

bool {{ NAMESPACE | join("::") }}::isLastGridSweepOfTimeStep() { return solverRepository.isLastGridSweepOfTimeStep(); }

double {{ NAMESPACE | join("::") }}::getMinTimeStamp() { return solverRepository.getMinTimeStamp(); }

double {{ NAMESPACE | join("::") }}::getMaxTimeStamp() { return solverRepository.getMaxTimeStamp(); }

double {{ NAMESPACE | join("::") }}::getMinTimeStepSize() { return solverRepository.getMinTimeStepSize(); }

double {{ NAMESPACE | join("::") }}::getMaxTimeStepSize() { return solverRepository.getMaxTimeStepSize(); }

void {{ NAMESPACE | join("::") }}::suspendSolversForOneGridSweep() { solverRepository.suspendSolversForOneGridSweep(); }

int {{ NAMESPACE | join("::") }}::getNumberOfDoFs() { return solverRepository.getNumberOfDoFs(); }

void {{ NAMESPACE | join("::") }}::startGridConstructionStep() { solverRepository.startGridConstructionStep(); }

void {{ NAMESPACE | join("::") }}::startGridInitialisationStep() { solverRepository.startGridInitialisationStep(); }

void {{ NAMESPACE | join("::") }}::startTimeStep() {
  assertion(::exahype2::RefinementControlService::getInstance().committedEventsAgreeAcrossRanks());
  solverRepository.startTimeStep();
}

void {{ NAMESPACE | join("::") }}::startPlottingStep() { solverRepository.startPlottingStep(); }

void {{ NAMESPACE | join("::") }}::finishTimeStep() {
  solverRepository.finishTimeStep();
  const bool commitDynamicMeshRefinementEvents = isLastGridSweepOfTimeStep();
  if (commitDynamicMeshRefinementEvents) {
    // Every rank holds the identical merged event set before the mesh-refinement sweep
    // starts, so the commit gathers collectively on the last grid sweep of a time step.
    ::exahype2::RefinementControlService::getInstance().finishRefinementCriterionStep();
    ::exahype2::RefinementControlService::getInstance().realisePlanRejectedEvents();
  }
{%- for particle_name in TRACERS %}
  ::{{ NAMESPACE[:-1] | join("::") }}::vertexdata::{{ particle_name }}Set::reduceNumberOfParticles();
  logDebug(::{{ NAMESPACE[:-1] | join("::") }}::vertexdata::{{ particle_name }}Set::printParticleStateStatistics());
{%- endfor %}
}

void {{ NAMESPACE | join("::") }}::startDynamicMeshRefinementStep() {
  assertion(::exahype2::RefinementControlService::getInstance().committedEventsAgreeAcrossRanks());
  solverRepository.startDynamicMeshRefinementStep();
}

void {{ NAMESPACE | join("::") }}::finishDynamicMeshRefinementStep() {
  solverRepository.finishDynamicMeshRefinementStep();
  ::exahype2::RefinementControlService::getInstance().finishDynamicMeshRefinementStep();
  ::exahype2::RefinementControlService::getInstance().realisePlanRejectedEvents();
}

void {{ NAMESPACE | join("::") }}::finishGridConstructionStep() {
  solverRepository.finishGridConstructionStep();
  ::exahype2::RefinementControlService::getInstance().finishStep();
  ::exahype2::RefinementControlService::getInstance().realisePlanRejectedEvents();
}

void {{ NAMESPACE | join("::") }}::finishGridInitialisationStep() {
  solverRepository.finishGridInitialisationStep();
  // The initialisation sweep evaluates the refinement criterion on the initial condition.
  // The commit here lets the mesh-refinement sweeps set the initial condition on the finer
  // mesh before time stepping starts.
  ::exahype2::RefinementControlService::getInstance().finishRefinementCriterionStep();
  ::exahype2::RefinementControlService::getInstance().realisePlanRejectedEvents();
}

void {{ NAMESPACE | join("::") }}::finishPlottingStep() { solverRepository.finishPlottingStep(); }

void {{ NAMESPACE | join("::") }}::startSimulation() {
  // A refinement request names its cell by level and lattice position, so the service needs
  // the anchor and the extent of the cell lattice. Coarsening needs the count of the solvers
  // that evaluate a refinement criterion, because every one of them has to consent.
  ::exahype2::RefinementControlService::getInstance().setDomain(
    tarch::la::Vector<DIMENSIONS, double>{ {{ DOMAIN_OFFSET }} },
    tarch::la::Vector<DIMENSIONS, double>{ {{ DOMAIN_SIZE }} }
  );
  ::exahype2::RefinementControlService::getInstance().setNumberOfSolvers({{ NUMBER_OF_AMR_PARTICIPANTS }});

  solverRepository.startSimulation();
}

void {{ NAMESPACE | join("::") }}::finishSimulation() {
  solverRepository.finishSimulation();
  ::exahype2::RefinementControlService::getInstance().finishStep();
  ::exahype2::RefinementControlService::getInstance().shutdown();
}
