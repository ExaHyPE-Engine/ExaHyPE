#include "{{CLASSNAME}}.h"

#include "{{SOLVER_NAME}}.h"

#include "repositories/SolverRepository.h"

{{NAMESPACE | join("::")}}::{{CLASSNAME}}::{{CLASSNAME}}() :
  Base({{TIME_STEPPING_FACTOR}}) {}

void {{NAMESPACE | join("::")}}::{{CLASSNAME}}::startGridInitialisationStep() {
  Base::startGridInitialisationStep();
{%- if START_GRID_INITIALISATION_IMPLEMENTATION.strip() %}
  {{START_GRID_INITIALISATION_IMPLEMENTATION.strip()}}
{%- endif %}
{%- if USE_POINT_SOURCE %}
  {{SOLVER_NAME}}::initPointSourceLocations(pointSourceLocation);
{%- endif %}
}

void {{NAMESPACE | join("::")}}::{{CLASSNAME}}::startTimeStep() {
{%- if START_TIME_STEP_IMPLEMENTATION.strip() and FAMILY in ["fv", "ader"] %}
  const bool resumesFromSuspension = getSolverState() == SolverState::Suspended;
  Base::startTimeStep();
  if (not resumesFromSuspension) {
    {{START_TIME_STEP_IMPLEMENTATION.strip()}}
  }
{%- else %}
  Base::startTimeStep();
{%- if START_TIME_STEP_IMPLEMENTATION.strip() %}
  {{START_TIME_STEP_IMPLEMENTATION.strip()}}
{%- endif %}
{%- endif %}
}

void {{NAMESPACE | join("::")}}::{{CLASSNAME}}::finishTimeStep() {
  Base::finishTimeStep();
{%- if FAMILY == "ader" %}
  if (not reducesStatisticsThisSweep()) {
    return;
  }
{%- endif %}
{%- if ERROR_MEASUREMENT %}
  if (getSolverState() == SolverState::GridInitialisation or isLastGridSweepOfTimeStep()) {
    errorMeasurement.reduceAndRecord(_minTimeStampThisTimeStep);
  }
{%- endif %}
{%- if FINISH_TIME_STEP_IMPLEMENTATION.strip() %}
  {{FINISH_TIME_STEP_IMPLEMENTATION.strip()}}
{%- endif %}
}

void {{NAMESPACE | join("::")}}::{{CLASSNAME}}::startSimulation() {
{%- for table in KERNEL_TABLES %}
  {{table}}::initialise();
{%- endfor %}
{%- if ERROR_MEASUREMENT %}
  errorMeasurement.open(
    ::runner::RuntimeParameters::getInstance().getOutputPath() + "{{ERROR_MEASUREMENT_FILE}}",
    {{ERROR_MEASUREMENT_TIME_DELTA}}
  );
{%- endif %}
{%- if START_SIMULATION_IMPLEMENTATION.strip() %}
  {{START_SIMULATION_IMPLEMENTATION.strip()}}
{%- endif %}
}

void {{NAMESPACE | join("::")}}::{{CLASSNAME}}::finishSimulation() {
{%- if FINISH_SIMULATION_IMPLEMENTATION.strip() %}
  {{FINISH_SIMULATION_IMPLEMENTATION.strip()}}
{%- endif %}
{%- for table in KERNEL_TABLES %}
  {{table}}::deallocate();
{%- endfor %}
}
{%- if ADAPTIVE_TIME_STEPPING %}

double {{NAMESPACE | join("::")}}::{{CLASSNAME}}::minTerminalTime() const {
  return ::runner::RuntimeParameters::getInstance().getMinTerminalTime();
}
{%- endif %}
{%- if FAMILY == "fv" %}

double {{NAMESPACE | join("::")}}::{{CLASSNAME}}::maxAdmissibleMeshWidth() const {
  return ::runner::RuntimeParameters::getInstance().getMaxAdmissibleCellSize(
    DomainSize,
    NumberOfFiniteVolumesPerAxisPerPatch
  );
}
{%- elif FAMILY == "ader" %}

double {{NAMESPACE | join("::")}}::{{CLASSNAME}}::maxAdmissibleMeshWidth() const {
  return ::runner::RuntimeParameters::getInstance().getMaxAdmissiblePatchSize(DomainSize);
}
{%- endif %}
{%- if ABSTRACT_SOLVER_USER_DEFINITIONS.strip() %}

{{ABSTRACT_SOLVER_USER_DEFINITIONS.strip()}}
{%- endif %}
