#include "exahype2/runner/RuntimeParameters.h"

{{NAMESPACE | join("::")}}::RuntimeParameters::Storage     {{NAMESPACE | join("::")}}::RuntimeParameters::_storage;
{{NAMESPACE | join("::")}}::RuntimeParameters::HostStorage {{NAMESPACE | join("::")}}::RuntimeParameters::_hostStorage;

::exahype2::runner::ParameterTable {{NAMESPACE | join("::")}}::RuntimeParameters::getParameterTable(
  [[maybe_unused]] Storage&     storage,
  [[maybe_unused]] HostStorage& hostStorage
) {
  ::exahype2::runner::ParameterTable result;
{%- for parameter in RUNTIME_PARAMETERS %}
{%- set owner = "hostStorage" if parameter.is_string else "storage" %}
{%- if parameter.is_array %}
  result.addArray("{{ parameter.name }}", {{ owner }}.{{ parameter.name }}.getData(), {{ parameter.array_size }});
{%- else %}
  result.add("{{ parameter.name }}", &{{ owner }}.{{ parameter.name }});
{%- endif %}
{%- endfor %}
  return result;
}

void {{NAMESPACE | join("::")}}::RuntimeParameters::printUsage() {
  Storage     defaults{};
  HostStorage hostDefaults{};
  getParameterTable(defaults, hostDefaults).printUsage();
}

/**
 * Copies the admissible patch sizes and the grid levels of the runtime into the storage a kernel
 * reads; the runtime parses its options before the application parameters load.
 */
void {{NAMESPACE | join("::")}}::RuntimeParameters::readGridParameters() {
  const auto& runtimeParameters   = ::exahype2::runner::RuntimeParameters::getInstance();
  _storage.maxAdmissiblePatchSize = runtimeParameters.getMaxAdmissiblePatchSize(DomainSize);
  _storage.minAdmissiblePatchSize = runtimeParameters.getMinAdmissiblePatchSize(DomainSize);
  _storage.gridLevels             = runtimeParameters.getGridLevels();
  _storage.maxGridLevels          = runtimeParameters.getMaxGridLevels();
}

void {{NAMESPACE | join("::")}}::RuntimeParameters::load(tarch::reader::JSONReader* const reader) {
  getParameterTable(_storage, _hostStorage).load(reader);
  readGridParameters();
}

void {{NAMESPACE | join("::")}}::RuntimeParameters::load(
  tarch::reader::JSONReader* const reader,
  int&                             argc,
  char** const                     argv
) {
  getParameterTable(_storage, _hostStorage).load(reader, argc, argv);
  readGridParameters();
}
