{%- for table in TABLES %}

/**
{%- for line in table.documentation %}
 * {{ line }}
{%- endfor %}
 */
template <typename Precision>
INLINE_METHOD GPU_CALLABLE_METHOD constexpr std::array<Precision, {{ table.length }}> {{ FULL_QUALIFIED_NAMESPACE }}::{{ CLASSNAME }}<Precision>::get{{ table.name }}() {
{%- if table.expression is defined %}
  constexpr int    NodesPerAxis                    = {{ DG_ORDER }} + 1;
  constexpr double QuadratureNodes1D[NodesPerAxis] = {{ QUADRATURE_NODES_1D }};
{%- if "QuadratureWeights1D" in table.expression %}
  constexpr double QuadratureWeights1D[NodesPerAxis] = {{ QUADRATURE_WEIGHTS_1D }};
{%- endif %}
  constexpr auto   Values                          = {{ table.expression }};
{%- else %}
  constexpr double Values[{{ table.length }}] = {{ table.rendered }};
{%- endif %}
  std::array<Precision, {{ table.length }}> result{};
  for (std::size_t entry = 0; entry < result.size(); entry++) {
    result[entry] = static_cast<Precision>(Values[entry]);
  }
{%- if table.name == "QuadraturePoints1D" %}
  // One minus a rounded upper point is exact. Every lower point then mirrors its upper point exactly
  // at one half in every precision.
  for (std::size_t entry = 0; entry < result.size() / 2; entry++) {
    result[entry] = Precision{1} - result[result.size() - 1 - entry];
  }
{%- endif %}
  return result;
}
{%- endfor %}
