#include "{{ CLASSNAME }}.h"

#include "tarch/Assertions.h"
#include "tarch/accelerator/MemoryLocation.h"
#include "tarch/accelerator/accelerator.h"

namespace {
  template <typename Precision, std::size_t Length>
  Precision* copyToDevice(const std::array<Precision, Length>& values) {
    static_assert(Length > 0);
    auto* const result = tarch::allocateMemory<Precision>(Length, tarch::MemoryLocation::Device);
    tarch::copyTo(result, values.data(), Length, tarch::MemoryLocation::Device);
    return result;
  }
} // namespace

template <typename Precision>
void {{ FULL_QUALIFIED_NAMESPACE }}::{{ CLASSNAME }}<Precision>::initialise() {
{%- for table in TABLES %}
  ASSERTION({{ table.name }} == nullptr);
  {{ table.name }} = copyToDevice(get{{ table.name }}());
{%- endfor %}
}

template <typename Precision>
void {{ FULL_QUALIFIED_NAMESPACE }}::{{ CLASSNAME }}<Precision>::deallocate() {
{%- for table in TABLES %}
  tarch::freeMemory({{ table.name }}, tarch::MemoryLocation::Device);
  {{ table.name }} = nullptr;
{%- endfor %}
}
{% for precision in TABLE_PRECISIONS %}
template class {{ FULL_QUALIFIED_NAMESPACE }}::{{ CLASSNAME }}<{{ precision }}>;
{%- endfor %}
