#include "{{ TABLE_CLASS }}.h"
{% if TABLES | selectattr("expression", "defined") | list %}
#include "exahype2/dg/AMRMatrices.h"
#include "peano4/sfc/ActiveCurve.h"
{%- endif %}
#include "tarch/accelerator/accelerator.h"

namespace {
{%- if TABLES | selectattr("expression", "defined") | list %}
  constexpr int NodesPerAxis               = {{ DG_ORDER }} + 1;
  constexpr int EntriesPerTransferOperator = peano4::sfc::ActiveCurve::SubdivisionFactor * NodesPerAxis * NodesPerAxis;

  constexpr double QuadratureNodes1D[NodesPerAxis]   = {{ QUADRATURE_NODES_1D }};
  constexpr double QuadratureWeights1D[NodesPerAxis] = {{ QUADRATURE_WEIGHTS_1D }};
{%- endif %}
{%- for table in TABLES %}
{%- if table.expression is defined %}
  constexpr auto {{ table.name }}Values = {{ table.expression }};
{%- else %}
  constexpr double {{ table.name }}Values[{{ table.length }}] = {{ table.rendered }};
{%- endif %}
{%- endfor %}
} // namespace

template <typename Precision>
void {{ FULL_QUALIFIED_NAMESPACE }}::{{ TABLE_CLASS }}<Precision>::initialise() {
{%- for table in TABLES %}
{%- set length = "EntriesPerTransferOperator" if table.expression is defined else table.length %}
  {{ table.name }} = tarch::allocateMemory<Precision>({{ length }}, tarch::MemoryLocation::Heap);
  for (int entry = 0; entry < {{ length }}; entry++) {
    {{ table.name }}[entry] = static_cast<Precision>({{ table.name }}Values[entry]);
  }
{%- endfor %}
}

template <typename Precision>
void {{ FULL_QUALIFIED_NAMESPACE }}::{{ TABLE_CLASS }}<Precision>::deallocate() {
{%- for table in TABLES %}
  tarch::freeMemory({{ table.name }}, tarch::MemoryLocation::Heap);
  {{ table.name }} = nullptr;
{%- endfor %}
}
{% for precision in TABLE_PRECISIONS %}
template class {{ FULL_QUALIFIED_NAMESPACE }}::{{ TABLE_CLASS }}<{{ precision }}>;
{%- endfor %}
