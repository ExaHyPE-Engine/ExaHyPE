#include "{{CLASSNAME}}.h"

std::string {{NAMESPACE | join("::")}}::{{CLASSNAME}}::toString() const {
  std::ostringstream out;
  out << std::boolalpha;
  out << "(";
{%- for attribute in ATTRIBUTE_TO_STRING_PAIRS %}
  out << "{{ "," if not loop.first else "" }}{{attribute.name}}=" << {{attribute.expression}};
{%- endfor %}
#if PEANO_DEBUG
  out << "{{ "," if ATTRIBUTE_TO_STRING_PAIRS else "" }}debugX=" << getDebugX();
  out << ",debugH=" << getDebugH();
#endif
  out << ")";
  return out.str();
}
