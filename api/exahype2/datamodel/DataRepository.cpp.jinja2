#include "DataRepository.h"

#include "peano4/data/MemoryUsage.h"
{%- for container in VERTEX_DATA_CONTAINERS %}

::peano4::data::RegisteredStackContainer<{{container.stack}}> {{FULL_QUALIFIED_CLASSNAME}}::{{container.name}}StackContainer(
  {{container.container_id}},
  ::peano4::data::ManagedContainerKind::VertexData
);
{%- endfor %}
{%- for container in FACE_DATA_CONTAINERS %}

::peano4::data::RegisteredStackContainer<{{container.stack}}> {{FULL_QUALIFIED_CLASSNAME}}::{{container.name}}StackContainer(
  {{container.container_id}},
  ::peano4::data::ManagedContainerKind::FaceData
);
{%- endfor %}
{%- for container in CELL_DATA_CONTAINERS %}

::peano4::data::RegisteredStackContainer<{{container.stack}}> {{FULL_QUALIFIED_CLASSNAME}}::{{container.name}}StackContainer(
  {{container.container_id}},
  ::peano4::data::ManagedContainerKind::CellData
);
{%- endfor %}

void {{FULL_QUALIFIED_CLASSNAME}}::shutdown() {
{%- for container in VERTEX_DATA_CONTAINERS %}
  {{container.name}}StackContainer.clear();
{%- endfor %}
{%- for container in FACE_DATA_CONTAINERS %}
  {{container.name}}StackContainer.clear();
{%- endfor %}
{%- for container in CELL_DATA_CONTAINERS %}
  {{container.name}}StackContainer.clear();
{%- endfor %}
{%- for container in VERTEX_DATA_CONTAINERS %}
  ::peano4::data::releasePoolStorage<{{container.fq}}>();
{%- endfor %}
{%- for container in FACE_DATA_CONTAINERS %}
  ::peano4::data::releasePoolStorage<{{container.fq}}>();
{%- endfor %}
{%- for container in CELL_DATA_CONTAINERS %}
  ::peano4::data::releasePoolStorage<{{container.fq}}>();
{%- endfor %}
}

void {{FULL_QUALIFIED_CLASSNAME}}::updateMemoryUsage() {
  std::uint64_t cellBytes   = 0;
  std::uint64_t faceBytes   = 0;
  std::uint64_t vertexBytes = 0;
{%- for container in CELL_DATA_CONTAINERS %}
  cellBytes += ::peano4::data::payloadBytesOf<{{container.fq}}>({{container.name}}StackContainer.getPoolSize());
{%- endfor %}
{%- for container in FACE_DATA_CONTAINERS %}
  faceBytes += ::peano4::data::payloadBytesOf<{{container.fq}}>({{container.name}}StackContainer.getPoolSize());
{%- endfor %}
{%- for container in VERTEX_DATA_CONTAINERS %}
  vertexBytes += ::peano4::data::payloadBytesOf<{{container.fq}}>({{container.name}}StackContainer.getPoolSize());
{%- endfor %}
  ::peano4::data::MemoryUsage::update(cellBytes, faceBytes, vertexBytes);
}

std::size_t {{FULL_QUALIFIED_CLASSNAME}}::getGlobalCellDataMemoryUsageInBytes() {
  return ::peano4::data::MemoryUsage::getGlobalCellDataMemoryUsageInBytes();
}

std::size_t {{FULL_QUALIFIED_CLASSNAME}}::getGlobalFaceDataMemoryUsageInBytes() {
  return ::peano4::data::MemoryUsage::getGlobalFaceDataMemoryUsageInBytes();
}

std::size_t {{FULL_QUALIFIED_CLASSNAME}}::getGlobalVertexDataMemoryUsageInBytes() {
  return ::peano4::data::MemoryUsage::getGlobalVertexDataMemoryUsageInBytes();
}
