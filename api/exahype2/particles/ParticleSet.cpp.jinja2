namespace {
  int getMpiElementCount(const std::size_t numberOfElements) {
    constexpr auto MaximumMpiCount = static_cast<std::size_t>(std::numeric_limits<int>::max());
    if (numberOfElements > MaximumMpiCount) {
      tarch::terminateWithError("The particle serialisation count exceeds MPI's maximum element count.");
    }
    return static_cast<int>(numberOfElements);
  }

  template <typename Value>
  int getMpiByteCount(const std::size_t numberOfValues) {
    constexpr auto MaximumMpiCount = static_cast<std::size_t>(std::numeric_limits<int>::max());
    if (numberOfValues > MaximumMpiCount / sizeof(Value)) {
      tarch::terminateWithError("The particle payload exceeds MPI's maximum byte count.");
    }
    return static_cast<int>(numberOfValues * sizeof(Value));
  }
} // namespace

/** Consumes the incoming particle by storing it or deleting an irrelevant copy. */
void {{NAMESPACE | join("::")}}::{{CLASSNAME}}::mergeWithParticle(
  DoFType* const                        neighbourParticle,
  const peano4::dataview::VertexMarker& marker,
  const int                             treeId
) {
  assertion(neighbourParticle != nullptr, marker.toString(), treeId);
  [[maybe_unused]] const auto ownershipTolerance = peano4::particles::ReleaseOwnershipSpatialSortingTolerance
    * tarch::la::max(marker.getH()) * tarch::la::NUMERICAL_ZERO_DIFFERENCE;
  assertion(
    marker.isContainedInAdjacentCells(
      peano4::particles::periodicImageTowardsVertex(neighbourParticle->getX(), marker),
      0.5,
      ownershipTolerance
    ),
    neighbourParticle->toString(),
    marker.toString(),
    treeId
  );
  const bool incomingParticleWillBeLocal =
    peano4::particles::particleAssignedToVertexWillBeLocal(neighbourParticle->getX(), marker);
  const auto iteratorToExistingCopy =
    peano4::particles::particleIsDuplicate(neighbourParticle, _container.begin(), _container.end());

  if (neighbourParticle->getParallelState() == DoFType::ParallelState::Virtual and not incomingParticleWillBeLocal) {
    logDebug(
      "Discard virtual incoming particle " << neighbourParticle->toString() << " at " << marker.toString() << "."
    );
    delete neighbourParticle;
    _numberOfDroppedIncomingVirtualParticles.fetch_add(1, std::memory_order_relaxed);
  } else if (
    iteratorToExistingCopy != end() and neighbourParticle->getParallelState() == DoFType::ParallelState::Virtual
    and incomingParticleWillBeLocal
  ) {
    logDebug("Discard returned virtual particle " << neighbourParticle->toString() << " on tree " << treeId << ".");
    delete neighbourParticle;
    _numberOfDroppedIncomingVirtualParticles.fetch_add(1, std::memory_order_relaxed);
  } else if (iteratorToExistingCopy != end()) {
    neighbourParticle->setParallelState(
      incomingParticleWillBeLocal ? DoFType::ParallelState::Local : DoFType::ParallelState::Virtual
    );

#if PEANO_DEBUG
    neighbourParticle->setDebugX((*iteratorToExistingCopy)->getDebugX());
#endif
#if PEANO_ASSERTIONS
    const int particleId = neighbourParticle->getPartid();
#else
    const int particleId = -1;
#endif

    if ((*iteratorToExistingCopy)->getParallelState() == DoFType::ParallelState::Local and incomingParticleWillBeLocal) {
      _numberOfRedundantlyOwnedLocalParticles.fetch_add(1, std::memory_order_relaxed);
      logDebug(
        "Replace a particle both trees store as local with " << neighbourParticle->toString() << " on tree " << treeId
                                                             << "."
      );
    } else if (not incomingParticleWillBeLocal) {
      _numberOfReplacedVirtualParticlesAlongBoundary.fetch_add(1, std::memory_order_relaxed);
      logDebug("Refresh virtual particle " << neighbourParticle->toString() << " on tree " << treeId << ".");
    } else {
      _numberOfAddedLocalParticlesAlongBoundary.fetch_add(1, std::memory_order_relaxed);
      logDebug("Promote incoming particle " << neighbourParticle->toString() << " to local ownership.");
    }

    peano4::particles::updateContainedInAdjacentCellProperty(marker, *neighbourParticle);
    peano4::particles::assignmentchecks::detachParticleFromVertex(
      peano4::particles::assignmentchecks::pruneTypeName<DoFType>(),
      neighbourParticle->getX(),
      particleId,
      (*iteratorToExistingCopy)->getParallelState() == DoFType::ParallelState::Local,
      marker.getX(),
      marker.getH(),
      treeId,
      "{{NAMESPACE | join("::")}}::{{CLASSNAME}}::mergeWithParticle(marker=" + marker.toString() + ")"
    );
    peano4::particles::assignmentchecks::eraseParticle(
      peano4::particles::assignmentchecks::pruneTypeName<DoFType>(),
      neighbourParticle->getX(),
      particleId,
      (*iteratorToExistingCopy)->getParallelState() == DoFType::ParallelState::Local,
      marker.getX(),
      marker.getH(),
      treeId,
      "{{NAMESPACE | join("::")}}::{{CLASSNAME}}::mergeWithParticle(marker=" + marker.toString() + ")"
    );
    peano4::particles::assignmentchecks::assignParticleToVertex(
      peano4::particles::assignmentchecks::pruneTypeName<DoFType>(),
      neighbourParticle->getX(),
      particleId,
      neighbourParticle->getParallelState() == DoFType::ParallelState::Local,
      marker.getX(),
      marker.getH(),
      treeId,
      "{{NAMESPACE | join("::")}}::{{CLASSNAME}}::mergeWithParticle(marker=" + marker.toString() + ")",
      marker.getX(),
      marker.getH()
    );

    delete *iteratorToExistingCopy;
    _container.erase(iteratorToExistingCopy);
    _container.push_back(neighbourParticle);
  } else {
    neighbourParticle->setParallelState(
      incomingParticleWillBeLocal ? DoFType::ParallelState::Local : DoFType::ParallelState::Virtual
    );

#if PEANO_ASSERTIONS
    const int particleId = neighbourParticle->getPartid();
#else
    const int particleId = -1;
#endif

    _container.push_back(neighbourParticle);
    if (incomingParticleWillBeLocal) {
      _numberOfAddedLocalParticlesAlongBoundary.fetch_add(1, std::memory_order_relaxed);
      logDebug("Add local incoming particle " << neighbourParticle->toString() << " at " << marker.toString() << ".");
    } else {
      _numberOfAddedVirtualParticlesAlongBoundary.fetch_add(1, std::memory_order_relaxed);
      logDebug("Add virtual incoming particle " << neighbourParticle->toString() << " on tree " << treeId << ".");
    }

    peano4::particles::updateContainedInAdjacentCellProperty(marker, *neighbourParticle);
    peano4::particles::assignmentchecks::assignParticleToVertex(
      peano4::particles::assignmentchecks::pruneTypeName<DoFType>(),
      neighbourParticle->getX(),
      particleId,
      neighbourParticle->getParallelState() == DoFType::ParallelState::Local,
      marker.getX(),
      marker.getH(),
      treeId,
      "{{NAMESPACE | join("::")}}::{{CLASSNAME}}::mergeWithParticle(marker=" + marker.toString() + ")",
      marker.getX(),
      marker.getH()
    );
  }
}

/**
 * Deletes every particle in the set and records each deletion.
 *
 * The rank overwrites its copy of a vertex that several subtree tasks touch
 * with those tasks' copies.
 */
void {{NAMESPACE | join("::")}}::{{CLASSNAME}}::deleteParticlesForSlotRebuild(
  const peano4::dataview::VertexMarker& marker,
  const int                             treeId
) {
  if (_container.empty()) {
    return;
  }
  const std::string trace =
    "{{NAMESPACE | join("::")}}::{{CLASSNAME}}::deleteParticlesForSlotRebuild(marker=" + marker.toString() + ")";
  for (DoFType* const particle : _container) {
#if PEANO_ASSERTIONS
    const int particleId = particle->getPartid();
#else
    const int particleId = -1;
#endif
    const bool particleIsLocal = particle->getParallelState() == DoFType::ParallelState::Local;

    peano4::particles::assignmentchecks::detachParticleFromVertex(
      peano4::particles::assignmentchecks::pruneTypeName<DoFType>(),
      particle->getX(),
      particleId,
      particleIsLocal,
      marker.getX(),
      marker.getH(),
      treeId,
      trace
    );
    peano4::particles::assignmentchecks::eraseParticle(
      peano4::particles::assignmentchecks::pruneTypeName<DoFType>(),
      particle->getX(),
      particleId,
      particleIsLocal,
      marker.getX(),
      marker.getH(),
      treeId,
      trace
    );
    delete particle;
  }
  _container.clear();
}

/** Merges a neighbour rank's or subtree task's particle-set copy. */
void {{NAMESPACE | join("::")}}::{{CLASSNAME}}::merge(
  const peano4::grid::SendReceiveContext context,
  const {{CLASSNAME}}&                   neighbour,
  const peano4::dataview::VertexMarker&  marker,
  const int                              treeId
) {
  assertion(this != &neighbour, marker.toString(), treeId);
#if PEANO_DEBUG
  assertion(
    tarch::la::equals(neighbour._debugX, _debugX),
    neighbour._debugX,
    _debugX,
    neighbour.toString(),
    toString()
  );
  assertion(
    tarch::la::equals(neighbour._debugH, _debugH),
    neighbour._debugH,
    _debugH,
    neighbour.toString(),
    toString()
  );
#endif

  if (context == peano4::grid::SendReceiveContext::Consolidation) {
    deleteParticlesForSlotRebuild(marker, treeId);
  }

  logDebug(
    "Merge " << neighbour.size() << " particle copies from " << neighbour.toString() << " into " << marker.toString()
             << "."
  );
  for (const auto* const particle : neighbour) {
    // The neighbour owns and frees its particles.
    mergeWithParticle(new DoFType(*particle), marker, treeId);
  }

  assertion(isValid(), toString(), marker.toString());
}

