#pragma once

#include "tarch/CompilerSpecificSettings.h"
#include "tarch/accelerator/CompileTarget.h"
{%- if HAS_ARRAY_RUNTIME_PARAMETERS %}
#include "tarch/la/Vector.h"
{%- endif %}

namespace exahype2::runner {
  class ParameterTable;
} // namespace exahype2::runner

namespace tarch::reader {
  class JSONReader;
} // namespace tarch::reader

namespace {{NAMESPACE | join("::")}} {
  struct RuntimeParameters;
} // namespace {{NAMESPACE | join("::")}}

/**
 * Holds the parameters that the configuration file and the command line set. Storage holds the
 * parameters that a kernel reads, and HostStorage holds the strings.
 */
struct {{NAMESPACE | join("::")}}::RuntimeParameters final {
  struct Storage final {
{%- for parameter in RUNTIME_PARAMETERS if not parameter.is_string %}
    {{ parameter.cpp_type }} {{ parameter.name }}{ {{- parameter.default_value -}} };
{%- endfor %}
  };

  struct HostStorage final {
{%- for parameter in RUNTIME_PARAMETERS if parameter.is_string %}
    {{ parameter.cpp_type }} {{ parameter.name }}{ {{- parameter.default_value -}} };
{%- endfor %}
  };

  static void load(tarch::reader::JSONReader* reader);
  static void load(tarch::reader::JSONReader* reader, int& argc, char** argv);
  static void printUsage();
  static INLINE_METHOD const Storage& getStorage();
{%- for parameter in RUNTIME_PARAMETERS %}
{%- if parameter.is_string %}
  static INLINE_METHOD const {{ parameter.return_type }}& {{ parameter.name }}();
{%- else %}
  static INLINE_METHOD GPU_CALLABLE_METHOD {{ parameter.return_type }} {{ parameter.name }}();
{%- endif %}
{%- endfor %}

private:
  static ::exahype2::runner::ParameterTable getParameterTable(Storage& storage, HostStorage& hostStorage);

  static Storage     _storage;
  static HostStorage _hostStorage;
};

#include "RuntimeParameters.cpph"
