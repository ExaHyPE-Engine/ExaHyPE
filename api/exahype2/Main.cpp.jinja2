{%- set project_namespace = FULL_QUALIFIED_NAMESPACE %}
{%- set generated_default_arguments = [
  DEFAULT_MIN_TERMINAL_TIME,
  DEFAULT_MAX_TERMINAL_TIME,
  DEFAULT_GRID_LEVELS,
  DEFAULT_MAX_GRID_LEVELS,
  '"' ~ PROJECT_NAME ~ '"'
] %}
#include "{{ MAIN_NAME }}.h"

#include "RuntimeParameters.h"
#include "SolverRepository.h"

#include "exahype2/runner/Runner.h"
#include "exahype2/runner/RuntimeParameters.h"
#include "tarch/la/Vector.h"

namespace {
  ::exahype2::runner::SolverRepositoryCallbacks createRepositoryCallbacks() {
    ::exahype2::runner::SolverRepositoryCallbacks result;

    result.getCopyrightBanner = []() { return std::string("ExaHyPE 2 (C) www.exahype.org"); };

    result.printApplicationHelp      = ::{{ project_namespace }}::RuntimeParameters::printUsage;
    result.loadApplicationParameters = [](tarch::reader::JSONReader* const reader, int& argc, char** const argv) {
      ::{{ project_namespace }}::RuntimeParameters::load(reader, argc, argv);
    };

    result.startSimulation  = ::{{ project_namespace }}::startSimulation;
    result.finishSimulation = ::{{ project_namespace }}::finishSimulation;

    result.allocate          = ::{{ project_namespace }}::allocate;
    result.getAllocatedBytes = ::{{ project_namespace }}::getAllocatedBytes;

    result.requestRefinementForGridConstruction = ::{{ project_namespace }}::requestRefinementForGridConstruction;
    result.initialise                           = ::{{ project_namespace }}::initialise;
    result.performTimeStep                      = ::{{ project_namespace }}::performTimeStep;
    result.regrid                               = ::{{ project_namespace }}::regrid;
    result.plot                                 = ::{{ project_namespace }}::plot;
    result.contributeTo                         = ::{{ project_namespace }}::contributeTo;
    result.adoptFrom                            = ::{{ project_namespace }}::adoptFrom;
    result.getRefinementRequests                = ::{{ project_namespace }}::getRefinementRequests;

    result.getMinTimeStamp         = ::{{ project_namespace }}::getMinTimeStamp;
    result.getMaxTimeStamp         = ::{{ project_namespace }}::getMaxTimeStamp;
    result.getNumberOfSolverCells  = ::{{ project_namespace }}::getNumberOfSolverCells;
    result.getNumberOfCellDoFs     = ::{{ project_namespace }}::getNumberOfCellDoFs;
    result.getSolverStatistics     = ::{{ project_namespace }}::getSolverStatistics;
    result.getConfigurationSummary = ::{{ project_namespace }}::getConfigurationSummary;
    return result;
  }
} // namespace

int main(int argc, char** argv) {
  ::exahype2::runner::RuntimeParameters::getInstance().setGeneratedDefaults({{ generated_default_arguments | join(", ") }});

  return ::exahype2::runner::Runner::launch(
    tarch::la::Vector<DIMENSIONS, double>{ {{ DOMAIN_OFFSET }} },
    tarch::la::Vector<DIMENSIONS, double>{ {{ DOMAIN_SIZE }} },
    std::bitset<DIMENSIONS>{ {{ PERIODIC_BOUNDARIES }}ULL },
    createRepositoryCallbacks(),
    argc,
    argv
  );
}
