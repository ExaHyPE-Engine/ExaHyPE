#include "{{ CLASSNAME }}.h"
{% if STATIC_INITIALISATIONS %}
{{ STATIC_INITIALISATIONS }}
{% endif %}
/**
 * Creates the action instance of one tree for one grid sweep. The creation
 * of actions is not thread-safe.
 *
 * @param treeId Number of the spacetree this instance serves. It is smaller
 *               than 0 for the prototype action of a rank.
 */
{{ FULL_QUALIFIED_NAMESPACE }}::{{ CLASSNAME }}::{{ CLASSNAME }}(int treeId) {
{%- if CONSTRUCTOR_BODY %}
  {{ CONSTRUCTOR_BODY | indent(2) }}
{%- endif %}
}

{{ FULL_QUALIFIED_NAMESPACE }}::{{ CLASSNAME }}::~{{ CLASSNAME }}() {
{%- if DESTRUCTOR_BODY %}
  {{ DESTRUCTOR_BODY | indent(2) }}
{%- endif %}
}

std::vector<peano4::grid::GridControlEvent> {{ FULL_QUALIFIED_NAMESPACE }}::{{ CLASSNAME }}::getGridControlEvents() const {
{%- if GRID_CONTROL_EVENTS_BODY %}
  {{ GRID_CONTROL_EVENTS_BODY | indent(2) }}
{%- endif %}
}

void {{ FULL_QUALIFIED_NAMESPACE }}::{{ CLASSNAME }}::prepareTraversal() {
{%- if PREPARE_TRAVERSAL_BODY %}
  {{ PREPARE_TRAVERSAL_BODY | indent(2) }}
{%- endif %}
}

void {{ FULL_QUALIFIED_NAMESPACE }}::{{ CLASSNAME }}::unprepareTraversal() {
{%- if UNPREPARE_TRAVERSAL_BODY %}
  {{ UNPREPARE_TRAVERSAL_BODY | indent(2) }}
{%- endif %}
}
{% for operation in OPERATIONS %}
{%- if operation.parameters %}
{{ operation.returns }} {{ FULL_QUALIFIED_NAMESPACE }}::{{ CLASSNAME }}::{{ operation.name }}(
{%- for parameter in operation.parameters %}
  {{ parameter.type }} {{ parameter.name }}{{ "," if not loop.last }}
{%- endfor %}
) {
{%- else %}
{{ operation.returns }} {{ FULL_QUALIFIED_NAMESPACE }}::{{ CLASSNAME }}::{{ operation.name }}() {
{%- endif %}
{%- if operation.body %}
  {{ operation.body | indent(2) }}
{%- endif %}
}
{% endfor -%}
