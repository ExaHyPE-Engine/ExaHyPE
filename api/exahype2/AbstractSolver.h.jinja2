#pragma once
{% for include in SOLVER_INCLUDES %}
#include "{{include}}"
{%- endfor %}

namespace {{NAMESPACE | join("::")}} {
  class {{CLASSNAME}};
} // namespace {{NAMESPACE | join("::")}}

class {{NAMESPACE | join("::")}}::{{CLASSNAME}} : public {{ABSTRACT_SOLVER_BASE_CLASS}} {
public:
  using Base = {{ABSTRACT_SOLVER_BASE_CLASS}};
{%- if USE_VARIABLE_SHORTCUTS %}

  /**
   * Names the variable indices, so Q[Shortcuts::{{VARIABLE_NAMES[0]}}] reads the first variable.
   */
  using Shortcuts = {{NAMESPACE | join("::")}}::VariableShortcuts{{SOLVER_NAME}};
{%- endif %}
{%- if SUBCELL_NUMBER_OF_DMP_OBSERVABLES %}
  static constexpr int NumberOfDMPObservables = {{SUBCELL_NUMBER_OF_DMP_OBSERVABLES}};
{%- endif %}

  {{CLASSNAME}}();
  {{CLASSNAME}}(const {{CLASSNAME}}& other)            = delete;
  {{CLASSNAME}}({{CLASSNAME}}&& other)                 = delete;
  {{CLASSNAME}}& operator=(const {{CLASSNAME}}& other) = delete;
  {{CLASSNAME}}& operator=({{CLASSNAME}}&& other)      = delete;
  ~{{CLASSNAME}}() override                            = default;

  static constexpr std::bitset<DIMENSIONS> PeriodicBoundaries{ {{PERIODIC_BOUNDARIES}}ULL };
{%- if ERROR_MEASUREMENT %}

  ::exahype2::ErrorMeasurement errorMeasurement{};
{%- endif %}

  void startGridInitialisationStep() override;
  void startTimeStep() override;
  void finishTimeStep() override;
  void startSimulation() override;
  void finishSimulation() override;
{%- if ABSTRACT_SOLVER_USER_DECLARATIONS.strip() %}

  {{ABSTRACT_SOLVER_USER_DECLARATIONS.strip()}}
{%- endif %}

protected:
{%- if ADAPTIVE_TIME_STEPPING %}
  double minTerminalTime() const override;
{%- endif %}
{%- if FAMILY != "rk" %}
  double maxAdmissibleMeshWidth() const override;
{%- endif %}
};
