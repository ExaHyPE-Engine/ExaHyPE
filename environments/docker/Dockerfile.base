FROM ubuntu:24.04

LABEL peano-framework.org=http://www.peano-framework.org/

ENV FORCE_UNSAFE_CONFIGURE=1 \
    DEBIAN_FRONTEND=noninteractive \
    TZ=UTC \
    DISPLAY=host.docker.internal:0.0 \
    OMPI_ALLOW_RUN_AS_ROOT=1 \
    OMPI_ALLOW_RUN_AS_ROOT_CONFIRM=1 \
    TERM=xterm-256color \
    COLORTERM=truecolor

RUN apt-get update -y && apt-get upgrade -y && apt-get install -y --no-install-recommends --fix-missing \
    software-properties-common \
    apt-utils \
    build-essential \
    gcc \
    g++ \
    gfortran \
    bash \
    wget \
    git \
    git-lfs \
    curl \
    ssh \
    subversion \
    tar \
    unzip \
    patch \
    gzip \
    bzip2 \
    file \
    gnupg \
    coreutils \
    mercurial \
    nano \
    pkg-config \
    tree \
    flex \
    automake \
    make \
    cmake \
    cmake-curses-gui \
    ccache \
    cppcheck \
    libtool \
    clang-tidy \
    clang-format \
    gcovr \
    vim \
    less \
    gdb \
    strace \
    linux-tools-common \
    linux-tools-generic \
    valgrind \
    unifdef \
    ninja-build \
    meson \
    graphviz \
    xorg-dev \
    htop \
    btop \
    nvtop \
    mesa-utils \
    mesa-common-dev \
    ca-certificates \
    libxml2-dev \
    libbz2-dev \
    libxslt1-dev \
    libelf-dev \
    libsimde-dev \
    libudev-dev \
    libsystemd-dev \
    libgsl-dev \
    libmimalloc-dev \
    libnuma-dev \
    libnuma1 \
    libnss3 \
    libatk1.0-0 \
    libatk-bridge2.0-0 \
    libcups2 \
    libgtk-3-0 \
    libasound2t64 \
    nodejs \
    npm \
    zlib1g \
    zlib1g-dev && \
    apt-get clean -y && \
    apt-get autoremove -y && \
    apt-get autoclean -y && \
    rm -rf /var/lib/apt/lists/*

ARG DOXYGEN_VERSION=1.10.0
ARG DOXYGEN_RELEASE=Release_1_10_0

RUN wget -q https://github.com/doxygen/doxygen/releases/download/${DOXYGEN_RELEASE}/doxygen-${DOXYGEN_VERSION}.linux.bin.tar.gz \
    && tar -xzf doxygen-${DOXYGEN_VERSION}.linux.bin.tar.gz \
    && cp doxygen-${DOXYGEN_VERSION}/bin/doxygen /usr/local/bin/ \
    && rm -rf doxygen-${DOXYGEN_VERSION} doxygen-${DOXYGEN_VERSION}.linux.bin.tar.gz

CMD ["/bin/bash"]
