Bootstrap: docker
From: peanoframework/spack:latest
Stage: build

%files
  environments/spack/compilers/gcc/spack.yaml /spack.yaml

%post
  mkdir /opt/spack-environment && cd /opt/spack-environment
  cp /spack.yaml .

  . /opt/spack/share/spack/setup-env.sh
  spack compiler find
  spack -e . external find curl cmake ccache git ninja
  spack -e . concretize
  spack -e . install --fail-fast
  spack gc -y
  spack clean
  spack env activate --sh -d . >> /opt/spack-environment/environment_modifications.sh

  . /opt/spack-environment/environment_modifications.sh
  cd /
  git clone -b muc/exahype https://gitlab.lrz.de/hpcsoftware/Peano.git
  cd Peano
  mkdir build && cd build
  cmake .. \
    -GNinja \
    -DCMAKE_INSTALL_PREFIX=/opt/Peano
  ninja && ninja install

Bootstrap: docker
From: peanoframework/base:latest
Stage: final

%environment
  TZ=UTC
  DEBIAN_FRONTEND=noninteractive
  export PEANO_SRC_ROOT_DIR=/opt/Peano
  export PEANO_CMAKE_BUILD_DIR=/opt/Peano

%files from build
  /opt/spack-environment /opt
  /opt/software /opt
  /opt/views /opt
  /opt/spack-environment/environment_modifications.sh /opt/spack-environment/environment_modifications.sh
  /opt/Peano /opt/Peano
  /Peano/requirements.txt /requirements.txt

%post
  export TZ=UTC
  export DEBIAN_FRONTEND=noninteractive

  # Load the build-time environment so pip finds the Spack python
  . /opt/spack-environment/environment_modifications.sh

  # Install requirements
  pip install -r /requirements.txt && rm /requirements.txt

  # Symlink the old view location
  ln -s /opt/views/view /opt/view

  # Add Spack environment vars to the container runtime
  cat /opt/spack-environment/environment_modifications.sh >> $SINGULARITY_ENVIRONMENT
  echo 'export PYTHONPATH=/opt/Peano/python:$PYTHONPATH' >> $SINGULARITY_ENVIRONMENT

%labels
  peano-framework.org http://www.peano-framework.org/
