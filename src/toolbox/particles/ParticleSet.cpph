template <typename T>
void toolbox::particles::ParticleSet<T>::clearReassignmentStatistics() {
  _numberOfLifts                                = 0;
  _numberOfDrops                                = 0;
  _numberOfLiftsIntoSieveSet                    = 0;
  _numberOfDropsFromSieveSet                    = 0;
  _numberOfDropsIntoHorizontalTreeDecomposition = 0;
  _numberOfReassignments                        = 0;
}

template <typename T>
void toolbox::particles::ParticleSet<T>::clearParticleStateStatistics() {
  _numberOfRemainingLocalParticles = 0;
  _remainingLocalParticleNumbers.clear();
  _numberOfRemainingGlobalParticles         = 0;
  _numberOfExpiredHaloParticles             = 0;
  _numberOfParticlesThatHaveLeftTheirDomain = 0;

  _numberOfDroppedIncomingVirtualParticles.store(0, std::memory_order_relaxed);
  _numberOfRedundantlyOwnedLocalParticles.store(0, std::memory_order_relaxed);
  _numberOfReplacedVirtualParticlesAlongBoundary.store(0, std::memory_order_relaxed);

  _numberOfAddedLocalParticlesAlongBoundary.store(0, std::memory_order_relaxed);
  _numberOfAddedVirtualParticlesAlongBoundary.store(0, std::memory_order_relaxed);
}

template <typename T>
std::string toolbox::particles::ParticleSet<T>::printParticleStateStatistics() {
  std::ostringstream description;
  description << "#remaining=" << _numberOfRemainingLocalParticles
              << ", #expired halo=" << _numberOfExpiredHaloParticles
              << ", #unique-remaining=" << _remainingLocalParticleNumbers.size()
              << ", #left=" << _numberOfParticlesThatHaveLeftTheirDomain << ", #dropped virtual copy from neighbour="
              << _numberOfDroppedIncomingVirtualParticles.load(std::memory_order_relaxed)
              << ", #redundantly owned=" << _numberOfRedundantlyOwnedLocalParticles.load(std::memory_order_relaxed)
              << ", #replaced virtual="
              << _numberOfReplacedVirtualParticlesAlongBoundary.load(std::memory_order_relaxed)
              << ", #added local (inflying)="
              << _numberOfAddedLocalParticlesAlongBoundary.load(std::memory_order_relaxed)
              << ", #added virtual=" << _numberOfAddedVirtualParticlesAlongBoundary.load(std::memory_order_relaxed)
              << " (subdomain-local state updates due to UpdateParallelState (3x) vs boundary merges prior "
                 "to each mesh sweep (5x))";
  return description.str();
}

/**
 * The ranks exchange their particle identities collectively, so every rank has
 * to call reduceNumberOfParticles().
 */
template <typename T>
void toolbox::particles::ParticleSet<T>::reduceNumberOfParticles() {
  std::vector<int> localParticleNumbers;
  localParticleNumbers.reserve(2 * _remainingLocalParticleNumbers.size());
  for (const auto& particleNumber : _remainingLocalParticleNumbers) {
    localParticleNumbers.push_back(particleNumber[0]);
    localParticleNumbers.push_back(particleNumber[1]);
  }

  const int        numberOfLocalEntries = static_cast<int>(localParticleNumbers.size());
  const int        numberOfRanks        = tarch::mpi::Rank::getInstance().getNumberOfRanks();
  const MPI_Comm   communicator         = tarch::mpi::Rank::getInstance().getCommunicator();
  std::vector<int> entriesPerRank(numberOfRanks, 0);

  tarch::mpi::allgather(&numberOfLocalEntries, 1, MPI_INT, entriesPerRank.data(), 1, MPI_INT, communicator);

  std::vector<int> displacements(numberOfRanks, 0);
  int              totalNumberOfEntries = 0;
  for (int rankIndex = 0; rankIndex < numberOfRanks; rankIndex++) {
    displacements[rankIndex] = totalNumberOfEntries;
    totalNumberOfEntries += entriesPerRank[rankIndex];
  }

  std::vector<int> globalParticleNumbers(totalNumberOfEntries);
  tarch::mpi::allgatherv(
    localParticleNumbers.empty() ? nullptr : localParticleNumbers.data(),
    numberOfLocalEntries,
    MPI_INT,
    globalParticleNumbers.empty() ? nullptr : globalParticleNumbers.data(),
    entriesPerRank.data(),
    displacements.data(),
    MPI_INT,
    communicator
  );

  std::set<std::array<int, 2>> globalUniqueParticleNumbers;
  assertion(totalNumberOfEntries % 2 == 0, totalNumberOfEntries);
  for (int entryIndex = 0; entryIndex < totalNumberOfEntries; entryIndex += 2) {
    globalUniqueParticleNumbers.insert({globalParticleNumbers[entryIndex], globalParticleNumbers[entryIndex + 1]});
  }
  _numberOfRemainingGlobalParticles = static_cast<int>(globalUniqueParticleNumbers.size());
}

template <typename T>
int toolbox::particles::ParticleSet<T>::getTotalNumberOfParticles() {
  return _numberOfRemainingGlobalParticles;
}

template <typename T>
void toolbox::particles::ParticleSet<T>::reduceParticleStateStatistics() {
  const MPI_Comm communicator                                  = tarch::mpi::Rank::getInstance().getCommunicator();
  const int      localNumberOfRemainingLocalParticles          = _numberOfRemainingLocalParticles;
  const int      localNumberOfExpiredHaloParticles             = _numberOfExpiredHaloParticles;
  const int      localNumberOfParticlesThatHaveLeftTheirDomain = _numberOfParticlesThatHaveLeftTheirDomain;

  tarch::mpi::reduce(
    &localNumberOfRemainingLocalParticles,
    &_numberOfRemainingLocalParticles,
    1,
    MPI_INT,
    MPI_SUM,
    tarch::mpi::Rank::getGlobalMasterRank(),
    communicator
  );
  tarch::mpi::reduce(
    &localNumberOfExpiredHaloParticles,
    &_numberOfExpiredHaloParticles,
    1,
    MPI_INT,
    MPI_SUM,
    tarch::mpi::Rank::getGlobalMasterRank(),
    communicator
  );
  tarch::mpi::reduce(
    &localNumberOfParticlesThatHaveLeftTheirDomain,
    &_numberOfParticlesThatHaveLeftTheirDomain,
    1,
    MPI_INT,
    MPI_SUM,
    tarch::mpi::Rank::getGlobalMasterRank(),
    communicator
  );

  const int localNumberOfDroppedIncomingVirtualParticles =
    _numberOfDroppedIncomingVirtualParticles.load(std::memory_order_relaxed);
  const int localNumberOfRedundantlyOwnedLocalParticles =
    _numberOfRedundantlyOwnedLocalParticles.load(std::memory_order_relaxed);
  const int localNumberOfReplacedVirtualParticlesAlongBoundary =
    _numberOfReplacedVirtualParticlesAlongBoundary.load(std::memory_order_relaxed);
  const int localNumberOfAddedLocalParticlesAlongBoundary =
    _numberOfAddedLocalParticlesAlongBoundary.load(std::memory_order_relaxed);
  const int localNumberOfAddedVirtualParticlesAlongBoundary =
    _numberOfAddedVirtualParticlesAlongBoundary.load(std::memory_order_relaxed);
  // The reduction fills the buffers on the global master only, so every other
  // rank keeps its local count.
  int globalNumberOfDroppedIncomingVirtualParticles       = localNumberOfDroppedIncomingVirtualParticles;
  int globalNumberOfRedundantlyOwnedLocalParticles        = localNumberOfRedundantlyOwnedLocalParticles;
  int globalNumberOfReplacedVirtualParticlesAlongBoundary = localNumberOfReplacedVirtualParticlesAlongBoundary;
  int globalNumberOfAddedLocalParticlesAlongBoundary      = localNumberOfAddedLocalParticlesAlongBoundary;
  int globalNumberOfAddedVirtualParticlesAlongBoundary    = localNumberOfAddedVirtualParticlesAlongBoundary;

  tarch::mpi::reduce(
    &localNumberOfDroppedIncomingVirtualParticles,
    &globalNumberOfDroppedIncomingVirtualParticles,
    1,
    MPI_INT,
    MPI_SUM,
    tarch::mpi::Rank::getGlobalMasterRank(),
    communicator
  );
  tarch::mpi::reduce(
    &localNumberOfRedundantlyOwnedLocalParticles,
    &globalNumberOfRedundantlyOwnedLocalParticles,
    1,
    MPI_INT,
    MPI_SUM,
    tarch::mpi::Rank::getGlobalMasterRank(),
    communicator
  );
  tarch::mpi::reduce(
    &localNumberOfReplacedVirtualParticlesAlongBoundary,
    &globalNumberOfReplacedVirtualParticlesAlongBoundary,
    1,
    MPI_INT,
    MPI_SUM,
    tarch::mpi::Rank::getGlobalMasterRank(),
    communicator
  );
  tarch::mpi::reduce(
    &localNumberOfAddedLocalParticlesAlongBoundary,
    &globalNumberOfAddedLocalParticlesAlongBoundary,
    1,
    MPI_INT,
    MPI_SUM,
    tarch::mpi::Rank::getGlobalMasterRank(),
    communicator
  );
  tarch::mpi::reduce(
    &localNumberOfAddedVirtualParticlesAlongBoundary,
    &globalNumberOfAddedVirtualParticlesAlongBoundary,
    1,
    MPI_INT,
    MPI_SUM,
    tarch::mpi::Rank::getGlobalMasterRank(),
    communicator
  );
  _numberOfDroppedIncomingVirtualParticles.store(
    globalNumberOfDroppedIncomingVirtualParticles,
    std::memory_order_relaxed
  );
  _numberOfRedundantlyOwnedLocalParticles.store(
    globalNumberOfRedundantlyOwnedLocalParticles,
    std::memory_order_relaxed
  );
  _numberOfReplacedVirtualParticlesAlongBoundary.store(
    globalNumberOfReplacedVirtualParticlesAlongBoundary,
    std::memory_order_relaxed
  );
  _numberOfAddedLocalParticlesAlongBoundary.store(
    globalNumberOfAddedLocalParticlesAlongBoundary,
    std::memory_order_relaxed
  );
  _numberOfAddedVirtualParticlesAlongBoundary.store(
    globalNumberOfAddedVirtualParticlesAlongBoundary,
    std::memory_order_relaxed
  );
}

template <typename T>
std::string toolbox::particles::ParticleSet<T>::printReassignmentStatistics() {
  std::ostringstream description;
  description << "sort statistics"
              << ": #lifts=" << _numberOfLifts << ", #drops=" << _numberOfDrops
              << ", #lifts-into-sieve-set=" << _numberOfLiftsIntoSieveSet
              << ", #drops-from-sieve-set=" << _numberOfDropsFromSieveSet
              << ", #drops-into-horizontal-tree-decomposition=" << _numberOfDropsIntoHorizontalTreeDecomposition
              << ", #reassignments=" << _numberOfReassignments;
  return description.str();
}

template <typename T>
void toolbox::particles::ParticleSet<T>::reduceReassignmentStatistics() {
  const MPI_Comm communicator                                      = tarch::mpi::Rank::getInstance().getCommunicator();
  int            localNumberOfLifts                                = _numberOfLifts;
  int            localNumberOfDrops                                = _numberOfDrops;
  int            localNumberOfLiftsIntoSieveSet                    = _numberOfLiftsIntoSieveSet;
  int            localNumberOfDropsFromSieveSet                    = _numberOfDropsFromSieveSet;
  int            localNumberOfDropsIntoHorizontalTreeDecomposition = _numberOfDropsIntoHorizontalTreeDecomposition;
  int            localNumberOfReassignments                        = _numberOfReassignments;

  tarch::mpi::reduce(
    &localNumberOfLifts,
    &_numberOfLifts,
    1,
    MPI_INT,
    MPI_SUM,
    tarch::mpi::Rank::getGlobalMasterRank(),
    communicator
  );
  tarch::mpi::reduce(
    &localNumberOfDrops,
    &_numberOfDrops,
    1,
    MPI_INT,
    MPI_SUM,
    tarch::mpi::Rank::getGlobalMasterRank(),
    communicator
  );
  tarch::mpi::reduce(
    &localNumberOfLiftsIntoSieveSet,
    &_numberOfLiftsIntoSieveSet,
    1,
    MPI_INT,
    MPI_SUM,
    tarch::mpi::Rank::getGlobalMasterRank(),
    communicator
  );
  tarch::mpi::reduce(
    &localNumberOfDropsFromSieveSet,
    &_numberOfDropsFromSieveSet,
    1,
    MPI_INT,
    MPI_SUM,
    tarch::mpi::Rank::getGlobalMasterRank(),
    communicator
  );
  tarch::mpi::reduce(
    &localNumberOfDropsIntoHorizontalTreeDecomposition,
    &_numberOfDropsIntoHorizontalTreeDecomposition,
    1,
    MPI_INT,
    MPI_SUM,
    tarch::mpi::Rank::getGlobalMasterRank(),
    communicator
  );
  tarch::mpi::reduce(
    &localNumberOfReassignments,
    &_numberOfReassignments,
    1,
    MPI_INT,
    MPI_SUM,
    tarch::mpi::Rank::getGlobalMasterRank(),
    communicator
  );
}

template <typename T>
void toolbox::particles::ParticleSet<T>::updateLiftDropStatistics(
  int numberOfLiftsInThisTree,
  int numberOfDropsInThisTree,
  int numberOfReassignmentsInThisTree,
  int numberOfLiftsIntoSieveSetInThisTree,
  int numberOfDropsFromSieveSetInThisTree,
  int numberOfDropsIntoHorizontalTreeDecomposition
) {
  const std::scoped_lock lock(_statisticsMutex);
  _numberOfLifts += numberOfLiftsInThisTree;
  _numberOfDrops += numberOfDropsInThisTree;
  _numberOfReassignments += numberOfReassignmentsInThisTree;
  _numberOfLiftsIntoSieveSet += numberOfLiftsIntoSieveSetInThisTree;
  _numberOfDropsFromSieveSet += numberOfDropsFromSieveSetInThisTree;
  _numberOfDropsIntoHorizontalTreeDecomposition += numberOfDropsIntoHorizontalTreeDecomposition;
}

template <typename T>
void toolbox::particles::ParticleSet<T>::updateNumberOfLocalAndExpiredParticles(
  int                                 numberOfRemainingLocalParticles,
  int                                 numberOfExpiredHaloParticles,
  int                                 numberOfParticlesThatHaveLeftTheirDomain,
  const std::set<std::array<int, 2>>& remainingLocalParticleNumbers
) {
  const std::scoped_lock lock(_statisticsMutex);
  _numberOfRemainingLocalParticles += numberOfRemainingLocalParticles;
  _remainingLocalParticleNumbers.insert(remainingLocalParticleNumbers.begin(), remainingLocalParticleNumbers.end());
  _numberOfExpiredHaloParticles += numberOfExpiredHaloParticles;
  _numberOfParticlesThatHaveLeftTheirDomain += numberOfParticlesThatHaveLeftTheirDomain;
}

template <typename T>
int toolbox::particles::ParticleSet<T>::getNumberOfDropsIntoHorizontalTreeDecomposition() {
  return _numberOfDropsIntoHorizontalTreeDecomposition;
}

template <typename T>
bool toolbox::particles::ParticleSet<T>::registeredAnyResorting() {
  return _numberOfLifts + _numberOfDrops + _numberOfReassignments + _numberOfLiftsIntoSieveSet
    + _numberOfDropsFromSieveSet + _numberOfDropsIntoHorizontalTreeDecomposition
    > 0;
}

/**
 * The ranks exchange their sieve lists collectively, so every rank has to call
 * finishedTraversal() after its traversal.
 */
template <typename T>
void toolbox::particles::ParticleSet<T>::finishedTraversal(
  const tarch::la::Vector<DIMENSIONS, double> domainOffset,
  const tarch::la::Vector<DIMENSIONS, double> domainSize,
  const std::bitset<DIMENSIONS>               periodicBC
) {
  _sieveParticles.exchangeSieveListsGlobally(domainOffset, domainSize, periodicBC);
}

/** Returns a deep copy of the particles that await sieving. */
template <typename T>
typename toolbox::particles::SieveParticles<T> toolbox::particles::ParticleSet<T>::cloneParticlesToBeSieved() {
  return _sieveParticles.cloneParticlesToBeSieved();
}

/**
 * Removes the sieve particles that belong to the marked local vertex from the
 * sieve set and returns them.
 */
template <typename T>
typename toolbox::particles::ParticleSet<T>::ParticleList toolbox::particles::ParticleSet<
  T>::getParticlesToBeSievedIntoVertex(const peano4::datamanagement::VertexMarker& marker) {
  return _sieveParticles.getParticlesToBeSievedIntoVertex(
    marker,
    true, // Remove returned particles from the sieve.
    true, // Return only particles that will be local.
    true  // Lock the sieve set while removing entries.
  );
}

template <typename T>
bool toolbox::particles::ParticleSet<T>::hasParticlesToBeSievedIntoVertices() {
  return _sieveParticles.hasParticlesToBeSievedIntoVertices();
}

template <typename T>
int toolbox::particles::ParticleSet<T>::getNumberOfParticlesThatHaveBeSievedIntoVertices() {
  return _sieveParticles.getNumberOfParticlesThatHaveBeSievedIntoVertices();
}

template <typename T>
std::string toolbox::particles::ParticleSet<T>::toString(bool addBrackets) const {
  std::ostringstream description;
  if (addBrackets) {
    description << "(";
  }

  description << "#lifts=" << _numberOfLifts << ", #drops=" << _numberOfDrops
              << ", #assignments=" << _numberOfReassignments << ", #lifts-into-sieve-set=" << _numberOfLiftsIntoSieveSet
              << ", #drops-from-sieve-set=" << _numberOfDropsFromSieveSet
              << ", #remaining-particles=" << _numberOfRemainingLocalParticles;

#if PEANO_DEBUG
  description << ",x=" << _debugX << ",h=" << _debugH;
#endif

  if (addBrackets) {
    description << ")";
  }
  return description.str();
}

template <typename T>
int toolbox::particles::ParticleSet<T>::getNumberOfRemainingLocalParticles() {
  return _numberOfRemainingLocalParticles;
}
