template <typename T>
tarch::multicore::BooleanSemaphore
  toolbox::particles::SieveParticles<T>::_particlesThatCanNotBeLiftedWithinTheirTreeSemaphore;

template <typename T>
tarch::multicore::BooleanSemaphore toolbox::particles::SieveParticles<T>::_particlesToBeSievedSemaphore;

template <typename T>
void toolbox::particles::SieveParticles<T>::deleteParticles(ParticleList& list) {
  for (auto* p : list) {
    delete p;
  }
  list.clear();
}

template <typename T>
void toolbox::particles::SieveParticles<T>::exchangeSieveListsGlobally(
  const tarch::la::Vector<DIMENSIONS, double> domainOffset,
  const tarch::la::Vector<DIMENSIONS, double> domainSize,
  const std::bitset<DIMENSIONS>               periodicBC
) {
  logDebug(
    "there are " << _particlesThatHaveToBeSieved.size()
                 << " sieve sets (each tied to one tree or the global sorting, respectively)"
  );

  deleteParticles(_particlesThatHaveToBeSieved);

  logDebug("pack the particles that cannot be sorted locally into a contiguous buffer");
  std::vector<T> sendBuffer;
  sendBuffer.reserve(_particlesThatCanNotBeLiftedWithinTheirTree.size());
  for (const auto* p : _particlesThatCanNotBeLiftedWithinTheirTree) {
    sendBuffer.push_back(*p);
  }

  const int        numberOfRanks          = tarch::mpi::Rank::getInstance().getNumberOfRanks();
  const int        localRank              = tarch::mpi::Rank::getInstance().getRank();
  const MPI_Comm   communicator           = tarch::mpi::Rank::getInstance().getCommunicator();
  const int        numberOfLocalParticles = static_cast<int>(sendBuffer.size());
  std::vector<int> particlesPerRank(numberOfRanks, 0);

  tarch::mpi::allgather(&numberOfLocalParticles, 1, MPI_INT, particlesPerRank.data(), 1, MPI_INT, communicator);

  // The particles travel as raw bytes, so both the per-rank counts and the offsets into the
  // receive buffer are byte counts, and an int has to span the whole gathered block.
  std::vector<int> bytesPerRank(numberOfRanks, 0);
  std::vector<int> displacements(numberOfRanks, 0);
  std::size_t      numberOfBytes           = 0;
  int              numberOfGlobalParticles = 0;
  for (int rank = 0; rank < numberOfRanks; rank++) {
    displacements[rank] = static_cast<int>(numberOfBytes);
    bytesPerRank[rank]  = particlesPerRank[rank] * static_cast<int>(sizeof(T));
    numberOfBytes += static_cast<std::size_t>(particlesPerRank[rank]) * sizeof(T);
    numberOfGlobalParticles += particlesPerRank[rank];
  }
  assertion(
    numberOfBytes <= static_cast<std::size_t>(std::numeric_limits<int>::max()),
    numberOfBytes,
    numberOfGlobalParticles,
    sizeof(T)
  );

  std::vector<T> receiveBuffer(numberOfGlobalParticles);
  tarch::mpi::allgatherv(
    sendBuffer.empty() ? nullptr : sendBuffer.data(),
    numberOfLocalParticles * static_cast<int>(sizeof(T)),
    MPI_BYTE,
    receiveBuffer.empty() ? nullptr : receiveBuffer.data(),
    bytesPerRank.data(),
    displacements.data(),
    MPI_BYTE,
    communicator
  );

  // This rank's own segment comes back with the rest, but its particles are handed over
  // below as pointers, so copying them out here would duplicate every one of them.
  int index = 0;
  for (int rank = 0; rank < numberOfRanks; rank++) {
    if (rank != localRank) {
      for (int particle = 0; particle < particlesPerRank[rank]; particle++) {
        _particlesThatHaveToBeSieved.push_back(new T(receiveBuffer[index + particle]));
      }
    }
    index += particlesPerRank[rank];
  }

  _particlesThatHaveToBeSieved.insert(
    _particlesThatHaveToBeSieved.end(),
    _particlesThatCanNotBeLiftedWithinTheirTree.begin(),
    _particlesThatCanNotBeLiftedWithinTheirTree.end()
  );

  // shallow clear, as the pointers have already been rolled over into _particlesThatHaveToBeSieved
  _particlesThatCanNotBeLiftedWithinTheirTree.clear();

  if (periodicBC.any()) {
    for (auto p : _particlesThatHaveToBeSieved) {
      p->setX(toolbox::particles::applyPeriodicBoundaryConditions(p->getX(), domainOffset, domainSize, periodicBC));
    }
  }
}

template <typename T>
std::string toolbox::particles::SieveParticles<T>::toString() const {
  std::ostringstream msg;

  msg << "(#particles-that-cannot-be-lifted=" << _particlesThatCanNotBeLiftedWithinTheirTree.size()
      << ",#particles-that-have-to-be-sieved=" << _particlesThatHaveToBeSieved.size() << ")";

  return msg.str();
}

template <typename T>
void toolbox::particles::SieveParticles<T>::deleteParticles() {
  deleteParticles(_particlesThatCanNotBeLiftedWithinTheirTree);
  deleteParticles(_particlesThatHaveToBeSieved);

  _particlesThatCanNotBeLiftedWithinTheirTree.clear();
  _particlesThatHaveToBeSieved.clear();
}

template <typename T>
toolbox::particles::SieveParticles<T> toolbox::particles::SieveParticles<T>::cloneParticlesToBeSieved() {
  SieveParticles<T> result;

  for (auto p : _particlesThatHaveToBeSieved) {
    result._particlesThatHaveToBeSieved.push_back(new T(*p));
  }

  logDebug("created a clone of the particle set: " << this->toString() << "->" << result.toString());

  return result;
}

template <typename T>
void toolbox::particles::SieveParticles<T>::addParticleThatCanNotBeLiftedWithinItsTree(T* p) {
  logDebug("particle cannot be lifted: " << p->toString());
  _particlesThatCanNotBeLiftedWithinTheirTree.push_back(p);
}

template <typename T>
int toolbox::particles::SieveParticles<T>::getNumberOfParticlesThatHaveBeSievedIntoVertices() const {
  return _particlesThatHaveToBeSieved.size();
}

template <typename T>
bool toolbox::particles::SieveParticles<T>::hasParticlesToBeSievedIntoVertices() const {
  return not _particlesThatHaveToBeSieved.empty();
}

template <typename T>
typename toolbox::particles::SieveParticles<T>::ParticleList
toolbox::particles::SieveParticles<T>::getParticlesToBeSievedIntoVertex(
  const peano4::datamanagement::VertexMarker& marker,
  bool                                        removeReturnedParticlesFromSet,
  bool                                        onlyReturnParticlesThatWillBeLocal,
  bool                                        lockSemaphore
) {
  tarch::multicore::Lock lock(_particlesToBeSievedSemaphore, removeReturnedParticlesFromSet and lockSemaphore);

  ParticleList                    result;
  typename ParticleList::iterator p = _particlesThatHaveToBeSieved.begin();
  while (p != _particlesThatHaveToBeSieved.end()) {
    bool willBeLocal = toolbox::particles::particleAssignedToVertexWillBeLocal((*p)->getX(), marker);
    if (::toolbox::particles::sieveParticle(**p, marker) and (willBeLocal or not onlyReturnParticlesThatWillBeLocal)) {
      logDebug("drop particle " << (*p)->toString() << " from global sieve list into vertex " << marker.toString());

      (*p)->setCellH(marker.getH());

      result.push_back(*p);
      if (removeReturnedParticlesFromSet) {
        p = _particlesThatHaveToBeSieved.erase(p);
      } else {
        p++;
      }
    } else {
      p++;
    }
  }
  return result;
}
