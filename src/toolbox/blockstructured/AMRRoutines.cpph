/**
 * Piecewise-constant prolongation of a coarse halo layer onto a fine face.
 */
template <typename T>
INLINE_METHOD void toolbox::blockstructured::interpolateHaloLayer(
  const peano4::datamanagement::FaceMarker& marker,
  const T* NOALIAS                          coarseGridFaceValues,
  T* NOALIAS                                fineGridFaceValues,
  const int                                 side,
  const int                                 numberOfDofsPerAxis,
  const int                                 numberOfUnknownsPlusAuxiliaryVariables
) {
  const auto normal = marker.getSelectedFaceNumber() % DIMENSIONS;

  int iStride    = 0;
  int jStride    = 0;
  int sideStride = 0;

  switch (normal) {
  case 0:
    iStride    = 2;
    jStride    = 2 * numberOfDofsPerAxis;
    sideStride = 1;
    break;
  case 1:
    iStride    = 1;
    jStride    = 2 * numberOfDofsPerAxis;
    sideStride = numberOfDofsPerAxis;
    break;
  case 2:
    iStride    = 1;
    jStride    = numberOfDofsPerAxis;
    sideStride = numberOfDofsPerAxis * numberOfDofsPerAxis;
    break;
  default:
    assertion(false);
    break;
  }

#if DIMENSIONS == 3
  for (int j = 0; j < numberOfDofsPerAxis; j++) {
    int jPos = jStride * ((j + numberOfDofsPerAxis * marker.getRelativePositionWithinFatherFace()[1]) / 3);
#else
  constexpr int j    = 0;
  constexpr int jPos = 0;
  {
#endif
    for (int i = 0; i < numberOfDofsPerAxis; i++) {
      const auto iPos = iStride * ((i + numberOfDofsPerAxis * marker.getRelativePositionWithinFatherFace()[0]) / 3);

      for (int u = 0; u < numberOfUnknownsPlusAuxiliaryVariables; u++) {
        fineGridFaceValues[(side * sideStride + i * iStride + j * jStride) * numberOfUnknownsPlusAuxiliaryVariables + u] =
          coarseGridFaceValues[(side * sideStride + iPos + jPos) * numberOfUnknownsPlusAuxiliaryVariables + u];
      }
    }
  }
}

/**
 * Piecewise-constant halo prolongation plus a tangential central-slope correction.
 *
 * Tangential means along the face: the DIMENSIONS-1 axes in the plane of the face,
 * one in two dimensions and two in three. The remaining axis is the normal, running
 * across the face.
 *
 * The plain piecewise-constant ghost gives all three fine sub-volumes of one coarse
 * volume the same value: a tangential staircase. For a wave crossing a coarse-fine face
 * at an angle, a Riemann flux turns that grid-aligned step into a spurious O(h)
 * tangential velocity. This routine removes the staircase without giving up bitwise
 * mirror symmetry: per coarse volume c_j and tangential axis, the three fine sub-volumes
 * become c_j - d, c_j, c_j + d with d = (c_{j+1} - c_{j-1})/6 in the interior and
 * d = (c_{j+1} - c_j)/3 or (c_j - c_{j-1})/3 at a patch end, where only one neighbour
 * exists. The correction stays tangential because the halo is one volume deep
 * across the face: coarse values run in a row along the face to difference, but only one
 * sits across it. Every correction is a two-term difference scaled by -1, 0, or +1, and
 * the per-axis contributions are summed before they touch the base value, so the operator
 * commutes bitwise with every reflection and axis swap of the face. It is exact for
 * constant fields, and the end divisor makes a linear tangential profile exact in every
 * sub-patch, including the ends.
 */
template <typename T>
INLINE_METHOD void toolbox::blockstructured::interpolateHaloLayerWithTangentialSlope(
  const peano4::datamanagement::FaceMarker& marker,
  const T* NOALIAS                          coarseGridFaceValues,
  T* NOALIAS                                fineGridFaceValues,
  const int                                 side,
  const int                                 numberOfDofsPerAxis,
  const int                                 numberOfUnknownsPlusAuxiliaryVariables
) {
  static_assert(std::is_floating_point_v<T>, "The tangential slope requires a floating-point type");

  interpolateHaloLayer(marker, coarseGridFaceValues, fineGridFaceValues, side, numberOfDofsPerAxis, numberOfUnknownsPlusAuxiliaryVariables);

  const auto normal = marker.getSelectedFaceNumber() % DIMENSIONS;

  int iStride    = 0;
  int jStride    = 0;
  int sideStride = 0;

  switch (normal) {
  case 0:
    iStride    = 2;
    jStride    = 2 * numberOfDofsPerAxis;
    sideStride = 1;
    break;
  case 1:
    iStride    = 1;
    jStride    = 2 * numberOfDofsPerAxis;
    sideStride = numberOfDofsPerAxis;
    break;
  case 2:
    iStride    = 1;
    jStride    = numberOfDofsPerAxis;
    sideStride = numberOfDofsPerAxis * numberOfDofsPerAxis;
    break;
  default:
    assertion(false);
    break;
  }

  // Slope of one tangential axis at the coarse volume with tangential index cell,
  // scaled to the fine-volume offset of one third of the coarse spacing. The
  // divisor 3*(right-left) covers both the central difference in the interior and
  // the one-sided difference at the patch ends, so linear traces reconstruct
  // exactly everywhere.
  auto slopeAt = [&](int cell, int stride, int base, int u) -> T {
    const int left  = (cell - 1 >= 0) ? cell - 1 : cell;
    const int right = (cell + 1 < numberOfDofsPerAxis) ? cell + 1 : cell;
    if (left == right) {
      return static_cast<T>(0.0);
    }
    return (coarseGridFaceValues[(base + right * stride) * numberOfUnknownsPlusAuxiliaryVariables + u]
            - coarseGridFaceValues[(base + left * stride) * numberOfUnknownsPlusAuxiliaryVariables + u])
      / static_cast<T>(3 * (right - left));
  };

#if DIMENSIONS == 3
  for (int j = 0; j < numberOfDofsPerAxis; j++) {
    const int jGlobal = j + numberOfDofsPerAxis * marker.getRelativePositionWithinFatherFace()[1];
    const int jCell   = jGlobal / 3;
    const int jPos    = jGlobal % 3;
#else
  constexpr int j     = 0;
  constexpr int jCell = 0;
  {
#endif
    for (int i = 0; i < numberOfDofsPerAxis; i++) {
      const int iGlobal = i + numberOfDofsPerAxis * marker.getRelativePositionWithinFatherFace()[0];
      const int iCell   = iGlobal / 3;
      const int iPos    = iGlobal % 3;

      for (int u = 0; u < numberOfUnknownsPlusAuxiliaryVariables; u++) {
        const T iSlope = slopeAt(iCell, iStride, side * sideStride + jCell * jStride, u);
#if DIMENSIONS == 3
        const T jSlope = slopeAt(jCell, jStride, side * sideStride + iCell * iStride, u);
        // Each axis term is rounded on its own before the commutative sum, so a diagonal
        // axis swap of the face commutes bitwise with the correction. A product fused
        // into the sum would round the two swap orders differently, which the separate
        // statements rule out.
        const T iTerm      = static_cast<T>(iPos - 1) * iSlope;
        const T jTerm      = static_cast<T>(jPos - 1) * jSlope;
        const T correction = iTerm + jTerm;
#else
        const T correction = static_cast<T>(iPos - 1) * iSlope;
#endif
        fineGridFaceValues[(side * sideStride + i * iStride + j * jStride) * numberOfUnknownsPlusAuxiliaryVariables + u] += correction;
      }
    }
  }
}

template <typename T>
INLINE_METHOD void toolbox::blockstructured::interpolateHaloLayerFromCoarseCell(
  const peano4::datamanagement::FaceMarker& marker,
  const T* NOALIAS                          coarseGridCellValues,
  T* NOALIAS                                fineGridFaceValues,
  const int                                 side,
  const int                                 numberOfDofsPerAxis,
  const int                                 numberOfUnknownsPlusAuxiliaryVariables
) {
  const auto normal = marker.getSelectedFaceNumber() % DIMENSIONS;

  tarch::la::Vector<DIMENSIONS, int> faceIndices;
  int                                sideStride = 0;

  switch (normal) {
  case 0:
    faceIndices[0] = 0;
    faceIndices[1] = 2;
#if DIMENSIONS == 3
    faceIndices[2] = 2 * numberOfDofsPerAxis;
#endif
    sideStride = 1;
    break;
  case 1:
    faceIndices[0] = 1;
    faceIndices[1] = 0;
#if DIMENSIONS == 3
    faceIndices[2] = 2 * numberOfDofsPerAxis;
#endif
    sideStride = numberOfDofsPerAxis;
    break;
#if DIMENSIONS == 3
  case 2:
    faceIndices[0] = 1;
    faceIndices[1] = numberOfDofsPerAxis;
    faceIndices[2] = 0;
    sideStride     = numberOfDofsPerAxis * numberOfDofsPerAxis;
    break;
#endif
  default:
    assertion(false);
    break;
  }

  peano4::dForEachExclusive(numberOfDofsPerAxis, normal, 0, [&](const tarch::la::Vector<DIMENSIONS, int>& volumePos) {
    // Piecewise-constant coarse source volume. Along the normal we have to
    // respect which side of the fine face we fill: the right halo (side==1)
    // samples the first layer of the coarse sub-cell, the left halo (side==0)
    // the last layer of the preceding sub-cell. volumePos[normal] is pinned to
    // 0 by the exclusive traversal, so the side term below supplies the entire
    // normal dependence.
    tarch::la::Vector<DIMENSIONS, int> coarseVolume;
    for (int d = 0; d < DIMENSIONS; d++) {
      coarseVolume[d] = (volumePos[d] + numberOfDofsPerAxis * marker.getRelativePositionWithinFatherCell()[d]) / 3;
    }
    coarseVolume[normal] =
      (numberOfDofsPerAxis * marker.getRelativePositionWithinFatherCell()[normal] - (1 - side)) / 3;

    const auto coarseGridPos = coarseVolume[0] + numberOfDofsPerAxis * coarseVolume[1]
#if DIMENSIONS == 3
      + numberOfDofsPerAxis * numberOfDofsPerAxis * coarseVolume[2]
#endif
      ;

    const auto fineGridPos = faceIndices[0] * volumePos[0] + faceIndices[1] * volumePos[1]
#if DIMENSIONS == 3
      + faceIndices[2] * volumePos[2]
#endif
      ;

    for (int u = 0; u < numberOfUnknownsPlusAuxiliaryVariables; u++) {
      fineGridFaceValues[(side * sideStride + fineGridPos) * numberOfUnknownsPlusAuxiliaryVariables + u] =
        coarseGridCellValues[(coarseGridPos)*numberOfUnknownsPlusAuxiliaryVariables + u];
    }
  });
}

/**
 * Average a fine halo layer back onto the coarse face.
 *
 * The coarse face must contain all zeroes before the restriction, as the routine cannot
 * know in which order the fine faces restrict into it.
 */
template <typename T>
INLINE_METHOD void toolbox::blockstructured::restrictHaloLayer(
  const peano4::datamanagement::FaceMarker& marker,
  T* NOALIAS                                coarseGridFaceValues,
  const T* NOALIAS                          fineGridFaceValues,
  const int                                 side,
  const int                                 numberOfDofsPerAxis,
  const int                                 numberOfUnknownsPlusAuxiliaryVariables
) {
  static_assert(std::is_floating_point_v<T>, "Averaging restriction requires a floating-point type");
  const auto normal = marker.getSelectedFaceNumber() % DIMENSIONS;

  int iStride    = 0;
  int jStride    = 0;
  int sideStride = 0;

  switch (normal) {
  case 0:
    iStride    = 2;
    jStride    = 2 * numberOfDofsPerAxis;
    sideStride = 1;
    break;
  case 1:
    iStride    = 1;
    jStride    = 2 * numberOfDofsPerAxis;
    sideStride = numberOfDofsPerAxis;
    break;
  case 2:
    iStride    = 1;
    jStride    = numberOfDofsPerAxis;
    sideStride = numberOfDofsPerAxis * numberOfDofsPerAxis;
    break;
  default:
    assertion(false);
    break;
  }

#if DIMENSIONS == 3
  constexpr T Scale = 1. / 9.;
  for (int j = 0; j < numberOfDofsPerAxis; j++) {
    int jPos = jStride * ((j + numberOfDofsPerAxis * marker.getRelativePositionWithinFatherFace()[1]) / 3);
#else
  constexpr T   Scale = 1. / 3.;
  constexpr int j     = 0;
  constexpr int jPos  = 0;
  {
#endif
    for (int i = 0; i < numberOfDofsPerAxis; i++) {
      const auto iPos = iStride * ((i + numberOfDofsPerAxis * marker.getRelativePositionWithinFatherFace()[0]) / 3);

      for (int u = 0; u < numberOfUnknownsPlusAuxiliaryVariables; u++) {
        coarseGridFaceValues[(side * sideStride + iPos + jPos) * numberOfUnknownsPlusAuxiliaryVariables + u] +=
          Scale * fineGridFaceValues[(side * sideStride + i * iStride + j * jStride) * numberOfUnknownsPlusAuxiliaryVariables + u];
      }
    }
  }
}

template <typename T>
INLINE_METHOD void toolbox::blockstructured::interpolateCell(
  const peano4::datamanagement::CellMarker& marker,
  const T* NOALIAS                          coarseGridValues,
  T* NOALIAS                                fineGridValues,
  const int                                 numberOfDofsPerAxis,
  const int                                 numberOfUnknownsPlusAuxiliaryVariables
) {
#if DIMENSIONS == 3
  for (int z = 0; z < numberOfDofsPerAxis; z++) {
    const auto zPos = numberOfDofsPerAxis * numberOfDofsPerAxis
      * ((z + numberOfDofsPerAxis * marker.getRelativePositionWithinFatherCell()[2]) / 3);
#else
  {
    constexpr int z    = 0;
    constexpr int zPos = 0;
#endif
    for (int y = 0; y < numberOfDofsPerAxis; y++) {
      const auto yPos =
        numberOfDofsPerAxis * ((y + numberOfDofsPerAxis * marker.getRelativePositionWithinFatherCell()[1]) / 3);
      for (int x = 0; x < numberOfDofsPerAxis; x++) {
        const auto xPos = (x + numberOfDofsPerAxis * marker.getRelativePositionWithinFatherCell()[0]) / 3;
        for (int u = 0; u < numberOfUnknownsPlusAuxiliaryVariables; u++) {
          fineGridValues[(z * numberOfDofsPerAxis * numberOfDofsPerAxis + y * numberOfDofsPerAxis + x) * numberOfUnknownsPlusAuxiliaryVariables + u] =
            coarseGridValues[(zPos + yPos + xPos) * numberOfUnknownsPlusAuxiliaryVariables + u];
        }
      }
    }
  }
}

/**
 * Matrix-based interpolation for nodal (e.g. discontinuous Galerkin) cell data.
 *
 * interpolationMatrix1d holds, per child interval b of the triadic subdivision, the
 * coarse one-dimensional shape functions evaluated at the child's nodes: entry
 * [b * n * n + fine * n + coarse] is phi_coarse at the fine node. The multidimensional
 * evaluation is the tensor product of the per-axis entries, so every polynomial the
 * coarse basis represents is reproduced exactly on the child.
 */
template <typename T>
INLINE_METHOD void toolbox::blockstructured::interpolateCell(
  const peano4::datamanagement::CellMarker& marker,
  const T* NOALIAS                          coarseGridValues,
  T* NOALIAS                                fineGridValues,
  const double* NOALIAS                     interpolationMatrix1d,
  const int                                 numberOfDofsPerAxis,
  const int                                 numberOfUnknownsPlusAuxiliaryVariables
) {
  const auto subcellIndex = marker.getRelativePositionWithinFatherCell();
  peano4::dForEach(numberOfDofsPerAxis, [&](const tarch::la::Vector<DIMENSIONS, int>& fineNode) {
    const int fineIndex = peano4::dLinearised(fineNode, numberOfDofsPerAxis) * numberOfUnknownsPlusAuxiliaryVariables;
    for (int unknown = 0; unknown < numberOfUnknownsPlusAuxiliaryVariables; unknown++) {
      fineGridValues[fineIndex + unknown] = 0.0;
    }
    peano4::dForEach(numberOfDofsPerAxis, [&](const tarch::la::Vector<DIMENSIONS, int>& coarseNode) {
      double weight = 1.0;
      for (int d = 0; d < DIMENSIONS; d++) {
        weight *= interpolationMatrix1d
          [subcellIndex(d) * numberOfDofsPerAxis * numberOfDofsPerAxis + fineNode(d) * numberOfDofsPerAxis
           + coarseNode(d)];
      }
      const int coarseIndex = peano4::dLinearised(coarseNode, numberOfDofsPerAxis) * numberOfUnknownsPlusAuxiliaryVariables;
      // The matrix holds doubles whatever the patch is stored in, so the product forms in
      // double and only the stored result narrows back to T.
      for (int unknown = 0; unknown < numberOfUnknownsPlusAuxiliaryVariables; unknown++) {
        const double accumulated = static_cast<double>(fineGridValues[fineIndex + unknown])
          + weight * static_cast<double>(coarseGridValues[coarseIndex + unknown]);
        fineGridValues[fineIndex + unknown] = static_cast<T>(accumulated);
      }
    });
  });
}

/**
 * Average the fine cell values back onto the coarse cell.
 *
 * The coarse cell must contain all zeroes before the restriction, as the routine cannot
 * know in which order the fine cells restrict into it.
 */
template <typename T>
INLINE_METHOD void toolbox::blockstructured::restrictCell(
  const peano4::datamanagement::CellMarker& marker,
  T* NOALIAS                                coarseGridValues,
  const T* NOALIAS                          fineGridValues,
  const int                                 numberOfDofsPerAxis,
  const int                                 numberOfUnknownsPlusAuxiliaryVariables
) {
  static_assert(std::is_floating_point_v<T>, "Averaging restriction requires a floating-point type");
#if DIMENSIONS == 3
  constexpr T Scale = 1. / 27.;
  for (int z = 0; z < numberOfDofsPerAxis; z++) {
    const auto zPos = numberOfDofsPerAxis * numberOfDofsPerAxis
      * ((z + numberOfDofsPerAxis * marker.getRelativePositionWithinFatherCell()[2]) / 3);
#else
  constexpr T Scale = 1. / 9.;
  {
    constexpr int z    = 0;
    constexpr int zPos = 0;
#endif
    for (int y = 0; y < numberOfDofsPerAxis; y++) {
      const auto yPos =
        numberOfDofsPerAxis * ((y + numberOfDofsPerAxis * marker.getRelativePositionWithinFatherCell()[1]) / 3);
      for (int x = 0; x < numberOfDofsPerAxis; x++) {
        const auto xPos = (x + numberOfDofsPerAxis * marker.getRelativePositionWithinFatherCell()[0]) / 3;
        for (int u = 0; u < numberOfUnknownsPlusAuxiliaryVariables; u++) {
          coarseGridValues[(zPos + yPos + xPos) * numberOfUnknownsPlusAuxiliaryVariables + u] += Scale
            * fineGridValues[(z * numberOfDofsPerAxis * numberOfDofsPerAxis + y * numberOfDofsPerAxis + x) * numberOfUnknownsPlusAuxiliaryVariables
                             + u];
        }
      }
    }
  }
}

/**
 * Matrix-based restriction for nodal (e.g. discontinuous Galerkin) cell data.
 *
 * restrictionMatrix1d holds, per child interval b, the coarse one-dimensional shape
 * functions evaluated at the child's nodes over the child width: entry
 * [b * n * n + coarse * n + fine] is phi_coarse at the fine node divided by three.
 * Weighting each fine node with its quadrature weight and dividing by the coarse
 * node's weight turns that into the mass-lumped L2 projection of the child
 * polynomial, so the sum over all 3^d children reproduces every polynomial the
 * coarse basis represents exactly. The coarse cell must contain all zeroes before
 * its first child restricts into it.
 */
template <typename T>
INLINE_METHOD void toolbox::blockstructured::restrictCell(
  const peano4::datamanagement::CellMarker& marker,
  T* NOALIAS                                coarseGridValues,
  const T* NOALIAS                          fineGridValues,
  const double* NOALIAS                     restrictionMatrix1d,
  const double* NOALIAS                     quadratureWeights1d,
  const int                                 numberOfDofsPerAxis,
  const int                                 numberOfUnknownsPlusAuxiliaryVariables
) {
  static_assert(std::is_floating_point_v<T>, "The mass-lumped projection requires a floating-point type");
  const auto subcellIndex = marker.getRelativePositionWithinFatherCell();
  peano4::dForEach(numberOfDofsPerAxis, [&](const tarch::la::Vector<DIMENSIONS, int>& coarseNode) {
    const int coarseIndex = peano4::dLinearised(coarseNode, numberOfDofsPerAxis) * numberOfUnknownsPlusAuxiliaryVariables;
    peano4::dForEach(numberOfDofsPerAxis, [&](const tarch::la::Vector<DIMENSIONS, int>& fineNode) {
      double weight = 1.0;
      for (int d = 0; d < DIMENSIONS; d++) {
        weight *= restrictionMatrix1d
                    [subcellIndex(d) * numberOfDofsPerAxis * numberOfDofsPerAxis + coarseNode(d) * numberOfDofsPerAxis
                     + fineNode(d)]
          * quadratureWeights1d[fineNode(d)] / quadratureWeights1d[coarseNode(d)];
      }
      const int fineIndex = peano4::dLinearised(fineNode, numberOfDofsPerAxis) * numberOfUnknownsPlusAuxiliaryVariables;
      // The matrix holds doubles whatever the patch is stored in, so the product forms in
      // double and only the stored result narrows back to T.
      for (int unknown = 0; unknown < numberOfUnknownsPlusAuxiliaryVariables; unknown++) {
        const double accumulated = static_cast<double>(coarseGridValues[coarseIndex + unknown])
          + weight * static_cast<double>(fineGridValues[fineIndex + unknown]);
        coarseGridValues[coarseIndex + unknown] = static_cast<T>(accumulated);
      }
    });
  });
}
