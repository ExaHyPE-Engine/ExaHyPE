  tarch::la::DynamicMatrix* P = faceInterpolationMap[key];
  lock.free();

#if DIMENSIONS == 2
  const int patchSize = numberOfDoFsPerAxisInPatch * 2 * overlap;
#else
  const int patchSize = numberOfDoFsPerAxisInPatch * numberOfDoFsPerAxisInPatch
                        * 2 * overlap;
