INLINE_METHOD GPU_CALLABLE_METHOD int toolbox::blockstructured::serialiseVoxelIndexInOverlap(
  const tarch::la::Vector<DIMENSIONS, int>& overlapCell,
  int                                       numberOfDofsPerAxis,
  int                                       overlap,
  int                                       normal
) {
  assertion(normal >= 0, overlapCell, numberOfDofsPerAxis, overlap, normal);
  assertion(normal < DIMENSIONS, overlapCell, numberOfDofsPerAxis, overlap, normal);
  int base   = 1;
  int result = 0;
  for (int d = 0; d < DIMENSIONS; d++) {
    result += overlapCell(d) * base;
    if (d == normal) {
      assertion(overlapCell(d) >= 0, overlapCell, numberOfDofsPerAxis, overlap, normal);
      assertion(overlapCell(d) < 2 * overlap, overlapCell, numberOfDofsPerAxis, overlap, normal);
      base *= overlap * 2;
    } else {
      assertion(overlapCell(d) >= 0, overlapCell, numberOfDofsPerAxis, overlap, normal);
      assertion(overlapCell(d) < numberOfDofsPerAxis, overlapCell, numberOfDofsPerAxis, overlap, normal);
      base *= numberOfDofsPerAxis;
    }
  }
  return result;
}
