INLINE_METHOD runner::SolverStatistic runner::makeValueStatistic(const char* const label, const double value) {
  return {label, SolverStatistic::Kind::Value, value, value, 0};
}

INLINE_METHOD runner::SolverStatistic runner::makeRangeStatistic(
  const char* const label,
  const double      minimum,
  const double      maximum
) {
  return {label, SolverStatistic::Kind::Value, minimum, maximum, 0};
}

INLINE_METHOD runner::SolverStatistic runner::makeCountStatistic(const char* const label, const long value) {
  return {label, SolverStatistic::Kind::Count, 0.0, 0.0, value};
}

template <typename Solver, typename AppendAdditionalStatistics>
INLINE_METHOD std::pair<std::string, std::vector<runner::SolverStatistic>> runner::makeSolverStatistics(
  const char* const                 solverName,
  const Solver&                     solver,
  const AppendAdditionalStatistics& appendAdditionalStatistics
) {
  std::vector<SolverStatistic> statistics;
  statistics.push_back(makeValueStatistic("dt", solver.getMinTimeStepSize()));
  statistics.push_back(makeRangeStatistic("h", solver.getMinCellSize(), solver.getMaxCellSize()));
  appendAdditionalStatistics(statistics);
  if constexpr (requires { solver.getMaxEigenvalue(); }) {
    statistics.push_back(makeValueStatistic("λ_max", solver.getMaxEigenvalue()));
  }
  if constexpr (requires { solver.getNumberOfTroubledCells(); }) {
    if (solver.getNumberOfTroubledCells() > 0) {
      statistics.push_back(makeCountStatistic("Troubled", solver.getNumberOfTroubledCells()));
    }
  }
  return {solverName, statistics};
}

INLINE_METHOD std::pair<std::string, std::vector<runner::SolverStatistic>> runner::makeParticleStatistics(
  const char* const particleName,
  const int         numberOfParticles
) {
  return {particleName, {makeCountStatistic("Particles", numberOfParticles)}};
}
