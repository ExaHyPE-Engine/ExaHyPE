INLINE_METHOD bool peano4::grid::GridTraversalEvent::bitTest8(const std::uint8_t mask, const int bitNumber) noexcept {
  assertion(bitNumber >= 0 and bitNumber < 8, bitNumber);
  return ((mask >> bitNumber) & 1U) != 0U;
}

INLINE_METHOD void peano4::grid::GridTraversalEvent::bitSet8(
  std::uint8_t& mask,
  const int     bitNumber,
  const bool    value
) noexcept {
  assertion(bitNumber >= 0 and bitNumber < 8, bitNumber);
  const auto bit = static_cast<std::uint8_t>(1U << bitNumber);
  mask           = value ? (mask | bit) : (mask & ~bit);
}

INLINE_METHOD bool peano4::grid::GridTraversalEvent::bitTest32(const std::uint32_t mask, const int bitNumber) noexcept {
  assertion(bitNumber >= 0 and bitNumber < 32, bitNumber);
  return ((mask >> bitNumber) & 1U) != 0U;
}

INLINE_METHOD void peano4::grid::GridTraversalEvent::bitSet32(
  std::uint32_t& mask,
  const int      bitNumber,
  const bool     value
) noexcept {
  assertion(bitNumber >= 0 and bitNumber < 32, bitNumber);
  const auto bit = static_cast<std::uint32_t>(1U << bitNumber);
  mask           = value ? (mask | bit) : (mask & ~bit);
}

