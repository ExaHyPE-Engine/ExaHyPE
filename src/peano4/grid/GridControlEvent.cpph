INLINE_METHOD peano4::grid::GridControlEvent::RefinementControl peano4::grid::GridControlEvent::
  getRefinementControl() const noexcept {
  return static_cast<RefinementControl>(refinementControl);
}

INLINE_METHOD void peano4::grid::GridControlEvent::setRefinementControl(const RefinementControl value) noexcept {
  refinementControl = static_cast<std::uint8_t>(value);
}
