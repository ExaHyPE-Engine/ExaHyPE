/**
 * Creates a container with the exchange identifier @p containerId.
 *
 * Every rank assigns these identifiers in the same order.
 */
template <class StackType>
peano4::grid::StackContainer<StackType>::StackContainer(const int containerId) :
  _containerId(containerId) {
  assertion(containerId >= 0, containerId);
}

template <class StackType>
INLINE_METHOD int peano4::grid::StackContainer<StackType>::getContainerId() const {
  return _containerId;
}

template <class StackType>
INLINE_METHOD peano4::grid::BoundaryDataAggregation<StackType>& peano4::grid::StackContainer<
  StackType>::getBoundaryDataAggregation() {
  return _boundaryDataAggregation;
}

/**
 * Returns one element of the flat per-rank pool.
 *
 * Traversal slot identifiers may contain gaps and differ from entity indices.
 */
template <class StackType>
INLINE_METHOD typename peano4::grid::StackContainer<StackType>::ElementType& peano4::grid::StackContainer<
  StackType>::getPoolSlot(const int poolIndex) {
  assertion(poolIndex >= 0 and poolIndex < static_cast<int>(_pool.size()), poolIndex, _pool.size(), _containerId);
  return _pool[poolIndex];
}

/**
 * Returns the first pool element for slot-based indexing.
 */
template <class StackType>
INLINE_METHOD typename peano4::grid::StackContainer<StackType>::ElementType* peano4::grid::StackContainer<
  StackType>::getPoolData() {
  assertion(not _pool.empty(), _containerId);
  return _pool.data();
}

/**
 * Returns the slot used for positions without a rank-local entity.
 */
template <class StackType>
INLINE_METHOD int peano4::grid::StackContainer<StackType>::getSentinelSlot() const {
  assertion(not _pool.empty(), _containerId);
  return static_cast<int>(_pool.size()) - 1;
}

template <class StackType>
INLINE_METHOD std::size_t peano4::grid::StackContainer<StackType>::getPoolSize() const {
  return _pool.size();
}

/**
 * Resizes the entity slots and appends a cleared sentinel.
 *
 * With @p bindPooledData the pooled element types are rebound after the
 * resize; a caller that defers the payload allocation calls bindPool() later.
 */
template <class StackType>
void peano4::grid::StackContainer<StackType>::resizePool(const std::size_t entityCount, const bool bindPooledData) {
  [[maybe_unused]] constexpr auto MaximumPoolSize = static_cast<std::size_t>(std::numeric_limits<int>::max());
  assertion(entityCount < MaximumPoolSize, entityCount, MaximumPoolSize, _containerId);
  _pool.resize(entityCount + 1);
  if (bindPooledData) {
    bindPooledStorage();
  }
  resetSentinel();
  assertion(_pool.size() == entityCount + 1, _pool.size(), entityCount, _containerId);
}

/**
 * Binds pooled element types to the chunks backing their slots.
 */
template <class StackType>
void peano4::grid::StackContainer<StackType>::bindPool() {
  bindPooledStorage();
  resetSentinel();
}

template <class StackType>
void peano4::grid::StackContainer<StackType>::bindPooledStorage() {
  if constexpr (requires(std::vector<ElementType>& slots) { ElementType::bindPoolStorage(slots); }) {
    ElementType::bindPoolStorage(_pool);
  }
}

/**
 * Clears the sentinel after an operation that may replace its slot.
 */
template <class StackType>
void peano4::grid::StackContainer<StackType>::resetSentinel() {
  if (_pool.empty()) {
    return;
  }
  if constexpr (requires(ElementType& element) { element.clearValues(); }) {
    _pool.back().clearValues();
  } else {
    _pool.back() = ElementType{};
  }
}

/**
 * Carries the pool across a regrid in place. An entity keeping its slot
 * needs no copy at all, so only the pairs whose source and target differ
 * stage their data and land on the target after the resize; the staging
 * makes arbitrary overlaps of the source and target ranges safe.
 */
template <class StackType>
void peano4::grid::StackContainer<StackType>::migratePoolSlots(
  const std::vector<std::pair<int, int>>& sourceAndTargetSlots,
  const std::size_t                       entityCount,
  const bool                              bindPooledData
) {
  [[maybe_unused]] constexpr auto MaximumPoolSize = static_cast<std::size_t>(std::numeric_limits<int>::max());
  assertion(entityCount < MaximumPoolSize, entityCount, MaximumPoolSize, _containerId);
  assertion(_pool.size() <= MaximumPoolSize, _pool.size(), MaximumPoolSize, _containerId);
  assertion(sourceAndTargetSlots.size() <= MaximumPoolSize, sourceAndTargetSlots.size(), MaximumPoolSize, _containerId);
  std::vector<ElementType> stagedData;
  std::vector<int>         stagedTargets;
  stagedData.reserve(sourceAndTargetSlots.size());
  stagedTargets.reserve(sourceAndTargetSlots.size());
  for (const auto& [sourceSlot, targetSlot] : sourceAndTargetSlots) {
    assertion(sourceSlot >= 0 and static_cast<std::size_t>(sourceSlot) < _pool.size(), sourceSlot, _pool.size());
    assertion(targetSlot >= 0 and static_cast<std::size_t>(targetSlot) < entityCount, targetSlot, entityCount);
    if (sourceSlot != targetSlot) {
      stagedData.push_back(_pool[sourceSlot]);
      stagedTargets.push_back(targetSlot);
    }
  }
  if (entityCount + 1 > _pool.capacity()) {
    _pool.reserve(std::max(entityCount + 1, 2 * _pool.size()));
  }
  _pool.resize(entityCount + 1);
  // Binding precedes assignment because a resize can invalidate pooled pointers.
  if (bindPooledData) {
    bindPooledStorage();
  }
  if (not stagedTargets.empty()) {
    tarch::accelerator::parallelForOnHost(
      tarch::accelerator::Range(static_cast<int>(stagedTargets.size())),
      [this, &stagedData, &stagedTargets](const int pairNumber) {
        assertion(pairNumber >= 0 and static_cast<std::size_t>(pairNumber) < stagedTargets.size(), pairNumber);
        _pool[stagedTargets[pairNumber]] = std::move(stagedData[pairNumber]);
      }
    );
  }
  resetSentinel();
  assertion(_pool.size() == entityCount + 1, _pool.size(), entityCount, _containerId);
}

/**
 * Replicates source slots into target slots and grows the pool when required.
 */
template <class StackType>
void peano4::grid::StackContainer<StackType>::replicatePoolSlots(
  const std::vector<std::pair<int, int>>& sourceAndTargetSlots,
  const int                               chunkNumber,
  const int                               numberOfChunks
) {
  assertion(chunkNumber >= 0 and chunkNumber < numberOfChunks, chunkNumber, numberOfChunks);
  const auto numberOfPairs = static_cast<std::int64_t>(sourceAndTargetSlots.size());
  const auto firstPair     = numberOfPairs * chunkNumber / numberOfChunks;
  const auto endPair       = numberOfPairs * (chunkNumber + 1) / numberOfChunks;
  for (auto pairNumber = firstPair; pairNumber < endPair; pairNumber++) {
    const auto& [sourceSlot, targetSlot] = sourceAndTargetSlots[pairNumber];
    assertion(sourceSlot >= 0 and sourceSlot < static_cast<int>(_pool.size()), sourceSlot, _pool.size());
    assertion(targetSlot >= 0 and targetSlot < static_cast<int>(_pool.size()), targetSlot, _pool.size());
    _pool[targetSlot] = _pool[sourceSlot];
  }
}

/**
 * Clears entity and boundary storage.
 */
template <class StackType>
void peano4::grid::StackContainer<StackType>::clear() {
  _pool.clear();
  _boundaryDataAggregation.clear();
}
