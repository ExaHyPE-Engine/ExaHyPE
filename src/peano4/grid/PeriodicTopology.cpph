INLINE_METHOD constexpr peano4::grid::PeriodicSide peano4::grid::opposite(PeriodicSide side) {
  return side == PeriodicSide::Low ? PeriodicSide::High : PeriodicSide::Low;
}

INLINE_METHOD constexpr int peano4::grid::toIndex(PeriodicSide side) { return static_cast<int>(side); }

/**
 * Number of cells per axis on a given level. Peano is three-refined, so this
 * is @f$ 3^{level} @f$.
 */
INLINE_METHOD constexpr int peano4::grid::cellsPerAxis(int level) {
  int result = 1;
  for (int i = 0; i < level; i++) {
    result *= 3;
  }
  return result;
}

/**
 * Exact integer cell index of a child given its parent's index and the
 * child's position within the 3x3(x3) refinement block: child = 3 * parent +
 * childPositionInParent, with childPositionInParent[d] in {0,1,2}. Carried
 * through the traversal this yields an exact, coordinate-free cell identity
 * at any depth.
 */
INLINE_METHOD tarch::la::Vector<DIMENSIONS, int> peano4::grid::childCellIndex(
  const tarch::la::Vector<DIMENSIONS, int>& parentCellIndex,
  const tarch::la::Vector<DIMENSIONS, int>& childPositionInParent
) {
  tarch::la::Vector<DIMENSIONS, int> result;
  for (int d = 0; d < DIMENSIONS; d++) {
    assertion(childPositionInParent(d) >= 0 and childPositionInParent(d) < 3, d, childPositionInParent(d));
    result(d) = parentCellIndex(d) * 3 + childPositionInParent(d);
  }
  return result;
}

/**
 * Integer index of vertex number vertexNumber of the cell at cellIndex. Bit
 * d of vertexNumber selects the low (0) or high (1) corner along axis d,
 * matching GridVertex::getVertexCoordinate().
 */
INLINE_METHOD tarch::la::Vector<DIMENSIONS, int>
peano4::grid::vertexIndexOfCellVertex(const tarch::la::Vector<DIMENSIONS, int>& cellIndex, int vertexNumber) {
  tarch::la::Vector<DIMENSIONS, int> result = cellIndex;
  for (int d = 0; d < DIMENSIONS; d++) {
    if ((vertexNumber & (1 << d)) != 0) {
      result(d)++;
    }
  }
  return result;
}

INLINE_METHOD bool peano4::grid::PeriodicKey::operator!=(const PeriodicKey& rhs) const { return not(*this == rhs); }

/**
 * True if an entry carrying this stamp is the wrapped partner of a reader
 * holding readerStamp: equal key, opposite side.
 */
INLINE_METHOD bool peano4::grid::PeriodicStamp::matchesPartnerOf(const PeriodicStamp& readerStamp) const {
  return key == readerStamp.key and side != readerStamp.side;
}
