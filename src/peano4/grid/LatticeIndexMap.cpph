#include "tarch/Assertions.h"

/**
 * Returns the slot a key probes first. Neighbouring lattice positions differ in their low bits only.
 * A multiply-shift finaliser spreads these bits over the word before the mask.
 */
INLINE_METHOD std::size_t
peano4::grid::LatticeIndexMap::getFirstSlot(const std::int64_t key) const {
  constexpr int           MixShift     = 33;
  constexpr std::uint64_t FirstFactor  = 0xFF51AFD7ED558CCDULL;
  constexpr std::uint64_t SecondFactor = 0xC4CEB9FE1A85EC53ULL;

  auto mixed = static_cast<std::uint64_t>(key);
  mixed ^= mixed >> MixShift;
  mixed *= FirstFactor;
  mixed ^= mixed >> MixShift;
  mixed *= SecondFactor;
  mixed ^= mixed >> MixShift;
  return static_cast<std::size_t>(mixed) & _slotMask;
}

/**
 * Returns the value stored for a key, or NoEntry.
 */
INLINE_METHOD int
peano4::grid::LatticeIndexMap::find(const std::int64_t key) const {
  assertion(key >= 0, key);
  if (_keys.empty()) {
    return NoEntry;
  }
  auto slot = getFirstSlot(key);
  while (true) {
    const auto occupant = _keys[slot];
    if (occupant == key) {
      return _values[slot];
    }
    if (occupant == EmptyKey) {
      return NoEntry;
    }
    slot = (slot + 1) & _slotMask;
  }
}

/**
 * Stores value under key unless the map already has the key. Returns the value stored afterwards
 * and whether this call stored it. A new entry reuses the first tombstone of its probe chain.
 */
INLINE_METHOD std::pair<int, bool>
peano4::grid::LatticeIndexMap::insert(const std::int64_t key, const int value) {
  assertion(key >= 0, key);
  // Half the slots stay free and keep a probe run short.
  if (2 * (_size + _numberOfTombstones + 1) > _keys.size()) {
    grow();
  }
  auto        slot          = getFirstSlot(key);
  std::size_t insertionSlot = _keys.size();
  while (true) {
    const auto occupant = _keys[slot];
    if (occupant == key) {
      return {_values[slot], false};
    }
    if (occupant == TombstoneKey and insertionSlot == _keys.size()) {
      insertionSlot = slot;
    }
    if (occupant == EmptyKey) {
      if (insertionSlot == _keys.size()) {
        insertionSlot = slot;
      } else {
        _numberOfTombstones--;
      }
      _keys[insertionSlot]   = key;
      _values[insertionSlot] = value;
      _size++;
      return {value, true};
    }
    slot = (slot + 1) & _slotMask;
  }
}

/**
 * Removes a key and returns whether the map had it. The slot becomes a tombstone. Probe chains
 * across it stay intact until the next growth.
 */
INLINE_METHOD bool
peano4::grid::LatticeIndexMap::erase(const std::int64_t key) {
  assertion(key >= 0, key);
  if (_keys.empty()) {
    return false;
  }
  auto slot = getFirstSlot(key);
  while (true) {
    const auto occupant = _keys[slot];
    if (occupant == key) {
      _keys[slot]   = TombstoneKey;
      _values[slot] = NoEntry;
      _size--;
      _numberOfTombstones++;
      return true;
    }
    if (occupant == EmptyKey) {
      return false;
    }
    slot = (slot + 1) & _slotMask;
  }
}

INLINE_METHOD std::size_t
peano4::grid::LatticeIndexMap::getSize() const {
  return _size;
}

INLINE_METHOD std::size_t
peano4::grid::LatticeIndexMap::getAllocatedBytes() const {
  return _keys.capacity() * sizeof(std::int64_t) + _values.capacity() * sizeof(int);
}

/**
 * Calls callback(key, value) for every entry in slot order. The slot order depends on the hash and
 * on the insertion order.
 */
template <typename Callback>
INLINE_METHOD void
peano4::grid::LatticeIndexMap::forEachEntry(const Callback& callback) const {
  for (std::size_t slot = 0; slot < _keys.size(); slot++) {
    if (_keys[slot] != EmptyKey and _keys[slot] != TombstoneKey) {
      callback(_keys[slot], _values[slot]);
    }
  }
}
