inline GPUCallableMethod int peano4::utils::dCmp(
  const tarch::la::Vector<Dimensions, int>& counter,
  const tarch::la::Vector<Dimensions, int>& max
) {
  int result = true;
  for (int i = 0; i < Dimensions; i++) {
#if defined(GPUOffloadingOff) and !defined(SharedSYCL)
    assertion2(counter(i) <= max(i), counter, max);
    assertion2(counter(i) >= 0, counter, max);
#endif
    result &= (counter(i) < max(i));
  }
  return result;
}

inline GPUCallableMethod int peano4::utils::dCmp(const tarch::la::Vector<Dimensions, int>& counter, int max) {
  int result = true;
  for (int i = 0; i < Dimensions; i++) {
#if defined(GPUOffloadingOff) and !defined(SharedSYCL)
    assertion2(counter(i) <= max, counter, max);
    assertion2(counter(i) >= 0, counter, max);
#endif
    result &= (counter(i) < max);
  }
  return result;
}

inline GPUCallableMethod bool peano4::utils::dCmpLinearOrder(
  const tarch::la::Vector<Dimensions, int>& counter,
  const tarch::la::Vector<Dimensions, int>& max
) {
  for (int i = Dimensions - 1; i >= 0; i--) {
    if (counter(i) > max(i)) {
      return false;
    } else if (counter(i) < max(i)) {
      return true;
    }
  }
  return false;
}
