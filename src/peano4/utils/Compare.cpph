INLINE_METHOD GPU_CALLABLE_METHOD int peano4::utils::dCmp(
  const tarch::la::Vector<DIMENSIONS, int>& counter,
  const tarch::la::Vector<DIMENSIONS, int>& max
) {
  int result = true;
  for (int i = 0; i < DIMENSIONS; i++) {
#if !defined(WITH_GPU)
    assertion2(counter(i) <= max(i), counter, max);
    assertion2(counter(i) >= 0, counter, max);
#endif
    result &= (counter(i) < max(i));
  }
  return result;
}

INLINE_METHOD GPU_CALLABLE_METHOD int peano4::utils::dCmp(const tarch::la::Vector<DIMENSIONS, int>& counter, int max) {
  int result = true;
  for (int i = 0; i < DIMENSIONS; i++) {
#if !defined(WITH_GPU)
    assertion2(counter(i) <= max, counter, max);
    assertion2(counter(i) >= 0, counter, max);
#endif
    result &= (counter(i) < max);
  }
  return result;
}

INLINE_METHOD GPU_CALLABLE_METHOD bool peano4::utils::dCmpLinearOrder(
  const tarch::la::Vector<DIMENSIONS, int>& counter,
  const tarch::la::Vector<DIMENSIONS, int>& max
) {
  for (int i = DIMENSIONS - 1; i >= 0; i--) {
    if (counter(i) > max(i)) {
      return false;
    } else if (counter(i) < max(i)) {
      return true;
    }
  }
  return false;
}
