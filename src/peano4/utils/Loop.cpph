inline GPUCallableMethod tarch::la::Vector<Dimensions, int> peano4::utils::dStartVector() {
  tarch::la::Vector<Dimensions, int> result(0);
  return result;
}

inline GPUCallableMethod tarch::la::Vector<Dimensions, int> peano4::utils::dStartVector(int dim, int value) {
  tarch::la::Vector<Dimensions, int> result(0);
#if defined(GPUOffloadingOff) and !defined(SharedSYCL)
  assertion2(dim >= 0, dim, value);
  assertion2(dim < Dimensions, dim, value);
  assertion2(value >= 0, dim, value);
#endif
  result(dim) = value;
  return result;
}

inline GPUCallableMethod tarch::la::Vector<Dimensions, int> peano4::utils::dStartVector(
  int                  max,
  const LoopDirection& direction
) {
  tarch::la::Vector<Dimensions, int> result;
#if defined(GPUOffloadingOff) and !defined(SharedSYCL)
  assertion2(max > 0 && max <= 3, max, direction);
#endif
  for (int i = 0; i < Dimensions; i++) {
    if (direction[i]) {
      result(i) = 0;
    } else {
      result(i) = max - 1;
    }
  }
  return result;
}
