INLINE_METHOD GPU_CALLABLE_METHOD tarch::la::Vector<DIMENSIONS, int> peano4::utils::dStartVector() {
  tarch::la::Vector<DIMENSIONS, int> result(0);
  return result;
}

INLINE_METHOD GPU_CALLABLE_METHOD tarch::la::Vector<DIMENSIONS, int> peano4::utils::dStartVector(int dim, int value) {
  tarch::la::Vector<DIMENSIONS, int> result(0);
#if !defined(WITH_GPU)
  assertion2(dim >= 0, dim, value);
  assertion2(dim < DIMENSIONS, dim, value);
  assertion2(value >= 0, dim, value);
#endif
  result(dim) = value;
  return result;
}

INLINE_METHOD tarch::la::Vector<DIMENSIONS, int> peano4::utils::dStartVector(int max, const LoopDirection& direction) {
  tarch::la::Vector<DIMENSIONS, int> result;
#if !defined(WITH_GPU)
  assertion2(max > 0 && max <= 3, max, direction);
#endif
  for (int i = 0; i < DIMENSIONS; i++) {
    if (direction[i]) {
      result(i) = 0;
    } else {
      result(i) = max - 1;
    }
  }
  return result;
}
