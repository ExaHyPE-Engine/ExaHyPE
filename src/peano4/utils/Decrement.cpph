inline GPU_CALLABLE_METHOD void peano4::utils::dDec(tarch::la::Vector<DIMENSIONS, int>& counter, int max) {
#if !defined(WITH_GPU)
  for (int i = 0; i < DIMENSIONS - 1; i++) {
    assertion(counter(i) >= 0);
  }
#endif

  counter(0)--;
  for (int i = 0; i < DIMENSIONS - 1; i++) {
    if (counter(i) < 0) {
      counter(i) = max - 1;
      counter(i + 1)--;
    }
  }
}
