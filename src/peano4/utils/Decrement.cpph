inline GPUCallableMethod void peano4::utils::dDec(tarch::la::Vector<Dimensions, int>& counter, int max) {
#if defined(GPUOffloadingOff) and !defined(SharedSYCL)
  for (int i = 0; i < Dimensions - 1; i++) {
    assertion(counter(i) >= 0);
  }
#endif

  counter(0)--;
  for (int i = 0; i < Dimensions - 1; i++) {
    if (counter(i) < 0) {
      counter(i) = max - 1;
      counter(i + 1)--;
    }
  }
}
