INLINE_METHOD constexpr int peano4::sfc::Grammar::axisOf(const Step step) { return static_cast<int>(step) / 2; }

INLINE_METHOD constexpr int peano4::sfc::Grammar::directionOf(const Step step) {
  return static_cast<int>(step) % 2 == 0 ? -1 : 1;
}

/**
 * Builds one production from its textbook form: The left-hand side followed
 * by the right-hand side, in which child non-terminals and turtle steps
 * alternate. Every symbol's type is checked against its position, so a step
 * in a child slot or a child in a step slot does not compile.
 */
template <class NonTerminal, class... Symbols>
constexpr peano4::sfc::Production<NonTerminal, (sizeof...(Symbols) + 1) / 2> peano4::sfc::Grammar::production(
  NonTerminal leftHandSide,
  Symbols... symbols
) {
  static_assert(sizeof...(Symbols) % 2 == 1, "A right-hand side alternates children and steps and ends with a child.");
  peano4::sfc::Production<NonTerminal, (sizeof...(Symbols) + 1) / 2> result{leftHandSide, {}, {}};
  const auto place = [&result](const auto position, const auto symbol) {
    constexpr std::size_t Position = decltype(position)::value;
    if constexpr (Position % 2 == 0) {
      static_assert(std::is_same_v<decltype(symbol), const NonTerminal>, "Even positions hold child non-terminals.");
      result.children[Position / 2] = symbol;
    } else {
      static_assert(std::is_same_v<decltype(symbol), const Step>, "Odd positions hold turtle steps.");
      result.steps[Position / 2] = symbol;
    }
  };
  [&place, symbols...]<std::size_t... Positions>(std::index_sequence<Positions...> positions) {
    (place(std::integral_constant<std::size_t, Positions>{}, symbols), ...);
  }(std::index_sequence_for<Symbols...>{});
  return result;
}
