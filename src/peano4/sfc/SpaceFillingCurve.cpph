#include "tarch/Assertions.h"

template <class CurveGrammar>
INLINE_METHOD tarch::la::Vector<DIMENSIONS, int>
peano4::sfc::SpaceFillingCurve<CurveGrammar>::Child::getPositionWithinParent() const {
  tarch::la::Vector<DIMENSIONS, int> result;
  for (int axis = 0; axis < DIMENSIONS; axis++) {
    result(axis) = position[axis];
  }
  return result;
}

/**
 * Returns the children of a cell in curve order for one curve state.
 */
template <class CurveGrammar>
INLINE_METHOD const typename peano4::sfc::SpaceFillingCurve<CurveGrammar>::ChildSequence&
peano4::sfc::SpaceFillingCurve<CurveGrammar>::getChildren(const int state) {
  static constexpr ChildOrder Table{deriveChildOrder()};
  assertion(state >= 0 and state < NumberOfStates, state);
  return Table[state];
}

template <class CurveGrammar>
INLINE_METHOD constexpr typename peano4::sfc::SpaceFillingCurve<CurveGrammar>::ChildOrder
peano4::sfc::SpaceFillingCurve<CurveGrammar>::deriveChildOrder() {
  ChildOrder result{};
  for (int state = 0; state < NumberOfStates; state++) {
    const auto positions = getPositions(state);
    for (int child = 0; child < ChildrenPerCell; child++) {
      int linearisedPosition = 0;
      int stride             = 1;
      for (int axis = 0; axis < DIMENSIONS; axis++) {
        linearisedPosition += positions[child][axis] * stride;
        stride *= SubdivisionFactor;
        result[state][child].position[axis] = static_cast<std::uint8_t>(positions[child][axis]);
      }
      result[state][child].linearisedPosition = static_cast<std::uint8_t>(linearisedPosition);
      result[state][child].state = static_cast<std::uint8_t>(CurveGrammar::Productions[state].children[child]);
    }
  }
  return result;
}

template <class CurveGrammar>
INLINE_METHOD constexpr bool
peano4::sfc::SpaceFillingCurve<CurveGrammar>::productionsAreInSymbolOrder() {
  for (int state = 0; state < NumberOfStates; state++) {
    if (static_cast<int>(CurveGrammar::Productions[state].leftHandSide) != state) {
      return false;
    }
  }
  return true;
}

/**
 * Returns whether the turtle walk of every production stays within DIMENSIONS axes and visits every
 * child position once.
 */
template <class CurveGrammar>
INLINE_METHOD constexpr bool
peano4::sfc::SpaceFillingCurve<CurveGrammar>::everyProductionTilesTheCell() {
  for (int state = 0; state < NumberOfStates; state++) {
    for (const auto step : CurveGrammar::Productions[state].steps) {
      if (peano4::sfc::Grammar::getAxis(step) >= DIMENSIONS) {
        return false;
      }
    }
    std::array<bool, ChildrenPerCell> visited{};
    for (const auto& position : getPositions(state)) {
      int linearisedPosition = 0;
      int stride             = 1;
      for (int axis = 0; axis < DIMENSIONS; axis++) {
        if (position[axis] >= SubdivisionFactor) {
          return false;
        }
        linearisedPosition += position[axis] * stride;
        stride *= SubdivisionFactor;
      }
      if (visited[linearisedPosition]) {
        return false;
      }
      visited[linearisedPosition] = true;
    }
  }
  return true;
}

/**
 * Returns whether, within every production, the exit point of each child meets the entry point of
 * the next child.
 */
template <class CurveGrammar>
INLINE_METHOD constexpr bool
peano4::sfc::SpaceFillingCurve<CurveGrammar>::childrenConnect() {
  constexpr double ConnectionTolerance = 1e-9;
  const auto       entryPoints         = getLimitPointsWithin(0);
  const auto       exitPoints          = getLimitPointsWithin(ChildrenPerCell - 1);
  for (int state = 0; state < NumberOfStates; state++) {
    const auto& production = CurveGrammar::Productions[state];
    const auto  positions  = getPositions(state);
    for (int child = 0; child + 1 < ChildrenPerCell; child++) {
      const auto exitState  = static_cast<int>(production.children[child]);
      const auto entryState = static_cast<int>(production.children[child + 1]);
      for (int axis = 0; axis < DIMENSIONS; axis++) {
        const double exitPoint  = positions[child][axis] + exitPoints[exitState][axis];
        const double entryPoint = positions[child + 1][axis] + entryPoints[entryState][axis];
        const double difference = exitPoint > entryPoint ? exitPoint - entryPoint : entryPoint - exitPoint;
        if (difference > ConnectionTolerance) {
          return false;
        }
      }
    }
  }
  return true;
}

/**
 * Returns the child positions that the turtle steps of one production visit, shifted so that the
 * lowest position is the origin.
 */
template <class CurveGrammar>
INLINE_METHOD constexpr std::array<
  typename peano4::sfc::SpaceFillingCurve<CurveGrammar>::Position,
  peano4::sfc::SpaceFillingCurve<CurveGrammar>::ChildrenPerCell
>
peano4::sfc::SpaceFillingCurve<CurveGrammar>::getPositions(const int state) {
  const auto&                           production = CurveGrammar::Productions[state];
  std::array<Position, ChildrenPerCell> positions{};
  Position                              minimum{};
  for (int child = 1; child < ChildrenPerCell; child++) {
    const auto step  = production.steps[child - 1];
    positions[child] = positions[child - 1];
    positions[child][peano4::sfc::Grammar::getAxis(step)] += peano4::sfc::Grammar::getDirection(step);
    for (int axis = 0; axis < DIMENSIONS; axis++) {
      minimum[axis] = positions[child][axis] < minimum[axis] ? positions[child][axis] : minimum[axis];
    }
  }
  for (auto& position : positions) {
    for (int axis = 0; axis < DIMENSIONS; axis++) {
      position[axis] -= minimum[axis];
    }
  }
  return positions;
}

/**
 * Returns for every state the limit point of the curve within the given child, in cell widths.
 * Child 0 yields the entry points and the last child the exit points. The points are the fixed point
 * of a contraction, which the loop reaches by iteration.
 */
template <class CurveGrammar>
INLINE_METHOD constexpr std::array<
  typename peano4::sfc::SpaceFillingCurve<CurveGrammar>::Point,
  peano4::sfc::SpaceFillingCurve<CurveGrammar>::NumberOfStates
>
peano4::sfc::SpaceFillingCurve<CurveGrammar>::getLimitPointsWithin(const int child) {
  constexpr int                        Iterations = 64;
  std::array<Position, NumberOfStates> childPositions{};
  std::array<int, NumberOfStates>      childStates{};
  for (int state = 0; state < NumberOfStates; state++) {
    childPositions[state] = getPositions(state)[child];
    childStates[state]    = static_cast<int>(CurveGrammar::Productions[state].children[child]);
  }
  std::array<Point, NumberOfStates> points{};
  for (int iteration = 0; iteration < Iterations; iteration++) {
    std::array<Point, NumberOfStates> next{};
    for (int state = 0; state < NumberOfStates; state++) {
      for (int axis = 0; axis < DIMENSIONS; axis++) {
        next[state][axis] = (childPositions[state][axis] + points[childStates[state]][axis]) / SubdivisionFactor;
      }
    }
    points = next;
  }
  return points;
}
