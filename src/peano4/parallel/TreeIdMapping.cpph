INLINE_METHOD int peano4::parallel::TreeIdMapping::getLocalTreeId(const int treeId) {
  return treeId / tarch::mpi::Rank::getInstance().getNumberOfRanks();
}

INLINE_METHOD int peano4::parallel::TreeIdMapping::getGlobalTreeId(const int localTreeId) {
  return getId(tarch::mpi::Rank::getInstance().getRank(), localTreeId);
}

INLINE_METHOD int peano4::parallel::TreeIdMapping::getRank(const int treeId) {
  return treeId % tarch::mpi::Rank::getInstance().getNumberOfRanks();
}

INLINE_METHOD bool peano4::parallel::TreeIdMapping::isGlobalMaster(const int treeId) { return treeId == 0; }

INLINE_METHOD int peano4::parallel::TreeIdMapping::getId(const int rank, const int localTreeId) {
  return tarch::mpi::Rank::getInstance().getNumberOfRanks() * localTreeId + rank;
}
