template <class Container>
void peano4::parallel::SpacetreeSet::resizeParallelExchangeStacks(Container& stackContainer) {
  for (auto& tree : getInstance()._spacetrees) {
    stackContainer.resizeParallelExchangeStacks(tree._id, tree.getNumberOfNeighbourTrees());
  }
}

template <class Container>
void peano4::parallel::SpacetreeSet::setLocalTrees(Container& stackContainer) {
  stackContainer.setLocalTrees(getInstance().getLocalSpacetrees());
  resizeParallelExchangeStacks(stackContainer);
}

template <class Container>
void peano4::parallel::SpacetreeSet::
  streamDataFromJoiningTreeToMasterTree(Container& /*stackContainer*/, int /*master*/, int /*worker*/) {}

/**
 * Copies (streams) data from the master to the worker of one split.
 *
 * These are complete copies of the data set: both trees coarsen their mesh
 * afterwards and thus free the surplus.
 *
 * The spacetree set runs over the trees with the label EmptyRun, i.e. those that
 * have not run any traversal yet, and invokes this routine on each such tree's
 * master. On a rank where the master does not exist, a temporary observer for
 * the master triggers the exchange instead. The routine runs multiple times per
 * split, once for the splitting trees and once for the empty ones, so it catches
 * both the on-rank and the between-rank case; it may therefore only stream while
 * the destination stack is still empty. All streamed data are clones of the
 * original data, created by streamDataFromSplittingTreesToNewTrees() before this
 * routine is triggered.
 *
 * ## On-rank realisation
 *
 * If source and destination reside on the same rank, the stream is copied over
 * directly: the routine runs on the master, which creates the stream on the
 * worker and fills it. The second call finds a non-empty destination and
 * degenerates to a nop. After the copy the temporary source stack is deleted,
 * as a later stream of the same source to the same tree — once that tree has
 * degenerated or fused back into its master — would clone into an existing
 * stack and corrupt memory. The source stack is deleted even by a call that did
 * not clone; the per-call empty check is the price of running the routine on
 * both sides of every split.
 *
 * ## Data exchange between ranks
 *
 * The master rank triggers a send, the worker rank a receive. The exchange has
 * two phases: an integer message carries the number of entries, then the actual
 * data follow. Neither side waits for the non-blocking calls here;
 * finishAllOutstandingSendsAndReceives() completes them later. The buffer of an
 * MPI send lives until the data has gone out, which happens exactly once per
 * cycle: tryToFinishSendOrReceive() clears it, and the garbage collection
 * eventually frees the memory.
 *
 * ## Data ownership
 *
 * The routine solely accesses vertical/stream stacks, i.e.
 * getOutputStackNumberForVerticalDataExchange(), so every entry is ready to be
 * streamed out: peano4::grid::Spacetree::sendUserData() has deposited the
 * outgoing user data in the respective output buffers, and
 * streamDataFromSplittingTreesToNewTrees() deposits the tree data.
 *
 * @param master Tree number (not a rank) of the tree deploying a subgrid to a
 *   worker.
 * @param worker Target tree number.
 */
template <class Container>
void peano4::parallel::SpacetreeSet::streamDataFromSplittingTreeToNewTree(
  Container& stackContainer,
  int        master,
  int        worker
) {
  const int thisRank   = tarch::mpi::Rank::getInstance().getRank();
  const int sourceRank = peano4::parallel::TreeIdMapping::getRank(master);
  const int targetRank = peano4::parallel::TreeIdMapping::getRank(worker);

  // If we're neither the sender nor receiver, we have nothing to do.
  if (thisRank != sourceRank and thisRank != targetRank) {
    return;
  }

  // We are the sender
  if (thisRank == sourceRank) {
    const int neighbourSlot = getInstance().getSpacetree(master).getNeighbourSlot(worker);
    assertion(neighbourSlot >= 0, master, worker);
    auto& sourceStack = stackContainer.getParallelExchangeStack(
      master,
      neighbourSlot,
      grid::StackTopology::ParallelExchangeStack::VerticalOutput
    );

    // We are the sender and receiver: Shared memory
    if (thisRank == targetRank) {
      if (sourceStack.empty()) {
        return;
      }
      const int targetStackNumber = grid::PeanoCurve::getOutputStackNumber(getInstance().getSpacetree(worker)._root);
      auto&     targetStack       = stackContainer.getLocalExchangeStack(worker, targetStackNumber);
      assertion(targetStack.empty());
      targetStack = std::move(sourceStack);
      return;
    }
    const auto metaInfo = peano4::parallel::ExchangeChannels::getInstance().getGridDataExchangeMetaInformation(
      master,
      worker,
      peano4::parallel::ExchangeChannels::ExchangeMode::VerticalData
    );

    assertion(metaInfo.first >= 0);
    assertion(metaInfo.second != MPI_COMM_NULL);

    const int messageSize = sourceStack.size();
    tarch::mpi::send(&messageSize, 1, MPI_INT, targetRank, metaInfo.first, metaInfo.second);

    if (messageSize > 0) {
      sourceStack.startSend(stacks::SendReceiveContext::ForkDomain, targetRank, metaInfo.first, metaInfo.second);
    }
  }
  // We are the receiver
  else if (thisRank == targetRank) {
    const auto metaInfo = peano4::parallel::ExchangeChannels::getInstance().getGridDataExchangeMetaInformation(
      master,
      worker,
      peano4::parallel::ExchangeChannels::ExchangeMode::VerticalData
    );

    assertion(metaInfo.first >= 0);
    assertion(metaInfo.second != MPI_COMM_NULL);

    int messageSize = 0;
    tarch::mpi::receive(&messageSize, 1, MPI_INT, sourceRank, metaInfo.first, metaInfo.second);

    if (messageSize > 0) {
      const int targetStackNumber = grid::PeanoCurve::getOutputStackNumber(getInstance().getSpacetree(worker)._root);
      auto&     targetStack       = stackContainer.getLocalExchangeStack(worker, targetStackNumber);
      assertion(targetStack.empty());
      targetStack
        .startReceive(stacks::SendReceiveContext::ForkDomain, sourceRank, metaInfo.first, metaInfo.second, messageSize);
    }
  }
}

/**
 * Move one tree's outgoing boundary data towards its neighbours.
 *
 * A neighbour on this rank takes the data by a stack move and needs no message.
 * A neighbour on another rank has its data copied into that rank's aggregation
 * buffer and described by one segment, so that a rank pair exchanges a single
 * payload and a single segment table per container rather than one message per
 * tree pair.
 *
 * A tree hands on to the contributor countdown of every remote rank it touches,
 * whether or not it had anything to send. The countdown is what tells the last
 * tree that the buffer is complete, and it is that tree which posts the
 * messages. Posting therefore still happens before any wait, which a caller
 * relies on: MPI's rendezvous protocol would deadlock if a rank blocked for one
 * rank pair's data while a peer waited for it to post another one's.
 */
template <class Container>
void peano4::parallel::SpacetreeSet::exchangeAllHorizontalDataExchangeStacks(
  Container& stackContainer,
  int        spacetreeId
) {
  const int thisRank    = tarch::mpi::Rank::getInstance().getRank();
  auto&     tree        = getInstance().getSpacetree(spacetreeId);
  auto&     aggregation = stackContainer.getBoundaryDataAggregation();

  aggregation.prepare(
    getInstance()._boundaryAggregationGeneration,
    getInstance()._boundaryAggregationRemoteRanks,
    getInstance()._boundaryAggregationContributors
  );

  for (int neighborSlot = 0; neighborSlot < tree.getNumberOfNeighbourTrees(); neighborSlot++) {
    const int targetTreeId = tree.getNeighbourTreeIdForSlot(neighborSlot);
    const int targetRank   = peano4::parallel::TreeIdMapping::getRank(targetTreeId);

    auto& sourceStack = stackContainer.getParallelExchangeStack(
      spacetreeId,
      neighborSlot,
      grid::StackTopology::ParallelExchangeStack::HorizontalOutput
    );
    // Symmetric horizontal exchange: an empty outgoing stack means that the
    // peer has no corresponding data for us either, so the pair contributes
    // nothing. Asymmetric cardinalities require a separate count exchange.
    if (sourceStack.empty()) {
      continue;
    }

    if (thisRank != targetRank) {
      aggregation.appendOutgoing(aggregation.getRankExchange(targetRank), spacetreeId, targetTreeId, sourceStack);
      continue;
    }

    // Shared memory exchange
    assertion(thisRank == targetRank);
    const int targetSlot = getInstance().getSpacetree(targetTreeId).getNeighbourSlot(spacetreeId);
    assertion(targetSlot >= 0, spacetreeId, targetTreeId, neighborSlot);

#if PEANO_DEBUG
    [[maybe_unused]] const auto& reverseOutputStack = stackContainer.getParallelExchangeStack(
      targetTreeId,
      targetSlot,
      grid::StackTopology::ParallelExchangeStack::HorizontalOutput
    );
    assertion(
      reverseOutputStack.empty() or reverseOutputStack.size() == sourceStack.size(),
      "Horizontal boundary exchange assumes symmetric data cardinality"
    );
#endif

    auto& targetStack = stackContainer.getParallelExchangeStack(
      targetTreeId,
      targetSlot,
      grid::StackTopology::ParallelExchangeStack::HorizontalInput
    );
    assertion(
      targetStack.empty(),
      spacetreeId,
      targetTreeId,
      targetSlot,
      targetStack.size(),
      sourceStack.size(),
      typeid(Container).name()
    );
    targetStack = std::move(sourceStack);
  }

  const int localTreeId = peano4::parallel::TreeIdMapping::getLocalTreeId(spacetreeId);
  for (const int remoteRank : getInstance()._boundaryAggregationRanksPerTree[localTreeId]) {
    auto& exchange = aggregation.getRankExchange(remoteRank);
    if (exchange.outstandingContributors.fetch_sub(1, std::memory_order_acq_rel) == 1) {
      postAggregatedBoundaryExchange(stackContainer, remoteRank);
    }
  }
}

/**
 * Send one rank pair's aggregated boundary data and receive the peer's.
 *
 * Both incoming lengths follow from the outgoing ones, as the exchange is
 * symmetric: the number of elements a tree sends to a peer tree equals the
 * number that tree sends back, so the total payload and the number of segments
 * match on both sides. Only the identity of each segment travels, which is what
 * frees the two ranks from agreeing on the order in which their trees packed.
 */
template <class Container>
void peano4::parallel::SpacetreeSet::postAggregatedBoundaryExchange(Container& stackContainer, int remoteRank) {
  using Aggregation = std::decay_t<decltype(stackContainer.getBoundaryDataAggregation())>;

  auto& exchange = stackContainer.getBoundaryDataAggregation().getRankExchange(remoteRank);

  const int numberOfSegments = static_cast<int>(exchange.outgoingSegments.size());
  const int containerId      = stackContainer.getContainerId();

  if (numberOfSegments == 0) {
    return;
  }

#if PEANO_DEBUG
  // Both ranks size their receives from their own data, so a peer that disagrees
  // about how many segments it sends would show up only as a mis-sized receive,
  // far from the cause. Trading the counts turns that into a failure that names
  // the rank pair. The trade happens only for a non-empty exchange: the data
  // symmetry guarantees the peer of a non-empty pair posts as well, whereas a
  // rank pair that is empty here may not exist in the peer's topology at all
  // while a split settles, and a count message on such a pair would dangle.
  const auto countMetaInfo =
    peano4::parallel::ExchangeChannels::getInstance().getAggregatedBoundaryExchangeMetaInformation(
      containerId,
      peano4::parallel::ExchangeChannels::AggregatedBoundaryMessage::SegmentCount
    );
  exchange.outgoingSegmentCount = numberOfSegments;
  tarch::mpi::isend(
    &exchange.outgoingSegmentCount,
    1,
    MPI_INT,
    remoteRank,
    countMetaInfo.first,
    countMetaInfo.second,
    &exchange.outgoingSegmentCountRequest
  );
  tarch::mpi::irecv(
    &exchange.incomingSegmentCount,
    1,
    MPI_INT,
    remoteRank,
    countMetaInfo.first,
    countMetaInfo.second,
    &exchange.incomingSegmentCountRequest
  );
#endif

  const int numberOfElements = static_cast<int>(exchange.outgoingPayload.size());

  const auto payloadMetaInfo =
    peano4::parallel::ExchangeChannels::getInstance().getAggregatedBoundaryExchangeMetaInformation(
      containerId,
      peano4::parallel::ExchangeChannels::AggregatedBoundaryMessage::Payload
    );
  const auto segmentMetaInfo =
    peano4::parallel::ExchangeChannels::getInstance().getAggregatedBoundaryExchangeMetaInformation(
      containerId,
      peano4::parallel::ExchangeChannels::AggregatedBoundaryMessage::SegmentTable
    );

  exchange.incomingSegments.resize(numberOfSegments);
  const int numberOfSegmentBytes = numberOfSegments * static_cast<int>(sizeof(typename Aggregation::Segment));

  exchange.outgoingSegmentChannel.startSend(
    exchange.outgoingSegments.data(),
    numberOfSegmentBytes,
    remoteRank,
    segmentMetaInfo.first,
    segmentMetaInfo.second
  );
  exchange.incomingSegmentChannel.startReceive(
    exchange.incomingSegments.data(),
    numberOfSegmentBytes,
    remoteRank,
    segmentMetaInfo.first,
    segmentMetaInfo.second
  );

  exchange.outgoingPayload
    .startSend(stacks::SendReceiveContext::BoundaryExchange, remoteRank, payloadMetaInfo.first, payloadMetaInfo.second);
  exchange.incomingPayload.startReceive(
    stacks::SendReceiveContext::BoundaryExchange,
    remoteRank,
    payloadMetaInfo.first,
    payloadMetaInfo.second,
    numberOfElements
  );
}

/**
 * Copy the segments addressed to one tree out of a rank pair's incoming buffer.
 *
 * The sender packed the payload and the table in the same order, so walking the
 * table and accumulating the element counts gives every segment's offset. A
 * tree picks out the segments naming it as the receiver and pushes each into
 * the input stack of the slot that holds its sender, which is where a
 * per-tree-pair receive would have put it.
 */
template <class Container>
void peano4::parallel::SpacetreeSet::unpackAggregatedBoundaryExchange(
  Container& stackContainer,
  int        spacetreeId,
  int        remoteRank
) {
  auto&       exchange = stackContainer.getBoundaryDataAggregation().getRankExchange(remoteRank);
  auto&       tree     = getInstance().getSpacetree(spacetreeId);
  std::size_t offset   = 0;

  for (const auto& segment : exchange.incomingSegments) {
    if (segment.receiverTreeId != spacetreeId) {
      offset += static_cast<std::size_t>(segment.numberOfElements);
      continue;
    }

    const int slot = tree.getNeighbourSlot(segment.senderTreeId);
    assertion(slot >= 0, spacetreeId, segment.senderTreeId, remoteRank);

    auto& targetStack = stackContainer.getParallelExchangeStack(
      spacetreeId,
      slot,
      grid::StackTopology::ParallelExchangeStack::HorizontalInput
    );
    assertion(targetStack.empty(), spacetreeId, segment.senderTreeId, targetStack.size(), typeid(Container).name());

    auto destination = targetStack.pushBlock(static_cast<std::size_t>(segment.numberOfElements));
    for (std::size_t i = 0; i < destination.size(); i++) {
      destination.set(i, std::move(exchange.incomingPayload[offset + i]));
    }
    offset += static_cast<std::size_t>(segment.numberOfElements);
  }
}

/**
 * Wait until one tree's messages have gone out and its data has arrived, then
 * hand the aggregated boundary data to the tree.
 *
 * The aggregated requests of a rank pair belong to all the trees that share it,
 * and testing a request that has already completed is a nop, so every tree may
 * poll them. Only the segments naming a tree as their receiver are copied out,
 * which leaves each element with exactly one reader.
 */
template <class Container>
void peano4::parallel::SpacetreeSet::finishAllOutstandingSendsAndReceives(Container& stackContainer, int spacetreeId) {
  if (tarch::mpi::Rank::getInstance().getNumberOfRanks() <= 1) {
    return;
  }

  tarch::mpi::Diagnostics::getInstance().setDeadlockWarningTimeStamp();
  tarch::mpi::Diagnostics::getInstance().setDeadlockTimeoutTimeStamp();

  auto& tree        = getInstance().getSpacetree(spacetreeId);
  auto& aggregation = stackContainer.getBoundaryDataAggregation();

  const std::vector<int> emptyRemoteRanks;
  const bool             hasAggregatedData = aggregation.isPreparedFor(getInstance()._boundaryAggregationGeneration);
  const int              localTreeId       = peano4::parallel::TreeIdMapping::getLocalTreeId(spacetreeId);
  const auto&            remoteRanks =
    hasAggregatedData ? getInstance()._boundaryAggregationRanksPerTree[localTreeId] : emptyRemoteRanks;

  bool                   allSendReceivesFinished = false;
  tarch::mpi::PollPacing pacing;
  while (not allSendReceivesFinished) {
    allSendReceivesFinished = true;

    for (int i = 0; i < grid::StackTopology::TotalNumberOfLocalExchangeStacks; i++) {
      allSendReceivesFinished &= stackContainer.getLocalExchangeStack(spacetreeId, i).tryToFinishSendOrReceive();
    }

    for (int slot = 0; slot < tree.getNumberOfNeighbourTrees(); slot++) {
      for (int k = 0; k < static_cast<int>(grid::StackTopology::ParallelExchangeStack::NumberOfStacks); k++) {
        const auto which = static_cast<grid::StackTopology::ParallelExchangeStack>(k);
        allSendReceivesFinished &=
          stackContainer.getParallelExchangeStack(spacetreeId, slot, which).tryToFinishSendOrReceive();
      }
    }

    for (const int remoteRank : remoteRanks) {
      auto& exchange = aggregation.getRankExchange(remoteRank);

      int segmentsSent = 0;
      tarch::mpi::test(exchange.outgoingSegmentChannel.getRequest(), &segmentsSent, MPI_STATUS_IGNORE);
      allSendReceivesFinished &= (segmentsSent != 0);

      int segmentsReceived = 0;
      tarch::mpi::test(exchange.incomingSegmentChannel.getRequest(), &segmentsReceived, MPI_STATUS_IGNORE);
      allSendReceivesFinished &= (segmentsReceived != 0);

      allSendReceivesFinished &= exchange.outgoingPayload.tryToFinishSendOrReceive();
      allSendReceivesFinished &= exchange.incomingPayload.tryToFinishSendOrReceive();

#if PEANO_DEBUG
      int segmentCountSent = 0;
      tarch::mpi::test(&exchange.outgoingSegmentCountRequest, &segmentCountSent, MPI_STATUS_IGNORE);
      allSendReceivesFinished &= (segmentCountSent != 0);

      int segmentCountReceived = 0;
      tarch::mpi::test(&exchange.incomingSegmentCountRequest, &segmentCountReceived, MPI_STATUS_IGNORE);
      allSendReceivesFinished &= (segmentCountReceived != 0);
#endif
    }

    if (not allSendReceivesFinished) {
      if (pacing.reportProgressNow()) {
        tarch::mpi::Diagnostics::getInstance().writeTimeoutWarning(
          "peano4::parallel::SpacetreeSet",
          "finishAllOutstandingSendsAndReceives()",
          spacetreeId,
          -1,
          -1
        );
        tarch::mpi::Diagnostics::getInstance().triggerDeadlockTimeout(
          "peano4::parallel::SpacetreeSet",
          "finishAllOutstandingSendsAndReceives()",
          spacetreeId,
          -1,
          -1
        );
      }
    }
  }

  for (const int remoteRank : remoteRanks) {
#if PEANO_DEBUG
    [[maybe_unused]] const auto& exchange = aggregation.getRankExchange(remoteRank);
    assertion(
      exchange.incomingSegmentCount == exchange.outgoingSegmentCount,
      "Horizontal boundary exchange assumes symmetric data cardinality",
      remoteRank,
      spacetreeId,
      exchange.outgoingSegmentCount,
      exchange.incomingSegmentCount
    );
#endif
    unpackAggregatedBoundaryExchange(stackContainer, spacetreeId, remoteRank);
  }
}

/**
 * Purge the periodic input stacks of one tree. An entry that still sits there
 * arrived last sweep but found no reader, which only happens while the grid
 * or the domain decomposition changes. Such a leftover has to go before the
 * next deposits arrive, as a later read could otherwise match the stale entry
 * instead of the fresh one.
 *
 * The routine touches only this tree's periodic input stacks. It has to run
 * after this tree's traversal and before any
 * exchangeAllPeriodicBoundaryDataStacks() call that routes data towards this
 * tree.
 */
template <class Container>
void peano4::parallel::SpacetreeSet::purgePeriodicBoundaryDataStacks(Container& stackContainer, int spacetreeId) {
  if (not getInstance().hasPeriodicBoundaryConditions()) {
    return;
  }

  for (int stackNumber = 0; stackNumber < grid::StackTopology::TotalNumberOfLocalExchangeStacks; stackNumber++) {
    if (not grid::StackTopology::isPeriodicBoundaryExchangeOutputStackNumber(stackNumber)) {
      continue;
    }
    const int inputStackNumber =
      grid::StackTopology::getPeriodicBoundaryExchangeInputStackNumberForOutputStack(stackNumber);
    auto& staleStack  = stackContainer.getLocalExchangeStack(spacetreeId, inputStackNumber);
    auto& staleStamps = stackContainer.getLocalExchangeStamps(spacetreeId, inputStackNumber);
    assertion(staleStack.size() == staleStamps.size(), staleStack.size(), staleStamps.size(), spacetreeId);
    if (not staleStack.empty()) {
      logDebug(
        "Purge " << staleStack.size() << " unconsumed periodic entries on tree " << spacetreeId << ", stack "
                 << inputStackNumber
      );
    }
    staleStack.shallowClear();
    staleStamps.clear();
  }
}

/**
 * Route one tree's periodic boundary data to the trees that hold the wrapped
 * partner entities. Every entry on the tree's periodic output stacks carries
 * a stamp, i.e. the integer identity of its face or vertex plus the side of
 * the domain it sits on. The routing table lists, per identity, which trees
 * touch the low and the high side of the wrap, so each entry is sent to all
 * trees on the opposite side: targets on the same rank get their copy pushed
 * straight onto their input stack, targets on other ranks are staged for
 * exchangeCrossRankPeriodicData(). An entry whose identity has no
 * opposite-side target yet is dropped; this only happens while the grid
 * settles after a change, and the entity resends its data next sweep.
 *
 * The routine reads this tree's periodic output stacks and deposits into the
 * target trees' periodic input stacks, exactly like the horizontal
 * shared-memory exchange moves data into the peer's input stacks. It
 * requires rebuildPeriodicAssociations() to have completed and the targets'
 * purges to have run; it does not require other trees' traversals or
 * routings to have finished. The receive matches entries by stamp, so the
 * deposit order within a stack does not matter.
 */
template <class Container>
void peano4::parallel::SpacetreeSet::exchangeAllPeriodicBoundaryDataStacks(Container& stackContainer, int spacetreeId) {
  if (not getInstance().hasPeriodicBoundaryConditions()) {
    return;
  }

  const int   thisRank = tarch::mpi::Rank::getInstance().getRank();
  const auto& routing  = getInstance()._periodicRouting;

  // The deposit stack is the input stack paired with the producer's output
  // stack, which by the reflection symmetry of the periodic stack maps is
  // exactly the stack the partner's receive reads (see
  // StackTopologyTest::testPeriodicPartnerRoundTrip).
  for (int stackNumber = 0; stackNumber < grid::StackTopology::TotalNumberOfLocalExchangeStacks; stackNumber++) {
    if (not grid::StackTopology::isPeriodicBoundaryExchangeOutputStackNumber(stackNumber)) {
      continue;
    }
    auto& sourceStack  = stackContainer.getLocalExchangeStack(spacetreeId, stackNumber);
    auto& sourceStamps = stackContainer.getLocalExchangeStamps(spacetreeId, stackNumber);
    assertion(sourceStack.size() == sourceStamps.size(), sourceStack.size(), sourceStamps.size(), spacetreeId);

    const int depositStackNumber =
      grid::StackTopology::getPeriodicBoundaryExchangeInputStackNumberForOutputStack(stackNumber);

    while (not sourceStack.empty()) {
      const grid::PeriodicStamp stamp = sourceStamps.back();
      sourceStamps.pop_back();
      auto data = sourceStack.pop();

      const auto entry = routing.find(stamp.key);
      // No routing entry means no tree touches the wrapped partner (yet);
      // this only happens while a regrid settles, and the entity is
      // reproduced next sweep, so the payload is dropped.
      if (entry == routing.end()) {
        continue;
      }
      const auto& targets = entry->second[grid::toIndex(grid::opposite(stamp.side))];

      for (std::size_t i = 0; i < targets.size(); i++) {
        const int  targetTree = targets[i];
        const bool lastTarget = i + 1 == targets.size();
        if (peano4::parallel::TreeIdMapping::getRank(targetTree) == thisRank) {
          auto& depositStack = stackContainer.getLocalExchangeStack(targetTree, depositStackNumber);
          if (lastTarget) {
            depositStack.push(std::move(data));
          } else {
            depositStack.push(data);
          }
          stackContainer.pushLocalExchangeStamp(targetTree, depositStackNumber, stamp);
        } else if (lastTarget) {
          stackContainer
            .stageCrossRankPeriodicEntry(spacetreeId, targetTree, stamp, depositStackNumber, std::move(data));
        } else {
          stackContainer.stageCrossRankPeriodicEntry(spacetreeId, targetTree, stamp, depositStackNumber, data);
        }
      }
    }
  }
}

/**
 * Non-blocking, point-to-point exchange of the periodic boundary data whose
 * partner tree lives on another rank. Runs once per container and sweep,
 * after the same-rank periodic pass has staged the cross-rank entries. It
 * first exchanges a per-channel payload count, then the per-entry stamps and
 * payloads on dedicated periodic tags, and finally deposits the received
 * payloads onto the partner tree's periodic input stacks so the ordinary
 * stamp-matched receive consumes them. The channels come from the globally
 * identical routing table, so both ranks of every channel post in lockstep
 * (count 0 for a channel idle this sweep), which keeps the non-blocking
 * exchange deadlock-free.
 */
template <class Container>
void peano4::parallel::SpacetreeSet::exchangeCrossRankPeriodicData([[maybe_unused]] Container& stackContainer) {
  if (not getInstance().hasPeriodicBoundaryConditions()) {
    return;
  }

  const int   thisRank = tarch::mpi::Rank::getInstance().getRank();
  const auto& channels = getInstance()._crossRankPeriodicChannels;

  using Channel = std::pair<int, int>;

  // Sending the stamp and consumer-side deposit stack with every payload keeps
  // the exchange independent of how many entities emit data in a sweep.
  constexpr int MetadataWordsPerEntry = grid::PackedPeriodicStampSize + 1;
  const auto packEntry = [](const grid::PeriodicStamp& stamp, const int depositStack, int* const output) {
    grid::packPeriodicStamp(stamp, output);
    output[grid::PackedPeriodicStampSize] = depositStack;
  };
  const auto unpackEntry = [](const int* const input, grid::PeriodicStamp& stamp, int& depositStack) {
    stamp        = grid::unpackPeriodicStamp(input);
    depositStack = input[grid::PackedPeriodicStampSize];
  };

  struct PeriodicPayload {
    grid::PeriodicStamp             stamp{};
    int                             depositStack{0};
    typename Container::ElementType data{};
  };
  std::map<Channel, std::vector<PeriodicPayload>> outgoingPayloadsByChannel;
  for (auto& stagedEntry : stackContainer.getCrossRankPeriodicStaging()) {
    const Channel channel{stagedEntry.sendTree, stagedEntry.recvTree};
    outgoingPayloadsByChannel[channel].push_back(
      PeriodicPayload{stagedEntry.stamp, stagedEntry.depositStack, std::move(stagedEntry.data)}
    );
  }

  // Both ranks derive these records from the global channel set, so they post
  // matching count exchanges even for idle channels. A list keeps the
  // in-flight buffers' addresses stable.
  struct ChannelIO {
    Channel                   channel{};
    bool                      outgoing{false};
    int                       remoteRank{-1};
    int                       count{0};
    std::vector<int>          metadata{};
    typename Container::Stack data{};
    int                       metadataTag{0};
    int                       dataTag{0};
    MPI_Comm                  communicator{MPI_COMM_NULL};
    MPI_Request               countRequest{MPI_REQUEST_NULL};
    MPI_Request               metadataRequest{MPI_REQUEST_NULL};
  };
  std::list<ChannelIO> channelRecords;

  for (const auto& channel : channels) {
    const int producerTree = channel.first;
    const int consumerTree = channel.second;
    const auto metadataChannel =
      peano4::parallel::ExchangeChannels::getInstance().getGridDataExchangeMetaInformation(
        producerTree,
        consumerTree,
        peano4::parallel::ExchangeChannels::ExchangeMode::PeriodicMetadata
      );
    const auto dataChannel = peano4::parallel::ExchangeChannels::getInstance().getGridDataExchangeMetaInformation(
      producerTree,
      consumerTree,
      peano4::parallel::ExchangeChannels::ExchangeMode::PeriodicData
    );
    assertion(metadataChannel.second == dataChannel.second);
    if (peano4::parallel::TreeIdMapping::getRank(producerTree) == thisRank) {
      channelRecords.emplace_back();
      auto& channelRecord        = channelRecords.back();
      channelRecord.channel      = channel;
      channelRecord.outgoing     = true;
      channelRecord.remoteRank   = peano4::parallel::TreeIdMapping::getRank(consumerTree);
      channelRecord.metadataTag  = metadataChannel.first;
      channelRecord.dataTag      = dataChannel.first;
      channelRecord.communicator = metadataChannel.second;
      const auto payloadsForChannel = outgoingPayloadsByChannel.find(channel);
      channelRecord.count           = payloadsForChannel != outgoingPayloadsByChannel.end()
        ? static_cast<int>(payloadsForChannel->second.size())
        : 0;
    }
    if (peano4::parallel::TreeIdMapping::getRank(consumerTree) == thisRank) {
      channelRecords.emplace_back();
      auto& channelRecord        = channelRecords.back();
      channelRecord.channel      = channel;
      channelRecord.outgoing     = false;
      channelRecord.remoteRank   = peano4::parallel::TreeIdMapping::getRank(producerTree);
      channelRecord.metadataTag  = metadataChannel.first;
      channelRecord.dataTag      = dataChannel.first;
      channelRecord.communicator = metadataChannel.second;
    }
  }

  // Phase 1 drains every count before the metadata tag is reused.
  for (auto& channelRecord : channelRecords) {
    if (channelRecord.outgoing) {
      tarch::mpi::isend(
        &channelRecord.count,
        1,
        MPI_INT,
        channelRecord.remoteRank,
        channelRecord.metadataTag,
        channelRecord.communicator,
        &channelRecord.countRequest
      );
    } else {
      tarch::mpi::irecv(
        &channelRecord.count,
        1,
        MPI_INT,
        channelRecord.remoteRank,
        channelRecord.metadataTag,
        channelRecord.communicator,
        &channelRecord.countRequest
      );
    }
  }
  {
    tarch::mpi::RequestGroup countRequests;
    for (auto& channelRecord : channelRecords) {
      countRequests.add(&channelRecord.countRequest);
    }
    countRequests.waitAll("peano4::parallel::SpacetreeSet", "exchangeCrossRankPeriodicData()");
  }

  // Phase 2 uses distinct tags so the variable-length metadata and payload
  // cannot match the wrong receive. The completed count phase safely shares
  // the metadata tag.
  for (auto& channelRecord : channelRecords) {
    if (channelRecord.count == 0) {
      continue;
    }
    channelRecord.metadata.resize(static_cast<std::size_t>(channelRecord.count) * MetadataWordsPerEntry);
    if (channelRecord.outgoing) {
      auto& payloads = outgoingPayloadsByChannel[channelRecord.channel];
      for (int entryIndex = 0; entryIndex < channelRecord.count; entryIndex++) {
        packEntry(
          payloads[entryIndex].stamp,
          payloads[entryIndex].depositStack,
          channelRecord.metadata.data() + entryIndex * MetadataWordsPerEntry
        );
        channelRecord.data.push(std::move(payloads[entryIndex].data));
      }
      tarch::mpi::isend(
        channelRecord.metadata.data(),
        channelRecord.count * MetadataWordsPerEntry,
        MPI_INT,
        channelRecord.remoteRank,
        channelRecord.metadataTag,
        channelRecord.communicator,
        &channelRecord.metadataRequest
      );
      channelRecord.data.startSend(
        stacks::SendReceiveContext::PeriodicBoundaryDataSwap,
        channelRecord.remoteRank,
        channelRecord.dataTag,
        channelRecord.communicator
      );
    } else {
      tarch::mpi::irecv(
        channelRecord.metadata.data(),
        channelRecord.count * MetadataWordsPerEntry,
        MPI_INT,
        channelRecord.remoteRank,
        channelRecord.metadataTag,
        channelRecord.communicator,
        &channelRecord.metadataRequest
      );
      channelRecord.data.startReceive(
        stacks::SendReceiveContext::PeriodicBoundaryDataSwap,
        channelRecord.remoteRank,
        channelRecord.dataTag,
        channelRecord.communicator,
        channelRecord.count
      );
    }
  }
  {
    tarch::mpi::Diagnostics::getInstance().setDeadlockWarningTimeStamp();
    tarch::mpi::Diagnostics::getInstance().setDeadlockTimeoutTimeStamp();

    bool                   allRequestsCompleted = channelRecords.empty();
    tarch::mpi::PollPacing pacing;
    while (not allRequestsCompleted) {
      allRequestsCompleted = true;
      for (auto& channelRecord : channelRecords) {
        if (channelRecord.count == 0) {
          continue;
        }
        int metadataCompleted{0};
        tarch::mpi::test(&channelRecord.metadataRequest, &metadataCompleted, MPI_STATUS_IGNORE);
        allRequestsCompleted &= metadataCompleted != 0;
        allRequestsCompleted &= channelRecord.data.tryToFinishSendOrReceive();
      }
      if (not allRequestsCompleted and pacing.reportProgressNow()) {
        tarch::mpi::Diagnostics::getInstance()
          .writeTimeoutWarning("peano4::parallel::SpacetreeSet", "exchangeCrossRankPeriodicData()", -1, -1);
        tarch::mpi::Diagnostics::getInstance()
          .triggerDeadlockTimeout("peano4::parallel::SpacetreeSet", "exchangeCrossRankPeriodicData()", -1, -1);
      }
    }
  }

  // Deposit received payloads onto the consumer tree's periodic input stacks,
  // stamped, so the ordinary stamp-matched receive consumes them next sweep.
  for (auto& channelRecord : channelRecords) {
    if (channelRecord.outgoing or channelRecord.count == 0) {
      continue;
    }
    const int consumerTree = channelRecord.channel.second;
    for (int entryIndex = 0; entryIndex < channelRecord.count; entryIndex++) {
      grid::PeriodicStamp stamp{};
      int                 depositStack{0};
      unpackEntry(
        channelRecord.metadata.data() + entryIndex * MetadataWordsPerEntry,
        stamp,
        depositStack
      );
      stackContainer.getLocalExchangeStack(consumerTree, depositStack).push(channelRecord.data[entryIndex]);
      stackContainer.pushLocalExchangeStamp(consumerTree, depositStack, stamp);
    }
  }

  stackContainer.clearCrossRankPeriodicStaging();
}
