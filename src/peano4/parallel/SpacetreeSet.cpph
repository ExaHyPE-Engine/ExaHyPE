template <class Container>
void peano4::parallel::SpacetreeSet::resizeParallelExchangeStacks(Container& stackContainer) {
  for (auto& tree : getInstance()._spacetrees) {
    stackContainer.resizeParallelExchangeStacks(tree._id, tree.getNumberOfNeighbourTrees());
  }
}

template <class Container>
void peano4::parallel::SpacetreeSet::setLocalTrees(Container& stackContainer) {
  stackContainer.setLocalTrees(getInstance().getLocalSpacetrees());
  resizeParallelExchangeStacks(stackContainer);
}

template <class Container>
void peano4::parallel::SpacetreeSet::
  streamDataFromJoiningTreeToMasterTree(Container& /*stackContainer*/, int /*master*/, int /*worker*/) {}

template <class Container>
void peano4::parallel::SpacetreeSet::
  streamDataFromSplittingTreeToNewTree(Container& stackContainer, int master, int worker) {
  const int thisRank   = tarch::mpi::Rank::getInstance().getRank();
  const int sourceRank = Node::getInstance().getRank(master);
  const int targetRank = Node::getInstance().getRank(worker);

  // If we're neither the sender nor receiver, we have nothing to do.
  if (thisRank != sourceRank and thisRank != targetRank) {
    return;
  }

  // We are the sender
  if (thisRank == sourceRank) {
    const int neighbourSlot = getInstance().getSpacetree(master).getNeighbourSlot(worker);
    assertion(neighbourSlot >= 0, master, worker);
    auto& sourceStack = stackContainer.getParallelExchangeStack(
      master,
      neighbourSlot,
      grid::StackTopology::ParallelExchangeStack::VerticalOutput
    );

    // We are the sender and receiver: Shared memory
    if (thisRank == targetRank) {
      if (sourceStack.empty()) {
        return;
      }
      const int targetStackNumber = grid::PeanoCurve::getOutputStackNumber(getInstance().getSpacetree(worker)._root);
      auto&     targetStack       = stackContainer.getLocalExchangeStack(worker, targetStackNumber);
      assertion(targetStack.empty());
      // targetStack.clone(sourceStack);
      // sourceStack.shallowClear();
      targetStack = std::move(sourceStack);
      return;
    }
#ifdef WITH_MPI
    const auto metaInfo = Node::getInstance().getGridDataExchangeMetaInformation(
      master,
      worker,
      Node::ExchangeMode::VerticalData
    );

    assertion(metaInfo.first >= 0);
    assertion(metaInfo.second != MPI_COMM_NULL);

    const int                  messageSize = sourceStack.size();
    tarch::mpi::IntegerMessage message(messageSize);
    tarch::mpi::IntegerMessage::sendAndPollDanglingMessages(message, targetRank, metaInfo.first, metaInfo.second);

    if (messageSize > 0) {
      sourceStack.startSend(stacks::SendReceiveContext::ForkDomain, targetRank, metaInfo.first, metaInfo.second);
    }
#endif
  }
  // We are the receiver
  else if (thisRank == targetRank) {
#ifdef WITH_MPI
    const auto metaInfo = Node::getInstance().getGridDataExchangeMetaInformation(
      master,
      worker,
      Node::ExchangeMode::VerticalData
    );

    assertion(metaInfo.first >= 0);
    assertion(metaInfo.second != MPI_COMM_NULL);

    tarch::mpi::IntegerMessage message;
    tarch::mpi::IntegerMessage::receiveAndPollDanglingMessages(message, sourceRank, metaInfo.first, metaInfo.second);

    if (message.getValue() > 0) {
      const int targetStackNumber = grid::PeanoCurve::getOutputStackNumber(getInstance().getSpacetree(worker)._root);
      auto&     targetStack       = stackContainer.getLocalExchangeStack(worker, targetStackNumber);
      assertion(targetStack.empty());
      targetStack.startReceive(
        stacks::SendReceiveContext::ForkDomain,
        sourceRank,
        metaInfo.first,
        metaInfo.second,
        message.getValue()
      );
    }
#endif
  }
}

template <class Container>
void peano4::parallel::SpacetreeSet::exchangeAllHorizontalDataExchangeStacks(
  Container& stackContainer,
  int        spacetreeId
) {
  const int thisRank = tarch::mpi::Rank::getInstance().getRank();
  auto&     tree     = getInstance().getSpacetree(spacetreeId);

  for (int neighborSlot = 0; neighborSlot < tree.getNumberOfNeighbourTrees(); neighborSlot++) {
    const int targetTreeId = tree.getNeighbourTreeIdForSlot(neighborSlot);
    const int targetRank   = Node::getInstance().getRank(targetTreeId);

    auto& sourceStack = stackContainer.getParallelExchangeStack(
      spacetreeId,
      neighborSlot,
      grid::StackTopology::ParallelExchangeStack::HorizontalOutput
    );
    // Symmetric horizontal exchange: an empty outgoing stack means that the
    // peer has no corresponding data for us either, so we post no receive.
    // Asymmetric cardinalities require a separate count-exchange protocol.
    if (sourceStack.empty()) {
      continue;
    }

    if (thisRank != targetRank) {
#ifdef WITH_MPI
      const int messageSize = sourceStack.size();
      assertion(messageSize > 0, spacetreeId, targetTreeId, neighborSlot);

      // The outgoing stack size is also the incoming stack size.
      const auto sendMetaInfo = Node::getInstance().getGridDataExchangeMetaInformation(
        spacetreeId,
        targetTreeId,
        Node::ExchangeMode::HorizontalData
      );

      assertion(sendMetaInfo.first >= 0);
      assertion(sendMetaInfo.second != MPI_COMM_NULL);

      sourceStack
        .startSend(stacks::SendReceiveContext::BoundaryExchange, targetRank, sendMetaInfo.first, sendMetaInfo.second);

      const auto receiveMetaInfo = Node::getInstance().getGridDataExchangeMetaInformation(
        targetTreeId,
        spacetreeId,
        Node::ExchangeMode::HorizontalData
      );

      assertion(receiveMetaInfo.first >= 0);
      assertion(receiveMetaInfo.second != MPI_COMM_NULL);

      auto& targetStack = stackContainer.getParallelExchangeStack(
        spacetreeId,
        neighborSlot,
        grid::StackTopology::ParallelExchangeStack::HorizontalInput
      );
      assertion(targetStack.empty());
      // targetStack.clear(); // TODO: Unclear if needed

      targetStack.startReceive(
        stacks::SendReceiveContext::BoundaryExchange,
        targetRank,
        receiveMetaInfo.first,
        receiveMetaInfo.second,
        messageSize
      );

      continue;
#endif
    }

    // Shared memory exchange
    // We only reach here if !WITH_MPI or (WITH_MPI and thisRank == targetRank)
    assertion(thisRank == targetRank);
    const int targetSlot = getInstance().getSpacetree(targetTreeId).getNeighbourSlot(spacetreeId);
    assertion(targetSlot >= 0, spacetreeId, targetTreeId, neighborSlot);

#if PEANO_DEBUG
    [[maybe_unused]] const auto& reverseOutputStack = stackContainer.getParallelExchangeStack(
      targetTreeId,
      targetSlot,
      grid::StackTopology::ParallelExchangeStack::HorizontalOutput
    );
    assertion(
      reverseOutputStack.empty() or reverseOutputStack.size() == sourceStack.size(),
      "Horizontal boundary exchange assumes symmetric data cardinality"
    );
#endif

    auto& targetStack = stackContainer.getParallelExchangeStack(
      targetTreeId,
      targetSlot,
      grid::StackTopology::ParallelExchangeStack::HorizontalInput
    );
    assertion(targetStack.empty());

    // targetStack.clone(sourceStack);
    // sourceStack.shallowClear();
    targetStack = std::move(sourceStack);
  }
}

template <class Container>
void peano4::parallel::SpacetreeSet::finishAllOutstandingSendsAndReceives(Container& stackContainer, int spacetreeId) {
#ifdef WITH_MPI
  if (tarch::mpi::Rank::getInstance().getNumberOfRanks() <= 1) {
    return;
  }

  tarch::mpi::Rank::getInstance().setDeadlockWarningTimeStamp();
  tarch::mpi::Rank::getInstance().setDeadlockTimeOutTimeStamp();

  auto& tree = getInstance().getSpacetree(spacetreeId);

  bool allSendReceivesFinished = false;
  while (not allSendReceivesFinished) {
    allSendReceivesFinished = true;

    for (int i = 0; i < grid::StackTopology::TotalNumberOfLocalExchangeStacks; i++) {
      allSendReceivesFinished &= stackContainer.getLocalExchangeStack(spacetreeId, i).tryToFinishSendOrReceive();
    }

    for (int slot = 0; slot < tree.getNumberOfNeighbourTrees(); slot++) {
      for (int k = 0; k < static_cast<int>(grid::StackTopology::ParallelExchangeStack::NumberOfStacks); k++) {
        const auto which = static_cast<grid::StackTopology::ParallelExchangeStack>(k);
        allSendReceivesFinished &= stackContainer.getParallelExchangeStack(spacetreeId, slot, which)
                                     .tryToFinishSendOrReceive();
      }
    }

    tarch::mpi::Rank::getInstance().writeTimeOutWarning(
      "peano4::parallel::SpacetreeSet",
      "finishAllOutstandingSendsAndReceives()",
      spacetreeId,
      -1,
      -1
    );
    tarch::mpi::Rank::getInstance().triggerDeadlockTimeOut(
      "peano4::parallel::SpacetreeSet",
      "finishAllOutstandingSendsAndReceives()",
      spacetreeId,
      -1,
      -1
    );
    tarch::services::ServiceRepository::getInstance().receiveDanglingMessages();
  }
#endif
}

template <class Container>
void peano4::parallel::SpacetreeSet::exchangeAllPeriodicBoundaryDataStacks(Container& stackContainer, int spacetreeId) {
  for (int stackNumber = 0; stackNumber < grid::StackTopology::TotalNumberOfLocalExchangeStacks; stackNumber++) {
    if (not grid::StackTopology::isPeriodicBoundaryExchangeOutputStackNumber(stackNumber)) {
      continue;
    }

    auto& sourceStack = stackContainer.getLocalExchangeStack(spacetreeId, stackNumber);
    if (sourceStack.empty()) {
      continue;
    }

    // const int targetStackNumber = grid::StackTopology::mapPeriodicBoundaryExchangeOutputStackOntoInputStack(
    //   stackNumber
    // );
    const int targetStackNumber = grid::StackTopology::getPeriodicBoundaryExchangeInputStackNumberForOutputStack(
      stackNumber
    );
    assertion(not grid::StackTopology::isPeriodicBoundaryExchangeOutputStackNumber(targetStackNumber));
    auto& targetStack = stackContainer.getLocalExchangeStack(spacetreeId, targetStackNumber);

    assertion(targetStack.empty());
    // targetStack.clone(sourceStack);
    // sourceStack.shallowClear();
    targetStack = std::move(sourceStack);
  }
}
