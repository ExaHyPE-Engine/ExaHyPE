template <class Container>
void peano4::parallel::SpacetreeSet::resizeParallelExchangeStacks(Container& stackContainer) {
  for (auto& tree : getInstance()._spacetrees) {
    stackContainer.resizeParallelExchangeStacks(tree._id, tree.getNumberOfNeighbourTrees());
  }
}

template <class Container>
void peano4::parallel::SpacetreeSet::setLocalTrees(Container& stackContainer) {
  stackContainer.setLocalTrees(getInstance().getLocalSpacetrees());
  resizeParallelExchangeStacks(stackContainer);
}

template <class Container>
void peano4::parallel::SpacetreeSet::
  streamDataFromJoiningTreeToMasterTree(Container& /*stackContainer*/, int /*master*/, int /*worker*/) {}

/**
 * Copies (streams) data from the master to the worker of one split.
 *
 * These are complete copies of the data set: both trees coarsen their mesh
 * afterwards and thus free the surplus.
 *
 * The spacetree set runs over the trees with the label EmptyRun, i.e. those that
 * have not run any traversal yet, and invokes this routine on each such tree's
 * master. On a rank where the master does not exist, a temporary observer for
 * the master triggers the exchange instead. The routine runs multiple times per
 * split, once for the splitting trees and once for the empty ones, so it catches
 * both the on-rank and the between-rank case; it may therefore only stream while
 * the destination stack is still empty. All streamed data are clones of the
 * original data, created by streamDataFromSplittingTreesToNewTrees() before this
 * routine is triggered.
 *
 * ## On-rank realisation
 *
 * If source and destination reside on the same rank, the stream is copied over
 * directly: the routine runs on the master, which creates the stream on the
 * worker and fills it. The second call finds a non-empty destination and
 * degenerates to a nop. After the copy the temporary source stack is deleted,
 * as a later stream of the same source to the same tree — once that tree has
 * degenerated or fused back into its master — would clone into an existing
 * stack and corrupt memory. The source stack is deleted even by a call that did
 * not clone; the per-call empty check is the price of running the routine on
 * both sides of every split.
 *
 * ## Data exchange between ranks
 *
 * The master rank triggers a send, the worker rank a receive. The exchange has
 * two phases: an integer message carries the number of entries, then the actual
 * data follow. Neither side waits for the non-blocking calls here;
 * finishAllOutstandingSendsAndReceives() completes them later. The buffer of an
 * MPI send lives until the data has gone out, which happens exactly once per
 * cycle: tryToFinishSendOrReceive() clears it, and the garbage collection
 * eventually frees the memory.
 *
 * ## Data ownership
 *
 * The routine solely accesses vertical/stream stacks, i.e.
 * getOutputStackNumberForVerticalDataExchange(), so every entry is ready to be
 * streamed out: peano4::grid::Spacetree::sendUserData() has deposited the
 * outgoing user data in the respective output buffers, and
 * streamDataFromSplittingTreesToNewTrees() deposits the tree data.
 *
 * @param master Tree number (not a rank) of the tree deploying a subgrid to a
 *   worker.
 * @param worker Target tree number.
 */
template <class Container>
void peano4::parallel::SpacetreeSet::streamDataFromSplittingTreeToNewTree(
  Container& stackContainer,
  int        master,
  int        worker
) {
  const int thisRank   = tarch::mpi::Rank::getInstance().getRank();
  const int sourceRank = Node::getInstance().getRank(master);
  const int targetRank = Node::getInstance().getRank(worker);

  // If we're neither the sender nor receiver, we have nothing to do.
  if (thisRank != sourceRank and thisRank != targetRank) {
    return;
  }

  // We are the sender
  if (thisRank == sourceRank) {
    const int neighbourSlot = getInstance().getSpacetree(master).getNeighbourSlot(worker);
    assertion(neighbourSlot >= 0, master, worker);
    auto& sourceStack = stackContainer.getParallelExchangeStack(
      master,
      neighbourSlot,
      grid::StackTopology::ParallelExchangeStack::VerticalOutput
    );

    // We are the sender and receiver: Shared memory
    if (thisRank == targetRank) {
      if (sourceStack.empty()) {
        return;
      }
      const int targetStackNumber = grid::PeanoCurve::getOutputStackNumber(getInstance().getSpacetree(worker)._root);
      auto&     targetStack       = stackContainer.getLocalExchangeStack(worker, targetStackNumber);
      assertion(targetStack.empty());
      targetStack = std::move(sourceStack);
      return;
    }
#ifdef PEANO_WITH_MPI
    const auto metaInfo =
      Node::getInstance().getGridDataExchangeMetaInformation(master, worker, Node::ExchangeMode::VerticalData);

    assertion(metaInfo.first >= 0);
    assertion(metaInfo.second != MPI_COMM_NULL);

    const int                  messageSize = sourceStack.size();
    tarch::mpi::IntegerMessage message(messageSize);
    tarch::mpi::IntegerMessage::sendAndPollDanglingMessages(message, targetRank, metaInfo.first, metaInfo.second);

    if (messageSize > 0) {
      sourceStack.startSend(stacks::SendReceiveContext::ForkDomain, targetRank, metaInfo.first, metaInfo.second);
    }
#endif
  }
  // We are the receiver
  else if (thisRank == targetRank) {
#ifdef PEANO_WITH_MPI
    const auto metaInfo =
      Node::getInstance().getGridDataExchangeMetaInformation(master, worker, Node::ExchangeMode::VerticalData);

    assertion(metaInfo.first >= 0);
    assertion(metaInfo.second != MPI_COMM_NULL);

    tarch::mpi::IntegerMessage message;
    tarch::mpi::IntegerMessage::receiveAndPollDanglingMessages(message, sourceRank, metaInfo.first, metaInfo.second);

    if (message.getValue() > 0) {
      const int targetStackNumber = grid::PeanoCurve::getOutputStackNumber(getInstance().getSpacetree(worker)._root);
      auto&     targetStack       = stackContainer.getLocalExchangeStack(worker, targetStackNumber);
      assertion(targetStack.empty());
      targetStack.startReceive(
        stacks::SendReceiveContext::ForkDomain,
        sourceRank,
        metaInfo.first,
        metaInfo.second,
        message.getValue()
      );
    }
#endif
  }
}

template <class Container>
void peano4::parallel::SpacetreeSet::exchangeAllHorizontalDataExchangeStacks(
  Container& stackContainer,
  int        spacetreeId
) {
  const int thisRank = tarch::mpi::Rank::getInstance().getRank();
  auto&     tree     = getInstance().getSpacetree(spacetreeId);

  for (int neighborSlot = 0; neighborSlot < tree.getNumberOfNeighbourTrees(); neighborSlot++) {
    const int targetTreeId = tree.getNeighbourTreeIdForSlot(neighborSlot);
    const int targetRank   = Node::getInstance().getRank(targetTreeId);

    auto& sourceStack = stackContainer.getParallelExchangeStack(
      spacetreeId,
      neighborSlot,
      grid::StackTopology::ParallelExchangeStack::HorizontalOutput
    );
    // Symmetric horizontal exchange: an empty outgoing stack means that the
    // peer has no corresponding data for us either, so we post no receive.
    // Asymmetric cardinalities require a separate count-exchange protocol.
    if (sourceStack.empty()) {
      continue;
    }

    if (thisRank != targetRank) {
#ifdef PEANO_WITH_MPI
      const int messageSize = sourceStack.size();
      assertion(messageSize > 0, spacetreeId, targetTreeId, neighborSlot);

      // The outgoing stack size is also the incoming stack size.
      const auto sendMetaInfo = Node::getInstance().getGridDataExchangeMetaInformation(
        spacetreeId,
        targetTreeId,
        Node::ExchangeMode::HorizontalData
      );

      assertion(sendMetaInfo.first >= 0);
      assertion(sendMetaInfo.second != MPI_COMM_NULL);

      sourceStack
        .startSend(stacks::SendReceiveContext::BoundaryExchange, targetRank, sendMetaInfo.first, sendMetaInfo.second);

      const auto receiveMetaInfo = Node::getInstance().getGridDataExchangeMetaInformation(
        targetTreeId,
        spacetreeId,
        Node::ExchangeMode::HorizontalData
      );

      assertion(receiveMetaInfo.first >= 0);
      assertion(receiveMetaInfo.second != MPI_COMM_NULL);

      auto& targetStack = stackContainer.getParallelExchangeStack(
        spacetreeId,
        neighborSlot,
        grid::StackTopology::ParallelExchangeStack::HorizontalInput
      );
      assertion(
        targetStack.empty(),
        spacetreeId,
        targetTreeId,
        neighborSlot,
        targetStack.size(),
        messageSize,
        typeid(Container).name()
      );
      targetStack.startReceive(
        stacks::SendReceiveContext::BoundaryExchange,
        targetRank,
        receiveMetaInfo.first,
        receiveMetaInfo.second,
        messageSize
      );

      continue;
#endif
    }

    // Shared memory exchange
    // We only reach here if !PEANO_WITH_MPI or (PEANO_WITH_MPI and thisRank == targetRank)
    assertion(thisRank == targetRank);
    const int targetSlot = getInstance().getSpacetree(targetTreeId).getNeighbourSlot(spacetreeId);
    assertion(targetSlot >= 0, spacetreeId, targetTreeId, neighborSlot);

#if PEANO_DEBUG
    [[maybe_unused]] const auto& reverseOutputStack = stackContainer.getParallelExchangeStack(
      targetTreeId,
      targetSlot,
      grid::StackTopology::ParallelExchangeStack::HorizontalOutput
    );
    assertion(
      reverseOutputStack.empty() or reverseOutputStack.size() == sourceStack.size(),
      "Horizontal boundary exchange assumes symmetric data cardinality"
    );
#endif

    auto& targetStack = stackContainer.getParallelExchangeStack(
      targetTreeId,
      targetSlot,
      grid::StackTopology::ParallelExchangeStack::HorizontalInput
    );
    assertion(
      targetStack.empty(),
      spacetreeId,
      targetTreeId,
      targetSlot,
      targetStack.size(),
      sourceStack.size(),
      typeid(Container).name()
    );
    targetStack = std::move(sourceStack);
  }
}

template <class Container>
void peano4::parallel::SpacetreeSet::finishAllOutstandingSendsAndReceives(Container& stackContainer, int spacetreeId) {
#ifdef PEANO_WITH_MPI
  if (tarch::mpi::Rank::getInstance().getNumberOfRanks() <= 1) {
    return;
  }

  tarch::mpi::Rank::getInstance().setDeadlockWarningTimeStamp();
  tarch::mpi::Rank::getInstance().setDeadlockTimeoutTimeStamp();

  auto& tree = getInstance().getSpacetree(spacetreeId);

  bool allSendReceivesFinished = false;
  while (not allSendReceivesFinished) {
    allSendReceivesFinished = true;

    for (int i = 0; i < grid::StackTopology::TotalNumberOfLocalExchangeStacks; i++) {
      allSendReceivesFinished &= stackContainer.getLocalExchangeStack(spacetreeId, i).tryToFinishSendOrReceive();
    }

    for (int slot = 0; slot < tree.getNumberOfNeighbourTrees(); slot++) {
      for (int k = 0; k < static_cast<int>(grid::StackTopology::ParallelExchangeStack::NumberOfStacks); k++) {
        const auto which = static_cast<grid::StackTopology::ParallelExchangeStack>(k);
        allSendReceivesFinished &=
          stackContainer.getParallelExchangeStack(spacetreeId, slot, which).tryToFinishSendOrReceive();
      }
    }

    tarch::mpi::Rank::getInstance().writeTimeoutWarning(
      "peano4::parallel::SpacetreeSet",
      "finishAllOutstandingSendsAndReceives()",
      spacetreeId,
      -1,
      -1
    );
    tarch::mpi::Rank::getInstance().triggerDeadlockTimeout(
      "peano4::parallel::SpacetreeSet",
      "finishAllOutstandingSendsAndReceives()",
      spacetreeId,
      -1,
      -1
    );
    tarch::services::ServiceRepository::getInstance().receiveDanglingMessages();
  }
#endif
}

/**
 * Purge the periodic input stacks of one tree. An entry that still sits there
 * arrived last sweep but found no reader, which only happens while the grid
 * or the domain decomposition changes. Such a leftover has to go before the
 * next deposits arrive, as a later read could otherwise match the stale entry
 * instead of the fresh one.
 *
 * The routine touches only this tree's periodic input stacks. It has to run
 * after this tree's traversal and before any
 * exchangeAllPeriodicBoundaryDataStacks() call that routes data towards this
 * tree.
 */
template <class Container>
void peano4::parallel::SpacetreeSet::purgePeriodicBoundaryDataStacks(Container& stackContainer, int spacetreeId) {
  if (not getInstance().hasPeriodicBoundaryConditions()) {
    return;
  }

  for (int stackNumber = 0; stackNumber < grid::StackTopology::TotalNumberOfLocalExchangeStacks; stackNumber++) {
    if (not grid::StackTopology::isPeriodicBoundaryExchangeOutputStackNumber(stackNumber)) {
      continue;
    }
    const int inputStackNumber =
      grid::StackTopology::getPeriodicBoundaryExchangeInputStackNumberForOutputStack(stackNumber);
    auto& staleStack  = stackContainer.getLocalExchangeStack(spacetreeId, inputStackNumber);
    auto& staleStamps = stackContainer.getLocalExchangeStamps(spacetreeId, inputStackNumber);
    assertion(staleStack.size() == staleStamps.size(), staleStack.size(), staleStamps.size(), spacetreeId);
    if (not staleStack.empty()) {
      logDebug(
        "Purge " << staleStack.size() << " unconsumed periodic entries on tree " << spacetreeId << ", stack "
                 << inputStackNumber
      );
    }
    staleStack.shallowClear();
    staleStamps.clear();
  }
}

/**
 * Route one tree's periodic boundary data to the trees that hold the wrapped
 * partner entities. Every entry on the tree's periodic output stacks carries
 * a stamp, i.e. the integer identity of its face or vertex plus the side of
 * the domain it sits on. The routing table lists, per identity, which trees
 * touch the low and the high side of the wrap, so each entry is sent to all
 * trees on the opposite side: targets on the same rank get their copy pushed
 * straight onto their input stack, targets on other ranks are staged for
 * exchangeCrossRankPeriodicData(). An entry whose identity has no
 * opposite-side target yet is dropped; this only happens while the grid
 * settles after a change, and the entity resends its data next sweep.
 *
 * The routine reads this tree's periodic output stacks and deposits into the
 * target trees' periodic input stacks, exactly like the horizontal
 * shared-memory exchange moves data into the peer's input stacks. It
 * requires rebuildPeriodicAssociations() to have completed and the targets'
 * purges to have run; it does not require other trees' traversals or
 * routings to have finished. The receive matches entries by stamp, so the
 * deposit order within a stack does not matter.
 */
template <class Container>
void peano4::parallel::SpacetreeSet::exchangeAllPeriodicBoundaryDataStacks(Container& stackContainer, int spacetreeId) {
  if (not getInstance().hasPeriodicBoundaryConditions()) {
    return;
  }

  const int   thisRank = tarch::mpi::Rank::getInstance().getRank();
  const auto& routing  = getInstance()._periodicRouting;

  // The deposit stack is the input stack paired with the producer's output
  // stack, which by the reflection symmetry of the periodic stack maps is
  // exactly the stack the partner's receive reads (see
  // StackTopologyTest::testPeriodicPartnerRoundTrip).
  for (int stackNumber = 0; stackNumber < grid::StackTopology::TotalNumberOfLocalExchangeStacks; stackNumber++) {
    if (not grid::StackTopology::isPeriodicBoundaryExchangeOutputStackNumber(stackNumber)) {
      continue;
    }
    auto& sourceStack  = stackContainer.getLocalExchangeStack(spacetreeId, stackNumber);
    auto& sourceStamps = stackContainer.getLocalExchangeStamps(spacetreeId, stackNumber);
    assertion(sourceStack.size() == sourceStamps.size(), sourceStack.size(), sourceStamps.size(), spacetreeId);

    const int depositStackNumber =
      grid::StackTopology::getPeriodicBoundaryExchangeInputStackNumberForOutputStack(stackNumber);

    while (not sourceStack.empty()) {
      const grid::PeriodicStamp stamp = sourceStamps.back();
      sourceStamps.pop_back();
      auto data = sourceStack.pop();

      const auto entry = routing.find(stamp.key);
      // No routing entry means no tree touches the wrapped partner (yet);
      // this only happens while a regrid settles, and the entity is
      // reproduced next sweep, so the payload is dropped.
      if (entry == routing.end()) {
        continue;
      }
      const auto& targets = entry->second[grid::toIndex(grid::opposite(stamp.side))];

      for (std::size_t i = 0; i < targets.size(); i++) {
        const int  targetTree = targets[i];
        const bool lastTarget = i + 1 == targets.size();
        if (Node::getInstance().getRank(targetTree) == thisRank) {
          auto& depositStack = stackContainer.getLocalExchangeStack(targetTree, depositStackNumber);
          if (lastTarget) {
            depositStack.push(std::move(data));
          } else {
            depositStack.push(data);
          }
          stackContainer.pushLocalExchangeStamp(targetTree, depositStackNumber, stamp);
        } else if (lastTarget) {
          stackContainer
            .stageCrossRankPeriodicEntry(spacetreeId, targetTree, stamp, depositStackNumber, std::move(data));
        } else {
          stackContainer.stageCrossRankPeriodicEntry(spacetreeId, targetTree, stamp, depositStackNumber, data);
        }
      }
    }
  }
}

/**
 * Non-blocking, point-to-point exchange of the periodic boundary data whose
 * partner tree lives on another rank. Runs once per container and sweep,
 * after the same-rank periodic pass has staged the cross-rank entries. It
 * first exchanges a per-channel payload count, then the per-entry stamps and
 * payloads on the dedicated periodic tag, and finally deposits the received
 * payloads onto the partner tree's periodic input stacks so the ordinary
 * stamp-matched receive consumes them. The channels come from the globally
 * identical routing table, so both ranks of every channel post in lockstep
 * (count 0 for a channel idle this sweep), which keeps the non-blocking
 * exchange deadlock-free.
 */
template <class Container>
void peano4::parallel::SpacetreeSet::exchangeCrossRankPeriodicData([[maybe_unused]] Container& stackContainer) {
#ifdef PEANO_WITH_MPI
  if (not getInstance().hasPeriodicBoundaryConditions()) {
    return;
  }

  const int   thisRank = tarch::mpi::Rank::getInstance().getRank();
  const auto& channels = getInstance()._crossRankPeriodicChannels;

  // A channel is the ordered pair of producer tree and consumer tree.
  using Channel = std::pair<int, int>;

  // Each payload travels with its stamp and the consumer-side deposit stack.
  // Transmitting these (rather than re-deriving counts from the routing
  // geometry) keeps the exchange correct no matter how many entities actually
  // emitted data this sweep: an idle channel simply ships count 0.
  constexpr int StampWords = grid::PackedPeriodicStampSize + 1;
  auto          packEntry  = [](const grid::PeriodicStamp& stamp, int depositStack, int* out) {
    grid::packPeriodicStamp(stamp, out);
    out[grid::PackedPeriodicStampSize] = depositStack;
  };
  auto unpackEntry = [](const int* in, grid::PeriodicStamp& stamp, int& depositStack) {
    stamp        = grid::unpackPeriodicStamp(in);
    depositStack = in[grid::PackedPeriodicStampSize];
  };

  // Group staged outgoing payloads by channel (the producer is a local tree).
  struct Payload {
    grid::PeriodicStamp             stamp;
    int                             depositStack;
    typename Container::ElementType data;
  };
  std::map<Channel, std::vector<Payload>> outByChannel;
  for (auto& e : stackContainer.getCrossRankPeriodicStaging()) {
    outByChannel[Channel(e.sendTree, e.recvTree)].push_back(Payload{e.stamp, e.depositStack, std::move(e.data)});
  }

  // One record per channel this rank participates in. Channels are taken from
  // the global set, so producer and consumer ranks post in lockstep (count 0
  // for a channel that is idle this sweep); no count exchange is left unmatched,
  // hence no deadlock. std::list keeps the in-flight buffers' addresses stable.
  struct ChannelIO {
    Channel                   channel;
    bool                      outgoing;
    int                       remoteRank;
    int                       count;
    std::vector<int>          meta;
    typename Container::Stack data;
    int                       tag          = 0;
    MPI_Comm                  comm         = MPI_COMM_NULL;
    MPI_Request               countRequest = MPI_REQUEST_NULL;
    MPI_Request               metaRequest  = MPI_REQUEST_NULL;
  };
  std::list<ChannelIO> io;

  for (const auto& ch : channels) {
    const int  producerTree = ch.first;
    const int  consumerTree = ch.second;
    const auto metaInfo     = Node::getInstance().getGridDataExchangeMetaInformation(
      producerTree,
      consumerTree,
      Node::ExchangeMode::PeriodicData
    );
    if (Node::getInstance().getRank(producerTree) == thisRank) {
      io.emplace_back();
      ChannelIO& c  = io.back();
      c.channel     = ch;
      c.outgoing    = true;
      c.remoteRank  = Node::getInstance().getRank(consumerTree);
      c.tag         = metaInfo.first;
      c.comm        = metaInfo.second;
      const auto it = outByChannel.find(ch);
      c.count       = (it != outByChannel.end()) ? static_cast<int>(it->second.size()) : 0;
    }
    if (Node::getInstance().getRank(consumerTree) == thisRank) {
      io.emplace_back();
      ChannelIO& c = io.back();
      c.channel    = ch;
      c.outgoing   = false;
      c.remoteRank = Node::getInstance().getRank(producerTree);
      c.tag        = metaInfo.first;
      c.comm       = metaInfo.second;
      c.count      = 0;
    }
  }

  // Phase 1: exchange the per-channel payload counts, then drain while pumping
  // service messages so unrelated dangling traffic cannot stall us.
  for (auto& c : io) {
    if (c.outgoing) {
      MPI_Isend(&c.count, 1, MPI_INT, c.remoteRank, c.tag, c.comm, &c.countRequest);
    } else {
      MPI_Irecv(&c.count, 1, MPI_INT, c.remoteRank, c.tag, c.comm, &c.countRequest);
    }
  }
  {
    bool done = io.empty();
    while (not done) {
      done = true;
      for (auto& c : io) {
        int flag = 0;
        MPI_Test(&c.countRequest, &flag, MPI_STATUS_IGNORE);
        done &= (flag != 0);
      }
      tarch::services::ServiceRepository::getInstance().receiveDanglingMessages();
    }
  }

  // Phase 2: for active channels (count > 0) exchange metadata then payload on
  // the same tag. MPI in-order delivery keeps the sequence count, meta, data
  // matched, so no extra synchronisation is needed.
  for (auto& c : io) {
    if (c.count == 0) {
      continue;
    }
    c.meta.resize(static_cast<std::size_t>(c.count) * StampWords);
    if (c.outgoing) {
      auto& payloads = outByChannel[c.channel];
      for (int k = 0; k < c.count; k++) {
        packEntry(payloads[k].stamp, payloads[k].depositStack, c.meta.data() + k * StampWords);
        c.data.push(std::move(payloads[k].data));
      }
      MPI_Isend(c.meta.data(), c.count * StampWords, MPI_INT, c.remoteRank, c.tag, c.comm, &c.metaRequest);
      c.data.startSend(stacks::SendReceiveContext::PeriodicBoundaryDataSwap, c.remoteRank, c.tag, c.comm);
    } else {
      MPI_Irecv(c.meta.data(), c.count * StampWords, MPI_INT, c.remoteRank, c.tag, c.comm, &c.metaRequest);
      c.data.startReceive(stacks::SendReceiveContext::PeriodicBoundaryDataSwap, c.remoteRank, c.tag, c.comm, c.count);
    }
  }
  {
    bool done = io.empty();
    while (not done) {
      done = true;
      for (auto& c : io) {
        if (c.count == 0) {
          continue;
        }
        int flag = 0;
        MPI_Test(&c.metaRequest, &flag, MPI_STATUS_IGNORE);
        done &= (flag != 0);
        done &= c.data.tryToFinishSendOrReceive();
      }
      tarch::services::ServiceRepository::getInstance().receiveDanglingMessages();
    }
  }

  // Deposit received payloads onto the consumer tree's periodic input stacks,
  // stamped, so the ordinary stamp-matched receive consumes them next sweep.
  // meta[k] and data[k] line up by transmission position.
  for (auto& c : io) {
    if (c.outgoing or c.count == 0) {
      continue;
    }
    const int consumerTree = c.channel.second;
    for (int k = 0; k < c.count; k++) {
      grid::PeriodicStamp stamp;
      int                 depositStack = 0;
      unpackEntry(c.meta.data() + k * StampWords, stamp, depositStack);
      stackContainer.getLocalExchangeStack(consumerTree, depositStack).push(c.data[k]);
      stackContainer.pushLocalExchangeStamp(consumerTree, depositStack, stamp);
    }
  }

  stackContainer.clearCrossRankPeriodicStaging();
#endif
}
