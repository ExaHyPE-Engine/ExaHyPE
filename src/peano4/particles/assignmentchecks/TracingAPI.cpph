/**
 * Returns the name of the type Particle. A compiler prefixes the name with the
 * lengths of its namespaces and appends one character, and the function cuts
 * both away.
 */
template <typename Particle>
std::string peano4::particles::assignmentchecks::pruneTypeName() {
  std::string       result    = typeid(Particle).name();
  const std::size_t lastDigit = result.find_last_of("0123456789");
  if (lastDigit != std::string::npos) {
    result = result.substr(lastDigit + 1);
  }
  assertion(result.size() > 1, typeid(Particle).name(), result);
  return result.size() > 1 ? result.substr(0, result.size() - 1) : result;
}

template <typename ParticleContainer>
std::vector<peano4::particles::assignmentchecks::ParticlePosition> peano4::particles::assignmentchecks::
  recordParticlePositions(const ParticleContainer& container) {
  std::vector<peano4::particles::assignmentchecks::ParticlePosition> result(container.size());

#ifdef ASSIGNMENT_CHECKS
  int entry = 0;
  for (const auto& particle : container) {
    result[entry] = particle->getX();
    entry++;
  }
#endif

  return result;
}

/**
 * Reports the movement of every local particle of container through
 * moveParticle(). The caller obtains recordedPositions from
 * recordParticlePositions(), so both hold the same particles in the same order.
 * A lift moves a virtual particle, and its movement is already reported while
 * the particle is local, so the loop skips it.
 */
template <typename ParticleContainer>
void peano4::particles::assignmentchecks::traceParticleMovements(
  const ParticleContainer&                     container,
  const std::vector<ParticlePosition>&         recordedPositions,
  const tarch::la::Vector<DIMENSIONS, double>& vertexX,
  const tarch::la::Vector<DIMENSIONS, double>& vertexH,
  int                                          treeId
) {
#ifdef ASSIGNMENT_CHECKS

  [[maybe_unused]] const auto numberOfParticles         = container.size();
  [[maybe_unused]] const auto numberOfRecordedPositions = recordedPositions.size();
  assertion(numberOfParticles == numberOfRecordedPositions, numberOfParticles, numberOfRecordedPositions);

  auto particleIterator         = container.begin();
  auto recordedPositionIterator = recordedPositions.begin();

  using Particle = std::remove_pointer_t<typename ParticleContainer::value_type>;

  while (particleIterator != container.end()) {
    if ((*particleIterator)->getParallelState() == Particle::ParallelState::Local) {
      peano4::particles::assignmentchecks::moveParticle(
        peano4::particles::assignmentchecks::pruneTypeName<Particle>(),
        *recordedPositionIterator,
        (*particleIterator)->getX(),
        (*particleIterator)->getPartid(),
        vertexX,
        vertexH,
        treeId,
        "peano4::particles::assignmentchecks::traceParticleMovements()"
      );
    }

    particleIterator++;
    recordedPositionIterator++;
  }
#endif
}
