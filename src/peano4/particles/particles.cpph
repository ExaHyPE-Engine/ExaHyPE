/**
 * Returns the iterator to the entry in [begin, end) that carries the number of
 * particle, and end when no entry carries it.
 *
 * @param particle Particle whose number is searched for.
 * @param begin    First element of the container to search.
 * @param end      One past the last element of the container to search.
 */
template <typename Iterator>
Iterator peano4::particles::particleIsDuplicate(
  const typename Iterator::value_type& particle,
  Iterator                             begin,
  const Iterator&                      end
) {
  while (begin != end) {
    // getNumber() returns the pair of inserting tree and running index on that
    // tree, and every copy of a particle carries it, so two entries with the
    // same number are one particle.
    if ((*begin)->getNumber() == particle->getNumber()) {
      logDebug(
        "Particles " << particle->toString() << " and " << (*begin)->toString()
                     << " are duplicates (same (tree,number) identity)"
      );
      return begin;
    }
    ++begin;
  }
  return begin;
}

/**
 * Inserts every particle of newParticles into the cell of marker. The vertices
 * take over the particle pointers, so the caller may destroy newParticles but
 * not the particles it points to.
 */
template <typename Particle, typename ParticleSet>
void peano4::particles::insertParticlesIntoCell(
  const peano4::dataview::CellMarker&              marker,
  const std::vector<Particle*>&                    newParticles,
  peano4::dataview::VertexEnumerator<ParticleSet>& fineGridVertices,
  int                                              treeId
) {
  for (const auto& particle : newParticles) {
    peano4::particles::insertParticleIntoCell(marker, particle, fineGridVertices, treeId);
  }
}

/**
 * Sets the bitset in particle that flags which cells around the vertex
 * assignedVertex of marker contain the particle.
 */
template <typename Particle>
void peano4::particles::updateContainedInAdjacentCellProperty(
  const peano4::dataview::CellMarker& marker,
  const std::bitset<DIMENSIONS>&      assignedVertex,
  Particle&                           particle
) {
  const tarch::la::Vector<DIMENSIONS, double> vertexPositionOfAssignedVertex = marker.getOffset()
    + tarch::la::multiplyComponents(tarch::la::Vector<DIMENSIONS, double>(assignedVertex), marker.getH());
  peano4::particles::updateContainedInAdjacentCellProperty(vertexPositionOfAssignedVertex, marker.getH(), particle);
}

template <typename Particle>
void peano4::particles::updateContainedInAdjacentCellProperty(
  const peano4::dataview::VertexMarker& marker,
  Particle&                             particle
) {
  particle.setContainedInAdjacentCell(peano4::particles::getAdjacentCellsOwningParticle(particle.getX(), marker));
}

/**
 * Sets the bitset in particle that flags which of the @f$ 2^d @f$ cells around
 * the vertex at x with mesh size h contain the particle. More than one bit is
 * set when the particle sits on a face between two of these cells. A caller
 * calls this routine after every movement of the particle.
 */
template <typename Particle>
void peano4::particles::updateContainedInAdjacentCellProperty(
  const tarch::la::Vector<DIMENSIONS, double>& x,
  const tarch::la::Vector<DIMENSIONS, double>& h,
  Particle&                                    particle
) {
  std::bitset<peano4::CellsPerVertex> result = 0;
  const auto                          image  = peano4::particles::periodicImageTowards(particle.getX(), x);

  peano4::dForEachCorner([&](const tarch::la::Vector<DIMENSIONS, int>& k, int kScalar) {
    const tarch::la::Vector<DIMENSIONS, double> adjacentCellCentre =
      x - 0.5 * h + tarch::la::multiplyComponents(tarch::la::convertScalar<double>(k), h);
    result[kScalar] = peano4::dataview::CellMarker::isContained(
      image,
      adjacentCellCentre,
      h,
      peano4::particles::relativeGrabOwnershipSpatialSortingTolerance(h) * tarch::la::NUMERICAL_ZERO_DIFFERENCE
    );
  });

  particle.setContainedInAdjacentCell(result);
}

/**
 * Adds newParticle to the closest vertex of the cell of marker and sets its
 * state to local. The position of newParticle has to lie within that cell. A
 * caller combines the insertion with a particle sorting step, so the particle
 * does not end up on a hanging vertex and disappear with it.
 */
template <typename Particle, typename ParticleSet>
void peano4::particles::insertParticleIntoCell(
  const peano4::dataview::CellMarker&              marker,
  Particle*                                        newParticle,
  peano4::dataview::VertexEnumerator<ParticleSet>& fineGridVertices,
  int                                              treeId
) {
  std::bitset<DIMENSIONS> targetVertex;
  for (int d = 0; d < DIMENSIONS; d++) {
    [[maybe_unused]] const double lowerCellFace = marker.getX()(d) - marker.getH()(d) / 2.0;
    [[maybe_unused]] const double upperCellFace = marker.getX()(d) + marker.getH()(d) / 2.0;
    [[maybe_unused]] const bool   particleIsAboveLowerCellFace =
      tarch::la::greaterEquals(newParticle->getX()(d), lowerCellFace);
    [[maybe_unused]] const bool particleIsBelowUpperCellFace =
      tarch::la::smallerEquals(newParticle->getX()(d), upperCellFace);
    assertion(particleIsAboveLowerCellFace, marker.toString(), newParticle->toString(), lowerCellFace, d);
    assertion(particleIsBelowUpperCellFace, marker.toString(), newParticle->toString(), upperCellFace, d);
    targetVertex[d] = newParticle->getX()(d) > marker.getX()(d);
  }

  [[maybe_unused]] const bool searchRadiusFitsIntoCell =
    tarch::la::smaller(2.0 * newParticle->getSearchRadius(), tarch::la::min(marker.getH()));
  assertion(searchRadiusFitsIntoCell, marker.toString(), newParticle->toString(), treeId);

  newParticle->setParallelState(Particle::ParallelState::Local);
  newParticle->setCellH(marker.getH());
  peano4::particles::updateContainedInAdjacentCellProperty(marker, targetVertex, *newParticle);

  const int linearisedTargetVertex = targetVertex.to_ulong();

  logDebug(
    "Assign particle " << newParticle->toString() << " to vertex " << linearisedTargetVertex << " in cell "
                       << marker.toString() << " (vertex=" << fineGridVertices(linearisedTargetVertex).toString() << ")"
  );
  fineGridVertices(linearisedTargetVertex).addParticle(newParticle);

#if PEANO_ASSERTIONS
  // The assignment checks key a particle on this id together with its tree and
  // its vertex, so two particles on one vertex of one tree carry distinct ids.
  // The rank sits in the upper bits, so the ids stay distinct once a particle
  // travels to another rank as a copy.
  static std::atomic<int> particleCounter{0};
  const int               rank = tarch::mpi::Rank::getInstance().getRank();
  newParticle->setPartid((rank << 20) | (particleCounter.fetch_add(1) & 0xFFFFF));
#endif

  const tarch::la::Vector<DIMENSIONS, double> vertexX = marker.getX() - 0.5 * marker.getH()
    + tarch::la::multiplyComponents(tarch::la::Vector<DIMENSIONS, double>(targetVertex), marker.getH());

  peano4::particles::assignmentchecks::assignParticleToVertex(
    peano4::particles::assignmentchecks::pruneTypeName<Particle>(),
    newParticle->getX(),
    newParticle->getPartid(),
    true, // isLocal
    vertexX,
    marker.getH(), // vertexH
    treeId,
    "peano4::particles::insertParticleIntoCell()",
    vertexX,
    marker.getH(),
    true // isNew
  );
}
