INLINE_METHOD peano4::RefinementRequest::RefinementControl
peano4::RefinementRequest::getRefinementControl() const noexcept {
  return static_cast<RefinementControl>(refinementControl);
}

INLINE_METHOD void
peano4::RefinementRequest::setRefinementControl(const RefinementControl value) noexcept {
  refinementControl = static_cast<std::uint8_t>(value);
}
