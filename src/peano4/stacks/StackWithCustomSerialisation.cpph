template <class T>
INLINE_METHOD peano4::stacks::StackWithCustomSerialisation<T>::StackWithCustomSerialisation(
  StackWithCustomSerialisation&& other
) noexcept :
  peano4::stacks::Stack<T>(std::move(other)),
  mpiCountRequest(other.mpiCountRequest),
  mpiDataRequest(other.mpiDataRequest),
  countBuffer(std::move(other.countBuffer)),
  dataBuffer(std::move(other.dataBuffer)),
  mpiComm(other.mpiComm),
  mpiContext(other.mpiContext) {
  other.mpiCountRequest = MPI_REQUEST_NULL;
  other.mpiDataRequest  = MPI_REQUEST_NULL;
  other.mpiComm         = MPI_COMM_NULL;
}

template <class T>
INLINE_METHOD peano4::stacks::StackWithCustomSerialisation<T>& peano4::stacks::StackWithCustomSerialisation<
  T>::operator=(StackWithCustomSerialisation&& other) noexcept {
  if (this != &other) {
    peano4::stacks::Stack<T>::operator=(std::move(other));

    countBuffer = std::move(other.countBuffer);
    dataBuffer  = std::move(other.dataBuffer);

    mpiCountRequest = other.mpiCountRequest;
    mpiDataRequest  = other.mpiDataRequest;
    mpiComm         = other.mpiComm;
    mpiContext      = other.mpiContext;

    other.mpiCountRequest = MPI_REQUEST_NULL;
    other.mpiDataRequest  = MPI_REQUEST_NULL;
    other.mpiComm         = MPI_COMM_NULL;
  }
  return *this;
}

/**
 * Hands the send to T::startSend(). The requests and buffers it drives live in
 * this stack, so the transfer survives the call that starts it.
 */
template <class T>
void peano4::stacks::StackWithCustomSerialisation<T>::startSend(
  const peano4::stacks::SendReceiveContext context,
  const int                                rank,
  const int                                tag,
  const MPI_Comm                           comm
) {
  assertion(this->_transferMode == peano4::stacks::IOMode::None);
  assertion(this->size() > 0);
  assertion(not this->_transferIsActive);

  assertion(this->mpiCountRequest == MPI_REQUEST_NULL);
  assertion(this->mpiDataRequest == MPI_REQUEST_NULL);

  this->_transferMode = peano4::stacks::IOMode::MPISend;
  this->_transferTag  = tag;
  this->_transferRank = rank;

  logDebug(this->toString());

  T::startSend(*this, context, comm);

  this->_transferIsActive = true;
}

template <class T>
void peano4::stacks::StackWithCustomSerialisation<T>::startReceive(
  const peano4::stacks::SendReceiveContext context,
  const int                                rank,
  const int                                tag,
  const MPI_Comm                           comm,
  const int                                numberOfElements
) {
  assertion(this->_transferMode == peano4::stacks::IOMode::None, rank, tag, numberOfElements);
  assertion(numberOfElements > 0, rank, tag, numberOfElements);
  assertion(not this->_transferIsActive);

  assertion(this->mpiCountRequest == MPI_REQUEST_NULL);
  assertion(this->mpiDataRequest == MPI_REQUEST_NULL);

  this->_transferMode = peano4::stacks::IOMode::MPIReceive;
  this->_transferTag  = tag;
  this->_transferRank = rank;

  logDebug(this->toString());

  this->resize(numberOfElements);

  T::startReceive(*this, context, comm, numberOfElements);

  this->_transferIsActive = true;
}

template <class T>
bool peano4::stacks::StackWithCustomSerialisation<T>::tryToFinishSendOrReceive() {
  if (this->_transferMode == peano4::stacks::IOMode::None or not this->_transferIsActive) {
    return true;
  }

  const bool finished = T::tryToFinishSendOrReceive(*this);

  if (finished) {
    if (this->_transferMode == peano4::stacks::IOMode::MPISend) {
      this->shallowClear();
      logDebug("Send complete: " << this->toString());
    } else if (this->_transferMode == peano4::stacks::IOMode::MPIReceive) {
      logDebug("Receive complete: " << this->toString());
    }
    this->_transferMode     = peano4::stacks::IOMode::None;
    this->_transferIsActive = false;
    this->mpiCountRequest   = MPI_REQUEST_NULL;
    this->mpiDataRequest    = MPI_REQUEST_NULL;
  }

  return finished;
}
