template <class T>
INLINE_METHOD std::size_t peano4::stacks::Stack<T>::View::size() const {
  return _size;
}

template <class T>
INLINE_METHOD T& peano4::stacks::Stack<T>::View::get(const std::size_t index) {
  assertion(index < _size, index, _size);
  return _stack->_data[_baseElement + index];
}

template <class T>
INLINE_METHOD const T& peano4::stacks::Stack<T>::View::get(const std::size_t index) const {
  assertion(index < _size, index, _size);
  return _stack->_data[_baseElement + index];
}

template <class T>
INLINE_METHOD void peano4::stacks::Stack<T>::View::set(const std::size_t index, T&& value) {
  assertion(index < _size, index, _size);
  _stack->_data[_baseElement + index] = std::move(value);
}

template <class T>
template <class... Args>
INLINE_METHOD void peano4::stacks::Stack<T>::View::emplace(const std::size_t index, Args&&... args) noexcept(
  std::is_nothrow_destructible_v<T> and std::is_nothrow_constructible_v<T, Args...>
) {
  assertion(index < _size, index, _size);
  auto* const element = &_stack->_data[_baseElement + index];
  std::destroy_at(element);
  std::construct_at(element, std::forward<Args>(args)...);
}

template <class T>
INLINE_METHOD void peano4::stacks::Stack<T>::View::emplaceDefault(
  const std::size_t index
) noexcept(std::is_nothrow_destructible_v<T> and std::is_nothrow_default_constructible_v<T>) {
  emplace(index);
}

template <class T>
INLINE_METHOD peano4::stacks::Stack<T>::View::View(
  const std::size_t numberOfElements,
  const std::size_t baseElement,
  Stack<T>* const   owner
) :
  _size(numberOfElements),
  _baseElement(baseElement),
  _stack(owner) {}

template <class T>
INLINE_METHOD peano4::stacks::Stack<T>::Stack(Stack&& other) noexcept :
  _data(std::move(other._data)),
  _logicalSize(other._logicalSize),
  _transferMode(other._transferMode),
  _transferRank(other._transferRank),
  _transferTag(other._transferTag),
  _persistentTransfer(std::move(other._persistentTransfer)),
  _transferIsActive(other._transferIsActive) {
  other._logicalSize      = 0;
  other._transferMode     = peano4::stacks::IOMode::None;
  other._transferIsActive = false;
}

template <class T>
INLINE_METHOD peano4::stacks::Stack<T>& peano4::stacks::Stack<T>::operator=(Stack&& other) noexcept {
  if (this != &other) {
    _data               = std::move(other._data);
    _logicalSize        = other._logicalSize;
    _transferMode       = other._transferMode;
    _transferRank       = other._transferRank;
    _transferTag        = other._transferTag;
    _persistentTransfer = std::move(other._persistentTransfer);
    _transferIsActive   = other._transferIsActive;

    other._transferIsActive = false;
    other._logicalSize      = 0;
    other._transferMode     = peano4::stacks::IOMode::None;
  }
  return *this;
}

template <class T>
INLINE_METHOD std::size_t peano4::stacks::Stack<T>::push(const T& element)
  requires(std::is_copy_constructible_v<T> and (std::is_copy_assignable_v<T> or std::is_move_assignable_v<T>))
{
  assertion(_transferMode == peano4::stacks::IOMode::None, peano4::stacks::toString(_transferMode));

  if (_logicalSize < _data.size()) {
    if constexpr (std::is_copy_assignable_v<T>) {
      _data[_logicalSize] = element;
    } else {
      _data[_logicalSize] = T(element);
    }
  } else {
    _data.push_back(element);
  }
  return _logicalSize++;
}

template <class T>
INLINE_METHOD std::size_t peano4::stacks::Stack<T>::push(T&& element) {
  assertion(_transferMode == peano4::stacks::IOMode::None, peano4::stacks::toString(_transferMode));

  if (_logicalSize < _data.size()) {
    // The slot keeps its object, so T::operator= has to replace the full state
    // of that object, including an empty or invalid handle.
    _data[_logicalSize] = std::move(element);
  } else {
    _data.push_back(std::move(element));
  }
  return _logicalSize++;
}

template <class T>
template <typename... Args>
INLINE_METHOD std::size_t peano4::stacks::Stack<T>::emplace(Args&&... args) {
  if (_logicalSize < _data.size()) {
    _data[_logicalSize] = T(std::forward<Args>(args)...);
  } else {
    _data.emplace_back(std::forward<Args>(args)...);
  }
  return _logicalSize++;
}

/**
 * The removed element is replaced with the last element, so the order is not
 * preserved.
 */
template <class T>
INLINE_METHOD void peano4::stacks::Stack<T>::erase(const std::size_t index) {
  assertion(index < _logicalSize);
  _data[index] = std::move(_data[_logicalSize - 1]);
  --_logicalSize;
}

template <class T>
INLINE_METHOD void peano4::stacks::Stack<T>::reserve(const std::size_t size) {
  _data.reserve(size);
}

template <class T>
INLINE_METHOD void peano4::stacks::Stack<T>::resize(const std::size_t size) {
  if (size <= _data.size()) {
    _logicalSize = size;
  } else {
    _data.reserve(size);
    while (_data.size() < size) {
      _data.emplace_back();
    }
    _logicalSize = size;
  }
}

template <class T>
INLINE_METHOD T& peano4::stacks::Stack<T>::operator[](const std::size_t index) {
  assertion(index < _logicalSize);
  return _data[index];
}

template <class T>
INLINE_METHOD const T& peano4::stacks::Stack<T>::operator[](const std::size_t index) const {
  assertion(index < _logicalSize);
  return _data[index];
}

template <class T>
INLINE_METHOD T peano4::stacks::Stack<T>::pop() {
  assertion(_logicalSize > 0);
  auto topElement = std::move(_data[_logicalSize - 1]);
  --_logicalSize;
  return topElement;
}

/** Returns the element at the given offset from the top. */
template <class T>
INLINE_METHOD T& peano4::stacks::Stack<T>::top(const std::size_t shift) {
  assertion(_logicalSize > 0);
  assertion(shift < _logicalSize);
  return _data[_logicalSize - 1 - shift];
}

template <class T>
INLINE_METHOD const T& peano4::stacks::Stack<T>::top(const std::size_t shift) const {
  assertion(_logicalSize > 0);
  assertion(shift < _logicalSize);
  return _data[_logicalSize - 1 - shift];
}

template <class T>
INLINE_METHOD typename peano4::stacks::Stack<T>::View peano4::stacks::Stack<T>::popBlock(
  const std::size_t numberOfElements
) {
  assertion(numberOfElements <= _logicalSize);
  const std::size_t baseElement = _logicalSize - numberOfElements;
  View              block(numberOfElements, baseElement, this);
  _logicalSize = baseElement;
  return block;
}

template <class T>
INLINE_METHOD typename peano4::stacks::Stack<T>::View peano4::stacks::Stack<T>::pushBlock(
  const std::size_t numberOfElements
) {
  const std::size_t baseElement = _logicalSize;
  _logicalSize += numberOfElements;
  if (_data.size() < _logicalSize) {
    _data.reserve(_logicalSize);
    while (_data.size() < _logicalSize) {
      _data.emplace_back();
    }
  }
  // A slot keeps its object, so a caller that fills the view has to assign a
  // value whose assignment replaces the full state, including an empty or
  // invalid handle.
  return View(numberOfElements, baseElement, this);
}

template <class T>
INLINE_METHOD void peano4::stacks::Stack<T>::clone(const Stack<T>& other)
  requires std::is_copy_constructible_v<T>
{
  assertion(this->empty());
  const std::size_t numberOfElements = other._logicalSize;
  _data.clear();
  _data.reserve(numberOfElements);
  for (std::size_t elementIndex = 0; elementIndex < numberOfElements; ++elementIndex) {
    _data.emplace_back(other._data[elementIndex]);
  }
  _logicalSize = numberOfElements;
}

template <class T>
INLINE_METHOD std::string peano4::stacks::Stack<T>::toString() const {
  std::ostringstream description;
  description << "Stack{";
  description << "Size=" << size() << ", Mode=" << peano4::stacks::toString(_transferMode) << ", Rank=" << _transferRank
              << ", Tag=" << _transferTag;
  description << "}";
  return description.str();
}

template <class T>
INLINE_METHOD std::size_t peano4::stacks::Stack<T>::size() const noexcept {
  return _logicalSize;
}

template <class T>
INLINE_METHOD bool peano4::stacks::Stack<T>::empty() const noexcept {
  return _logicalSize == 0;
}

template <class T>
INLINE_METHOD void peano4::stacks::Stack<T>::clear() {
  shallowClear();
  _data.clear();
}

template <class T>
INLINE_METHOD void peano4::stacks::Stack<T>::shallowClear() {
  // The elements stay constructed for reuse, and their state survives until a
  // later push() or View::set() assignment replaces it.
  _logicalSize = 0;
}

/** Returns a byte count that the MPI interface can represent. */
template <class T>
INLINE_METHOD int peano4::stacks::Stack<T>::getMPIByteCount(
  const std::size_t numberOfElements,
  const std::size_t bytesPerElement
) {
  assertion(bytesPerElement > 0, bytesPerElement);
  constexpr auto MaximumByteCount = static_cast<std::size_t>(std::numeric_limits<int>::max());
  if (numberOfElements > MaximumByteCount / bytesPerElement) {
    tarch::terminateWithError("The stack payload exceeds MPI's maximum byte count.");
  }
  return static_cast<int>(numberOfElements * bytesPerElement);
}

/**
 * Posts a non-blocking send of the whole container as raw bytes. The message
 * reads from the container's buffer until tryToFinishSendOrReceive() reports
 * completion, so the container must not be modified while the send is active.
 *
 * @param context Exchange the data belongs to; every context ships the same payload.
 * @param rank Destination rank.
 * @param tag MPI tag.
 * @param comm MPI communicator.
 */
template <class T>
void peano4::stacks::Stack<T>::startSend(
  [[maybe_unused]] const peano4::stacks::SendReceiveContext context,
  const int                                                 rank,
  const int                                                 tag,
  const MPI_Comm                                            comm
) {
  assertion(_transferMode == peano4::stacks::IOMode::None);
  assertion(size() > 0);
  assertion(not _transferIsActive);

  const int numberOfBytes = getMPIByteCount(size(), sizeof(T));

  _transferMode = peano4::stacks::IOMode::MPISend;
  _transferTag  = tag;
  _transferRank = rank;

  logDebug(toString());

  _persistentTransfer.startSend(_data.data(), numberOfBytes, _transferRank, _transferTag, comm);
  _transferIsActive = true;
}

/**
 * Initiates a non-blocking receive into the container. @see startSend()
 *
 * @param context Exchange the data belongs to; every context ships the same payload.
 * @param rank Source rank.
 * @param tag MPI tag.
 * @param comm MPI communicator.
 * @param numberOfElements Number of elements expected.
 */
template <class T>
void peano4::stacks::Stack<T>::startReceive(
  [[maybe_unused]] const peano4::stacks::SendReceiveContext context,
  const int                                                 rank,
  const int                                                 tag,
  const MPI_Comm                                            comm,
  const int                                                 numberOfElements
) {
  assertion(_transferMode == peano4::stacks::IOMode::None, rank, tag, numberOfElements);
  assertion(numberOfElements > 0, rank, tag, numberOfElements);
  assertion(not _transferIsActive);

  const auto elementCount  = static_cast<std::size_t>(numberOfElements);
  const int  numberOfBytes = getMPIByteCount(elementCount, sizeof(T));
  resize(elementCount);

  _transferMode = peano4::stacks::IOMode::MPIReceive;
  _transferTag  = tag;
  _transferRank = rank;

  logDebug(toString());

  _persistentTransfer.startReceive(_data.data(), numberOfBytes, _transferRank, _transferTag, comm);
  _transferIsActive = true;
}

/**
 * One completion test for the active transfer. A stack without an active
 * transfer reports completion straight away. A completed send clears the
 * stack, as the data now travels through MPI; a completed receive keeps the
 * freshly arrived payload. Afterwards the state is IOMode::None.
 *
 * @return Whether no transfer is active any more.
 */
template <class T>
bool peano4::stacks::Stack<T>::tryToFinishSendOrReceive() {
  if (_transferMode == peano4::stacks::IOMode::None or not _transferIsActive) {
    return true;
  }

  int transferComplete = 0;
  tarch::mpi::test(_persistentTransfer.getRequest(), &transferComplete, MPI_STATUS_IGNORE);
  if (transferComplete) {
    if (_transferMode == peano4::stacks::IOMode::MPISend) {
      shallowClear();
      logDebug("Send complete: " << toString());
    } else if (_transferMode == peano4::stacks::IOMode::MPIReceive) {
      logDebug("Receive complete: " << toString());
    }
    _transferMode     = peano4::stacks::IOMode::None;
    _transferIsActive = false;

    return true;
  }

  return false;
}

template <class T>
INLINE_METHOD peano4::stacks::IOMode peano4::stacks::Stack<T>::getIOMode() const {
  return _transferMode;
}

/**
 * Partner rank and tag of the active transfer; both are -1 while none is
 * active.
 */
template <class T>
INLINE_METHOD int peano4::stacks::Stack<T>::getActiveIORank() const {
  return _transferMode == peano4::stacks::IOMode::None ? -1 : _transferRank;
}

template <class T>
INLINE_METHOD int peano4::stacks::Stack<T>::getActiveIOTag() const {
  return _transferMode == peano4::stacks::IOMode::None ? -1 : _transferTag;
}
