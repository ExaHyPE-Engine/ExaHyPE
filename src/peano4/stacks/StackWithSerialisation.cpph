/**
 * Serialises every element into one contiguous buffer and sends that buffer.
 * The elements own their storage, so their bytes cannot travel; the buffer
 * holds T::Cardinality unknowns per element in element order.
 */
template <class T>
void peano4::stacks::StackWithSerialisation<T>::startSend(
  [[maybe_unused]] const peano4::stacks::SendReceiveContext context,
  const int                                                 rank,
  const int                                                 tag,
  const MPI_Comm                                            comm
) {
  assertion(this->_transferMode == peano4::stacks::IOMode::None);
  assertion(this->size() > 0);
  assertion(not this->_transferIsActive);

  constexpr auto BytesPerElement  = static_cast<std::size_t>(T::Cardinality) * sizeof(typename T::DoFType);
  const auto     numberOfElements = this->size();
  const int      numberOfBytes    = this->getMPIByteCount(numberOfElements, BytesPerElement);
  _sendBuffer.resize(numberOfElements * static_cast<std::size_t>(T::Cardinality));
  serialise();

  this->_transferMode = peano4::stacks::IOMode::MPISend;
  this->_transferTag  = tag;
  this->_transferRank = rank;

  logDebug(this->toString());

  this->_persistentTransfer.startSend(_sendBuffer.data(), numberOfBytes, this->_transferRank, this->_transferTag, comm);
  this->_transferIsActive = true;
}

/**
 * Receives into the serialisation buffer. The elements are resized first, so
 * the completion can copy each element's part of the payload into it.
 */
template <class T>
void peano4::stacks::StackWithSerialisation<T>::startReceive(
  [[maybe_unused]] const peano4::stacks::SendReceiveContext context,
  const int                                                 rank,
  const int                                                 tag,
  const MPI_Comm                                            comm,
  const int                                                 numberOfElements
) {
  assertion(this->_transferMode == peano4::stacks::IOMode::None, rank, tag, numberOfElements);
  assertion(numberOfElements > 0, rank, tag, numberOfElements);
  assertion(not this->_transferIsActive);

  constexpr auto BytesPerElement = static_cast<std::size_t>(T::Cardinality) * sizeof(typename T::DoFType);
  const auto     elementCount    = static_cast<std::size_t>(numberOfElements);
  const int      numberOfBytes   = this->getMPIByteCount(elementCount, BytesPerElement);
  this->resize(elementCount);
  _receiveBuffer.resize(elementCount * static_cast<std::size_t>(T::Cardinality));

  this->_transferMode = peano4::stacks::IOMode::MPIReceive;
  this->_transferTag  = tag;
  this->_transferRank = rank;

  logDebug(this->toString());

  this->_persistentTransfer
    .startReceive(_receiveBuffer.data(), numberOfBytes, this->_transferRank, this->_transferTag, comm);
  this->_transferIsActive = true;
}

template <class T>
bool peano4::stacks::StackWithSerialisation<T>::tryToFinishSendOrReceive() {
  if (this->_transferMode == peano4::stacks::IOMode::None or not this->_transferIsActive) {
    return true;
  }

  int transferComplete = 0;
  tarch::mpi::test(this->_persistentTransfer.getRequest(), &transferComplete, MPI_STATUS_IGNORE);
  if (transferComplete) {
    if (this->_transferMode == peano4::stacks::IOMode::MPISend) {
      this->shallowClear();
      logDebug("Send complete: " << this->toString());
    } else if (this->_transferMode == peano4::stacks::IOMode::MPIReceive) {
      deserialise();
      logDebug("Receive complete: " << this->toString());
    }
    this->_transferMode     = peano4::stacks::IOMode::None;
    this->_transferIsActive = false;

    return true;
  }

  return false;
}

template <class T>
void peano4::stacks::StackWithSerialisation<T>::serialise() {
  for (std::size_t elementIndex = 0; elementIndex < this->size(); ++elementIndex) {
    // An element type may allocate its storage on demand, so the non-const
    // data() call materialises that storage before the copy reads it.
    typename T::DoFType* source = this->_data[elementIndex].data();
    assertion(source != nullptr);
    std::copy_n(source, T::Cardinality, _sendBuffer.data() + elementIndex * T::Cardinality);
  }
}

template <class T>
void peano4::stacks::StackWithSerialisation<T>::deserialise() {
  for (std::size_t elementIndex = 0; elementIndex < this->size(); ++elementIndex) {
    // An element type may allocate its storage on demand, so the non-const
    // data() call materialises that storage before the copy writes into it.
    typename T::DoFType* target = this->_data[elementIndex].data();
    if (target == nullptr) {
      this->_data[elementIndex] = T();
      target                    = this->_data[elementIndex].data();
    }
    assertion(target != nullptr);
    std::copy_n(_receiveBuffer.data() + elementIndex * T::Cardinality, T::Cardinality, target);
  }
}
