#include "peano4/Constants.h"
#include "tarch/Assertions.h"

/**
 * Returns the linearisation of counter, where entry k is multiplied by max^k
 * and the products are accumulated. Entry 0 runs fastest.
 */
INLINE_METHOD GPU_CALLABLE_METHOD int
peano4::dLinearised(const tarch::la::Vector<DIMENSIONS, int>& counter, int max) {
  int result = counter(DIMENSIONS - 1);
  assertion(counter(DIMENSIONS - 1) >= 0, counter, max);
  assertion(counter(DIMENSIONS - 1) < max, counter, max);
  for (int d = DIMENSIONS - 2; d >= 0; d--) {
    assertion(counter(d) >= 0, counter(d), max);
    assertion(counter(d) < max, counter(d), max);
    result = result * max + counter(d);
  }
  return result;
}

/**
 * Returns the linearisation of the entries of counter other than dim, the lowest
 * of those entries running fastest.
 */
INLINE_METHOD GPU_CALLABLE_METHOD int
peano4::dLinearisedExclusive(const tarch::la::Vector<DIMENSIONS, int>& counter, const int max, const int dim) {
  assertion(max > 0, counter, max);
  assertion(dim >= 0 and dim < DIMENSIONS, counter, dim);
  int result = 0;
  int stride = 1;
  for (int d = 0; d < DIMENSIONS; d++) {
    if (d != dim) {
      assertion(counter(d) >= 0, counter, max);
      assertion(counter(d) < max, counter, max);
      result += counter(d) * stride;
      stride *= max;
    }
  }
  return result;
}

/**
 * Returns the counter that dLinearised maps onto index, so entry 0 carries the
 * remainder of index by max and every higher entry follows by division.
 */
INLINE_METHOD GPU_CALLABLE_METHOD tarch::la::Vector<DIMENSIONS, int>
peano4::dDelinearised(const int index, const int max) {
  assertion(index >= 0, index, max);
  assertion(max > 0, index, max);
  tarch::la::Vector<DIMENSIONS, int> counter;
  int                                rest = index;
  for (int d = 0; d < DIMENSIONS - 1; d++) {
    counter(d) = rest % max;
    rest /= max;
  }
  counter(DIMENSIONS - 1) = rest;
  assertion(counter(DIMENSIONS - 1) < max, index, max);
  return counter;
}

/**
 * Returns the counter whose entry dim is zero and whose other entries carry
 * index, the lowest of those entries running fastest.
 */
INLINE_METHOD GPU_CALLABLE_METHOD tarch::la::Vector<DIMENSIONS, int>
peano4::dDelinearisedExclusive(const int index, const int max, const int dim) {
  assertion(index >= 0, index, max);
  assertion(max > 0, index, max);
  assertion(dim >= 0 and dim < DIMENSIONS, index, dim);
  tarch::la::Vector<DIMENSIONS, int> counter(0);
  int                                rest = index;
  for (int d = 0; d < DIMENSIONS; d++) {
    if (d != dim) {
      counter(d) = rest % max;
      rest /= max;
    }
  }
  assertion(rest == 0, index, max, dim);
  return counter;
}

/**
 * Invokes body(counter) for every point of [0,max)^d, entry 0 running
 * fastest. A constexpr function takes the execution space of its caller, so
 * host code passes host functors and a kernel passes device functors.
 */
template <typename Functor>
INLINE_METHOD constexpr void
peano4::dForEach(const int max, const Functor& body) {
  peano4::dForEach(tarch::la::Vector<DIMENSIONS, int>(max), body);
}

/**
 * Invokes body(counter) for every point of the box whose axis d runs over
 * [0,max(d)), entry 0 running fastest. A constexpr function takes the
 * execution space of its caller.
 */
template <typename Functor>
INLINE_METHOD constexpr void
peano4::dForEach(const tarch::la::Vector<DIMENSIONS, int>& max, const Functor& body) {
  tarch::la::Vector<DIMENSIONS, int> counter(0);
#if DIMENSIONS == 2
  for (counter(1) = 0; counter(1) < max(1); counter(1)++) {
    for (counter(0) = 0; counter(0) < max(0); counter(0)++) {
      body(counter);
    }
  }
#else
  static_assert(DIMENSIONS == 3, "dForEach() spans two or three dimensions.");
  for (counter(2) = 0; counter(2) < max(2); counter(2)++) {
    for (counter(1) = 0; counter(1) < max(1); counter(1)++) {
      for (counter(0) = 0; counter(0) < max(0); counter(0)++) {
        body(counter);
      }
    }
  }
#endif
}

/**
 * Invokes body for each of the 2^d cube corners with the corner and its
 * linearised index. A constexpr function takes the execution space of its
 * caller.
 */
template <typename Functor>
INLINE_METHOD constexpr void
peano4::dForEachCorner(const Functor& body) {
  int bit0 = 0;
  int bit1 = 0;
#if DIMENSIONS == 3
  int bit2 = 0;
#endif
  for (int scalar = 0; scalar < peano4::VerticesPerCell; scalar++) {
    tarch::la::Vector<DIMENSIONS, int> counter;
    counter(0) = bit0;
    counter(1) = bit1;
#if DIMENSIONS == 3
    counter(2) = bit2;
#endif
    bit0 = not bit0;
    bit1 = not(bit0 xor bit1);
#if DIMENSIONS == 3
    bit2 = bit2 or (not bit0 and not bit1 and not bit2);
#endif
    body(counter, scalar);
  }
}
