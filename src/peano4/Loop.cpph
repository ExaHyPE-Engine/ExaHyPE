/**
 * Returns a vector whose entries are all zero.
 */
INLINE_METHOD GPU_CALLABLE_METHOD tarch::la::Vector<DIMENSIONS, int> peano4::dStartVector() {
  tarch::la::Vector<DIMENSIONS, int> result(0);
  return result;
}

/**
 * Returns a vector whose entries are all zero besides the dim-th one, which
 * holds value.
 */
INLINE_METHOD GPU_CALLABLE_METHOD tarch::la::Vector<DIMENSIONS, int> peano4::dStartVector(int dim, int value) {
  tarch::la::Vector<DIMENSIONS, int> result(0);
  assertion(dim >= 0, dim, value);
  assertion(dim < DIMENSIONS, dim, value);
  assertion(value >= 0, dim, value);
  result(dim) = value;
  return result;
}

/**
 * Increments the first entry of counter, and carries over into the next entry
 * once an entry passes max-1.
 */
INLINE_METHOD GPU_CALLABLE_METHOD void peano4::dIncrement(tarch::la::Vector<DIMENSIONS, int>& counter, int max) {
  counter(0)++;
  for (int i = 0; i < DIMENSIONS - 1; i++) {
    if (counter(i) >= max) {
      counter(i) = 0;
      counter(i + 1)++;
    } else {
      break;
    }
  }
}

/**
 * Increments the first entry of counter, and carries over into the next entry
 * once an entry passes that entry's own max-1.
 */
INLINE_METHOD GPU_CALLABLE_METHOD void peano4::dIncrement(
  tarch::la::Vector<DIMENSIONS, int>&       counter,
  const tarch::la::Vector<DIMENSIONS, int>& max
) {
  counter(0)++;
  for (int i = 0; i < DIMENSIONS - 1; i++) {
    if (counter(i) >= max(i)) {
      counter(i) = 0;
      counter(i + 1)++;
    } else {
      break;
    }
  }
}

/**
 * Increments counter like dIncrement(counter, max) and leaves the entry
 * doNotExamine untouched.
 */
INLINE_METHOD GPU_CALLABLE_METHOD void peano4::dIncrement(
  tarch::la::Vector<DIMENSIONS, int>& counter,
  int                                 max,
  int                                 doNotExamine
) {
  assertion(doNotExamine < DIMENSIONS);
  assertion(doNotExamine >= -1);

  if (doNotExamine != 0) {
    counter(0)++;
  } else {
    counter(1)++;
  }
  for (int i = 0; i < DIMENSIONS - 1; i++) {
    // The pinned dimension counter(doNotExamine) stays at its start value (< max)
    // throughout, so it never triggers this carry.
    if (counter(i) >= max) {
      counter(i) = 0;
      if (doNotExamine != i + 1) {
        counter(i + 1)++;
      } else {
        // Entry i + 2 lies outside counter once doNotExamine is the last entry,
        // so the loop ends by setting counter(i) to max.
        if (doNotExamine != DIMENSIONS - 1) {
          counter(i + 2)++;
        } else {
          counter(i) = max;
        }
      }
    }
  }
}

/**
 * Returns whether all entries of counter are smaller than their corresponding
 * entries in max.
 */
INLINE_METHOD GPU_CALLABLE_METHOD int peano4::dCompare(
  const tarch::la::Vector<DIMENSIONS, int>& counter,
  const tarch::la::Vector<DIMENSIONS, int>& max
) {
  int result = 1;
  for (int i = 0; i < DIMENSIONS; i++) {
    assertion(counter(i) <= max(i), counter, max);
    assertion(counter(i) >= 0, counter, max);
    result &= static_cast<int>(counter(i) < max(i));
  }
  return result;
}

/**
 * Returns whether all entries of counter are smaller than max.
 */
INLINE_METHOD GPU_CALLABLE_METHOD int peano4::dCompare(const tarch::la::Vector<DIMENSIONS, int>& counter, int max) {
  int result = 1;
  for (int i = 0; i < DIMENSIONS; i++) {
    assertion(counter(i) <= max, counter, max);
    assertion(counter(i) >= 0, counter, max);
    result &= static_cast<int>(counter(i) < max);
  }
  return result;
}

/**
 * Returns whether all entries of counter besides the dim-th one are smaller
 * than max.
 */
INLINE_METHOD GPU_CALLABLE_METHOD int peano4::dCompareExclusive(
  const tarch::la::Vector<DIMENSIONS, int>& counter,
  int                                       max,
  int                                       dim
) {
  int result = 1;
  for (int i = 0; i < DIMENSIONS; i++) {
    if (i == dim) {
      continue;
    }
    assertion(counter(i) <= max, counter, max);
    assertion(counter(i) >= 0, counter, max);
    result &= static_cast<int>(counter(i) < max);
  }
  return result;
}

/**
 * Returns the linearisation of counter, where entry k is multiplied by max^k
 * and the products are accumulated. Entry 0 runs fastest.
 */
INLINE_METHOD GPU_CALLABLE_METHOD int peano4::dLinearised(const tarch::la::Vector<DIMENSIONS, int>& counter, int max) {
  int result = counter(DIMENSIONS - 1);
  assertion(counter(DIMENSIONS - 1) >= 0, counter, max);
  assertion(counter(DIMENSIONS - 1) < max, counter, max);
  for (int d = DIMENSIONS - 2; d >= 0; d--) {
    assertion(counter(d) >= 0, counter(d), max);
    assertion(counter(d) < max, counter(d), max);
    result = result * max + counter(d);
  }
  return result;
}

/**
 * Invokes body(counter) for every point of [0,max)^d, entry 0 running
 * fastest.
 */
template <typename Functor>
INLINE_METHOD GPU_CALLABLE_METHOD void peano4::dForEach(int max, const Functor& body) {
  for (tarch::la::Vector<DIMENSIONS, int> counter = dStartVector(); dCompare(counter, max); dIncrement(counter, max)) {
    body(counter);
  }
}

/**
 * Invokes body(counter) for every point of the box whose axis d runs over
 * [0,max(d)), entry 0 running fastest.
 */
template <typename Functor>
INLINE_METHOD GPU_CALLABLE_METHOD void peano4::dForEach(
  const tarch::la::Vector<DIMENSIONS, int>& max,
  const Functor&                            body
) {
  for (tarch::la::Vector<DIMENSIONS, int> counter = dStartVector(); dCompare(counter, max); dIncrement(counter, max)) {
    body(counter);
  }
}

/**
 * Invokes body(counter) for every point of [0,max)^d whose dimension dim holds
 * value.
 */
template <typename Functor>
INLINE_METHOD GPU_CALLABLE_METHOD void peano4::dForEachExclusive(int max, int dim, int value, const Functor& body) {
  for (tarch::la::Vector<DIMENSIONS, int> counter = dStartVector(dim, value); dCompareExclusive(counter, max, dim);
       dIncrement(counter, max, dim)) {
    body(counter);
  }
}

/**
 * Invokes body for each of the 2^d cube corners with the corner and its
 * linearised index.
 */
template <typename Functor>
INLINE_METHOD GPU_CALLABLE_METHOD void peano4::dForEachCorner(const Functor& body) {
  int bit0 = 0;
  int bit1 = 0;
#if DIMENSIONS == 3
  int bit2 = 0;
#endif
  for (int scalar = 0; scalar < peano4::VerticesPerCell; scalar++) {
    tarch::la::Vector<DIMENSIONS, int> counter;
    counter(0) = bit0;
    counter(1) = bit1;
#if DIMENSIONS == 3
    counter(2) = bit2;
#endif
    bit0 = not bit0;
    bit1 = not(bit0 xor bit1);
#if DIMENSIONS == 3
    bit2 = bit2 or (not bit0 and not bit1 and not bit2);
#endif
    body(counter, scalar);
  }
}

/**
 * Invokes body for each point of the 3^d stencil in lexicographic order with
 * the point and its linearised index.
 */
template <typename Functor>
INLINE_METHOD GPU_CALLABLE_METHOD void peano4::dForEachStencil(const Functor& body) {
  for (int scalar = 0; scalar < peano4::CellsPerNeighbourhood; scalar++) {
    tarch::la::Vector<DIMENSIONS, int> counter;
    int                                remainder = scalar;
    for (int d = DIMENSIONS - 1; d >= 0; d--) {
      int stride = 1;
      for (int factor = 0; factor < d; factor++) {
        stride *= peano4::NeighbourhoodWidth;
      }
      counter(d) = remainder / stride;
      remainder -= counter(d) * stride;
    }
    body(counter, scalar);
  }
}
