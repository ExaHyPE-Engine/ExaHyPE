/**
 * Selects the face the marker refers to and returns the marker.
 *
 * @param faceNumber Number from 0 to 2d-1
 */
INLINE_METHOD peano4::dataview::FaceMarker& peano4::dataview::FaceMarker::select(const int faceNumber) {
  assertion(faceNumber >= 0, faceNumber);
  assertion(faceNumber < peano4::FacesPerCell, faceNumber);
  selectedFace = faceNumber;
  return *this;
}

/**
 * Returns the number of the selected face; its value modulo DIMENSIONS is
 * the axis of the face normal.
 *
 * @see peano4::dataview::FaceEnumerator for a discussion of the face ordering.
 *
 * @return Number from 0 to 2d-1
 */
INLINE_METHOD int peano4::dataview::FaceMarker::getSelectedFaceNumber() const { return selectedFace; }

/**
 * Returns the centre of face faceNumber of the cell.
 */
INLINE_METHOD tarch::la::Vector<DIMENSIONS, double> peano4::dataview::FaceMarker::getX(const int faceNumber) const {
  assertion(faceNumber >= 0, faceNumber);
  assertion(faceNumber < peano4::FacesPerCell, faceNumber);
  auto       result          = cellCentre;
  const auto normalDimension = faceNumber % DIMENSIONS;
  result(normalDimension) += faceNumber >= DIMENSIONS ? h(normalDimension) / 2.0 : -h(normalDimension) / 2.0;
  return result;
}

/**
 * Returns the centre of the selected face; getX(int) returns the centre of
 * any face of the cell.
 *
 * @see select(int)
 */
INLINE_METHOD tarch::la::Vector<DIMENSIONS, double> peano4::dataview::FaceMarker::getX() const {
  return getX(selectedFace);
}

/**
 * Returns the normal of face faceNumber, scaled with the cell width and
 * oriented from the cell's point of view, so a marker built from the other
 * adjacent cell returns the mirrored normal. Face faceNumber has its normal
 * along axis faceNumber modulo DIMENSIONS, and the faces below DIMENSIONS
 * lie closer to the origin of the unit cube.
 *
 * @image html FaceEnumerator.png
 */
INLINE_METHOD tarch::la::Vector<DIMENSIONS, double> peano4::dataview::FaceMarker::normal(const int faceNumber) const {
  assertion(faceNumber >= 0, faceNumber);
  assertion(faceNumber < peano4::FacesPerCell, faceNumber);
  auto       result          = tarch::la::Vector<DIMENSIONS, double>{0.0};
  const auto normalDimension = faceNumber % DIMENSIONS;
  result(normalDimension)    = faceNumber < DIMENSIONS ? -h(normalDimension) : h(normalDimension);
  return result;
}

INLINE_METHOD tarch::la::Vector<DIMENSIONS, double> peano4::dataview::FaceMarker::normal() const {
  return normal(selectedFace);
}

/**
 * Returns the normal of face faceNumber oriented away from the local
 * domain: For a remote cell the sign of normal(int) flips.
 */
INLINE_METHOD tarch::la::Vector<DIMENSIONS, double> peano4::dataview::FaceMarker::outerNormal(
  const int faceNumber
) const {
  auto result = normal(faceNumber);
  if (not cellIsLocal) {
    result *= -1.0;
  }
  return result;
}

INLINE_METHOD tarch::la::Vector<DIMENSIONS, double> peano4::dataview::FaceMarker::outerNormal() const {
  return outerNormal(selectedFace);
}

/**
 * Returns the width of the cell.
 */
INLINE_METHOD const tarch::la::Vector<DIMENSIONS, double>& peano4::dataview::FaceMarker::getH() const { return h; }

/**
 * Returns whether the selected face holds a refined vertex. A refined vertex
 * refines every adjacent cell, so such a face lies between two refined cells
 * and is not hanging.
 */
INLINE_METHOD bool peano4::dataview::FaceMarker::hasBeenRefined() const { return hasBeenRefined(selectedFace); }

INLINE_METHOD bool peano4::dataview::FaceMarker::hasBeenRefined(const int faceNumber) const {
  return isSet(hasBeenRefinedMask, faceNumber);
}

INLINE_METHOD bool peano4::dataview::FaceMarker::willBeRefined() const { return willBeRefined(selectedFace); }

INLINE_METHOD bool peano4::dataview::FaceMarker::willBeRefined(const int faceNumber) const {
  return isSet(willBeRefinedMask, faceNumber);
}

/**
 * Returns whether the cell of the marker has been refined. A face of such a
 * cell holds no data of its own, because the faces of the children carry it,
 * and a face without a refined vertex does not report this through
 * hasBeenRefined().
 */
INLINE_METHOD bool peano4::dataview::FaceMarker::hasCellBeenRefined() const { return cellHasBeenRefined; }

INLINE_METHOD bool peano4::dataview::FaceMarker::willCellBeRefined() const { return cellWillBeRefined; }

INLINE_METHOD bool peano4::dataview::FaceMarker::isLocal() const { return isLocal(selectedFace); }

INLINE_METHOD bool peano4::dataview::FaceMarker::isLocal(const int faceNumber) const {
  return isSet(isLocalMask, faceNumber);
}

INLINE_METHOD bool peano4::dataview::FaceMarker::isHanging() const { return isHanging(selectedFace); }

INLINE_METHOD bool peano4::dataview::FaceMarker::isHanging(const int faceNumber) const {
  return isSet(isHangingMask, faceNumber);
}

/**
 * Returns the face position in the parent's pattern of children.
 */
INLINE_METHOD tarch::la::Vector<DIMENSIONS, int> peano4::dataview::FaceMarker::
  getRelativePositionWithinFatherCell() const {
  return getRelativePositionWithinFatherCell(selectedFace);
}

INLINE_METHOD tarch::la::Vector<DIMENSIONS, int> peano4::dataview::FaceMarker::getRelativePositionWithinFatherCell(
  const int faceNumber
) const {
  assertion(faceNumber >= 0, faceNumber);
  assertion(faceNumber < peano4::FacesPerCell, faceNumber);
  auto       result          = relativePositionWithinFatherCell;
  const auto normalDimension = faceNumber % DIMENSIONS;
  result(normalDimension) += faceNumber >= DIMENSIONS ? 1 : 0;
  return result;
}

/**
 * Returns the position of the selected face within its father face: The
 * entries of the father-cell position along every axis except the axis of the
 * face normal, in ascending order of the axis.
 */
INLINE_METHOD tarch::la::Vector<DIMENSIONS - 1, int> peano4::dataview::FaceMarker::
  getRelativePositionWithinFatherFace() const {
  assertion(getSelectedFaceNumber() >= 0, getSelectedFaceNumber());
  assertion(getSelectedFaceNumber() < peano4::FacesPerCell, getSelectedFaceNumber());
  const auto normalDimension = getSelectedFaceNumber() % DIMENSIONS;
  auto       result          = tarch::la::Vector<DIMENSIONS - 1, int>{};
  int        faceDimension   = 0;
  for (int dimension = 0; dimension < DIMENSIONS; dimension++) {
    if (dimension != normalDimension) {
      result(faceDimension) = relativePositionWithinFatherCell(dimension);
      faceDimension++;
    }
  }
  return result;
}

/**
 * Identifies faces between two children of the same refined cell.
 */
INLINE_METHOD bool peano4::dataview::FaceMarker::isInteriorFaceWithinPatch() const {
  assertion(getSelectedFaceNumber() >= 0, getSelectedFaceNumber());
  assertion(getSelectedFaceNumber() < peano4::FacesPerCell, getSelectedFaceNumber());
  const auto normalDimension = getSelectedFaceNumber() % DIMENSIONS;
  const auto isLowerFace     = getSelectedFaceNumber() < DIMENSIONS;
  const auto facePosition    = relativePositionWithinFatherCell(normalDimension) + (isLowerFace ? 0 : 1);
  return facePosition > 0 and facePosition < peano4::sfc::ActiveCurve::SubdivisionFactor;
}

INLINE_METHOD bool peano4::dataview::FaceMarker::isSet(const std::uint8_t mask, const int faceNumber) {
  assertion(faceNumber >= 0, faceNumber);
  assertion(faceNumber < peano4::FacesPerCell, faceNumber);
  return ((mask >> faceNumber) & 1U) != 0;
}
