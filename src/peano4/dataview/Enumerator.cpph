template <class Element, int Cardinality>
INLINE_METHOD peano4::dataview::Enumerator<Element, Cardinality>::Enumerator(
  Element* const   pool,
  const int* const slots,
  const int        sentinelSlot
) {
  assertion(pool != nullptr);
  assertion(slots != nullptr);
  assertion(sentinelSlot >= 0, sentinelSlot);
  for (int index = 0; index < Cardinality; index++) {
    _elements[index] = pool + (slots[index] >= 0 ? slots[index] : sentinelSlot);
  }
}

template <class Element, int Cardinality>
INLINE_METHOD Element& peano4::dataview::Enumerator<Element, Cardinality>::operator()(const int index) const {
  assertion(index >= 0, index);
  assertion(index < Cardinality, index);
  return *_elements[index];
}
