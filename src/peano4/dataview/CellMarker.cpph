INLINE_METHOD bool peano4::dataview::CellMarker::hasBeenRefined() const { return (flags & HasBeenRefined) != 0; }

INLINE_METHOD bool peano4::dataview::CellMarker::willBeRefined() const { return (flags & WillBeRefined) != 0; }

INLINE_METHOD bool peano4::dataview::CellMarker::isLocal() const { return (flags & IsLocal) != 0; }

INLINE_METHOD bool peano4::dataview::CellMarker::isParentLocal() const { return (flags & IsParentLocal) != 0; }

INLINE_METHOD const tarch::la::Vector<DIMENSIONS, double>& peano4::dataview::CellMarker::getH() const { return h; }

INLINE_METHOD const tarch::la::Vector<DIMENSIONS, double>& peano4::dataview::CellMarker::getX() const { return centre; }

INLINE_METHOD tarch::la::Vector<DIMENSIONS, double> peano4::dataview::CellMarker::getOffset() const {
  return centre - 0.5 * h;
}

INLINE_METHOD const tarch::la::Vector<DIMENSIONS, int>& peano4::dataview::CellMarker::
  getRelativePositionWithinFatherCell() const {
  return relativePositionWithinFatherCell;
}

INLINE_METHOD tarch::la::Vector<DIMENSIONS, double> peano4::dataview::CellMarker::getInvokingParentCellsCentre() const {
  auto result = centre;
  for (int dimension = 0; dimension < DIMENSIONS; dimension++) {
    assertion(relativePositionWithinFatherCell[dimension] >= 0, toString());
    assertion(relativePositionWithinFatherCell[dimension] <= 2, toString());
    result[dimension] += (1 - relativePositionWithinFatherCell[dimension]) * h[dimension];
  }
  return result;
}

INLINE_METHOD bool peano4::dataview::CellMarker::isContained(
  const tarch::la::Vector<DIMENSIONS, double>& position,
  const double                                 tolerance
) const {
  return isContained(position, centre, h, tolerance);
}

INLINE_METHOD bool peano4::dataview::CellMarker::isContained(
  const tarch::la::Vector<DIMENSIONS, double>& position,
  const tarch::la::Vector<DIMENSIONS, double>& cellCentre,
  const tarch::la::Vector<DIMENSIONS, double>& cellSize,
  const double                                 tolerance
) {
  for (int dimension = 0; dimension < DIMENSIONS; dimension++) {
    if (not tarch::la::greaterEquals(position(dimension), cellCentre(dimension) - cellSize(dimension) / 2.0, tolerance)
        or not tarch::la::smallerEquals(
          position(dimension),
          cellCentre(dimension) + cellSize(dimension) / 2.0,
          tolerance
        )) {
      return false;
    }
  }
  return true;
}

INLINE_METHOD bool peano4::dataview::CellMarker::overlaps(
  const tarch::la::Vector<DIMENSIONS, double>& regionOffset,
  const tarch::la::Vector<DIMENSIONS, double>& regionSize
) const {
  for (int dimension = 0; dimension < DIMENSIONS; dimension++) {
    if (not tarch::la::smallerEquals(
          centre(dimension) - h(dimension) / 2.0,
          regionOffset(dimension) + regionSize(dimension)
        )
        or not tarch::la::greaterEquals(centre(dimension) + h(dimension) / 2.0, regionOffset(dimension))) {
      return false;
    }
  }
  return true;
}
