#include "tarch/Assertions.h"
#include "tarch/mpi/Rank.h"
#include "tarch/plotter/CellTypes.h"
#include "tarch/plotter/FileWriter.h"

INLINE_METHOD
exahype2::plotter::ParticlePlotter::ParticlePlotter(std::string filename) :
  _filename(std::move(filename)) {
  assertion(not _filename.empty());
}

/**
 * Writes one snapshot of the particles of every rank in the order of their numbers. Particles has
 * the interface of exahype2::particles::ParticleSet. Every rank calls this function collectively.
 */
template <typename Particles>
INLINE_METHOD void
exahype2::plotter::ParticlePlotter::plot(
  Particles&                   particles,
  const double                 timeStamp,
  const tarch::plotter::Format format,
  const std::string&           outputDirectory
) {
  using Values               = tarch::plotter::MeshArray<double>;
  constexpr int NumberOfData = Particles::ValuesPerParticle - DIMENSIONS;
  static_assert(NumberOfData >= 0);
  particles.download();
  const auto numberOfParticles = static_cast<std::size_t>(particles.getSize());
  const int  rank              = tarch::mpi::Rank::getInstance().getRank();

  tarch::plotter::Mesh mesh;
  mesh.pointsXYZ.assign(numberOfParticles * 3, 0.0);
  mesh.connectivity.resize(numberOfParticles);
  mesh.offsets.resize(numberOfParticles);
  mesh.types.assign(numberOfParticles, static_cast<std::uint8_t>(tarch::plotter::CellType::Vertex));
  mesh.cellFields.push_back({"Number", 2, Values(numberOfParticles * 2)});
  if constexpr (NumberOfData > 0) {
    mesh.cellFields.push_back({"Data", NumberOfData, Values(numberOfParticles * NumberOfData)});
  }
  mesh.cellFields.push_back({"RefinementLevel", 1, Values(numberOfParticles, 1.0)});
  mesh.cellFields.push_back({"Subdomain", 1, Values(numberOfParticles, static_cast<double>(rank))});

  std::vector<int> order(numberOfParticles);
  std::iota(order.begin(), order.end(), 0);
  std::sort(order.begin(), order.end(), [&particles](const int left, const int right) {
    return particles.getNumber(left) < particles.getNumber(right);
  });
  for (std::size_t particle = 0; particle < numberOfParticles; particle++) {
    const int  index    = order[particle];
    const auto position = particles.getPosition(index);
    for (int axis = 0; axis < DIMENSIONS; axis++) {
      mesh.pointsXYZ[particle * 3 + static_cast<std::size_t>(axis)] = position(axis);
    }
    mesh.connectivity[particle] = static_cast<std::int32_t>(particle);
    mesh.offsets[particle]      = static_cast<std::int32_t>(particle + 1);

    const auto number                           = particles.getNumber(index);
    mesh.cellFields[0].values[particle * 2]     = static_cast<double>(number.first);
    mesh.cellFields[0].values[particle * 2 + 1] = static_cast<double>(number.second);
    if constexpr (NumberOfData > 0) {
      const double* const data = particles.getData(index);
      for (int entry = 0; entry < NumberOfData; entry++) {
        mesh.cellFields[1].values[particle * NumberOfData + static_cast<std::size_t>(entry)] = data[entry];
      }
    }
  }

  if (_fileWriter == nullptr) {
    _fileWriter = tarch::plotter::createFileWriter(format);
  }
  assertion(_fileWriter->getFormat() == format);
  _fileWriter->write(mesh, outputDirectory + OutputSubdirectory, _filename, timeStamp);
}
