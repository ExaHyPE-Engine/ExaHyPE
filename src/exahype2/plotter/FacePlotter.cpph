#include "peano4/Constants.h"
#include "peano4/Loop.h"
#include "peano4/Partition.h"
#include "tarch/Assertions.h"
#include "tarch/accelerator/ParallelFor.h"
#include "tarch/accelerator/Range.h"
#include "tarch/mpi/Rank.h"
#include "tarch/plotter/CellTypes.h"
#include "tarch/plotter/FileWriter.h"

/**
 * Writes one snapshot of every face for which plotsFace(faceCentre, cellWidth, normal) is true.
 * Face f starts at values + f * valuesPerFace with the lower half, followed by the upper half, each
 * with ValuesPerNode values per node and the lower tangential axis fastest. Every rank calls this
 * function collectively.
 */
template <int NodesPerAxis, int ValuesPerNode, typename Precision, typename Predicate>
INLINE_METHOD void
exahype2::plotter::FacePlotter::plot(
  const peano4::Partition&     partition,
  const Precision* const       values,
  const int                    valuesPerFace,
  const double* const          quadratureNodes,
  const double                 timeStamp,
  const tarch::plotter::Format format,
  const std::string&           outputDirectory,
  const Predicate&             plotsFace
) {
  static_assert(NodesPerAxis > 0 and ValuesPerNode > 0);
  constexpr int  NodesPerFace   = peano4::power(NodesPerAxis, DIMENSIONS - 1);
  constexpr int  CellsPerFace   = peano4::power(NodesPerAxis - 1, DIMENSIONS - 1);
  constexpr int  CornersPerCell = peano4::VerticesPerCell / 2;
  constexpr auto CellType = DIMENSIONS == 2 ? tarch::plotter::CellType::Line : tarch::plotter::CellType::Quadrangle;
  assertion(values != nullptr or partition.getNumberOfFaces() == 0);
  assertion(valuesPerFace >= 2 * NodesPerFace * ValuesPerNode, valuesPerFace);
  assertion(quadratureNodes != nullptr);
  for ([[maybe_unused]] const auto& field : _fields) {
    assertion(field.components > 0, field.name, field.components);
  }

  std::vector<int> faces;
  for (const int face : getPlottedFaces(partition)) {
    if (plotsFace(partition.getFaceCentre(face), partition.getFaceWidth(face), partition.getFaceNormal(face))) {
      faces.push_back(face);
    }
  }
  const auto        numberOfFaces  = faces.size();
  const auto        numberOfCells  = numberOfFaces * CellsPerFace;
  const auto        numberOfPoints = numberOfFaces * NodesPerFace;
  const std::string directory      = outputDirectory + OutputSubdirectory;
  const int         rank           = tarch::mpi::Rank::getInstance().getRank();

  _snapshot.openFile(format, directory, timeStamp);
  auto& writer = _snapshot.getFileWriter();
  auto& piece  = writer.getPieceBuffers(writer.acquirePiece(rank));

  piece.pointsXYZ.assign(numberOfPoints * 3, 0.0);
  piece.connectivity.resize(numberOfCells * CornersPerCell);
  piece.offsets.resize(numberOfCells);
  piece.types.assign(numberOfCells, static_cast<std::uint8_t>(CellType));
  piece.pointFields.clear();
  piece.cellFields.clear();
  [[maybe_unused]] int plottedValues = 0;
  for (const auto& field : _fields) {
    piece.pointFields.push_back(
      {field.name + "L", field.components, std::vector<double>(numberOfPoints * field.components)}
    );
    piece.pointFields.push_back(
      {field.name + "R", field.components, std::vector<double>(numberOfPoints * field.components)}
    );
    plottedValues += field.components;
  }
  assertion(plottedValues <= ValuesPerNode, plottedValues, ValuesPerNode);
  piece.cellFields.push_back({"RefinementLevel", 1, std::vector<double>(numberOfCells)});
  piece.cellFields.push_back({"Subdomain", 1, std::vector<double>(numberOfCells, static_cast<double>(rank))});

  tarch::accelerator::parallelForOnHost(
    tarch::accelerator::Range(static_cast<int>(numberOfFaces)),
    [&](const int entry) {
      const int              face       = faces[static_cast<std::size_t>(entry)];
      const int              normal     = partition.getFaceNormal(face);
      const auto             centre     = partition.getFaceCentre(face);
      const auto             width      = partition.getFaceWidth(face);
      const std::size_t      firstPoint = static_cast<std::size_t>(entry) * NodesPerFace;
      const std::size_t      firstCell  = static_cast<std::size_t>(entry) * CellsPerFace;
      const Precision* const lower      = values + static_cast<std::size_t>(face) * valuesPerFace;
      const Precision* const upper      = lower + NodesPerFace * ValuesPerNode;

      for (int node = 0; node < NodesPerFace; node++) {
        const auto nodeIndex = peano4::dDelinearisedExclusive(node, NodesPerAxis, normal);
        for (int axis = 0; axis < DIMENSIONS; axis++) {
          double coordinate = centre(axis);
          if (axis != normal) {
            coordinate = centre(axis) - 0.5 * width(axis) + quadratureNodes[nodeIndex(axis)] * width(axis);
          }
          piece.pointsXYZ[(firstPoint + node) * 3 + axis] = coordinate;
        }
        int firstComponent = 0;
        for (std::size_t field = 0; field < _fields.size(); field++) {
          const int components = _fields[field].components;
          for (int component = 0; component < components; component++) {
            const int value = node * ValuesPerNode + firstComponent + component;
            piece.pointFields[2 * field].values[(firstPoint + node) * components + component] =
              static_cast<double>(lower[value]);
            piece.pointFields[2 * field + 1].values[(firstPoint + node) * components + component] =
              static_cast<double>(upper[value]);
          }
          firstComponent += components;
        }
      }

      for (int cell = 0; cell < CellsPerFace; cell++) {
        for (int corner = 0; corner < CornersPerCell; corner++) {
          const auto cellIndex = peano4::dDelinearised(cell, NodesPerAxis - 1);
          int        node      = 0;
          int        stride    = 1;
          for (int tangential = 0; tangential < DIMENSIONS - 1; tangential++) {
            node += (cellIndex(tangential) + CellCorners[corner][tangential]) * stride;
            stride *= NodesPerAxis;
          }
          piece.connectivity[(firstCell + cell) * CornersPerCell + corner] =
            static_cast<std::int32_t>(firstPoint) + node;
        }
        piece.offsets[firstCell + cell] = static_cast<std::int32_t>((firstCell + cell + 1) * CornersPerCell);
        piece.cellFields[0].values[firstCell + cell] = static_cast<double>(partition.getFaceLevel(face));
      }
    }
  );

  _snapshot.writeFile(directory, _filename);
}
