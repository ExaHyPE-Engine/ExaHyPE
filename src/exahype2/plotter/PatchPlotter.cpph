#include "peano4/CellConnectivity.h"
#include "peano4/Loop.h"
#include "tarch/Assertions.h"
#include "tarch/accelerator/ChunkedMemoryPool.h"
#include "tarch/accelerator/ParallelFor.h"
#include "tarch/accelerator/Range.h"
#include "tarch/la/Vector.h"
#include "tarch/mpi/Rank.h"
#include "tarch/plotter/CellTypes.h"

/**
 * Writes one snapshot of the cells with one plot cell per finite volume and the interior
 * volume corners of the patches before the corners on the patch faces. Every rank calls this at
 * the same time. The chunk of a slot in values stores the volumes of its patch in linearised order
 * with ValuesPerVolume values each. With volumeStatuses, the cell field statusName stores the
 * status of each volume from its chunk.
 */
template <int VolumesPerAxis, int ValuesPerVolume, typename Precision>
INLINE_METHOD void
exahype2::plotter::PatchPlotter::plotVolumes(
  const peano4::CellConnectivity&                         cellConnectivity,
  const tarch::Span<const int>                            cells,
  const tarch::accelerator::ChunkedMemoryPool<Precision>& values,
  const double                                            timeStamp,
  const tarch::plotter::Format                            format,
  const std::string&                                      outputDirectory,
  const tarch::accelerator::ChunkedMemoryPool<int>* const volumeStatuses,
  const char* const                                       statusName
) {
  static_assert(VolumesPerAxis > 0 and ValuesPerVolume > 0);
  constexpr int CornersPerAxis          = VolumesPerAxis + 1;
  constexpr int CellsPerPatch           = peano4::power(VolumesPerAxis, DIMENSIONS);
  constexpr int CornersPerPatch         = peano4::power(CornersPerAxis, DIMENSIONS);
  constexpr int InteriorCornersPerPatch = peano4::power(VolumesPerAxis - 1, DIMENSIONS);
  constexpr int FaceCornersPerPatch     = CornersPerPatch - InteriorCornersPerPatch;
  assertion(
    cells.size >= 0 and cells.size <= cellConnectivity.getNumberOfSlots(),
    cells.size,
    cellConnectivity.getNumberOfSlots()
  );
  assertion(values.isHostAccessible());
  assertion(values.getChunkSize() >= CellsPerPatch * ValuesPerVolume, values.getChunkSize());

  const auto             corners          = classifyCorners(CornersPerAxis);
  const FaceCornerPoints faceCornerPoints = numberFaceCorners<VolumesPerAxis>(cellConnectivity, cells, corners);
  const std::size_t      interiorCorners  = static_cast<std::size_t>(cells.size) * InteriorCornersPerPatch;
  const auto             facePoints       = static_cast<std::size_t>(faceCornerPoints.firstPointOfPatch.back());
  tarch::plotter::Mesh   mesh =
    createMesh(cells.size, CellsPerPatch, interiorCorners + facePoints, false, volumeStatuses != nullptr ? statusName : nullptr);
  assertion(volumeStatuses == nullptr or volumeStatuses->isHostAccessible());
  assertion(volumeStatuses == nullptr or statusName != nullptr);
  const double           rank = static_cast<double>(tarch::mpi::Rank::getInstance().getRank());

  tarch::accelerator::parallelForOnHost(tarch::accelerator::Range(cells.size), [&](const int patch) {
    const int          cell                = cells[patch];
    const std::size_t  firstCell           = static_cast<std::size_t>(patch) * CellsPerPatch;
    const std::size_t  firstInteriorCorner = static_cast<std::size_t>(patch) * InteriorCornersPerPatch;
    const std::size_t  firstFaceCorner     = static_cast<std::size_t>(patch) * FaceCornersPerPatch;
    const std::int32_t firstOwnedPoint     = faceCornerPoints.firstPointOfPatch[static_cast<std::size_t>(patch)];
    const auto         centre              = cellConnectivity.getCellCentre(cell);
    const auto         width               = cellConnectivity.getCellWidth(cell);
    const auto         pointOfCorner       = [&](const PatchCorner& patchCorner) {
      return patchCorner.onFace ? interiorCorners
          + static_cast<std::size_t>(faceCornerPoints.pointOfFaceCorner[firstFaceCorner + patchCorner.index])
                                : firstInteriorCorner + static_cast<std::size_t>(patchCorner.index);
    };
    peano4::dForEach(CornersPerAxis, [&](const tarch::la::Vector<DIMENSIONS, int>& cornerIndex) {
      const PatchCorner& patchCorner =
        corners[static_cast<std::size_t>(peano4::dLinearised(cornerIndex, CornersPerAxis))];
      if (
        patchCorner.onFace and faceCornerPoints.pointOfFaceCorner[firstFaceCorner + patchCorner.index] < firstOwnedPoint
      ) {
        return;
      }
      const std::size_t point = pointOfCorner(patchCorner);
      assertion(point * 3 < mesh.pointsXYZ.size(), point, mesh.pointsXYZ.size());
      for (int axis = 0; axis < DIMENSIONS; axis++) {
        const double fraction            = static_cast<double>(cornerIndex(axis)) / VolumesPerAxis;
        mesh.pointsXYZ[point * 3 + axis] = centre(axis) - 0.5 * width(axis) + fraction * width(axis);
      }
      for (int axis = DIMENSIONS; axis < 3; axis++) {
        mesh.pointsXYZ[point * 3 + axis] = 0.0;
      }
    });
    connectPatch<CornersPerAxis>(
      [&](const int corner) {
        return static_cast<std::int32_t>(pointOfCorner(corners[static_cast<std::size_t>(corner)]));
      },
      firstCell,
      mesh
    );
    std::fill_n(
      mesh.cellFields[_fields.size() + RefinementLevelField].values.begin() + firstCell,
      CellsPerPatch,
      static_cast<double>(cellConnectivity.getCellLevel(cell))
    );
    std::fill_n(mesh.cellFields[_fields.size() + SubdomainField].values.begin() + firstCell, CellsPerPatch, rank);
    std::fill_n(
      mesh.cellFields[_fields.size() + CurveIndexField].values.begin() + firstCell,
      CellsPerPatch,
      static_cast<double>(cellConnectivity.getCellCurveIndex(cell))
    );
    const Precision* const volumes = values.getChunk(cell);
    for (int volume = 0; volume < CellsPerPatch; volume++) {
      copyState(volumes + volume * ValuesPerVolume, ValuesPerVolume, firstCell + volume, mesh.cellFields);
    }
    if (volumeStatuses != nullptr) {
      const int* const statuses = volumeStatuses->getChunk(cell);
      for (int volume = 0; volume < CellsPerPatch; volume++) {
        mesh.cellFields[_fields.size() + CurveIndexField + 1].values[firstCell + volume] = static_cast<double>(statuses[volume]);
      }
    }
  });
  write(mesh, timeStamp, format, outputDirectory);
}

/**
 * Writes a snapshot of the nodal values. Each chunk in values stores ValuesPerNode values per node.
 * The array nodePositions stores the NodesPerAxis node coordinates within the unit interval.
 */
template <int NodesPerAxis, int ValuesPerNode, typename Precision>
INLINE_METHOD void
exahype2::plotter::PatchPlotter::plotNodes(
  const peano4::CellConnectivity&                         cellConnectivity,
  const tarch::Span<const int>                            cells,
  const tarch::accelerator::ChunkedMemoryPool<Precision>& values,
  const double* const                                     nodePositions,
  const double                                            timeStamp,
  const tarch::plotter::Format                            format,
  const std::string&                                      outputDirectory
) {
  plotNodes<NodesPerAxis, ValuesPerNode, NodesPerAxis, Precision>(
    cellConnectivity,
    cells,
    values,
    nodePositions,
    nullptr,
    nullptr,
    0,
    nullptr,
    timeStamp,
    format,
    outputDirectory
  );
}

/**
 * Writes nodal values at their node positions or repeats a single node at the patch corners.
 * A patch with status at least subcellStatus reads each node from its containing subcell. The
 * cell field statusName stores the statuses. The function writes the status field only if
 * statuses is non-null.
 */
template <int NodesPerAxis, int ValuesPerNode, int SubcellsPerAxis, typename Precision>
INLINE_METHOD void
exahype2::plotter::PatchPlotter::plotNodes(
  const peano4::CellConnectivity&                                                     cellConnectivity,
  const tarch::Span<const int>                                                        cells,
  const tarch::accelerator::ChunkedMemoryPool<Precision>&                             values,
  const double* const                                                                 nodePositions,
  const tarch::accelerator::ChunkedMemoryPool<std::type_identity_t<Precision>>* const subcellValues,
  const tarch::accelerator::ChunkedMemoryPool<int>* const                             statuses,
  const int                                                                           subcellStatus,
  const char* const                                                                   statusName,
  const double                                                                        timeStamp,
  const tarch::plotter::Format                                                        format,
  const std::string&                                                                  outputDirectory
) {
  static_assert(NodesPerAxis > 0 and ValuesPerNode > 0 and SubcellsPerAxis > 0);
  constexpr int PointsPerAxis  = std::max(NodesPerAxis, 2);
  constexpr int PointsPerPatch = peano4::power(PointsPerAxis, DIMENSIONS);
  constexpr int CellsPerPatch  = peano4::power(PointsPerAxis - 1, DIMENSIONS);
  assertion(
    cells.size >= 0 and cells.size <= cellConnectivity.getNumberOfSlots(),
    cells.size,
    cellConnectivity.getNumberOfSlots()
  );
  assertion(values.isHostAccessible());
  assertion(values.getChunkSize() >= peano4::power(NodesPerAxis, DIMENSIONS) * ValuesPerNode, values.getChunkSize());
  assertion(nodePositions != nullptr);
  assertion(statuses == nullptr or (statuses->isHostAccessible() and subcellValues != nullptr));
  assertion(statuses == nullptr or subcellValues->isHostAccessible());
  assertion(
    statuses == nullptr or subcellValues->getChunkSize() >= peano4::power(SubcellsPerAxis, DIMENSIONS) * ValuesPerNode,
    subcellValues->getChunkSize()
  );

  const auto           subcellOfNode = containingSubcells<NodesPerAxis, SubcellsPerAxis>(nodePositions);
  const bool           hasStatus     = statuses != nullptr;
  const std::size_t    points        = static_cast<std::size_t>(cells.size) * PointsPerPatch;
  tarch::plotter::Mesh mesh          = createMesh(cells.size, CellsPerPatch, points, true, hasStatus ? statusName : nullptr);
  const std::size_t    statusField   = mesh.cellFields.size() - 1;
  const double         rank          = static_cast<double>(tarch::mpi::Rank::getInstance().getRank());
  tarch::accelerator::parallelForOnHost(tarch::accelerator::Range(cells.size), [&](const int patch) {
    const int              cell          = cells[patch];
    const std::size_t      firstCell     = static_cast<std::size_t>(patch) * CellsPerPatch;
    const std::size_t      firstPoint    = static_cast<std::size_t>(patch) * PointsPerPatch;
    const int              status        = hasStatus ? statuses->getChunk(cell)[0] : 0;
    const bool             plotsSubcells = hasStatus and status >= subcellStatus;
    const Precision* const states        = plotsSubcells ? subcellValues->getChunk(cell) : values.getChunk(cell);
    const auto             centre        = cellConnectivity.getCellCentre(cell);
    const auto             width         = cellConnectivity.getCellWidth(cell);
    peano4::dForEach(PointsPerAxis, [&](const tarch::la::Vector<DIMENSIONS, int>& pointIndex) {
      const int point = peano4::dLinearised(pointIndex, PointsPerAxis);
      const int node  = NodesPerAxis == 1 ? 0 : point;
      for (int axis = 0; axis < DIMENSIONS; axis++) {
        const double position =
          NodesPerAxis == 1 ? static_cast<double>(pointIndex(axis)) : nodePositions[pointIndex(axis)];
        mesh.pointsXYZ[(firstPoint + point) * 3 + axis] = centre(axis) - 0.5 * width(axis) + position * width(axis);
      }
      for (int axis = DIMENSIONS; axis < 3; axis++) {
        mesh.pointsXYZ[(firstPoint + point) * 3 + axis] = 0.0;
      }
      const int stateOfNode = plotsSubcells ? subcellOfNode[static_cast<std::size_t>(node)] : node;
      copyState(states + stateOfNode * ValuesPerNode, ValuesPerNode, firstPoint + point, mesh.pointFields);
    });
    connectPatch<PointsPerAxis>(
      [&](const int node) { return static_cast<std::int32_t>(firstPoint + node); },
      firstCell,
      mesh
    );
    std::fill_n(
      mesh.cellFields[RefinementLevelField].values.begin() + firstCell,
      CellsPerPatch,
      static_cast<double>(cellConnectivity.getCellLevel(cell))
    );
    std::fill_n(mesh.cellFields[SubdomainField].values.begin() + firstCell, CellsPerPatch, rank);
    std::fill_n(
      mesh.cellFields[CurveIndexField].values.begin() + firstCell,
      CellsPerPatch,
      static_cast<double>(cellConnectivity.getCellCurveIndex(cell))
    );
    if (hasStatus) {
      std::fill_n(mesh.cellFields[statusField].values.begin() + firstCell, CellsPerPatch, static_cast<double>(status));
    }
  });
  write(mesh, timeStamp, format, outputDirectory);
}

/**
 * Writes one snapshot in which ElementsPerAxis elements per axis tile every patch and every element
 * owns PointsPerAxis points per axis, equidistant from face to face or at the increasing positions
 * pointPositions within the unit interval. The call evaluate(cell, values)
 * writes the ValuesPerPoint values of every point of the patch of cell into values, ordered by
 * element, then by point within the element. The call status(cell, element) returns the status of
 * an element for the cell field statusName. A null status omits the status field.
 */
template <int ElementsPerAxis, int PointsPerAxis, int ValuesPerPoint, typename Evaluate, typename Status>
INLINE_METHOD void
exahype2::plotter::PatchPlotter::plotPatch(
  const peano4::CellConnectivity& cellConnectivity,
  const tarch::Span<const int>    cells,
  const Evaluate&                 evaluate,
  const double                    timeStamp,
  const tarch::plotter::Format    format,
  const std::string&              outputDirectory,
  const Status&                   status,
  const char* const               statusName,
  const double* const             pointPositions
) {
  static_assert(ElementsPerAxis > 0 and PointsPerAxis > 1 and ValuesPerPoint > 0);
  constexpr bool HasStatus         = not std::is_same_v<Status, std::nullptr_t>;
  constexpr int  ElementsPerPatch  = peano4::power(ElementsPerAxis, DIMENSIONS);
  constexpr int  PointsPerElement  = peano4::power(PointsPerAxis, DIMENSIONS);
  constexpr int  CellsPerElement   = peano4::power(PointsPerAxis - 1, DIMENSIONS);
  constexpr int  PointsPerPatch    = ElementsPerPatch * PointsPerElement;
  constexpr int  CellsPerPatch     = ElementsPerPatch * CellsPerElement;
  assertion(
    cells.size >= 0 and cells.size <= cellConnectivity.getNumberOfSlots(),
    cells.size,
    cellConnectivity.getNumberOfSlots()
  );

  const std::size_t    points      = static_cast<std::size_t>(cells.size) * PointsPerPatch;
  tarch::plotter::Mesh mesh        = createMesh(cells.size, CellsPerPatch, points, true, HasStatus ? statusName : nullptr);
  const std::size_t    statusField = mesh.cellFields.size() - 1;
  const double         rank        = static_cast<double>(tarch::mpi::Rank::getInstance().getRank());
  tarch::accelerator::parallelForOnHost(tarch::accelerator::Range(cells.size), [&](const int patch) {
    const int           cell       = cells[patch];
    const std::size_t   firstCell  = static_cast<std::size_t>(patch) * CellsPerPatch;
    const std::size_t   firstPoint = static_cast<std::size_t>(patch) * PointsPerPatch;
    const auto          centre     = cellConnectivity.getCellCentre(cell);
    const auto          width      = cellConnectivity.getCellWidth(cell);
    std::vector<double> values(static_cast<std::size_t>(PointsPerPatch) * ValuesPerPoint);
    evaluate(cell, values.data());
    peano4::dForEach(ElementsPerAxis, [&](const tarch::la::Vector<DIMENSIONS, int>& elementIndex) {
      const int         element           = peano4::dLinearised(elementIndex, ElementsPerAxis);
      const std::size_t firstElementPoint = firstPoint + static_cast<std::size_t>(element) * PointsPerElement;
      const std::size_t firstElementCell  = firstCell + static_cast<std::size_t>(element) * CellsPerElement;
      peano4::dForEach(PointsPerAxis, [&](const tarch::la::Vector<DIMENSIONS, int>& pointIndex) {
        const int         point     = peano4::dLinearised(pointIndex, PointsPerAxis);
        const std::size_t meshPoint = firstElementPoint + static_cast<std::size_t>(point);
        for (int axis = 0; axis < DIMENSIONS; axis++) {
          const double position = pointPositions == nullptr
                                  ? static_cast<double>(pointIndex(axis)) / (PointsPerAxis - 1)
                                  : pointPositions[pointIndex(axis)];
          const double fraction = (elementIndex(axis) + position) / ElementsPerAxis;
          mesh.pointsXYZ[meshPoint * 3 + axis] = centre(axis) - 0.5 * width(axis) + fraction * width(axis);
        }
        for (int axis = DIMENSIONS; axis < 3; axis++) {
          mesh.pointsXYZ[meshPoint * 3 + axis] = 0.0;
        }
        copyState(
          values.data() + (static_cast<std::size_t>(element) * PointsPerElement + point) * ValuesPerPoint,
          ValuesPerPoint,
          meshPoint,
          mesh.pointFields
        );
      });
      connectPatch<PointsPerAxis>(
        [&](const int point) { return static_cast<std::int32_t>(firstElementPoint + point); },
        firstElementCell,
        mesh
      );
      if constexpr (HasStatus) {
        std::fill_n(
          mesh.cellFields[statusField].values.begin() + firstElementCell,
          CellsPerElement,
          static_cast<double>(status(cell, element))
        );
      }
    });
    std::fill_n(
      mesh.cellFields[RefinementLevelField].values.begin() + firstCell,
      CellsPerPatch,
      static_cast<double>(cellConnectivity.getCellLevel(cell))
    );
    std::fill_n(mesh.cellFields[SubdomainField].values.begin() + firstCell, CellsPerPatch, rank);
    std::fill_n(
      mesh.cellFields[CurveIndexField].values.begin() + firstCell,
      CellsPerPatch,
      static_cast<double>(cellConnectivity.getCellCurveIndex(cell))
    );
  });
  write(mesh, timeStamp, format, outputDirectory);
}

/**
 * Returns the matrix whose entry [point][node] is the product over the axes of the entries
 * [point][node] of matrix1D along each axis, with points and nodes in linearised order.
 */
template <int PointsPerAxis, int NodesPerAxis>
INLINE_METHOD std::vector<double>
exahype2::plotter::PatchPlotter::getTensorProductMatrix(const double* const matrix1D) {
  constexpr int PointsPerPatch = peano4::power(PointsPerAxis, DIMENSIONS);
  constexpr int NodesPerPatch  = peano4::power(NodesPerAxis, DIMENSIONS);
  assertion(matrix1D != nullptr);
  std::vector<double> result(static_cast<std::size_t>(PointsPerPatch) * NodesPerPatch);
  peano4::dForEach(PointsPerAxis, [&](const tarch::la::Vector<DIMENSIONS, int>& pointIndex) {
    const int point = peano4::dLinearised(pointIndex, PointsPerAxis);
    peano4::dForEach(NodesPerAxis, [&](const tarch::la::Vector<DIMENSIONS, int>& nodeIndex) {
      double entry = 1.0;
      for (int axis = 0; axis < DIMENSIONS; axis++) {
        entry *= matrix1D[pointIndex(axis) * NodesPerAxis + nodeIndex(axis)];
      }
      result[static_cast<std::size_t>(point) * NodesPerPatch + peano4::dLinearised(nodeIndex, NodesPerAxis)] = entry;
    });
  });
  return result;
}

/**
 * Writes the Values values at every point of the nodal field nodalValues into pointValues with the
 * matrix of getTensorProductMatrix().
 */
template <int PointsPerAxis, int NodesPerAxis, int Values, typename Precision>
INLINE_METHOD void
exahype2::plotter::PatchPlotter::evaluateNodes(
  const std::vector<double>& tensorProductMatrix,
  const Precision* const     nodalValues,
  double* const              pointValues
) {
  constexpr int PointsPerPatch = peano4::power(PointsPerAxis, DIMENSIONS);
  constexpr int NodesPerPatch  = peano4::power(NodesPerAxis, DIMENSIONS);
  assertion(tensorProductMatrix.size() == static_cast<std::size_t>(PointsPerPatch) * NodesPerPatch);
  for (int point = 0; point < PointsPerPatch; point++) {
    const double* const weights = tensorProductMatrix.data() + static_cast<std::size_t>(point) * NodesPerPatch;
    double* const       result  = pointValues + static_cast<std::ptrdiff_t>(point) * Values;
    std::fill_n(result, Values, 0.0);
    for (int node = 0; node < NodesPerPatch; node++) {
      for (int value = 0; value < Values; value++) {
        result[value] += weights[node] * static_cast<double>(nodalValues[node * Values + value]);
      }
    }
  }
}

/**
 * Returns for every node of a patch the linearised index of the subcell that contains the node.
 * SubcellsPerAxis subcells per axis tile the patch. A node on the boundary between two subcells
 * belongs to the upper one.
 */
template <int NodesPerAxis, int SubcellsPerAxis>
INLINE_METHOD std::array<int, peano4::power(NodesPerAxis, DIMENSIONS)>
exahype2::plotter::PatchPlotter::containingSubcells(const double* const nodePositions) {
  static_assert(NodesPerAxis > 0 and SubcellsPerAxis > 0);
  constexpr int NodesPerPatch = peano4::power(NodesPerAxis, DIMENSIONS);
  assertion(nodePositions != nullptr);
  std::array<int, NodesPerPatch> result{};
  peano4::dForEach(NodesPerAxis, [&](const tarch::la::Vector<DIMENSIONS, int>& nodeIndex) {
    const int                          node = peano4::dLinearised(nodeIndex, NodesPerAxis);
    tarch::la::Vector<DIMENSIONS, int> subcell;
    for (int axis = 0; axis < DIMENSIONS; axis++) {
      const double position = nodePositions[nodeIndex(axis)];
      assertion(position >= 0.0 and position <= 1.0, node, axis, position);
      subcell(axis) = std::clamp(static_cast<int>(position * SubcellsPerAxis), 0, SubcellsPerAxis - 1);
    }
    result[static_cast<std::size_t>(node)] = peano4::dLinearised(subcell, SubcellsPerAxis);
  });
  return result;
}

/**
 * Numbers the distinct volume corners on the faces of the patches in the order of their first
 * appearance in cells. Corners with the same integer lattice coordinates on the finest level are one
 * point.
 */
template <int VolumesPerAxis>
INLINE_METHOD exahype2::plotter::PatchPlotter::FaceCornerPoints
exahype2::plotter::PatchPlotter::numberFaceCorners(
  const peano4::CellConnectivity& cellConnectivity,
  const tarch::Span<const int>    cells,
  const std::vector<PatchCorner>& corners
) {
  constexpr int          CornersPerAxis      = VolumesPerAxis + 1;
  constexpr int          CornersPerPatch     = peano4::power(CornersPerAxis, DIMENSIONS);
  constexpr int          FaceCornersPerPatch = CornersPerPatch - peano4::power(VolumesPerAxis - 1, DIMENSIONS);
  constexpr std::int32_t EmptySlot           = std::numeric_limits<std::int32_t>::max();
  constexpr std::size_t  SlotsPerTask        = std::size_t{1} << 16;
  assertion(corners.size() == static_cast<std::size_t>(CornersPerPatch), corners.size());
  assertion(static_cast<std::int64_t>(cells.size) * FaceCornersPerPatch < EmptySlot, cells.size);

  std::array<int, FaceCornersPerPatch> cornerOfFaceCorner{};
  for (int corner = 0; corner < CornersPerPatch; corner++) {
    const PatchCorner& patchCorner = corners[static_cast<std::size_t>(corner)];
    if (patchCorner.onFace) {
      assertion(patchCorner.index >= 0 and patchCorner.index < FaceCornersPerPatch, corner, patchCorner.index);
      cornerOfFaceCorner[static_cast<std::size_t>(patchCorner.index)] = corner;
    }
  }

  const auto getLatticeKey = [&](const std::int32_t faceCorner) {
    const int  patch       = faceCorner / FaceCornersPerPatch;
    const int  cell        = cells[patch];
    const auto cornerIndex = peano4::dDelinearised(
      cornerOfFaceCorner[static_cast<std::size_t>(faceCorner % FaceCornersPerPatch)],
      CornersPerAxis
    );
    const auto   lattice = cellConnectivity.getCellLattice(cell);
    std::int64_t spacing = 1;
    for (int level = cellConnectivity.getCellLevel(cell); level < cellConnectivity.getMaximumLevel(); level++) {
      spacing *= peano4::SubdivisionFactor;
    }
    std::array<std::int64_t, DIMENSIONS> key{};
    for (int axis = 0; axis < DIMENSIONS; axis++) {
      key[static_cast<std::size_t>(axis)] =
        (static_cast<std::int64_t>(lattice(axis)) * VolumesPerAxis + cornerIndex(axis)) * spacing;
    }
    return key;
  };

  const std::size_t numberOfFaceCorners = static_cast<std::size_t>(cells.size) * FaceCornersPerPatch;
  const std::size_t numberOfSlots       = std::bit_ceil(std::max<std::size_t>(2 * numberOfFaceCorners, 1));
  const std::size_t slotMask            = numberOfSlots - 1;
  const std::size_t numberOfSlotTasks   = (numberOfSlots + SlotsPerTask - 1) / SlotsPerTask;
  tarch::plotter::MeshArray<std::int32_t> ownerOfSlot(numberOfSlots);
  tarch::plotter::MeshArray<std::size_t>  slotOfFaceCorner(numberOfFaceCorners);
  tarch::accelerator::parallelForOnHost(
    tarch::accelerator::Range(static_cast<int>(numberOfSlotTasks)),
    [&](const int task) {
      const std::size_t firstSlot = static_cast<std::size_t>(task) * SlotsPerTask;
      std::fill(
        ownerOfSlot.begin() + firstSlot,
        ownerOfSlot.begin() + std::min(firstSlot + SlotsPerTask, numberOfSlots),
        EmptySlot
      );
    }
  );

  // A slot stores the smallest face corner of one lattice key.
  tarch::accelerator::parallelForOnHost(tarch::accelerator::Range(cells.size), [&](const int patch) {
    for (int faceIndex = 0; faceIndex < FaceCornersPerPatch; faceIndex++) {
      const std::int32_t faceCorner = patch * FaceCornersPerPatch + faceIndex;
      const auto         key        = getLatticeKey(faceCorner);
      std::size_t        slot       = hashLatticeKey(key) & slotMask;
      while (true) {
        std::atomic_ref<std::int32_t> owner(ownerOfSlot[slot]);
        std::int32_t                  currentOwner = EmptySlot;
        if (owner.compare_exchange_strong(currentOwner, faceCorner, std::memory_order_relaxed)) {
          break;
        }
        if (getLatticeKey(currentOwner) == key) {
          while (faceCorner < currentOwner
                 and not owner.compare_exchange_weak(currentOwner, faceCorner, std::memory_order_relaxed)) {
          }
          break;
        }
        slot = (slot + 1) & slotMask;
      }
      slotOfFaceCorner[static_cast<std::size_t>(faceCorner)] = slot;
    }
  });

  FaceCornerPoints result;
  result.firstPointOfPatch.assign(static_cast<std::size_t>(cells.size) + 1, 0);
  tarch::accelerator::parallelForOnHost(tarch::accelerator::Range(cells.size), [&](const int patch) {
    std::int32_t ownedPoints = 0;
    for (int faceIndex = 0; faceIndex < FaceCornersPerPatch; faceIndex++) {
      const std::int32_t faceCorner = patch * FaceCornersPerPatch + faceIndex;
      if (ownerOfSlot[slotOfFaceCorner[static_cast<std::size_t>(faceCorner)]] == faceCorner) {
        ownedPoints++;
      }
    }
    result.firstPointOfPatch[static_cast<std::size_t>(patch) + 1] = ownedPoints;
  });
  std::partial_sum(result.firstPointOfPatch.begin(), result.firstPointOfPatch.end(), result.firstPointOfPatch.begin());

  result.pointOfFaceCorner.resize(numberOfFaceCorners);
  tarch::accelerator::parallelForOnHost(tarch::accelerator::Range(cells.size), [&](const int patch) {
    std::int32_t point = result.firstPointOfPatch[static_cast<std::size_t>(patch)];
    for (int faceIndex = 0; faceIndex < FaceCornersPerPatch; faceIndex++) {
      const std::int32_t faceCorner = patch * FaceCornersPerPatch + faceIndex;
      if (ownerOfSlot[slotOfFaceCorner[static_cast<std::size_t>(faceCorner)]] == faceCorner) {
        result.pointOfFaceCorner[static_cast<std::size_t>(faceCorner)] = point;
        point++;
      }
    }
    assertion(point == result.firstPointOfPatch[static_cast<std::size_t>(patch) + 1], patch, point);
  });
  tarch::accelerator::parallelForOnHost(tarch::accelerator::Range(cells.size), [&](const int patch) {
    for (int faceIndex = 0; faceIndex < FaceCornersPerPatch; faceIndex++) {
      const std::int32_t faceCorner = patch * FaceCornersPerPatch + faceIndex;
      const std::int32_t owner      = ownerOfSlot[slotOfFaceCorner[static_cast<std::size_t>(faceCorner)]];
      if (owner != faceCorner) {
        assertion(owner < faceCorner, owner, faceCorner);
        result.pointOfFaceCorner[static_cast<std::size_t>(faceCorner)] =
          result.pointOfFaceCorner[static_cast<std::size_t>(owner)];
      }
    }
  });
  return result;
}

/**
 * Writes the corners, the end offsets and the types of the cells of mesh between neighbouring
 * points of a patch with PointsPerAxis points per axis from firstCell on. The functor pointOfCorner
 * maps a point of the patch in linearised order onto its point in mesh.
 */
template <int PointsPerAxis, typename PointOfCorner>
INLINE_METHOD void
exahype2::plotter::PatchPlotter::connectPatch(
  const PointOfCorner&  pointOfCorner,
  const std::size_t     firstCell,
  tarch::plotter::Mesh& mesh
) {
  static_assert(PointsPerAxis > 1);
  constexpr int  CellsPerAxis   = PointsPerAxis - 1;
  constexpr int  CornersPerCell = peano4::VerticesPerCell;
  constexpr auto CellType =
    DIMENSIONS == 2 ? tarch::plotter::CellType::Quadrangle : tarch::plotter::CellType::Hexahedron;
  assertion(firstCell + peano4::power(CellsPerAxis, DIMENSIONS) <= mesh.types.size(), firstCell, mesh.types.size());
  peano4::dForEach(CellsPerAxis, [&](const tarch::la::Vector<DIMENSIONS, int>& cellIndex) {
    const int cell = peano4::dLinearised(cellIndex, CellsPerAxis);
    for (int corner = 0; corner < CornersPerCell; corner++) {
      tarch::la::Vector<DIMENSIONS, int> pointIndex;
      for (int axis = 0; axis < DIMENSIONS; axis++) {
        pointIndex(axis) = cellIndex(axis) + CellCorners[corner][axis];
      }
      const int point                                                 = peano4::dLinearised(pointIndex, PointsPerAxis);
      mesh.connectivity[(firstCell + cell) * CornersPerCell + corner] = pointOfCorner(point);
    }
    mesh.offsets[firstCell + cell] = static_cast<std::int32_t>((firstCell + cell + 1) * CornersPerCell);
    mesh.types[firstCell + cell]   = static_cast<std::uint8_t>(CellType);
  });
}

/**
 * Copies the data fields of one state with valuesPerState values into entity of fields. The vector
 * fields lists the data fields first and in their order.
 */
template <typename Precision>
INLINE_METHOD void
exahype2::plotter::PatchPlotter::copyState(
  const Precision* const                    state,
  const int                                 valuesPerState,
  const std::size_t                         entity,
  std::vector<tarch::plotter::Mesh::Field>& fields
) const {
  assertion(state != nullptr);
  assertion(fields.size() >= _fields.size(), fields.size(), _fields.size());
  int firstComponent = 0;
  for (std::size_t field = 0; field < _fields.size(); field++) {
    const int components = _fields[field].components;
    for (int component = 0; component < components; component++) {
      fields[field].values[entity * components + component] = static_cast<double>(state[firstComponent + component]);
    }
    firstComponent += components;
  }
  assertion(firstComponent <= valuesPerState, firstComponent, valuesPerState);
}
