TARGET_DECLARE
/**
 * Overwrites face states with the cell polynomial's boundary values.
 * Face buffers hold lower faces before upper faces, with the lowest tangential axis running fastest.
 */
template <
  int NumberOfDofsPerAxis,
  int NumberOfUnknowns,
  int NumberOfAuxiliaryVariables,
  typename StoragePrecision,
  typename ComputePrecision>
INLINE_METHOD GPU_CALLABLE_METHOD void exahype2::dg::extrapolateStateToFaces(
  StoragePrecision* const NOALIAS       faceState[peano4::FacesPerCell],
  const StoragePrecision* NOALIAS const cellState,
  const ComputePrecision* NOALIAS const leftFaceCoefficients,
  const ComputePrecision* NOALIAS const rightFaceCoefficients
) {
  constexpr int NumberOfData     = NumberOfUnknowns + NumberOfAuxiliaryVariables;
  constexpr int NodesPerAxisIn3D = (DIMENSIONS == 3) ? NumberOfDofsPerAxis : 1;
  constexpr int NodesPerFace     = NumberOfDofsPerAxis * NodesPerAxisIn3D;

  using AccumulatePrecision = std::common_type_t<StoragePrecision, ComputePrecision>;

  UNROLL(DIMENSIONS)
  for (int direction = 0; direction < DIMENSIONS; direction++) {
    int lowerAxesStride = 1;
    for (int axis = 0; axis < direction; axis++) {
      lowerAxesStride *= NumberOfDofsPerAxis;
    }

    for (int faceNode = 0; faceNode < NodesPerFace; faceNode++) {
      const int lowerAxesIndex  = faceNode % lowerAxesStride;
      const int higherAxesIndex = faceNode / lowerAxesStride;

      AccumulatePrecision leftState[NumberOfData]  = {};
      AccumulatePrecision rightState[NumberOfData] = {};

      for (int normalIndex = 0; normalIndex < NumberOfDofsPerAxis; normalIndex++) {
        const int cellNode = (higherAxesIndex * NumberOfDofsPerAxis + normalIndex) * lowerAxesStride + lowerAxesIndex;
        SIMD()
        for (int value = 0; value < NumberOfData; value++) {
          const auto nodeValue = static_cast<AccumulatePrecision>(cellState[value + NumberOfData * cellNode]);
          leftState[value] += nodeValue * static_cast<AccumulatePrecision>(leftFaceCoefficients[normalIndex]);
          rightState[value] += nodeValue * static_cast<AccumulatePrecision>(rightFaceCoefficients[normalIndex]);
        }
      }

      SIMD()
      for (int value = 0; value < NumberOfData; value++) {
        faceState[direction][value + NumberOfData * faceNode] = static_cast<StoragePrecision>(leftState[value]);
        faceState[direction + DIMENSIONS][value + NumberOfData * faceNode] =
          static_cast<StoragePrecision>(rightState[value]);
      }
    }
  }
}

/**
 * Extrapolates nodal fluxes onto cell faces, or writes zeros when flux evaluation is disabled.
 * Diffusive fluxes read the cell polynomial's gradient along every axis.
 */
template <
  typename Solver,
  int  NumberOfDofsPerAxis,
  int  NumberOfUnknowns,
  int  NumberOfAuxiliaryVariables,
  bool EvaluateFlux,
  bool EvaluateDiffusiveFlux,
  typename StoragePrecision,
  typename ComputePrecision>
INLINE_METHOD GPU_CALLABLE_METHOD void exahype2::dg::extrapolateFluxToFaces(
  StoragePrecision* const NOALIAS              faceFlux[peano4::FacesPerCell],
  const StoragePrecision* NOALIAS const        cellState,
  const ComputePrecision* NOALIAS const        leftFaceCoefficients,
  const ComputePrecision* NOALIAS const        rightFaceCoefficients,
  const ComputePrecision* NOALIAS const        quadratureNodes,
  const ComputePrecision* NOALIAS const        derivativeOperator,
  const tarch::la::Vector<DIMENSIONS, double>& cellCentre,
  const tarch::la::Vector<DIMENSIONS, double>& cellSize,
  const double                                 timeStamp,
  const double                                 timeStepSize
) {
  static_assert(EvaluateFlux or not EvaluateDiffusiveFlux, "A diffusive flux is a flux.");

  constexpr int NumberOfData           = NumberOfUnknowns + NumberOfAuxiliaryVariables;
  constexpr int NodesPerAxisIn3D       = (DIMENSIONS == 3) ? NumberOfDofsPerAxis : 1;
  constexpr int NodesPerFace           = NumberOfDofsPerAxis * NodesPerAxisIn3D;
  constexpr int NodesPerCell           = NodesPerFace * NumberOfDofsPerAxis;
  constexpr int AxisStride             = NumberOfUnknowns * NodesPerCell;
  constexpr int GradientEntriesPerAxis = NodesPerCell * NumberOfData;

  using AccumulatePrecision = std::common_type_t<StoragePrecision, ComputePrecision>;

  if constexpr (EvaluateFlux) {
    [[maybe_unused]] ComputePrecision nodalGradients[EvaluateDiffusiveFlux ? DIMENSIONS * GradientEntriesPerAxis : 1];
    if constexpr (EvaluateDiffusiveFlux) {
      exahype2::dg::computeNodalGradients<
        NumberOfDofsPerAxis,
        NumberOfUnknowns,
        NumberOfAuxiliaryVariables,
        StoragePrecision,
        ComputePrecision>(nodalGradients, cellState, derivativeOperator, cellSize);
    }

    ComputePrecision cellFlux[DIMENSIONS * AxisStride];
    for (int cellNode = 0; cellNode < NodesPerCell; cellNode++) {
      tarch::la::Vector<DIMENSIONS, int> nodeIndex;
      int                                remainder = cellNode;
      for (int axis = 0; axis < DIMENSIONS; axis++) {
        nodeIndex(axis) = remainder % NumberOfDofsPerAxis;
        remainder /= NumberOfDofsPerAxis;
      }

      const ComputePrecision* NOALIAS   nodeState = nullptr;
      [[maybe_unused]] ComputePrecision nodeStateBuffer[NumberOfData];
      if constexpr (std::is_same_v<StoragePrecision, ComputePrecision>) {
        nodeState = cellState + cellNode * NumberOfData;
      } else {
        for (int value = 0; value < NumberOfData; value++) {
          nodeStateBuffer[value] = static_cast<ComputePrecision>(cellState[cellNode * NumberOfData + value]);
        }
        nodeState = nodeStateBuffer;
      }

      [[maybe_unused]] const ComputePrecision* NOALIAS nodeGradients[DIMENSIONS];
      if constexpr (EvaluateDiffusiveFlux) {
        for (int axis = 0; axis < DIMENSIONS; axis++) {
          nodeGradients[axis] = nodalGradients + axis * GradientEntriesPerAxis + cellNode * NumberOfData;
        }
      }

      UNROLL(DIMENSIONS)
      for (int direction = 0; direction < DIMENSIONS; direction++) {
        ComputePrecision flux[NumberOfUnknowns] = {};
        if constexpr (EvaluateDiffusiveFlux) {
          Solver::flux(
            nodeState,
            nodeGradients,
            exahype2::dg::getQuadraturePoint(cellCentre, cellSize, nodeIndex, quadratureNodes),
            cellSize,
            timeStamp,
            timeStepSize,
            direction,
            flux
          );
        } else {
          Solver::flux(
            nodeState,
            exahype2::dg::getQuadraturePoint(cellCentre, cellSize, nodeIndex, quadratureNodes),
            cellSize,
            timeStamp,
            timeStepSize,
            direction,
            flux
          );
        }
        SIMD()
        for (int unknown = 0; unknown < NumberOfUnknowns; unknown++) {
          cellFlux[direction * AxisStride + cellNode * NumberOfUnknowns + unknown] = flux[unknown];
        }
      }
    }

    UNROLL(DIMENSIONS)
    for (int direction = 0; direction < DIMENSIONS; direction++) {
      int lowerAxesStride = 1;
      for (int axis = 0; axis < direction; axis++) {
        lowerAxesStride *= NumberOfDofsPerAxis;
      }

      for (int faceNode = 0; faceNode < NodesPerFace; faceNode++) {
        const int lowerAxesIndex  = faceNode % lowerAxesStride;
        const int higherAxesIndex = faceNode / lowerAxesStride;

        AccumulatePrecision leftFlux[NumberOfUnknowns]  = {};
        AccumulatePrecision rightFlux[NumberOfUnknowns] = {};

        for (int normalIndex = 0; normalIndex < NumberOfDofsPerAxis; normalIndex++) {
          const int cellNode = (higherAxesIndex * NumberOfDofsPerAxis + normalIndex) * lowerAxesStride + lowerAxesIndex;
          const int entry    = NumberOfUnknowns * cellNode + direction * AxisStride;
          SIMD()
          for (int unknown = 0; unknown < NumberOfUnknowns; unknown++) {
            const auto nodeFlux = static_cast<AccumulatePrecision>(cellFlux[unknown + entry]);
            leftFlux[unknown] += nodeFlux * static_cast<AccumulatePrecision>(leftFaceCoefficients[normalIndex]);
            rightFlux[unknown] += nodeFlux * static_cast<AccumulatePrecision>(rightFaceCoefficients[normalIndex]);
          }
        }

        SIMD()
        for (int unknown = 0; unknown < NumberOfUnknowns; unknown++) {
          faceFlux[direction][unknown + NumberOfUnknowns * faceNode] = static_cast<StoragePrecision>(leftFlux[unknown]);
          faceFlux[direction + DIMENSIONS][unknown + NumberOfUnknowns * faceNode] =
            static_cast<StoragePrecision>(rightFlux[unknown]);
        }
      }
    }
  } else {
    for (int face = 0; face < peano4::FacesPerCell; face++) {
      for (int entry = 0; entry < NodesPerFace * NumberOfUnknowns; entry++) {
        faceFlux[face][entry] = static_cast<StoragePrecision>(0);
      }
    }
  }
}

/**
 * Evaluates one side's flux from face traces ordered along the normal axis.
 * Diffusive fluxes use the trace jump divided by the cell extent as the normal derivative.
 * Tangential derivatives are zero.
 */
template <
  typename Solver,
  int  NumberOfDofsPerAxis,
  int  NumberOfUnknowns,
  int  NumberOfAuxiliaryVariables,
  bool EvaluateFlux,
  bool EvaluateDiffusiveFlux,
  typename StoragePrecision,
  typename ComputePrecision>
INLINE_METHOD GPU_CALLABLE_METHOD void exahype2::dg::evaluateFluxOnFace(
  StoragePrecision* NOALIAS const              faceFlux,
  const StoragePrecision* NOALIAS const        leftState,
  const StoragePrecision* NOALIAS const        rightState,
  const int                                    side,
  const ComputePrecision* NOALIAS const        quadratureNodes,
  const tarch::la::Vector<DIMENSIONS, double>& faceCentre,
  const tarch::la::Vector<DIMENSIONS, double>& cellSize,
  const double                                 timeStamp,
  const double                                 timeStepSize,
  const int                                    direction
) {
  static_assert(EvaluateFlux or not EvaluateDiffusiveFlux, "A diffusive flux is a flux.");

  constexpr int NumberOfData = NumberOfUnknowns + NumberOfAuxiliaryVariables;
  constexpr int NodesPerFace = (DIMENSIONS == 3) ? NumberOfDofsPerAxis * NumberOfDofsPerAxis : NumberOfDofsPerAxis;

  assertion(side == 0 or side == 1, side);
  assertion(direction >= 0 and direction < DIMENSIONS, direction);
  assertion(cellSize(direction) > 0.0, cellSize, direction);

  if constexpr (EvaluateFlux) {
    const StoragePrecision* NOALIAS const faceState  = side == 0 ? leftState : rightState;
    const auto                            faceOffset = faceCentre - 0.5 * cellSize;

    [[maybe_unused]] ComputePrecision                normalGradient[NumberOfData];
    [[maybe_unused]] const ComputePrecision          zeroGradient[NumberOfData] = {};
    [[maybe_unused]] const ComputePrecision* NOALIAS nodeGradients[DIMENSIONS];
    if constexpr (EvaluateDiffusiveFlux) {
      for (int axis = 0; axis < DIMENSIONS; axis++) {
        nodeGradients[axis] = zeroGradient;
      }
      nodeGradients[direction] = normalGradient;
    }

    const ComputePrecision* NOALIAS   nodeState = nullptr;
    [[maybe_unused]] ComputePrecision nodeStateBuffer[NumberOfData];

    for (int faceNode = 0; faceNode < NodesPerFace; faceNode++) {
      tarch::la::Vector<DIMENSIONS, int> nodeIndex(0);
      int                                remainder = faceNode;
      for (int axis = 0; axis < DIMENSIONS; axis++) {
        if (axis != direction) {
          nodeIndex(axis) = remainder % NumberOfDofsPerAxis;
          remainder /= NumberOfDofsPerAxis;
        }
      }

      tarch::la::Vector<DIMENSIONS, double> nodePosition;
      for (int axis = 0; axis < DIMENSIONS; axis++) {
        nodePosition(axis) = faceOffset(axis)
          + ((axis == direction) ? 0.5 : static_cast<double>(quadratureNodes[nodeIndex(axis)])) * cellSize(axis);
      }

      if constexpr (std::is_same_v<StoragePrecision, ComputePrecision>) {
        nodeState = faceState + faceNode * NumberOfData;
      } else {
        for (int value = 0; value < NumberOfData; value++) {
          nodeStateBuffer[value] = static_cast<ComputePrecision>(faceState[faceNode * NumberOfData + value]);
        }
        nodeState = nodeStateBuffer;
      }

      ComputePrecision flux[NumberOfUnknowns] = {};
      if constexpr (EvaluateDiffusiveFlux) {
        for (int value = 0; value < NumberOfData; value++) {
          normalGradient[value] = static_cast<ComputePrecision>(
            (rightState[faceNode * NumberOfData + value] - leftState[faceNode * NumberOfData + value])
            / cellSize(direction)
          );
        }
        Solver::flux(nodeState, nodeGradients, nodePosition, cellSize, timeStamp, timeStepSize, direction, flux);
      } else {
        Solver::flux(nodeState, nodePosition, cellSize, timeStamp, timeStepSize, direction, flux);
      }
      for (int unknown = 0; unknown < NumberOfUnknowns; unknown++) {
        faceFlux[faceNode * NumberOfUnknowns + unknown] = static_cast<StoragePrecision>(flux[unknown]);
      }
    }
  } else {
    for (int entry = 0; entry < NodesPerFace * NumberOfUnknowns; entry++) {
      faceFlux[entry] = static_cast<StoragePrecision>(0);
    }
  }
}
TARGET_DECLARE_END
