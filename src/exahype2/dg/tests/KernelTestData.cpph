#include "tarch/accelerator/MemoryLocation.h"
#include "tarch/accelerator/accelerator.h"

TARGET_DECLARE
INLINE_METHOD GPU_CALLABLE_METHOD void
exahype2::dg::tests::StubSolver::boundaryConditions(
  const double* NOALIAS const                                   insideState,
  double* NOALIAS const                                         outsideState,
  const tarch::la::Vector<DIMENSIONS, double>&                  position,
  [[maybe_unused]] const tarch::la::Vector<DIMENSIONS, double>& cellSize,
  const double                                                  timeStamp,
  const int                                                     direction
) {
  for (int value = 0; value < KernelTestSetup::NumberOfData; value++) {
    outsideState[value] = -insideState[value] + position(direction) + timeStamp;
  }
}

INLINE_METHOD GPU_CALLABLE_METHOD double
exahype2::dg::tests::StubSolver::maxEigenvalue(
  const double* NOALIAS const                                   state,
  const tarch::la::Vector<DIMENSIONS, double>&                  position,
  [[maybe_unused]] const tarch::la::Vector<DIMENSIONS, double>& cellSize,
  [[maybe_unused]] const double                                 timeStamp,
  [[maybe_unused]] const double                                 timeStepSize,
  const int                                                     direction
) {
  return 0.5 + std::fabs(state[0]) + 0.25 * direction + 0.125 * position(0);
}

INLINE_METHOD GPU_CALLABLE_METHOD void
exahype2::dg::tests::StubSolver::flux(
  const double* NOALIAS const                                   state,
  const tarch::la::Vector<DIMENSIONS, double>&                  position,
  [[maybe_unused]] const tarch::la::Vector<DIMENSIONS, double>& cellSize,
  [[maybe_unused]] const double                                 timeStamp,
  [[maybe_unused]] const double                                 timeStepSize,
  const int                                                     direction,
  double* NOALIAS const                                         values
) {
  for (int unknown = 0; unknown < KernelTestSetup::NumberOfUnknowns; unknown++) {
    values[unknown] = state[unknown] * (1.0 + direction) + position(0);
  }
}

INLINE_METHOD GPU_CALLABLE_METHOD void
exahype2::dg::tests::StubSolver::flux(
  const double* NOALIAS const                                   state,
  const double* const NOALIAS                                   stateGradients[DIMENSIONS],
  const tarch::la::Vector<DIMENSIONS, double>&                  position,
  [[maybe_unused]] const tarch::la::Vector<DIMENSIONS, double>& cellSize,
  [[maybe_unused]] const double                                 timeStamp,
  [[maybe_unused]] const double                                 timeStepSize,
  const int                                                     direction,
  double* NOALIAS const                                         values
) {
  for (int unknown = 0; unknown < KernelTestSetup::NumberOfUnknowns; unknown++) {
    values[unknown] = state[unknown] * (1.0 + direction) + position(0);
    for (int axis = 0; axis < DIMENSIONS; axis++) {
      values[unknown] += (0.5 + axis) * stateGradients[axis][unknown];
    }
  }
}

INLINE_METHOD GPU_CALLABLE_METHOD void
exahype2::dg::tests::StubSolver::sourceTerm(
  const double* NOALIAS const                                   state,
  const tarch::la::Vector<DIMENSIONS, double>&                  position,
  [[maybe_unused]] const tarch::la::Vector<DIMENSIONS, double>& cellSize,
  [[maybe_unused]] const double                                 timeStamp,
  [[maybe_unused]] const double                                 timeStepSize,
  double* NOALIAS const                                         values
) {
  for (int unknown = 0; unknown < KernelTestSetup::NumberOfUnknowns; unknown++) {
    values[unknown] = 0.5 * state[unknown] - position(0);
  }
}

INLINE_METHOD GPU_CALLABLE_METHOD void
exahype2::dg::tests::StubSolver::nonconservativeProduct(
  const double* NOALIAS const                                   state,
  const double* NOALIAS const                                   stateGradient,
  const tarch::la::Vector<DIMENSIONS, double>&                  position,
  [[maybe_unused]] const tarch::la::Vector<DIMENSIONS, double>& cellSize,
  [[maybe_unused]] const double                                 timeStamp,
  [[maybe_unused]] const double                                 timeStepSize,
  const int                                                     direction,
  double* NOALIAS const                                         values
) {
  for (int unknown = 0; unknown < KernelTestSetup::NumberOfUnknowns; unknown++) {
    values[unknown] = stateGradient[unknown] * (1.0 + 0.5 * direction) + state[unknown] + position(0);
  }
}

INLINE_METHOD GPU_CALLABLE_METHOD void
exahype2::dg::tests::StubSolver::multiplyMaterialParameterMatrix(
  const double* NOALIAS const                                   state,
  [[maybe_unused]] const tarch::la::Vector<DIMENSIONS, double>& faceCentre,
  [[maybe_unused]] const tarch::la::Vector<DIMENSIONS, double>& cellSize,
  [[maybe_unused]] const double                                 timeStamp,
  [[maybe_unused]] const double                                 timeStepSize,
  [[maybe_unused]] const int                                    direction,
  double* NOALIAS const                                         values
) {
  for (int unknown = 0; unknown < KernelTestSetup::NumberOfUnknowns; unknown++) {
    values[unknown] *= 1.0 + 0.25 * state[0];
  }
}

/**
 * Returns the centre of the face faceNumber of cell.
 */
INLINE_METHOD GPU_CALLABLE_METHOD tarch::la::Vector<DIMENSIONS, double>
exahype2::dg::tests::getFaceCentreOf(
  const int     cell,
  const int     faceNumber,
  const double* cellCentres,
  const double* cellSizes
) {
  const int                                   firstCoordinate = cell * DIMENSIONS;
  tarch::la::Vector<DIMENSIONS, double>       faceCentre(cellCentres + firstCoordinate);
  const tarch::la::Vector<DIMENSIONS, double> cellSize(cellSizes + firstCoordinate);
  faceCentre(faceNumber % DIMENSIONS) += (faceNumber < DIMENSIONS ? -0.5 : 0.5) * cellSize(faceNumber % DIMENSIONS);
  return faceCentre;
}
TARGET_DECLARE_END

template <typename T>
INLINE_METHOD exahype2::dg::tests::DeviceBuffer<T>::DeviceBuffer(const std::vector<T>& hostData) :
  _count(hostData.size()),
  _data(tarch::allocateMemory<T>(_count, tarch::MemoryLocation::Device)) {
  tarch::copyTo(_data.get(), hostData.data(), _count, tarch::MemoryLocation::Device);
}

template <typename T>
INLINE_METHOD T*
exahype2::dg::tests::DeviceBuffer<T>::getData() const {
  return _data.get();
}

template <typename T>
INLINE_METHOD void
exahype2::dg::tests::DeviceBuffer<T>::copyBack(std::vector<T>& target) const {
  tarch::copyFrom(_data.get(), target.data(), _count, tarch::MemoryLocation::Device);
}
