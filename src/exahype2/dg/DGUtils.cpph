/**
 * Evaluates one component of the nodal DG polynomial inside a cell.
 *
 * Q uses an array-of-structures layout with unknownsPerDoF consecutive values
 * per tensor-product node. quadratureNodes1D contains order+1 reference
 * coordinates on [0, 1].
 */
template <typename QStoreType>
QStoreType exahype2::dg::evaluatePolynomial(
  const peano4::dataview::CellMarker&          marker,
  const int                                    order,
  const QStoreType* NOALIAS const              quadratureNodes1D,
  const int                                    unknownsPerDoF,
  const QStoreType* NOALIAS const              Q,
  const tarch::la::Vector<DIMENSIONS, double>& x,
  const int                                    unknown
) {
  assertion(order >= 0, order);
  assertion(unknown >= 0 and unknown < unknownsPerDoF, unknown, unknownsPerDoF);

  QStoreType interpolatedValue = 0.0;
  peano4::dForEach(order + 1, [&](const tarch::la::Vector<DIMENSIONS, int>& currentDoF) {
    double denominator = 1.0;
    double numerator   = 1.0;
    for (int axis = 0; axis < DIMENSIONS; axis++) {
      for (int quadratureNode = 0; quadratureNode < order + 1; quadratureNode++) {
        if (quadratureNode != currentDoF(axis)) {
          const double referenceNodeDistance = quadratureNodes1D[currentDoF(axis)] - quadratureNodes1D[quadratureNode];
          const double distanceToQuadraturePoint =
            x(axis) - (quadratureNodes1D[quadratureNode] * marker.getH()(axis) + marker.getOffset()(axis));
          denominator *= referenceNodeDistance * marker.getH()(axis);
          numerator *= distanceToQuadraturePoint;
        }
      }
    }

    assertion(denominator != 0.0, denominator);

    const int linearisedDoF = peano4::dLinearised(currentDoF, order + 1);
    interpolatedValue += numerator / denominator * Q[linearisedDoF * unknownsPerDoF + unknown];
  });
  return interpolatedValue;
}

/**
 * Evaluates one component of the nodal DG polynomial on a face.
 *
 * Q contains (order+1)^(DIMENSIONS-1) array-of-structures entries. The tensor-product
 * interpolation skips the axis of the face normal.
 */
template <typename QStoreType>
QStoreType exahype2::dg::evaluatePolynomial(
  const peano4::dataview::FaceMarker&          marker,
  const int                                    order,
  const QStoreType* NOALIAS const              quadratureNodes1D,
  const int                                    unknownsPerDoF,
  const QStoreType* NOALIAS const              Q,
  const tarch::la::Vector<DIMENSIONS, double>& x,
  const int                                    unknown
) {
  assertion(order >= 0, order);
  assertion(unknown >= 0 and unknown < unknownsPerDoF, unknown, unknownsPerDoF);

  const int normal = marker.getSelectedFaceNumber() % DIMENSIONS;

  const tarch::la::Vector<DIMENSIONS, double> referencePosition = {
    (x[0] - marker.getX()[0]) / (marker.getH()[0]) + 0.5,
    (x[1] - marker.getX()[1]) / (marker.getH()[1]) + 0.5,
#if DIMENSIONS == 3
    (x[2] - marker.getX()[2]) / (marker.getH()[2]) + 0.5,
#endif
  };

  int linearisedDoF = 0;

  QStoreType interpolatedValue = 0.0;
  peano4::dForEachExclusive(order + 1, normal, 0, [&](const tarch::la::Vector<DIMENSIONS, int>& currentDoF) {
    double denominator = 1.0;
    double numerator   = 1.0;
    for (int axis = 0; axis < DIMENSIONS; axis++) {
      if (axis == normal) {
        continue;
      }

      for (int quadratureNode = 0; quadratureNode < order + 1; quadratureNode++) {
        if (quadratureNode != currentDoF(axis)) {
          const double referenceNodeDistance = quadratureNodes1D[currentDoF(axis)] - quadratureNodes1D[quadratureNode];
          const double distanceToQuadraturePoint = referencePosition(axis) - quadratureNodes1D[quadratureNode];
          denominator *= referenceNodeDistance;
          numerator *= distanceToQuadraturePoint;
        }
      }
    }

    assertion(denominator != 0.0, denominator);

    interpolatedValue += numerator / denominator * Q[linearisedDoF + unknown];
    linearisedDoF += unknownsPerDoF;
  });
  return interpolatedValue;
}

/**
 * Maps a tensor-product reference node from [0, 1]^DIMENSIONS into a cell.
 *
 * quadraturePoints holds one reference coordinate per node along an axis. The caller keeps
 * every component of index below that number of nodes.
 */
template <typename T>
tarch::la::Vector<DIMENSIONS, double> exahype2::dg::getQuadraturePoint(
  const tarch::la::Vector<DIMENSIONS, double>& cellCentre,
  const tarch::la::Vector<DIMENSIONS, double>& cellSize,
  const tarch::la::Vector<DIMENSIONS, int>&    index,
  const T* NOALIAS const                       quadraturePoints
) {
  assertion(index(0) >= 0, index);
  assertion(index(1) >= 0, index);
#if DIMENSIONS == 3
  assertion(index(2) >= 0, index);
#endif
#if PEANO_ASSERTIONS
  const bool cellSizeIsPositive = tarch::la::allGreater(cellSize, 0.0);
  assertion(cellSizeIsPositive, cellSize);
#endif

  tarch::la::Vector<DIMENSIONS, double> referencePosition;

  referencePosition(0) = quadraturePoints[index(0)];
  referencePosition(1) = quadraturePoints[index(1)];
#if DIMENSIONS == 3
  referencePosition(2) = quadraturePoints[index(2)];
#endif

  return tarch::la::multiplyComponents(referencePosition, cellSize) + cellCentre - 0.5 * cellSize;
}
