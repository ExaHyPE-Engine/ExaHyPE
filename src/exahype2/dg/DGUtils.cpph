
template <typename QStoreType>
QStoreType exahype2::dg::evaluatePolynomial(
  const peano4::datamanagement::CellMarker&    marker,
  int                                          order,
  const double* NOALIAS                   QuadratureNodes1d,
  int                                          unknownsPerDoF,
  const QStoreType* NOALIAS               Q,
  const tarch::la::Vector<DIMENSIONS,double>&  x,
  int                                          unknown
) {
  QStoreType result = 0.0;
  dfor(currentDoF,order+1) {
    double denominator = 1.0;
    double enumerator  = 1.0;
    for (int d=0; d<DIMENSIONS; d++) {
      for (int i=0; i<order+1; i++) {
        if ( i!=currentDoF(d) ) {
          double normalisedQuadratePointDistance = QuadratureNodes1d[currentDoF(d)]-QuadratureNodes1d[i];
          double distanceToQuadraturePoint1d     = x(d)-( QuadratureNodes1d[i]*marker.getH()(d)+marker.getOffset()(d) );
          denominator *= normalisedQuadratePointDistance * marker.getH()(d);
          enumerator  *= distanceToQuadraturePoint1d;
        }
      }
    }
    int dofLinearised = peano4::utils::dLinearised(currentDoF,order+1);
    result += enumerator/denominator * Q[ dofLinearised * unknownsPerDoF + unknown ];
  }
  return result;
}

template<typename T>
tarch::la::Vector<DIMENSIONS,double>  exahype2::dg::getQuadraturePoint(
  const tarch::la::Vector<DIMENSIONS,double>&  cellCentre,
  const tarch::la::Vector<DIMENSIONS,double>&  cellSize,
  const tarch::la::Vector<DIMENSIONS,int>&     index,
  int                                 /*polynomialOrder*/,
  const T* NOALIAS          quadraturePoints
) {
  tarch::la::Vector<DIMENSIONS,double> result;

  result(0) = quadraturePoints[index(0)];
  result(1) = quadraturePoints[index(1)];
#if DIMENSIONS==3
  result(2) = quadraturePoints[index(2)];
#endif

  return tarch::la::multiplyComponents(result,cellSize) + cellCentre - 0.5*cellSize;
}
