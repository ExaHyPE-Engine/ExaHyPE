TARGET_DECLARE
/**
 * Writes physical derivatives in consecutive axis blocks using the cell's node order.
 * Each block includes unknowns and auxiliary variables.
 */
template <
  int NumberOfDofsPerAxis,
  int NumberOfUnknowns,
  int NumberOfAuxiliaryVariables,
  typename StoragePrecision,
  typename ComputePrecision>
INLINE_METHOD GPU_CALLABLE_METHOD void exahype2::dg::computeNodalGradients(
  ComputePrecision* NOALIAS const              gradients,
  const StoragePrecision* NOALIAS const        cellState,
  const ComputePrecision* NOALIAS const        derivativeOperator,
  const tarch::la::Vector<DIMENSIONS, double>& cellSize
) {
  constexpr int NumberOfData     = NumberOfUnknowns + NumberOfAuxiliaryVariables;
  constexpr int NodesPerAxisIn3D = (DIMENSIONS == 3) ? NumberOfDofsPerAxis : 1;
  constexpr int NodesPerFace     = NumberOfDofsPerAxis * NodesPerAxisIn3D;
  constexpr int NodesPerCell     = NumberOfDofsPerAxis * NodesPerFace;
  constexpr int EntriesPerAxis   = NodesPerCell * NumberOfData;

  UNROLL(DIMENSIONS)
  for (int axis = 0; axis < DIMENSIONS; axis++) {
    assertion(cellSize(axis) > 0.0, cellSize);
    int lowerAxesStride = 1;
    for (int lowerAxis = 0; lowerAxis < axis; lowerAxis++) {
      lowerAxesStride *= NumberOfDofsPerAxis;
    }

    for (int line = 0; line < NodesPerFace; line++) {
      const int lowerAxesIndex  = line % lowerAxesStride;
      const int higherAxesIndex = line / lowerAxesStride;
      const int firstCellNode   = higherAxesIndex * NumberOfDofsPerAxis * lowerAxesStride + lowerAxesIndex;

      ComputePrecision stateLine[NumberOfDofsPerAxis * NumberOfData];
      for (int normalIndex = 0; normalIndex < NumberOfDofsPerAxis; normalIndex++) {
        const int cellNode = firstCellNode + normalIndex * lowerAxesStride;
        for (int value = 0; value < NumberOfData; value++) {
          stateLine[normalIndex * NumberOfData + value] =
            static_cast<ComputePrecision>(cellState[cellNode * NumberOfData + value]);
        }
      }

      ComputePrecision gradientLine[NumberOfDofsPerAxis * NumberOfData];
      exahype2::dg::applyOperatorAlongAxis<
        NumberOfData,
        NumberOfDofsPerAxis,
        NumberOfDofsPerAxis,
        NumberOfData,
        NumberOfDofsPerAxis,
        NumberOfData,
        true,
        ComputePrecision,
        ComputePrecision>(gradientLine, stateLine, derivativeOperator, 1.0 / cellSize(axis));

      for (int normalIndex = 0; normalIndex < NumberOfDofsPerAxis; normalIndex++) {
        const int cellNode = firstCellNode + normalIndex * lowerAxesStride;
        for (int value = 0; value < NumberOfData; value++) {
          gradients[axis * EntriesPerAxis + cellNode * NumberOfData + value] =
            gradientLine[normalIndex * NumberOfData + value];
        }
      }
    }
  }
}
TARGET_DECLARE_END
