/**
 * Runs the space-time predictor of one cell and projects its estimates onto its own faces.
 *
 * The caller passes the time step size the solver proposes for this sweep; the time stamp comes
 * from the cell label.
 */
template <
  typename SolverType,
  int  NumberOfDofsPerAxis,
  int  NumberOfUnknowns,
  int  NumberOfAuxiliaryVariables,
  bool IsLinear,
  bool EvaluateFlux,
  bool EvaluateNonconservativeProduct,
  bool EvaluateSource,
  bool EvaluateDiffusiveFlux,
  bool EvaluateDiffusiveSource,
  bool EvaluateMaterialParameters,
  bool EvaluatePointSources,
  typename ComputePrecision,
  typename PicardPrecision,
  typename StoragePrecision,
  typename CellLabel,
  typename FaceLabelEnumerator,
  typename FaceStateEnumerator,
  typename FaceFluxEnumerator>
INLINE_METHOD void exahype2::dg::ader::predict(
  const peano4::dataview::CellMarker&  marker,
  SolverType&                          solver,
  CellLabel&                           cellLabel,
  const FaceLabelEnumerator&           faceLabels,
  const FaceStateEnumerator&           faceStates,
  const FaceFluxEnumerator&            faceFluxes,
  StoragePrecision* NOALIAS            cellState,
  StoragePrecision* NOALIAS            previousCellState,
  const BasisTables<ComputePrecision>& tables,
  const BasisTables<PicardPrecision>&  picardTables,
  const double                         timeStepSize
) {
  using CellLayout    = exahype2::dg::ader::Layout<NumberOfDofsPerAxis, NumberOfUnknowns, NumberOfAuxiliaryVariables>;
  using FacePrecision = std::remove_pointer_t<decltype(faceStates(0).data())>;

  constexpr int StateElementsPerFace = CellLayout::NodesPerFace * CellLayout::NumberOfData;
  constexpr int FluxElementsPerFace  = CellLayout::NodesPerFace * NumberOfUnknowns;
  static_assert(
    std::remove_reference_t<decltype(faceStates(0))>::Cardinality == 2 * StateElementsPerFace,
    "A face holds the state estimates of the two cells that meet on it."
  );
  static_assert(
    std::remove_reference_t<decltype(faceFluxes(0))>::Cardinality == 2 * FluxElementsPerFace,
    "A face holds the flux estimates of the two cells that meet on it."
  );

  assertion(cellState != nullptr);
  assertion(previousCellState != nullptr);
  assertion(timeStepSize >= 0.0, timeStepSize, marker.toString());

  const double timeStamp = cellLabel.getTimeStamp();

  FacePrecision* stateEstimates[peano4::FacesPerCell];
  FacePrecision* fluxEstimates[peano4::FacesPerCell];
  for (int face = 0; face < peano4::FacesPerCell; face++) {
    const int ownHalf    = face < DIMENSIONS ? 1 : 0;
    stateEstimates[face] = faceStates(face).data() + ownHalf * StateElementsPerFace;
    fluxEstimates[face]  = faceFluxes(face).data() + ownHalf * FluxElementsPerFace;
  }

  // This copy decides which buffer a plotter reads: In fused ADER-DG the correction writes the
  // accepted state into the cell state earlier in this traversal, so the previous buffer carries
  // it. A limiting solver corrects in its own traversal and leaves the accepted state in place.
  std::copy_n(cellState, CellLayout::NodesPerCell * CellLayout::NumberOfData, previousCellState);

  [[maybe_unused]] const int numberOfPicardIterations = exahype2::dg::ader::runSpaceTimePredictor<
    SolverType,
    NumberOfDofsPerAxis,
    NumberOfUnknowns,
    NumberOfAuxiliaryVariables,
    IsLinear,
    EvaluateFlux,
    EvaluateNonconservativeProduct,
    EvaluateSource,
    EvaluateDiffusiveFlux,
    EvaluateDiffusiveSource,
    EvaluateMaterialParameters,
    EvaluatePointSources>(
    marker,
    stateEstimates,
    fluxEstimates,
    cellState,
    tables,
    picardTables,
    timeStamp,
    timeStepSize
  );

  if constexpr (not IsLinear) {
    if constexpr (SolverType::UsesSubcellLimiter) {
      // A diverged predictor holds no candidate, so the limiter recomputes the cell.
      cellLabel.setPredictorDiverged(numberOfPicardIterations < 0);
    } else if (numberOfPicardIterations < 0) {
      tarch::terminateWithError(
        "The space-time predictor diverged in " + marker.toString()
        + ". Configure a subcell limiter so failing cells are recomputed."
      );
    }
  }

  for (int direction = 0; direction < DIMENSIONS; direction++) {
    faceLabels(direction).setNewTimeStamp(1, timeStamp);
    faceLabels(direction + DIMENSIONS).setNewTimeStamp(0, timeStamp);

    faceLabels(direction).setUpdated(1, true);
    faceLabels(direction + DIMENSIONS).setUpdated(0, true);

    // The prediction derives this cell's face estimates, so its halves need no mesh-transfer
    // projection.
    faceLabels(direction).setRequiresDataTransfer(1, false);
    faceLabels(direction + DIMENSIONS).setRequiresDataTransfer(0, false);
  }

  cellLabel.setTimeStepSize(timeStepSize);

  bool hasHangingFaces = false;
  for (int faceNumber = 0; faceNumber < peano4::FacesPerCell; faceNumber++) {
    const auto& faceLabel = faceLabels(faceNumber);
    hasHangingFaces =
      hasHangingFaces or faceLabel.getIsHanging() or faceLabel.getAboveHanging(0) or faceLabel.getAboveHanging(1);
  }

  solver.update(timeStepSize, timeStamp, tarch::la::min(marker.getH()), tarch::la::max(marker.getH()), hasHangingFaces);
}
