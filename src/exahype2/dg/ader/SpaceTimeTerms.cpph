TARGET_DECLARE
/**
 * Splits a cell node index into one index per axis, the first axis running fastest.
 */
template <int NumberOfDofsPerAxis>
INLINE_METHOD GPU_CALLABLE_METHOD tarch::la::Vector<DIMENSIONS, int> exahype2::dg::ader::spatialNodeIndex(
  const int cellNode
) {
  assertion(cellNode >= 0, cellNode);
  tarch::la::Vector<DIMENSIONS, int> index;
  int                                remainder = cellNode;
  for (int axis = 0; axis < DIMENSIONS; axis++) {
    index(axis) = remainder % NumberOfDofsPerAxis;
    remainder /= NumberOfDofsPerAxis;
  }
  return index;
}

/**
 * Overwrites the gradient of the unknowns at every node of one time slice, one block per axis in
 * cell node order, scaled to physical derivatives.
 */
template <int NumberOfDofsPerAxis, int NumberOfUnknowns, int NumberOfAuxiliaryVariables, typename ComputePrecision>
INLINE_METHOD GPU_CALLABLE_METHOD void exahype2::dg::ader::computeSpaceTimeGradient(
  ComputePrecision* NOALIAS const                        stateGradient,
  const ComputePrecision* NOALIAS const                  spaceTimeState,
  const ComputePrecision* NOALIAS const                  derivativeOperator,
  const tarch::la::Vector<DIMENSIONS, ComputePrecision>& inverseCellSize,
  const int                                              timeNode
) {
  using CellLayout             = Layout<NumberOfDofsPerAxis, NumberOfUnknowns, NumberOfAuxiliaryVariables>;
  constexpr int StateStride    = CellLayout::PaddedNumberOfData;
  constexpr int GradientStride = CellLayout::PaddedNumberOfUnknowns;
  constexpr int AxisStride     = GradientStride * CellLayout::NodesPerCell;

  assertion(timeNode >= 0 and timeNode < NumberOfDofsPerAxis, timeNode);

  for (int axis = 0; axis < DIMENSIONS; axis++) {
    assertion(inverseCellSize(axis) > 0.0, inverseCellSize, axis);
    for (int cellNode = 0; cellNode < CellLayout::NodesPerCell; cellNode++) {
      for (int unknown = NumberOfUnknowns; unknown < GradientStride; unknown++) {
        stateGradient[axis * AxisStride + cellNode * GradientStride + unknown] = static_cast<ComputePrecision>(0);
      }
    }
  }

  const ComputePrecision* NOALIAS const timeSlice = spaceTimeState + timeNode * CellLayout::NodesPerCell * StateStride;

  for (int z = 0; z < CellLayout::NodesPerAxisIn3D; z++) {
    for (int y = 0; y < NumberOfDofsPerAxis; y++) {
      const int firstNode = (z * NumberOfDofsPerAxis + y) * NumberOfDofsPerAxis;
      exahype2::dg::applyOperatorAlongAxis<
        NumberOfUnknowns,
        NumberOfDofsPerAxis,
        NumberOfDofsPerAxis,
        StateStride,
        NumberOfDofsPerAxis,
        GradientStride,
        true,
        ComputePrecision,
        ComputePrecision>(
        stateGradient + firstNode * GradientStride,
        timeSlice + firstNode * StateStride,
        derivativeOperator,
        inverseCellSize(0)
      );
    }
  }

  for (int z = 0; z < CellLayout::NodesPerAxisIn3D; z++) {
    for (int x = 0; x < NumberOfDofsPerAxis; x++) {
      const int firstNode = z * NumberOfDofsPerAxis * NumberOfDofsPerAxis + x;
      exahype2::dg::applyOperatorAlongAxis<
        NumberOfUnknowns,
        NumberOfDofsPerAxis,
        NumberOfDofsPerAxis,
        StateStride * NumberOfDofsPerAxis,
        NumberOfDofsPerAxis,
        GradientStride * NumberOfDofsPerAxis,
        true,
        ComputePrecision,
        ComputePrecision>(
        stateGradient + firstNode * GradientStride + AxisStride,
        timeSlice + firstNode * StateStride,
        derivativeOperator,
        inverseCellSize(1)
      );
    }
  }

  if constexpr (DIMENSIONS == 3) {
    for (int y = 0; y < NumberOfDofsPerAxis; y++) {
      for (int x = 0; x < NumberOfDofsPerAxis; x++) {
        const int firstNode = y * NumberOfDofsPerAxis + x;
        exahype2::dg::applyOperatorAlongAxis<
          NumberOfUnknowns,
          NumberOfDofsPerAxis,
          NumberOfDofsPerAxis,
          StateStride * NumberOfDofsPerAxis * NumberOfDofsPerAxis,
          NumberOfDofsPerAxis,
          GradientStride * NumberOfDofsPerAxis * NumberOfDofsPerAxis,
          true,
          ComputePrecision,
          ComputePrecision>(
          stateGradient + firstNode * GradientStride + 2 * AxisStride,
          timeSlice + firstNode * StateStride,
          derivativeOperator,
          inverseCellSize(DIMENSIONS - 1)
        );
      }
    }
  }
}

/**
 * Overwrites the flux of one time slice and adds it, times the weight of the time node, to the
 * time-averaged flux, which the first time node overwrites. The solver writes into a zeroed node,
 * so an unknown it leaves out stays zero.
 */
template <
  typename SolverType,
  int  NumberOfDofsPerAxis,
  int  NumberOfUnknowns,
  int  NumberOfAuxiliaryVariables,
  bool EvaluateDiffusiveFlux,
  typename ComputePrecision>
INLINE_METHOD GPU_CALLABLE_METHOD void exahype2::dg::ader::evaluateSpaceTimeFlux(
  ComputePrecision* NOALIAS const                        flux,
  ComputePrecision* NOALIAS const                        timeAveragedFlux,
  const ComputePrecision* NOALIAS const                  spaceTimeState,
  [[maybe_unused]] const ComputePrecision* NOALIAS const stateGradient,
  const ComputePrecision* NOALIAS const                  quadraturePoints,
  const ComputePrecision* NOALIAS const                  quadratureWeights,
  const tarch::la::Vector<DIMENSIONS, double>&           cellCentre,
  const tarch::la::Vector<DIMENSIONS, double>&           cellSize,
  const double                                           timeStamp,
  const double                                           timeStepSize,
  const int                                              timeNode
) {
  using CellLayout                 = Layout<NumberOfDofsPerAxis, NumberOfUnknowns, NumberOfAuxiliaryVariables>;
  constexpr int FluxStride         = CellLayout::PaddedNumberOfUnknowns;
  constexpr int FluxAxisStride     = CellLayout::NodesPerCell * FluxStride;
  constexpr int GradientAxisStride = FluxStride * CellLayout::NodesPerCell;

  using TimePrecision = std::common_type_t<ComputePrecision, double>;

  assertion(timeNode >= 0 and timeNode < NumberOfDofsPerAxis, timeNode);

  const auto timePosition = static_cast<double>(
    static_cast<TimePrecision>(timeStamp)
    + static_cast<TimePrecision>(quadraturePoints[timeNode]) * static_cast<TimePrecision>(timeStepSize)
  );
  const ComputePrecision weight = quadratureWeights[timeNode];

  for (int cellNode = 0; cellNode < CellLayout::NodesPerCell; cellNode++) {
    const int  spaceTimeNode = timeNode * CellLayout::NodesPerCell + cellNode;
    const auto nodePosition  = exahype2::dg::getQuadraturePoint(
      cellCentre,
      cellSize,
      spatialNodeIndex<NumberOfDofsPerAxis>(cellNode),
      quadraturePoints
    );
    const ComputePrecision* NOALIAS const nodeState = spaceTimeState + spaceTimeNode * CellLayout::PaddedNumberOfData;

    [[maybe_unused]] const ComputePrecision* NOALIAS nodeGradients[DIMENSIONS];
    if constexpr (EvaluateDiffusiveFlux) {
      UNROLL(DIMENSIONS)
      for (int axis = 0; axis < DIMENSIONS; axis++) {
        nodeGradients[axis] = stateGradient + FluxStride * cellNode + axis * GradientAxisStride;
      }
    }

    UNROLL(DIMENSIONS)
    for (int axis = 0; axis < DIMENSIONS; axis++) {
      ComputePrecision* NOALIAS const nodeFlux = flux + cellNode * FluxStride + axis * FluxAxisStride;
      for (int unknown = 0; unknown < FluxStride; unknown++) {
        nodeFlux[unknown] = static_cast<ComputePrecision>(0);
      }
      if constexpr (EvaluateDiffusiveFlux) {
        SolverType::flux(nodeState, nodeGradients, nodePosition, cellSize, timePosition, timeStepSize, axis, nodeFlux);
      } else {
        SolverType::flux(nodeState, nodePosition, cellSize, timePosition, timeStepSize, axis, nodeFlux);
      }
    }
  }

  constexpr int FluxEntries = DIMENSIONS * FluxAxisStride;
  if (timeNode == 0) {
    for (int entry = 0; entry < FluxEntries; entry++) {
      timeAveragedFlux[entry] = static_cast<ComputePrecision>(0) + weight * flux[entry];
    }
  } else {
    for (int entry = 0; entry < FluxEntries; entry++) {
      timeAveragedFlux[entry] += weight * flux[entry];
    }
  }
}

/**
 * Adds the space-time quadrature of the source of one time slice to the right-hand side, and the
 * source times the weight of the time node to the time-averaged source, which the first time node
 * overwrites.
 */
template <
  typename SolverType,
  int  NumberOfDofsPerAxis,
  int  NumberOfUnknowns,
  int  NumberOfAuxiliaryVariables,
  bool EvaluateNonconservativeProduct,
  bool EvaluateSource,
  bool EvaluateDiffusiveSource,
  typename ComputePrecision>
INLINE_METHOD GPU_CALLABLE_METHOD void exahype2::dg::ader::evaluateSpaceTimeSource(
  ComputePrecision* NOALIAS const                        rightHandSide,
  ComputePrecision* NOALIAS const                        timeAveragedSource,
  const ComputePrecision* NOALIAS const                  spaceTimeState,
  [[maybe_unused]] const ComputePrecision* NOALIAS const stateGradient,
  const ComputePrecision* NOALIAS const                  quadraturePoints,
  const ComputePrecision* NOALIAS const                  quadratureWeights,
  const ComputePrecision* NOALIAS const                  cellQuadratureWeights,
  const tarch::la::Vector<DIMENSIONS, double>&           cellCentre,
  const tarch::la::Vector<DIMENSIONS, double>&           cellSize,
  const double                                           timeStamp,
  const double                                           timeStepSize,
  const int                                              timeNode
) {
  static_assert(
    EvaluateNonconservativeProduct or EvaluateSource or EvaluateDiffusiveSource,
    "The source of a node sums at least one term."
  );

  using CellLayout                 = Layout<NumberOfDofsPerAxis, NumberOfUnknowns, NumberOfAuxiliaryVariables>;
  constexpr int SourceStride       = CellLayout::PaddedNumberOfUnknowns;
  constexpr int GradientAxisStride = SourceStride * CellLayout::NodesPerCell;

  using TimePrecision = std::common_type_t<ComputePrecision, double>;

  assertion(timeNode >= 0 and timeNode < NumberOfDofsPerAxis, timeNode);

  const auto timePosition = static_cast<double>(
    static_cast<TimePrecision>(timeStamp)
    + static_cast<TimePrecision>(quadraturePoints[timeNode]) * static_cast<TimePrecision>(timeStepSize)
  );

  [[maybe_unused]] ComputePrecision productValues[NumberOfUnknowns] __attribute__((aligned(PEANO_WITH_ALIGNMENT)));
  [[maybe_unused]] ComputePrecision diffusiveSourceValues[NumberOfUnknowns]
    __attribute__((aligned(PEANO_WITH_ALIGNMENT)));
  [[maybe_unused]] ComputePrecision nodeGradient[EvaluateDiffusiveSource ? NumberOfUnknowns * DIMENSIONS : 1]
    __attribute__((aligned(PEANO_WITH_ALIGNMENT)));

  const ComputePrecision weight = quadratureWeights[timeNode];

  ComputePrecision localSource[SourceStride] __attribute__((aligned(PEANO_WITH_ALIGNMENT)));

  for (int cellNode = 0; cellNode < CellLayout::NodesPerCell; cellNode++) {
    const int spaceTimeNode = timeNode * CellLayout::NodesPerCell + cellNode;
    for (int unknown = 0; unknown < SourceStride; unknown++) {
      localSource[unknown] = static_cast<ComputePrecision>(0);
    }

    const auto nodePosition = exahype2::dg::getQuadraturePoint(
      cellCentre,
      cellSize,
      spatialNodeIndex<NumberOfDofsPerAxis>(cellNode),
      quadraturePoints
    );
    const ComputePrecision* NOALIAS const nodeState = spaceTimeState + spaceTimeNode * CellLayout::PaddedNumberOfData;

    if constexpr (EvaluateDiffusiveSource) {
      for (int axis = 0; axis < DIMENSIONS; axis++) {
        for (int unknown = 0; unknown < NumberOfUnknowns; unknown++) {
          nodeGradient[axis * NumberOfUnknowns + unknown] =
            stateGradient[SourceStride * cellNode + axis * GradientAxisStride + unknown];
        }
      }
    }

    if constexpr (EvaluateSource) {
      SolverType::sourceTerm(nodeState, nodePosition, cellSize, timePosition, timeStepSize, localSource);
    }

    if constexpr (EvaluateDiffusiveSource and EvaluateSource) {
      for (int unknown = 0; unknown < NumberOfUnknowns; unknown++) {
        diffusiveSourceValues[unknown] = static_cast<ComputePrecision>(0);
      }
      SolverType::diffusiveSourceTerm(
        nodeState,
        nodeGradient,
        nodePosition,
        cellSize,
        timePosition,
        timeStepSize,
        diffusiveSourceValues
      );
      SIMD(aligned(diffusiveSourceValues : PEANO_WITH_ALIGNMENT))
      for (int unknown = 0; unknown < NumberOfUnknowns; unknown++) {
        localSource[unknown] += diffusiveSourceValues[unknown];
      }
    } else if constexpr (EvaluateDiffusiveSource) {
      SolverType::diffusiveSourceTerm(
        nodeState,
        nodeGradient,
        nodePosition,
        cellSize,
        timePosition,
        timeStepSize,
        localSource
      );
    }

    if constexpr (EvaluateNonconservativeProduct) {
      UNROLL(DIMENSIONS)
      for (int axis = 0; axis < DIMENSIONS; axis++) {
        for (int unknown = 0; unknown < NumberOfUnknowns; unknown++) {
          productValues[unknown] = static_cast<ComputePrecision>(0);
        }
        SolverType::nonconservativeProduct(
          nodeState,
          stateGradient + SourceStride * cellNode + axis * GradientAxisStride,
          nodePosition,
          cellSize,
          timePosition,
          timeStepSize,
          axis,
          productValues
        );
        SIMD(aligned(productValues : PEANO_WITH_ALIGNMENT))
        for (int unknown = 0; unknown < NumberOfUnknowns; unknown++) {
          localSource[unknown] -= productValues[unknown];
        }
      }
    }

    const auto updateSize = static_cast<ComputePrecision>(
      static_cast<TimePrecision>(quadratureWeights[timeNode] * cellQuadratureWeights[cellNode])
      * static_cast<TimePrecision>(timeStepSize)
    );
    SIMD()
    for (int unknown = 0; unknown < NumberOfUnknowns; unknown++) {
      rightHandSide[unknown + spaceTimeNode * SourceStride] += updateSize * localSource[unknown];
    }

    ComputePrecision* NOALIAS const nodeAverage = timeAveragedSource + cellNode * SourceStride;
    if (timeNode == 0) {
      SIMD()
      for (int unknown = 0; unknown < SourceStride; unknown++) {
        nodeAverage[unknown] = static_cast<ComputePrecision>(0) + weight * localSource[unknown];
      }
    } else {
      SIMD()
      for (int unknown = 0; unknown < SourceStride; unknown++) {
        nodeAverage[unknown] += weight * localSource[unknown];
      }
    }
  }
}
TARGET_DECLARE_END
