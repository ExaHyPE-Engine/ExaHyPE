#include "peano4/Loop.h"
#include "tarch/Assertions.h"
#include "tarch/accelerator/Device.h"
#include "tarch/la/VectorOperations.h"

TARGET_DECLARE
INLINE_METHOD GPU_CALLABLE_METHOD void
exahype2::dg::ader::PicardResidual::add(const PicardResidual& other) {
  const std::uint64_t sum = lowLimb + other.lowLimb;
  highLimb += other.highLimb + (sum < lowLimb ? 1 : 0);
  lowLimb  = sum;
  exceeds  = exceeds or other.exceeds;
  diverged = diverged or other.diverged;
}

/**
 * Solves the local Cauchy problem of one cell with a Picard iteration on the threads of workers and
 * extrapolates the time-averaged state and flux to the faces. On return, the time-averaged flux in
 * scratch stores its derivative along its own axis. Returns the number of sweeps,
 * UnconvergedPicardIteration or DivergedPicardIteration, and zero on a thread without a cell.
 */
template <typename Derived, typename ComputePrecision>
template <typename StoragePrecision, typename CorrectorPrecision>
INLINE_METHOD GPU_CALLABLE_METHOD int
exahype2::dg::ader::NonlinearPredictor<Derived, ComputePrecision>::predict(
  CorrectorPrecision* const NOALIAS            faceStates[peano4::FacesPerCell],
  CorrectorPrecision* const NOALIAS            faceFluxes[peano4::FacesPerCell],
  const StoragePrecision* NOALIAS const        cellState,
  ComputePrecision* NOALIAS const              scratch,
  const Tables&                                tables,
  const tarch::la::Vector<DIMENSIONS, double>& cellCentre,
  const tarch::la::Vector<DIMENSIONS, double>& cellSize,
  const double                                 timeStamp,
  const double                                 timeStepSize,
  const double                                 picardTolerance,
  const TeamWorkers&                           workers
) {
  constexpr int NodesPerAxis          = CellLayout::NodesPerAxis;
  constexpr int NumberOfUnknowns      = CellLayout::NumberOfUnknowns;
  constexpr int MaximumNumberOfSweeps = 2 * NodesPerAxis + 1;

  assertion(timeStepSize >= 0.0, timeStepSize);
  assertion(picardTolerance > 0.0, picardTolerance);
  assertion(workers.thread >= 0 and workers.thread < workers.threads, workers.thread, workers.threads);

  ComputePrecision* NOALIAS const spaceTimeState     = scratch + Scratch::SpaceTimeStateOffset;
  ComputePrecision* NOALIAS const rightHandSide      = scratch + Scratch::RightHandSideOffset;
  ComputePrecision* const         flux               = scratch + Scratch::FluxOffset;
  ComputePrecision* const         firstFlux          = scratch + Scratch::FirstFluxOffset;
  ComputePrecision* NOALIAS const timeAveragedFlux   = scratch + Scratch::TimeAveragedFluxOffset;
  ComputePrecision* NOALIAS const firstSource        = scratch + Scratch::FirstSourceOffset;
  ComputePrecision* NOALIAS const timeAveragedSource = scratch + Scratch::TimeAveragedSourceOffset;
  ComputePrecision* NOALIAS const stateGradient      = scratch + Scratch::StateGradientOffset;

  const auto   inverseCellSize = tarch::la::convertScalar<ComputePrecision>(tarch::la::invertEntries(cellSize));
  const double squaredTolerance =
    workers.hasCell ? getSquaredTolerance(cellState, picardTolerance) : picardTolerance * picardTolerance;

  bool active = workers.hasCell;
  if (active) {
    initialiseState(spaceTimeState, cellState, workers);
  }

  int  numberOfSweeps = 0;
  bool converged      = false;
  bool diverged       = false;
  bool anyActive      = isAnyActive(workers, active);
  while (anyActive) {
    for (int timeNode = 0; timeNode < NodesPerAxis; timeNode++) {
      // The other threads read the state slice and the gradient of the previous time node until
      // here.
      exahype2::dg::ader::synchronise(workers);
      if (active) {
        if constexpr (NeedsStateGradient) {
          computeSpaceTimeGradient(
            stateGradient,
            spaceTimeState,
            tables.derivativeOperator,
            inverseCellSize,
            timeNode,
            workers
          );
        }
        clearRightHandSide(rightHandSide, timeNode, workers);
      }
      exahype2::dg::ader::synchronise(workers);

      // The later time nodes read the flux of the first time node for the time average.
      ComputePrecision* const fluxOfTimeNode = timeNode == 0 ? firstFlux : flux;
      if constexpr (EvaluateFlux) {
        if (active) {
          evaluateSpaceTimeFlux(
            fluxOfTimeNode,
            spaceTimeState,
            stateGradient,
            tables.quadraturePoints,
            cellCentre,
            cellSize,
            timeStamp,
            timeStepSize,
            timeNode,
            workers
          );
        }
        exahype2::dg::ader::synchronise(workers);
        if (active) {
          averageFluxOverTime(
            timeAveragedFlux,
            fluxOfTimeNode,
            firstFlux,
            tables.quadratureWeights[timeNode],
            timeNode,
            workers
          );
        }
        // The lines of one axis write disjoint nodes. The axes add to the same nodes in ascending order.
        for (int axis = 0; axis < DIMENSIONS; axis++) {
          if (active) {
            subtractFluxDivergence(
              rightHandSide,
              fluxOfTimeNode,
              tables.stiffnessOperatorTransposed,
              tables.cellQuadratureWeights,
              inverseCellSize,
              timeStepSize,
              timeNode,
              axis,
              workers
            );
          }
          exahype2::dg::ader::synchronise(workers);
        }
      }

      if constexpr (AccumulatesSource) {
        if (active) {
          evaluateSpaceTimeSource(
            rightHandSide,
            firstSource,
            timeAveragedSource,
            spaceTimeState,
            stateGradient,
            tables.quadraturePoints,
            tables.quadratureWeights,
            tables.cellQuadratureWeights,
            cellCentre,
            cellSize,
            timeStamp,
            timeStepSize,
            timeNode,
            workers
          );
        }
      }
    }
    exahype2::dg::ader::synchronise(workers);

    PicardResidual ownResidual;
    if (active) {
      ownResidual = solvePicardSystem(
        spaceTimeState,
        rightHandSide,
        cellState,
        tables.inversePicardOperator,
        tables.inverseCellQuadratureWeights,
        squaredTolerance,
        workers
      );
    }
    const PicardResidual residual = combineOverGroup(workers, ownResidual);
    if (active) {
      numberOfSweeps++;
      const double squaredResidual = getSquaredResidual(residual, squaredTolerance);
      if (not std::isfinite(squaredResidual)) {
        diverged = true;
      } else if (squaredResidual < squaredTolerance) {
        converged = true;
      }
      active = not diverged and not converged and numberOfSweeps < MaximumNumberOfSweeps;
    }
    anyActive = isAnyActive(workers, active);
  }
  exahype2::dg::ader::synchronise(workers);

  if (workers.hasCell) {
    averageStateOverTime(spaceTimeState, tables.quadratureWeights, workers);
  }
  exahype2::dg::ader::synchronise(workers);
  const ComputePrecision* const timeAveragedState = spaceTimeState;

  if (workers.hasCell) {
    for (int direction = workers.thread; direction < DIMENSIONS; direction += workers.threads) {
      exahype2::dg::extrapolateNodalFieldToFacePair<
        NodesPerAxis,
        CellLayout::NumberOfData,
        CellLayout::PaddedNumberOfData,
        ComputePrecision,
        CorrectorPrecision,
        ComputePrecision
      >(faceStates[direction],
        faceStates[direction + DIMENSIONS],
        timeAveragedState,
        tables.leftFaceCoefficients,
        tables.rightFaceCoefficients,
        direction);
      if constexpr (EvaluateFlux) {
        exahype2::dg::extrapolateNodalFieldToFacePair<
          NodesPerAxis,
          NumberOfUnknowns,
          CellLayout::PaddedNumberOfUnknowns,
          ComputePrecision,
          CorrectorPrecision,
          ComputePrecision
        >(faceFluxes[direction],
          faceFluxes[direction + DIMENSIONS],
          timeAveragedFlux + direction * CellLayout::PaddedNumberOfUnknowns * CellLayout::NodesPerCell,
          tables.leftFaceCoefficients,
          tables.rightFaceCoefficients,
          direction);
      } else {
        for (int entry = 0; entry < CellLayout::NodesPerFace * NumberOfUnknowns; entry++) {
          faceFluxes[direction][entry]              = static_cast<ComputePrecision>(0);
          faceFluxes[direction + DIMENSIONS][entry] = static_cast<ComputePrecision>(0);
        }
      }
    }
  }
  exahype2::dg::ader::synchronise(workers);

  if constexpr (EvaluateFlux) {
    if (workers.hasCell) {
      exahype2::dg::differentiateFluxInPlace<Derived>(
        timeAveragedFlux,
        tables.derivativeOperator,
        inverseCellSize,
        workers.thread,
        workers.threads
      );
    }
    exahype2::dg::ader::synchronise(workers);
  }

  if (not workers.hasCell) {
    return 0;
  }
  if (diverged) {
    return exahype2::dg::ader::DivergedPicardIteration;
  }
  if (not converged) {
    return exahype2::dg::ader::UnconvergedPicardIteration;
  }
  return numberOfSweeps;
}

/**
 * Returns the bytes at the start of the aligned team scratch that combineOverGroup() and
 * isAnyActive() use. These bytes hold two limbs and two flags per thread of the team. The count
 * rounds up to PEANO_WITH_ALIGNMENT.
 */
template <typename Derived, typename ComputePrecision>
INLINE_METHOD GPU_CALLABLE_METHOD int
exahype2::dg::ader::NonlinearPredictor<Derived, ComputePrecision>::getReservedTeamScratchBytes(const int teamThreads) {
  assertion(teamThreads > 0, teamThreads);
  const int bytes = teamThreads * (2 * static_cast<int>(sizeof(std::uint64_t)) + 2);
  return ((bytes + PEANO_WITH_ALIGNMENT - 1) / PEANO_WITH_ALIGNMENT) * PEANO_WITH_ALIGNMENT;
}

/**
 * Returns the team scratch bytes that a launch of teams of teamThreads threads asks for. The count
 * adds the alignment slack to the reserved bytes. A team of one thread needs none.
 */
template <typename Derived, typename ComputePrecision>
INLINE_METHOD GPU_CALLABLE_METHOD int
exahype2::dg::ader::NonlinearPredictor<Derived, ComputePrecision>::getTeamScratchBytes(const int teamThreads) {
  assertion(teamThreads > 0, teamThreads);
  if (teamThreads == 1) {
    return 0;
  }
  return getReservedTeamScratchBytes(teamThreads) + PEANO_WITH_ALIGNMENT;
}

/**
 * Returns the team scratch of workers rounded up to PEANO_WITH_ALIGNMENT. A caller asks for the
 * bytes of getTeamScratchBytes() at the launch.
 */
template <typename Derived, typename ComputePrecision>
INLINE_METHOD GPU_CALLABLE_METHOD unsigned char*
exahype2::dg::ader::NonlinearPredictor<Derived, ComputePrecision>::getAlignedTeamScratch(const TeamWorkers& workers) {
  assertion(workers.scratch != nullptr, workers.teamThread, workers.teamThreads);
  const auto           address = reinterpret_cast<std::uintptr_t>(workers.scratch);
  const std::uintptr_t aligned =
    (address + PEANO_WITH_ALIGNMENT - 1) & ~static_cast<std::uintptr_t>(PEANO_WITH_ALIGNMENT - 1);
  return reinterpret_cast<unsigned char*>(aligned);
}

/**
 * Returns the sum of the residuals of the threads of the group of workers, the same value on every
 * thread of the group. Every thread writes its limbs and flag into the reserved start of the
 * aligned team scratch and adds the entries of its group in thread order. A team of one thread
 * returns residual and a thread without a group an empty residual.
 */
template <typename Derived, typename ComputePrecision>
INLINE_METHOD GPU_CALLABLE_METHOD exahype2::dg::ader::PicardResidual
exahype2::dg::ader::NonlinearPredictor<Derived, ComputePrecision>::combineOverGroup(
  const TeamWorkers&    workers,
  const PicardResidual& residual
) {
  if (workers.teamThreads == 1) {
    return residual;
  }
  PicardResidual sum;
  auto* const    limbs              = reinterpret_cast<std::uint64_t*>(getAlignedTeamScratch(workers));
  auto* const    flags              = reinterpret_cast<unsigned char*>(limbs + 2 * workers.teamThreads);
  limbs[2 * workers.teamThread]     = residual.highLimb;
  limbs[2 * workers.teamThread + 1] = residual.lowLimb;
  flags[workers.teamThread] = static_cast<unsigned char>((residual.exceeds ? 1 : 0) + (residual.diverged ? 2 : 0));
  exahype2::dg::ader::synchronise(workers);
  if (workers.group < workers.groups) {
    const int first = workers.group * workers.threads;
    for (int other = first; other < first + workers.threads; other++) {
      PicardResidual part;
      part.highLimb = limbs[2 * other];
      part.lowLimb  = limbs[2 * other + 1];
      part.exceeds  = (flags[other] & 1) != 0;
      part.diverged = (flags[other] & 2) != 0;
      sum.add(part);
    }
  }
  exahype2::dg::ader::synchronise(workers);
  return sum;
}

/**
 * Returns whether any thread of the team passes active. Every thread returns the same value. A team
 * of one thread returns active.
 */
template <typename Derived, typename ComputePrecision>
INLINE_METHOD GPU_CALLABLE_METHOD bool
exahype2::dg::ader::NonlinearPredictor<Derived, ComputePrecision>::isAnyActive(
  const TeamWorkers& workers,
  const bool         active
) {
  if (workers.teamThreads == 1) {
    return active;
  }
  unsigned char* const flags =
    getAlignedTeamScratch(workers) + workers.teamThreads * (2 * static_cast<int>(sizeof(std::uint64_t)) + 1);
  flags[workers.teamThread] = active ? 1 : 0;
  exahype2::dg::ader::synchronise(workers);
  bool any = false;
  for (int other = 0; other < workers.teamThreads; other++) {
    any = any or flags[other] != 0;
  }
  exahype2::dg::ader::synchronise(workers);
  return any;
}

/**
 * Returns the squared tolerance of the Picard iteration of one cell. The tolerance is the larger of
 * picardTolerance and the distance that the rounding of ComputePrecision leaves between two
 * iterates of the cell. The largest unknown of the first node of cellState scales that distance.
 */
template <typename Derived, typename ComputePrecision>
template <typename StoragePrecision>
INLINE_METHOD GPU_CALLABLE_METHOD double
exahype2::dg::ader::NonlinearPredictor<Derived, ComputePrecision>::getSquaredTolerance(
  const StoragePrecision* NOALIAS const cellState,
  const double                          picardTolerance
) {
  // Each value of two converged iterates differs by up to RoundingUnits units in the last place of
  // the largest unknown of the first node. solvePicardSystem() sums the squares of the differences
  // of ValuesPerIterate values.
  constexpr double RoundingUnits = 2.0;
  constexpr double RoundingOfValue =
    RoundingUnits * static_cast<double>(std::numeric_limits<ComputePrecision>::epsilon());
  constexpr double ValuesPerIterate =
    static_cast<double>(CellLayout::NumberOfUnknowns * CellLayout::NodesPerCell * CellLayout::NodesPerAxis);
  constexpr double SquaredRounding = ValuesPerIterate * RoundingOfValue * RoundingOfValue;
  assertion(cellState != nullptr);
  assertion(picardTolerance > 0.0, picardTolerance);

  double largestMagnitude = 0.0;
  for (int unknown = 0; unknown < CellLayout::NumberOfUnknowns; unknown++) {
    const double magnitude = std::abs(static_cast<double>(cellState[unknown]));
    largestMagnitude       = magnitude > largestMagnitude ? magnitude : largestMagnitude;
  }
  const double squaredRoundingOfCell = SquaredRounding * largestMagnitude * largestMagnitude;
  const double squaredTolerance      = picardTolerance * picardTolerance;
  return squaredRoundingOfCell > squaredTolerance ? squaredRoundingOfCell : squaredTolerance;
}

/**
 * Returns the squared residual as a double. A diverged iterate yields infinity. A square at or
 * above squaredTolerance yields squaredTolerance.
 */
template <typename Derived, typename ComputePrecision>
INLINE_METHOD GPU_CALLABLE_METHOD double
exahype2::dg::ader::NonlinearPredictor<Derived, ComputePrecision>::getSquaredResidual(
  const PicardResidual& residual,
  const double          squaredTolerance
) {
  constexpr double TwoToThe63 = 9223372036854775808.0;
  constexpr double TwoToThe64 = 18446744073709551616.0;
  if (residual.diverged) {
    return std::numeric_limits<double>::infinity();
  }
  if (residual.exceeds) {
    return squaredTolerance;
  }
  // solvePicardSystem() leaves both limbs zero for every squaredTolerance whose scale overflows.
  if (residual.highLimb == 0 and residual.lowLimb == 0) {
    return 0.0;
  }
  const double scale = TwoToThe63 / squaredTolerance;
  assertion(std::isfinite(scale), squaredTolerance);
  return (static_cast<double>(residual.highLimb) * TwoToThe64 + static_cast<double>(residual.lowLimb)) / scale;
}

/**
 * Copies the cell state into every time slice of the space-time state and zeroes the padding lanes.
 */
template <typename Derived, typename ComputePrecision>
template <typename StoragePrecision>
INLINE_METHOD GPU_CALLABLE_METHOD void
exahype2::dg::ader::NonlinearPredictor<Derived, ComputePrecision>::initialiseState(
  ComputePrecision* NOALIAS const       spaceTimeState,
  const StoragePrecision* NOALIAS const cellState,
  const TeamWorkers&                    workers
) {
  constexpr int SliceSize = CellLayout::PaddedNumberOfData * CellLayout::NodesPerCell;

  for (int cellNode = workers.thread; cellNode < CellLayout::NodesPerCell; cellNode += workers.threads) {
    ComputePrecision* NOALIAS const localState = spaceTimeState + CellLayout::PaddedNumberOfData * cellNode;
    for (int value = CellLayout::NumberOfData; value < CellLayout::PaddedNumberOfData; value++) {
      localState[value] = static_cast<ComputePrecision>(0);
    }
    for (int value = 0; value < CellLayout::NumberOfData; value++) {
      localState[value] = static_cast<ComputePrecision>(cellState[CellLayout::NumberOfData * cellNode + value]);
    }
    for (int timeNode = 1; timeNode < CellLayout::NodesPerAxis; timeNode++) {
      for (int value = 0; value < CellLayout::PaddedNumberOfData; value++) {
        spaceTimeState[timeNode * SliceSize + CellLayout::PaddedNumberOfData * cellNode + value] = localState[value];
      }
    }
  }
}

/**
 * Overwrites stateGradient with the physical gradient of the unknowns of one time slice.
 * stateGradient holds one block per axis.
 */
template <typename Derived, typename ComputePrecision>
INLINE_METHOD GPU_CALLABLE_METHOD void
exahype2::dg::ader::NonlinearPredictor<Derived, ComputePrecision>::computeSpaceTimeGradient(
  ComputePrecision* NOALIAS const                        stateGradient,
  const ComputePrecision* NOALIAS const                  spaceTimeState,
  const ComputePrecision* NOALIAS const                  derivativeOperator,
  const tarch::la::Vector<DIMENSIONS, ComputePrecision>& inverseCellSize,
  const int                                              timeNode,
  const TeamWorkers&                                     workers
) {
  constexpr int NodesPerAxis     = CellLayout::NodesPerAxis;
  constexpr int NumberOfUnknowns = CellLayout::NumberOfUnknowns;
  constexpr int StateStride      = CellLayout::PaddedNumberOfData;
  constexpr int GradientStride   = CellLayout::PaddedNumberOfUnknowns;
  constexpr int AxisStride       = GradientStride * CellLayout::NodesPerCell;
  constexpr int LinesPerAxis     = CellLayout::NodesPerAxisIn3D * NodesPerAxis;

  assertion(timeNode >= 0 and timeNode < NodesPerAxis, timeNode);

  for (int axis = 0; axis < DIMENSIONS; axis++) {
    assertion(inverseCellSize(axis) > 0.0, inverseCellSize, axis);
    for (int cellNode = workers.thread; cellNode < CellLayout::NodesPerCell; cellNode += workers.threads) {
      for (int unknown = NumberOfUnknowns; unknown < GradientStride; unknown++) {
        stateGradient[axis * AxisStride + cellNode * GradientStride + unknown] = static_cast<ComputePrecision>(0);
      }
    }
  }

  const ComputePrecision* NOALIAS const timeSlice = spaceTimeState + timeNode * CellLayout::NodesPerCell * StateStride;

  for (int line = workers.thread; line < LinesPerAxis; line += workers.threads) {
    const int z         = line / NodesPerAxis;
    const int y         = line - z * NodesPerAxis;
    const int firstNode = (z * NodesPerAxis + y) * NodesPerAxis;
    exahype2::dg::differentiateAlongAxis<
      NumberOfUnknowns,
      NodesPerAxis,
      StateStride,
      NodesPerAxis,
      GradientStride,
      true,
      ComputePrecision,
      ComputePrecision
    >(stateGradient + firstNode * GradientStride,
      timeSlice + firstNode * StateStride,
      derivativeOperator,
      inverseCellSize(0));
  }

  for (int line = workers.thread; line < LinesPerAxis; line += workers.threads) {
    const int z         = line / NodesPerAxis;
    const int x         = line - z * NodesPerAxis;
    const int firstNode = z * NodesPerAxis * NodesPerAxis + x;
    exahype2::dg::differentiateAlongAxis<
      NumberOfUnknowns,
      NodesPerAxis,
      StateStride * NodesPerAxis,
      NodesPerAxis,
      GradientStride * NodesPerAxis,
      true,
      ComputePrecision,
      ComputePrecision
    >(stateGradient + firstNode * GradientStride + AxisStride,
      timeSlice + firstNode * StateStride,
      derivativeOperator,
      inverseCellSize(1));
  }

  if constexpr (DIMENSIONS == 3) {
    for (int line = workers.thread; line < NodesPerAxis * NodesPerAxis; line += workers.threads) {
      const int y         = line / NodesPerAxis;
      const int x         = line - y * NodesPerAxis;
      const int firstNode = y * NodesPerAxis + x;
      exahype2::dg::differentiateAlongAxis<
        NumberOfUnknowns,
        NodesPerAxis,
        StateStride * NodesPerAxis * NodesPerAxis,
        NodesPerAxis,
        GradientStride * NodesPerAxis * NodesPerAxis,
        true,
        ComputePrecision,
        ComputePrecision
      >(stateGradient + firstNode * GradientStride + 2 * AxisStride,
        timeSlice + firstNode * StateStride,
        derivativeOperator,
        inverseCellSize(DIMENSIONS - 1));
    }
  }
}

/**
 * Overwrites flux with the flux of every node of one time slice. flux holds one block per axis. An
 * unknown that Derived does not write stays zero.
 */
template <typename Derived, typename ComputePrecision>
INLINE_METHOD GPU_CALLABLE_METHOD void
exahype2::dg::ader::NonlinearPredictor<Derived, ComputePrecision>::evaluateSpaceTimeFlux(
  ComputePrecision* NOALIAS const                        flux,
  const ComputePrecision* NOALIAS const                  spaceTimeState,
  [[maybe_unused]] const ComputePrecision* NOALIAS const stateGradient,
  const ComputePrecision* NOALIAS const                  quadraturePoints,
  const tarch::la::Vector<DIMENSIONS, double>&           cellCentre,
  const tarch::la::Vector<DIMENSIONS, double>&           cellSize,
  const double                                           timeStamp,
  const double                                           timeStepSize,
  const int                                              timeNode,
  const TeamWorkers&                                     workers
) {
  constexpr int NodesPerAxis       = CellLayout::NodesPerAxis;
  constexpr int FluxStride         = CellLayout::PaddedNumberOfUnknowns;
  constexpr int FluxAxisStride     = CellLayout::NodesPerCell * FluxStride;
  constexpr int GradientAxisStride = FluxStride * CellLayout::NodesPerCell;

  using TimePrecision = std::common_type_t<ComputePrecision, double>;

  assertion(timeNode >= 0 and timeNode < NodesPerAxis, timeNode);

  const auto timePosition = static_cast<double>(
    static_cast<TimePrecision>(timeStamp)
    + static_cast<TimePrecision>(quadraturePoints[timeNode]) * static_cast<TimePrecision>(timeStepSize)
  );

  for (int cellNode = workers.thread; cellNode < CellLayout::NodesPerCell; cellNode += workers.threads) {
    const int  spaceTimeNode = timeNode * CellLayout::NodesPerCell + cellNode;
    const auto nodePosition  = exahype2::dg::getQuadraturePoint(
      cellCentre,
      cellSize,
      peano4::dDelinearised(cellNode, NodesPerAxis),
      quadraturePoints
    );
    const ComputePrecision* NOALIAS const nodeState = spaceTimeState + spaceTimeNode * CellLayout::PaddedNumberOfData;

    [[maybe_unused]] const ComputePrecision* NOALIAS nodeGradients[DIMENSIONS];
    if constexpr (EvaluateDiffusiveFlux) {
      UNROLL(DIMENSIONS)
      for (int axis = 0; axis < DIMENSIONS; axis++) {
        nodeGradients[axis] = stateGradient + FluxStride * cellNode + axis * GradientAxisStride;
      }
    }

    UNROLL(DIMENSIONS)
    for (int axis = 0; axis < DIMENSIONS; axis++) {
      ComputePrecision* NOALIAS const nodeFlux = flux + cellNode * FluxStride + axis * FluxAxisStride;
      for (int unknown = 0; unknown < FluxStride; unknown++) {
        nodeFlux[unknown] = static_cast<ComputePrecision>(0);
      }
      if constexpr (EvaluateDiffusiveFlux) {
        Derived::flux(nodeState, nodeGradients, nodePosition, cellSize, timePosition, timeStepSize, axis, nodeFlux);
      } else {
        Derived::flux(nodeState, nodePosition, cellSize, timePosition, timeStepSize, axis, nodeFlux);
      }
    }
  }
}

/**
 * Adds weight times the difference between flux and firstFlux to timeAveragedFlux. At timeNode
 * zero, the function first overwrites timeAveragedFlux with firstFlux. A flux that is constant in
 * time returns its value bitwise.
 */
template <typename Derived, typename ComputePrecision>
INLINE_METHOD GPU_CALLABLE_METHOD void
exahype2::dg::ader::NonlinearPredictor<Derived, ComputePrecision>::averageFluxOverTime(
  ComputePrecision* NOALIAS const timeAveragedFlux,
  const ComputePrecision* const   flux,
  const ComputePrecision* const   firstFlux,
  const ComputePrecision          weight,
  const int                       timeNode,
  const TeamWorkers&              workers
) {
  constexpr int FluxEntries = DIMENSIONS * CellLayout::NodesPerCell * CellLayout::PaddedNumberOfUnknowns;

  assertion(timeNode >= 0 and timeNode < CellLayout::NodesPerAxis, timeNode);
  assertion(timeNode > 0 or flux == firstFlux, timeNode);

  if (workers.threads == 1) {
    if (timeNode == 0) {
      for (int entry = 0; entry < FluxEntries; entry++) {
        timeAveragedFlux[entry] = firstFlux[entry];
      }
    }
    SIMD()
    for (int entry = 0; entry < FluxEntries; entry++) {
      timeAveragedFlux[entry] += weight * (flux[entry] - firstFlux[entry]);
    }
    return;
  }
  for (int entry = workers.thread; entry < FluxEntries; entry += workers.threads) {
    if (timeNode == 0) {
      timeAveragedFlux[entry] = firstFlux[entry];
    }
    timeAveragedFlux[entry] += weight * (flux[entry] - firstFlux[entry]);
  }
}

/**
 * Zeroes the right-hand side of one time node. The Picard system solves for the difference from
 * the cell state. The right-hand side collects only the flux divergence and the sources.
 */
template <typename Derived, typename ComputePrecision>
INLINE_METHOD GPU_CALLABLE_METHOD void
exahype2::dg::ader::NonlinearPredictor<Derived, ComputePrecision>::clearRightHandSide(
  ComputePrecision* NOALIAS const rightHandSide,
  const int                       timeNode,
  const TeamWorkers&              workers
) {
  constexpr int SliceEntries = CellLayout::PaddedNumberOfUnknowns * CellLayout::NodesPerCell;

  assertion(timeNode >= 0 and timeNode < CellLayout::NodesPerAxis, timeNode);

  ComputePrecision* NOALIAS const timeSlice = rightHandSide + SliceEntries * timeNode;
  for (int entry = workers.thread; entry < SliceEntries; entry += workers.threads) {
    timeSlice[entry] = static_cast<ComputePrecision>(0);
  }
}

/**
 * Subtracts the derivative of flux along axis from the time slice timeNode of rightHandSide. The
 * scaling multiplies the transposed stiffness operator by the weights of time and of the other
 * axes. A caller runs the axes in ascending order with a barrier between two calls.
 */
template <typename Derived, typename ComputePrecision>
INLINE_METHOD GPU_CALLABLE_METHOD void
exahype2::dg::ader::NonlinearPredictor<Derived, ComputePrecision>::subtractFluxDivergence(
  ComputePrecision* NOALIAS const                        rightHandSide,
  const ComputePrecision* NOALIAS const                  flux,
  const ComputePrecision* NOALIAS const                  stiffnessOperatorTransposed,
  const ComputePrecision* NOALIAS const                  cellQuadratureWeights,
  const tarch::la::Vector<DIMENSIONS, ComputePrecision>& inverseCellSize,
  const double                                           timeStepSize,
  const int                                              timeNode,
  const int                                              axis,
  const TeamWorkers&                                     workers
) {
  constexpr int NodesPerAxis   = CellLayout::NodesPerAxis;
  constexpr int NodeStride     = CellLayout::PaddedNumberOfUnknowns;
  constexpr int FluxAxisStride = CellLayout::NodesPerCell * NodeStride;
  constexpr int LinesPerAxis   = CellLayout::NodesPerAxisIn3D * NodesPerAxis;

  assertion(timeNode >= 0 and timeNode < NodesPerAxis, timeNode);
  assertion(axis >= 0 and axis < DIMENSIONS, axis);
  assertion(inverseCellSize(axis) > 0.0, inverseCellSize, axis);

  // The right-hand side spans every time node. The flux spans one time slice.
  const int              timeSliceOffset    = timeNode * CellLayout::NodesPerCell * NodeStride;
  const ComputePrecision timeStepByCellSize = static_cast<ComputePrecision>(timeStepSize) * inverseCellSize(axis);

  if (axis == 0) {
    for (int line = workers.thread; line < LinesPerAxis; line += workers.threads) {
      const int        z          = line / NodesPerAxis;
      const int        y          = line - z * NodesPerAxis;
      const int        lineNode   = (timeNode * CellLayout::NodesPerAxisIn3D + z) * NodesPerAxis + y;
      const int        lineOffset = lineNode * NodesPerAxis * NodeStride;
      ComputePrecision lineUpdate[NodesPerAxis * NodeStride];
      exahype2::dg::differentiateAlongAxis<
        NodeStride,
        NodesPerAxis,
        NodeStride,
        NodesPerAxis,
        NodeStride,
        true,
        ComputePrecision,
        ComputePrecision
      >(lineUpdate,
        flux + (lineOffset - timeSliceOffset),
        stiffnessOperatorTransposed,
        -cellQuadratureWeights[lineNode],
        timeStepByCellSize);
      for (int node = 0; node < NodesPerAxis; node++) {
        SIMD()
        for (int entry = 0; entry < NodeStride; entry++) {
          rightHandSide[lineOffset + node * NodeStride + entry] += lineUpdate[node * NodeStride + entry];
        }
      }
    }
  } else if (axis == 1) {
    for (int line = workers.thread; line < LinesPerAxis; line += workers.threads) {
      const int z        = line / NodesPerAxis;
      const int x        = line - z * NodesPerAxis;
      const int lineNode = (timeNode * CellLayout::NodesPerAxisIn3D + z) * NodesPerAxis + x;
      const int lineOffset =
        ((timeNode * CellLayout::NodesPerAxisIn3D + z) * NodesPerAxis * NodesPerAxis + x) * NodeStride;
      ComputePrecision lineUpdate[NodesPerAxis * NodeStride];
      exahype2::dg::differentiateAlongAxis<
        NodeStride,
        NodesPerAxis,
        NodeStride * NodesPerAxis,
        NodesPerAxis,
        NodeStride,
        true,
        ComputePrecision,
        ComputePrecision
      >(lineUpdate,
        flux + (lineOffset - timeSliceOffset) + FluxAxisStride,
        stiffnessOperatorTransposed,
        -cellQuadratureWeights[lineNode],
        timeStepByCellSize);
      for (int node = 0; node < NodesPerAxis; node++) {
        SIMD()
        for (int entry = 0; entry < NodeStride; entry++) {
          rightHandSide[lineOffset + node * NodeStride * NodesPerAxis + entry] += lineUpdate[node * NodeStride + entry];
        }
      }
    }
  } else if constexpr (DIMENSIONS == 3) {
    for (int line = workers.thread; line < NodesPerAxis * NodesPerAxis; line += workers.threads) {
      const int        y          = line / NodesPerAxis;
      const int        x          = line - y * NodesPerAxis;
      const int        lineNode   = (timeNode * CellLayout::NodesPerAxisIn3D + y) * NodesPerAxis + x;
      const int        lineOffset = ((timeNode * NodesPerAxis * NodesPerAxis + y) * NodesPerAxis + x) * NodeStride;
      ComputePrecision lineUpdate[NodesPerAxis * NodeStride];
      exahype2::dg::differentiateAlongAxis<
        NodeStride,
        NodesPerAxis,
        NodeStride * NodesPerAxis * NodesPerAxis,
        NodesPerAxis,
        NodeStride,
        true,
        ComputePrecision,
        ComputePrecision
      >(lineUpdate,
        flux + (lineOffset - timeSliceOffset) + 2 * FluxAxisStride,
        stiffnessOperatorTransposed,
        -cellQuadratureWeights[lineNode],
        timeStepByCellSize);
      for (int node = 0; node < NodesPerAxis; node++) {
        SIMD()
        for (int entry = 0; entry < NodeStride; entry++) {
          rightHandSide[lineOffset + node * NodeStride * NodesPerAxis * NodesPerAxis + entry] +=
            lineUpdate[node * NodeStride + entry];
        }
      }
    }
  }
}

/**
 * Adds the space-time quadrature of the source of one time slice to the right-hand side. Averages
 * the source over time like averageFluxOverTime(). The source of a node is the algebraic source
 * plus the diffusive source minus the nonconservative product.
 */
template <typename Derived, typename ComputePrecision>
INLINE_METHOD GPU_CALLABLE_METHOD void
exahype2::dg::ader::NonlinearPredictor<Derived, ComputePrecision>::evaluateSpaceTimeSource(
  ComputePrecision* NOALIAS const                        rightHandSide,
  ComputePrecision* NOALIAS const                        firstSource,
  ComputePrecision* NOALIAS const                        timeAveragedSource,
  const ComputePrecision* NOALIAS const                  spaceTimeState,
  [[maybe_unused]] const ComputePrecision* NOALIAS const stateGradient,
  const ComputePrecision* NOALIAS const                  quadraturePoints,
  const ComputePrecision* NOALIAS const                  quadratureWeights,
  const ComputePrecision* NOALIAS const                  cellQuadratureWeights,
  const tarch::la::Vector<DIMENSIONS, double>&           cellCentre,
  const tarch::la::Vector<DIMENSIONS, double>&           cellSize,
  const double                                           timeStamp,
  const double                                           timeStepSize,
  const int                                              timeNode,
  const TeamWorkers&                                     workers
) {
  static_assert(
    AccumulatesSource,
    "The source of the predictor expects a source term, a diffusive source term or a nonconservative product."
  );

  constexpr int NodesPerAxis       = CellLayout::NodesPerAxis;
  constexpr int NumberOfUnknowns   = CellLayout::NumberOfUnknowns;
  constexpr int SourceStride       = CellLayout::PaddedNumberOfUnknowns;
  constexpr int GradientAxisStride = SourceStride * CellLayout::NodesPerCell;

  using TimePrecision = std::common_type_t<ComputePrecision, double>;

  assertion(timeNode >= 0 and timeNode < NodesPerAxis, timeNode);

  const auto timePosition = static_cast<double>(
    static_cast<TimePrecision>(timeStamp)
    + static_cast<TimePrecision>(quadraturePoints[timeNode]) * static_cast<TimePrecision>(timeStepSize)
  );

  [[maybe_unused]] ComputePrecision productValues[NumberOfUnknowns] __attribute__((aligned(PEANO_WITH_ALIGNMENT)));
  [[maybe_unused]] ComputePrecision diffusiveSourceValues[NumberOfUnknowns]
    __attribute__((aligned(PEANO_WITH_ALIGNMENT)));
  [[maybe_unused]] ComputePrecision nodeGradient[EvaluateDiffusiveSource ? NumberOfUnknowns * DIMENSIONS : 1]
    __attribute__((aligned(PEANO_WITH_ALIGNMENT)));
  ComputePrecision localSource[SourceStride] __attribute__((aligned(PEANO_WITH_ALIGNMENT)));

  const ComputePrecision weight = quadratureWeights[timeNode];

  for (int cellNode = workers.thread; cellNode < CellLayout::NodesPerCell; cellNode += workers.threads) {
    const int spaceTimeNode = timeNode * CellLayout::NodesPerCell + cellNode;
    for (int unknown = 0; unknown < SourceStride; unknown++) {
      localSource[unknown] = static_cast<ComputePrecision>(0);
    }

    const auto nodePosition = exahype2::dg::getQuadraturePoint(
      cellCentre,
      cellSize,
      peano4::dDelinearised(cellNode, NodesPerAxis),
      quadraturePoints
    );
    const ComputePrecision* NOALIAS const nodeState = spaceTimeState + spaceTimeNode * CellLayout::PaddedNumberOfData;

    if constexpr (EvaluateDiffusiveSource) {
      for (int axis = 0; axis < DIMENSIONS; axis++) {
        for (int unknown = 0; unknown < NumberOfUnknowns; unknown++) {
          nodeGradient[axis * NumberOfUnknowns + unknown] =
            stateGradient[SourceStride * cellNode + axis * GradientAxisStride + unknown];
        }
      }
    }

    if constexpr (EvaluateSource) {
      Derived::sourceTerm(nodeState, nodePosition, cellSize, timePosition, timeStepSize, localSource);
    }

    if constexpr (EvaluateDiffusiveSource and EvaluateSource) {
      for (int unknown = 0; unknown < NumberOfUnknowns; unknown++) {
        diffusiveSourceValues[unknown] = static_cast<ComputePrecision>(0);
      }
      Derived::diffusiveSourceTerm(
        nodeState,
        nodeGradient,
        nodePosition,
        cellSize,
        timePosition,
        timeStepSize,
        diffusiveSourceValues
      );
      SIMD(aligned(diffusiveSourceValues : PEANO_WITH_ALIGNMENT))
      for (int unknown = 0; unknown < NumberOfUnknowns; unknown++) {
        localSource[unknown] += diffusiveSourceValues[unknown];
      }
    } else if constexpr (EvaluateDiffusiveSource) {
      Derived::diffusiveSourceTerm(
        nodeState,
        nodeGradient,
        nodePosition,
        cellSize,
        timePosition,
        timeStepSize,
        localSource
      );
    }

    if constexpr (EvaluateNonconservativeProduct) {
      // The products of all axes add up before localSource subtracts them. Mirror-image cells then
      // receive mirrored sources.
      ComputePrecision axisProducts[NumberOfUnknowns] __attribute__((aligned(PEANO_WITH_ALIGNMENT)));
      SIMD(aligned(axisProducts : PEANO_WITH_ALIGNMENT))
      for (int unknown = 0; unknown < NumberOfUnknowns; unknown++) {
        axisProducts[unknown] = static_cast<ComputePrecision>(0);
      }
      UNROLL(DIMENSIONS)
      for (int axis = 0; axis < DIMENSIONS; axis++) {
        for (int unknown = 0; unknown < NumberOfUnknowns; unknown++) {
          productValues[unknown] = static_cast<ComputePrecision>(0);
        }
        Derived::nonconservativeProduct(
          nodeState,
          stateGradient + SourceStride * cellNode + axis * GradientAxisStride,
          nodePosition,
          cellSize,
          timePosition,
          timeStepSize,
          axis,
          productValues
        );
        SIMD(aligned(productValues, axisProducts : PEANO_WITH_ALIGNMENT))
        for (int unknown = 0; unknown < NumberOfUnknowns; unknown++) {
          axisProducts[unknown] += productValues[unknown];
        }
      }
      SIMD(aligned(axisProducts : PEANO_WITH_ALIGNMENT))
      for (int unknown = 0; unknown < NumberOfUnknowns; unknown++) {
        localSource[unknown] -= axisProducts[unknown];
      }
    }

    const auto updateSize = static_cast<ComputePrecision>(
      static_cast<TimePrecision>(quadratureWeights[timeNode] * cellQuadratureWeights[cellNode])
      * static_cast<TimePrecision>(timeStepSize)
    );
    SIMD()
    for (int unknown = 0; unknown < NumberOfUnknowns; unknown++) {
      rightHandSide[unknown + spaceTimeNode * SourceStride] += updateSize * localSource[unknown];
    }

    ComputePrecision* NOALIAS const nodeFirstSource    = firstSource + cellNode * SourceStride;
    ComputePrecision* NOALIAS const nodeAveragedSource = timeAveragedSource + cellNode * SourceStride;
    if (timeNode == 0) {
      for (int unknown = 0; unknown < SourceStride; unknown++) {
        nodeFirstSource[unknown]    = localSource[unknown];
        nodeAveragedSource[unknown] = localSource[unknown];
      }
    }
    SIMD()
    for (int unknown = 0; unknown < SourceStride; unknown++) {
      nodeAveragedSource[unknown] += weight * (localSource[unknown] - nodeFirstSource[unknown]);
    }
  }
}

/**
 * Solves the time system of one Picard sweep and returns the squared distance between the new and
 * the previous iterate as an exact fixed-point sum. A zero right-hand side leaves the cell state bitwise
 * in every time node. A value that is not finite or lies outside the divergence bound returns a
 * diverged residual.
 */
template <typename Derived, typename ComputePrecision>
template <typename StoragePrecision>
INLINE_METHOD GPU_CALLABLE_METHOD exahype2::dg::ader::PicardResidual
exahype2::dg::ader::NonlinearPredictor<Derived, ComputePrecision>::solvePicardSystem(
  ComputePrecision* NOALIAS const       spaceTimeState,
  const ComputePrecision* NOALIAS const rightHandSide,
  const StoragePrecision* NOALIAS const cellState,
  const ComputePrecision* NOALIAS const inversePicardOperator,
  const ComputePrecision* NOALIAS const inverseCellQuadratureWeights,
  const double                          squaredTolerance,
  const TeamWorkers&                    workers
) {
  constexpr int    NodesPerAxis     = CellLayout::NodesPerAxis;
  constexpr int    NodeStride       = CellLayout::PaddedNumberOfUnknowns;
  constexpr auto   DivergenceBound  = static_cast<ComputePrecision>(1e20);
  constexpr double TwoToThe63       = 9223372036854775808.0;
  constexpr double TwoToTheMinus961 = 0x1p-961;
  assertion(squaredTolerance >= 0.0, squaredTolerance);

  // TwoToThe63 / squaredTolerance overflows for every squaredTolerance at or below 2^-961.
  const bool     representable = squaredTolerance > TwoToTheMinus961;
  const double   scale         = representable ? TwoToThe63 / squaredTolerance : 0.0;
  PicardResidual residual;

  ComputePrecision updatedTimeSlice[NodesPerAxis * NodeStride];

  for (int cellNode = workers.thread; cellNode < CellLayout::NodesPerCell; cellNode += workers.threads) {
    exahype2::dg::applyOperatorAlongAxis<
      NodeStride,
      NodesPerAxis,
      NodesPerAxis,
      NodeStride * CellLayout::NodesPerCell,
      NodesPerAxis,
      NodeStride,
      true,
      ComputePrecision,
      ComputePrecision
    >(updatedTimeSlice,
      rightHandSide + NodeStride * cellNode,
      inversePicardOperator,
      inverseCellQuadratureWeights[cellNode]);

    for (int timeNode = 0; timeNode < NodesPerAxis; timeNode++) {
      ComputePrecision* NOALIAS const stateNode =
        spaceTimeState + CellLayout::PaddedNumberOfData * (cellNode + CellLayout::NodesPerCell * timeNode);
      for (int unknown = 0; unknown < CellLayout::NumberOfUnknowns; unknown++) {
        const auto newValue = static_cast<ComputePrecision>(cellState[unknown + CellLayout::NumberOfData * cellNode])
          + updatedTimeSlice[unknown + NodeStride * timeNode];
        const auto previousValue = stateNode[unknown];
        if (
          not std::isfinite(newValue) or newValue < -DivergenceBound or newValue > DivergenceBound
          or not std::isfinite(previousValue) or previousValue < -DivergenceBound or previousValue > DivergenceBound
        ) {
          return PicardResidual{0, 0, true, true};
        }
        const double difference = static_cast<double>(newValue - previousValue);
        const double square     = difference * difference;
        if (square >= squaredTolerance or not representable) {
          residual.exceeds = residual.exceeds or square > 0.0;
        } else {
          residual.add(PicardResidual{0, static_cast<std::uint64_t>(square * scale), false});
        }
        stateNode[unknown] = newValue;
      }
    }
  }
  return residual;
}

/**
 * Overwrites the first time slice of spaceTimeState with the time average of the state. A state
 * that is constant in time returns its value bitwise.
 */
template <typename Derived, typename ComputePrecision>
INLINE_METHOD GPU_CALLABLE_METHOD void
exahype2::dg::ader::NonlinearPredictor<Derived, ComputePrecision>::averageStateOverTime(
  ComputePrecision* NOALIAS const       spaceTimeState,
  const ComputePrecision* NOALIAS const quadratureWeights,
  const TeamWorkers&                    workers
) {
  constexpr int StateStride = CellLayout::PaddedNumberOfData;

  for (int cellNode = workers.thread; cellNode < CellLayout::NodesPerCell; cellNode += workers.threads) {
    ComputePrecision stateAverage[StateStride];

    SIMD()
    for (int value = 0; value < StateStride; value++) {
      stateAverage[value] = spaceTimeState[cellNode * StateStride + value];
    }

    for (int timeNode = 0; timeNode < CellLayout::NodesPerAxis; timeNode++) {
      const int              spaceTimeNode = timeNode * CellLayout::NodesPerCell + cellNode;
      const ComputePrecision weight        = quadratureWeights[timeNode];
      SIMD()
      for (int value = 0; value < StateStride; value++) {
        stateAverage[value] += weight
          * (spaceTimeState[spaceTimeNode * StateStride + value] - spaceTimeState[cellNode * StateStride + value]);
      }
    }

    SIMD()
    for (int value = 0; value < StateStride; value++) {
      spaceTimeState[cellNode * StateStride + value] = stateAverage[value];
    }
  }
}
TARGET_DECLARE_END
