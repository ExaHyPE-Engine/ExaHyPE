TARGET_DECLARE
/**
 * Copies the cell state into every time slice of the space-time state and zeroes the padding lanes.
 */
template <
  int NumberOfDofsPerAxis,
  int NumberOfUnknowns,
  int NumberOfAuxiliaryVariables,
  typename StoragePrecision,
  typename ComputePrecision>
INLINE_METHOD GPU_CALLABLE_METHOD void exahype2::dg::ader::initialisePredictorState(
  ComputePrecision* NOALIAS const       spaceTimeState,
  const StoragePrecision* NOALIAS const cellState
) {
  using CellLayout        = Layout<NumberOfDofsPerAxis, NumberOfUnknowns, NumberOfAuxiliaryVariables>;
  constexpr int SliceSize = CellLayout::PaddedNumberOfData * CellLayout::NodesPerCell;

  for (int cellNode = 0; cellNode < CellLayout::NodesPerCell; cellNode++) {
    ComputePrecision* NOALIAS const localState = spaceTimeState + CellLayout::PaddedNumberOfData * cellNode;
    for (int value = CellLayout::NumberOfData; value < CellLayout::PaddedNumberOfData; value++) {
      localState[value] = static_cast<ComputePrecision>(0);
    }
    for (int value = 0; value < CellLayout::NumberOfData; value++) {
      localState[value] = static_cast<ComputePrecision>(cellState[CellLayout::NumberOfData * cellNode + value]);
    }
  }

  for (int timeNode = 1; timeNode < NumberOfDofsPerAxis; timeNode++) {
    for (int entry = 0; entry < SliceSize; entry++) {
      spaceTimeState[timeNode * SliceSize + entry] = spaceTimeState[entry];
    }
  }
}

/**
 * Writes the initial-value term of one time node into the right-hand side of the Picard system. The
 * temporal basis function at the start of the time step carries the cell state into the time node.
 */
template <
  int NumberOfDofsPerAxis,
  int NumberOfUnknowns,
  int NumberOfAuxiliaryVariables,
  typename StoragePrecision,
  typename ComputePrecision>
INLINE_METHOD GPU_CALLABLE_METHOD void exahype2::dg::ader::initialisePicardRightHandSide(
  ComputePrecision* NOALIAS const       rightHandSide,
  const StoragePrecision* NOALIAS const cellState,
  const ComputePrecision* NOALIAS const cellQuadratureWeights,
  const ComputePrecision* NOALIAS const leftFaceCoefficients,
  const int                             timeNode
) {
  using CellLayout          = Layout<NumberOfDofsPerAxis, NumberOfUnknowns, NumberOfAuxiliaryVariables>;
  using AccumulatePrecision = std::common_type_t<StoragePrecision, ComputePrecision>;

  assertion(timeNode >= 0 and timeNode < NumberOfDofsPerAxis, timeNode);

  for (int cellNode = 0; cellNode < CellLayout::NodesPerCell; cellNode++) {
    const ComputePrecision          weight = cellQuadratureWeights[cellNode] * leftFaceCoefficients[timeNode];
    ComputePrecision* NOALIAS const localRightHandSide =
      rightHandSide + CellLayout::PaddedNumberOfUnknowns * (cellNode + CellLayout::NodesPerCell * timeNode);
    for (int unknown = NumberOfUnknowns; unknown < CellLayout::PaddedNumberOfUnknowns; unknown++) {
      localRightHandSide[unknown] = static_cast<ComputePrecision>(0);
    }
    SIMD()
    for (int unknown = 0; unknown < NumberOfUnknowns; unknown++) {
      localRightHandSide[unknown] = static_cast<ComputePrecision>(
        static_cast<AccumulatePrecision>(weight)
        * static_cast<AccumulatePrecision>(cellState[unknown + CellLayout::NumberOfData * cellNode])
      );
    }
  }
}

/**
 * Subtracts the flux divergence of one time node, whose time slice the flux holds, from the
 * right-hand side of the Picard system. The stiffness operator carries the quadrature weight of its
 * own axis, so the scaling supplies the weights of time and of the other axes.
 */
template <int NumberOfDofsPerAxis, int NumberOfUnknowns, int NumberOfAuxiliaryVariables, typename ComputePrecision>
INLINE_METHOD GPU_CALLABLE_METHOD void exahype2::dg::ader::subtractFluxDivergence(
  ComputePrecision* NOALIAS const                        rightHandSide,
  const ComputePrecision* NOALIAS const                  flux,
  const ComputePrecision* NOALIAS const                  stiffnessOperatorTransposed,
  const ComputePrecision* NOALIAS const                  cellQuadratureWeights,
  const tarch::la::Vector<DIMENSIONS, ComputePrecision>& inverseCellSize,
  const double                                           timeStepSize,
  const int                                              timeNode
) {
  using CellLayout             = Layout<NumberOfDofsPerAxis, NumberOfUnknowns, NumberOfAuxiliaryVariables>;
  constexpr int NodeStride     = CellLayout::PaddedNumberOfUnknowns;
  constexpr int FluxAxisStride = CellLayout::NodesPerCell * NodeStride;

  assertion(timeNode >= 0 and timeNode < NumberOfDofsPerAxis, timeNode);

  ComputePrecision timeStepByCellSize[DIMENSIONS];
  UNROLL(DIMENSIONS)
  for (int axis = 0; axis < DIMENSIONS; axis++) {
    assertion(inverseCellSize(axis) > 0.0, inverseCellSize, axis);
    timeStepByCellSize[axis] = static_cast<ComputePrecision>(timeStepSize) * inverseCellSize(axis);
  }

  for (int z = 0; z < CellLayout::NodesPerAxisIn3D; z++) {
    for (int y = 0; y < NumberOfDofsPerAxis; y++) {
      const int lineNode   = (timeNode * CellLayout::NodesPerAxisIn3D + z) * NumberOfDofsPerAxis + y;
      const int lineOffset = lineNode * NumberOfDofsPerAxis * NodeStride;
      const int fluxOffset = (z * NumberOfDofsPerAxis + y) * NumberOfDofsPerAxis * NodeStride;
      exahype2::dg::applyOperatorAlongAxis<
        NodeStride,
        NumberOfDofsPerAxis,
        NumberOfDofsPerAxis,
        NodeStride,
        NumberOfDofsPerAxis,
        NodeStride,
        false,
        ComputePrecision,
        ComputePrecision>(
        rightHandSide + lineOffset,
        flux + fluxOffset,
        stiffnessOperatorTransposed,
        -cellQuadratureWeights[lineNode],
        timeStepByCellSize[0]
      );
    }
  }

  for (int z = 0; z < CellLayout::NodesPerAxisIn3D; z++) {
    for (int x = 0; x < NumberOfDofsPerAxis; x++) {
      const int lineNode = (timeNode * CellLayout::NodesPerAxisIn3D + z) * NumberOfDofsPerAxis + x;
      const int lineOffset =
        ((timeNode * CellLayout::NodesPerAxisIn3D + z) * NumberOfDofsPerAxis * NumberOfDofsPerAxis + x) * NodeStride;
      const int fluxOffset = (z * NumberOfDofsPerAxis * NumberOfDofsPerAxis + x) * NodeStride;
      exahype2::dg::applyOperatorAlongAxis<
        NodeStride,
        NumberOfDofsPerAxis,
        NumberOfDofsPerAxis,
        NodeStride * NumberOfDofsPerAxis,
        NumberOfDofsPerAxis,
        NodeStride * NumberOfDofsPerAxis,
        false,
        ComputePrecision,
        ComputePrecision>(
        rightHandSide + lineOffset,
        flux + fluxOffset + FluxAxisStride,
        stiffnessOperatorTransposed,
        -cellQuadratureWeights[lineNode],
        timeStepByCellSize[1]
      );
    }
  }

  if constexpr (DIMENSIONS == 3) {
    for (int y = 0; y < NumberOfDofsPerAxis; y++) {
      for (int x = 0; x < NumberOfDofsPerAxis; x++) {
        const int lineNode = (timeNode * CellLayout::NodesPerAxisIn3D + y) * NumberOfDofsPerAxis + x;
        const int lineOffset =
          ((timeNode * NumberOfDofsPerAxis * NumberOfDofsPerAxis + y) * NumberOfDofsPerAxis + x) * NodeStride;
        const int fluxOffset = (y * NumberOfDofsPerAxis + x) * NodeStride;
        exahype2::dg::applyOperatorAlongAxis<
          NodeStride,
          NumberOfDofsPerAxis,
          NumberOfDofsPerAxis,
          NodeStride * NumberOfDofsPerAxis * NumberOfDofsPerAxis,
          NumberOfDofsPerAxis,
          NodeStride * NumberOfDofsPerAxis * NumberOfDofsPerAxis,
          false,
          ComputePrecision,
          ComputePrecision>(
          rightHandSide + lineOffset,
          flux + fluxOffset + 2 * FluxAxisStride,
          stiffnessOperatorTransposed,
          -cellQuadratureWeights[lineNode],
          timeStepByCellSize[DIMENSIONS - 1]
        );
      }
    }
  }
}

/**
 * Solves the temporal system of one Picard sweep and returns the squared distance between the new
 * and the previous iterate. A value outside the divergence bound or a value that is not a number
 * returns an infinite distance, so the caller stops before a difference overflows.
 */
template <int NumberOfDofsPerAxis, int NumberOfUnknowns, int NumberOfAuxiliaryVariables, typename ComputePrecision>
INLINE_METHOD GPU_CALLABLE_METHOD double exahype2::dg::ader::solvePicardSystem(
  ComputePrecision* NOALIAS const       spaceTimeState,
  ComputePrecision* NOALIAS const       updatedTimeSlice,
  const ComputePrecision* NOALIAS const rightHandSide,
  const ComputePrecision* NOALIAS const inversePicardOperator,
  const ComputePrecision* NOALIAS const inverseCellQuadratureWeights
) {
  using CellLayout               = Layout<NumberOfDofsPerAxis, NumberOfUnknowns, NumberOfAuxiliaryVariables>;
  constexpr int  NodeStride      = CellLayout::PaddedNumberOfUnknowns;
  constexpr auto DivergenceBound = static_cast<ComputePrecision>(1e20);

  double squaredResidual = 0.0;

  for (int cellNode = 0; cellNode < CellLayout::NodesPerCell; cellNode++) {
    exahype2::dg::applyOperatorAlongAxis<
      NodeStride,
      NumberOfDofsPerAxis,
      NumberOfDofsPerAxis,
      NodeStride * CellLayout::NodesPerCell,
      NumberOfDofsPerAxis,
      NodeStride,
      true,
      ComputePrecision,
      ComputePrecision>(
      updatedTimeSlice,
      rightHandSide + NodeStride * cellNode,
      inversePicardOperator,
      inverseCellQuadratureWeights[cellNode]
    );

    for (int timeNode = 0; timeNode < NumberOfDofsPerAxis; timeNode++) {
      ComputePrecision* NOALIAS const stateNode =
        spaceTimeState + CellLayout::PaddedNumberOfData * (cellNode + CellLayout::NodesPerCell * timeNode);
      for (int unknown = 0; unknown < NumberOfUnknowns; unknown++) {
        const auto newValue      = updatedTimeSlice[unknown + NodeStride * timeNode];
        const auto previousValue = stateNode[unknown];
        if (
          not std::isfinite(newValue) or newValue < -DivergenceBound or newValue > DivergenceBound
          or not std::isfinite(previousValue) or previousValue < -DivergenceBound or previousValue > DivergenceBound
        ) {
          return std::numeric_limits<double>::infinity();
        }
        const double difference = static_cast<double>(newValue) - static_cast<double>(previousValue);
        squaredResidual += difference * difference;
        stateNode[unknown] = newValue;
      }
    }
  }

  return squaredResidual;
}
TARGET_DECLARE_END
