#include "exahype2/terms/CellPredicate.h"
#include "exahype2/terms/PointSourceLocations.h"
#include "tarch/Assertions.h"
#include "tarch/Termination.h"
#include "tarch/accelerator/ParallelFor.h"
#include "tarch/accelerator/ParallelReduce.h"
#include "tarch/accelerator/Range.h"
#include "tarch/accelerator/Reducer.h"
#include "tarch/accelerator/Scratch.h"
#include "tarch/instrumentation/Warning.h"
#include "tarch/la/Vector.h"
#include "tarch/mpi/Rank.h"
#include "tarch/mpi/ReductionRecord.h"

/**
 * Returns the CFL factor of the ADER-DG scheme of the given polynomial order. The factors up to
 * order 4 stem from the von Neumann analysis of Dumbser, Balsara, Toro and Munz (2008).
 */
INLINE_METHOD constexpr double
exahype2::dg::ader::getCFLFactor(const int order) {
  constexpr double Factors[] = {
    1.0,
    0.33,
    0.17,
    0.1,
    0.069,
    0.045,
    0.038,
    0.03,
    0.02,
    0.015,
    0.008821428571428572,
    0.005235326086956522,
    0.0031307249999999996,
    0.0018842326388888888,
    0.001140285614224138,
    0.0006933672202620968
  };
  return Factors[order];
}

template <typename Derived, typename StoragePrecision, typename ComputePrecision, typename Limiter>
INLINE_METHOD exahype2::dg::ader::Solver<Derived, StoragePrecision, ComputePrecision, Limiter>::Solver(
  const double                                     timeStepFactor,
  const std::string&                               name,
  const std::vector<exahype2::plotter::DataField>& plottedFields
) :
  Base(timeStepFactor, name, plottedFields) {
  static_assert(not HasLimiter, "The solver with a limiter expects the relaxation parameters of the limiter.");
  static_assert(
    Derived::DGOrder >= 0 and Derived::DGOrder < 16,
    "The ADER-DG solver supports the orders 0 to 15 only."
  );
}

/**
 * relaxationParameter and differencesScaling widen the range of the discrete maximum
 * principle of the limiter.
 */
template <typename Derived, typename StoragePrecision, typename ComputePrecision, typename Limiter>
INLINE_METHOD exahype2::dg::ader::Solver<Derived, StoragePrecision, ComputePrecision, Limiter>::Solver(
  const double                                     timeStepFactor,
  const std::string&                               name,
  const std::vector<exahype2::plotter::DataField>& plottedFields,
  const double                                     relaxationParameter,
  const double                                     differencesScaling
) :
  Base(timeStepFactor, name, plottedFields),
  _limiter(std::in_place, relaxationParameter, differencesScaling) {
  static_assert(HasLimiter, "Only a solver with a limiter takes relaxation parameters.");
  static_assert(
    Derived::DGOrder >= 0 and Derived::DGOrder < 16,
    "The ADER-DG solver supports the orders 0 to 15 only."
  );
}

template <typename Derived, typename StoragePrecision, typename ComputePrecision, typename Limiter>
INLINE_METHOD void
exahype2::dg::ader::Solver<Derived, StoragePrecision, ComputePrecision, Limiter>::allocate(
  const peano4::CellConnectivity& cellConnectivity
) {
  Base::allocate(cellConnectivity);
  if constexpr (HasLimiter) {
    _limiter->allocate(cellConnectivity);
  }
  rebuildCouplingFaces(cellConnectivity);
  reservePredictorScratch(cellConnectivity);
}

template <typename Derived, typename StoragePrecision, typename ComputePrecision, typename Limiter>
INLINE_METHOD void
exahype2::dg::ader::Solver<Derived, StoragePrecision, ComputePrecision, Limiter>::reservePredictorScratch(
  const peano4::CellConnectivity& cellConnectivity
) {
  const auto chunks =
    static_cast<std::size_t>(Predictor::getNumberOfScratchChunks(this->getNumberOfCells(cellConnectivity)));
  if (_predictorScratch.getSize() < chunks * Predictor::ScratchSize) {
    _predictorScratch.allocate(chunks * Predictor::ScratchSize);
  }
}

template <typename Derived, typename StoragePrecision, typename ComputePrecision, typename Limiter>
INLINE_METHOD void
exahype2::dg::ader::Solver<Derived, StoragePrecision, ComputePrecision, Limiter>::release() {
  Base::release();
  _pointSourceLocations.release();
  _predictorScratch.release();
  _couplingFaces.release();
  _couplingMatrix.release();
  _numberOfCouplingFaces = 0;
  if constexpr (HasLimiter) {
    _limiter->release();
  }
}

template <typename Derived, typename StoragePrecision, typename ComputePrecision, typename Limiter>
INLINE_METHOD tarch::AllocatedBytes
exahype2::dg::ader::Solver<Derived, StoragePrecision, ComputePrecision, Limiter>::getAllocatedBytes() const {
  auto result = Base::getAllocatedBytes() + _pointSourceLocations.getAllocatedBytes()
    + _couplingFaces.getAllocatedBytes() + _couplingMatrix.getAllocatedBytes() + _predictorScratch.getAllocatedBytes();
  if constexpr (HasLimiter) {
    result += _limiter->getAllocatedBytes();
  }
  return result;
}

/**
 * Writes the initial condition into every cell and, with a limiter, into every subgrid.
 * initPointSourceLocations() runs after the initial condition.
 */
template <typename Derived, typename StoragePrecision, typename ComputePrecision, typename Limiter>
INLINE_METHOD void
exahype2::dg::ader::Solver<Derived, StoragePrecision, ComputePrecision, Limiter>::initialise(
  const peano4::CellConnectivity& cellConnectivity,
  exahype2::RefinementRequests&   requests
) {
  Base::initialise(cellConnectivity, requests);
  if constexpr (Derived::NumberOfPointSources > 0) {
    static_assert(
      exahype2::terms::HasPointSourceLocations<Derived, Derived::NumberOfPointSources>,
      "The point sources of the solver expect their locations."
    );
    double locations[Derived::NumberOfPointSources][DIMENSIONS];
    Derived::initPointSourceLocations(locations);
    _pointSourceLocations.setValues(
      std::vector<double>(
        &locations[0][0],
        &locations[0][0] + static_cast<std::size_t>(Derived::NumberOfPointSources) * DIMENSIONS
      )
    );
  }
  if constexpr (HasLimiter) {
    _limiter->initialise(cellConnectivity, this->_solution);
  }
}

/**
 * Advances every cell by the time step size that the previous time step proposed. The ranks
 * exchange the face halves while the local cells predict and the restricted fluxes while the local
 * cells correct. A solver with a coupling partner runs the time steps of both solvers.
 */
template <typename Derived, typename StoragePrecision, typename ComputePrecision, typename Limiter>
INLINE_METHOD void
exahype2::dg::ader::Solver<Derived, StoragePrecision, ComputePrecision, Limiter>::performTimeStep(
  const peano4::CellConnectivity& cellConnectivity,
  exahype2::RefinementRequests&   requests
) {
  if (_drivenByPartner) {
    return;
  }
  if (_coupledTimeStep) {
    _coupledTimeStep(cellConnectivity, requests);
    return;
  }
  constexpr auto Local        = peano4::Adjacency::Local;
  constexpr auto Remote       = peano4::Adjacency::Remote;
  const double   timeStepSize = this->_timeStepping.startTimeStep();
  const double   timeStamp    = this->_timeStepping.getTimeStamp();

  if constexpr (HasLimiter) {
    _limiter->openTimeStep(cellConnectivity, this->_solution);
  }
  predict(cellConnectivity, Remote, timeStepSize);

  const typename Base::RestrictFluxes restrictFluxes{
    cellConnectivity.onDevice(),
    this->_faceFluxes.getView(),
    DGMatrices<double>::WeightedRestrictionMatrix1D
  };
  this->_stateExchange.post();
  if constexpr (Predictor::WritesFaceFluxes) {
    this->_fluxExchange.post();
  }
  predict(cellConnectivity, Local, timeStepSize);
  interpolatePredictedHalves(cellConnectivity, Local);
  this->solveRiemannProblems(cellConnectivity, Local, timeStamp, timeStepSize, getAppliedFluxes());
  this->_stateExchange.wait();
  if constexpr (Predictor::WritesFaceFluxes) {
    this->_fluxExchange.wait();
  }
  interpolatePredictedHalves(cellConnectivity, Remote);
  this->solveRiemannProblems(cellConnectivity, Remote, timeStamp, timeStepSize, getAppliedFluxes());

  this->restrictFineFaces(cellConnectivity, Remote, restrictFluxes);
  this->_restrictedFluxExchange.post();
  this->restrictFineFaces(cellConnectivity, Local, restrictFluxes);
  auto statistics = correct(cellConnectivity, Local, timeStepSize);
  this->_restrictedFluxExchange.wait();
  statistics =
    exahype2::dg::MaxEigenvalueStatistics::combine(statistics, correct(cellConnectivity, Remote, timeStepSize));
  if constexpr (HasLimiter) {
    statistics = _limiter->closeTimeStep(cellConnectivity, this->_solution, timeStamp, timeStepSize);
  }
  this->closeTimeStep(timeStepSize, statistics);
  this->measureError(cellConnectivity);
  this->voteOnRefinement(cellConnectivity, requests);
}

/**
 * Returns the number of cells on all ranks that the limiter marked as troubled in the time step of
 * the last adopted reduction, or zero without a limiter.
 */
template <typename Derived, typename StoragePrecision, typename ComputePrecision, typename Limiter>
INLINE_METHOD int
exahype2::dg::ader::Solver<Derived, StoragePrecision, ComputePrecision, Limiter>::getNumberOfTroubledCells() const {
  if constexpr (HasLimiter) {
    return _limiter->getGlobalNumberOfTroubledCells();
  } else {
    return 0;
  }
}

/**
 * Couples this solver with partner across the faces between their cells. Every time step of this
 * solver then advances both solvers with the smaller time step size. fromPartnerMatrix and
 * toPartnerMatrix store the input node as the major index.
 */
template <typename Derived, typename StoragePrecision, typename ComputePrecision, typename Limiter>
template <typename Partner>
INLINE_METHOD void
exahype2::dg::ader::Solver<Derived, StoragePrecision, ComputePrecision, Limiter>::coupleWith(
  Partner&                   partner,
  const std::vector<double>& fromPartnerMatrix,
  const std::vector<double>& toPartnerMatrix
) {
  static_assert(
    exahype2::terms::HasCellPredicate<Derived> and exahype2::terms::HasCellPredicate<typename Partner::DerivedType>,
    "Each coupled solver expects its cells through restrict_to_cells."
  );
  static_assert(Partner::NumberOfData == NumberOfData, "Coupled solvers store the same number of values per node.");
  assertion(not _drivenByPartner and not _coupledTimeStep);
  setCouplingMatrix(fromPartnerMatrix);
  partner.setCouplingMatrix(toPartnerMatrix);
  partner.leaveTimeStepsToPartner();
  _coupledTimeStep =
    [this, &partner](const peano4::CellConnectivity& cellConnectivity, exahype2::RefinementRequests& requests) {
      constexpr auto Local      = peano4::Adjacency::Local;
      constexpr auto Remote     = peano4::Adjacency::Remote;
      const double timeStepSize = std::min(this->_timeStepping.startTimeStep(), partner._timeStepping.startTimeStep());
      const double timeStamp    = this->_timeStepping.getTimeStamp();

      if constexpr (HasLimiter) {
        _limiter->openTimeStep(cellConnectivity, this->_solution);
      }
      if constexpr (Partner::HasLimiter) {
        partner._limiter->openTimeStep(cellConnectivity, partner._solution);
      }
      predict(cellConnectivity, Remote, timeStepSize);
      partner.predict(cellConnectivity, Remote, timeStepSize);

      const typename Base::RestrictFluxes restrictFluxes{
        cellConnectivity.onDevice(),
        this->_faceFluxes.getView(),
        DGMatrices<double>::WeightedRestrictionMatrix1D
      };
      const typename Partner::RestrictFluxes restrictPartnerFluxes{
        cellConnectivity.onDevice(),
        partner._faceFluxes.getView(),
        Partner::template DGMatrices<double>::WeightedRestrictionMatrix1D
      };
      const double partnerTimeStamp = partner.getTimeStepping().getTimeStamp();

      this->_stateExchange.post();
      this->_fluxExchange.post();
      partner._stateExchange.post();
      partner._fluxExchange.post();
      predict(cellConnectivity, Local, timeStepSize);
      partner.predict(cellConnectivity, Local, timeStepSize);
      interpolatePredictedHalves(cellConnectivity, Local);
      partner.interpolatePredictedHalves(cellConnectivity, Local);
      copyFaceHalvesFromPartner(cellConnectivity, partner, Local);
      partner.copyFaceHalvesFromPartner(cellConnectivity, *this, Local);
      this->solveRiemannProblems(cellConnectivity, Local, timeStamp, timeStepSize, getAppliedFluxes());
      partner.solveRiemannProblems(cellConnectivity, Local, partnerTimeStamp, timeStepSize, partner.getAppliedFluxes());
      this->_stateExchange.wait();
      this->_fluxExchange.wait();
      partner._stateExchange.wait();
      partner._fluxExchange.wait();
      interpolatePredictedHalves(cellConnectivity, Remote);
      partner.interpolatePredictedHalves(cellConnectivity, Remote);
      copyFaceHalvesFromPartner(cellConnectivity, partner, Remote);
      partner.copyFaceHalvesFromPartner(cellConnectivity, *this, Remote);
      this->solveRiemannProblems(cellConnectivity, Remote, timeStamp, timeStepSize, getAppliedFluxes());
      partner.solveRiemannProblems(cellConnectivity, Remote, partnerTimeStamp, timeStepSize, partner.getAppliedFluxes());

      this->restrictFineFaces(cellConnectivity, Remote, restrictFluxes);
      partner.restrictFineFaces(cellConnectivity, Remote, restrictPartnerFluxes);
      this->_restrictedFluxExchange.post();
      partner._restrictedFluxExchange.post();
      this->restrictFineFaces(cellConnectivity, Local, restrictFluxes);
      partner.restrictFineFaces(cellConnectivity, Local, restrictPartnerFluxes);
      auto statistics        = correct(cellConnectivity, Local, timeStepSize);
      auto partnerStatistics = partner.correct(cellConnectivity, Local, timeStepSize);
      this->_restrictedFluxExchange.wait();
      partner._restrictedFluxExchange.wait();
      statistics =
        exahype2::dg::MaxEigenvalueStatistics::combine(statistics, correct(cellConnectivity, Remote, timeStepSize));
      partnerStatistics = exahype2::dg::MaxEigenvalueStatistics::combine(
        partnerStatistics,
        partner.correct(cellConnectivity, Remote, timeStepSize)
      );
      if constexpr (HasLimiter) {
        statistics = _limiter->closeTimeStep(cellConnectivity, this->_solution, timeStamp, timeStepSize);
      }
      if constexpr (Partner::HasLimiter) {
        partnerStatistics = partner._limiter->closeTimeStep(
          cellConnectivity,
          partner._solution,
          partner.getTimeStepping().getTimeStamp(),
          timeStepSize
        );
      }
      this->closeTimeStep(timeStepSize, statistics);
      partner.closeTimeStep(timeStepSize, partnerStatistics);
      if constexpr (requires { partner.traceTracers(cellConnectivity, timeStepSize, false); }) {
        partner.traceTracers(cellConnectivity, timeStepSize, false);
      }
      this->measureError(cellConnectivity);
      partner.measureError(cellConnectivity);
      this->voteOnRefinement(cellConnectivity, requests);
      partner.voteOnRefinement(cellConnectivity, requests);
    };
}

/**
 * Stores the matrix that maps the partner's face nodes onto this solver's face nodes.
 */
template <typename Derived, typename StoragePrecision, typename ComputePrecision, typename Limiter>
INLINE_METHOD void
exahype2::dg::ader::Solver<Derived, StoragePrecision, ComputePrecision, Limiter>::setCouplingMatrix(
  const std::vector<double>& fromPartnerMatrix
) {
  assertion(fromPartnerMatrix.size() % static_cast<std::size_t>(NodesPerAxis) == 0, fromPartnerMatrix.size());
  std::vector<ComputePrecision> matrix(fromPartnerMatrix.size());
  for (std::size_t entry = 0; entry < matrix.size(); entry++) {
    matrix[entry] = static_cast<ComputePrecision>(fromPartnerMatrix[entry]);
  }
  _couplingMatrix.setValues(matrix);
}

template <typename Derived, typename StoragePrecision, typename ComputePrecision, typename Limiter>
INLINE_METHOD void
exahype2::dg::ader::Solver<Derived, StoragePrecision, ComputePrecision, Limiter>::leaveTimeStepsToPartner() {
  assertion(not _coupledTimeStep);
  _drivenByPartner = true;
}

/**
 * Copies the partner's face states and fluxes on the local or the remote coupling faces into the
 * partner's halves in this solver's pools.
 */
template <typename Derived, typename StoragePrecision, typename ComputePrecision, typename Limiter>
template <typename Partner>
INLINE_METHOD void
exahype2::dg::ader::Solver<Derived, StoragePrecision, ComputePrecision, Limiter>::copyFaceHalvesFromPartner(
  [[maybe_unused]] const peano4::CellConnectivity& cellConnectivity,
  const Partner&                                   partner,
  const peano4::Adjacency                          adjacency
) {
  assertion(
    _couplingMatrix.getSize() == static_cast<std::size_t>(Partner::NodesPerAxis * NodesPerAxis),
    _couplingMatrix.getSize()
  );
  assertion(
    cellConnectivity.getNumberOfFaces() <= partner.getFaceStates().getCapacity(),
    cellConnectivity.getNumberOfFaces()
  );
  using PartnerPrecision   = typename Partner::StatePool::ValueType;
  const bool local         = adjacency == peano4::Adjacency::Local;
  const int  firstFace     = local ? 0 : _numberOfLocalCouplingFaces;
  const int  numberOfFaces = local ? _numberOfLocalCouplingFaces : _numberOfCouplingFaces - _numberOfLocalCouplingFaces;
  tarch::accelerator::parallelFor(
    tarch::accelerator::Range(numberOfFaces),
    exahype2::dg::CopyPartnerFaceHalves<Derived, typename Partner::DerivedType, PartnerPrecision, ComputePrecision>{
      _couplingFaces.getData() + 2 * static_cast<std::ptrdiff_t>(firstFace),
      partner.getFaceStates().getView(),
      partner.getFaceFluxes().getView(),
      this->_faceStates.getView(),
      this->_faceFluxes.getView(),
      _couplingMatrix.getData()
    }
  );
}

/**
 * Lists every interior face between a cell this solver owns and a cell it does not own, the local
 * faces first. The far cell of an exchanged face is the owned cell mirrored across the face. A
 * coupling face on a level jump is a fatal error.
 */
template <typename Derived, typename StoragePrecision, typename ComputePrecision, typename Limiter>
INLINE_METHOD void
exahype2::dg::ader::Solver<Derived, StoragePrecision, ComputePrecision, Limiter>::rebuildCouplingFaces(
  [[maybe_unused]] const peano4::CellConnectivity& cellConnectivity
) {
  if constexpr (exahype2::terms::HasCellPredicate<Derived>) {
    std::vector<int> couplingFaces;
    for (const auto adjacency : {peano4::Adjacency::Local, peano4::Adjacency::Remote}) {
      for (const int face :
           cellConnectivity.getFaces(adjacency, peano4::FaceKind::Interior, peano4::FaceKind::Intermediate)) {
        const auto kind = cellConnectivity.getFaceKind(face);
        if (kind == peano4::FaceKind::Boundary) {
          continue;
        }
        int ownedSide = -1;
        int farSide   = -1;
        for (int side = 0; side < 2; side++) {
          const int slot = cellConnectivity.getFaceCell(face, side);
          if (slot < 0) {
            continue;
          }
          if (Derived::ownsCell(cellConnectivity.getCellCentre(slot), cellConnectivity.getCellWidth(slot))) {
            ownedSide = side;
          } else {
            farSide = side;
          }
        }
        if (ownedSide < 0 or (farSide < 0 and cellConnectivity.getFaceCell(face, 1 - ownedSide) >= 0)) {
          continue;
        }
        if (farSide < 0) {
          const tarch::la::Vector<DIMENSIONS, double> centre =
            cellConnectivity.getCellCentreBesideFace(face, 1 - ownedSide);
          if (Derived::ownsCell(centre, cellConnectivity.getFaceWidth(face))) {
            continue;
          }
        }
        if (kind != peano4::FaceKind::Interior) {
          tarch::terminateWithError(
            "The coupling face " + toString(cellConnectivity.getFaceLattice(face)) + " on level "
            + std::to_string(cellConnectivity.getFaceLevel(face)) + " must lie away from level jumps."
          );
        }
        couplingFaces.push_back(face);
        couplingFaces.push_back(ownedSide);
      }
      if (adjacency == peano4::Adjacency::Local) {
        _numberOfLocalCouplingFaces = static_cast<int>(couplingFaces.size() / 2);
      }
    }
    _numberOfCouplingFaces = static_cast<int>(couplingFaces.size() / 2);
    _couplingFaces.setValues(couplingFaces);
  }
}

/**
 * Moves the solution and, with a limiter, the statuses and the subgrids through the regrid.
 */
template <typename Derived, typename StoragePrecision, typename ComputePrecision, typename Limiter>
INLINE_METHOD void
exahype2::dg::ader::Solver<Derived, StoragePrecision, ComputePrecision, Limiter>::regrid(
  const peano4::CellConnectivity& cellConnectivity,
  const peano4::Regrid&           regrid,
  exahype2::RefinementRequests&   requests
) {
  if constexpr (HasLimiter) {
    _limiter->regrid(cellConnectivity, regrid, this->_solution);
  }
  Base::regrid(cellConnectivity, regrid, requests);
  rebuildCouplingFaces(cellConnectivity);
  reservePredictorScratch(cellConnectivity);
}

/**
 * Writes one snapshot. With a limiter, every plot cell stores its status. A limited cell plots at
 * every plot point the subcell that contains the point.
 */
template <typename Derived, typename StoragePrecision, typename ComputePrecision, typename Limiter>
INLINE_METHOD void
exahype2::dg::ader::Solver<Derived, StoragePrecision, ComputePrecision, Limiter>::plot(
  const peano4::CellConnectivity& cellConnectivity,
  const tarch::plotter::Format    format,
  const std::string&              outputDirectory
) {
  if constexpr (HasLimiter) {
    this->template plotPolynomial<std::max(2 * NodesPerAxis - 1, 2), Limiter::SubcellScheme::SubcellsPerAxis>(
      cellConnectivity,
      DGMatrices<double>::getPlotMatrix1D().data(),
      format,
      outputDirectory,
      &_limiter->downloadSubcells(),
      &_limiter->downloadStatuses(),
      static_cast<int>(exahype2::dg::limiting::LimiterStatus::Limited),
      exahype2::dg::limiting::LimiterStatusFieldName
    );
    this->plotFaces(cellConnectivity, format, outputDirectory);
  } else {
    Base::plot(cellConnectivity, format, outputDirectory);
  }
}

/**
 * Returns the time step size of the CFL condition of the ADER-DG scheme on the scaled wave speed.
 */
template <typename Derived, typename StoragePrecision, typename ComputePrecision, typename Limiter>
INLINE_METHOD double
exahype2::dg::ader::Solver<Derived, StoragePrecision, ComputePrecision, Limiter>::getTimeStepSizeFromCFL() const {
  if constexpr (UsesAdaptiveTimeStepping) {
    return this->_timeStepping.getFactor() * PNPM / this->_timeStepping.getMaxScaledEigenvalueOfThisStep();
  } else {
    return 0.0;
  }
}

/**
 * Returns the normalised fraction of the admissible mesh width a fixed rule advances by.
 */
template <typename Derived, typename StoragePrecision, typename ComputePrecision, typename Limiter>
INLINE_METHOD double
exahype2::dg::ader::Solver<Derived, StoragePrecision, ComputePrecision, Limiter>::getFixedTimeStepSize() const {
  const double maxAdmissibleMeshWidth = this->_timeStepping.getLimits().maxAdmissibleMeshWidth;
  assertion(std::isfinite(maxAdmissibleMeshWidth) and maxAdmissibleMeshWidth > 0.0, maxAdmissibleMeshWidth);
  return this->_timeStepping.getFactor() * this->_timeStepping.getMinMeshWidth() / maxAdmissibleMeshWidth;
}

template <typename Derived, typename StoragePrecision, typename ComputePrecision, typename Limiter>
INLINE_METHOD const typename exahype2::dg::ader::Solver<
  Derived,
  StoragePrecision,
  ComputePrecision,
  Limiter
>::LimiterType&
exahype2::dg::ader::Solver<Derived, StoragePrecision, ComputePrecision, Limiter>::getLimiter() const {
  if constexpr (HasLimiter) {
    return *_limiter;
  } else {
    return _limiter;
  }
}

template <typename Derived, typename StoragePrecision, typename ComputePrecision, typename Limiter>
INLINE_METHOD exahype2::dg::BasisTables<ComputePrecision>
exahype2::dg::ader::Solver<Derived, StoragePrecision, ComputePrecision, Limiter>::getBasisTables() {
  return exahype2::dg::BasisTables<ComputePrecision>{
    Quadrature<ComputePrecision>::QuadraturePoints1D,
    Quadrature<ComputePrecision>::QuadratureWeights1D,
    Quadrature<ComputePrecision>::InverseQuadratureWeights1D,
    Quadrature<ComputePrecision>::QuadratureWeightsInCell,
    Quadrature<ComputePrecision>::InverseQuadratureWeightsInCell,
    DGMatrices<ComputePrecision>::StiffnessOperator1D,
    DGMatrices<ComputePrecision>::StiffnessOperatorTransposed1D,
    DGMatrices<ComputePrecision>::DerivativeOperator1D,
    DGMatrices<ComputePrecision>::InversePicardOperator1D,
    DGMatrices<ComputePrecision>::BasisFunctionValuesLeft1D,
    DGMatrices<ComputePrecision>::BasisFunctionValuesRight1D
  };
}

/**
 * Runs the space-time predictor of the local or the remote cells. A solver with a limiter marks
 * every cell whose Picard iteration diverges or stops at its sweep limit for the limiter. A solver
 * without a limiter terminates the run on a diverged cell and continues an unconverged cell with
 * the last iterate.
 */
template <typename Derived, typename StoragePrecision, typename ComputePrecision, typename Limiter>
INLINE_METHOD void
exahype2::dg::ader::Solver<Derived, StoragePrecision, ComputePrecision, Limiter>::predict(
  const peano4::CellConnectivity& cellConnectivity,
  const peano4::Adjacency         adjacency,
  const double                    timeStepSize
) {
  assertion(
    _predictorScratch.getSize()
    >= static_cast<std::size_t>(Predictor::getNumberOfScratchChunks(this->getNumberOfCells(cellConnectivity)))
      * Predictor::ScratchSize
  );
  exahype2::dg::ader::PredictionCounts counts;
  if constexpr (HasLimiter) {
    counts = predictCells(cellConnectivity, adjacency, timeStepSize, _limiter->getStatuses());
  } else {
    counts = predictCells(cellConnectivity, adjacency, timeStepSize, exahype2::dg::ader::NoLimiter{});
    if (counts.divergedCells > 0) {
      assertion(counts.firstDivergedCell >= 0, counts.firstDivergedCell, counts.divergedCells);
      std::ostringstream message;
      message << "The space-time predictor diverges at t = " << this->_timeStepping.getTimeStamp()
              << " in the cell with the centre " << toString(cellConnectivity.getCellCentre(counts.firstDivergedCell))
              << " (diverged cells on this rank: " << counts.divergedCells
              << "). Add a subcell limiter to the solver or lower its time step factor.";
      tarch::terminateWithError(message.str());
    }
  }
  assertion(counts.unconvergedCells >= 0, counts.unconvergedCells);
  _unconvergedPredictions += counts.unconvergedCells;
}

/**
 * Returns the pool in which the Riemann problems store the numerical flux of every side for the
 * limiter, or an empty view without a limiter.
 */
template <typename Derived, typename StoragePrecision, typename ComputePrecision, typename Limiter>
INLINE_METHOD typename exahype2::dg::ader::Solver<Derived, StoragePrecision, ComputePrecision, Limiter>::Base::FluxPool::View
exahype2::dg::ader::Solver<Derived, StoragePrecision, ComputePrecision, Limiter>::getAppliedFluxes() {
  if constexpr (HasLimiter) {
    return _limiter->getAppliedFluxes();
  } else {
    return {};
  }
}

/**
 * Adds the values of the base solver and of the limiter and the unconverged predictions of this rank
 * since the last reduction to record.
 */
template <typename Derived, typename StoragePrecision, typename ComputePrecision, typename Limiter>
INLINE_METHOD void
exahype2::dg::ader::Solver<Derived, StoragePrecision, ComputePrecision, Limiter>::addLocalValuesToGlobalReduction(
  tarch::mpi::ReductionRecord& record
) {
  Base::addLocalValuesToGlobalReduction(record);
  if constexpr (HasLimiter) {
    _limiter->addLocalValuesToGlobalReduction(record);
  }
  if constexpr (not Derived::IsLinear) {
    assertion(_unconvergedPredictions >= 0, _unconvergedPredictions);
    _unconvergedPredictionsSlot = record.addSum(static_cast<std::uint64_t>(_unconvergedPredictions));
    _unconvergedPredictions     = 0;
  }
}

/**
 * Reads the reduced values of the base solver and of the limiter. The global master warns when the
 * Picard iteration of any cell stopped at its sweep limit since the last reduction. With a limiter,
 * no iteration stops there.
 */
template <typename Derived, typename StoragePrecision, typename ComputePrecision, typename Limiter>
INLINE_METHOD void
exahype2::dg::ader::Solver<Derived, StoragePrecision, ComputePrecision, Limiter>::readValuesFromGlobalReduction(
  const tarch::mpi::ReductionRecord& record
) {
  Base::readValuesFromGlobalReduction(record);
  if constexpr (HasLimiter) {
    _limiter->readValuesFromGlobalReduction(record);
  }
  if constexpr (not Derived::IsLinear) {
    const auto globalPredictions = record.getSum(_unconvergedPredictionsSlot);
    if (globalPredictions > 0 and tarch::mpi::Rank::getInstance().isGlobalMaster()) {
      logWarning(
        "The Picard iteration of " << globalPredictions
                                   << " cells reaches its sweep limit at t = " << this->_timeStepping.getTimeStamp()
                                   << " before it converges. The cells continue with the last iterate."
      );
    }
  }
}

/**
 * Runs the predictor kernel and returns the numbers of the diverged and the unconverged cells.
 * With a limiter, the kernel marks these cells in divergenceMarks and returns zero counts.
 */
template <typename Derived, typename StoragePrecision, typename ComputePrecision, typename Limiter>
template <typename DivergenceMarks>
INLINE_METHOD exahype2::dg::ader::PredictionCounts
exahype2::dg::ader::Solver<Derived, StoragePrecision, ComputePrecision, Limiter>::predictCells(
  const peano4::CellConnectivity& cellConnectivity,
  const peano4::Adjacency         adjacency,
  const double                    timeStepSize,
  const DivergenceMarks&          divergenceMarks
) {
  const auto                           cells = this->getCells(cellConnectivity, adjacency);
  exahype2::dg::ader::PredictionCounts counts;
  if (cells.size == 0) {
    return counts;
  }
  const int numberOfTeams = Predictor::getNumberOfTeams(cells.size);
  const int teamThreads   = Predictor::getTeamThreads();
  tarch::accelerator::parallelReduce(
    tarch::accelerator::TeamRange(numberOfTeams, teamThreads, Predictor::getTeamScratchBytes(teamThreads)),
    exahype2::dg::ader::PredictCells<Derived, StoragePrecision, ComputePrecision, DivergenceMarks>{
      cellConnectivity.onDevice(),
      cells,
      numberOfTeams,
      Predictor::getThreadsPerCell(),
      this->_solution.getView(),
      this->_faceStates.getView(),
      this->_faceFluxes.getView(),
      divergenceMarks,
      getBasisTables(),
      _pointSourceLocations.getData(),
      this->_timeStepping.getTimeStamp(),
      timeStepSize,
      _predictorScratch.getData()
    },
    tarch::accelerator::Custom<exahype2::dg::ader::PredictionCounts>{counts}
  );
  return counts;
}

/**
 * Interpolates the face halves that the predictor writes across the local or the remote level
 * jumps. A predictor without face fluxes writes the state halves only.
 */
template <typename Derived, typename StoragePrecision, typename ComputePrecision, typename Limiter>
INLINE_METHOD void
exahype2::dg::ader::Solver<Derived, StoragePrecision, ComputePrecision, Limiter>::interpolatePredictedHalves(
  const peano4::CellConnectivity& cellConnectivity,
  const peano4::Adjacency         adjacency
) {
  if constexpr (Predictor::WritesFaceFluxes) {
    this->interpolateCoarseFaces(
      cellConnectivity,
      adjacency,
      typename Base::InterpolateHalves{
        this->_faceStates.getView(),
        this->_faceFluxes.getView(),
        DGMatrices<double>::ProlongationMatrix1D
      }
    );
  } else {
    this->interpolateCoarseFaces(
      cellConnectivity,
      adjacency,
      typename Base::InterpolateStateHalves{this->_faceStates.getView(), DGMatrices<double>::ProlongationMatrix1D}
    );
  }
}

/**
 * Adds the face integrals of the local or the remote cells to their solution and returns the
 * wave-speed maxima of the updated solution. With a limiter, the maxima are zero.
 */
template <typename Derived, typename StoragePrecision, typename ComputePrecision, typename Limiter>
INLINE_METHOD exahype2::dg::MaxEigenvalueStatistics
exahype2::dg::ader::Solver<Derived, StoragePrecision, ComputePrecision, Limiter>::correct(
  const peano4::CellConnectivity& cellConnectivity,
  const peano4::Adjacency         adjacency,
  const double                    timeStepSize
) {
  using Cells                                 = CorrectorCells<UsesAdaptiveTimeStepping and not HasLimiter>;
  const auto                            cells = this->getCells(cellConnectivity, adjacency);
  exahype2::dg::MaxEigenvalueStatistics statistics;
  if (cells.size == 0) {
    return statistics;
  }
  const int numberOfTeams = Corrector::getNumberOfTeams(cells.size);
  tarch::accelerator::parallelReduce(
    tarch::accelerator::TeamRange(numberOfTeams, Corrector::getTeamThreads(), 0),
    Cells{
      cellConnectivity.onDevice(),
      cells,
      numberOfTeams,
      this->_solution.getView(),
      std::as_const(this->_faceFluxes).getView(),
      Quadrature<ComputePrecision>::QuadratureWeightsOnFace,
      Quadrature<ComputePrecision>::InverseQuadratureWeightsInCell,
      DGMatrices<ComputePrecision>::BasisFunctionValuesLeft1D,
      DGMatrices<ComputePrecision>::BasisFunctionValuesRight1D,
      Quadrature<StoragePrecision>::QuadraturePoints1D,
      this->_timeStepping.getTimeStamp(),
      timeStepSize
    },
    tarch::accelerator::Custom<exahype2::dg::MaxEigenvalueStatistics>{statistics}
  );
  return statistics;
}
