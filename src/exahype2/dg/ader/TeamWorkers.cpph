#include "tarch/Assertions.h"

TARGET_DECLARE
/**
 * Returns the calling device thread as a worker of a team that runs cells on threadsPerCell
 * threads each. The threads of the team split into groups of threadsPerCell consecutive threads.
 * The threads behind the last full group receive no cell. A team smaller than threadsPerCell runs
 * one cell on all of its threads. On the host the call runs one cell on one thread without a team.
 */
INLINE_METHOD GPU_CALLABLE_METHOD exahype2::dg::ader::TeamWorkers
exahype2::dg::ader::getWorkers(
  [[maybe_unused]] const tarch::accelerator::TeamHandle& team,
  [[maybe_unused]] const int                             threadsPerCell
) {
  assertion(threadsPerCell > 0, threadsPerCell);
  TeamWorkers workers;
  COMPILE_IF_ON_DEVICE(workers.teamThread  = tarch::accelerator::getThreadOfTeam(team);
                       workers.teamThreads = tarch::accelerator::getNumberOfThreadsPerTeam(team);
                       workers.threads = threadsPerCell < workers.teamThreads ? threadsPerCell : workers.teamThreads;
                       workers.groups  = workers.teamThreads / workers.threads;
                       workers.group   = workers.teamThread / workers.threads;
                       workers.thread  = workers.teamThread - workers.group * workers.threads;
                       workers.hasCell = workers.group < workers.groups;
                       workers.team    = &team;
                       workers.scratch = tarch::accelerator::getTeamScratch(team);)
  return workers;
}

/**
 * Waits until every thread of the team reaches this point. A team of one thread returns at once.
 */
INLINE_METHOD GPU_CALLABLE_METHOD void
exahype2::dg::ader::synchronise(const TeamWorkers& workers) {
  if (workers.teamThreads > 1) {
    assertion(workers.team != nullptr, workers.teamThread, workers.teamThreads);
    COMPILE_IF_ON_DEVICE(tarch::accelerator::teamBarrier(*workers.team);)
  }
}
TARGET_DECLARE_END
