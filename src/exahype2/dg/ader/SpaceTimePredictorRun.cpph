/**
 * Runs the space-time predictor of one cell on the buffers the caller selects.
 *
 * The predictor overwrites cellState and writes the estimates of this cell into the halves of
 * stateEstimates and fluxEstimates the caller points at, from scratch memory that lives per
 * thread and outlives the call. Returns the result of spaceTimePredictor() for a nonlinear solver
 * and zero for a linear solver.
 */
template <
  typename SolverType,
  int  NumberOfDofsPerAxis,
  int  NumberOfUnknowns,
  int  NumberOfAuxiliaryVariables,
  bool IsLinear,
  bool EvaluateFlux,
  bool EvaluateNonconservativeProduct,
  bool EvaluateSource,
  bool EvaluateDiffusiveFlux,
  bool EvaluateDiffusiveSource,
  bool EvaluateMaterialParameters,
  bool EvaluatePointSources,
  typename ComputePrecision,
  typename StoragePrecision,
  typename FacePrecision>
INLINE_METHOD int exahype2::dg::ader::runSpaceTimePredictor(
  const peano4::dataview::CellMarker&  marker,
  FacePrecision* const*                stateEstimates,
  FacePrecision* const*                fluxEstimates,
  StoragePrecision* NOALIAS            cellState,
  const BasisTables<ComputePrecision>& tables,
  const double                         timeStamp,
  const double                         timeStepSize
) {
  assertion(stateEstimates != nullptr);
  assertion(fluxEstimates != nullptr);
  assertion(cellState != nullptr);
  assertion(timeStamp >= 0.0, timeStamp, marker.toString());
  assertion(timeStepSize >= 0.0, timeStepSize, marker.toString());

  using ScratchDeleter = decltype([](auto* const memory) { tarch::accelerator::freeHeapMemory(memory); });

  if constexpr (IsLinear) {
    using PredictorScratch = exahype2::dg::ader::LinearPredictorScratch<
      NumberOfDofsPerAxis,
      NumberOfUnknowns,
      NumberOfAuxiliaryVariables,
      EvaluateNonconservativeProduct,
      EvaluatePointSources>;
    static thread_local const std::unique_ptr<ComputePrecision[], ScratchDeleter> predictorScratch(
      static_cast<ComputePrecision*>(
        tarch::accelerator::allocateHeapMemory(PredictorScratch::Size * sizeof(ComputePrecision))
      )
    );

    if constexpr (EvaluatePointSources) {
      static_assert(
        SolverType::NumberOfPointSources > 0,
        "A solver that evaluates point sources declares at least one."
      );
      int                 pointSourceIndices[SolverType::NumberOfPointSources];
      const double* const pointSourceLocations = &SolverType::pointSourceLocation[0][0];
      const int numberOfPointSources = exahype2::dg::ader::selectPointSources<SolverType::NumberOfPointSources>(
        pointSourceIndices,
        pointSourceLocations,
        marker.getX(),
        marker.getH()
      );
      if (numberOfPointSources > 0) {
        exahype2::dg::ader::linearSpaceTimePredictor<
          SolverType,
          NumberOfDofsPerAxis,
          NumberOfUnknowns,
          NumberOfAuxiliaryVariables,
          EvaluateFlux,
          EvaluateNonconservativeProduct,
          EvaluateSource,
          EvaluateMaterialParameters,
          true>(
          stateEstimates,
          fluxEstimates,
          cellState,
          predictorScratch.get(),
          pointSourceIndices,
          numberOfPointSources,
          pointSourceLocations,
          tables,
          marker.getX(),
          marker.getH(),
          timeStamp,
          timeStepSize
        );
        return 0;
      }
      exahype2::dg::ader::linearSpaceTimePredictor<
        SolverType,
        NumberOfDofsPerAxis,
        NumberOfUnknowns,
        NumberOfAuxiliaryVariables,
        EvaluateFlux,
        EvaluateNonconservativeProduct,
        EvaluateSource,
        EvaluateMaterialParameters,
        false>(
        stateEstimates,
        fluxEstimates,
        cellState,
        predictorScratch.get(),
        pointSourceIndices,
        0,
        pointSourceLocations,
        tables,
        marker.getX(),
        marker.getH(),
        timeStamp,
        timeStepSize
      );
      return 0;
    }

    const int* const    pointSourceIndices   = nullptr;
    const double* const pointSourceLocations = nullptr;
    exahype2::dg::ader::linearSpaceTimePredictor<
      SolverType,
      NumberOfDofsPerAxis,
      NumberOfUnknowns,
      NumberOfAuxiliaryVariables,
      EvaluateFlux,
      EvaluateNonconservativeProduct,
      EvaluateSource,
      EvaluateMaterialParameters,
      false>(
      stateEstimates,
      fluxEstimates,
      cellState,
      predictorScratch.get(),
      pointSourceIndices,
      0,
      pointSourceLocations,
      tables,
      marker.getX(),
      marker.getH(),
      timeStamp,
      timeStepSize
    );
    return 0;
  } else {
    using PredictorScratch = exahype2::dg::ader::NonlinearPredictorScratch<
      NumberOfDofsPerAxis,
      NumberOfUnknowns,
      NumberOfAuxiliaryVariables,
      EvaluateFlux,
      EvaluateNonconservativeProduct,
      EvaluateSource,
      EvaluateDiffusiveFlux,
      EvaluateDiffusiveSource>;
    static thread_local const std::unique_ptr<ComputePrecision[], ScratchDeleter> scratch(
      static_cast<ComputePrecision*>(
        tarch::accelerator::allocateHeapMemory(PredictorScratch::Size * sizeof(ComputePrecision))
      )
    );

    return exahype2::dg::ader::spaceTimePredictor<
      SolverType,
      NumberOfDofsPerAxis,
      NumberOfUnknowns,
      NumberOfAuxiliaryVariables,
      EvaluateFlux,
      EvaluateNonconservativeProduct,
      EvaluateSource,
      EvaluateDiffusiveFlux,
      EvaluateDiffusiveSource>(
      stateEstimates,
      fluxEstimates,
      cellState,
      scratch.get(),
      tables,
      marker.getX(),
      marker.getH(),
      timeStamp,
      timeStepSize,
      SolverType::PicardResidualTolerance
    );
  }
}
