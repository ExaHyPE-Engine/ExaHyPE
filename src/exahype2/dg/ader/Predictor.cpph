#include "exahype2/dg/Kernels.h"
#include "exahype2/dg/limiting/LimiterStatus.h"
#include "peano4/Constants.h"
#include "tarch/Assertions.h"
#include "tarch/accelerator/Scratch.h"

TARGET_DECLARE
/**
 * Runs the space-time predictor of one cell and subtracts the volume integral of the time averages
 * from cellState. scratch is a block of ScratchSize values that no other call reads while this
 * call runs. Returns the outcome of NonlinearPredictor::predict(), or zero for a linear Derived.
 */
template <typename Derived, typename ComputePrecision>
template <typename StoragePrecision>
INLINE_METHOD GPU_CALLABLE_METHOD int
exahype2::dg::ader::Predictor<Derived, ComputePrecision>::predict(
  const tarch::la::Vector<DIMENSIONS, double>& cellCentre,
  const tarch::la::Vector<DIMENSIONS, double>& cellSize,
  ComputePrecision* const* const               faceStates,
  ComputePrecision* const* const               faceFluxes,
  StoragePrecision* NOALIAS const              cellState,
  const double* NOALIAS const                  pointSourceLocations,
  ComputePrecision* NOALIAS const              scratch,
  const Tables&                                tables,
  const double                                 timeStamp,
  const double                                 timeStepSize
) {
  assertion(faceStates != nullptr);
  assertion(faceFluxes != nullptr);
  assertion(cellState != nullptr);
  assertion(scratch != nullptr);
  assertion(timeStamp >= 0.0, timeStamp, cellCentre);
  assertion(timeStepSize >= 0.0, timeStepSize, cellCentre);

  if constexpr (Derived::IsLinear) {
    using Scratch = typename Linear::Scratch;

    if constexpr (Linear::EvaluatePointSources) {
      static_assert(Derived::NumberOfPointSources > 0, "A solver that evaluates point sources declares at least one.");
      assertion(pointSourceLocations != nullptr);
      int       pointSourceIndices[Derived::NumberOfPointSources];
      const int numberOfPointSources =
        Linear::selectPointSources(pointSourceIndices, pointSourceLocations, cellCentre, cellSize);
      Linear::predict(
        faceStates,
        faceFluxes,
        cellState,
        scratch,
        pointSourceIndices,
        numberOfPointSources,
        pointSourceLocations,
        tables,
        cellCentre,
        cellSize,
        timeStamp,
        timeStepSize
      );
    } else {
      const int* const pointSourceIndices = nullptr;
      Linear::predict(
        faceStates,
        faceFluxes,
        cellState,
        scratch,
        pointSourceIndices,
        0,
        pointSourceLocations,
        tables,
        cellCentre,
        cellSize,
        timeStamp,
        timeStepSize
      );
    }
    // The terms of a linear Derived are linear in the state and constant within the time step, so
    // the source of the time-averaged state is the time-averaged source.
    const ComputePrecision* const timeAveragedState = scratch + Scratch::TimeAveragedStateOffset;
    subtractTimeAveragedVolumeIntegral<Linear::AccumulatesFlux, Linear::AccumulatesSource>(
      cellState,
      scratch + Scratch::FluxOffset,
      [&](const int cellNode, ComputePrecision* const values) {
        if constexpr (Linear::AccumulatesSource) {
          for (int unknown = 0; unknown < CellLayout::PaddedNumberOfUnknowns; unknown++) {
            values[unknown] = static_cast<ComputePrecision>(0);
          }
          Derived::sourceTerm(
            timeAveragedState + cellNode * CellLayout::PaddedNumberOfData,
            cellCentre,
            cellSize,
            timeStamp,
            timeStepSize,
            values
          );
        }
      },
      timeStepSize
    );
    return 0;
  } else {
    using Scratch = typename Nonlinear::Scratch;

    const int outcome = Nonlinear::predict(
      faceStates,
      faceFluxes,
      cellState,
      scratch,
      tables,
      cellCentre,
      cellSize,
      timeStamp,
      timeStepSize,
      Derived::PicardResidualTolerance
    );
    const ComputePrecision* const timeAveragedSource = scratch + Scratch::TimeAveragedSourceOffset;
    subtractTimeAveragedVolumeIntegral<Nonlinear::AccumulatesFlux, Nonlinear::AccumulatesSource>(
      cellState,
      scratch + Scratch::TimeAveragedFluxOffset,
      [&](const int cellNode, ComputePrecision* const values) {
        for (int unknown = 0; unknown < CellLayout::PaddedNumberOfUnknowns; unknown++) {
          values[unknown] = timeAveragedSource[cellNode * CellLayout::PaddedNumberOfUnknowns + unknown];
        }
      },
      timeStepSize
    );
    return outcome;
  }
}

/**
 * Adds the time step times the time-averaged source minus the flux divergence to cellState.
 * timeAveragedFlux stores the derivative of the flux along its own axis, one block per axis.
 * sourceOfNode(cellNode, values) writes the time-averaged source of one node.
 */
template <typename Derived, typename ComputePrecision>
template <bool AccumulatesFlux, bool AccumulatesSource, typename StoragePrecision, typename SourceOfNode>
INLINE_METHOD GPU_CALLABLE_METHOD void
exahype2::dg::ader::Predictor<Derived, ComputePrecision>::subtractTimeAveragedVolumeIntegral(
  StoragePrecision* NOALIAS const                        cellState,
  [[maybe_unused]] const ComputePrecision* NOALIAS const timeAveragedFlux,
  [[maybe_unused]] const SourceOfNode&                   sourceOfNode,
  const double                                           timeStepSize
) {
  constexpr int UnknownStride = CellLayout::PaddedNumberOfUnknowns;
  constexpr int AxisStride    = UnknownStride * CellLayout::NodesPerCell;

  using UpdatePrecision = std::common_type_t<ComputePrecision, double>;

  [[maybe_unused]] ComputePrecision nodeSource[UnknownStride] __attribute__((aligned(PEANO_WITH_ALIGNMENT)));

  for (int cellNode = 0; cellNode < CellLayout::NodesPerCell; cellNode++) {
    if constexpr (AccumulatesSource) {
      sourceOfNode(cellNode, nodeSource);
    }
    SIMD()
    for (int unknown = 0; unknown < CellLayout::NumberOfUnknowns; unknown++) {
      const int entry  = cellNode * UnknownStride + unknown;
      auto      update = static_cast<ComputePrecision>(0);
      if constexpr (AccumulatesFlux) {
        update = timeAveragedFlux[entry] + timeAveragedFlux[entry + AxisStride];
        if constexpr (DIMENSIONS == 3) {
          update += timeAveragedFlux[entry + 2 * AxisStride];
        }
      }
      if constexpr (AccumulatesSource) {
        update -= nodeSource[unknown];
      }
      cellState[cellNode * CellLayout::NumberOfData + unknown] -= static_cast<StoragePrecision>(
        static_cast<UpdatePrecision>(timeStepSize) * static_cast<UpdatePrecision>(update)
      );
    }
  }
}

template <typename Derived, typename StoragePrecision, typename ComputePrecision, typename DivergenceMarks>
INLINE_METHOD GPU_CALLABLE_METHOD void
exahype2::dg::ader::PredictCells<Derived, StoragePrecision, ComputePrecision, DivergenceMarks>::operator()(
  const int         entry,
  PredictionCounts& accumulator
) const {
  constexpr int     StateValuesPerFace = CellLayout::NodesPerFace * CellLayout::NumberOfData;
  constexpr int     FluxValuesPerFace  = CellLayout::NodesPerFace * CellLayout::NumberOfUnknowns;
  const int         slot               = cells[entry];
  const int         chunk              = tarch::accelerator::getScratchChunk(entry);
  ComputePrecision* ownStateHalves[peano4::FacesPerCell];
  ComputePrecision* ownFluxHalves[peano4::FacesPerCell];
  for (int faceNumber = 0; faceNumber < peano4::FacesPerCell; faceNumber++) {
    const int face             = partition.getCellFace(slot, faceNumber);
    const int half             = exahype2::dg::getOwnHalf(faceNumber);
    ownStateHalves[faceNumber] = faceStates.getChunk(face) + half * StateValuesPerFace;
    ownFluxHalves[faceNumber]  = faceFluxes.getChunk(face) + half * FluxValuesPerFace;
  }
  const int outcome = exahype2::dg::ader::Predictor<Derived, ComputePrecision>::predict(
    partition.getCellCentre(slot),
    partition.getCellWidth(slot),
    ownStateHalves,
    ownFluxHalves,
    solution.getChunk(slot),
    pointSourceLocations,
    predictorScratch + chunk * predictorScratchSize,
    tables,
    timeStamp,
    timeStepSize
  );
  if (outcome == exahype2::dg::ader::DivergedPicardIteration) {
    if constexpr (HasLimiter) {
      divergenceMarks.getChunk(slot)[static_cast<int>(exahype2::dg::limiting::StatusEntry::PredictorDiverged)] = 1;
    } else {
      accumulator.divergedCells++;
    }
  } else if (outcome == exahype2::dg::ader::UnconvergedPicardIteration) {
    accumulator.unconvergedCells++;
  }
}

INLINE_METHOD GPU_CALLABLE_METHOD exahype2::dg::ader::PredictionCounts
exahype2::dg::ader::PredictionCounts::identity() {
  return ValueType{};
}

INLINE_METHOD GPU_CALLABLE_METHOD exahype2::dg::ader::PredictionCounts
exahype2::dg::ader::PredictionCounts::combine(const ValueType left, const ValueType right) {
  return ValueType{left.divergedCells + right.divergedCells, left.unconvergedCells + right.unconvergedCells};
}
TARGET_DECLARE_END
