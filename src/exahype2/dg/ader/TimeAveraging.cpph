TARGET_DECLARE
/**
 * Overwrites the first time slice of the space-time state with the temporal quadrature of all its
 * time slices.
 */
template <int NumberOfDofsPerAxis, int NumberOfUnknowns, int NumberOfAuxiliaryVariables, typename ComputePrecision>
INLINE_METHOD GPU_CALLABLE_METHOD void exahype2::dg::ader::averageStateOverTime(
  ComputePrecision* NOALIAS const       spaceTimeState,
  const ComputePrecision* NOALIAS const quadratureWeights
) {
  using CellLayout           = Layout<NumberOfDofsPerAxis, NumberOfUnknowns, NumberOfAuxiliaryVariables>;
  constexpr int SliceEntries = CellLayout::NodesPerCell * CellLayout::PaddedNumberOfData;

  const ComputePrecision firstWeight = quadratureWeights[0];
  for (int entry = 0; entry < SliceEntries; entry++) {
    spaceTimeState[entry] = static_cast<ComputePrecision>(0) + firstWeight * spaceTimeState[entry];
  }

  for (int timeNode = 1; timeNode < NumberOfDofsPerAxis; timeNode++) {
    const ComputePrecision weight     = quadratureWeights[timeNode];
    const int              sliceFirst = timeNode * SliceEntries;
    for (int entry = 0; entry < SliceEntries; entry++) {
      spaceTimeState[entry] += weight * spaceTimeState[sliceFirst + entry];
    }
  }
}
TARGET_DECLARE_END
