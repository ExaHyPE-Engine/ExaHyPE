TARGET_DECLARE
/**
 * Copies the cell state into the zeroth Taylor coefficient and zeroes the padding lanes.
 */
template <
  int NumberOfDofsPerAxis,
  int NumberOfUnknowns,
  int NumberOfAuxiliaryVariables,
  typename StoragePrecision,
  typename ComputePrecision>
INLINE_METHOD GPU_CALLABLE_METHOD void exahype2::dg::ader::initialiseLinearPredictorState(
  ComputePrecision* NOALIAS const       state,
  const StoragePrecision* NOALIAS const cellState
) {
  using CellLayout = Layout<NumberOfDofsPerAxis, NumberOfUnknowns, NumberOfAuxiliaryVariables>;

  for (int cellNode = 0; cellNode < CellLayout::NodesPerCell; cellNode++) {
    ComputePrecision* NOALIAS const localState = state + cellNode * CellLayout::PaddedNumberOfData;
    for (int value = CellLayout::NumberOfData; value < CellLayout::PaddedNumberOfData; value++) {
      localState[value] = static_cast<ComputePrecision>(0);
    }
    for (int value = 0; value < CellLayout::NumberOfData; value++) {
      localState[value] = static_cast<ComputePrecision>(cellState[cellNode * CellLayout::NumberOfData + value]);
    }
  }
}

/**
 * Copies the zeroth Taylor coefficient into the time average, which enters with a factor of one.
 */
template <int NumberOfDofsPerAxis, int NumberOfUnknowns, int NumberOfAuxiliaryVariables, typename ComputePrecision>
INLINE_METHOD GPU_CALLABLE_METHOD void exahype2::dg::ader::seedTimeAveragedState(
  ComputePrecision* NOALIAS const       timeAveragedState,
  const ComputePrecision* NOALIAS const state
) {
  using CellLayout = Layout<NumberOfDofsPerAxis, NumberOfUnknowns, NumberOfAuxiliaryVariables>;

  for (int entry = 0; entry < CellLayout::NodesPerCell * CellLayout::PaddedNumberOfData; entry++) {
    timeAveragedState[entry] = state[entry];
  }
}

/**
 * Zeroes the flux and the source of one Taylor step, so the solver callbacks accumulate into them.
 */
template <
  int  NumberOfDofsPerAxis,
  int  NumberOfUnknowns,
  int  NumberOfAuxiliaryVariables,
  bool EvaluateSource,
  typename ComputePrecision>
INLINE_METHOD GPU_CALLABLE_METHOD void exahype2::dg::ader::clearTaylorTerms(
  ComputePrecision* NOALIAS const                  flux,
  [[maybe_unused]] ComputePrecision* NOALIAS const source
) {
  using CellLayout         = Layout<NumberOfDofsPerAxis, NumberOfUnknowns, NumberOfAuxiliaryVariables>;
  constexpr int AxisStride = CellLayout::NodesPerCell * CellLayout::PaddedNumberOfUnknowns;

  for (int entry = 0; entry < DIMENSIONS * AxisStride; entry++) {
    flux[entry] = static_cast<ComputePrecision>(0);
  }
  if constexpr (EvaluateSource) {
    for (int entry = 0; entry < AxisStride; entry++) {
      source[entry] = static_cast<ComputePrecision>(0);
    }
  }
}

/**
 * Replaces the flux of every axis by its physical derivative along that axis, one line of nodes at
 * a time through a line buffer.
 */
template <int NumberOfDofsPerAxis, int NumberOfUnknowns, int NumberOfAuxiliaryVariables, typename ComputePrecision>
INLINE_METHOD GPU_CALLABLE_METHOD void exahype2::dg::ader::differentiateFluxInPlace(
  ComputePrecision* NOALIAS const                        flux,
  const ComputePrecision* NOALIAS const                  derivativeOperator,
  const tarch::la::Vector<DIMENSIONS, ComputePrecision>& inverseCellSize
) {
  using CellLayout         = Layout<NumberOfDofsPerAxis, NumberOfUnknowns, NumberOfAuxiliaryVariables>;
  constexpr int FluxStride = CellLayout::PaddedNumberOfUnknowns;
  constexpr int AxisStride = CellLayout::NodesPerCell * FluxStride;
  constexpr int LineSize   = NumberOfDofsPerAxis * FluxStride;

  for (int axis = 0; axis < DIMENSIONS; axis++) {
    assertion(inverseCellSize(axis) > 0.0, inverseCellSize, axis);
  }

  ComputePrecision derivative[LineSize] __attribute__((aligned(PEANO_WITH_ALIGNMENT)));

  for (int line = 0; line < CellLayout::NodesPerFace; line++) {
    ComputePrecision* NOALIAS const fluxLine = flux + line * LineSize;
    exahype2::dg::applyOperatorAlongAxis<
      FluxStride,
      NumberOfDofsPerAxis,
      NumberOfDofsPerAxis,
      FluxStride,
      NumberOfDofsPerAxis,
      FluxStride,
      true,
      ComputePrecision,
      ComputePrecision>(derivative, fluxLine, derivativeOperator, inverseCellSize(0));
    for (int entry = 0; entry < LineSize; entry++) {
      fluxLine[entry] = derivative[entry];
    }
  }

  for (int z = 0; z < CellLayout::NodesPerAxisIn3D; z++) {
    for (int x = 0; x < NumberOfDofsPerAxis; x++) {
      ComputePrecision* NOALIAS const fluxLine =
        flux + AxisStride + (z * NumberOfDofsPerAxis * NumberOfDofsPerAxis + x) * FluxStride;
      exahype2::dg::applyOperatorAlongAxis<
        FluxStride,
        NumberOfDofsPerAxis,
        NumberOfDofsPerAxis,
        FluxStride * NumberOfDofsPerAxis,
        NumberOfDofsPerAxis,
        FluxStride,
        true,
        ComputePrecision,
        ComputePrecision>(derivative, fluxLine, derivativeOperator, inverseCellSize(1));
      for (int y = 0; y < NumberOfDofsPerAxis; y++) {
        SIMD()
        for (int unknown = 0; unknown < FluxStride; unknown++) {
          fluxLine[y * NumberOfDofsPerAxis * FluxStride + unknown] = derivative[y * FluxStride + unknown];
        }
      }
    }
  }

  if constexpr (DIMENSIONS == 3) {
    for (int line = 0; line < NumberOfDofsPerAxis * NumberOfDofsPerAxis; line++) {
      ComputePrecision* NOALIAS const fluxLine = flux + 2 * AxisStride + line * FluxStride;
      exahype2::dg::applyOperatorAlongAxis<
        FluxStride,
        NumberOfDofsPerAxis,
        NumberOfDofsPerAxis,
        FluxStride * NumberOfDofsPerAxis * NumberOfDofsPerAxis,
        NumberOfDofsPerAxis,
        FluxStride,
        true,
        ComputePrecision,
        ComputePrecision>(derivative, fluxLine, derivativeOperator, inverseCellSize(DIMENSIONS - 1));
      for (int z = 0; z < NumberOfDofsPerAxis; z++) {
        SIMD()
        for (int unknown = 0; unknown < FluxStride; unknown++) {
          fluxLine[z * NumberOfDofsPerAxis * NumberOfDofsPerAxis * FluxStride + unknown] =
            derivative[z * FluxStride + unknown];
        }
      }
    }
  }
}

/**
 * Adds the current Taylor coefficient of the flux and the source, scaled by the time average
 * factor, to their time averages.
 */
template <
  int  NumberOfDofsPerAxis,
  int  NumberOfUnknowns,
  int  NumberOfAuxiliaryVariables,
  bool EvaluateSource,
  typename ComputePrecision>
INLINE_METHOD GPU_CALLABLE_METHOD void exahype2::dg::ader::accumulateTimeAveragedTerms(
  ComputePrecision* NOALIAS const                        timeAveragedFlux,
  [[maybe_unused]] ComputePrecision* NOALIAS const       timeAveragedSource,
  const ComputePrecision* NOALIAS const                  flux,
  [[maybe_unused]] const ComputePrecision* NOALIAS const source,
  const ComputePrecision                                 timeAverageFactor
) {
  using CellLayout         = Layout<NumberOfDofsPerAxis, NumberOfUnknowns, NumberOfAuxiliaryVariables>;
  constexpr int FluxStride = CellLayout::PaddedNumberOfUnknowns;
  constexpr int AxisStride = CellLayout::NodesPerCell * FluxStride;

  for (int cellNode = 0; cellNode < CellLayout::NodesPerCell; cellNode++) {
    SIMD()
    for (int unknown = 0; unknown < FluxStride; unknown++) {
      const int entry = cellNode * FluxStride + unknown;
      timeAveragedFlux[entry] += timeAverageFactor * flux[entry];
      timeAveragedFlux[entry + AxisStride] += timeAverageFactor * flux[entry + AxisStride];
      if constexpr (DIMENSIONS == 3) {
        timeAveragedFlux[entry + 2 * AxisStride] += timeAverageFactor * flux[entry + 2 * AxisStride];
      }
      if constexpr (EvaluateSource) {
        timeAveragedSource[entry] += timeAverageFactor * source[entry];
      }
    }
  }
}

/**
 * Writes the next Taylor coefficient, the source minus the flux divergence, into the state.
 */
template <
  int  NumberOfDofsPerAxis,
  int  NumberOfUnknowns,
  int  NumberOfAuxiliaryVariables,
  bool EvaluateSource,
  typename ComputePrecision>
INLINE_METHOD GPU_CALLABLE_METHOD void exahype2::dg::ader::advanceTimeDerivative(
  ComputePrecision* NOALIAS const                        state,
  const ComputePrecision* NOALIAS const                  flux,
  [[maybe_unused]] const ComputePrecision* NOALIAS const source
) {
  using CellLayout         = Layout<NumberOfDofsPerAxis, NumberOfUnknowns, NumberOfAuxiliaryVariables>;
  constexpr int FluxStride = CellLayout::PaddedNumberOfUnknowns;
  constexpr int AxisStride = CellLayout::NodesPerCell * FluxStride;

  for (int cellNode = 0; cellNode < CellLayout::NodesPerCell; cellNode++) {
    SIMD()
    for (int unknown = 0; unknown < NumberOfUnknowns; unknown++) {
      const int        entry      = cellNode * FluxStride + unknown;
      ComputePrecision derivative = -(flux[entry] + flux[entry + AxisStride]);
      if constexpr (DIMENSIONS == 3) {
        derivative -= flux[entry + 2 * AxisStride];
      }
      if constexpr (EvaluateSource) {
        derivative += source[entry];
      }
      state[cellNode * CellLayout::PaddedNumberOfData + unknown] = derivative;
    }
  }
}

/**
 * Adds the unknowns of the current Taylor coefficient, scaled by the time average factor, to the
 * time-averaged state. The auxiliary variables keep the value the seed left.
 */
template <int NumberOfDofsPerAxis, int NumberOfUnknowns, int NumberOfAuxiliaryVariables, typename ComputePrecision>
INLINE_METHOD GPU_CALLABLE_METHOD void exahype2::dg::ader::accumulateTimeAveragedState(
  ComputePrecision* NOALIAS const       timeAveragedState,
  const ComputePrecision* NOALIAS const state,
  const ComputePrecision                timeAverageFactor
) {
  using CellLayout = Layout<NumberOfDofsPerAxis, NumberOfUnknowns, NumberOfAuxiliaryVariables>;

  for (int cellNode = 0; cellNode < CellLayout::NodesPerCell; cellNode++) {
    SIMD()
    for (int unknown = 0; unknown < NumberOfUnknowns; unknown++) {
      const int entry = cellNode * CellLayout::PaddedNumberOfData + unknown;
      timeAveragedState[entry] += timeAverageFactor * state[entry];
    }
  }
}
TARGET_DECLARE_END
