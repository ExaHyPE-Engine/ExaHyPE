TARGET_DECLARE
/**
 * Adds the flux of a linear system at every node into the zeroed flux buffer, one block per axis.
 * Coefficients are evaluated at the cell centre and the start of the time step and held fixed
 * throughout the Taylor expansion.
 */
template <
  typename SolverType,
  int NumberOfDofsPerAxis,
  int NumberOfUnknowns,
  int NumberOfAuxiliaryVariables,
  typename ComputePrecision>
INLINE_METHOD GPU_CALLABLE_METHOD void exahype2::dg::ader::evaluateLinearFlux(
  ComputePrecision* NOALIAS const              flux,
  const ComputePrecision* NOALIAS const        state,
  const tarch::la::Vector<DIMENSIONS, double>& cellCentre,
  const tarch::la::Vector<DIMENSIONS, double>& cellSize,
  const double                                 timeStamp,
  const double                                 timeStepSize
) {
  using CellLayout         = Layout<NumberOfDofsPerAxis, NumberOfUnknowns, NumberOfAuxiliaryVariables>;
  constexpr int AxisStride = CellLayout::NodesPerCell * CellLayout::PaddedNumberOfUnknowns;

  for (int cellNode = 0; cellNode < CellLayout::NodesPerCell; cellNode++) {
    UNROLL(DIMENSIONS)
    for (int axis = 0; axis < DIMENSIONS; axis++) {
      SolverType::flux(
        state + cellNode * CellLayout::PaddedNumberOfData,
        cellCentre,
        cellSize,
        timeStamp,
        timeStepSize,
        axis,
        flux + cellNode * CellLayout::PaddedNumberOfUnknowns + axis * AxisStride
      );
    }
  }
}

/**
 * Adds the nonconservative product of a linear system to the flux of every axis. The gradient
 * along one axis couples one line of nodes, so the line buffer holds one differentiated line.
 */
template <
  typename SolverType,
  int NumberOfDofsPerAxis,
  int NumberOfUnknowns,
  int NumberOfAuxiliaryVariables,
  typename ComputePrecision>
INLINE_METHOD GPU_CALLABLE_METHOD void exahype2::dg::ader::addNonconservativeProduct(
  ComputePrecision* NOALIAS const                        flux,
  ComputePrecision* NOALIAS const                        stateGradient,
  const ComputePrecision* NOALIAS const                  state,
  const ComputePrecision* NOALIAS const                  derivativeOperator,
  const tarch::la::Vector<DIMENSIONS, ComputePrecision>& inverseCellSize,
  const tarch::la::Vector<DIMENSIONS, double>&           cellCentre,
  const tarch::la::Vector<DIMENSIONS, double>&           cellSize,
  const double                                           timeStamp,
  const double                                           timeStepSize
) {
  using CellLayout          = Layout<NumberOfDofsPerAxis, NumberOfUnknowns, NumberOfAuxiliaryVariables>;
  constexpr int StateStride = CellLayout::PaddedNumberOfData;
  constexpr int FluxStride  = CellLayout::PaddedNumberOfUnknowns;
  constexpr int AxisStride  = CellLayout::NodesPerCell * FluxStride;

  for (int axis = 0; axis < DIMENSIONS; axis++) {
    assertion(inverseCellSize(axis) > 0.0, inverseCellSize, axis);
  }

  ComputePrecision productValues[FluxStride] __attribute__((aligned(PEANO_WITH_ALIGNMENT)));

  const auto addProductOfLine = [&](const int firstNode, const int nodeStrideAlongAxis, const int axis) {
    for (int lineNode = 0; lineNode < NumberOfDofsPerAxis; lineNode++) {
      const int cellNode = firstNode + lineNode * nodeStrideAlongAxis;
      for (int unknown = 0; unknown < FluxStride; unknown++) {
        productValues[unknown] = static_cast<ComputePrecision>(0);
      }
      SolverType::nonconservativeProduct(
        state + cellNode * StateStride,
        stateGradient + lineNode * FluxStride,
        cellCentre,
        cellSize,
        timeStamp,
        timeStepSize,
        axis,
        productValues
      );
      SIMD(aligned(productValues : PEANO_WITH_ALIGNMENT))
      for (int unknown = 0; unknown < FluxStride; unknown++) {
        flux[cellNode * FluxStride + unknown + axis * AxisStride] += productValues[unknown];
      }
    }
  };

  for (int line = 0; line < CellLayout::NodesPerFace; line++) {
    const int firstNode = line * NumberOfDofsPerAxis;
    exahype2::dg::applyOperatorAlongAxis<
      FluxStride,
      NumberOfDofsPerAxis,
      NumberOfDofsPerAxis,
      StateStride,
      NumberOfDofsPerAxis,
      FluxStride,
      true,
      ComputePrecision,
      ComputePrecision>(stateGradient, state + firstNode * StateStride, derivativeOperator, inverseCellSize(0));
    addProductOfLine(firstNode, 1, 0);
  }

  for (int z = 0; z < CellLayout::NodesPerAxisIn3D; z++) {
    for (int x = 0; x < NumberOfDofsPerAxis; x++) {
      const int firstNode = z * NumberOfDofsPerAxis * NumberOfDofsPerAxis + x;
      exahype2::dg::applyOperatorAlongAxis<
        FluxStride,
        NumberOfDofsPerAxis,
        NumberOfDofsPerAxis,
        StateStride * NumberOfDofsPerAxis,
        NumberOfDofsPerAxis,
        FluxStride,
        true,
        ComputePrecision,
        ComputePrecision>(stateGradient, state + firstNode * StateStride, derivativeOperator, inverseCellSize(1));
      addProductOfLine(firstNode, NumberOfDofsPerAxis, 1);
    }
  }

  if constexpr (DIMENSIONS == 3) {
    for (int line = 0; line < NumberOfDofsPerAxis * NumberOfDofsPerAxis; line++) {
      exahype2::dg::applyOperatorAlongAxis<
        FluxStride,
        NumberOfDofsPerAxis,
        NumberOfDofsPerAxis,
        StateStride * NumberOfDofsPerAxis * NumberOfDofsPerAxis,
        NumberOfDofsPerAxis,
        FluxStride,
        true,
        ComputePrecision,
        ComputePrecision>(
        stateGradient,
        state + line * StateStride,
        derivativeOperator,
        inverseCellSize(DIMENSIONS - 1)
      );
      addProductOfLine(line, NumberOfDofsPerAxis * NumberOfDofsPerAxis, DIMENSIONS - 1);
    }
  }
}

/**
 * Multiplies the flux of every node and axis by the material parameter matrix of the solver.
 */
template <
  typename SolverType,
  int NumberOfDofsPerAxis,
  int NumberOfUnknowns,
  int NumberOfAuxiliaryVariables,
  typename ComputePrecision>
INLINE_METHOD GPU_CALLABLE_METHOD void exahype2::dg::ader::applyMaterialParameterMatrix(
  ComputePrecision* NOALIAS const              flux,
  const ComputePrecision* NOALIAS const        state,
  const tarch::la::Vector<DIMENSIONS, double>& cellCentre,
  const tarch::la::Vector<DIMENSIONS, double>& cellSize,
  const double                                 timeStamp,
  const double                                 timeStepSize
) {
  using CellLayout         = Layout<NumberOfDofsPerAxis, NumberOfUnknowns, NumberOfAuxiliaryVariables>;
  constexpr int AxisStride = CellLayout::NodesPerCell * CellLayout::PaddedNumberOfUnknowns;

  for (int cellNode = 0; cellNode < CellLayout::NodesPerCell; cellNode++) {
    UNROLL(DIMENSIONS)
    for (int axis = 0; axis < DIMENSIONS; axis++) {
      SolverType::multiplyMaterialParameterMatrix(
        state + cellNode * CellLayout::PaddedNumberOfData,
        cellCentre,
        cellSize,
        timeStamp,
        timeStepSize,
        axis,
        flux + cellNode * CellLayout::PaddedNumberOfUnknowns + axis * AxisStride
      );
    }
  }
}

/**
 * Adds the source of a linear system at every node into the zeroed source buffer.
 */
template <
  typename SolverType,
  int NumberOfDofsPerAxis,
  int NumberOfUnknowns,
  int NumberOfAuxiliaryVariables,
  typename ComputePrecision>
INLINE_METHOD GPU_CALLABLE_METHOD void exahype2::dg::ader::evaluateLinearSource(
  ComputePrecision* NOALIAS const              source,
  const ComputePrecision* NOALIAS const        state,
  const tarch::la::Vector<DIMENSIONS, double>& cellCentre,
  const tarch::la::Vector<DIMENSIONS, double>& cellSize,
  const double                                 timeStamp,
  const double                                 timeStepSize
) {
  using CellLayout = Layout<NumberOfDofsPerAxis, NumberOfUnknowns, NumberOfAuxiliaryVariables>;

  for (int cellNode = 0; cellNode < CellLayout::NodesPerCell; cellNode++) {
    SolverType::sourceTerm(
      state + cellNode * CellLayout::PaddedNumberOfData,
      cellCentre,
      cellSize,
      timeStamp,
      timeStepSize,
      source + cellNode * CellLayout::PaddedNumberOfUnknowns
    );
  }
}
TARGET_DECLARE_END
