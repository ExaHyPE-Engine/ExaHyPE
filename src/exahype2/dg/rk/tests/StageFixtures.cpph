template <typename Element>
INLINE_METHOD peano4::dataview::FaceEnumerator<Element> exahype2::dg::rk::tests::makeFaceEnumerator(
  Element* const pool
) {
  int slots[peano4::FacesPerCell];
  for (int face = 0; face < peano4::FacesPerCell; face++) {
    slots[face] = face;
  }
  return peano4::dataview::FaceEnumerator<Element>(pool, slots, 0);
}

template <typename SolverType>
INLINE_METHOD void exahype2::dg::rk::tests::enterGridInitialisation(SolverType& solver) {
  Quadrature::initialise();
  DGMatrices::initialise();
  StageTerms::reset();
  solver.startGridInitialisationStep();
}

template <typename SolverType>
INLINE_METHOD void exahype2::dg::rk::tests::enterTimeStepping(SolverType& solver) {
  enterGridInitialisation(solver);
  solver.finishGridInitialisationStep();
  solver.startTimeStep();
}

template <typename SolverType>
INLINE_METHOD void exahype2::dg::rk::tests::advanceOneSweep(SolverType& solver) {
  solver.update(ReportedTimeStepSize, 0.0, makeCellSize()(0));
  if constexpr (SolverType::UsesAdaptiveTimeStepping) {
    solver.setMaxEigenvalue(MaxEigenvalue);
    solver.setMaxScaledEigenvalue(MaxEigenvalue);
  }
  solver.reduceLocalUpdates();
  solver.finishTimeStep();
  solver.startTimeStep();
}

INLINE_METHOD void exahype2::dg::rk::tests::StageTerms::flux(
  const double* const                                           state,
  [[maybe_unused]] const tarch::la::Vector<DIMENSIONS, double>& x,
  [[maybe_unused]] const tarch::la::Vector<DIMENSIONS, double>& h,
  const double                                                  timeStamp,
  [[maybe_unused]] const double                                 timeStepSize,
  const int                                                     direction,
  double* const                                                 fluxValues
) {
  for (int unknown = 0; unknown < NumberOfUnknowns; unknown++) {
    fluxValues[unknown] = (1.0 + direction) * state[unknown] + timeStamp;
  }
}

INLINE_METHOD double exahype2::dg::rk::tests::StageTerms::maxEigenvalue(
  [[maybe_unused]] const double* const                          state,
  [[maybe_unused]] const tarch::la::Vector<DIMENSIONS, double>& x,
  [[maybe_unused]] const tarch::la::Vector<DIMENSIONS, double>& h,
  [[maybe_unused]] const double                                 timeStamp,
  [[maybe_unused]] const double                                 timeStepSize,
  [[maybe_unused]] const int                                    direction
) {
  return MaxEigenvalue;
}

INLINE_METHOD void exahype2::dg::rk::tests::StageTerms::boundaryConditions(
  const double* const                                           inside,
  double* const                                                 outside,
  [[maybe_unused]] const tarch::la::Vector<DIMENSIONS, double>& x,
  [[maybe_unused]] const tarch::la::Vector<DIMENSIONS, double>& h,
  [[maybe_unused]] const double                                 timeStamp,
  [[maybe_unused]] const int                                    direction
) {
  for (int value = 0; value < NumberOfData; value++) {
    outside[value] = 2.0 * inside[value];
  }
}

INLINE_METHOD void exahype2::dg::rk::tests::StageTerms::riemannSolver(
  double* const                                                 leftFlux,
  double* const                                                 rightFlux,
  const double* const                                           leftState,
  const double* const                                           rightState,
  const double                                                  timeStamp,
  [[maybe_unused]] const double                                 timeStepSize,
  [[maybe_unused]] const tarch::la::Vector<DIMENSIONS, double>& faceCentre,
  [[maybe_unused]] const tarch::la::Vector<DIMENSIONS, double>& cellSize,
  const int                                                     direction,
  const bool                                                    isBoundary,
  const int                                                     faceNumber
) {
  riemannSolverCalls++;
  riemannSolverFaceNumber = faceNumber;
  riemannSolverDirection  = direction;
  riemannSolverBoundary   = isBoundary;
  riemannSolverTimeStamp  = timeStamp;

  for (int faceNode = 0; faceNode < NodesPerFace; faceNode++) {
    for (int unknown = 0; unknown < NumberOfUnknowns; unknown++) {
      leftFlux[faceNode * NumberOfUnknowns + unknown]  = leftState[faceNode * NumberOfData + unknown];
      rightFlux[faceNode * NumberOfUnknowns + unknown] = rightState[faceNode * NumberOfData + unknown];
    }
  }
}

INLINE_METHOD void exahype2::dg::rk::tests::StageTerms::reset() {
  riemannSolverCalls      = 0;
  riemannSolverFaceNumber = -1;
  riemannSolverDirection  = -1;
  riemannSolverBoundary   = false;
  riemannSolverTimeStamp  = 0.0;
  PeriodicBoundaries.reset();
}

