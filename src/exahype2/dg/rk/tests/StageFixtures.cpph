template <int Values>
INLINE_METHOD double* exahype2::dg::rk::tests::ValuePatch<Values>::data() {
  return _values;
}

template <int Values>
INLINE_METHOD const double* exahype2::dg::rk::tests::ValuePatch<Values>::data() const {
  return _values;
}

template <int Values>
INLINE_METHOD void exahype2::dg::rk::tests::ValuePatch<Values>::fill(const double value) {
  for (int entry = 0; entry < Values; entry++) {
    _values[entry] = value;
  }
}
