TARGET_DECLARE
/**
 * Writes volume contributions multiplied by the time step into the cell's unknowns.
 * Linear fluxes use the strong form.
 * Nonlinear fluxes use the weak form.
 */
template <
  typename SolverType,
  int  NumberOfDofsPerAxis,
  int  NumberOfUnknowns,
  int  NumberOfAuxiliaryVariables,
  bool IsLinear,
  bool EvaluateFlux,
  bool EvaluateDiffusiveFlux,
  bool EvaluateSource,
  bool EvaluateNonconservativeProduct,
  typename StoragePrecision,
  typename ComputePrecision>
INLINE_METHOD GPU_CALLABLE_METHOD void exahype2::dg::rk::volumeIntegral(
  const StoragePrecision* NOALIAS const        cellState,
  StoragePrecision* NOALIAS const              cellUpdate,
  const ComputePrecision* NOALIAS const        quadratureNodes,
  const ComputePrecision* NOALIAS const        massMatrixDiagonal,
  const ComputePrecision* NOALIAS const        stiffnessMatrix,
  const ComputePrecision* NOALIAS const        derivativeOperator,
  const tarch::la::Vector<DIMENSIONS, double>& cellCentre,
  const tarch::la::Vector<DIMENSIONS, double>& cellSize,
  const double                                 timeStamp,
  const double                                 timeStepSize
) {
  static_assert(EvaluateFlux or not EvaluateDiffusiveFlux, "A diffusive flux is a flux.");
  static_assert(not IsLinear or not EvaluateDiffusiveFlux, "A linear system carries no diffusive flux.");

  constexpr int NumberOfData           = NumberOfUnknowns + NumberOfAuxiliaryVariables;
  constexpr int NodesPerAxisIn3D       = (DIMENSIONS == 3) ? NumberOfDofsPerAxis : 1;
  constexpr int NodesPerFace           = NumberOfDofsPerAxis * NodesPerAxisIn3D;
  constexpr int NodesPerCell           = NumberOfDofsPerAxis * NodesPerFace;
  constexpr int GradientEntriesPerAxis = NodesPerCell * NumberOfData;

  using WeightPrecision = std::common_type_t<ComputePrecision, double>;
  using UpdatePrecision = std::common_type_t<StoragePrecision, ComputePrecision>;

  [[maybe_unused]] ComputePrecision nodeStateBuffer[NumberOfData];
  const auto                        nodeStateForCompute = [&](const int cellNode) -> const ComputePrecision* {
    if constexpr (std::is_same_v<StoragePrecision, ComputePrecision>) {
      return cellState + cellNode * NumberOfData;
    } else {
      for (int value = 0; value < NumberOfData; value++) {
        nodeStateBuffer[value] = static_cast<ComputePrecision>(cellState[cellNode * NumberOfData + value]);
      }
      return nodeStateBuffer;
    }
  };

  [[maybe_unused]] ComputePrecision volumeCoefficients[NumberOfDofsPerAxis * NumberOfDofsPerAxis];
  if constexpr (EvaluateFlux) {
    for (int row = 0; row < NumberOfDofsPerAxis; row++) {
      for (int column = 0; column < NumberOfDofsPerAxis; column++) {
        const int entry = row * NumberOfDofsPerAxis + column;
        if constexpr (IsLinear) {
          volumeCoefficients[entry] = static_cast<ComputePrecision>(
            -static_cast<WeightPrecision>(derivativeOperator[entry]) * static_cast<WeightPrecision>(timeStepSize)
          );
        } else {
          volumeCoefficients[entry] = static_cast<ComputePrecision>(
            static_cast<WeightPrecision>(stiffnessMatrix[entry]) * static_cast<WeightPrecision>(timeStepSize)
            / static_cast<WeightPrecision>(massMatrixDiagonal[row])
          );
        }
      }
    }
  }

  if constexpr (not EvaluateFlux) {
    for (int entry = 0; entry < NodesPerCell * NumberOfUnknowns; entry++) {
      cellUpdate[entry] = static_cast<StoragePrecision>(0);
    }
  }

  [[maybe_unused]] ComputePrecision nodalGradients[EvaluateDiffusiveFlux ? DIMENSIONS * GradientEntriesPerAxis : 1];
  if constexpr (EvaluateDiffusiveFlux) {
    exahype2::dg::computeNodalGradients<
      NumberOfDofsPerAxis,
      NumberOfUnknowns,
      NumberOfAuxiliaryVariables,
      StoragePrecision,
      ComputePrecision>(nodalGradients, cellState, derivativeOperator, cellSize);
  }

  for (int direction = 0; direction < DIMENSIONS; direction++) {
    assertion(cellSize(direction) > 0.0, cellSize, direction);
    int lowerAxesStride = 1;
    for (int axis = 0; axis < direction; axis++) {
      lowerAxesStride *= NumberOfDofsPerAxis;
    }

    for (int line = 0; line < NodesPerFace; line++) {
      const int lowerAxesIndex  = line % lowerAxesStride;
      const int higherAxesIndex = line / lowerAxesStride;
      const int firstCellNode   = higherAxesIndex * NumberOfDofsPerAxis * lowerAxesStride + lowerAxesIndex;

      if constexpr (EvaluateFlux) {
        ComputePrecision fluxValues[NumberOfDofsPerAxis * NumberOfUnknowns];
        for (int normalIndex = 0; normalIndex < NumberOfDofsPerAxis; normalIndex++) {
          const int                          cellNode = firstCellNode + normalIndex * lowerAxesStride;
          tarch::la::Vector<DIMENSIONS, int> nodeIndex;
          int                                remainder = cellNode;
          for (int axis = 0; axis < DIMENSIONS; axis++) {
            nodeIndex(axis) = remainder % NumberOfDofsPerAxis;
            remainder /= NumberOfDofsPerAxis;
          }
          if constexpr (EvaluateDiffusiveFlux) {
            const ComputePrecision* NOALIAS nodeGradients[DIMENSIONS];
            for (int axis = 0; axis < DIMENSIONS; axis++) {
              nodeGradients[axis] = nodalGradients + axis * GradientEntriesPerAxis + cellNode * NumberOfData;
            }
            SolverType::flux(
              nodeStateForCompute(cellNode),
              nodeGradients,
              exahype2::dg::getQuadraturePoint(cellCentre, cellSize, nodeIndex, quadratureNodes),
              cellSize,
              timeStamp,
              timeStepSize,
              direction,
              fluxValues + normalIndex * NumberOfUnknowns
            );
          } else {
            SolverType::flux(
              nodeStateForCompute(cellNode),
              exahype2::dg::getQuadraturePoint(cellCentre, cellSize, nodeIndex, quadratureNodes),
              cellSize,
              timeStamp,
              timeStepSize,
              direction,
              fluxValues + normalIndex * NumberOfUnknowns
            );
          }
        }

        const auto integrateFluxLine = [&](auto lowerAxesStrideConstant, auto overwriteResultConstant) {
          constexpr int  LowerAxesStride = decltype(lowerAxesStrideConstant)::value;
          constexpr bool OverwriteResult = decltype(overwriteResultConstant)::value;
          exahype2::dg::applyOperatorAlongAxis<
            NumberOfUnknowns,
            NumberOfDofsPerAxis,
            NumberOfDofsPerAxis,
            NumberOfUnknowns,
            NumberOfDofsPerAxis,
            NumberOfUnknowns * LowerAxesStride,
            OverwriteResult,
            StoragePrecision,
            ComputePrecision>(
            cellUpdate + firstCellNode * NumberOfUnknowns,
            fluxValues,
            volumeCoefficients,
            1.0 / cellSize(direction)
          );
        };
        if (direction == 0) {
          integrateFluxLine(std::integral_constant<int, 1>{}, std::true_type{});
        } else if (direction == 1) {
          integrateFluxLine(std::integral_constant<int, NumberOfDofsPerAxis>{}, std::false_type{});
        } else {
          integrateFluxLine(
            std::integral_constant<int, NumberOfDofsPerAxis * NumberOfDofsPerAxis>{},
            std::false_type{}
          );
        }
      }

      if constexpr (EvaluateNonconservativeProduct) {
        ComputePrecision stateLine[NumberOfDofsPerAxis * NumberOfData];
        for (int normalIndex = 0; normalIndex < NumberOfDofsPerAxis; normalIndex++) {
          const int cellNode = firstCellNode + normalIndex * lowerAxesStride;
          for (int value = 0; value < NumberOfData; value++) {
            stateLine[normalIndex * NumberOfData + value] =
              static_cast<ComputePrecision>(cellState[cellNode * NumberOfData + value]);
          }
        }

        ComputePrecision gradients[NumberOfDofsPerAxis * NumberOfData];
        exahype2::dg::applyOperatorAlongAxis<
          NumberOfData,
          NumberOfDofsPerAxis,
          NumberOfDofsPerAxis,
          NumberOfData,
          NumberOfDofsPerAxis,
          NumberOfData,
          true,
          ComputePrecision,
          ComputePrecision>(gradients, stateLine, derivativeOperator, 1.0 / cellSize(direction));

        for (int normalIndex = 0; normalIndex < NumberOfDofsPerAxis; normalIndex++) {
          const int                          cellNode = firstCellNode + normalIndex * lowerAxesStride;
          tarch::la::Vector<DIMENSIONS, int> nodeIndex;
          int                                remainder = cellNode;
          for (int axis = 0; axis < DIMENSIONS; axis++) {
            nodeIndex(axis) = remainder % NumberOfDofsPerAxis;
            remainder /= NumberOfDofsPerAxis;
          }

          ComputePrecision nonconservativeProduct[NumberOfUnknowns];
          SolverType::nonconservativeProduct(
            nodeStateForCompute(cellNode),
            gradients + normalIndex * NumberOfData,
            exahype2::dg::getQuadraturePoint(cellCentre, cellSize, nodeIndex, quadratureNodes),
            cellSize,
            timeStamp,
            timeStepSize,
            direction,
            nonconservativeProduct
          );
          SIMD()
          for (int unknown = 0; unknown < NumberOfUnknowns; unknown++) {
            cellUpdate[cellNode * NumberOfUnknowns + unknown] = static_cast<StoragePrecision>(
              static_cast<UpdatePrecision>(cellUpdate[cellNode * NumberOfUnknowns + unknown])
              - static_cast<UpdatePrecision>(timeStepSize)
                * static_cast<UpdatePrecision>(nonconservativeProduct[unknown])
            );
          }
        }
      }
    }
  }

  if constexpr (EvaluateSource) {
    for (int cellNode = 0; cellNode < NodesPerCell; cellNode++) {
      tarch::la::Vector<DIMENSIONS, int> nodeIndex;
      int                                remainder = cellNode;
      for (int axis = 0; axis < DIMENSIONS; axis++) {
        nodeIndex(axis) = remainder % NumberOfDofsPerAxis;
        remainder /= NumberOfDofsPerAxis;
      }

      ComputePrecision sourceValues[NumberOfUnknowns];
      SolverType::sourceTerm(
        nodeStateForCompute(cellNode),
        exahype2::dg::getQuadraturePoint(cellCentre, cellSize, nodeIndex, quadratureNodes),
        cellSize,
        timeStamp,
        timeStepSize,
        sourceValues
      );
      SIMD()
      for (int unknown = 0; unknown < NumberOfUnknowns; unknown++) {
        cellUpdate[cellNode * NumberOfUnknowns + unknown] = static_cast<StoragePrecision>(
          static_cast<UpdatePrecision>(cellUpdate[cellNode * NumberOfUnknowns + unknown])
          + static_cast<UpdatePrecision>(timeStepSize) * static_cast<UpdatePrecision>(sourceValues[unknown])
        );
      }
    }
  }
}
TARGET_DECLARE_END
