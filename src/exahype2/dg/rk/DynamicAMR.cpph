template <typename T>
INLINE_METHOD exahype2::dg::rk::StageEstimatesRestriction<T>::StageEstimatesRestriction(
  const double* const restrictionMatrix1D,
  const int           numberOfDofsPerAxis,
  const int           numberOfUnknowns,
  const int           numberOfStages,
  const int           valuesPerStage
) :
  _restrictionMatrix1D(restrictionMatrix1D),
  _numberOfDofsPerAxis(numberOfDofsPerAxis),
  _numberOfUnknowns(numberOfUnknowns),
  _numberOfStages(numberOfStages),
  _valuesPerStage(valuesPerStage) {
  assertion(restrictionMatrix1D != nullptr);
  assertion(numberOfDofsPerAxis > 0, numberOfDofsPerAxis);
  assertion(numberOfUnknowns > 0, numberOfUnknowns);
  assertion(numberOfStages > 0, numberOfStages);
  assertion(valuesPerStage > 0, valuesPerStage);
}

template <typename T>
INLINE_METHOD void exahype2::dg::rk::StageEstimatesRestriction<T>::operator()(
  exahype2::amr::ChildDataStage<T>& stage,
  T* const NOALIAS                  coarseGridValues
) const {
  const int     entriesPerTransferMatrix = _numberOfDofsPerAxis * _numberOfDofsPerAxis;
  const double* restrictionMatrixPerInterval[peano4::sfc::ActiveCurve::SubdivisionFactor];
  for (int interval = 0; interval < peano4::sfc::ActiveCurve::SubdivisionFactor; interval++) {
    restrictionMatrixPerInterval[interval] = _restrictionMatrix1D + interval * entriesPerTransferMatrix;
  }

  const T* stagedChildren[peano4::sfc::ActiveCurve::ChildrenPerCell];
  for (int rungeKuttaStage = 0; rungeKuttaStage < _numberOfStages; rungeKuttaStage++) {
    const int stageOffset = rungeKuttaStage * _valuesPerStage;
    for (int child = 0; child < peano4::sfc::ActiveCurve::ChildrenPerCell; child++) {
      assertion(stage.hasChild(coarseGridValues, child), child, rungeKuttaStage);
      stagedChildren[child] = stage.child(coarseGridValues, child) + stageOffset;
    }
    exahype2::amr::restrictCellFromChildren(
      coarseGridValues + stageOffset,
      stagedChildren,
      restrictionMatrixPerInterval,
      _numberOfDofsPerAxis,
      _numberOfUnknowns
    );
  }
  stage.discard(coarseGridValues);
}

/**
 * Restricts the trace of a hanging face onto the coarse face and evaluates the flux of the
 * restricted side.
 *
 * The subfaces below one coarse face stay on one tree, so the coarse trace is complete once
 * the last subface has staged its half. The flux the coarse face then carries is the one its
 * two adjacent cells read, so it is evaluated on the coarse face centre and the coarse cell size.
 */
template <
  typename SolverType,
  bool EvaluateFlux,
  bool EvaluateDiffusiveFlux,
  typename Quadrature,
  typename DGMatrices,
  typename FaceLabel,
  typename T>
INLINE_METHOD void exahype2::dg::rk::restrictHangingFaceTrace(
  const peano4::dataview::FaceMarker& marker,
  exahype2::amr::ChildDataStage<T>&   stage,
  T* const NOALIAS                    coarseFaceState,
  const T* const NOALIAS              fineFaceState,
  T* const NOALIAS                    coarseFaceRiemannSolution,
  FaceLabel&                          coarseFaceLabel,
  const FaceLabel&                    fineFaceLabel,
  const double                        timeStepSize
) {
  constexpr int NumberOfDofsPerAxis    = SolverType::DGOrder + 1;
  constexpr int NumberOfData           = SolverType::NumberOfUnknowns + SolverType::NumberOfAuxiliaryVariables;
  constexpr int EntriesPerFaceSide     = exahype2::dg::NodesPerFace<NumberOfDofsPerAxis> * NumberOfData;
  constexpr int FluxEntriesPerFaceSide = exahype2::dg::NodesPerFace<NumberOfDofsPerAxis> * SolverType::NumberOfUnknowns;
  constexpr int SubdivisionFactor      = peano4::sfc::ActiveCurve::SubdivisionFactor;

  assertion(coarseFaceState != nullptr);
  assertion(fineFaceState != nullptr);
  assertion(coarseFaceRiemannSolution != nullptr);
  assertion(std::isfinite(timeStepSize) and timeStepSize >= 0.0, timeStepSize, marker.toString());

  const int  restrictedSide       = marker.getSelectedFaceNumber() < DIMENSIONS ? 1 : 0;
  T* const   restrictedCoarseHalf = coarseFaceState + restrictedSide * EntriesPerFaceSide;
  const bool restrictionCompleted = exahype2::amr::stageSubfaceForRestriction(
    marker,
    stage,
    restrictedCoarseHalf,
    fineFaceState + restrictedSide * EntriesPerFaceSide
  );
  if (restrictionCompleted) {
    exahype2::amr::restrictFaceFromStagedSubfaces(
      stage,
      restrictedCoarseHalf,
      restrictedCoarseHalf,
      exahype2::dg::FaceRestriction<T>(DGMatrices::WeightedRestrictionMatrix1D, NumberOfDofsPerAxis, NumberOfData)
    );
  }

  exahype2::amr::copyUpdatedTimeStampOntoCoarseFace(coarseFaceLabel, fineFaceLabel, restrictedSide);

  if (restrictionCompleted) {
    const int      direction       = marker.getSelectedFaceNumber() % DIMENSIONS;
    const T* const coarseLeftTrace = coarseFaceState;

    tarch::la::Vector<DIMENSIONS, double> coarseFaceCentre = marker.getX();
    tarch::la::Vector<DIMENSIONS, double> coarseCellSize   = marker.getH();
    for (int axis = 0; axis < DIMENSIONS; axis++) {
      if (axis != direction) {
        coarseFaceCentre(axis) +=
          (0.5 * (SubdivisionFactor - 1) - marker.getRelativePositionWithinFatherCell()(axis)) * marker.getH()(axis);
      }
      coarseCellSize(axis) *= SubdivisionFactor;
    }

    exahype2::dg::evaluateFluxOnFace<
      SolverType,
      NumberOfDofsPerAxis,
      SolverType::NumberOfUnknowns,
      SolverType::NumberOfAuxiliaryVariables,
      EvaluateFlux,
      EvaluateDiffusiveFlux>(
      coarseFaceRiemannSolution + restrictedSide * FluxEntriesPerFaceSide,
      coarseLeftTrace,
      coarseLeftTrace + EntriesPerFaceSide,
      restrictedSide,
      Quadrature::QuadraturePoints1D,
      coarseFaceCentre,
      coarseCellSize,
      coarseFaceLabel.getUpdatedTimeStamp(restrictedSide),
      timeStepSize,
      direction
    );
  }
}

/**
 * Empties the buffers of a created face and gives it the time stamp of the parent cell.
 */
template <typename CellLabel, typename FaceLabel, typename FaceStateRecord, typename FaceFluxRecord>
INLINE_METHOD void exahype2::dg::rk::createFace(
  FaceStateRecord& fineFaceState,
  FaceFluxRecord&  fineFaceRiemannSolution,
  const CellLabel& coarseCellLabel,
  FaceLabel&       fineFaceLabel
) {
  exahype2::amr::clearTransferRecord(fineFaceState);
  exahype2::amr::clearTransferRecord(fineFaceRiemannSolution);
  exahype2::amr::setFaceTimeStampsFromCoarseCell(coarseCellLabel, fineFaceLabel);
}

/**
 * Fills the buffers of a created child from its parent.
 *
 * The grid initialisation carries no stage in flight, so the stage estimates of a cell it
 * creates start at zero.
 */
template <
  typename SolverType,
  typename DGMatrices,
  typename CellLabel,
  typename CellStateRecord,
  typename CellStageRecord>
INLINE_METHOD void exahype2::dg::rk::createCell(
  const peano4::dataview::CellMarker& marker,
  const SolverType&                   solver,
  const CellStateRecord&              coarseCellState,
  CellStateRecord&                    fineCellState,
  const CellStageRecord&              coarseStageEstimates,
  CellStageRecord&                    fineStageEstimates,
  const CellLabel&                    coarseCellLabel,
  CellLabel&                          fineCellLabel
) {
  using StoragePrecision = std::remove_pointer_t<decltype(fineCellState.data())>;

  constexpr int NumberOfDofsPerAxis = SolverType::DGOrder + 1;
  constexpr int NumberOfData        = SolverType::NumberOfUnknowns + SolverType::NumberOfAuxiliaryVariables;
  constexpr int ValuesPerStage      = exahype2::dg::NodesPerCell<NumberOfDofsPerAxis> * SolverType::NumberOfUnknowns;

  const exahype2::dg::NodalCellInterpolation<StoragePrecision> prolongState(
    DGMatrices::InterpolationMatrix1D,
    NumberOfDofsPerAxis,
    NumberOfData
  );
  exahype2::amr::prolongCellIntoChild(marker, coarseCellState.data(), fineCellState.data(), prolongState);

  if (solver.getSolverState() != SolverType::SolverState::GridInitialisation) {
    const exahype2::dg::NodalCellInterpolation<StoragePrecision> prolongStage(
      DGMatrices::InterpolationMatrix1D,
      NumberOfDofsPerAxis,
      SolverType::NumberOfUnknowns
    );
    for (int rungeKuttaStage = 0; rungeKuttaStage < SolverType::NumberOfRungeKuttaStages; rungeKuttaStage++) {
      const int stageOffset = rungeKuttaStage * ValuesPerStage;
      exahype2::amr::prolongCellIntoChild(
        marker,
        coarseStageEstimates.data() + stageOffset,
        fineStageEstimates.data() + stageOffset,
        prolongStage
      );
    }
  } else {
    exahype2::amr::clearTransferRecord(fineStageEstimates);
  }

  exahype2::amr::copyCellLabelIntoChild(coarseCellLabel, fineCellLabel);
}

/**
 * Restricts the buffers of a destroyed child onto its parent.
 *
 * The load balancer keeps the siblings that can coarsen on one tree, so every sibling set
 * completes where it started.
 */
template <typename SolverType, typename DGMatrices, typename CellLabel, typename FaceLabelEnumerator, typename T>
INLINE_METHOD void exahype2::dg::rk::destroyCell(
  const peano4::dataview::CellMarker& marker,
  exahype2::amr::ChildDataStage<T>&   cellStateStage,
  exahype2::amr::ChildDataStage<T>&   stageEstimatesStage,
  T* const NOALIAS                    coarseCellState,
  const T* const NOALIAS              fineCellState,
  T* const NOALIAS                    coarseStageEstimates,
  const T* const NOALIAS              fineStageEstimates,
  const FaceLabelEnumerator&          coarseFaceLabels,
  CellLabel&                          coarseCellLabel,
  const CellLabel&                    fineCellLabel
) {
  constexpr int NumberOfDofsPerAxis = SolverType::DGOrder + 1;
  constexpr int NumberOfData        = SolverType::NumberOfUnknowns + SolverType::NumberOfAuxiliaryVariables;
  constexpr int ValuesPerStage      = exahype2::dg::NodesPerCell<NumberOfDofsPerAxis> * SolverType::NumberOfUnknowns;

  const exahype2::dg::CellRestriction<T> restrictNodalCell(
    DGMatrices::WeightedRestrictionMatrix1D,
    NumberOfDofsPerAxis,
    NumberOfData
  );
  exahype2::amr::restrictChildrenIntoCell(marker, cellStateStage, coarseCellState, fineCellState, restrictNodalCell);
  exahype2::amr::restrictChildrenIntoCell(
    marker,
    stageEstimatesStage,
    coarseStageEstimates,
    fineStageEstimates,
    exahype2::dg::rk::StageEstimatesRestriction<T>(
      DGMatrices::WeightedRestrictionMatrix1D,
      NumberOfDofsPerAxis,
      SolverType::NumberOfUnknowns,
      SolverType::NumberOfRungeKuttaStages,
      ValuesPerStage
    )
  );
  exahype2::amr::requestDataTransferOnOwnSides(coarseFaceLabels);
  exahype2::amr::raiseCellTimeStampsFromChild(coarseCellLabel, fineCellLabel);
}

/**
 * Rebuilds the face data of a cell that will not be refined.
 *
 * A cell that owes data to a face integrates its volume again, and every cell that will not be
 * refined projects the stage onto its faces, so both sides of a changed face read the same trace.
 */
template <
  typename SolverType,
  bool IsLinear,
  bool EvaluateFlux,
  bool EvaluateDiffusiveFlux,
  bool EvaluateSource,
  bool EvaluateNonconservativeProduct,
  typename Quadrature,
  typename DGMatrices,
  typename ButcherTableau,
  typename CellLabel,
  typename FaceLabel,
  typename FaceStateRecord,
  typename FaceFluxRecord,
  typename T>
INLINE_METHOD void exahype2::dg::rk::projectStageAfterTransfer(
  const peano4::dataview::CellMarker&                      marker,
  const SolverType&                                        solver,
  CellLabel&                                               cellLabel,
  const peano4::dataview::FaceEnumerator<FaceLabel>&       faceLabels,
  const peano4::dataview::FaceEnumerator<FaceStateRecord>& faceStates,
  const peano4::dataview::FaceEnumerator<FaceFluxRecord>&  faceFluxes,
  const T* const NOALIAS                                   cellState,
  T* const NOALIAS                                         stageEstimates
) {
  constexpr int NumberOfDofsPerAxis = SolverType::DGOrder + 1;
  constexpr int NumberOfData        = SolverType::NumberOfUnknowns + SolverType::NumberOfAuxiliaryVariables;
  constexpr int NodesPerCell        = exahype2::dg::NodesPerCell<NumberOfDofsPerAxis>;
  constexpr int ValuesPerStage      = NodesPerCell * SolverType::NumberOfUnknowns;

  assertion(cellState != nullptr);
  assertion(stageEstimates != nullptr);

  const int rungeKuttaStage = solver.getRkStageAfterDynamicMeshRefinement();
  assertion(
    rungeKuttaStage >= 0 and rungeKuttaStage < SolverType::NumberOfRungeKuttaStages,
    rungeKuttaStage,
    marker.toString()
  );
  const bool requiresDataTransfer = exahype2::amr::awaitsDataTransfer(marker, faceLabels);

  if (not marker.willBeRefined() and solver.getSolverState() != SolverType::SolverState::GridInitialisation) {
    const double timeStepSize = cellLabel.getTimeStepSize();
    const double stageTimeStamp =
      cellLabel.getTimeStamp() + ButcherTableau::RelativeTimeStepSizes[rungeKuttaStage] * timeStepSize;

    T* const combination = exahype2::dg::rk::stageScratch<NodesPerCell * NumberOfData, T>();
    exahype2::dg::rk::linearCombinationOfEstimates<
      SolverType::NumberOfRungeKuttaStages,
      NumberOfDofsPerAxis,
      SolverType::NumberOfUnknowns,
      SolverType::NumberOfAuxiliaryVariables>(
      rungeKuttaStage,
      cellState,
      stageEstimates,
      combination,
      ButcherTableau::ButcherMatrix
    );

    if (requiresDataTransfer) {
      exahype2::dg::rk::volumeIntegral<
        SolverType,
        NumberOfDofsPerAxis,
        SolverType::NumberOfUnknowns,
        SolverType::NumberOfAuxiliaryVariables,
        IsLinear,
        EvaluateFlux,
        EvaluateDiffusiveFlux,
        EvaluateSource,
        EvaluateNonconservativeProduct>(
        combination,
        stageEstimates + rungeKuttaStage * ValuesPerStage,
        Quadrature::QuadraturePoints1D,
        DGMatrices::MassMatrixDiagonal1D,
        DGMatrices::StiffnessOperator1D,
        DGMatrices::DerivativeOperator1D,
        marker.getX(),
        marker.getH(),
        stageTimeStamp,
        timeStepSize
      );
    }

    exahype2::dg::rk::projectStageOntoFaces<SolverType, EvaluateFlux, EvaluateDiffusiveFlux, Quadrature, DGMatrices>(
      marker,
      cellLabel,
      faceLabels,
      faceStates,
      faceFluxes,
      combination,
      stageTimeStamp
    );
  }

  if (not marker.willBeRefined() and not marker.hasBeenRefined()) {
    cellLabel.setRequiresCriterionEvaluation(false);
  }
}
