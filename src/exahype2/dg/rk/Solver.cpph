#include "exahype2/LevelJumps.h"
#include "tarch/Assertions.h"
#include "tarch/accelerator/ParallelFor.h"
#include "tarch/accelerator/ParallelReduce.h"
#include "tarch/accelerator/Range.h"
#include "tarch/accelerator/Reducer.h"
#include "tarch/accelerator/Scratch.h"

template <typename Derived, typename StoragePrecision, typename ComputePrecision>
INLINE_METHOD exahype2::dg::rk::Solver<Derived, StoragePrecision, ComputePrecision>::Solver(
  const double                                     timeStepFactor,
  const std::string&                               name,
  const std::vector<exahype2::plotter::DataField>& plottedFields
) :
  Base(timeStepFactor, name, plottedFields) {}

template <typename Derived, typename StoragePrecision, typename ComputePrecision>
template <typename RuntimeParameters>
INLINE_METHOD void
exahype2::dg::rk::Solver<Derived, StoragePrecision, ComputePrecision>::allocate(
  const peano4::CellConnectivity& cellConnectivity,
  const RuntimeParameters&        parameters
) {
  Base::allocate(cellConnectivity, parameters);
  _estimates.reserve(cellConnectivity.getNumberOfSlots());
  reserveStageScratch(cellConnectivity);
}

template <typename Derived, typename StoragePrecision, typename ComputePrecision>
INLINE_METHOD void
exahype2::dg::rk::Solver<Derived, StoragePrecision, ComputePrecision>::reserveStageScratch(
  const peano4::CellConnectivity& cellConnectivity
) {
  const auto chunks =
    static_cast<std::size_t>(tarch::accelerator::getNumberOfScratchChunks(this->getNumberOfCells(cellConnectivity)));
  const auto size = chunks * static_cast<std::size_t>(Stage::StateValuesPerCell);
  if (_stageScratch.getSize() < size) {
    _stageScratch.allocate(size);
  }
}

template <typename Derived, typename StoragePrecision, typename ComputePrecision>
INLINE_METHOD void
exahype2::dg::rk::Solver<Derived, StoragePrecision, ComputePrecision>::release() {
  Base::release();
  _estimates.release();
  _stageScratch.release();
}

template <typename Derived, typename StoragePrecision, typename ComputePrecision>
INLINE_METHOD tarch::AllocatedBytes
exahype2::dg::rk::Solver<Derived, StoragePrecision, ComputePrecision>::getAllocatedBytes() const {
  return Base::getAllocatedBytes() + _estimates.getAllocatedBytes() + _stageScratch.getAllocatedBytes();
}

/**
 * Advances every cell by the time step size that the previous time step proposed. The open of a
 * stage and the final combination add the face integrals of the stage before. Both read the
 * restricted fluxes that the ranks exchange in that stage.
 */
template <typename Derived, typename StoragePrecision, typename ComputePrecision>
template <typename RuntimeParameters>
INLINE_METHOD void
exahype2::dg::rk::Solver<Derived, StoragePrecision, ComputePrecision>::performTimeStep(
  const peano4::CellConnectivity& cellConnectivity,
  exahype2::RefinementRequests&   requests,
  const RuntimeParameters&        parameters
) {
  using Tableau               = typename Stage::Tableau;
  constexpr auto Local        = peano4::Adjacency::Local;
  constexpr auto Remote       = peano4::Adjacency::Remote;
  const double   timeStepSize = this->_timeStepping.startTimeStep();

  const typename Base::InterpolateHalves interpolateHalves{
    this->_faceStates.getView(),
    this->_faceFluxes.getView(),
    DGMatrices<double>::ProlongationMatrix1D
  };
  const typename Base::RestrictFluxes restrictFluxes{
    cellConnectivity.onDevice(),
    this->_faceFluxes.getView(),
    DGMatrices<double>::WeightedRestrictionMatrix1D
  };
  for (int stage = 0; stage < NumberOfRungeKuttaStages; stage++) {
    const double stageTimeStamp = this->_timeStepping.getTimeStamp() + Tableau::Nodes[stage] * timeStepSize;
    if (stage > 0) {
      this->_restrictedFluxExchange.wait();
    }
    openStage(cellConnectivity, Remote, stage, timeStepSize, parameters);
    this->_stateExchange.post();
    this->_fluxExchange.post();
    openStage(cellConnectivity, Local, stage, timeStepSize, parameters);
    this->interpolateCoarseFaces(cellConnectivity, Local, interpolateHalves);
    this->solveRiemannProblems(cellConnectivity, Local, stageTimeStamp, timeStepSize, parameters);
    this->_stateExchange.wait();
    this->_fluxExchange.wait();
    this->interpolateCoarseFaces(cellConnectivity, Remote, interpolateHalves);
    this->solveRiemannProblems(cellConnectivity, Remote, stageTimeStamp, timeStepSize, parameters);
    this->restrictFineFaces(cellConnectivity, Remote, restrictFluxes);
    this->_restrictedFluxExchange.post();
    this->restrictFineFaces(cellConnectivity, Local, restrictFluxes);
  }
  this->_restrictedFluxExchange.wait();

  const auto statistics = combineFinalState(cellConnectivity, timeStepSize, parameters);
  this->closeTimeStep(timeStepSize, statistics);
  this->measureError(cellConnectivity, parameters);
  this->voteOnRefinement(cellConnectivity, requests, parameters);
}

/**
 * Moves the solution through the regrid and grows the estimate pool with the slot range.
 */
template <typename Derived, typename StoragePrecision, typename ComputePrecision>
template <typename RuntimeParameters>
INLINE_METHOD void
exahype2::dg::rk::Solver<Derived, StoragePrecision, ComputePrecision>::regrid(
  const peano4::CellConnectivity& cellConnectivity,
  const peano4::Regrid&           regrid,
  exahype2::RefinementRequests&   requests,
  const RuntimeParameters&        parameters
) {
  Base::regrid(cellConnectivity, regrid, requests, parameters);
  _estimates.reserve(regrid.newNumberOfSlots);
  reserveStageScratch(cellConnectivity);
}

/**
 * Returns the time step size of the CFL condition of Cockburn and Shu on the scaled wave
 * speed, damped by the square of the polynomial degree.
 */
template <typename Derived, typename StoragePrecision, typename ComputePrecision>
INLINE_METHOD double
exahype2::dg::rk::Solver<Derived, StoragePrecision, ComputePrecision>::getTimeStepSizeFromCFL() const {
  if constexpr (UsesAdaptiveTimeStepping) {
    constexpr double CockburnShuDamping = 1.0 / (2.0 * Derived::RungeKuttaOrder - 1.0);
    constexpr double MeshDamping        = Derived::DGOrder == 0 ? 1.0 : 1.0 / (Derived::DGOrder * Derived::DGOrder);
    return this->_timeStepping.getFactor() * CockburnShuDamping * MeshDamping
      / this->_timeStepping.getMaxScaledEigenvalueOfThisStep();
  } else {
    return 0.0;
  }
}

/**
 * Returns the normalised fraction of the admissible mesh width a fixed rule advances by,
 * damped by the square of the Runge-Kutta order.
 */
template <typename Derived, typename StoragePrecision, typename ComputePrecision>
INLINE_METHOD double
exahype2::dg::rk::Solver<Derived, StoragePrecision, ComputePrecision>::getFixedTimeStepSize() const {
  const double maxAdmissibleMeshWidth = this->_timeStepping.getLimits().maxAdmissibleMeshWidth;
  ASSERTION(std::isfinite(maxAdmissibleMeshWidth) and maxAdmissibleMeshWidth > 0.0, maxAdmissibleMeshWidth);
  return this->_timeStepping.getFactor() * this->_timeStepping.getMinMeshWidth() / maxAdmissibleMeshWidth
    / (Derived::RungeKuttaOrder * Derived::RungeKuttaOrder);
}

template <typename Derived, typename StoragePrecision, typename ComputePrecision>
INLINE_METHOD const typename exahype2::dg::rk::Solver<Derived, StoragePrecision, ComputePrecision>::EstimatePool&
exahype2::dg::rk::Solver<Derived, StoragePrecision, ComputePrecision>::getEstimates() const {
  return _estimates;
}

/**
 * Adds the face integrals of the stage before to the estimate of every local or remote cell. Writes
 * the volume terms of the stage state into the estimate of the stage and the face states and fluxes
 * of that state into the own face halves of the cell.
 */
template <typename Derived, typename StoragePrecision, typename ComputePrecision>
template <typename RuntimeParameters>
INLINE_METHOD void
exahype2::dg::rk::Solver<Derived, StoragePrecision, ComputePrecision>::openStage(
  const peano4::CellConnectivity& cellConnectivity,
  const peano4::Adjacency         adjacency,
  const int                       stage,
  const double                    timeStepSize,
  const RuntimeParameters&        parameters
) {
  using Tableau    = typename Stage::Tableau;
  const auto cells = this->getCells(cellConnectivity, adjacency);
  ASSERTION(stage >= 0 and stage < NumberOfRungeKuttaStages, stage);
  ASSERTION(
    _stageScratch.getSize()
    >= static_cast<std::size_t>(tarch::accelerator::getNumberOfScratchChunks(cells.size)) * Stage::StateValuesPerCell
  );
  const auto stageIndex = static_cast<std::size_t>(stage);
  tarch::accelerator::parallelFor(
    tarch::accelerator::Range(cells.size),
    exahype2::dg::rk::OpenStage<Derived, StoragePrecision, ComputePrecision>{
      cellConnectivity.onDevice(),
      cells,
      std::as_const(this->_solution).getView(),
      _estimates.getView(),
      this->_faceStates.getView(),
      this->_faceFluxes.getView(),
      Tableau::Matrix[stageIndex],
      Quadrature<ComputePrecision>::QuadraturePoints1D,
      DGMatrices<ComputePrecision>::DerivativeOperator1D,
      Quadrature<ComputePrecision>::QuadratureWeightsOnFace,
      Quadrature<ComputePrecision>::InverseQuadratureWeightsInCell,
      DGMatrices<ComputePrecision>::BasisFunctionValuesLeft1D,
      DGMatrices<ComputePrecision>::BasisFunctionValuesRight1D,
      stage,
      this->_timeStepping.getTimeStamp() + Tableau::Nodes[stageIndex] * timeStepSize,
      timeStepSize,
      _stageScratch.getData(),
      parameters
    }
  );
}

/**
 * Adds the face integrals of the last stage to its estimate and the weighted estimates to the
 * solution of every cell. Returns the wave-speed maxima of the new solution.
 */
template <typename Derived, typename StoragePrecision, typename ComputePrecision>
template <typename RuntimeParameters>
INLINE_METHOD exahype2::dg::MaxEigenvalueStatistics
exahype2::dg::rk::Solver<Derived, StoragePrecision, ComputePrecision>::combineFinalState(
  const peano4::CellConnectivity& cellConnectivity,
  const double                    timeStepSize,
  const RuntimeParameters&        parameters
) {
  using Tableau                               = typename Stage::Tableau;
  const auto                            cells = this->getCells(cellConnectivity);
  exahype2::dg::MaxEigenvalueStatistics statistics;
  tarch::accelerator::parallelReduce(
    tarch::accelerator::Range(cells.size),
    exahype2::dg::rk::CombineStages<Derived, StoragePrecision, ComputePrecision>{
      cellConnectivity.onDevice(),
      cells,
      this->_solution.getView(),
      _estimates.getView(),
      std::as_const(this->_faceFluxes).getView(),
      Tableau::Weights,
      Quadrature<ComputePrecision>::QuadratureWeightsOnFace,
      Quadrature<ComputePrecision>::InverseQuadratureWeightsInCell,
      DGMatrices<ComputePrecision>::BasisFunctionValuesLeft1D,
      DGMatrices<ComputePrecision>::BasisFunctionValuesRight1D,
      Quadrature<StoragePrecision>::QuadraturePoints1D,
      this->_timeStepping.getTimeStamp(),
      timeStepSize,
      parameters
    },
    tarch::accelerator::Custom<exahype2::dg::MaxEigenvalueStatistics>{statistics}
  );
  return statistics;
}
