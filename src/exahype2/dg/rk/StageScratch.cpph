/**
 * Returns the buffer of this thread that carries the linear combination of one cell. The memory
 * is aligned like a heap-allocated patch, because the volume integral and the extrapolation read
 * it with vector instructions. One cell at a time writes it, and the next cell overwrites it.
 */
template <int NumberOfValues, typename Precision>
INLINE_METHOD Precision* exahype2::dg::rk::stageScratch() {
  using ScratchDeleter = decltype([](Precision* const memory) { tarch::accelerator::freeHeapMemory(memory); });
  static thread_local const std::unique_ptr<Precision[], ScratchDeleter> scratch(
    static_cast<Precision*>(tarch::accelerator::allocateHeapMemory(NumberOfValues * sizeof(Precision)))
  );
  return scratch.get();
}
