TARGET_DECLARE
/**
 * Fills the exterior half of a boundary face through the solver callback.
 * Face halves follow the negative and positive sides of the normal axis.
 */
template <
  typename SolverType,
  int NumberOfDofsPerAxis,
  int NumberOfUnknowns,
  int NumberOfAuxiliaryVariables,
  typename StoragePrecision,
  typename ComputePrecision>
INLINE_METHOD GPU_CALLABLE_METHOD void exahype2::dg::applyBoundaryConditions(
  StoragePrecision* NOALIAS const              faceState,
  const ComputePrecision* NOALIAS const        quadratureNodes,
  const tarch::la::Vector<DIMENSIONS, double>& faceCentre,
  const tarch::la::Vector<DIMENSIONS, double>& cellSize,
  const double                                 timeStamp,
  const int                                    faceNumber
) {
  constexpr int NumberOfData = NumberOfUnknowns + NumberOfAuxiliaryVariables;
  constexpr int NodesPerFace = (DIMENSIONS == 3) ? NumberOfDofsPerAxis * NumberOfDofsPerAxis : NumberOfDofsPerAxis;

  assertion(faceNumber >= 0 and faceNumber < 2 * DIMENSIONS, faceNumber);

  const int  direction  = faceNumber % DIMENSIONS;
  const auto faceOffset = faceCentre - 0.5 * cellSize;

  [[maybe_unused]] ComputePrecision insideStateBuffer[NumberOfData];
  [[maybe_unused]] ComputePrecision outsideStateBuffer[NumberOfData];

  for (int faceNode = 0; faceNode < NodesPerFace; faceNode++) {
    tarch::la::Vector<DIMENSIONS, int> nodeIndex(0);
    int                                remainder = faceNode;
    for (int axis = 0; axis < DIMENSIONS; axis++) {
      if (axis != direction) {
        nodeIndex(axis) = remainder % NumberOfDofsPerAxis;
        remainder /= NumberOfDofsPerAxis;
      }
    }

    tarch::la::Vector<DIMENSIONS, double> nodePosition;
    for (int axis = 0; axis < DIMENSIONS; axis++) {
      nodePosition(axis) = faceOffset(axis)
        + ((axis == direction) ? 0.5 : static_cast<double>(quadratureNodes[nodeIndex(axis)])) * cellSize(axis);
    }

    const int insideSide    = faceNumber < DIMENSIONS ? 1 : 0;
    const int outsideSide   = 1 - insideSide;
    const int insideOffset  = (insideSide * NodesPerFace + faceNode) * NumberOfData;
    const int outsideOffset = (outsideSide * NodesPerFace + faceNode) * NumberOfData;

    if constexpr (std::is_same_v<StoragePrecision, ComputePrecision>) {
      SolverType::boundaryConditions(
        faceState + insideOffset,
        faceState + outsideOffset,
        nodePosition,
        cellSize,
        timeStamp,
        direction
      );
    } else {
      for (int value = 0; value < NumberOfData; value++) {
        insideStateBuffer[value] = static_cast<ComputePrecision>(faceState[insideOffset + value]);
      }
      SolverType::boundaryConditions(
        insideStateBuffer,
        outsideStateBuffer,
        nodePosition,
        cellSize,
        timeStamp,
        direction
      );
      for (int value = 0; value < NumberOfData; value++) {
        faceState[outsideOffset + value] = static_cast<StoragePrecision>(outsideStateBuffer[value]);
      }
    }
  }
}
TARGET_DECLARE_END
