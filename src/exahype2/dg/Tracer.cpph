/**
 * Interpolates one DG attribute at the particle position.
 *
 * SourceIndex selects one entry of every array-of-structures node in Q.
 * DestIndex selects the particle data entry that receives the value.
 */
template <typename Particle, int SourceIndex, int DestIndex, typename QStoreType>
void exahype2::dg::projectValueOntoParticle(
  const peano4::dataview::CellMarker& marker,
  const int                           order,
  const QStoreType* NOALIAS const     quadratureNodes1D,
  const int                           unknownsPerDoF,
  const QStoreType* NOALIAS const     Q,
  Particle&                           particle
) {
  particle.setData(
    DestIndex,
    ::exahype2::dg::evaluatePolynomial(
      marker,
      order,
      quadratureNodes1D,
      unknownsPerDoF,
      Q,
      particle.getX(),
      SourceIndex
    )
  );
}

/**
 * Interpolates every DG attribute at the particle position.
 *
 * The loop writes every source attribute to the particle data entry with the same index.
 * Q contains unknownsPerDoF consecutive values per tensor-product node.
 */
template <typename Particle, typename QStoreType>
void exahype2::dg::projectAllValuesOntoParticle(
  const peano4::dataview::CellMarker& marker,
  const int                           order,
  const QStoreType* NOALIAS const     quadratureNodes1D,
  const int                           unknownsPerDoF,
  const QStoreType* NOALIAS const     Q,
  Particle&                           particle
) {
  assertion(unknownsPerDoF > 0, unknownsPerDoF);

  for (int sourceAttribute = 0; sourceAttribute < unknownsPerDoF; sourceAttribute++) {
    const QStoreType interpolatedValue = ::exahype2::dg::evaluatePolynomial(
      marker,
      order,
      quadratureNodes1D,
      unknownsPerDoF,
      Q,
      particle.getX(),
      sourceAttribute
    );

    assertion(interpolatedValue == interpolatedValue, interpolatedValue, sourceAttribute);
    particle.setData(sourceAttribute, interpolatedValue);
  }
}
