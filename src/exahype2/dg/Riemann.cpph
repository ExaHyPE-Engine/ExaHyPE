TARGET_DECLARE
/**
 * Replaces projected fluxes with the nonlinear Rusanov fluxes.
 * Wave speeds use the quadrature-weighted mean state on each side.
 * Nonconservative contributions enter the two fluxes with opposite signs.
 */
template <
  typename Solver,
  int  NumberOfDofsPerAxis,
  int  NumberOfUnknowns,
  int  NumberOfAuxiliaryVariables,
  bool EvaluateNonconservativeProduct,
  typename StoragePrecision,
  typename ComputePrecision>
INLINE_METHOD GPU_CALLABLE_METHOD void exahype2::dg::solveRiemannProblem(
  StoragePrecision* NOALIAS const              leftFlux,
  StoragePrecision* NOALIAS const              rightFlux,
  const StoragePrecision* NOALIAS const        leftState,
  const StoragePrecision* NOALIAS const        rightState,
  const ComputePrecision* NOALIAS const        faceQuadratureWeights,
  const tarch::la::Vector<DIMENSIONS, double>& faceCentre,
  const tarch::la::Vector<DIMENSIONS, double>& cellSize,
  const double                                 timeStamp,
  const double                                 timeStepSize,
  const int                                    direction
) {
  constexpr int NumberOfData = NumberOfUnknowns + NumberOfAuxiliaryVariables;
  constexpr int NodesPerFace = (DIMENSIONS == 3) ? NumberOfDofsPerAxis * NumberOfDofsPerAxis : NumberOfDofsPerAxis;
  constexpr int PaddedNumberOfUnknowns =
    ((NumberOfUnknowns + PEANO_WITH_SIMDLEN - 1) / PEANO_WITH_SIMDLEN) * PEANO_WITH_SIMDLEN;
  constexpr int PaddedNumberOfData =
    ((NumberOfData + PEANO_WITH_SIMDLEN - 1) / PEANO_WITH_SIMDLEN) * PEANO_WITH_SIMDLEN;
  constexpr auto Half = static_cast<ComputePrecision>(0.5);

  assertion(direction >= 0 and direction < DIMENSIONS, direction);

  using FluxPrecision = std::common_type_t<StoragePrecision, ComputePrecision>;

  ComputePrecision jumpTerm[NodesPerFace * PaddedNumberOfUnknowns] __attribute__((aligned(PEANO_WITH_ALIGNMENT)));
  ComputePrecision averageLeftState[PaddedNumberOfData] __attribute__((aligned(PEANO_WITH_ALIGNMENT)))  = {};
  ComputePrecision averageRightState[PaddedNumberOfData] __attribute__((aligned(PEANO_WITH_ALIGNMENT))) = {};

  for (int faceNode = 0; faceNode < NodesPerFace; faceNode++) {
    SIMD(aligned(averageLeftState, averageRightState : PEANO_WITH_ALIGNMENT))
    for (int value = 0; value < NumberOfData; value++) {
      averageLeftState[value] +=
        faceQuadratureWeights[faceNode] * static_cast<ComputePrecision>(leftState[faceNode * NumberOfData + value]);
      averageRightState[value] +=
        faceQuadratureWeights[faceNode] * static_cast<ComputePrecision>(rightState[faceNode * NumberOfData + value]);
    }
  }

  const auto leftMaxEigenvalue = static_cast<ComputePrecision>(
    Solver::maxEigenvalue(averageLeftState, faceCentre, cellSize, timeStamp, timeStepSize, direction)
  );
  const auto rightMaxEigenvalue = static_cast<ComputePrecision>(
    Solver::maxEigenvalue(averageRightState, faceCentre, cellSize, timeStamp, timeStepSize, direction)
  );
  const ComputePrecision maxEigenvalue = std::fmax(leftMaxEigenvalue, rightMaxEigenvalue);

  for (int faceNode = 0; faceNode < NodesPerFace; faceNode++) {
    SIMD(aligned(jumpTerm : PEANO_WITH_ALIGNMENT))
    for (int unknown = 0; unknown < NumberOfUnknowns; unknown++) {
      jumpTerm[faceNode * PaddedNumberOfUnknowns + unknown] = maxEigenvalue
        * (static_cast<ComputePrecision>(leftState[faceNode * NumberOfData + unknown])
           - static_cast<ComputePrecision>(rightState[faceNode * NumberOfData + unknown]));
    }
  }

  SIMD(aligned(jumpTerm : PEANO_WITH_ALIGNMENT))
  for (int faceNode = 0; faceNode < NodesPerFace; faceNode++) {
    for (int unknown = 0; unknown < NumberOfUnknowns; unknown++) {
      leftFlux[faceNode * NumberOfUnknowns + unknown] = static_cast<StoragePrecision>(
        static_cast<FluxPrecision>(Half)
        * (static_cast<FluxPrecision>(leftFlux[faceNode * NumberOfUnknowns + unknown]) + static_cast<FluxPrecision>(rightFlux[faceNode * NumberOfUnknowns + unknown]) + static_cast<FluxPrecision>(jumpTerm[faceNode * PaddedNumberOfUnknowns + unknown]))
      );
    }
  }
  for (int entry = 0; entry < NodesPerFace * NumberOfUnknowns; entry++) {
    rightFlux[entry] = leftFlux[entry];
  }

  if constexpr (EvaluateNonconservativeProduct) {
    ComputePrecision averageState[NumberOfData] __attribute__((aligned(PEANO_WITH_ALIGNMENT))) = {};
    ComputePrecision stateJump[NumberOfData] __attribute__((aligned(PEANO_WITH_ALIGNMENT)))    = {};
    ComputePrecision productValues[PaddedNumberOfUnknowns] __attribute__((aligned(PEANO_WITH_ALIGNMENT)));

    for (int faceNode = 0; faceNode < NodesPerFace; faceNode++) {
      SIMD(aligned(averageState, stateJump : PEANO_WITH_ALIGNMENT))
      for (int unknown = 0; unknown < NumberOfUnknowns; unknown++) {
        averageState[unknown] = Half
          * (static_cast<ComputePrecision>(leftState[faceNode * NumberOfData + unknown])
             + static_cast<ComputePrecision>(rightState[faceNode * NumberOfData + unknown]));
        stateJump[unknown] = static_cast<ComputePrecision>(rightState[faceNode * NumberOfData + unknown])
          - static_cast<ComputePrecision>(leftState[faceNode * NumberOfData + unknown]);
      }
      if constexpr (NumberOfAuxiliaryVariables > 0) {
        for (int value = NumberOfUnknowns; value < NumberOfData; value++) {
          averageState[value] = Half
            * (static_cast<ComputePrecision>(leftState[faceNode * NumberOfData + value])
               + static_cast<ComputePrecision>(rightState[faceNode * NumberOfData + value]));
          stateJump[value] = static_cast<ComputePrecision>(rightState[faceNode * NumberOfData + value])
            - static_cast<ComputePrecision>(leftState[faceNode * NumberOfData + value]);
        }
      }

      SIMD(aligned(productValues : PEANO_WITH_ALIGNMENT))
      for (int unknown = 0; unknown < PaddedNumberOfUnknowns; unknown++) {
        productValues[unknown] = static_cast<ComputePrecision>(0);
      }
      Solver::nonconservativeProduct(
        averageState,
        stateJump,
        faceCentre,
        cellSize,
        timeStamp,
        timeStepSize,
        direction,
        productValues
      );

      SIMD(aligned(productValues : PEANO_WITH_ALIGNMENT))
      for (int unknown = 0; unknown < NumberOfUnknowns; unknown++) {
        const auto halfProduct                           = static_cast<FluxPrecision>(Half * productValues[unknown]);
        rightFlux[faceNode * NumberOfUnknowns + unknown] = static_cast<StoragePrecision>(
          static_cast<FluxPrecision>(rightFlux[faceNode * NumberOfUnknowns + unknown]) - halfProduct
        );
        leftFlux[faceNode * NumberOfUnknowns + unknown] = static_cast<StoragePrecision>(
          static_cast<FluxPrecision>(leftFlux[faceNode * NumberOfUnknowns + unknown]) + halfProduct
        );
      }
    }
  }
}

/**
 * Computes linear Rusanov corrections from the state jump.
 * Material parameters use the quadrature-weighted mean of both traces.
 * EvaluateMaterialParameters applies the solver's material matrix to each term.
 */
template <
  typename Solver,
  int  NumberOfDofsPerAxis,
  int  NumberOfUnknowns,
  int  NumberOfAuxiliaryVariables,
  bool EvaluateFlux,
  bool EvaluateNonconservativeProduct,
  bool EvaluateMaterialParameters,
  typename StoragePrecision,
  typename ComputePrecision>
INLINE_METHOD GPU_CALLABLE_METHOD void exahype2::dg::solveLinearRiemannProblem(
  StoragePrecision* NOALIAS const              leftFlux,
  StoragePrecision* NOALIAS const              rightFlux,
  const StoragePrecision* NOALIAS const        leftState,
  const StoragePrecision* NOALIAS const        rightState,
  const ComputePrecision* NOALIAS const        faceQuadratureWeights,
  const tarch::la::Vector<DIMENSIONS, double>& faceCentre,
  const tarch::la::Vector<DIMENSIONS, double>& cellSize,
  const double                                 timeStamp,
  const double                                 timeStepSize,
  const int                                    direction
) {
  constexpr int NumberOfData = NumberOfUnknowns + NumberOfAuxiliaryVariables;
  constexpr int NodesPerFace = (DIMENSIONS == 3) ? NumberOfDofsPerAxis * NumberOfDofsPerAxis : NumberOfDofsPerAxis;
  constexpr int PaddedNumberOfUnknowns =
    ((NumberOfUnknowns + PEANO_WITH_SIMDLEN - 1) / PEANO_WITH_SIMDLEN) * PEANO_WITH_SIMDLEN;
  constexpr int PaddedNumberOfData =
    ((NumberOfData + PEANO_WITH_SIMDLEN - 1) / PEANO_WITH_SIMDLEN) * PEANO_WITH_SIMDLEN;
  constexpr auto Half = static_cast<ComputePrecision>(0.5);

  assertion(direction >= 0 and direction < DIMENSIONS, direction);

  ComputePrecision averageLeftState[PaddedNumberOfData] __attribute__((aligned(PEANO_WITH_ALIGNMENT)))  = {};
  ComputePrecision averageRightState[PaddedNumberOfData] __attribute__((aligned(PEANO_WITH_ALIGNMENT))) = {};
  for (int faceNode = 0; faceNode < NodesPerFace; faceNode++) {
    SIMD(aligned(averageLeftState, averageRightState : PEANO_WITH_ALIGNMENT))
    for (int value = 0; value < NumberOfData; value++) {
      averageLeftState[value] +=
        faceQuadratureWeights[faceNode] * static_cast<ComputePrecision>(leftState[faceNode * NumberOfData + value]);
      averageRightState[value] +=
        faceQuadratureWeights[faceNode] * static_cast<ComputePrecision>(rightState[faceNode * NumberOfData + value]);
    }
  }

  const auto leftMaxEigenvalue = static_cast<ComputePrecision>(
    Solver::maxEigenvalue(averageLeftState, faceCentre, cellSize, timeStamp, timeStepSize, direction)
  );
  const auto rightMaxEigenvalue = static_cast<ComputePrecision>(
    Solver::maxEigenvalue(averageRightState, faceCentre, cellSize, timeStamp, timeStepSize, direction)
  );
  const ComputePrecision maxEigenvalue = std::fmax(leftMaxEigenvalue, rightMaxEigenvalue);

  [[maybe_unused]] ComputePrecision averageState[PaddedNumberOfData] __attribute__((aligned(PEANO_WITH_ALIGNMENT)));
  SIMD(aligned(averageState, averageLeftState, averageRightState : PEANO_WITH_ALIGNMENT))
  for (int value = 0; value < PaddedNumberOfData; value++) {
    averageState[value] = Half * (averageRightState[value] + averageLeftState[value]);
  }

  ComputePrecision halfStateJump[PaddedNumberOfData] __attribute__((aligned(PEANO_WITH_ALIGNMENT))) = {};
  if constexpr (NumberOfAuxiliaryVariables > 0) {
    for (int value = NumberOfUnknowns; value < PaddedNumberOfData; value++) {
      halfStateJump[value] = averageState[value];
    }
  }

  [[maybe_unused]] ComputePrecision productValues[PaddedNumberOfUnknowns]
    __attribute__((aligned(PEANO_WITH_ALIGNMENT)));
  [[maybe_unused]] ComputePrecision fluxValues[PaddedNumberOfUnknowns] __attribute__((aligned(PEANO_WITH_ALIGNMENT)));

  for (int faceNode = 0; faceNode < NodesPerFace; faceNode++) {
    SIMD(aligned(halfStateJump : PEANO_WITH_ALIGNMENT))
    for (int unknown = 0; unknown < NumberOfUnknowns; unknown++) {
      halfStateJump[unknown] = Half
        * (static_cast<ComputePrecision>(rightState[faceNode * NumberOfData + unknown])
           - static_cast<ComputePrecision>(leftState[faceNode * NumberOfData + unknown]));
    }

    ComputePrecision centralFlux[NumberOfUnknowns] __attribute__((aligned(PEANO_WITH_ALIGNMENT))) = {};

    if constexpr (EvaluateNonconservativeProduct) {
      SIMD(aligned(productValues : PEANO_WITH_ALIGNMENT))
      for (int unknown = 0; unknown < PaddedNumberOfUnknowns; unknown++) {
        productValues[unknown] = static_cast<ComputePrecision>(0);
      }
      Solver::nonconservativeProduct(
        averageState,
        halfStateJump,
        faceCentre,
        cellSize,
        timeStamp,
        timeStepSize,
        direction,
        productValues
      );
      if constexpr (EvaluateMaterialParameters) {
        Solver::multiplyMaterialParameterMatrix(
          averageState,
          faceCentre,
          cellSize,
          timeStamp,
          timeStepSize,
          direction,
          productValues
        );
      }
      SIMD(aligned(productValues, centralFlux : PEANO_WITH_ALIGNMENT))
      for (int unknown = 0; unknown < NumberOfUnknowns; unknown++) {
        centralFlux[unknown] += productValues[unknown];
      }
    }

    if constexpr (EvaluateFlux) {
      SIMD(aligned(fluxValues : PEANO_WITH_ALIGNMENT))
      for (int unknown = 0; unknown < PaddedNumberOfUnknowns; unknown++) {
        fluxValues[unknown] = static_cast<ComputePrecision>(0);
      }
      Solver::flux(halfStateJump, faceCentre, cellSize, timeStamp, timeStepSize, direction, fluxValues);
      if constexpr (EvaluateMaterialParameters) {
        Solver::multiplyMaterialParameterMatrix(
          averageState,
          faceCentre,
          cellSize,
          timeStamp,
          timeStepSize,
          direction,
          fluxValues
        );
      }
      SIMD(aligned(fluxValues, centralFlux : PEANO_WITH_ALIGNMENT))
      for (int unknown = 0; unknown < NumberOfUnknowns; unknown++) {
        centralFlux[unknown] += fluxValues[unknown];
      }
    }

    SIMD(aligned(halfStateJump, centralFlux : PEANO_WITH_ALIGNMENT))
    for (int unknown = 0; unknown < NumberOfUnknowns; unknown++) {
      const ComputePrecision dissipation = maxEigenvalue * halfStateJump[unknown];
      rightFlux[faceNode * NumberOfUnknowns + unknown] =
        static_cast<StoragePrecision>(centralFlux[unknown] + dissipation);
      leftFlux[faceNode * NumberOfUnknowns + unknown] =
        static_cast<StoragePrecision>(centralFlux[unknown] - dissipation);
    }
  }
}
TARGET_DECLARE_END
