template <typename T>
INLINE_METHOD exahype2::dg::FaceRestriction<T>::FaceRestriction(
  const double* const restrictionMatrix1D,
  const int           numberOfDofsPerAxis,
  const int           numberOfValuesPerNode
) :
  _restrictionMatrix1D(restrictionMatrix1D),
  _numberOfDofsPerAxis(numberOfDofsPerAxis),
  _numberOfValuesPerNode(numberOfValuesPerNode) {
  assertion(restrictionMatrix1D != nullptr);
  assertion(numberOfDofsPerAxis > 0, numberOfDofsPerAxis);
  assertion(numberOfValuesPerNode > 0, numberOfValuesPerNode);
}

template <typename T>
INLINE_METHOD void exahype2::dg::FaceRestriction<T>::operator()(
  exahype2::amr::ChildDataStage<T>& stage,
  const void* const                 coarseFaceKey,
  T* const                          coarseFaceValues
) const {
  assertion(coarseFaceKey != nullptr);
  assertion(coarseFaceValues != nullptr);

  const int     entriesPerTransferMatrix = _numberOfDofsPerAxis * _numberOfDofsPerAxis;
  const double* restrictionMatrixPerInterval[peano4::sfc::ActiveCurve::SubdivisionFactor];
  for (int interval = 0; interval < peano4::sfc::ActiveCurve::SubdivisionFactor; interval++) {
    restrictionMatrixPerInterval[interval] = _restrictionMatrix1D + interval * entriesPerTransferMatrix;
  }

  const T* stagedSubfaces[exahype2::amr::SubfacesPerFace];
  exahype2::amr::collectStagedSubfaces(stage, coarseFaceKey, stagedSubfaces);
  exahype2::amr::restrictFaceFromChildren(
    coarseFaceValues,
    stagedSubfaces,
    restrictionMatrixPerInterval,
    _numberOfDofsPerAxis,
    _numberOfValuesPerNode
  );
  stage.discard(coarseFaceKey);
}

template <typename T>
INLINE_METHOD exahype2::dg::CellRestriction<T>::CellRestriction(
  const double* const restrictionMatrix1D,
  const int           numberOfDofsPerAxis,
  const int           numberOfValuesPerNode
) :
  _restrictionMatrix1D(restrictionMatrix1D),
  _numberOfDofsPerAxis(numberOfDofsPerAxis),
  _numberOfValuesPerNode(numberOfValuesPerNode) {
  assertion(restrictionMatrix1D != nullptr);
  assertion(numberOfDofsPerAxis > 0, numberOfDofsPerAxis);
  assertion(numberOfValuesPerNode > 0, numberOfValuesPerNode);
}

template <typename T>
INLINE_METHOD void exahype2::dg::CellRestriction<T>::operator()(
  exahype2::amr::ChildDataStage<T>& stage,
  T* NOALIAS const                  coarseGridValues
) const {
  assertion(coarseGridValues != nullptr);

  const int     entriesPerTransferMatrix = _numberOfDofsPerAxis * _numberOfDofsPerAxis;
  const double* restrictionMatrixPerInterval[peano4::sfc::ActiveCurve::SubdivisionFactor];
  for (int interval = 0; interval < peano4::sfc::ActiveCurve::SubdivisionFactor; interval++) {
    restrictionMatrixPerInterval[interval] = _restrictionMatrix1D + interval * entriesPerTransferMatrix;
  }

  const T* stagedChildren[peano4::sfc::ActiveCurve::ChildrenPerCell];
  exahype2::amr::collectStagedChildren(stage, coarseGridValues, stagedChildren);
  exahype2::amr::restrictCellFromChildren(
    coarseGridValues,
    stagedChildren,
    restrictionMatrixPerInterval,
    _numberOfDofsPerAxis,
    _numberOfValuesPerNode
  );
  stage.discard(coarseGridValues);
}
