#include "exahype2/dg/Basis.h"
#include "exahype2/particles/Integration.h"
#include "peano4/Loop.h"
#include "tarch/Assertions.h"
#include "tarch/accelerator/ParallelFor.h"
#include "tarch/accelerator/Range.h"

TARGET_DECLARE
/**
 * Writes the first unknowns of the nodal polynomial of the cell at position into the particle:
 * The k-th index of FieldIndices names the data entry that receives unknown k. The scheme None
 * writes nothing, every other scheme evaluates the polynomial.
 */
template <int NodesPerAxis, int NumberOfData, typename Storage, int... FieldIndices>
INLINE_METHOD GPU_CALLABLE_METHOD void
exahype2::dg::interpolateFields(
  const exahype2::particles::InterpolationScheme scheme,
  const tarch::la::Vector<DIMENSIONS, double>&   centre,
  const tarch::la::Vector<DIMENSIONS, double>&   width,
  const double* NOALIAS const                    quadratureNodes,
  const Storage* NOALIAS const                   Q,
  const tarch::la::Vector<DIMENSIONS, double>&   position,
  exahype2::particles::Particle&                 particle
) {
  static_assert(NodesPerAxis > 0);
  static_assert(sizeof...(FieldIndices) <= NumberOfData, "Every interpolated field reads one unknown.");
  if (scheme == exahype2::particles::InterpolationScheme::None) {
    return;
  }
  [[maybe_unused]] const auto interpolateUnknown = [&](const int unknown) {
    return static_cast<double>(exahype2::dg::evaluatePolynomial(
      centre,
      width,
      NodesPerAxis - 1,
      quadratureNodes,
      NumberOfData,
      Q,
      position,
      unknown
    ));
  };
  [[maybe_unused]] int unknown = 0;
  (particle.setData(FieldIndices, interpolateUnknown(unknown++)), ...);
}

/**
 * Interpolates the fields the list names; the list carries the entries as a type.
 */
template <int NodesPerAxis, int NumberOfData, typename Storage, int... FieldIndices>
INLINE_METHOD GPU_CALLABLE_METHOD void
exahype2::dg::interpolateFields(
  [[maybe_unused]] const exahype2::particles::FieldList<FieldIndices...> fields,
  const exahype2::particles::InterpolationScheme                         scheme,
  const tarch::la::Vector<DIMENSIONS, double>&                           centre,
  const tarch::la::Vector<DIMENSIONS, double>&                           width,
  const double* NOALIAS const                                            quadratureNodes,
  const Storage* NOALIAS const                                           Q,
  const tarch::la::Vector<DIMENSIONS, double>&                           position,
  exahype2::particles::Particle&                                         particle
) {
  exahype2::dg::interpolateFields<NodesPerAxis, NumberOfData, Storage, FieldIndices...>(
    scheme,
    centre,
    width,
    quadratureNodes,
    Q,
    position,
    particle
  );
}

/**
 * Returns whether value is one of the entries of the list.
 */
template <int... Fields>
INLINE_METHOD GPU_CALLABLE_METHOD bool
exahype2::dg::listsValue([[maybe_unused]] const exahype2::particles::FieldList<Fields...> fields, const int value) {
  return ((value == Fields) or ... or false);
}

/**
 * Returns one value of the nodal polynomial of a face at position. The array values holds the
 * face nodes in the order of the tangential axes with the lower axis fastest, valuesPerNode
 * values each.
 */
template <int NodesPerAxis, typename Storage>
INLINE_METHOD GPU_CALLABLE_METHOD double
exahype2::dg::evaluateFacePolynomial(
  const tarch::la::Vector<DIMENSIONS, double>& faceCentre,
  const tarch::la::Vector<DIMENSIONS, double>& cellWidth,
  const int                                    normal,
  const double* NOALIAS const                  quadratureNodes,
  const int                                    valuesPerNode,
  const Storage* NOALIAS const                 values,
  const tarch::la::Vector<DIMENSIONS, double>& position,
  const int                                    value
) {
  constexpr int NodesPerFace = exahype2::dg::getNodesPerFace(NodesPerAxis);
  assertion(normal >= 0 and normal < DIMENSIONS, normal);
  assertion(value >= 0 and value < valuesPerNode, value, valuesPerNode);
  double result = 0.0;
  for (int faceNode = 0; faceNode < NodesPerFace; faceNode++) {
    const auto faceNodeIndex = peano4::dDelinearisedExclusive(faceNode, NodesPerAxis, normal);
    double     weight        = 1.0;
    for (int axis = 0; axis < DIMENSIONS; axis++) {
      if (axis == normal) {
        continue;
      }
      const int    node   = faceNodeIndex(axis);
      const double offset = faceCentre(axis) - 0.5 * cellWidth(axis);
      for (int other = 0; other < NodesPerAxis; other++) {
        if (other != node) {
          weight *= (position(axis) - (offset + quadratureNodes[other] * cellWidth(axis)))
            / ((quadratureNodes[node] - quadratureNodes[other]) * cellWidth(axis));
        }
      }
    }
    result += weight * static_cast<double>(values[faceNode * valuesPerNode + value]);
  }
  return result;
}
TARGET_DECLARE_END

/**
 * Writes the traces of the faces along normal into every particle of the set that sits on the
 * plane at position. The values of DifferenceFields carry the jump across the face.
 */
template <int NodesPerAxis, int NumberOfData, int NumberOfParticleData, int... DifferenceFields, typename Pool>
void
exahype2::dg::traceFaceValues(
  const peano4::Partition&                                partition,
  const Pool&                                             faceStates,
  const double* NOALIAS const                             quadratureNodes,
  exahype2::particles::ParticleSet<NumberOfParticleData>& particles,
  const int                                               normal,
  const double                                            position
) {
  static_assert(
    ((DifferenceFields >= 0 and DifferenceFields < NumberOfData) and ...),
    "Every difference field is a value."
  );
  assertion(normal >= 0 and normal < DIMENSIONS, normal);
  assertion(quadratureNodes != nullptr);
  if (particles.getSize() == 0) {
    return;
  }
  particles.upload();
  const auto set = particles.getView();
  tarch::accelerator::parallelFor(
    tarch::accelerator::Range(set.numberOfParticles),
    exahype2::dg::TraceFaceValues<
      NodesPerAxis,
      NumberOfData,
      NumberOfParticleData,
      exahype2::particles::FieldList<DifferenceFields...>,
      Pool
    >{partition.onDevice(), faceStates.getView(), quadratureNodes, set, normal, position}
  );
}

template <int NodesPerAxis, int NumberOfData, int NumberOfParticleData, typename Fields, typename Pool>
INLINE_METHOD GPU_CALLABLE_METHOD void
exahype2::dg::TraceFaceValues<NodesPerAxis, NumberOfData, NumberOfParticleData, Fields, Pool>::operator()(
  const int index
) const {
  constexpr int    NodesPerFace   = exahype2::dg::getNodesPerFace(NodesPerAxis);
  constexpr int    StoredValues   = NumberOfParticleData < NumberOfData ? NumberOfParticleData : NumberOfData;
  constexpr double PlaneTolerance = 1.0e-8;
  const int        slot           = particles.getSlot(index);
  if (slot < 0) {
    return;
  }
  auto       particle   = particles.getParticle(index);
  const auto location   = particle.getX();
  const int  faceNumber = location(normal) > partition.getCellCentre(slot, normal) ? normal + DIMENSIONS : normal;
  const int  face       = partition.getCellFace(slot, faceNumber);
  tarch::la::Vector<DIMENSIONS, double> faceCentre;
  tarch::la::Vector<DIMENSIONS, double> cellWidth;
  for (int axis = 0; axis < DIMENSIONS; axis++) {
    faceCentre(axis) = partition.getFaceCentre(face, axis);
    cellWidth(axis)  = partition.getFaceWidth(face, axis);
  }
  if (std::abs(faceCentre(normal) - position) > PlaneTolerance * cellWidth(normal)) {
    return;
  }
  const auto* const lower = faceStates.getChunk(face);
  const auto* const upper = lower + NodesPerFace * NumberOfData;
  for (int value = 0; value < StoredValues; value++) {
    const double lowerValue = exahype2::dg::evaluateFacePolynomial<NodesPerAxis>(
      faceCentre,
      cellWidth,
      normal,
      quadratureNodes,
      NumberOfData,
      lower,
      location,
      value
    );
    const double upperValue = exahype2::dg::evaluateFacePolynomial<NodesPerAxis>(
      faceCentre,
      cellWidth,
      normal,
      quadratureNodes,
      NumberOfData,
      upper,
      location,
      value
    );
    const bool difference = exahype2::dg::listsValue(Fields{}, value);
    particle.setData(value, difference ? upperValue - lowerValue : 0.5 * (lowerValue + upperValue));
  }
}

/**
 * Moves every particle of the set through the solution of its cell and sends every particle that
 * left its cell to the rank that holds it. A stage position of the integration outside the cell
 * reads the polynomial extended beyond it. Only a set that moves copies its values back to the
 * host, for the relocation.
 */
template <int NodesPerAxis, int NumberOfData, int NumberOfParticleData, int... FieldIndices, typename Pool>
void
exahype2::dg::traceParticles(
  const peano4::Partition&                                partition,
  const Pool&                                             solution,
  const double* NOALIAS const                             quadratureNodes,
  const double                                            timeStepSize,
  exahype2::particles::ParticleSet<NumberOfParticleData>& particles,
  const exahype2::particles::Forces&                      forces,
  const tarch::la::Vector<DIMENSIONS, double>&            domainOffset,
  const tarch::la::Vector<DIMENSIONS, double>&            domainWidth,
  const int                                               periodicAxes
) {
  assertion(timeStepSize >= 0.0, timeStepSize);
  assertion(quadratureNodes != nullptr);
  if (particles.getSize() == 0) {
    particles.relocate(partition);
    return;
  }
  particles.upload();
  const auto set = particles.getView();
  tarch::accelerator::parallelFor(
    tarch::accelerator::Range(set.numberOfParticles),
    exahype2::dg::TraceParticles<
      NodesPerAxis,
      NumberOfData,
      NumberOfParticleData,
      exahype2::particles::FieldList<FieldIndices...>,
      Pool
    >{partition.onDevice(),
      solution.getView(),
      quadratureNodes,
      timeStepSize,
      set,
      forces,
      domainOffset,
      domainWidth,
      periodicAxes}
  );
  if (forces.integrationScheme != exahype2::particles::IntegrationScheme::Static) {
    particles.download();
  }
  particles.relocate(partition);
}

template <int NodesPerAxis, int NumberOfData, int NumberOfParticleData, typename Fields, typename Pool>
INLINE_METHOD GPU_CALLABLE_METHOD void
exahype2::dg::TraceParticles<NodesPerAxis, NumberOfData, NumberOfParticleData, Fields, Pool>::operator()(
  const int index
) const {
  constexpr double              WallDamping = 0.8;
  exahype2::particles::Particle particle    = particles.getParticle(index);
  const int                     slot        = particles.getSlot(index);
  assertion(slot >= 0, slot, index);
  tarch::la::Vector<DIMENSIONS, double> centre;
  tarch::la::Vector<DIMENSIONS, double> width;
  for (int axis = 0; axis < DIMENSIONS; axis++) {
    centre(axis) = partition.getCellCentre(slot, axis);
    width(axis)  = partition.getCellWidth(slot, axis);
  }
  const auto* const Q = solution.getChunk(slot);
  const auto        interpolateAt =
    [&](exahype2::particles::Particle& target, const tarch::la::Vector<DIMENSIONS, double>& position) {
      exahype2::dg::interpolateFields<NodesPerAxis, NumberOfData, std::remove_cv_t<std::remove_pointer_t<decltype(Q)>>>(
        Fields{},
        forces.interpolationScheme,
        centre,
        width,
        quadratureNodes,
        Q,
        position,
        target
      );
    };
  interpolateAt(particle, particle.getX());
  if (forces.integrationScheme == exahype2::particles::IntegrationScheme::Static) {
    return;
  }
  exahype2::particles::applyForces(particle, particle.getX(), forces, domainOffset, domainWidth);
  auto newPosition =
    exahype2::particles::advance(particle, forces, timeStepSize, interpolateAt, domainOffset, domainWidth);
  exahype2::particles::reflectAtWalls(particle, newPosition, WallDamping, domainOffset, domainWidth, periodicAxes);
  exahype2::particles::wrapIntoDomain(newPosition, domainOffset, domainWidth, periodicAxes);
  particle.setX(newPosition);
}
