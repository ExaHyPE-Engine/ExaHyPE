TARGET_DECLARE
/**
 * Calls functor(value, x, h, weight, index) for every subcell of a subgrid in linearised order.
 * The centre x comes from exahype2::fv::getVolumeSizeAndCentre, which rounds differently from
 * exahype2::fv::forEachVolume.
 */
template <int SubcellsPerAxis, int Values, typename Precision, typename Functor>
INLINE_METHOD GPU_CALLABLE_METHOD void exahype2::dg::limiting::forEachSubcell(
  const tarch::la::Vector<DIMENSIONS, double>& cellCentre,
  const tarch::la::Vector<DIMENSIONS, double>& cellSize,
  Precision* const                             values,
  Functor&&                                    functor
) {
  static_assert(SubcellsPerAxis > 0 and Values > 0);
  assertion(values != nullptr);

  const auto subcellSize = exahype2::fv::getVolumeSize(cellSize, SubcellsPerAxis);
  double     weight      = 1.0;
  for (int axis = 0; axis < DIMENSIONS; axis++) {
    assertion(subcellSize(axis) > 0.0, subcellSize, axis);
    weight *= subcellSize(axis);
  }

  peano4::dForEach(SubcellsPerAxis, [&](const tarch::la::Vector<DIMENSIONS, int>& subcell) {
    const int  index = peano4::dLinearised(subcell, SubcellsPerAxis);
    const auto subcellCentre =
      exahype2::fv::getVolumeSizeAndCentre<DIMENSIONS, SubcellsPerAxis>(cellCentre, cellSize, subcell).volumeCentre;
    functor(values + index * Values, subcellCentre, subcellSize, weight, index);
  });
}
TARGET_DECLARE_END
