TARGET_DECLARE
/**
 * Returns the physical and scaled wave-speed maxima over the subcell averages of a cell.
 *
 * The scaled wave speeds divide by the cell extents, so they bound the same time step as the
 * nodal maxima of the cell.
 */
template <typename SolverType, typename Value>
INLINE_METHOD GPU_CALLABLE_METHOD exahype2::dg::MaxEigenvalueStatistics exahype2::dg::limiting::
  reduceSubcellMaxEigenvalues(
    const Value* const                           subcellSolution,
    const tarch::la::Vector<DIMENSIONS, double>& cellCentre,
    const tarch::la::Vector<DIMENSIONS, double>& cellSize,
    const double                                 timeStamp,
    const double                                 timeStepSize
  ) {
  using Layout = exahype2::dg::limiting::SubcellLayout<SolverType>;
  assertion(subcellSolution != nullptr);

  const tarch::la::Vector<DIMENSIONS, double> subcellSize =
    cellSize / static_cast<double>(Layout::NumberOfSubcellsPerAxis);
  exahype2::dg::MaxEigenvalueStatistics result;
  for (int subcell = 0; subcell < Layout::NumberOfSubcells; subcell++) {
    tarch::la::Vector<DIMENSIONS, double> subcellCentre;
    int                                   remainder = subcell;
    for (int dimension = 0; dimension < DIMENSIONS; dimension++) {
      subcellCentre(dimension) = cellCentre(dimension) - 0.5 * cellSize(dimension)
        + (remainder % Layout::NumberOfSubcellsPerAxis + 0.5) * subcellSize(dimension);
      remainder /= Layout::NumberOfSubcellsPerAxis;
    }
    double subcellState[Layout::NumberOfData];
    for (int entry = 0; entry < Layout::NumberOfData; entry++) {
      subcellState[entry] = static_cast<double>(subcellSolution[subcell * Layout::NumberOfData + entry]);
    }
    result.accumulate<DIMENSIONS>(cellSize, [&](const int normal) {
      return SolverType::maxEigenvalue(subcellState, subcellCentre, subcellSize, timeStamp, timeStepSize, normal);
    });
  }
  return result;
}
TARGET_DECLARE_END

/**
 * Returns whether a cell's candidate solution and its subcell averages pass the solver's physical
 * admissibility term.
 *
 * A cell whose space-time predictor diverged holds no valid candidate, so it fails regardless of
 * the term (Dumbser, Zanotti, Loubere and Diot, J. Comput. Phys. 278 (2014) 47-75).
 */
template <typename SolverType, bool UsesAdmissibilityCriterion, typename Value, typename CellLabel>
INLINE_METHOD bool exahype2::dg::limiting::isCandidateAdmissible(
  [[maybe_unused]] const peano4::dataview::CellMarker& marker,
  const CellLabel&                                     cellLabel,
  [[maybe_unused]] const Value* const                  candidate,
  [[maybe_unused]] const Value* const                  candidateSubcells
) {
  using Layout = exahype2::dg::limiting::SubcellLayout<SolverType>;

  bool admissible = true;
  if (cellLabel.getPredictorDiverged()) {
    admissible = false;
  }
  if constexpr (UsesAdmissibilityCriterion) {
    assertion(candidate != nullptr);
    assertion(candidateSubcells != nullptr);
    if (
      not SolverType::isPhysicallyAdmissible(candidate, Layout::NumberOfNodes, marker.getX(), marker.getH())
      or not SolverType::isPhysicallyAdmissible(
        candidateSubcells,
        Layout::NumberOfSubcells,
        marker.getX(),
        marker.getH()
      )
    ) {
      admissible = false;
    }
  }
  return admissible;
}

/**
 * Writes the limiter verdict of one cell into its cell label and onto its faces, and reduces the
 * wave speed of an accepted candidate into an adaptive solver.
 *
 * A cell that stays on the subcell scheme discards its candidate, so the recompute reports its wave
 * speed. The previous status makes this decision independent of the order a traversal visits
 * neighbours in.
 */
template <typename SolverType, typename Value, typename CellLabel, typename FaceLabels>
INLINE_METHOD void exahype2::dg::limiting::commitLimiterVerdict(
  [[maybe_unused]] const peano4::dataview::CellMarker& marker,
  SolverType&                                          solver,
  CellLabel&                                           cellLabel,
  const FaceLabels&                                    faceLabels,
  const bool                                           admissible,
  [[maybe_unused]] const Value* const                  candidate,
  [[maybe_unused]] const Value* const                  candidateSubcells,
  [[maybe_unused]] const Value* const                  quadraturePoints1D
) {
  using Layout = exahype2::dg::limiting::SubcellLayout<SolverType>;

  const auto remainsOnSubcellScheme = cellLabel.getWasTroubledInPreviousStep();
  // A new rejection or its directly limited ring sets the bit again for the following step.
  cellLabel.setWasTroubledInPreviousStep(false);

  if constexpr (SolverType::UsesAdaptiveTimeStepping) {
    if (
      admissible and not remainsOnSubcellScheme
      and cellLabel.getPreviousLimiterStatus() == exahype2::dg::LimiterStatus::Regular
    ) {
      assertion(candidate != nullptr);
      assertion(candidateSubcells != nullptr);
      assertion(quadraturePoints1D != nullptr);
      const double timeStamp      = cellLabel.getTimeStamp();
      const double timeStepSize   = cellLabel.getTimeStepSize();
      const auto   maxEigenvalues = exahype2::dg::reduceMaxEigenvalues<
        SolverType,
        Layout::NumberOfDofsPerAxis,
        SolverType::NumberOfUnknowns,
        SolverType::NumberOfAuxiliaryVariables>(
        candidate,
        quadraturePoints1D,
        marker.getX(),
        marker.getH(),
        timeStamp,
        timeStepSize
      );
      solver.setMaxEigenvalue(maxEigenvalues.maxPhysicalEigenvalue);
      solver.setMaxScaledEigenvalue(maxEigenvalues.maxScaledEigenvalue);

      const auto subcellEigenvalues = exahype2::dg::limiting::reduceSubcellMaxEigenvalues<SolverType>(
        candidateSubcells,
        marker.getX(),
        marker.getH(),
        timeStamp,
        timeStepSize
      );
      solver.setMaxEigenvalue(subcellEigenvalues.maxPhysicalEigenvalue);
      solver.setMaxScaledEigenvalue(subcellEigenvalues.maxScaledEigenvalue);
    }
  }

  if (not admissible) {
    cellLabel.setLimiterStatus(exahype2::dg::LimiterStatus::Troubled);
    cellLabel.setWasTroubledInPreviousStep(true);
  } else if (remainsOnSubcellScheme) {
    cellLabel.setLimiterStatus(exahype2::dg::LimiterStatus::Limited);
  }
  if (not admissible or remainsOnSubcellScheme) {
    solver.markCellAsTroubled();
  }
  exahype2::dg::limiting::projectCellStatusOntoFaces(cellLabel, faceLabels);
}

/**
 * Tests a cell's candidate solution against the physical admissibility term and writes the verdict.
 *
 * The subcell scheme starts from the subcell averages of an accepted candidate, so the
 * admissibility term tests them and they bound the time step like the nodes.
 */
template <typename SolverType, bool UsesAdmissibilityCriterion, typename Value, typename CellLabel, typename FaceLabels>
INLINE_METHOD void exahype2::dg::limiting::correctAndFlag(
  const peano4::dataview::CellMarker& marker,
  SolverType&                         solver,
  CellLabel&                          cellLabel,
  const FaceLabels&                   faceLabels,
  const Value* const                  candidate,
  const Value* const                  dgToFvMatrix,
  const Value* const                  quadraturePoints1D
) {
  using Layout = exahype2::dg::limiting::SubcellLayout<SolverType>;
  assertion(candidate != nullptr);
  assertion(dgToFvMatrix != nullptr);

  Value candidateSubcells[Layout::NumberOfSubcells * Layout::NumberOfData];
  exahype2::dg::projectTensorProduct<
    DIMENSIONS,
    Layout::NumberOfDofsPerAxis,
    Layout::NumberOfSubcellsPerAxis,
    Layout::NumberOfData>(candidate, candidateSubcells, dgToFvMatrix);

  const bool admissible = exahype2::dg::limiting::isCandidateAdmissible<SolverType, UsesAdmissibilityCriterion>(
    marker,
    cellLabel,
    candidate,
    candidateSubcells
  );
  exahype2::dg::limiting::commitLimiterVerdict<
    SolverType>(marker, solver, cellLabel, faceLabels, admissible, candidate, candidateSubcells, quadraturePoints1D);
}

/**
 * Tests a cell's candidate solution against the physical admissibility term and the discrete
 * maximum principle, and writes the verdict.
 *
 * The corrector has not touched the predictor backup, so it still holds the accepted previous
 * solution. The previous-step ranges of every cell adjacent to a node of this one widen the
 * reference, the neighbourhood V_i of Dumbser, Zanotti, Loubere and Diot, arXiv 1406.7416,
 * equation 23.
 */
template <
  typename SolverType,
  bool UsesAdmissibilityCriterion,
  int  NumberOfObservables,
  bool UsesRelaxationTerm,
  typename Value,
  typename CellLabel,
  typename FaceLabels,
  typename VertexLabels>
INLINE_METHOD void exahype2::dg::limiting::correctAndFlag(
  const peano4::dataview::CellMarker& marker,
  SolverType&                         solver,
  CellLabel&                          cellLabel,
  const FaceLabels&                   faceLabels,
  const VertexLabels&                 vertexLabels,
  const Value* const                  candidate,
  const Value* const                  previousSolution,
  const Value* const                  dgToFvMatrix,
  const Value* const                  dgToLobattoMatrix,
  const Value* const                  dgToSubcellMatrix,
  const Value* const                  quadraturePoints1D,
  const Value                         relaxationParameter,
  const Value                         differencesScaling
) {
  static_assert(NumberOfObservables > 0, "The discrete maximum principle needs at least one observable.");
  using Layout = exahype2::dg::limiting::SubcellLayout<SolverType>;
  assertion(candidate != nullptr);
  assertion(previousSolution != nullptr);
  assertion(dgToFvMatrix != nullptr);

  Value candidateSubcells[Layout::NumberOfSubcells * Layout::NumberOfData];
  exahype2::dg::projectTensorProduct<
    DIMENSIONS,
    Layout::NumberOfDofsPerAxis,
    Layout::NumberOfSubcellsPerAxis,
    Layout::NumberOfData>(candidate, candidateSubcells, dgToFvMatrix);

  const bool passesAdmissibilityCriterion =
    exahype2::dg::limiting::isCandidateAdmissible<SolverType, UsesAdmissibilityCriterion>(
      marker,
      cellLabel,
      candidate,
      candidateSubcells
    );

  const auto mapStateToObservables = [](const Value* const state, Value* const observables) {
    SolverType::mapDmpObservables(observables, state);
  };
  Value candidateMinimum[NumberOfObservables];
  Value candidateMaximum[NumberOfObservables];
  exahype2::dg::limiting::reduceSampledObservableExtrema<
    NumberOfObservables,
    Layout::NumberOfDofsPerAxis,
    Layout::NumberOfSubcellsPerAxis,
    Layout::NumberOfData>(
    candidateMinimum,
    candidateMaximum,
    candidate,
    dgToLobattoMatrix,
    dgToSubcellMatrix,
    mapStateToObservables
  );
  Value referenceMinimum[NumberOfObservables];
  Value referenceMaximum[NumberOfObservables];
  exahype2::dg::limiting::reduceSampledObservableExtrema<
    NumberOfObservables,
    Layout::NumberOfDofsPerAxis,
    Layout::NumberOfSubcellsPerAxis,
    Layout::NumberOfData>(
    referenceMinimum,
    referenceMaximum,
    previousSolution,
    dgToLobattoMatrix,
    dgToSubcellMatrix,
    mapStateToObservables
  );
  exahype2::dg::limiting::widenRangeByVertexObservableExtrema<NumberOfObservables>(
    referenceMinimum,
    referenceMaximum,
    vertexLabels
  );
  const bool passesMaximumPrinciple =
    exahype2::dg::limiting::satisfiesRelaxedMaximumPrinciple<SolverType, NumberOfObservables, UsesRelaxationTerm>(
      candidateMinimum,
      candidateMaximum,
      referenceMinimum,
      referenceMaximum,
      relaxationParameter,
      differencesScaling
    );

  exahype2::dg::limiting::commitLimiterVerdict<SolverType>(
    marker,
    solver,
    cellLabel,
    faceLabels,
    passesAdmissibilityCriterion and passesMaximumPrinciple,
    candidate,
    candidateSubcells,
    quadraturePoints1D
  );
}
