TARGET_DECLARE
/**
 * Fills the outer halo layers of one subcell face that sits at a resolution transition.
 *
 * The subcell halo never travels across a resolution transition, so the outer layers of such a
 * face are rebuilt in the traversal that consumes them: A persistent coarse face samples its
 * neighbour's Galerkin face trace, a hanging face extrapolates the cell's own face-touching layer.
 * The argument estimateFace holds the Galerkin estimates of both sides of the face.
 */
template <typename SolverType, int HaloWidth, typename Value, typename EstimatePrecision>
INLINE_METHOD GPU_CALLABLE_METHOD void exahype2::dg::limiting::rebuildTransitionFaceHalo(
  const int                      faceNumber,
  const bool                     isCoarseTransitionSide,
  const bool                     isFineTransitionSide,
  const EstimatePrecision* const estimateFace,
  const Value* const             subcellSolution,
  Value* const                   transitionFace,
  const Value* const             dgToFvMatrix
) {
  assertion(faceNumber >= 0, faceNumber);
  assertion(faceNumber < 2 * DIMENSIONS, faceNumber);
  assertion(isCoarseTransitionSide or isFineTransitionSide);
  assertion(estimateFace != nullptr);
  assertion(subcellSolution != nullptr);
  assertion(transitionFace != nullptr);
  assertion(dgToFvMatrix != nullptr);

  using Layout = exahype2::dg::limiting::SubcellLayout<SolverType>;

  constexpr int TangentialSubcells   = peano4::power(Layout::NumberOfSubcellsPerAxis, DIMENSIONS - 1);
  constexpr int TangentialNodes      = peano4::power(Layout::NumberOfDofsPerAxis, DIMENSIONS - 1);
  constexpr int TraceElementsPerSide = TangentialNodes * Layout::NumberOfData;

  const auto axis = faceNumber % DIMENSIONS;
  Value      outerHaloProfile[TangentialSubcells * Layout::NumberOfData];
  if (isCoarseTransitionSide) {
    const auto* const neighbourTraceEstimates = estimateFace + (faceNumber < DIMENSIONS ? 0 : TraceElementsPerSide);
    Value             neighbourTrace[TraceElementsPerSide];
    for (int entry = 0; entry < TraceElementsPerSide; entry++) {
      neighbourTrace[entry] = static_cast<Value>(neighbourTraceEstimates[entry]);
    }
    exahype2::dg::projectTensorProduct<
      DIMENSIONS - 1,
      Layout::NumberOfDofsPerAxis,
      Layout::NumberOfSubcellsPerAxis,
      Layout::NumberOfData>(neighbourTrace, outerHaloProfile, dgToFvMatrix);
  }
  peano4::dForEachExclusive(
    Layout::NumberOfSubcellsPerAxis,
    axis,
    0,
    [&](const tarch::la::Vector<DIMENSIONS, int>& tangentialIndex) {
      int tangentialSerialised = 0;
      int tangentialStride     = 1;
      for (int dimension = 0; dimension < DIMENSIONS; dimension++) {
        if (dimension != axis) {
          tangentialSerialised += tangentialIndex(dimension) * tangentialStride;
          tangentialStride *= Layout::NumberOfSubcellsPerAxis;
        }
      }
      if (isFineTransitionSide) {
        // The hanging face is recreated each traversal, so the touching layer comes from the
        // persistent cell patch.
        auto ownIndex            = tangentialIndex;
        ownIndex(axis)           = faceNumber < DIMENSIONS ? 0 : Layout::NumberOfSubcellsPerAxis - 1;
        const auto serialisedOwn = peano4::dLinearised(ownIndex, Layout::NumberOfSubcellsPerAxis);
        for (int value = 0; value < Layout::NumberOfData; value++) {
          outerHaloProfile[tangentialSerialised * Layout::NumberOfData + value] =
            subcellSolution[serialisedOwn * Layout::NumberOfData + value];
        }
      }
      for (int layer = 0; layer < HaloWidth; layer++) {
        auto outerIndex  = tangentialIndex;
        outerIndex(axis) = faceNumber < DIMENSIONS ? layer : HaloWidth + layer;
        const auto serialisedOuter =
          exahype2::serialiseVoxelIndexInOverlap(outerIndex, Layout::NumberOfSubcellsPerAxis, HaloWidth, axis);
        for (int value = 0; value < Layout::NumberOfData; value++) {
          transitionFace[serialisedOuter * Layout::NumberOfData + value] =
            outerHaloProfile[tangentialSerialised * Layout::NumberOfData + value];
        }
      }
    }
  );
}
TARGET_DECLARE_END

/**
 * Advances a cell that runs the subcell scheme by one time step on its finite-volume subgrid and
 * projects the result back onto the Galerkin nodes.
 *
 * The corrector advanced this cell's stamp when it committed the candidate, so the step being
 * recomputed started one step size earlier. The evolved subgrid is the next step's input of a cell
 * that stays on the subcell scheme.
 */
template <
  typename SolverType,
  typename Reconstruction,
  typename FallbackReconstruction,
  typename TimeStepping,
  int  HaloWidth,
  bool UsesAdmissibilityCriterion,
  bool EvaluateFlux,
  bool EvaluateNonconservativeProduct,
  bool EvaluateSource,
  bool EvaluateDiffusiveSource,
  bool EvaluateCustomRiemann,
  bool EvaluateMaxEigenvalue,
  bool EvaluateMaxEigenvalueOfFinalState,
  typename Value,
  typename CellLabel,
  typename FaceLabels,
  typename EstimateFaces,
  typename OldSubcellFaces,
  typename SubcellPatch,
  typename NodalPatch>
INLINE_METHOD void exahype2::dg::limiting::recomputeSubcells(
  const peano4::dataview::CellMarker& marker,
  SolverType&                         solver,
  const CellLabel&                    cellLabel,
  const FaceLabels&                   faceLabels,
  const EstimateFaces&                estimateFaces,
  const OldSubcellFaces&              oldSubcellFaces,
  SubcellPatch&                       subcellPatch,
  NodalPatch&                         updatedState,
  const Value* const                  dgToFvMatrix,
  const Value* const                  fvToDgMatrix
) {
  static_assert(HaloWidth > 0, "A subcell scheme reads at least one halo layer.");
  static_assert(
    HaloWidth == Reconstruction::HaloSize,
    "The face buffers carry the halo of the primary reconstruction."
  );
  static_assert(
    std::is_same_v<Value, typename SubcellPatch::DoFType>,
    "The projection matrices and the subgrid carry the same precision."
  );
  assertion(dgToFvMatrix != nullptr);
  assertion(fvToDgMatrix != nullptr);

  if (not exahype2::dg::runsSubcellScheme(cellLabel.getLimiterStatus())) {
    return;
  }

  const double timeStepSize = cellLabel.getTimeStepSize();
  const double timeStamp    = cellLabel.getTimeStamp() - timeStepSize;

  using Layout = exahype2::dg::limiting::SubcellLayout<SolverType>;
  static_assert(
    HaloWidth <= Layout::NumberOfSubcellsPerAxis,
    "A halo reaches at most the neighbouring cell's subgrid."
  );

  // The finite-volume step writes the halo layers of the new subgrid into face buffers, and no
  // sweep reads these layers, so the buffers end with the cell.
  constexpr int ValuesPerFace =
    2 * HaloWidth * peano4::power(Layout::NumberOfSubcellsPerAxis, DIMENSIONS - 1) * Layout::NumberOfData;
  std::array<Value, 2 * DIMENSIONS * ValuesPerFace> newSubgridHalo;
  const Value*                                      oldFaceData[2 * DIMENSIONS];
  Value*                                            newFaceData[2 * DIMENSIONS];
  for (int faceNumber = 0; faceNumber < 2 * DIMENSIONS; faceNumber++) {
    oldFaceData[faceNumber] = oldSubcellFaces(faceNumber).data();
    newFaceData[faceNumber] = newSubgridHalo.data() + faceNumber * ValuesPerFace;
  }

  // The evolved subgrid lives in memory of this thread that is aligned like a heap-allocated
  // patch, because the finite-volume kernels use aligned vector instructions on it.
  using ScratchDeleter = decltype([](Value* const memory) { tarch::accelerator::freeHeapMemory(memory); });
  static thread_local const std::unique_ptr<Value[], ScratchDeleter> evolvedSubgrid(
    static_cast<Value*>(
      tarch::accelerator::allocateHeapMemory(Layout::NumberOfSubcells * Layout::NumberOfData * sizeof(Value))
    )
  );

  for (int faceNumber = 0; faceNumber < 2 * DIMENSIONS; faceNumber++) {
    const auto& transitionFaceLabel = faceLabels(faceNumber);
    const bool  isCoarseTransitionSide =
      transitionFaceLabel.getAboveHanging(0) or transitionFaceLabel.getAboveHanging(1);
    const bool isFineTransitionSide = transitionFaceLabel.getIsHanging();
    if (not isCoarseTransitionSide and not isFineTransitionSide) {
      continue;
    }
    exahype2::dg::limiting::rebuildTransitionFaceHalo<SolverType, HaloWidth>(
      faceNumber,
      isCoarseTransitionSide,
      isFineTransitionSide,
      estimateFaces(faceNumber).data(),
      subcellPatch.data(),
      oldSubcellFaces(faceNumber).data(),
      dgToFvMatrix
    );
  }

  const auto advanceSubcells = [&]<typename ReconstructionPolicy>() -> double {
    const double subcellMaxEigenvalue = exahype2::fv::applyFiniteVolume<
      ReconstructionPolicy,
      TimeStepping,
      SolverType,
      Layout::NumberOfSubcellsPerAxis,
      SolverType::NumberOfUnknowns,
      SolverType::NumberOfAuxiliaryVariables,
      EvaluateFlux,
      EvaluateNonconservativeProduct,
      EvaluateSource,
      EvaluateDiffusiveSource,
      EvaluateCustomRiemann,
      EvaluateMaxEigenvalue,
      EvaluateMaxEigenvalueOfFinalState,
      Value,
      Value>(
      subcellPatch.data(),
      evolvedSubgrid.get(),
      oldFaceData,
      newFaceData,
      marker.getX(),
      marker.getH(),
      timeStamp,
      timeStepSize,
      exahype2::fv::hostScratch<
        Value,
        TimeStepping::template ScratchSize<
          ReconstructionPolicy,
          Layout::NumberOfSubcellsPerAxis,
          SolverType::NumberOfUnknowns,
          SolverType::NumberOfAuxiliaryVariables,
          EvaluateFlux,
          EvaluateNonconservativeProduct,
          EvaluateSource>>()
    );
    if (std::isnan(subcellMaxEigenvalue)) {
      tarch::terminateWithError("The finite-volume time step of the subcells diverged in " + marker.toString());
    }
    return subcellMaxEigenvalue;
  };
  [[maybe_unused]] auto maxEigenvalue = advanceSubcells.template operator()<Reconstruction>();

  if constexpr (UsesAdmissibilityCriterion and not std::is_void_v<FallbackReconstruction>) {
    static_assert(
      FallbackReconstruction::HaloSize == Reconstruction::HaloSize,
      "The fallback reads the halo layout of the primary reconstruction."
    );
    bool needsFallbackReconstruction = false;
    for (int subcell = 0; subcell < Layout::NumberOfSubcells; subcell++) {
      const auto* const subcellState = evolvedSubgrid.get() + subcell * Layout::NumberOfData;
      if (not SolverType::isPhysicallyAdmissible(subcellState, 1, marker.getX(), marker.getH())) {
        needsFallbackReconstruction = true;
        break;
      }
    }
    if (needsFallbackReconstruction) {
      maxEigenvalue = advanceSubcells.template operator()<FallbackReconstruction>();
    }
  }

  // The nodal patch is the limiter's plot buffer, and the subgrid patch keeps the evolved subgrid
  // for the next step.
  exahype2::dg::projectTensorProduct<
    DIMENSIONS,
    Layout::NumberOfSubcellsPerAxis,
    Layout::NumberOfDofsPerAxis,
    Layout::NumberOfData>(evolvedSubgrid.get(), updatedState.data(), fvToDgMatrix);
  std::copy_n(evolvedSubgrid.get(), Layout::NumberOfSubcells * Layout::NumberOfData, subcellPatch.data());

  if constexpr (SolverType::UsesAdaptiveTimeStepping) {
    // The subgrid resolves waves the smoothed candidate hides, so the admissible step comes from
    // the finite-volume wave speed.
    exahype2::dg::MaxEigenvalueStatistics subcellEigenvalueStatistics;
    subcellEigenvalueStatistics.accumulate<DIMENSIONS>(
      marker.getH(),
      [maxEigenvalue]([[maybe_unused]] const int dimension) { return maxEigenvalue; }
    );
    solver.setMaxEigenvalue(subcellEigenvalueStatistics.maxPhysicalEigenvalue);
    solver.setMaxScaledEigenvalue(subcellEigenvalueStatistics.maxScaledEigenvalue);
  }
}
