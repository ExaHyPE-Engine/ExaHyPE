/**
 * Writes a cell's limiter status onto the side of each adjacent face the cell owns.
 *
 * A cell owns the right side of its lower faces and the left side of its upper faces.
 */
template <typename CellLabel, typename FaceLabels>
INLINE_METHOD void exahype2::dg::limiting::projectCellStatusOntoFaces(
  const CellLabel&  cellLabel,
  const FaceLabels& faceLabels
) {
  const auto limiterStatus = cellLabel.getLimiterStatus();
  for (int faceNumber = 0; faceNumber < 2 * DIMENSIONS; faceNumber++) {
    const auto ownSide = faceNumber < DIMENSIONS ? 1 : 0;
    faceLabels(faceNumber).setLimiterStatus(ownSide, limiterStatus);
  }
}

/**
 * Resets the refined sides of a face to LimiterStatus::Regular.
 *
 * The hanging subfaces raise their fine statuses onto a refined side while the traversal descends,
 * and the face event runs before the subtree below is entered.
 */
template <typename FaceLabel>
INLINE_METHOD void exahype2::dg::limiting::resetRefinedFaceStatus(FaceLabel& faceLabel) {
  for (int faceSide = 0; faceSide < 2; faceSide++) {
    if (faceLabel.getAboveHanging(faceSide)) {
      faceLabel.setLimiterStatus(faceSide, exahype2::dg::LimiterStatus::Regular);
    }
  }
}

/**
 * Copies both sides of a face's limiter status into its snapshot and resets the refined sides.
 *
 * A cell of the spreading sweep reads the snapshot of its neighbours and writes the live status,
 * so the two never mix within one sweep.
 */
template <typename FaceLabel>
INLINE_METHOD void exahype2::dg::limiting::snapshotFaceStatus(FaceLabel& faceLabel) {
  for (int faceSide = 0; faceSide < 2; faceSide++) {
    faceLabel.setLimiterStatusSnapshot(faceSide, faceLabel.getLimiterStatus(faceSide));
  }
  exahype2::dg::limiting::resetRefinedFaceStatus(faceLabel);
}

/**
 * Copies both sides of a hanging face's limiter status from the coarse face's snapshot.
 *
 * A hanging face keeps whatever its storage slot last held, so the live status and the snapshot
 * are both written on first touch.
 */
template <typename FaceLabel, typename CoarseFaceLabels>
INLINE_METHOD void exahype2::dg::limiting::copyCoarseFaceStatusOntoHangingFace(
  const int               faceNumber,
  FaceLabel&              faceLabel,
  const CoarseFaceLabels& coarseFaceLabels
) {
  assertion(faceNumber >= 0, faceNumber);
  assertion(faceNumber < 2 * DIMENSIONS, faceNumber);
  for (int faceSide = 0; faceSide < 2; faceSide++) {
    const auto coarseStatus = coarseFaceLabels(faceNumber).getLimiterStatusSnapshot(faceSide);
    faceLabel.setLimiterStatus(faceSide, coarseStatus);
    faceLabel.setLimiterStatusSnapshot(faceSide, coarseStatus);
  }
}

/**
 * Raises the fine cell's limiter status of a hanging face onto the refined side of the coarse face.
 *
 * The adjacent fine cell has written its status onto its side by the time the hanging face is left,
 * and the maximum over the subfaces is the same for every subface order.
 */
template <typename FaceLabel, typename CoarseFaceLabels>
INLINE_METHOD void exahype2::dg::limiting::raiseHangingFaceStatusOntoCoarseFace(
  const int               faceNumber,
  const FaceLabel&        faceLabel,
  const CoarseFaceLabels& coarseFaceLabels
) {
  assertion(faceNumber >= 0, faceNumber);
  assertion(faceNumber < 2 * DIMENSIONS, faceNumber);
  const auto refinedSide = faceNumber < DIMENSIONS ? 1 : 0;
  coarseFaceLabels(faceNumber).raiseLimiterStatus(refinedSide, faceLabel.getLimiterStatus(refinedSide));
}
