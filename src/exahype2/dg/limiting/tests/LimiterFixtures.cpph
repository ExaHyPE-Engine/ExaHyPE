template <typename Element, int Cardinality>
INLINE_METHOD Element& exahype2::dg::limiting::tests::TestEnumerator<Element, Cardinality>::operator()(
  const int index
) const {
  assertion(index >= 0, index);
  assertion(index < Cardinality, index);
  return elements[index];
}

template <typename Value, int Cardinality>
INLINE_METHOD Value* exahype2::dg::limiting::tests::TestPatch<Value, Cardinality>::data() {
  return values;
}

template <typename Value, int Cardinality>
INLINE_METHOD const Value* exahype2::dg::limiting::tests::TestPatch<Value, Cardinality>::data() const {
  return values;
}

template <bool Adaptive>
INLINE_METHOD void exahype2::dg::limiting::tests::TestSolver<Adaptive>::setMaxEigenvalue(const double value) {
  maxPhysicalEigenvalue = std::max(maxPhysicalEigenvalue, value);
}

template <bool Adaptive>
INLINE_METHOD void exahype2::dg::limiting::tests::TestSolver<Adaptive>::setMaxScaledEigenvalue(const double value) {
  maxScaledEigenvalue = std::max(maxScaledEigenvalue, value);
}

template <bool Adaptive>
INLINE_METHOD void exahype2::dg::limiting::tests::TestSolver<Adaptive>::markCellAsTroubled() {
  numberOfTroubledCells++;
}

template <bool Adaptive>
INLINE_METHOD void exahype2::dg::limiting::tests::TestSolver<Adaptive>::initialCondition(
  double* const                                                 state,
  const tarch::la::Vector<DIMENSIONS, double>&                  volumeCentre,
  [[maybe_unused]] const tarch::la::Vector<DIMENSIONS, double>& volumeSize
) {
  state[0] = volumeCentre(0);
}

template <bool Adaptive>
INLINE_METHOD void exahype2::dg::limiting::tests::TestSolver<Adaptive>::mapDmpObservables(
  double* const       observables,
  const double* const state
) {
  observables[0] = state[0];
}

/**
 * Returns twice the parameter, so a test tells the widened relaxation from the specified one.
 */
template <bool Adaptive>
INLINE_METHOD double exahype2::dg::limiting::tests::TestSolver<Adaptive>::dmpRelaxationParameter(
  [[maybe_unused]] const int observable,
  const double               specifiedRelaxationParameter
) {
  return 2.0 * specifiedRelaxationParameter;
}

template <bool Adaptive>
INLINE_METHOD bool exahype2::dg::limiting::tests::TestSolver<Adaptive>::isPhysicallyAdmissible(
  const double* const                                           state,
  const int                                                     numberOfStates,
  [[maybe_unused]] const tarch::la::Vector<DIMENSIONS, double>& x,
  [[maybe_unused]] const tarch::la::Vector<DIMENSIONS, double>& h
) {
  constexpr int NumberOfData = NumberOfUnknowns + NumberOfAuxiliaryVariables;
  for (int stateNumber = 0; stateNumber < numberOfStates; stateNumber++) {
    if (state[stateNumber * NumberOfData] < 0.0) {
      return false;
    }
  }
  return true;
}

template <bool Adaptive>
template <typename ComputePrecision>
INLINE_METHOD void exahype2::dg::limiting::tests::TestSolver<Adaptive>::flux(
  const ComputePrecision* const                                 state,
  [[maybe_unused]] const tarch::la::Vector<DIMENSIONS, double>& volumeCentre,
  [[maybe_unused]] const tarch::la::Vector<DIMENSIONS, double>& volumeSize,
  [[maybe_unused]] const double                                 timeStamp,
  [[maybe_unused]] const double                                 timeStepSize,
  [[maybe_unused]] const int                                    normal,
  ComputePrecision* const                                       fluxes
) {
  numberOfFluxEvaluations++;
  fluxes[0] = static_cast<ComputePrecision>(AdvectionSpeed) * state[0];
}

template <bool Adaptive>
template <typename ComputePrecision>
INLINE_METHOD double exahype2::dg::limiting::tests::TestSolver<Adaptive>::maxEigenvalue(
  [[maybe_unused]] const ComputePrecision* const                state,
  [[maybe_unused]] const tarch::la::Vector<DIMENSIONS, double>& volumeCentre,
  [[maybe_unused]] const tarch::la::Vector<DIMENSIONS, double>& volumeSize,
  [[maybe_unused]] const double                                 timeStamp,
  [[maybe_unused]] const double                                 timeStepSize,
  [[maybe_unused]] const int                                    normal
) {
  return AdvectionSpeed;
}

template <bool Adaptive>
template <typename ComputePrecision>
INLINE_METHOD void exahype2::dg::limiting::tests::TestSolver<Adaptive>::boundaryConditions(
  const ComputePrecision* const                                 stateInside,
  ComputePrecision* const                                       stateOutside,
  [[maybe_unused]] const tarch::la::Vector<DIMENSIONS, double>& x,
  [[maybe_unused]] const tarch::la::Vector<DIMENSIONS, double>& h,
  [[maybe_unused]] const double                                 timeStamp,
  [[maybe_unused]] const int                                    normal
) {
  stateOutside[0] = stateInside[0];
}

INLINE_METHOD peano4::dataview::CellMarker exahype2::dg::limiting::tests::TestGeometry::cellMarker(
  const double centre,
  const double width
) {
  peano4::dataview::CellMarker marker;
  marker.level  = 1;
  marker.h      = tarch::la::Vector<DIMENSIONS, double>(width);
  marker.centre = tarch::la::Vector<DIMENSIONS, double>(centre);
  marker.flags  = peano4::dataview::CellMarker::IsLocal;
  return marker;
}
