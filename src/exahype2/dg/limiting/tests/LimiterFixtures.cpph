INLINE_METHOD void exahype2::dg::limiting::tests::TestFaceLabel::raiseLimiterStatus(
  const int                         side,
  const exahype2::dg::LimiterStatus value
) {
  limiterStatus[side] = exahype2::dg::mergeLimiterStatus(limiterStatus[side], value);
}

