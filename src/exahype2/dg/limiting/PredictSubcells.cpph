/**
 * Opens a cell's limiter step: The status of the closed step becomes the previous status, and a
 * cell that was troubled runs the subcell scheme.
 *
 * The previous status decides whether a cell keeps its evolved subcell data.
 */
template <typename CellLabel>
INLINE_METHOD void exahype2::dg::limiting::predictSubcells(CellLabel& cellLabel) {
  cellLabel.setPreviousLimiterStatus(cellLabel.getLimiterStatus());
  cellLabel.setLimiterStatus(
    cellLabel.getWasTroubledInPreviousStep() ? exahype2::dg::LimiterStatus::Limited
                                             : exahype2::dg::LimiterStatus::Regular
  );
}

/**
 * Opens a cell's limiter step and reduces the observable extrema of its accepted solution into its
 * vertices.
 *
 * The predictor backup holds the accepted solution and takes the same extrema samples as the
 * candidate that the corrector tests against them.
 */
template <typename SolverType, int NumberOfObservables, typename Value, typename CellLabel, typename VertexLabels>
INLINE_METHOD void exahype2::dg::limiting::predictSubcells(
  CellLabel&          cellLabel,
  const Value* const  acceptedSolution,
  const Value* const  dgToLobattoMatrix,
  const Value* const  dgToSubcellMatrix,
  const VertexLabels& vertexLabels
) {
  static_assert(NumberOfObservables > 0, "The discrete maximum principle needs at least one observable.");
  assertion(acceptedSolution != nullptr);
  exahype2::dg::limiting::predictSubcells(cellLabel);

  using Layout = exahype2::dg::limiting::SubcellLayout<SolverType>;

  const auto mapStateToObservables = [](const Value* const state, Value* const observables) {
    SolverType::mapDmpObservables(observables, state);
  };

  Value acceptedMinimum[NumberOfObservables];
  Value acceptedMaximum[NumberOfObservables];
  exahype2::dg::limiting::reduceSampledObservableExtrema<
    NumberOfObservables,
    Layout::NumberOfDofsPerAxis,
    Layout::NumberOfSubcellsPerAxis,
    Layout::NumberOfData>(
    acceptedMinimum,
    acceptedMaximum,
    acceptedSolution,
    dgToLobattoMatrix,
    dgToSubcellMatrix,
    mapStateToObservables
  );
  exahype2::dg::limiting::reduceCellObservableExtremaIntoVertices<NumberOfObservables>(
    acceptedMinimum,
    acceptedMaximum,
    vertexLabels
  );
}
