/**
 * Grows the subcell domain by one ring around a troubled cell and writes the subgrid of every
 * non-regular cell onto its halo faces.
 *
 * The projection of the accepted polynomial overwrites only the subgrid of a cell entering the
 * scheme; a cell entering within the first time step keeps the subcells the grid initialisation
 * sampled. The recompute reads its halo from the previous-solution faces, the only subcell faces
 * that travel between the spreading sweep and the recompute sweep.
 */
template <
  typename SolverType,
  int HaloWidth,
  typename Value,
  typename CellLabel,
  typename FaceLabels,
  typename SubcellFaces,
  typename AcceptedPatch,
  typename SubcellPatch>
INLINE_METHOD void exahype2::dg::limiting::spreadDomain(
  const peano4::dataview::CellMarker& marker,
  SolverType&                         solver,
  CellLabel&                          cellLabel,
  const FaceLabels&                   faceLabels,
  const SubcellFaces&                 subcellFaces,
  AcceptedPatch&                      acceptedSolution,
  SubcellPatch&                       subcellPatch,
  const Value* const                  dgToFvMatrix
) {
  static_assert(HaloWidth > 0, "A subcell scheme reads at least one halo layer.");
  static_assert(
    std::is_same_v<Value, typename SubcellPatch::DoFType>,
    "The projection matrix and the subgrid carry the same precision."
  );
  assertion(dgToFvMatrix != nullptr);

  using Layout = exahype2::dg::limiting::SubcellLayout<SolverType>;
  static_assert(
    HaloWidth <= Layout::NumberOfSubcellsPerAxis,
    "A halo reaches at most the neighbouring cell's subgrid."
  );

  auto status               = cellLabel.getLimiterStatus();
  bool hasTroubledNeighbour = false;
  for (int faceNumber = 0; faceNumber < 2 * DIMENSIONS; faceNumber++) {
    const auto neighbourSide   = faceNumber < DIMENSIONS ? 0 : 1;
    const auto neighbourStatus = faceLabels(faceNumber).getLimiterStatusSnapshot(neighbourSide);
    hasTroubledNeighbour       = hasTroubledNeighbour or neighbourStatus == exahype2::dg::LimiterStatus::Troubled;
    status = exahype2::dg::mergeLimiterStatus(status, exahype2::dg::spreadLimiterStatus(neighbourStatus));
  }
  cellLabel.setLimiterStatus(status);
  if (hasTroubledNeighbour) {
    // The directly limited ring remains on the subcell scheme for one additional step together
    // with its troubled cell.
    cellLabel.setWasTroubledInPreviousStep(true);
  }
  exahype2::dg::limiting::projectCellStatusOntoFaces(cellLabel, faceLabels);

  if (status != exahype2::dg::LimiterStatus::Regular) {
    const bool holdsInitialSubcells = cellLabel.getTimeStamp() <= cellLabel.getTimeStepSize();
    if (not exahype2::dg::runsSubcellScheme(cellLabel.getPreviousLimiterStatus()) and not holdsInitialSubcells) {
      exahype2::dg::projectTensorProduct<
        DIMENSIONS,
        Layout::NumberOfDofsPerAxis,
        Layout::NumberOfSubcellsPerAxis,
        Layout::NumberOfData>(acceptedSolution.data(), subcellPatch.data(), dgToFvMatrix);
    }

    Value* haloFaces[2 * DIMENSIONS];
    for (int faceNumber = 0; faceNumber < 2 * DIMENSIONS; faceNumber++) {
      haloFaces[faceNumber] = subcellFaces(faceNumber).data();
    }
    exahype2::projectPatch<Layout::NumberOfSubcellsPerAxis, HaloWidth, Layout::NumberOfData, Value>(
      subcellPatch.data(),
      haloFaces
    );
    for (int faceNumber = 0; faceNumber < 2 * DIMENSIONS; faceNumber++) {
      if (not SolverType::PeriodicBoundaries[faceNumber % DIMENSIONS] and faceLabels(faceNumber).getBoundary()) {
        exahype2::fv::applyBoundaryConditionsOnFace<
          SolverType,
          Layout::NumberOfSubcellsPerAxis,
          HaloWidth,
          SolverType::NumberOfUnknowns,
          SolverType::NumberOfAuxiliaryVariables,
          Value>(
          solver,
          marker.getX(),
          marker.getH(),
          cellLabel.getTimeStamp() - cellLabel.getTimeStepSize(),
          faceNumber,
          subcellFaces(faceNumber).data()
        );
      }
    }
  }
}
