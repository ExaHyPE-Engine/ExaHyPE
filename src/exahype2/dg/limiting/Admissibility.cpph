TARGET_DECLARE
/**
 * Returns the relaxation the discrete maximum principle grants one observable. A solver that sets
 * the relaxation term replaces the specified parameter per observable.
 */
template <typename SolverType, bool UsesRelaxationTerm, typename Value>
INLINE_METHOD GPU_CALLABLE_METHOD Value exahype2::dg::limiting::relaxationParameterOfObservable(
  [[maybe_unused]] const int   observable,
  [[maybe_unused]] const Value relaxationParameter
) {
  if constexpr (UsesRelaxationTerm) {
    return SolverType::dmpRelaxationParameter(observable, relaxationParameter);
  } else {
    return relaxationParameter;
  }
}

/**
 * Seeds the extrema with infinities and reduces the observables of a tensor-product nodal state
 * into them.
 *
 * A polynomial can attain extrema between its storage nodes, so the reduction samples it at the
 * Lobatto nodes and through its subcell averages as well. Both matrices carry the input-node-major
 * layout of exahype2::dg::projectTensorProduct.
 */
template <
  int NumberOfObservables,
  int NumberOfDofsPerAxis,
  int NumberOfSubcellsPerAxis,
  int NumberOfData,
  typename Value,
  typename ObservableMapping>
INLINE_METHOD GPU_CALLABLE_METHOD void exahype2::dg::limiting::reduceSampledObservableExtrema(
  Value* const       minimum,
  Value* const       maximum,
  const Value* const nodalState,
  const Value* const dgToLobattoMatrix,
  const Value* const dgToSubcellMatrix,
  ObservableMapping  mapStateToObservables
) {
  static_assert(NumberOfObservables > 0, "The discrete maximum principle needs at least one observable.");
  static_assert(NumberOfDofsPerAxis > 0, "A cell holds at least one degree of freedom per axis.");
  static_assert(NumberOfSubcellsPerAxis > 0, "A cell holds at least one subcell per axis.");
  static_assert(NumberOfData > 0, "A node carries at least one value.");
  assertion(minimum != nullptr);
  assertion(maximum != nullptr);
  assertion(nodalState != nullptr);
  assertion(dgToLobattoMatrix != nullptr);
  assertion(dgToSubcellMatrix != nullptr);

  constexpr int NumberOfNodes = peano4::power(NumberOfDofsPerAxis, DIMENSIONS);

  for (int observable = 0; observable < NumberOfObservables; observable++) {
    minimum[observable] = std::numeric_limits<Value>::infinity();
    maximum[observable] = -std::numeric_limits<Value>::infinity();
  }
  exahype2::dg::reduceObservableExtrema<NumberOfObservables>(
    minimum,
    maximum,
    nodalState,
    NumberOfNodes,
    NumberOfData,
    mapStateToObservables
  );
  exahype2::dg::reduceProjectedObservableExtrema<
    DIMENSIONS,
    NumberOfDofsPerAxis,
    NumberOfDofsPerAxis,
    NumberOfData,
    NumberOfObservables>(minimum, maximum, nodalState, dgToLobattoMatrix, mapStateToObservables);
  exahype2::dg::reduceProjectedObservableExtrema<
    DIMENSIONS,
    NumberOfDofsPerAxis,
    NumberOfSubcellsPerAxis,
    NumberOfData,
    NumberOfObservables>(minimum, maximum, nodalState, dgToSubcellMatrix, mapStateToObservables);
}

/**
 * Returns whether every observable of the candidate range stays inside the relaxed reference range.
 */
template <typename SolverType, int NumberOfObservables, bool UsesRelaxationTerm, typename Value>
INLINE_METHOD GPU_CALLABLE_METHOD bool exahype2::dg::limiting::satisfiesRelaxedMaximumPrinciple(
  const Value* const candidateMinimum,
  const Value* const candidateMaximum,
  const Value* const referenceMinimum,
  const Value* const referenceMaximum,
  const Value        relaxationParameter,
  const Value        differencesScaling
) {
  static_assert(NumberOfObservables > 0, "The discrete maximum principle needs at least one observable.");
  assertion(candidateMinimum != nullptr);
  assertion(candidateMaximum != nullptr);
  assertion(referenceMinimum != nullptr);
  assertion(referenceMaximum != nullptr);
  assertion(relaxationParameter >= static_cast<Value>(0));
  assertion(differencesScaling >= static_cast<Value>(0));

  bool satisfied = true;
  for (int observableNumber = 0; observableNumber < NumberOfObservables; observableNumber++) {
    const Value observableRelaxation =
      exahype2::dg::limiting::relaxationParameterOfObservable<SolverType, UsesRelaxationTerm>(
        observableNumber,
        relaxationParameter
      );
    assertion(observableRelaxation >= static_cast<Value>(0), observableNumber, observableRelaxation);
    const bool observableInRange = exahype2::dg::satisfiesDiscreteMaximumPrinciple(
      candidateMinimum[observableNumber],
      candidateMaximum[observableNumber],
      referenceMinimum[observableNumber],
      referenceMaximum[observableNumber],
      observableRelaxation,
      differencesScaling
    );
    satisfied = satisfied and observableInRange;
  }
  return satisfied;
}
TARGET_DECLARE_END
