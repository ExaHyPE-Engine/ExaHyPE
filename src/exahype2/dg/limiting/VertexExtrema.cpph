/**
 * Seeds a vertex's observable extrema with infinities.
 *
 * The vertex event runs before any adjacent cell reduces into the vertex, so a vertex no cell
 * writes keeps the infinities.
 */
template <int NumberOfObservables, typename VertexLabel>
INLINE_METHOD void exahype2::dg::limiting::resetVertexObservableExtrema(VertexLabel& vertexLabel) {
  static_assert(NumberOfObservables > 0, "The discrete maximum principle needs at least one observable.");
  for (int observable = 0; observable < NumberOfObservables; observable++) {
    vertexLabel.setDmpMinimum(observable, std::numeric_limits<double>::infinity());
    vertexLabel.setDmpMaximum(observable, -std::numeric_limits<double>::infinity());
  }
}

/**
 * Reduces a cell's observable extrema into the extrema of its adjacent vertices.
 *
 * A minimum and a maximum are the same for every order of the adjacent cells, so a vertex does not
 * depend on the traversal or on the decomposition.
 */
template <int NumberOfObservables, typename Value, typename VertexLabels>
INLINE_METHOD void exahype2::dg::limiting::reduceCellObservableExtremaIntoVertices(
  const Value* const  minimum,
  const Value* const  maximum,
  const VertexLabels& vertexLabels
) {
  static_assert(NumberOfObservables > 0, "The discrete maximum principle needs at least one observable.");
  assertion(minimum != nullptr);
  assertion(maximum != nullptr);
  for (int vertexNumber = 0; vertexNumber < peano4::VerticesPerCell; vertexNumber++) {
    auto& vertexLabel = vertexLabels(vertexNumber);
    for (int observable = 0; observable < NumberOfObservables; observable++) {
      vertexLabel.setDmpMinimum(
        observable,
        exahype2::dg::mergeDiscreteMaximumPrincipleMinimum(
          vertexLabel.getDmpMinimum(observable),
          static_cast<double>(minimum[observable])
        )
      );
      vertexLabel.setDmpMaximum(
        observable,
        exahype2::dg::mergeDiscreteMaximumPrincipleMaximum(
          vertexLabel.getDmpMaximum(observable),
          static_cast<double>(maximum[observable])
        )
      );
    }
  }
}

/**
 * Widens a cell's observable range by the extrema of its adjacent vertices.
 *
 * A vertex holds the range of every cell adjacent to it, so the widened range covers every cell
 * that touches a node of this cell.
 */
template <int NumberOfObservables, typename Value, typename VertexLabels>
INLINE_METHOD void exahype2::dg::limiting::widenRangeByVertexObservableExtrema(
  Value* const        minimum,
  Value* const        maximum,
  const VertexLabels& vertexLabels
) {
  static_assert(NumberOfObservables > 0, "The discrete maximum principle needs at least one observable.");
  assertion(minimum != nullptr);
  assertion(maximum != nullptr);
  for (int vertexNumber = 0; vertexNumber < peano4::VerticesPerCell; vertexNumber++) {
    const auto& vertexLabel = vertexLabels(vertexNumber);
    for (int observable = 0; observable < NumberOfObservables; observable++) {
      minimum[observable] = exahype2::dg::mergeDiscreteMaximumPrincipleMinimum(
        minimum[observable],
        static_cast<Value>(vertexLabel.getDmpMinimum(observable))
      );
      maximum[observable] = exahype2::dg::mergeDiscreteMaximumPrincipleMaximum(
        maximum[observable],
        static_cast<Value>(vertexLabel.getDmpMaximum(observable))
      );
    }
  }
}

/**
 * Derives a hanging vertex's observable extrema from the coarse vertices.
 *
 * A hanging vertex keeps whatever its storage slot last held, so its extrema are seeded with
 * infinities and reduced over the coarse vertices on every father-cell boundary facet that
 * contains it.
 */
template <int NumberOfObservables, typename VertexLabel, typename CoarseVertexLabels>
INLINE_METHOD void exahype2::dg::limiting::interpolateHangingVertexObservableExtrema(
  const tarch::la::Vector<DIMENSIONS, int>& hangingVertexPosition,
  VertexLabel&                              vertexLabel,
  const CoarseVertexLabels&                 coarseVertexLabels
) {
  static_assert(NumberOfObservables > 0, "The discrete maximum principle needs at least one observable.");
  exahype2::dg::limiting::resetVertexObservableExtrema<NumberOfObservables>(vertexLabel);
  for (int coarseVertexNumber = 0; coarseVertexNumber < peano4::VerticesPerCell; coarseVertexNumber++) {
    if (exahype2::dg::isCoarseVertexOnFacetOfHangingVertex(hangingVertexPosition, coarseVertexNumber)) {
      const auto& coarseVertexLabel = coarseVertexLabels(coarseVertexNumber);
      for (int observable = 0; observable < NumberOfObservables; observable++) {
        vertexLabel.setDmpMinimum(
          observable,
          exahype2::dg::mergeDiscreteMaximumPrincipleMinimum(
            vertexLabel.getDmpMinimum(observable),
            coarseVertexLabel.getDmpMinimum(observable)
          )
        );
        vertexLabel.setDmpMaximum(
          observable,
          exahype2::dg::mergeDiscreteMaximumPrincipleMaximum(
            vertexLabel.getDmpMaximum(observable),
            coarseVertexLabel.getDmpMaximum(observable)
          )
        );
      }
    }
  }
}

/**
 * Reduces a hanging vertex's observable extrema into the coarse vertices.
 *
 * The adjacent fine cells have reduced their extrema into the hanging vertex by the time it is
 * left, and a minimum and a maximum are the same for every order of the fine cells.
 */
template <int NumberOfObservables, typename VertexLabel, typename CoarseVertexLabels>
INLINE_METHOD void exahype2::dg::limiting::restrictHangingVertexObservableExtrema(
  const tarch::la::Vector<DIMENSIONS, int>& hangingVertexPosition,
  const VertexLabel&                        vertexLabel,
  const CoarseVertexLabels&                 coarseVertexLabels
) {
  static_assert(NumberOfObservables > 0, "The discrete maximum principle needs at least one observable.");
  for (int coarseVertexNumber = 0; coarseVertexNumber < peano4::VerticesPerCell; coarseVertexNumber++) {
    if (exahype2::dg::isCoarseVertexOnFacetOfHangingVertex(hangingVertexPosition, coarseVertexNumber)) {
      auto& coarseVertexLabel = coarseVertexLabels(coarseVertexNumber);
      for (int observable = 0; observable < NumberOfObservables; observable++) {
        coarseVertexLabel.setDmpMinimum(
          observable,
          exahype2::dg::mergeDiscreteMaximumPrincipleMinimum(
            coarseVertexLabel.getDmpMinimum(observable),
            vertexLabel.getDmpMinimum(observable)
          )
        );
        coarseVertexLabel.setDmpMaximum(
          observable,
          exahype2::dg::mergeDiscreteMaximumPrincipleMaximum(
            coarseVertexLabel.getDmpMaximum(observable),
            vertexLabel.getDmpMaximum(observable)
          )
        );
      }
    }
  }
}

/**
 * Reduces two copies of one vertex into the extrema of the receiving copy.
 *
 * A minimum and a maximum are the same for every order of the copies, so the merged vertex does
 * not depend on the traversal or on the decomposition. The rank rebuilds the vertex label with a
 * copy, so the merge never sees a consolidation.
 */
template <int NumberOfObservables, typename VertexLabel>
INLINE_METHOD void exahype2::dg::limiting::mergeVertexObservableExtrema(
  const peano4::grid::SendReceiveContext context,
  VertexLabel&                           vertexLabel,
  const VertexLabel&                     neighbour
) {
  static_assert(NumberOfObservables > 0, "The discrete maximum principle needs at least one observable.");
  switch (context) {
  case peano4::grid::SendReceiveContext::InterRank:
  case peano4::grid::SendReceiveContext::IntraRank:
    for (int observable = 0; observable < NumberOfObservables; observable++) {
      vertexLabel.setDmpMinimum(
        observable,
        exahype2::dg::mergeDiscreteMaximumPrincipleMinimum(
          vertexLabel.getDmpMinimum(observable),
          neighbour.getDmpMinimum(observable)
        )
      );
      vertexLabel.setDmpMaximum(
        observable,
        exahype2::dg::mergeDiscreteMaximumPrincipleMaximum(
          vertexLabel.getDmpMaximum(observable),
          neighbour.getDmpMaximum(observable)
        )
      );
    }
    break;
  case peano4::grid::SendReceiveContext::Consolidation:
    assertion(false, "The rank rebuilds the vertex label with a copy, so its merge never sees a consolidation.");
    break;
  }
}
