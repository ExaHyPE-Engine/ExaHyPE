#include "exahype2/LevelJumps.h"
#include "exahype2/fv/Kernels.h"
#include "tarch/Assertions.h"
#include "tarch/MemoryUsage.h"
#include "tarch/Span.h"
#include "tarch/accelerator/ParallelFor.h"
#include "tarch/accelerator/ParallelReduce.h"
#include "tarch/accelerator/Range.h"
#include "tarch/accelerator/Reducer.h"
#include "tarch/accelerator/Scratch.h"
#include "tarch/mpi/ReductionRecord.h"

/**
 * The parameter relaxationParameter is the absolute widening of the discrete maximum principle.
 * The parameter differencesScaling is its widening relative to the reference range.
 */
template <
  typename Derived,
  typename StoragePrecision,
  typename ComputePrecision,
  template <typename, typename, typename> class SubcellFamily>
INLINE_METHOD exahype2::dg::limiting::SubcellLimiter<Derived, StoragePrecision, ComputePrecision, SubcellFamily>::SubcellLimiter(
  const double relaxationParameter,
  const double differencesScaling
) :
  _relaxationParameter{relaxationParameter},
  _differencesScaling{differencesScaling} {
  assertion(std::isfinite(relaxationParameter) and relaxationParameter >= 0.0, relaxationParameter);
  assertion(std::isfinite(differencesScaling) and differencesScaling >= 0.0, differencesScaling);
  static_assert(
    SubcellScheme::HaloSize <= SubcellScheme::SubcellsPerAxis,
    "The halo of the subcell scheme must fit into the subgrid of a cell."
  );
}

/**
 * Allocates the projection tables, the pools and the exchanges. Every rank calls this at the same
 * time. The exchanges then take the same MPI tags.
 */
template <
  typename Derived,
  typename StoragePrecision,
  typename ComputePrecision,
  template <typename, typename, typename> class SubcellFamily>
INLINE_METHOD void
exahype2::dg::limiting::SubcellLimiter<Derived, StoragePrecision, ComputePrecision, SubcellFamily>::allocate(
  const peano4::CellConnectivity& cellConnectivity
) {
  SubcellProjection<double>::initialise();
  if constexpr (not std::is_same_v<StoragePrecision, double>) {
    SubcellProjection<StoragePrecision>::initialise();
  }
  _previousSolution.reserve(cellConnectivity.getNumberOfSlots());
  _subcells.reserve(cellConnectivity.getNumberOfSlots());
  _statuses.reserve(cellConnectivity.getNumberOfSlots());
  if constexpr (Detector::UsesMaximumPrinciple) {
    _referenceExtrema.reserve(cellConnectivity.getNumberOfSlots());
  }
  rebuild(cellConnectivity);
}

template <
  typename Derived,
  typename StoragePrecision,
  typename ComputePrecision,
  template <typename, typename, typename> class SubcellFamily>
INLINE_METHOD void
exahype2::dg::limiting::SubcellLimiter<Derived, StoragePrecision, ComputePrecision, SubcellFamily>::release() {
  _haloExchange.release();
  _statusExchange.release();
  _extremaExchange.release();
  _subcellMigration.release();
  _statusMigration.release();
  _previousSolution.release();
  _subcells.release();
  _subcellHalo.release();
  _appliedFluxes.release();
  _statuses.release();
  _faceStatuses.release();
  _referenceExtrema.release();
  _extremaFaces.release();
  _cellsOnSubcellScheme.release();
  _recomputedCells.release();
  _freedCells.release();
  _cellCountsOfBlocks.release();
  _recomputeScratch.release();
  _detectorScratch.release();
  _family.release();
  _statusesOnHost.release();
  _subcellsOnHost.release();
  _cellCounts                  = exahype2::dg::limiting::SubcellSchemeCounts{};
  _localTroubledCells          = 0;
  _globalTroubledCells         = 0;
  _extremaOfSolutionAreReduced = false;
  SubcellProjection<double>::deallocate();
  if constexpr (not std::is_same_v<StoragePrecision, double>) {
    SubcellProjection<StoragePrecision>::deallocate();
  }
}

template <
  typename Derived,
  typename StoragePrecision,
  typename ComputePrecision,
  template <typename, typename, typename> class SubcellFamily>
INLINE_METHOD tarch::AllocatedBytes
exahype2::dg::limiting::SubcellLimiter<Derived, StoragePrecision, ComputePrecision, SubcellFamily>::getAllocatedBytes() const {
  return _previousSolution.getAllocatedBytes() + _subcells.getAllocatedBytes() + _subcellHalo.getAllocatedBytes()
    + _appliedFluxes.getAllocatedBytes()
    + _statuses.getAllocatedBytes() + _faceStatuses.getAllocatedBytes() + _referenceExtrema.getAllocatedBytes()
    + _extremaFaces.getAllocatedBytes() + _cellsOnSubcellScheme.getAllocatedBytes()
    + _recomputedCells.getAllocatedBytes() + _freedCells.getAllocatedBytes() + _cellCountsOfBlocks.getAllocatedBytes()
    + _recomputeScratch.getAllocatedBytes() + _detectorScratch.getAllocatedBytes() + _family.getAllocatedBytes()
    + _haloExchange.getAllocatedBytes() + _statusExchange.getAllocatedBytes() + _extremaExchange.getAllocatedBytes()
    + _subcellMigration.getAllocatedBytes()
    + _statusMigration.getAllocatedBytes() + _statusesOnHost.getAllocatedBytes() + _subcellsOnHost.getAllocatedBytes();
}

/**
 * Samples the initial condition on the subgrid of every cell and opens every cell on the Galerkin
 * scheme. With a discrete maximum principle, a cell whose nodal interpolant leaves the sampled
 * extrema of the cell and of every cell it touches at a vertex starts on the subcell scheme.
 */
template <
  typename Derived,
  typename StoragePrecision,
  typename ComputePrecision,
  template <typename, typename, typename> class SubcellFamily>
INLINE_METHOD void
exahype2::dg::limiting::SubcellLimiter<Derived, StoragePrecision, ComputePrecision, SubcellFamily>::initialise(
  const peano4::CellConnectivity& cellConnectivity,
  const CellPool&          solution
) {
  sampleSubcells(cellConnectivity);
  if constexpr (Detector::UsesMaximumPrinciple) {
    tarch::accelerator::parallelFor(
      tarch::accelerator::Range(cellConnectivity.getCells().size),
      exahype2::dg::limiting::ReduceSampledExtrema<Derived, StoragePrecision, ComputePrecision>{
        cellConnectivity.onDevice(),
        std::as_const(_subcells).getView(),
        _referenceExtrema.getView()
      }
    );
    tarch::accelerator::parallelFor(
      tarch::accelerator::Range(cellConnectivity.getCells().size),
      exahype2::dg::limiting::WriteExtremaOntoFaces<Derived, StoragePrecision, ComputePrecision>{
        cellConnectivity.onDevice(),
        std::as_const(_referenceExtrema).getView(),
        _extremaFaces.getView()
      }
    );
    mergeNeighbourExtrema(cellConnectivity, true);
  }
  const int numberOfTeams        = Detector::getNumberOfTeams(cellConnectivity.getCells().size);
  const int teamThreads          = Detector::getTeamThreads();
  const int scratchValuesPerTeam = Detector::getExtremaScratchValuesPerTeam(teamThreads);
  reserveDetectorScratch(numberOfTeams, scratchValuesPerTeam);
  tarch::accelerator::parallelFor(
    tarch::accelerator::TeamRange(numberOfTeams, teamThreads, 0),
    exahype2::dg::limiting::OpenInitialStatuses<Derived, StoragePrecision, ComputePrecision>{
      cellConnectivity.onDevice(),
      numberOfTeams,
      solution.getView(),
      std::as_const(_referenceExtrema).getView(),
      _statuses.getView(),
      SubcellProjection<StoragePrecision>::NodesToLobatto1D,
      SubcellProjection<StoragePrecision>::NodesToSubcells1D,
      static_cast<StoragePrecision>(_relaxationParameter),
      static_cast<StoragePrecision>(_differencesScaling),
      _detectorScratch.getData(),
      scratchValuesPerTeam
    }
  );
  _extremaOfSolutionAreReduced = false;
}

/**
 * Writes the initial condition of Derived on the host at the subcell centres of every cell.
 */
template <
  typename Derived,
  typename StoragePrecision,
  typename ComputePrecision,
  template <typename, typename, typename> class SubcellFamily>
INLINE_METHOD void
exahype2::dg::limiting::SubcellLimiter<Derived, StoragePrecision, ComputePrecision, SubcellFamily>::sampleSubcells(
  const peano4::CellConnectivity& cellConnectivity
) {
  CellPool   copyOnHost{SubcellScheme::SubcellValuesPerCell, tarch::MemoryLocation::Heap};
  CellPool&  subcells = _subcells.download(copyOnHost);
  const auto cells    = cellConnectivity.getCells();
  tarch::accelerator::parallelForOnHost(tarch::accelerator::Range(cells.size), [&](const int entry) {
    const int slot = cells[entry];
    SubcellScheme::sampleInitialCondition(
      subcells.getChunk(slot),
      cellConnectivity.getCellCentre(slot),
      cellConnectivity.getCellWidth(slot)
    );
  });
  _subcells.upload(subcells);
}

/**
 * Saves the solution, opens every cell that was troubled on the subcell scheme and runs every merge
 * round of the reference extrema but the last one. The judge of closeTimeStep() runs the last
 * round. The reference extrema of a cell then cover every cell it touches at a vertex.
 */
template <
  typename Derived,
  typename StoragePrecision,
  typename ComputePrecision,
  template <typename, typename, typename> class SubcellFamily>
INLINE_METHOD void
exahype2::dg::limiting::SubcellLimiter<Derived, StoragePrecision, ComputePrecision, SubcellFamily>::openTimeStep(
  const peano4::CellConnectivity& cellConnectivity,
  const CellPool&          solution
) {
  if constexpr (Detector::UsesMaximumPrinciple) {
    if (not _extremaOfSolutionAreReduced) {
      reduceExtrema(cellConnectivity.onDevice().getCells(), solution);
      _extremaOfSolutionAreReduced = true;
    }
  }
  openStep(cellConnectivity, solution);
  if constexpr (Detector::UsesMaximumPrinciple) {
    mergeNeighbourExtrema(cellConnectivity, false);
  }
}

/**
 * Checks every candidate and recomputes the rejected cells and their neighbours on the subcell
 * scheme. Every rank spreads the statuses and exchanges the subgrid halo in every step. Returns the wave
 * speeds of the accepted candidates and of the recomputed subgrids.
 */
template <
  typename Derived,
  typename StoragePrecision,
  typename ComputePrecision,
  template <typename, typename, typename> class SubcellFamily>
INLINE_METHOD exahype2::dg::MaxEigenvalueStatistics
exahype2::dg::limiting::SubcellLimiter<Derived, StoragePrecision, ComputePrecision, SubcellFamily>::closeTimeStep(
  const peano4::CellConnectivity& cellConnectivity,
  CellPool&                solution,
  const double             timeStamp,
  const double             timeStepSize
) {
  const auto judged     = judgeCandidates(cellConnectivity, solution, timeStamp, timeStepSize);
  auto       statistics = judged.statistics;
  _localTroubledCells   = judged.troubledCells;
  spreadStatuses(cellConnectivity);
  listCellsOnSubcellScheme(cellConnectivity);
  statistics = exahype2::dg::MaxEigenvalueStatistics::combine(
    statistics,
    recompute(cellConnectivity, solution, timeStamp, timeStepSize)
  );
  if constexpr (Detector::UsesMaximumPrinciple) {
    reduceExtrema(tarch::Span<const int>{_recomputedCells.getData(), _cellCounts.recomputedCells}, solution);
  }
  assertion(
    _cellCounts.troubledCells == judged.troubledCells and _cellCounts.recomputedCells >= judged.recomputedCells,
    _cellCounts.troubledCells,
    judged.troubledCells,
    _cellCounts.recomputedCells,
    judged.recomputedCells
  );
  return statistics;
}

/**
 * Moves the statuses and the subgrids through the regrid. A regrid reads the old cells from its
 * freed slots only. Every freed cell on the Galerkin scheme first writes the projection of its
 * nodes into its subgrid. The next time step fills the previous solution and the faces.
 */
template <
  typename Derived,
  typename StoragePrecision,
  typename ComputePrecision,
  template <typename, typename, typename> class SubcellFamily>
INLINE_METHOD void
exahype2::dg::limiting::SubcellLimiter<Derived, StoragePrecision, ComputePrecision, SubcellFamily>::regrid(
  const peano4::CellConnectivity& cellConnectivity,
  const peano4::Regrid&    regrid,
  const CellPool&          solution
) {
  _previousSolution.reserve(regrid.newNumberOfSlots);
  _subcells.reserve(regrid.newNumberOfSlots);
  _statuses.reserve(regrid.newNumberOfSlots);
  if constexpr (Detector::UsesMaximumPrinciple) {
    _referenceExtrema.reserve(regrid.newNumberOfSlots);
  }

  projectNodesOfFreedCells(regrid.freedSlots, solution);
  _subcellMigration.migrate(
    _subcells,
    regrid,
    exahype2::fv::PatchTransfer<Derived, StoragePrecision, ComputePrecision>{std::as_const(_subcells).getView()}
  );
  _statusMigration
    .migrate(_statuses, regrid, exahype2::dg::limiting::StatusTransfer{std::as_const(_statuses).getView()});

  rebuild(cellConnectivity);
  _extremaOfSolutionAreReduced = false;
}

/**
 * Writes the projection of the nodes of every cell in freedSlots that runs the Galerkin scheme into
 * its subgrid.
 */
template <
  typename Derived,
  typename StoragePrecision,
  typename ComputePrecision,
  template <typename, typename, typename> class SubcellFamily>
INLINE_METHOD void
exahype2::dg::limiting::SubcellLimiter<Derived, StoragePrecision, ComputePrecision, SubcellFamily>::projectNodesOfFreedCells(
  const std::vector<int>& freedSlots,
  const CellPool&         solution
) {
  if (freedSlots.empty()) {
    return;
  }
  const int  cells         = static_cast<int>(freedSlots.size());
  const int  teamThreads   = SubcellScheme::getTeamThreads();
  const int  numberOfTeams = tarch::accelerator::getNumberOfPersistentTeams(cells, teamThreads);
  const auto scratchValues = static_cast<std::size_t>(tarch::accelerator::getNumberOfScratchChunks(numberOfTeams))
    * SubcellScheme::SubcellProjectionScratchValues;
  if (_recomputeScratch.getSize() < scratchValues) {
    _recomputeScratch.allocate(scratchValues);
  }
  _freedCells.setValues(freedSlots);
  tarch::accelerator::parallelFor(
    tarch::accelerator::TeamRange(numberOfTeams, teamThreads, 0),
    exahype2::dg::limiting::ProjectNodesOntoSubgrids<Derived, StoragePrecision, ComputePrecision>{
      tarch::Span<const int>{_freedCells.getData(), cells},
      numberOfTeams,
      solution.getView(),
      _subcells.getView(),
      std::as_const(_statuses).getView(),
      SubcellProjection<StoragePrecision>::NodesToSubcells1D,
      _recomputeScratch.getData()
    }
  );
}

template <
  typename Derived,
  typename StoragePrecision,
  typename ComputePrecision,
  template <typename, typename, typename> class SubcellFamily>
INLINE_METHOD tarch::accelerator::ChunkedMemoryPool<int>::View
exahype2::dg::limiting::SubcellLimiter<Derived, StoragePrecision, ComputePrecision, SubcellFamily>::getStatuses() {
  return _statuses.getView();
}

template <
  typename Derived,
  typename StoragePrecision,
  typename ComputePrecision,
  template <typename, typename, typename> class SubcellFamily>
INLINE_METHOD typename exahype2::dg::limiting::SubcellLimiter<
  Derived,
  StoragePrecision,
  ComputePrecision,
  SubcellFamily
>::FluxPool::View
exahype2::dg::limiting::SubcellLimiter<Derived, StoragePrecision, ComputePrecision, SubcellFamily>::getAppliedFluxes() {
  if constexpr (exahype2::dg::limiting::couplesGalerkinFlux<Derived>()) {
    return _appliedFluxes.getView();
  } else {
    return {};
  }
}

/**
 * Returns the status pool if host code reads it. Otherwise returns its copy in _statusesOnHost.
 */
template <
  typename Derived,
  typename StoragePrecision,
  typename ComputePrecision,
  template <typename, typename, typename> class SubcellFamily>
INLINE_METHOD const typename exahype2::dg::limiting::SubcellLimiter<Derived, StoragePrecision, ComputePrecision, SubcellFamily>::StatusPool&
exahype2::dg::limiting::SubcellLimiter<Derived, StoragePrecision, ComputePrecision, SubcellFamily>::downloadStatuses() {
  return std::as_const(_statuses).download(_statusesOnHost);
}

/**
 * Returns the subgrid pool if host code reads it. Otherwise returns its copy in _subcellsOnHost.
 */
template <
  typename Derived,
  typename StoragePrecision,
  typename ComputePrecision,
  template <typename, typename, typename> class SubcellFamily>
INLINE_METHOD const typename exahype2::dg::limiting::SubcellLimiter<Derived, StoragePrecision, ComputePrecision, SubcellFamily>::CellPool&
exahype2::dg::limiting::SubcellLimiter<Derived, StoragePrecision, ComputePrecision, SubcellFamily>::downloadSubcells() {
  return std::as_const(_subcells).download(_subcellsOnHost);
}

template <
  typename Derived,
  typename StoragePrecision,
  typename ComputePrecision,
  template <typename, typename, typename> class SubcellFamily>
INLINE_METHOD int
exahype2::dg::limiting::SubcellLimiter<
  Derived,
  StoragePrecision,
  ComputePrecision,
  SubcellFamily
>::getNumberOfRecomputedCells() const {
  return _cellCounts.recomputedCells;
}

/**
 * Returns the number of cells whose status is not Regular at the end of the last time step.
 */
template <
  typename Derived,
  typename StoragePrecision,
  typename ComputePrecision,
  template <typename, typename, typename> class SubcellFamily>
INLINE_METHOD int
exahype2::dg::limiting::SubcellLimiter<
  Derived,
  StoragePrecision,
  ComputePrecision,
  SubcellFamily
>::getNumberOfCellsOnSubcellScheme() const {
  return _cellCounts.cellsOnScheme;
}

template <
  typename Derived,
  typename StoragePrecision,
  typename ComputePrecision,
  template <typename, typename, typename> class SubcellFamily>
INLINE_METHOD int
exahype2::dg::limiting::SubcellLimiter<Derived, StoragePrecision, ComputePrecision, SubcellFamily>::getNumberOfTroubledCells() const {
  return _cellCounts.troubledCells;
}

/**
 * Returns the number of troubled cells on all ranks in the time step of the last
 * readValuesFromGlobalReduction().
 */
template <
  typename Derived,
  typename StoragePrecision,
  typename ComputePrecision,
  template <typename, typename, typename> class SubcellFamily>
INLINE_METHOD int
exahype2::dg::limiting::SubcellLimiter<
  Derived,
  StoragePrecision,
  ComputePrecision,
  SubcellFamily
>::getGlobalNumberOfTroubledCells() const {
  return _globalTroubledCells;
}

/**
 * Adds the troubled cells of this rank in the last closeTimeStep() to record.
 */
template <
  typename Derived,
  typename StoragePrecision,
  typename ComputePrecision,
  template <typename, typename, typename> class SubcellFamily>
INLINE_METHOD void
exahype2::dg::limiting::SubcellLimiter<Derived, StoragePrecision, ComputePrecision, SubcellFamily>::addLocalValuesToGlobalReduction(
  tarch::mpi::ReductionRecord& record
) {
  assertion(_localTroubledCells >= 0, _localTroubledCells);
  _troubledCellsSlot = record.addSum(static_cast<std::uint64_t>(_localTroubledCells));
}

/**
 * Reads the number of troubled cells on all ranks from record.
 */
template <
  typename Derived,
  typename StoragePrecision,
  typename ComputePrecision,
  template <typename, typename, typename> class SubcellFamily>
INLINE_METHOD void
exahype2::dg::limiting::SubcellLimiter<Derived, StoragePrecision, ComputePrecision, SubcellFamily>::readValuesFromGlobalReduction(
  const tarch::mpi::ReductionRecord& record
) {
  const auto globalTroubledCells = record.getSum(_troubledCellsSlot);
  assertion(globalTroubledCells <= static_cast<std::uint64_t>(std::numeric_limits<int>::max()), globalTroubledCells);
  _globalTroubledCells = static_cast<int>(globalTroubledCells);
}

template <
  typename Derived,
  typename StoragePrecision,
  typename ComputePrecision,
  template <typename, typename, typename> class SubcellFamily>
INLINE_METHOD void
exahype2::dg::limiting::SubcellLimiter<Derived, StoragePrecision, ComputePrecision, SubcellFamily>::rebuild(
  const peano4::CellConnectivity& cellConnectivity
) {
  _subcellHalo.reserve(cellConnectivity.getNumberOfFaces());
  if constexpr (exahype2::dg::limiting::couplesGalerkinFlux<Derived>()) {
    _appliedFluxes.reserve(cellConnectivity.getNumberOfFaces());
  }
  _faceStatuses.reserve(cellConnectivity.getNumberOfFaces());
  if constexpr (Detector::UsesMaximumPrinciple) {
    _extremaFaces.reserve(cellConnectivity.getNumberOfFaces());
  }
  _haloExchange.rebuild(cellConnectivity);
  _statusExchange.rebuild(cellConnectivity);
  if constexpr (Detector::UsesMaximumPrinciple) {
    _extremaExchange.rebuild(cellConnectivity);
  }
  _cellsOnSubcellScheme.allocate(static_cast<std::size_t>(cellConnectivity.getCells().size));
  _recomputedCells.allocate(static_cast<std::size_t>(cellConnectivity.getCells().size));
  _cellCounts = exahype2::dg::limiting::SubcellSchemeCounts{};
  _family.rebuild(cellConnectivity);
  clearFaces(cellConnectivity);
}

/**
 * Resets every face to the status Regular and empty extrema. The subcell halo becomes zero. The
 * level jumps and the rank boundaries then move finite values in the halves no cell writes.
 */
template <
  typename Derived,
  typename StoragePrecision,
  typename ComputePrecision,
  template <typename, typename, typename> class SubcellFamily>
INLINE_METHOD void
exahype2::dg::limiting::SubcellLimiter<Derived, StoragePrecision, ComputePrecision, SubcellFamily>::clearFaces(
  const peano4::CellConnectivity& cellConnectivity
) {
  tarch::accelerator::parallelFor(
    tarch::accelerator::Range(cellConnectivity.getNumberOfFaces()),
    exahype2::dg::limiting::ClearFaces<Derived, StoragePrecision, ComputePrecision>{
      _faceStatuses.getView(),
      _extremaFaces.getView(),
      _subcellHalo.getView()
    }
  );
}

/**
 * Saves the solution of every cell, opens a troubled cell on the subcell scheme and copies the
 * reference extrema of the cell into its own half of every face.
 */
template <
  typename Derived,
  typename StoragePrecision,
  typename ComputePrecision,
  template <typename, typename, typename> class SubcellFamily>
INLINE_METHOD void
exahype2::dg::limiting::SubcellLimiter<Derived, StoragePrecision, ComputePrecision, SubcellFamily>::openStep(
  const peano4::CellConnectivity& cellConnectivity,
  const CellPool&          solution
) {
  tarch::accelerator::parallelFor(
    tarch::accelerator::Range(cellConnectivity.getCells().size),
    exahype2::dg::limiting::OpenStep<Derived, StoragePrecision, ComputePrecision>{
      cellConnectivity.onDevice(),
      solution.getView(),
      _previousSolution.getView(),
      _statuses.getView(),
      std::as_const(_referenceExtrema).getView(),
      _extremaFaces.getView()
    }
  );
}

/**
 * Writes the observable extrema of the solution of every listed cell into its reference extrema.
 */
template <
  typename Derived,
  typename StoragePrecision,
  typename ComputePrecision,
  template <typename, typename, typename> class SubcellFamily>
INLINE_METHOD void
exahype2::dg::limiting::SubcellLimiter<Derived, StoragePrecision, ComputePrecision, SubcellFamily>::reduceExtrema(
  const tarch::Span<const int> cells,
  const CellPool&              solution
) {
  if (cells.isEmpty()) {
    return;
  }
  const int numberOfTeams        = Detector::getNumberOfTeams(cells.size);
  const int teamThreads          = Detector::getTeamThreads();
  const int scratchValuesPerTeam = Detector::getExtremaScratchValuesPerTeam(teamThreads);
  reserveDetectorScratch(numberOfTeams, scratchValuesPerTeam);
  tarch::accelerator::parallelFor(
    tarch::accelerator::TeamRange(numberOfTeams, teamThreads, 0),
    exahype2::dg::limiting::ReduceReferenceExtrema<Derived, StoragePrecision, ComputePrecision>{
      cells,
      numberOfTeams,
      solution.getView(),
      _referenceExtrema.getView(),
      SubcellProjection<StoragePrecision>::NodesToLobatto1D,
      SubcellProjection<StoragePrecision>::NodesToSubcells1D,
      _detectorScratch.getData(),
      scratchValuesPerTeam
    }
  );
}

/**
 * Grows the detector scratch to one chunk of scratchValuesPerTeam values per team of a launch with
 * numberOfTeams teams.
 */
template <
  typename Derived,
  typename StoragePrecision,
  typename ComputePrecision,
  template <typename, typename, typename> class SubcellFamily>
INLINE_METHOD void
exahype2::dg::limiting::SubcellLimiter<Derived, StoragePrecision, ComputePrecision, SubcellFamily>::reserveDetectorScratch(
  const int numberOfTeams,
  const int scratchValuesPerTeam
) {
  assertion(numberOfTeams > 0, numberOfTeams);
  assertion(scratchValuesPerTeam >= 0, scratchValuesPerTeam);
  const auto values = static_cast<std::size_t>(tarch::accelerator::getNumberOfScratchChunks(numberOfTeams))
    * static_cast<std::size_t>(scratchValuesPerTeam);
  if (_detectorScratch.getSize() < values) {
    _detectorScratch.allocate(values);
  }
}

/**
 * Runs the DIMENSIONS merge rounds of exahype2::dg::limiting::MergeNeighbourExtrema on faces that
 * store the extrema of their cells. Without mergeLastRound, no cell runs the last round. Minima and
 * maxima are exact and do not depend on the rank layout.
 */
template <
  typename Derived,
  typename StoragePrecision,
  typename ComputePrecision,
  template <typename, typename, typename> class SubcellFamily>
INLINE_METHOD void
exahype2::dg::limiting::SubcellLimiter<Derived, StoragePrecision, ComputePrecision, SubcellFamily>::mergeNeighbourExtrema(
  const peano4::CellConnectivity& cellConnectivity,
  const bool               mergeLastRound
) {
  for (int round = 1; round <= DIMENSIONS; round++) {
    const bool lastRound = round == DIMENSIONS;
    exchangeFaces(
      cellConnectivity,
      exahype2::dg::limiting::InterpolateExtremaHalves<Derived, StoragePrecision, ComputePrecision>{
        _extremaFaces.getView()
      },
      exahype2::dg::limiting::RestrictExtremaHalves<Derived, StoragePrecision, ComputePrecision>{
        _extremaFaces.getView()
      },
      _extremaExchange,
      [this, &cellConnectivity, round, lastRound, mergeLastRound](const peano4::Adjacency adjacency) {
        const auto cells = cellConnectivity.onDevice().getCells(adjacency);
        if (cells.isEmpty() or (lastRound and not mergeLastRound)) {
          return;
        }
        tarch::accelerator::parallelFor(
          tarch::accelerator::Range(cells.size),
          exahype2::dg::limiting::MergeNeighbourExtrema<Derived, StoragePrecision, ComputePrecision>{
            cellConnectivity.onDevice(),
            cells,
            _referenceExtrema.getView(),
            _extremaFaces.getView(),
            round
          }
        );
      }
    );
  }
}

/**
 * Checks the candidate of every cell and returns the counts of the verdicts and the wave speeds of
 * the accepted candidates whose cells were not troubled.
 */
template <
  typename Derived,
  typename StoragePrecision,
  typename ComputePrecision,
  template <typename, typename, typename> class SubcellFamily>
INLINE_METHOD exahype2::dg::limiting::JudgedCells
exahype2::dg::limiting::SubcellLimiter<Derived, StoragePrecision, ComputePrecision, SubcellFamily>::judgeCandidates(
  const peano4::CellConnectivity& cellConnectivity,
  const CellPool&          solution,
  const double             timeStamp,
  const double             timeStepSize
) {
  exahype2::dg::limiting::JudgedCells judged;
  const int                           cells = cellConnectivity.getCells().size;
  if (cells == 0) {
    return judged;
  }
  const int numberOfTeams = Detector::getNumberOfTeams((cells + Detector::CellsPerBatch - 1) / Detector::CellsPerBatch);
  const int teamThreads   = Detector::getTeamThreads();
  const int scratchValuesPerTeam = Detector::getScratchValuesPerTeam(teamThreads);
  reserveDetectorScratch(numberOfTeams, scratchValuesPerTeam);
  tarch::accelerator::parallelReduce(
    tarch::accelerator::TeamRange(numberOfTeams, teamThreads, Detector::getTeamScratchBytes()),
    exahype2::dg::limiting::JudgeCandidates<Derived, StoragePrecision, ComputePrecision>{
      cellConnectivity.onDevice(),
      numberOfTeams,
      solution.getView(),
      _statuses.getView(),
      _faceStatuses.getView(),
      _referenceExtrema.getView(),
      std::as_const(_extremaFaces).getView(),
      SubcellProjection<StoragePrecision>::NodesToLobatto1D,
      SubcellProjection<StoragePrecision>::NodesToSubcells1D,
      SubcellProjection<StoragePrecision>::QuadraturePoints1D,
      static_cast<StoragePrecision>(_relaxationParameter),
      static_cast<StoragePrecision>(_differencesScaling),
      timeStamp,
      timeStepSize,
      _detectorScratch.getData(),
      scratchValuesPerTeam
    },
    tarch::accelerator::Custom<exahype2::dg::limiting::JudgedCells>{judged}
  );
  return judged;
}

/**
 * Grows the subcell domain by one ring per round. A neighbour of a troubled cell turns Limited. A
 * neighbour of a limited cell turns Halo.
 */
template <
  typename Derived,
  typename StoragePrecision,
  typename ComputePrecision,
  template <typename, typename, typename> class SubcellFamily>
INLINE_METHOD void
exahype2::dg::limiting::SubcellLimiter<Derived, StoragePrecision, ComputePrecision, SubcellFamily>::spreadStatuses(
  const peano4::CellConnectivity& cellConnectivity
) {
  for (int ring = 0; ring < exahype2::dg::limiting::NumberOfSpreadRings; ring++) {
    exchangeFaces(
      cellConnectivity,
      exahype2::dg::limiting::InterpolateStatusHalves{_faceStatuses.getView()},
      exahype2::dg::limiting::RestrictStatusHalves{_faceStatuses.getView()},
      _statusExchange,
      [this, &cellConnectivity](const peano4::Adjacency adjacency) {
        const auto cells = cellConnectivity.onDevice().getCells(adjacency);
        tarch::accelerator::parallelFor(
          tarch::accelerator::Range(cells.size),
          exahype2::dg::limiting::SpreadStatuses<Derived, ComputePrecision>{
            cellConnectivity.onDevice(),
            cells,
            _statuses.getView(),
            std::as_const(_faceStatuses).getView()
          }
        );
      }
    );
    if (ring + 1 < exahype2::dg::limiting::NumberOfSpreadRings) {
      tarch::accelerator::parallelFor(
        tarch::accelerator::Range(cellConnectivity.getCells().size),
        exahype2::dg::limiting::WriteStatusesOntoFaces{
          cellConnectivity.onDevice(),
          std::as_const(_statuses).getView(),
          _faceStatuses.getView()
        }
      );
    }
  }
}

/**
 * Lists and counts the cells whose status is not Regular and the cells that recompute, the local
 * cells first.
 */
template <
  typename Derived,
  typename StoragePrecision,
  typename ComputePrecision,
  template <typename, typename, typename> class SubcellFamily>
INLINE_METHOD void
exahype2::dg::limiting::SubcellLimiter<Derived, StoragePrecision, ComputePrecision, SubcellFamily>::listCellsOnSubcellScheme(
  const peano4::CellConnectivity& cellConnectivity
) {
  const int numberOfCells = cellConnectivity.getCells().size;
  assertion(
    _cellsOnSubcellScheme.getSize() == static_cast<std::size_t>(numberOfCells),
    _cellsOnSubcellScheme.getSize(),
    numberOfCells
  );
  assertion(
    _recomputedCells.getSize() == static_cast<std::size_t>(numberOfCells),
    _recomputedCells.getSize(),
    numberOfCells
  );
  constexpr int MaximumNumberOfBlocks = 1024;
  const int     numberOfBlocks        = std::min(numberOfCells, MaximumNumberOfBlocks);
  if (_cellCountsOfBlocks.getSize() < static_cast<std::size_t>(numberOfBlocks)) {
    _cellCountsOfBlocks.allocate(static_cast<std::size_t>(numberOfBlocks));
  }
  _cellCounts = exahype2::dg::limiting::SubcellSchemeCounts{};
  tarch::accelerator::parallelReduce(
    tarch::accelerator::Range(numberOfBlocks),
    exahype2::dg::limiting::CountCellsOnSubcellScheme{
      cellConnectivity.onDevice(),
      std::as_const(_statuses).getView(),
      numberOfBlocks,
      cellConnectivity.getCells(peano4::Adjacency::Local).size,
      _cellCountsOfBlocks.getData()
    },
    tarch::accelerator::Custom<exahype2::dg::limiting::SubcellSchemeCountsReduction>{_cellCounts}
  );
  tarch::accelerator::parallelFor(
    tarch::accelerator::Range(numberOfBlocks),
    exahype2::dg::limiting::ListCellsOnSubcellScheme{
      cellConnectivity.onDevice(),
      std::as_const(_statuses).getView(),
      numberOfBlocks,
      std::as_const(_cellCountsOfBlocks).getData(),
      _cellsOnSubcellScheme.getData(),
      _recomputedCells.getData()
    }
  );
  assertion(
    _cellCounts.recomputedCells <= _cellCounts.cellsOnScheme,
    _cellCounts.recomputedCells,
    _cellCounts.cellsOnScheme
  );
  assertion(
    _cellCounts.troubledCells <= _cellCounts.recomputedCells,
    _cellCounts.troubledCells,
    _cellCounts.recomputedCells
  );
}

/**
 * Advances every recomputing cell by one step of the subcell family on its subgrid and projects the
 * result onto the nodes over the candidate. Every cell on the subcell scheme first writes its
 * subgrid onto its faces. Returns the wave speeds of the subgrids.
 */
template <
  typename Derived,
  typename StoragePrecision,
  typename ComputePrecision,
  template <typename, typename, typename> class SubcellFamily>
INLINE_METHOD exahype2::dg::MaxEigenvalueStatistics
exahype2::dg::limiting::SubcellLimiter<Derived, StoragePrecision, ComputePrecision, SubcellFamily>::recompute(
  const peano4::CellConnectivity& cellConnectivity,
  CellPool&                solution,
  const double             timeStamp,
  const double             timeStepSize
) {
  // The projections onto the faces and onto the nodes take their chunks from this scratch. Every
  // recomputing cell lies on the subcell scheme.
  const auto scratchValues =
    static_cast<std::size_t>(tarch::accelerator::getNumberOfScratchChunks(_cellCounts.cellsOnScheme))
    * SubcellScheme::ProjectionScratchValues;
  if (_recomputeScratch.getSize() < scratchValues) {
    _recomputeScratch.allocate(scratchValues);
  }
  tarch::accelerator::parallelFor(
    tarch::accelerator::TeamRange(_cellCounts.cellsOnScheme, SubcellScheme::getTeamThreads(), 0),
    exahype2::dg::limiting::ProjectSubgridsOntoFaces<Derived, StoragePrecision, ComputePrecision>{
      cellConnectivity.onDevice(),
      tarch::Span<const int>{_cellsOnSubcellScheme.getData(), _cellCounts.cellsOnScheme},
      std::as_const(_previousSolution).getView(),
      _subcells.getView(),
      _subcellHalo.getView(),
      std::as_const(_statuses).getView(),
      SubcellProjection<StoragePrecision>::NodesToSubcells1D,
      timeStamp <= 0.0,
      _recomputeScratch.getData()
    }
  );
  const auto boundaryFaces = cellConnectivity.onDevice().getFaces(peano4::Adjacency::Local, peano4::FaceKind::Boundary);
  tarch::accelerator::parallelFor(
    tarch::accelerator::Range(boundaryFaces.size * SubcellScheme::Subgrid::VolumesPerLayer),
    exahype2::dg::limiting::ApplySubgridBoundaryConditions<Derived, StoragePrecision, ComputePrecision>{
      {cellConnectivity.onDevice(), boundaryFaces, _subcellHalo.getView(), timeStamp},
      std::as_const(_statuses).getView()
    }
  );

  // A coarse cell beside finer cells applies the restriction of the Galerkin fluxes of its fine faces.
  if constexpr (exahype2::dg::limiting::couplesGalerkinFlux<Derived>()) {
    exahype2::restrictFineFaces(
      cellConnectivity,
      exahype2::dg::RestrictFluxHalves<Derived, ComputePrecision>{
        cellConnectivity.onDevice(),
        _appliedFluxes.getView(),
        Derived::template DGMatrices<double>::WeightedRestrictionMatrix1D
      }
    );
  }

  const tarch::Span<const int> recomputedCells{_recomputedCells.getData(), _cellCounts.recomputedCells};
  // A level jump copies coarse subcells into the fine halo. The halo then stays within the range of
  // the coarse subgrid at a shock.
  const auto exchangeHalo = [this, &cellConnectivity](const auto& workOnCells) {
    exchangeFaces(
      cellConnectivity,
      exahype2::fv::InjectHaloHalves<Derived, StoragePrecision, ComputePrecision>{
        cellConnectivity.onDevice(),
        _subcellHalo.getView()
      },
      exahype2::fv::RestrictHaloHalves<Derived, StoragePrecision, ComputePrecision>{
        cellConnectivity.onDevice(),
        _subcellHalo.getView()
      },
      _haloExchange,
      workOnCells
    );
  };
  _family.advance(
    cellConnectivity,
    exahype2::dg::limiting::SubcellRegion<StoragePrecision, ComputePrecision>{
      recomputedCells,
      _cellCounts.localRecomputedCells,
      _subcells.getView(),
      std::as_const(_subcellHalo).getView(),
      std::as_const(_faceStatuses).getView(),
      exahype2::dg::limiting::couplesGalerkinFlux<Derived>() ? std::as_const(_appliedFluxes).getView()
                                                             : typename FluxPool::ConstView{}
    },
    exchangeHalo,
    timeStamp,
    timeStepSize
  );

  exahype2::dg::MaxEigenvalueStatistics statistics;
  tarch::accelerator::parallelReduce(
    tarch::accelerator::TeamRange(recomputedCells.size, SubcellScheme::getTeamThreads(), 0),
    exahype2::dg::limiting::ProjectRecomputedSubgrids<Derived, StoragePrecision, ComputePrecision>{
      cellConnectivity.onDevice(),
      recomputedCells,
      solution.getView(),
      std::as_const(_subcells).getView(),
      SubcellProjection<StoragePrecision>::SubcellsToNodes1D,
      timeStamp,
      timeStepSize,
      _recomputeScratch.getData()
    },
    tarch::accelerator::Custom<exahype2::dg::MaxEigenvalueStatistics>{statistics}
  );
  return statistics;
}

/**
 * Passes one kind of face halves across the level jumps and the rank boundaries and calls
 * workOnCells for the local and the remote cells. The first round of exchange sends the halves
 * that the remote level jumps interpolate. The second round sends the restricted halves while the
 * local cells work.
 */
template <
  typename Derived,
  typename StoragePrecision,
  typename ComputePrecision,
  template <typename, typename, typename> class SubcellFamily>
template <typename Interpolate, typename Restrict, typename Exchange, typename Work>
INLINE_METHOD void
exahype2::dg::limiting::SubcellLimiter<Derived, StoragePrecision, ComputePrecision, SubcellFamily>::exchangeFaces(
  const peano4::CellConnectivity& cellConnectivity,
  const Interpolate&       interpolation,
  const Restrict&          restriction,
  Exchange&                exchange,
  const Work&              workOnCells
) {
  exchange.post();
  exahype2::interpolateCoarseFaces(cellConnectivity, peano4::Adjacency::Local, interpolation);
  exahype2::restrictFineFaces(cellConnectivity, peano4::Adjacency::Local, restriction);
  exchange.wait();
  exahype2::interpolateCoarseFaces(cellConnectivity, peano4::Adjacency::Remote, interpolation);
  exahype2::restrictFineFaces(cellConnectivity, peano4::Adjacency::Remote, restriction);
  exchange.post();
  workOnCells(peano4::Adjacency::Local);
  exchange.wait();
  workOnCells(peano4::Adjacency::Remote);
}
