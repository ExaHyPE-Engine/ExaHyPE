#include "exahype2/LevelJumps.h"
#include "exahype2/fv/Kernels.h"
#include "exahype2/terms/InitialisesOnHost.h"
#include "tarch/Assertions.h"
#include "tarch/MemoryUsage.h"
#include "tarch/Span.h"
#include "tarch/accelerator/ParallelFor.h"
#include "tarch/accelerator/ParallelReduce.h"
#include "tarch/accelerator/Range.h"
#include "tarch/accelerator/Reducer.h"
#include "tarch/accelerator/Scratch.h"
#include "tarch/mpi/Collectives.h"
#include "tarch/mpi/Rank.h"

#include <mpi.h>

/**
 * relaxationParameter is the absolute widening of the discrete maximum principle and
 * differencesScaling its widening relative to the reference range.
 */
template <typename Derived, typename StoragePrecision, typename ComputePrecision>
INLINE_METHOD exahype2::dg::limiting::SubcellLimiter<Derived, StoragePrecision, ComputePrecision>::SubcellLimiter(
  const double relaxationParameter,
  const double differencesScaling
) :
  _relaxationParameter{relaxationParameter},
  _differencesScaling{differencesScaling} {
  assertion(std::isfinite(relaxationParameter) and relaxationParameter >= 0.0, relaxationParameter);
  assertion(std::isfinite(differencesScaling) and differencesScaling >= 0.0, differencesScaling);
  static_assert(
    SubcellScheme::HaloSize <= SubcellScheme::SubcellsPerAxis,
    "A halo reaches at most the neighbouring cell's subgrid."
  );
}

/**
 * Allocates the projection tables, the pools and the exchanges. Every rank calls this at the same
 * time, so the exchanges take the same MPI tags.
 */
template <typename Derived, typename StoragePrecision, typename ComputePrecision>
INLINE_METHOD void
exahype2::dg::limiting::SubcellLimiter<Derived, StoragePrecision, ComputePrecision>::allocate(
  const peano4::Partition& partition
) {
  SubcellProjection<double>::initialise();
  if constexpr (not std::is_same_v<StoragePrecision, double>) {
    SubcellProjection<StoragePrecision>::initialise();
  }
  _previousSolution.reserve(partition.getNumberOfSlots());
  _subcells.reserve(partition.getNumberOfSlots());
  _statuses.reserve(partition.getNumberOfSlots());
  if constexpr (Detector::UsesMaximumPrinciple) {
    _referenceExtrema.reserve(partition.getNumberOfSlots());
  }
  rebuild(partition);
}

template <typename Derived, typename StoragePrecision, typename ComputePrecision>
INLINE_METHOD void
exahype2::dg::limiting::SubcellLimiter<Derived, StoragePrecision, ComputePrecision>::release() {
  _haloExchange.release();
  _statusExchange.release();
  _extremaExchange.release();
  _subcellMigration.release();
  _statusMigration.release();
  _previousSolution.release();
  _subcells.release();
  _subcellHalo.release();
  _statuses.release();
  _faceStatuses.release();
  _referenceExtrema.release();
  _extremaFaces.release();
  _cellsOnSubcellScheme.release();
  _recomputedCells.release();
  _cellCountsOfBlocks.release();
  _recomputeScratch.release();
  _statusesOnHost      = std::vector<int>{};
  _subcellsOnHost      = std::vector<StoragePrecision>{};
  _cellCounts          = exahype2::dg::limiting::SubcellSchemeCounts{};
  _globalTroubledCells = 0;
  SubcellProjection<double>::deallocate();
  if constexpr (not std::is_same_v<StoragePrecision, double>) {
    SubcellProjection<StoragePrecision>::deallocate();
  }
}

template <typename Derived, typename StoragePrecision, typename ComputePrecision>
INLINE_METHOD tarch::AllocatedBytes
exahype2::dg::limiting::SubcellLimiter<Derived, StoragePrecision, ComputePrecision>::getAllocatedBytes() const {
  return _previousSolution.getAllocatedBytes() + _subcells.getAllocatedBytes() + _subcellHalo.getAllocatedBytes()
    + _statuses.getAllocatedBytes() + _faceStatuses.getAllocatedBytes() + _referenceExtrema.getAllocatedBytes()
    + _extremaFaces.getAllocatedBytes() + _cellsOnSubcellScheme.getAllocatedBytes()
    + _recomputedCells.getAllocatedBytes() + _cellCountsOfBlocks.getAllocatedBytes()
    + _recomputeScratch.getAllocatedBytes() + _haloExchange.getAllocatedBytes() + _statusExchange.getAllocatedBytes()
    + _extremaExchange.getAllocatedBytes() + _subcellMigration.getAllocatedBytes()
    + _statusMigration.getAllocatedBytes()
    + tarch::AllocatedBytes::onHost(
           tarch::getAllocatedBytesOf(_statusesOnHost) + tarch::getAllocatedBytesOf(_subcellsOnHost)
    );
}

/**
 * Samples the initial condition on the subgrid of every cell and opens every cell on the Galerkin
 * scheme. With a discrete maximum principle, a cell whose nodal interpolant oscillates beyond its
 * subcells starts on the subcell scheme.
 */
template <typename Derived, typename StoragePrecision, typename ComputePrecision>
INLINE_METHOD void
exahype2::dg::limiting::SubcellLimiter<Derived, StoragePrecision, ComputePrecision>::initialise(
  const peano4::Partition& partition,
  const CellPool&          solution
) {
  sampleSubcells(partition);
  tarch::accelerator::parallelFor(
    tarch::accelerator::Range(partition.getCells().size),
    exahype2::dg::limiting::OpenInitialStatuses<Derived, StoragePrecision, ComputePrecision>{
      partition.onDevice(),
      solution.getView(),
      std::as_const(_subcells).getView(),
      _statuses.getView(),
      SubcellProjection<StoragePrecision>::NodesToLobatto1D,
      SubcellProjection<StoragePrecision>::NodesToSubcells1D,
      static_cast<StoragePrecision>(_relaxationParameter),
      static_cast<StoragePrecision>(_differencesScaling)
    }
  );
}

/**
 * Writes the initial condition of Derived at the subcell centres of every cell. An initial
 * condition that reads host objects fills a host copy of the pool.
 */
template <typename Derived, typename StoragePrecision, typename ComputePrecision>
INLINE_METHOD void
exahype2::dg::limiting::SubcellLimiter<Derived, StoragePrecision, ComputePrecision>::sampleSubcells(
  const peano4::Partition& partition
) {
  if constexpr (exahype2::terms::InitialisesOnHost<Derived>) {
    _subcells.copyToHost(_subcellsOnHost);
    const auto valuesPerSlot = static_cast<std::size_t>(_subcells.getPaddedChunkSize());
    const auto cells         = partition.getCells();
    tarch::accelerator::parallelForOnHost(tarch::accelerator::Range(cells.size), [&](const int entry) {
      const int slot = cells[entry];
      SubcellScheme::sampleInitialCondition(
        _subcellsOnHost.data() + static_cast<std::size_t>(slot) * valuesPerSlot,
        partition.getCellCentre(slot),
        partition.getCellWidth(slot)
      );
    });
    _subcells.copyFromHost(_subcellsOnHost);
  } else {
    tarch::accelerator::parallelFor(
      tarch::accelerator::Range(partition.getCells().size),
      exahype2::dg::limiting::SampleSubcells<Derived, StoragePrecision, ComputePrecision>{
        partition.onDevice(),
        _subcells.getView()
      }
    );
  }
}

/**
 * Saves the solution, opens every cell that was troubled on the subcell scheme and reduces the
 * reference extrema of the discrete maximum principle.
 */
template <typename Derived, typename StoragePrecision, typename ComputePrecision>
INLINE_METHOD void
exahype2::dg::limiting::SubcellLimiter<Derived, StoragePrecision, ComputePrecision>::openTimeStep(
  const peano4::Partition& partition,
  const CellPool&          solution
) {
  openStep(partition, solution);
  if constexpr (Detector::UsesMaximumPrinciple) {
    reduceReferenceExtrema(partition);
  }
}

/**
 * Checks every candidate and recomputes the rejected cells and their neighbours on the subcell
 * scheme. Returns the wave speeds of the accepted candidates and of the recomputed subgrids. The
 * troubled cells are summed over the ranks only after a recompute, because every troubled cell
 * recomputes.
 */
template <typename Derived, typename StoragePrecision, typename ComputePrecision>
INLINE_METHOD exahype2::dg::MaxEigenvalueStatistics
exahype2::dg::limiting::SubcellLimiter<Derived, StoragePrecision, ComputePrecision>::closeTimeStep(
  const peano4::Partition& partition,
  CellPool&                solution,
  const double             timeStamp,
  const double             timeStepSize
) {
  auto statistics = judgeCandidates(partition, solution, timeStamp, timeStepSize);
  listCellsOnSubcellScheme(partition);
  const int localRecomputed  = _cellCounts.recomputedCells;
  int       globalRecomputed = 0;
  tarch::mpi::allreduce(
    &localRecomputed,
    &globalRecomputed,
    1,
    MPI_INT,
    MPI_SUM,
    tarch::mpi::Rank::getInstance().getCommunicator()
  );
  _globalTroubledCells = 0;
  if (globalRecomputed > 0) {
    spreadStatuses(partition);
    listCellsOnSubcellScheme(partition);
    statistics = exahype2::dg::MaxEigenvalueStatistics::combine(
      statistics,
      recompute(partition, solution, timeStamp, timeStepSize)
    );
    const int localTroubled = _cellCounts.troubledCells;
    tarch::mpi::allreduce(
      &localTroubled,
      &_globalTroubledCells,
      1,
      MPI_INT,
      MPI_SUM,
      tarch::mpi::Rank::getInstance().getCommunicator()
    );
  }
  assertion(
    _globalTroubledCells >= _cellCounts.troubledCells and _globalTroubledCells <= globalRecomputed,
    _globalTroubledCells,
    _cellCounts.troubledCells,
    globalRecomputed
  );
  return statistics;
}

/**
 * Moves the statuses and the subgrids through the regrid. The next time step fills the previous
 * solution and the faces.
 */
template <typename Derived, typename StoragePrecision, typename ComputePrecision>
INLINE_METHOD void
exahype2::dg::limiting::SubcellLimiter<Derived, StoragePrecision, ComputePrecision>::regrid(
  const peano4::Partition& partition,
  const peano4::Regrid&    regrid,
  const CellPool&          solution
) {
  _previousSolution.reserve(regrid.newNumberOfSlots);
  _subcells.reserve(regrid.newNumberOfSlots);
  _statuses.reserve(regrid.newNumberOfSlots);
  if constexpr (Detector::UsesMaximumPrinciple) {
    _referenceExtrema.reserve(regrid.newNumberOfSlots);
  }

  _subcellMigration.migrate(
    _subcells,
    regrid,
    exahype2::dg::limiting::SubgridTransfer<Derived, StoragePrecision, ComputePrecision>{
      solution.getView(),
      std::as_const(_subcells).getView(),
      std::as_const(_statuses).getView(),
      SubcellProjection<StoragePrecision>::NodesToSubcells1D
    }
  );
  _statusMigration
    .migrate(_statuses, regrid, exahype2::dg::limiting::StatusTransfer{std::as_const(_statuses).getView()});

  rebuild(partition);
}

template <typename Derived, typename StoragePrecision, typename ComputePrecision>
INLINE_METHOD tarch::accelerator::ChunkedMemoryPool<int>::View
exahype2::dg::limiting::SubcellLimiter<Derived, StoragePrecision, ComputePrecision>::getStatuses() {
  return _statuses.getView();
}

/**
 * Copies the status pool to the host. The chunk of a slot starts at slot times the padded chunk
 * size.
 */
template <typename Derived, typename StoragePrecision, typename ComputePrecision>
INLINE_METHOD const int*
exahype2::dg::limiting::SubcellLimiter<Derived, StoragePrecision, ComputePrecision>::downloadStatuses() {
  _statuses.copyToHost(_statusesOnHost);
  return _statusesOnHost.data();
}

/**
 * Copies the subgrid pool to the host. The chunk of a slot starts at slot times the padded chunk
 * size.
 */
template <typename Derived, typename StoragePrecision, typename ComputePrecision>
INLINE_METHOD const StoragePrecision*
exahype2::dg::limiting::SubcellLimiter<Derived, StoragePrecision, ComputePrecision>::downloadSubcells() {
  _subcells.copyToHost(_subcellsOnHost);
  return _subcellsOnHost.data();
}

template <typename Derived, typename StoragePrecision, typename ComputePrecision>
INLINE_METHOD int
exahype2::dg::limiting::SubcellLimiter<
  Derived,
  StoragePrecision,
  ComputePrecision
>::getNumberOfRecomputedCells() const {
  return _cellCounts.recomputedCells;
}

/**
 * Returns the number of cells whose status is not Regular at the end of the last time step.
 */
template <typename Derived, typename StoragePrecision, typename ComputePrecision>
INLINE_METHOD int
exahype2::dg::limiting::SubcellLimiter<
  Derived,
  StoragePrecision,
  ComputePrecision
>::getNumberOfCellsOnSubcellScheme() const {
  return _cellCounts.cellsOnScheme;
}

template <typename Derived, typename StoragePrecision, typename ComputePrecision>
INLINE_METHOD int
exahype2::dg::limiting::SubcellLimiter<Derived, StoragePrecision, ComputePrecision>::getNumberOfTroubledCells() const {
  return _cellCounts.troubledCells;
}

/**
 * Returns the number of troubled cells on all ranks at the end of the last closeTimeStep().
 */
template <typename Derived, typename StoragePrecision, typename ComputePrecision>
INLINE_METHOD int
exahype2::dg::limiting::SubcellLimiter<
  Derived,
  StoragePrecision,
  ComputePrecision
>::getGlobalNumberOfTroubledCells() const {
  return _globalTroubledCells;
}

template <typename Derived, typename StoragePrecision, typename ComputePrecision>
INLINE_METHOD void
exahype2::dg::limiting::SubcellLimiter<Derived, StoragePrecision, ComputePrecision>::rebuild(
  const peano4::Partition& partition
) {
  _subcellHalo.reserve(partition.getNumberOfFaces());
  _faceStatuses.reserve(partition.getNumberOfFaces());
  if constexpr (Detector::UsesMaximumPrinciple) {
    _extremaFaces.reserve(partition.getNumberOfFaces());
  }
  _haloExchange.rebuild(partition);
  _statusExchange.rebuild(partition);
  if constexpr (Detector::UsesMaximumPrinciple) {
    _extremaExchange.rebuild(partition);
  }
  _cellsOnSubcellScheme.allocate(static_cast<std::size_t>(partition.getCells().size));
  _recomputedCells.allocate(static_cast<std::size_t>(partition.getCells().size));
  _cellCounts = exahype2::dg::limiting::SubcellSchemeCounts{};
  clearFaces(partition);
}

/**
 * Resets every face to the status Regular and empty extrema. The subcell halo becomes zero, so the
 * level jumps and the rank boundaries move finite values in the halves no cell writes.
 */
template <typename Derived, typename StoragePrecision, typename ComputePrecision>
INLINE_METHOD void
exahype2::dg::limiting::SubcellLimiter<Derived, StoragePrecision, ComputePrecision>::clearFaces(
  const peano4::Partition& partition
) {
  tarch::accelerator::parallelFor(
    tarch::accelerator::Range(partition.getNumberOfFaces()),
    exahype2::dg::limiting::ClearFaces<Derived, StoragePrecision, ComputePrecision>{
      _faceStatuses.getView(),
      _extremaFaces.getView(),
      _subcellHalo.getView()
    }
  );
}

/**
 * Saves the solution of every cell and opens a troubled cell on the subcell scheme.
 */
template <typename Derived, typename StoragePrecision, typename ComputePrecision>
INLINE_METHOD void
exahype2::dg::limiting::SubcellLimiter<Derived, StoragePrecision, ComputePrecision>::openStep(
  const peano4::Partition& partition,
  const CellPool&          solution
) {
  tarch::accelerator::parallelFor(
    tarch::accelerator::Range(partition.getCells().size),
    exahype2::dg::limiting::OpenStep<Derived, StoragePrecision, ComputePrecision>{
      partition.onDevice(),
      solution.getView(),
      _previousSolution.getView(),
      _statuses.getView()
    }
  );
}

/**
 * Reduces the observable extrema of the previous solution over every cell and its face
 * neighbours, one axis per pass. After DIMENSIONS passes, every cell stores the extrema of every
 * cell it touches at a vertex. Minima and maxima are exact, so the extrema do not depend on the
 * rank layout.
 */
template <typename Derived, typename StoragePrecision, typename ComputePrecision>
INLINE_METHOD void
exahype2::dg::limiting::SubcellLimiter<Derived, StoragePrecision, ComputePrecision>::reduceReferenceExtrema(
  const peano4::Partition& partition
) {
  tarch::accelerator::parallelFor(
    tarch::accelerator::Range(partition.getCells().size),
    exahype2::dg::limiting::ReduceReferenceExtrema<Derived, StoragePrecision, ComputePrecision>{
      partition.onDevice(),
      std::as_const(_previousSolution).getView(),
      _referenceExtrema.getView(),
      SubcellProjection<StoragePrecision>::NodesToLobatto1D,
      SubcellProjection<StoragePrecision>::NodesToSubcells1D
    }
  );
  for (int axis = 0; axis < DIMENSIONS; axis++) {
    tarch::accelerator::parallelFor(
      tarch::accelerator::Range(partition.getCells().size),
      exahype2::dg::limiting::WriteExtremaOntoFaces<Derived, StoragePrecision, ComputePrecision>{
        partition.onDevice(),
        std::as_const(_referenceExtrema).getView(),
        _extremaFaces.getView(),
        axis
      }
    );
    exchangeFaces(
      partition,
      exahype2::dg::limiting::InterpolateExtremaHalves<Derived, StoragePrecision, ComputePrecision>{
        _extremaFaces.getView()
      },
      exahype2::dg::limiting::RestrictExtremaHalves<Derived, StoragePrecision, ComputePrecision>{
        _extremaFaces.getView()
      },
      _extremaExchange,
      [this, &partition, axis](const peano4::Adjacency adjacency) {
        const auto cells = partition.onDevice().getCells(adjacency);
        tarch::accelerator::parallelFor(
          tarch::accelerator::Range(cells.size),
          exahype2::dg::limiting::MergeNeighbourExtrema<Derived, StoragePrecision, ComputePrecision>{
            partition.onDevice(),
            cells,
            _referenceExtrema.getView(),
            std::as_const(_extremaFaces).getView(),
            axis
          }
        );
      }
    );
  }
}

/**
 * Checks the candidate of every cell and returns the wave speeds of the accepted candidates whose
 * cells were not troubled.
 */
template <typename Derived, typename StoragePrecision, typename ComputePrecision>
INLINE_METHOD exahype2::dg::MaxEigenvalueStatistics
exahype2::dg::limiting::SubcellLimiter<Derived, StoragePrecision, ComputePrecision>::judgeCandidates(
  const peano4::Partition& partition,
  const CellPool&          solution,
  const double             timeStamp,
  const double             timeStepSize
) {
  exahype2::dg::MaxEigenvalueStatistics statistics;
  tarch::accelerator::parallelReduce(
    tarch::accelerator::Range(partition.getCells().size),
    exahype2::dg::limiting::JudgeCandidates<Derived, StoragePrecision, ComputePrecision>{
      partition.onDevice(),
      solution.getView(),
      _statuses.getView(),
      _faceStatuses.getView(),
      std::as_const(_referenceExtrema).getView(),
      SubcellProjection<StoragePrecision>::NodesToLobatto1D,
      SubcellProjection<StoragePrecision>::NodesToSubcells1D,
      SubcellProjection<StoragePrecision>::QuadraturePoints1D,
      static_cast<StoragePrecision>(_relaxationParameter),
      static_cast<StoragePrecision>(_differencesScaling),
      timeStamp,
      timeStepSize
    },
    tarch::accelerator::Custom<exahype2::dg::MaxEigenvalueStatistics>{statistics}
  );
  return statistics;
}

/**
 * Grows the subcell domain by one ring per round. A neighbour of a troubled cell turns Limited,
 * and a neighbour of a limited cell turns Halo.
 */
template <typename Derived, typename StoragePrecision, typename ComputePrecision>
INLINE_METHOD void
exahype2::dg::limiting::SubcellLimiter<Derived, StoragePrecision, ComputePrecision>::spreadStatuses(
  const peano4::Partition& partition
) {
  for (int ring = 0; ring < exahype2::dg::limiting::NumberOfSpreadRings; ring++) {
    exchangeFaces(
      partition,
      exahype2::dg::limiting::InterpolateStatusHalves{_faceStatuses.getView()},
      exahype2::dg::limiting::RestrictStatusHalves{_faceStatuses.getView()},
      _statusExchange,
      [this, &partition](const peano4::Adjacency adjacency) {
        const auto cells = partition.onDevice().getCells(adjacency);
        tarch::accelerator::parallelFor(
          tarch::accelerator::Range(cells.size),
          exahype2::dg::limiting::SpreadStatuses<Derived, ComputePrecision>{
            partition.onDevice(),
            cells,
            _statuses.getView(),
            _faceStatuses.getView()
          }
        );
      }
    );
  }
}

/**
 * Lists and counts the cells whose status is not Regular and the cells that recompute, the local
 * cells first.
 */
template <typename Derived, typename StoragePrecision, typename ComputePrecision>
INLINE_METHOD void
exahype2::dg::limiting::SubcellLimiter<Derived, StoragePrecision, ComputePrecision>::listCellsOnSubcellScheme(
  const peano4::Partition& partition
) {
  const int numberOfCells = partition.getCells().size;
  assertion(
    _cellsOnSubcellScheme.getSize() == static_cast<std::size_t>(numberOfCells),
    _cellsOnSubcellScheme.getSize(),
    numberOfCells
  );
  assertion(
    _recomputedCells.getSize() == static_cast<std::size_t>(numberOfCells),
    _recomputedCells.getSize(),
    numberOfCells
  );
  constexpr int MaximumNumberOfBlocks = 1024;
  const int     numberOfBlocks        = std::min(numberOfCells, MaximumNumberOfBlocks);
  if (_cellCountsOfBlocks.getSize() < static_cast<std::size_t>(numberOfBlocks)) {
    _cellCountsOfBlocks.allocate(static_cast<std::size_t>(numberOfBlocks));
  }
  _cellCounts = exahype2::dg::limiting::SubcellSchemeCounts{};
  tarch::accelerator::parallelReduce(
    tarch::accelerator::Range(numberOfBlocks),
    exahype2::dg::limiting::CountCellsOnSubcellScheme{
      partition.onDevice(),
      std::as_const(_statuses).getView(),
      numberOfBlocks,
      partition.getCells(peano4::Adjacency::Local).size,
      _cellCountsOfBlocks.getData()
    },
    tarch::accelerator::Custom<exahype2::dg::limiting::SubcellSchemeCountsReduction>{_cellCounts}
  );
  tarch::accelerator::parallelFor(
    tarch::accelerator::Range(numberOfBlocks),
    exahype2::dg::limiting::ListCellsOnSubcellScheme{
      partition.onDevice(),
      std::as_const(_statuses).getView(),
      numberOfBlocks,
      std::as_const(_cellCountsOfBlocks).getData(),
      _cellsOnSubcellScheme.getData(),
      _recomputedCells.getData()
    }
  );
  assertion(
    _cellCounts.recomputedCells <= _cellCounts.cellsOnScheme,
    _cellCounts.recomputedCells,
    _cellCounts.cellsOnScheme
  );
  assertion(
    _cellCounts.troubledCells <= _cellCounts.recomputedCells,
    _cellCounts.troubledCells,
    _cellCounts.recomputedCells
  );
}

/**
 * Advances every recomputing cell by one finite-volume step on its subgrid and projects the result
 * onto the nodes over the candidate. Every cell on the subcell scheme first writes its subgrid onto
 * its faces, and the local cells recompute while the ranks exchange the halo. Returns the wave
 * speeds of the subgrids.
 */
template <typename Derived, typename StoragePrecision, typename ComputePrecision>
INLINE_METHOD exahype2::dg::MaxEigenvalueStatistics
exahype2::dg::limiting::SubcellLimiter<Derived, StoragePrecision, ComputePrecision>::recompute(
  const peano4::Partition& partition,
  CellPool&                solution,
  const double             timeStamp,
  const double             timeStepSize
) {
  tarch::accelerator::parallelFor(
    tarch::accelerator::Range(_cellCounts.cellsOnScheme),
    exahype2::dg::limiting::ProjectSubgridsOntoFaces<Derived, StoragePrecision, ComputePrecision>{
      partition.onDevice(),
      tarch::Span<const int>{_cellsOnSubcellScheme.getData(), _cellCounts.cellsOnScheme},
      std::as_const(_previousSolution).getView(),
      _subcells.getView(),
      _subcellHalo.getView(),
      std::as_const(_statuses).getView(),
      SubcellProjection<StoragePrecision>::NodesToSubcells1D,
      timeStamp <= 0.0
    }
  );
  const auto boundaryFaces = partition.onDevice().getFaces(peano4::Adjacency::Local, peano4::FaceKind::Boundary);
  tarch::accelerator::parallelFor(
    tarch::accelerator::Range(boundaryFaces.size),
    exahype2::dg::limiting::ApplySubgridBoundaryConditions<Derived, StoragePrecision, ComputePrecision>{
      {partition.onDevice(), boundaryFaces, _subcellHalo.getView(), timeStamp},
      std::as_const(_statuses).getView()
    }
  );

  const auto scratchValues =
    static_cast<std::size_t>(tarch::accelerator::getNumberOfScratchChunks(_cellCounts.recomputedCells))
    * SubcellScheme::SubcellValuesPerCell;
  if (_recomputeScratch.getSize() < scratchValues) {
    _recomputeScratch.allocate(scratchValues);
  }
  exahype2::dg::MaxEigenvalueStatistics statistics;
  // A level jump copies coarse subcells into the fine halo, so the halo stays within the range of
  // the coarse subgrid at a shock.
  exchangeFaces(
    partition,
    exahype2::fv::InjectHaloHalves<Derived, StoragePrecision, ComputePrecision>{
      partition.onDevice(),
      _subcellHalo.getView()
    },
    exahype2::fv::RestrictHaloHalves<Derived, StoragePrecision, ComputePrecision>{
      partition.onDevice(),
      _subcellHalo.getView()
    },
    _haloExchange,
    [this, &partition, &solution, &statistics, timeStamp, timeStepSize](const peano4::Adjacency adjacency) {
      const int local = _cellCounts.localRecomputedCells;
      const int first = adjacency == peano4::Adjacency::Local ? 0 : local;
      const int count = adjacency == peano4::Adjacency::Local ? local : _cellCounts.recomputedCells - local;
      exahype2::dg::MaxEigenvalueStatistics statisticsOfGroup;
      tarch::accelerator::parallelReduce(
        tarch::accelerator::Range(count),
        exahype2::dg::limiting::RecomputeSubcells<Derived, StoragePrecision, ComputePrecision>{
          partition.onDevice(),
          tarch::Span<const int>{_recomputedCells.getData() + first, count},
          solution.getView(),
          _subcells.getView(),
          std::as_const(_subcellHalo).getView(),
          SubcellProjection<StoragePrecision>::SubcellsToNodes1D,
          _recomputeScratch.getData(),
          timeStamp,
          timeStepSize
        },
        tarch::accelerator::Custom<exahype2::dg::MaxEigenvalueStatistics>{statisticsOfGroup}
      );
      statistics = exahype2::dg::MaxEigenvalueStatistics::combine(statistics, statisticsOfGroup);
    }
  );
  return statistics;
}

/**
 * Passes one kind of face halves across the level jumps and the rank boundaries, then calls
 * workOnCells for the local and the remote cells. exchange runs twice: The first round sends the
 * halves the remote level jumps interpolate, the second the restricted halves while the local
 * cells work.
 */
template <typename Derived, typename StoragePrecision, typename ComputePrecision>
template <typename Interpolate, typename Restrict, typename Exchange, typename Work>
INLINE_METHOD void
exahype2::dg::limiting::SubcellLimiter<Derived, StoragePrecision, ComputePrecision>::exchangeFaces(
  const peano4::Partition& partition,
  const Interpolate&       interpolation,
  const Restrict&          restriction,
  Exchange&                exchange,
  const Work&              workOnCells
) {
  exchange.post();
  exahype2::interpolateCoarseFaces(partition, peano4::Adjacency::Local, interpolation);
  exahype2::restrictFineFaces(partition, peano4::Adjacency::Local, restriction);
  exchange.wait();
  exahype2::interpolateCoarseFaces(partition, peano4::Adjacency::Remote, interpolation);
  exahype2::restrictFineFaces(partition, peano4::Adjacency::Remote, restriction);
  exchange.post();
  workOnCells(peano4::Adjacency::Local);
  exchange.wait();
  workOnCells(peano4::Adjacency::Remote);
}
