INLINE_METHOD GPU_CALLABLE_METHOD bool
exahype2::dg::limiting::SubcellScheme<Derived, ComputePrecision>::SubgridSolver<Reconstruct>::isPhysicallyAdmissible(
  const Precision* const                       Q,
  const int                                    numberOfStates,
  const tarch::la::Vector<DIMENSIONS, double>& x,
  const tarch::la::Vector<DIMENSIONS, double>& h,
  const RuntimeParameters&                     parameters
)
  requires exahype2::terms::HasPhysicalAdmissibility<Derived, Precision>
{
