#include "tarch/Assertions.h"
#include "tarch/accelerator/Scratch.h"

TARGET_DECLARE
template <typename Derived, typename ComputePrecision>
template <typename StoragePrecision>
INLINE_METHOD void
exahype2::dg::limiting::SubcellScheme<Derived, ComputePrecision>::sampleInitialCondition(
  StoragePrecision* NOALIAS const              subcells,
  const tarch::la::Vector<DIMENSIONS, double>& cellCentre,
  const tarch::la::Vector<DIMENSIONS, double>& cellSize
) {
  forEachSubcell(
    cellCentre,
    cellSize,
    subcells,
    [](
      StoragePrecision* const                      values,
      const tarch::la::Vector<DIMENSIONS, double>& x,
      const tarch::la::Vector<DIMENSIONS, double>& h
    ) { Derived::initialCondition(values, x, h); }
  );
}

/**
 * Averages the nodal polynomial of a cell onto its subcells, every axis through the same matrix.
 */
template <typename Derived, typename ComputePrecision>
template <typename StoragePrecision>
INLINE_METHOD GPU_CALLABLE_METHOD void
exahype2::dg::limiting::SubcellScheme<Derived, ComputePrecision>::projectNodesOntoSubcells(
  const StoragePrecision* NOALIAS const nodes,
  StoragePrecision* NOALIAS const       subcells,
  const StoragePrecision* NOALIAS const nodesToSubcells
) {
  assertion(nodes != nullptr);
  assertion(subcells != nullptr);
  assertion(nodesToSubcells != nullptr);
  exahype2::dg::projectTensorProduct<DIMENSIONS, NodesPerAxis, SubcellsPerAxis, NumberOfData>(
    nodes,
    subcells,
    nodesToSubcells
  );
}

/**
 * Writes the subgrid onto the halo halves. A cell that ran the Galerkin scheme in the previous step
 * first projects its previous solution onto the subgrid. In the first step, every subgrid stores
 * the sampled initial condition.
 */
template <typename Derived, typename ComputePrecision>
template <typename StoragePrecision>
INLINE_METHOD GPU_CALLABLE_METHOD void
exahype2::dg::limiting::SubcellScheme<Derived, ComputePrecision>::projectSubgridOntoFaces(
  const int* NOALIAS const              status,
  StoragePrecision* NOALIAS const       subcells,
  const StoragePrecision* NOALIAS const previousSolution,
  StoragePrecision* const               haloHalves[peano4::FacesPerCell],
  const StoragePrecision* NOALIAS const nodesToSubcells,
  const bool                            holdsInitialSubcells
) {
  const auto previousStatus = static_cast<exahype2::dg::limiting::LimiterStatus>(
    status[static_cast<int>(exahype2::dg::limiting::StatusEntry::PreviousStatus)]
  );
  if (not exahype2::dg::limiting::runsSubcellScheme(previousStatus) and not holdsInitialSubcells) {
    projectNodesOntoSubcells(previousSolution, subcells, nodesToSubcells);
  }
  Subgrid::projectOntoFaces(subcells, haloHalves);
}

/**
 * Advances the subgrid by one step, projects it onto the nodes and returns its wave speeds, or
 * empty maxima with a fixed time step rule. A solver with a fallback reconstruction repeats the
 * step with it when an evolved subcell fails the physical admissibility test. Bit f of
 * boundaryFaces is set when face f lies on the domain boundary.
 */
template <typename Derived, typename ComputePrecision>
template <typename StoragePrecision>
INLINE_METHOD GPU_CALLABLE_METHOD exahype2::dg::MaxEigenvalueStatistics
exahype2::dg::limiting::SubcellScheme<Derived, ComputePrecision>::recompute(
  StoragePrecision* NOALIAS const              nodes,
  StoragePrecision* NOALIAS const              subcells,
  StoragePrecision* NOALIAS const              evolvedSubcells,
  const StoragePrecision* const                haloHalves[peano4::FacesPerCell],
  const StoragePrecision* NOALIAS const        subcellsToNodes,
  const tarch::la::Vector<DIMENSIONS, double>& cellCentre,
  const tarch::la::Vector<DIMENSIONS, double>& cellSize,
  const int                                    boundaryFaces,
  const double                                 timeStamp,
  const double                                 timeStepSize
) {
  using FallbackReconstruction = typename Derived::FallbackReconstruction;
  advanceSubcells<typename Derived::Reconstruction>(
    subcells,
    evolvedSubcells,
    haloHalves,
    cellCentre,
    cellSize,
    boundaryFaces,
    timeStamp,
    timeStepSize
  );
  if constexpr (
    exahype2::terms::HasPhysicalAdmissibility<Derived, StoragePrecision> and not std::is_void_v<FallbackReconstruction>
  ) {
    bool needsFallback = false;
    for (int subcell = 0; subcell < SubcellsPerCell and not needsFallback; subcell++) {
      needsFallback = not Derived::isPhysicallyAdmissible(
        evolvedSubcells + static_cast<std::ptrdiff_t>(subcell) * NumberOfData,
        1,
        cellCentre,
        cellSize
      );
    }
    if (needsFallback) {
      advanceSubcells<FallbackReconstruction>(
        subcells,
        evolvedSubcells,
        haloHalves,
        cellCentre,
        cellSize,
        boundaryFaces,
        timeStamp,
        timeStepSize
      );
    }
  }
  for (int value = 0; value < SubcellValuesPerCell; value++) {
    subcells[value] = evolvedSubcells[value];
  }
  projectSubcellsOntoNodes(subcells, nodes, subcellsToNodes);
  if constexpr (ReportEigenvalues) {
    return reduceMaxEigenvalues(subcells, cellCentre, cellSize, timeStamp + timeStepSize, timeStepSize);
  } else {
    return exahype2::dg::MaxEigenvalueStatistics{};
  }
}

/**
 * Runs recompute() on a host thread. On a device the threads of the team divide the subcells and
 * the nodes of the cell among themselves in every phase of recompute(), and every thread returns
 * the wave speeds of its subcells.
 */
template <typename Derived, typename ComputePrecision>
template <typename StoragePrecision>
INLINE_METHOD GPU_CALLABLE_METHOD exahype2::dg::MaxEigenvalueStatistics
exahype2::dg::limiting::SubcellScheme<Derived, ComputePrecision>::recomputeInTeam(
  [[maybe_unused]] const tarch::accelerator::TeamHandle team,
  StoragePrecision* NOALIAS const                       nodes,
  StoragePrecision* NOALIAS const                       subcells,
  StoragePrecision* NOALIAS const                       evolvedSubcells,
  const StoragePrecision* const                         haloHalves[peano4::FacesPerCell],
  const StoragePrecision* NOALIAS const                 subcellsToNodes,
  const tarch::la::Vector<DIMENSIONS, double>&          cellCentre,
  const tarch::la::Vector<DIMENSIONS, double>&          cellSize,
  const int                                             boundaryFaces,
  const double                                          timeStamp,
  const double                                          timeStepSize
) {
  exahype2::dg::MaxEigenvalueStatistics statistics;
  COMPILE_IF_ON_HOST(
    statistics = recompute(
      nodes,
      subcells,
      evolvedSubcells,
      haloHalves,
      subcellsToNodes,
      cellCentre,
      cellSize,
      boundaryFaces,
      timeStamp,
      timeStepSize
    );
  )
  COMPILE_IF_ON_DEVICE(
    using Reconstruction         = typename Derived::Reconstruction;
    using FallbackReconstruction = typename Derived::FallbackReconstruction;
    const int thread             = tarch::accelerator::getThreadOfTeam(team);
    const int threads            = tarch::accelerator::getNumberOfThreadsPerTeam(team);
    for (int subcell = thread; subcell < SubcellsPerCell; subcell += threads) {
      static_cast<void>(
        exahype2::fv::FiniteVolumeScheme<SubgridSolver<Reconstruction>, ComputePrecision>::computeVolumeUpdate(
          subcell,
          subcells,
          haloHalves,
          cellCentre,
          cellSize,
          timeStamp,
          timeStepSize,
          boundaryFaces,
          evolvedSubcells + static_cast<std::ptrdiff_t>(subcell) * NumberOfData
        )
      );
    } if constexpr (exahype2::terms::HasPhysicalAdmissibility<Derived, StoragePrecision> and not std::is_void_v<FallbackReconstruction>) {
      // Every thread marks in the team scratch whether one of its evolved subcells fails.
      unsigned char* const failures = tarch::accelerator::getTeamScratch(team);
      bool                 fails    = false;
      for (int subcell = thread; subcell < SubcellsPerCell; subcell += threads) {
        fails = fails
          or not Derived::isPhysicallyAdmissible(
                  evolvedSubcells + static_cast<std::ptrdiff_t>(subcell) * NumberOfData,
                  1,
                  cellCentre,
                  cellSize
          );
      }
      failures[thread] = fails ? 1 : 0;
      tarch::accelerator::teamBarrier(team);
      bool needsFallback = false;
      for (int other = 0; other < threads; other++) {
        needsFallback = needsFallback or failures[other] != 0;
      }
      tarch::accelerator::teamBarrier(team);
      if (needsFallback) {
        for (int subcell = thread; subcell < SubcellsPerCell; subcell += threads) {
          static_cast<void>(exahype2::fv::FiniteVolumeScheme<SubgridSolver<FallbackReconstruction>, ComputePrecision>::
                              computeVolumeUpdate(
                                subcell,
                                subcells,
                                haloHalves,
                                cellCentre,
                                cellSize,
                                timeStamp,
                                timeStepSize,
                                boundaryFaces,
                                evolvedSubcells + static_cast<std::ptrdiff_t>(subcell) * NumberOfData
                              ));
        }
      }
    } tarch::accelerator::teamBarrier(team);
    for (int subcell = thread; subcell < SubcellsPerCell; subcell += threads) {
      for (int value = subcell * NumberOfData; value < (subcell + 1) * NumberOfData; value++) {
        subcells[value] = evolvedSubcells[value];
      }
    } tarch::accelerator::teamBarrier(team);
    for (int node = thread; node < exahype2::dg::getNodesPerCell(NodesPerAxis); node += threads) {
      projectSubcellsOntoNode(subcells, nodes, subcellsToNodes, node);
    } if constexpr (ReportEigenvalues) {
      for (int subcell = thread; subcell < SubcellsPerCell; subcell += threads) {
        statistics = exahype2::dg::MaxEigenvalueStatistics::combine(
          statistics,
          reduceMaxEigenvaluesOfSubcell(subcells, subcell, cellCentre, cellSize, timeStamp + timeStepSize, timeStepSize)
        );
      }
    }
    // The reduction of the team may run through the scratch. Every thread leaves it first.
    tarch::accelerator::teamBarrier(team);
  )
  return statistics;
}

/**
 * Returns the physical and scaled wave speeds of one subcell of a cell.
 */
template <typename Derived, typename ComputePrecision>
template <typename StoragePrecision>
INLINE_METHOD GPU_CALLABLE_METHOD exahype2::dg::MaxEigenvalueStatistics
exahype2::dg::limiting::SubcellScheme<Derived, ComputePrecision>::reduceMaxEigenvaluesOfSubcell(
  const StoragePrecision* NOALIAS const        subcells,
  const int                                    subcell,
  const tarch::la::Vector<DIMENSIONS, double>& cellCentre,
  const tarch::la::Vector<DIMENSIONS, double>& cellSize,
  const double                                 timeStamp,
  const double                                 timeStepSize
) {
  assertion(subcell >= 0 and subcell < SubcellsPerCell, subcell);
  tarch::la::Vector<DIMENSIONS, int> index;
  int                                remainder = subcell;
  for (int axis = 0; axis < DIMENSIONS; axis++) {
    index(axis) = remainder % SubcellsPerAxis;
    remainder /= SubcellsPerAxis;
  }
  const auto subcellSize   = exahype2::fv::getVolumeSize(cellSize, SubcellsPerAxis);
  const auto subcellCentre = exahype2::fv::getVolumeCentre(cellCentre, cellSize, SubcellsPerAxis, index);
  const StoragePrecision* const         values = subcells + static_cast<std::ptrdiff_t>(subcell) * NumberOfData;
  exahype2::dg::MaxEigenvalueStatistics result;
  result.template accumulate<DIMENSIONS>(cellSize, [&](const int normal) {
    return Derived::maxEigenvalue(values, subcellCentre, subcellSize, timeStamp, timeStepSize, normal);
  });
  return result;
}

/**
 * Returns the physical and scaled wave-speed maxima over the subcells of a cell. The scaled wave
 * speeds divide by the cell extents. They bound the same time step as the nodal maxima.
 */
template <typename Derived, typename ComputePrecision>
template <typename StoragePrecision>
INLINE_METHOD GPU_CALLABLE_METHOD exahype2::dg::MaxEigenvalueStatistics
exahype2::dg::limiting::SubcellScheme<Derived, ComputePrecision>::reduceMaxEigenvalues(
  const StoragePrecision* NOALIAS const        subcells,
  const tarch::la::Vector<DIMENSIONS, double>& cellCentre,
  const tarch::la::Vector<DIMENSIONS, double>& cellSize,
  const double                                 timeStamp,
  const double                                 timeStepSize
) {
  assertion(subcells != nullptr);
  exahype2::dg::MaxEigenvalueStatistics result;
  forEachSubcell(
    cellCentre,
    cellSize,
    subcells,
    [&](
      const StoragePrecision* const                values,
      const tarch::la::Vector<DIMENSIONS, double>& x,
      const tarch::la::Vector<DIMENSIONS, double>& h
    ) {
      result.template accumulate<DIMENSIONS>(cellSize, [&](const int normal) {
        return Derived::maxEigenvalue(values, x, h, timeStamp, timeStepSize, normal);
      });
    }
  );
  return result;
}

/**
 * Calls functor(values, x, h) for every subcell in linearised order, with x the centre of the
 * subcell and h its size.
 */
template <typename Derived, typename ComputePrecision>
template <typename Value, typename Functor>
INLINE_METHOD constexpr void
exahype2::dg::limiting::SubcellScheme<Derived, ComputePrecision>::forEachSubcell(
  const tarch::la::Vector<DIMENSIONS, double>& cellCentre,
  const tarch::la::Vector<DIMENSIONS, double>& cellSize,
  Value* const                                 values,
  Functor&&                                    functor
) {
  assertion(values != nullptr);
  const auto subcellSize = exahype2::fv::getVolumeSize(cellSize, SubcellsPerAxis);
  for (int axis = 0; axis < DIMENSIONS; axis++) {
    assertion(subcellSize(axis) > 0.0, subcellSize, axis);
  }
  peano4::dForEach(SubcellsPerAxis, [&](const tarch::la::Vector<DIMENSIONS, int>& subcell) {
    const int  index         = peano4::dLinearised(subcell, SubcellsPerAxis);
    const auto subcellCentre = exahype2::fv::getVolumeCentre(cellCentre, cellSize, SubcellsPerAxis, subcell);
    functor(values + static_cast<std::ptrdiff_t>(index) * NumberOfData, subcellCentre, subcellSize);
  });
}

/**
 * Runs the finite-volume scheme with the reconstruction Reconstruct on one subgrid.
 */
template <typename Derived, typename ComputePrecision>
template <typename Reconstruct, typename StoragePrecision>
INLINE_METHOD GPU_CALLABLE_METHOD void
exahype2::dg::limiting::SubcellScheme<Derived, ComputePrecision>::advanceSubcells(
  const StoragePrecision* NOALIAS const        subcells,
  StoragePrecision* NOALIAS const              evolvedSubcells,
  const StoragePrecision* const                haloHalves[peano4::FacesPerCell],
  const tarch::la::Vector<DIMENSIONS, double>& cellCentre,
  const tarch::la::Vector<DIMENSIONS, double>& cellSize,
  const int                                    boundaryFaces,
  const double                                 timeStamp,
  const double                                 timeStepSize
) {
  static_assert(
    Reconstruct::HaloSize == HaloSize,
    "The fallback reconstruction of the limiter needs the halo width of the primary reconstruction."
  );
  static_cast<void>(exahype2::fv::FiniteVolumeScheme<SubgridSolver<Reconstruct>, ComputePrecision>::update(
    subcells,
    evolvedSubcells,
    haloHalves,
    cellCentre,
    cellSize,
    timeStamp,
    timeStepSize,
    boundaryFaces
  ));
}

/**
 * Projects the subcell averages of a cell back onto its nodes, every axis through the same matrix.
 */
template <typename Derived, typename ComputePrecision>
template <typename StoragePrecision>
INLINE_METHOD GPU_CALLABLE_METHOD void
exahype2::dg::limiting::SubcellScheme<Derived, ComputePrecision>::projectSubcellsOntoNodes(
  const StoragePrecision* NOALIAS const subcells,
  StoragePrecision* NOALIAS const       nodes,
  const StoragePrecision* NOALIAS const subcellsToNodes
) {
  assertion(subcells != nullptr);
  assertion(nodes != nullptr);
  assertion(subcellsToNodes != nullptr);
  exahype2::dg::projectTensorProduct<DIMENSIONS, SubcellsPerAxis, NodesPerAxis, NumberOfData>(
    subcells,
    nodes,
    subcellsToNodes
  );
}

/**
 * Projects the subcell averages of a cell onto one of its nodes. The sums run in the order of
 * projectSubcellsOntoNodes(). The threads of a team call it for different nodes of one cell.
 */
template <typename Derived, typename ComputePrecision>
template <typename StoragePrecision>
INLINE_METHOD GPU_CALLABLE_METHOD void
exahype2::dg::limiting::SubcellScheme<Derived, ComputePrecision>::projectSubcellsOntoNode(
  const StoragePrecision* NOALIAS const subcells,
  StoragePrecision* NOALIAS const       nodes,
  const StoragePrecision* NOALIAS const subcellsToNodes,
  const int                             node
) {
  constexpr int SubcellsAlongThirdAxis = DIMENSIONS == 3 ? SubcellsPerAxis : 1;
  assertion(subcells != nullptr);
  assertion(nodes != nullptr);
  assertion(subcellsToNodes != nullptr);
  assertion(node >= 0 and node < exahype2::dg::getNodesPerCell(NodesPerAxis), node);
  const int                  firstIndex  = node % NodesPerAxis;
  const int                  secondIndex = (node / NodesPerAxis) % NodesPerAxis;
  [[maybe_unused]] const int thirdIndex  = node / (NodesPerAxis * NodesPerAxis);
  for (int value = 0; value < NumberOfData; value++) {
    StoragePrecision projected{0};
    for (int thirdSubcell = 0; thirdSubcell < SubcellsAlongThirdAxis; thirdSubcell++) {
      StoragePrecision plane{0};
      for (int secondSubcell = 0; secondSubcell < SubcellsPerAxis; secondSubcell++) {
        StoragePrecision line{0};
        for (int firstSubcell = 0; firstSubcell < SubcellsPerAxis; firstSubcell++) {
          const int subcell = (thirdSubcell * SubcellsPerAxis + secondSubcell) * SubcellsPerAxis + firstSubcell;
          line += subcells[subcell * NumberOfData + value] * subcellsToNodes[firstSubcell * NodesPerAxis + firstIndex];
        }
        plane += line * subcellsToNodes[secondSubcell * NodesPerAxis + secondIndex];
      }
      if constexpr (DIMENSIONS == 3) {
        projected += plane * subcellsToNodes[thirdSubcell * NodesPerAxis + thirdIndex];
      } else {
        projected = plane;
      }
    }
    nodes[node * NumberOfData + value] = projected;
  }
}

template <typename Derived, typename ComputePrecision>
template <typename Reconstruct>
template <typename Precision>
INLINE_METHOD GPU_CALLABLE_METHOD void
exahype2::dg::limiting::SubcellScheme<Derived, ComputePrecision>::SubgridSolver<Reconstruct>::flux(
  const Precision* const                       Q,
  const tarch::la::Vector<DIMENSIONS, double>& x,
  const tarch::la::Vector<DIMENSIONS, double>& h,
  const double                                 t,
  const double                                 dt,
  const int                                    normal,
  Precision* const                             F
)
  requires exahype2::terms::HasFlux<Derived, Precision>
{
  Derived::flux(Q, x, h, t, dt, normal, F);
}

template <typename Derived, typename ComputePrecision>
template <typename Reconstruct>
template <typename Precision>
INLINE_METHOD GPU_CALLABLE_METHOD void
exahype2::dg::limiting::SubcellScheme<Derived, ComputePrecision>::SubgridSolver<Reconstruct>::nonconservativeProduct(
  const Precision* const                       Q,
  const Precision* const                       deltaQ,
  const tarch::la::Vector<DIMENSIONS, double>& x,
  const tarch::la::Vector<DIMENSIONS, double>& h,
  const double                                 t,
  const double                                 dt,
  const int                                    normal,
  Precision* const                             BTimesDeltaQ
)
  requires exahype2::terms::HasNonconservativeProduct<Derived, Precision>
{
  Derived::nonconservativeProduct(Q, deltaQ, x, h, t, dt, normal, BTimesDeltaQ);
}

template <typename Derived, typename ComputePrecision>
template <typename Reconstruct>
template <typename Precision>
INLINE_METHOD GPU_CALLABLE_METHOD void
exahype2::dg::limiting::SubcellScheme<Derived, ComputePrecision>::SubgridSolver<Reconstruct>::sourceTerm(
  const Precision* const                       Q,
  const tarch::la::Vector<DIMENSIONS, double>& x,
  const tarch::la::Vector<DIMENSIONS, double>& h,
  const double                                 t,
  const double                                 dt,
  Precision* const                             S
)
  requires exahype2::terms::HasSourceTerm<Derived, Precision>
{
  Derived::sourceTerm(Q, x, h, t, dt, S);
}

template <typename Derived, typename ComputePrecision>
template <typename Reconstruct>
template <typename Precision>
INLINE_METHOD GPU_CALLABLE_METHOD void
exahype2::dg::limiting::SubcellScheme<Derived, ComputePrecision>::SubgridSolver<Reconstruct>::diffusiveSourceTerm(
  const Precision* const                       Q,
  const Precision* const                       deltaQ,
  const tarch::la::Vector<DIMENSIONS, double>& x,
  const tarch::la::Vector<DIMENSIONS, double>& h,
  const double                                 t,
  const double                                 dt,
  Precision* const                             S
)
  requires exahype2::terms::HasDiffusiveSourceTerm<Derived, Precision>
{
  Derived::diffusiveSourceTerm(Q, deltaQ, x, h, t, dt, S);
}

template <typename Derived, typename ComputePrecision>
template <typename Reconstruct>
template <typename Precision>
INLINE_METHOD GPU_CALLABLE_METHOD double
exahype2::dg::limiting::SubcellScheme<Derived, ComputePrecision>::SubgridSolver<Reconstruct>::maxEigenvalue(
  const Precision* const                       Q,
  const tarch::la::Vector<DIMENSIONS, double>& x,
  const tarch::la::Vector<DIMENSIONS, double>& h,
  const double                                 t,
  const double                                 dt,
  const int                                    normal
)
  requires exahype2::terms::HasMaxEigenvalue<Derived, Precision>
{
  return Derived::maxEigenvalue(Q, x, h, t, dt, normal);
}

template <typename Derived, typename ComputePrecision>
template <typename Reconstruct>
template <typename Precision>
INLINE_METHOD GPU_CALLABLE_METHOD double
exahype2::dg::limiting::SubcellScheme<Derived, ComputePrecision>::SubgridSolver<Reconstruct>::solveRiemannProblem(
  const Precision* const                       QL,
  const Precision* const                       QR,
  const tarch::la::Vector<DIMENSIONS, double>& x,
  const tarch::la::Vector<DIMENSIONS, double>& h,
  const double                                 t,
  const double                                 dt,
  const int                                    normal,
  const bool                                   isBoundaryFace,
  const int                                    faceIndex,
  Precision* const                             FL,
  Precision* const                             FR
)
  requires exahype2::terms::HasSubcellRiemannSolver<Derived, Precision>
{
  return Derived::solveSubcellRiemannProblem(QL, QR, x, h, t, dt, normal, isBoundaryFace, faceIndex, FL, FR);
}

template <typename Derived, typename StoragePrecision, typename ComputePrecision>
INLINE_METHOD GPU_CALLABLE_METHOD void
exahype2::dg::limiting::ProjectSubgridsOntoFaces<Derived, StoragePrecision, ComputePrecision>::operator()(
  const int entry
) const {
  const int         slot = cells[entry];
  StoragePrecision* haloHalves[peano4::FacesPerCell];
  for (int faceNumber = 0; faceNumber < peano4::FacesPerCell; faceNumber++) {
    haloHalves[faceNumber] = halo.getChunk(partition.getCellFace(slot, faceNumber));
  }
  Kernel::projectSubgridOntoFaces(
    statuses.getChunk(slot),
    subcells.getChunk(slot),
    previousSolution.getChunk(slot),
    haloHalves,
    nodesToSubcells,
    holdsInitialSubcells
  );
}

template <typename Derived, typename StoragePrecision, typename ComputePrecision>
INLINE_METHOD GPU_CALLABLE_METHOD void
exahype2::dg::limiting::ApplySubgridBoundaryConditions<Derived, StoragePrecision, ComputePrecision>::operator()(
  const int entry
) const {
  const int  face      = boundaryConditions.boundaryFaces[entry];
  const int  lowerCell = boundaryConditions.partition.getFaceCell(face, 0);
  const int  slot      = lowerCell >= 0 ? lowerCell : boundaryConditions.partition.getFaceCell(face, 1);
  const auto status    = static_cast<exahype2::dg::limiting::LimiterStatus>(
    statuses.getChunk(slot)[static_cast<int>(exahype2::dg::limiting::StatusEntry::Status)]
  );
  if (status != exahype2::dg::limiting::LimiterStatus::Regular) {
    boundaryConditions(entry);
  }
}

template <typename Derived, typename StoragePrecision, typename ComputePrecision>
INLINE_METHOD GPU_CALLABLE_METHOD void
exahype2::dg::limiting::RecomputeSubcells<Derived, StoragePrecision, ComputePrecision>::operator()(
  const int                                             entry,
  [[maybe_unused]] const tarch::accelerator::TeamHandle team,
  exahype2::dg::MaxEigenvalueStatistics&                accumulator
) const {
  const int               slot = cells[entry];
  const StoragePrecision* haloHalves[peano4::FacesPerCell];
  for (int faceNumber = 0; faceNumber < peano4::FacesPerCell; faceNumber++) {
    haloHalves[faceNumber] = halo.getChunk(partition.getCellFace(slot, faceNumber));
  }
  StoragePrecision* const evolvedSubcells =
    scratch + static_cast<std::ptrdiff_t>(tarch::accelerator::getScratchChunk(entry)) * Kernel::SubcellValuesPerCell;
  const tarch::la::Vector<DIMENSIONS, double> centre     = partition.getCellCentre(slot);
  const tarch::la::Vector<DIMENSIONS, double> width      = partition.getCellWidth(slot);
  const exahype2::dg::MaxEigenvalueStatistics statistics = Kernel::recomputeInTeam(
    team,
    nodes.getChunk(slot),
    subcells.getChunk(slot),
    evolvedSubcells,
    haloHalves,
    subcellsToNodes,
    centre,
    width,
    exahype2::fv::getBoundaryFaceMask(partition, slot),
    timeStamp,
    timeStepSize
  );
  COMPILE_IF_ON_HOST(accumulator = exahype2::dg::MaxEigenvalueStatistics::combine(accumulator, statistics);)
  COMPILE_IF_ON_DEVICE(
    const tarch::accelerator::Custom<exahype2::dg::MaxEigenvalueStatistics> reducer{accumulator};
    tarch::accelerator::reduceOverTeam(team, statistics, reducer);
  )
}

template <typename Derived, typename StoragePrecision, typename ComputePrecision>
INLINE_METHOD GPU_CALLABLE_METHOD void
exahype2::dg::limiting::SubgridTransfer<Derived, StoragePrecision, ComputePrecision>::copy(
  const int               slot,
  StoragePrecision* const target
) const {
  const StoragePrecision* const subgrid = getSubgrid(slot, target);
  if (subgrid != target) {
    for (int value = 0; value < Kernel::SubcellValuesPerCell; value++) {
      target[value] = subgrid[value];
    }
  }
}

template <typename Derived, typename StoragePrecision, typename ComputePrecision>
INLINE_METHOD GPU_CALLABLE_METHOD void
exahype2::dg::limiting::SubgridTransfer<Derived, StoragePrecision, ComputePrecision>::interpolateFromParent(
  const int               parentSlot,
  StoragePrecision* const target,
  const int               childPosition
) const {
  StoragePrecision projection[Kernel::SubcellValuesPerCell];
  Kernel::Subgrid::interpolatePatch(getSubgrid(parentSlot, projection), target, childPosition);
}

template <typename Derived, typename StoragePrecision, typename ComputePrecision>
INLINE_METHOD GPU_CALLABLE_METHOD void
exahype2::dg::limiting::SubgridTransfer<Derived, StoragePrecision, ComputePrecision>::restrictFromChildren(
  const int* const        childSlots,
  StoragePrecision* const target
) const {
  StoragePrecision        projections[peano4::ChildrenPerCell][Kernel::SubcellValuesPerCell];
  const StoragePrecision* children[peano4::ChildrenPerCell];
  for (int child = 0; child < peano4::ChildrenPerCell; child++) {
    children[child] = getSubgrid(childSlots[child], projections[child]);
  }
  Kernel::Subgrid::restrictPatch(children, target);
}

/**
 * Returns the subgrid of a cell on the subcell scheme. Every other cell writes the projection of
 * its nodes into projection and returns projection.
 */
template <typename Derived, typename StoragePrecision, typename ComputePrecision>
INLINE_METHOD GPU_CALLABLE_METHOD const StoragePrecision*
exahype2::dg::limiting::SubgridTransfer<Derived, StoragePrecision, ComputePrecision>::getSubgrid(
  const int               slot,
  StoragePrecision* const projection
) const {
  const auto status = static_cast<exahype2::dg::limiting::LimiterStatus>(
    statuses.getChunk(slot)[static_cast<int>(exahype2::dg::limiting::StatusEntry::Status)]
  );
  if (exahype2::dg::limiting::runsSubcellScheme(status)) {
    return subcells.getChunk(slot);
  }
  Kernel::projectNodesOntoSubcells(nodes.getChunk(slot), projection, nodesToSubcells);
  return projection;
}
TARGET_DECLARE_END
