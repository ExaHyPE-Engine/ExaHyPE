#include "exahype2/dg/limiting/LimiterStatus.h"
#include "exahype2/fv/Kernels.h"
#include "exahype2/terms/PhysicalAdmissibility.h"
#include "peano4/Loop.h"
#include "tarch/Assertions.h"
#include "tarch/accelerator/Scratch.h"

/**
 * Returns the threads per team of a launch that asks for one thread per subcell of a cell.
 */
template <typename Derived, typename ComputePrecision>
INLINE_METHOD int
exahype2::dg::limiting::SubcellScheme<Derived, ComputePrecision>::getTeamThreads() {
  return tarch::accelerator::getTeamThreads(SubcellsPerCell);
}

TARGET_DECLARE
template <typename Derived, typename ComputePrecision>
template <typename StoragePrecision>
INLINE_METHOD void
exahype2::dg::limiting::SubcellScheme<Derived, ComputePrecision>::sampleInitialCondition(
  StoragePrecision* NOALIAS const              subcells,
  const tarch::la::Vector<DIMENSIONS, double>& cellCentre,
  const tarch::la::Vector<DIMENSIONS, double>& cellSize,
  const typename Derived::RuntimeParameters&   parameters
) {
  forEachSubcell(
    cellCentre,
    cellSize,
    subcells,
    [&parameters](
      StoragePrecision* const                      values,
      const tarch::la::Vector<DIMENSIONS, double>& x,
      const tarch::la::Vector<DIMENSIONS, double>& h
    ) { Derived::initialCondition(values, x, h, parameters); }
  );
}

/**
 * Averages the nodal polynomial of a cell onto its subcells. The projection applies nodesToSubcells
 * along every axis. nodesToSubcells is its own mirror image.
 */
template <typename Derived, typename ComputePrecision>
template <typename StoragePrecision>
INLINE_METHOD GPU_CALLABLE_METHOD void
exahype2::dg::limiting::SubcellScheme<Derived, ComputePrecision>::projectNodesOntoSubcells(
  const StoragePrecision* NOALIAS const nodes,
  StoragePrecision* NOALIAS const       subcells,
  const StoragePrecision* NOALIAS const nodesToSubcells
) {
  ASSERTION(nodes != nullptr);
  ASSERTION(subcells != nullptr);
  ASSERTION(nodesToSubcells != nullptr);
  exahype2::dg::projectTensorProduct<
    DIMENSIONS,
    NodesPerAxis,
    SubcellsPerAxis,
    NumberOfData,
    exahype2::dg::ProjectionRule::Butterfly
  >(nodes, subcells, nodesToSubcells);
}

/**
 * Writes the projection of projectNodesOntoSubcells() into subcells. The threads of team divide the
 * values of the lines of every projection stage among themselves. scratch provides
 * SubcellProjectionScratchValues values.
 */
template <typename Derived, typename ComputePrecision>
template <typename StoragePrecision>
INLINE_METHOD GPU_CALLABLE_METHOD void
exahype2::dg::limiting::SubcellScheme<Derived, ComputePrecision>::projectNodesOntoSubcellsInTeam(
  const tarch::accelerator::TeamHandle  team,
  const StoragePrecision* NOALIAS const nodes,
  StoragePrecision* NOALIAS const       subcells,
  const StoragePrecision* NOALIAS const nodesToSubcells,
  StoragePrecision* NOALIAS const       scratch
) {
  const int  thread  = tarch::accelerator::getThreadOfTeam(team);
  const int  threads = tarch::accelerator::getNumberOfThreadsPerTeam(team);
  const auto weights = exahype2::dg::getProjectionWeightsOfDofPairs<NodesPerAxis, SubcellsPerAxis>(nodesToSubcells);
  for (int stage = 0; stage < exahype2::dg::getStagesOfTensorProduct<DIMENSIONS>(); stage++) {
    projectNodesOntoSubcells(nodes, subcells, nodesToSubcells, weights, scratch, stage, thread, threads);
    tarch::accelerator::teamBarrier(team);
  }
}

/**
 * Writes the subgrid onto the halo halves. A cell that ran the Galerkin scheme in the previous step
 * first projects its previous solution onto the subgrid. In the first step, every subgrid stores
 * the sampled initial condition.
 */
template <typename Derived, typename ComputePrecision>
template <typename StoragePrecision>
INLINE_METHOD GPU_CALLABLE_METHOD void
exahype2::dg::limiting::SubcellScheme<Derived, ComputePrecision>::projectSubgridOntoFaces(
  const int* NOALIAS const              status,
  StoragePrecision* NOALIAS const       subcells,
  const StoragePrecision* NOALIAS const previousSolution,
  StoragePrecision* const               haloHalves[peano4::FacesPerCell],
  const StoragePrecision* NOALIAS const nodesToSubcells,
  const bool                            subcellsStoreInitialCondition
) {
  const auto previousStatus = static_cast<exahype2::dg::limiting::LimiterStatus>(
    status[static_cast<int>(exahype2::dg::limiting::StatusEntry::PreviousStatus)]
  );
  if (not exahype2::dg::limiting::runsSubcellScheme(previousStatus) and not subcellsStoreInitialCondition) {
    projectNodesOntoSubcells(previousSolution, subcells, nodesToSubcells);
  }
  Subgrid::projectOntoFaces(subcells, haloHalves);
}

/**
 * Runs projectSubgridOntoFaces() on a host thread and projectSubgridOntoFacesWithThreadsOfTeam() on
 * a device.
 */
template <typename Derived, typename ComputePrecision>
template <typename StoragePrecision>
INLINE_METHOD GPU_CALLABLE_METHOD void
exahype2::dg::limiting::SubcellScheme<Derived, ComputePrecision>::projectSubgridOntoFacesInTeam(
  [[maybe_unused]] const tarch::accelerator::TeamHandle team,
  const int* NOALIAS const                              status,
  StoragePrecision* NOALIAS const                       subcells,
  const StoragePrecision* NOALIAS const                 previousSolution,
  StoragePrecision* const                               haloHalves[peano4::FacesPerCell],
  const StoragePrecision* NOALIAS const                 nodesToSubcells,
  const bool                                            subcellsStoreInitialCondition,
  [[maybe_unused]] StoragePrecision* NOALIAS const      scratch
) {
  COMPILE_IF_ON_HOST(projectSubgridOntoFaces(
                       status,
                       subcells,
                       previousSolution,
                       haloHalves,
                       nodesToSubcells,
                       subcellsStoreInitialCondition
  );)
  COMPILE_IF_ON_DEVICE(projectSubgridOntoFacesWithThreadsOfTeam(
                         team,
                         status,
                         subcells,
                         previousSolution,
                         haloHalves,
                         nodesToSubcells,
                         subcellsStoreInitialCondition,
                         scratch
  );)
}

/**
 * Runs projectSubgridOntoFaces() with the threads of team. The threads divide the values of the
 * lines of every projection stage and the values of the face layers among themselves. scratch
 * provides SubcellProjectionScratchValues values.
 */
template <typename Derived, typename ComputePrecision>
template <typename StoragePrecision>
INLINE_METHOD GPU_CALLABLE_METHOD void
exahype2::dg::limiting::SubcellScheme<Derived, ComputePrecision>::projectSubgridOntoFacesWithThreadsOfTeam(
  const tarch::accelerator::TeamHandle  team,
  const int* NOALIAS const              status,
  StoragePrecision* NOALIAS const       subcells,
  const StoragePrecision* NOALIAS const previousSolution,
  StoragePrecision* const               haloHalves[peano4::FacesPerCell],
  const StoragePrecision* NOALIAS const nodesToSubcells,
  const bool                            subcellsStoreInitialCondition,
  StoragePrecision* NOALIAS const       scratch
) {
  const auto previousStatus = static_cast<exahype2::dg::limiting::LimiterStatus>(
    status[static_cast<int>(exahype2::dg::limiting::StatusEntry::PreviousStatus)]
  );
  if (not exahype2::dg::limiting::runsSubcellScheme(previousStatus) and not subcellsStoreInitialCondition) {
    projectNodesOntoSubcellsInTeam(team, previousSolution, subcells, nodesToSubcells, scratch);
  }
  Subgrid::projectOntoFacesInTeam(team, subcells, haloHalves);
}

/**
 * Projects the advanced subgrid onto the nodes and returns its wave speeds, or empty maxima with a
 * fixed time step rule.
 */
template <typename Derived, typename ComputePrecision>
template <typename StoragePrecision>
INLINE_METHOD GPU_CALLABLE_METHOD exahype2::dg::MaxEigenvalueStatistics
exahype2::dg::limiting::SubcellScheme<Derived, ComputePrecision>::projectRecomputedSubgrid(
  StoragePrecision* NOALIAS const              nodes,
  const StoragePrecision* NOALIAS const        subcells,
  const StoragePrecision* NOALIAS const        subcellsToNodes,
  const tarch::la::Vector<DIMENSIONS, double>& cellCentre,
  const tarch::la::Vector<DIMENSIONS, double>& cellSize,
  const double                                 timeStamp,
  const double                                 timeStepSize,
  const typename Derived::RuntimeParameters&   parameters
) {
  projectSubcellsOntoNodes(subcells, nodes, subcellsToNodes);
  if constexpr (ReportEigenvalues) {
    return reduceMaxEigenvalues(subcells, cellCentre, cellSize, timeStamp + timeStepSize, timeStepSize, parameters);
  } else {
    return exahype2::dg::MaxEigenvalueStatistics{};
  }
}

/**
 * Runs projectRecomputedSubgrid() on a host thread. On a device the threads of the team divide the
 * lines of the projection stages in scratch, which provides NodeProjectionScratchValues values,
 * and the subcells of the cell among themselves. Every thread returns the wave speeds of its
 * subcells.
 */
template <typename Derived, typename ComputePrecision>
template <typename StoragePrecision>
INLINE_METHOD GPU_CALLABLE_METHOD exahype2::dg::MaxEigenvalueStatistics
exahype2::dg::limiting::SubcellScheme<Derived, ComputePrecision>::projectRecomputedSubgridInTeam(
  [[maybe_unused]] const tarch::accelerator::TeamHandle team,
  StoragePrecision* NOALIAS const                       nodes,
  const StoragePrecision* NOALIAS const                 subcells,
  const StoragePrecision* NOALIAS const                 subcellsToNodes,
  const tarch::la::Vector<DIMENSIONS, double>&          cellCentre,
  const tarch::la::Vector<DIMENSIONS, double>&          cellSize,
  const double                                          timeStamp,
  const double                                          timeStepSize,
  [[maybe_unused]] StoragePrecision* NOALIAS const      scratch,
  const typename Derived::RuntimeParameters&            parameters
) {
  exahype2::dg::MaxEigenvalueStatistics statistics;
  COMPILE_IF_ON_HOST(
    statistics = projectRecomputedSubgrid(
      nodes,
      subcells,
      subcellsToNodes,
      cellCentre,
      cellSize,
      timeStamp,
      timeStepSize,
      parameters
    );
  )
  COMPILE_IF_ON_DEVICE(
    const int thread  = tarch::accelerator::getThreadOfTeam(team);
    const int threads = tarch::accelerator::getNumberOfThreadsPerTeam(team);
    projectSubcellsOntoNodesInTeam(team, subcells, nodes, subcellsToNodes, scratch);
    if constexpr (ReportEigenvalues) {
      for (int subcell = thread; subcell < SubcellsPerCell; subcell += threads) {
        statistics = exahype2::dg::MaxEigenvalueStatistics::combine(
          statistics,
          reduceMaxEigenvaluesOfSubcell(
            subcells,
            subcell,
            cellCentre,
            cellSize,
            timeStamp + timeStepSize,
            timeStepSize,
            parameters
          )
        );
      }
    }
  )
  return statistics;
}

/**
 * Returns the physical and scaled wave speeds of one subcell of a cell.
 */
template <typename Derived, typename ComputePrecision>
template <typename StoragePrecision>
INLINE_METHOD GPU_CALLABLE_METHOD exahype2::dg::MaxEigenvalueStatistics
exahype2::dg::limiting::SubcellScheme<Derived, ComputePrecision>::reduceMaxEigenvaluesOfSubcell(
  const StoragePrecision* NOALIAS const        subcells,
  const int                                    subcell,
  const tarch::la::Vector<DIMENSIONS, double>& cellCentre,
  const tarch::la::Vector<DIMENSIONS, double>& cellSize,
  const double                                 timeStamp,
  const double                                 timeStepSize,
  const typename Derived::RuntimeParameters&   parameters
) {
  ASSERTION(subcell >= 0 and subcell < SubcellsPerCell, subcell);
  tarch::la::Vector<DIMENSIONS, int> index;
  int                                remainder = subcell;
  for (int axis = 0; axis < DIMENSIONS; axis++) {
    index(axis) = remainder % SubcellsPerAxis;
    remainder /= SubcellsPerAxis;
  }
  const auto subcellSize   = exahype2::fv::getVolumeSize(cellSize, SubcellsPerAxis);
  const auto subcellCentre = exahype2::fv::getVolumeCentre(cellCentre, cellSize, SubcellsPerAxis, index);
  const StoragePrecision* const         values = subcells + static_cast<std::ptrdiff_t>(subcell) * NumberOfData;
  exahype2::dg::MaxEigenvalueStatistics result;
  result.template accumulate<DIMENSIONS>(cellSize, [&](const int normal) {
    return Derived::maxEigenvalue(values, subcellCentre, subcellSize, timeStamp, timeStepSize, normal, parameters);
  });
  return result;
}

/**
 * Returns the physical and scaled wave-speed maxima over the subcells of a cell. The scaled wave
 * speeds divide by the cell extents. They bound the same time step as the nodal maxima.
 */
template <typename Derived, typename ComputePrecision>
template <typename StoragePrecision>
INLINE_METHOD GPU_CALLABLE_METHOD exahype2::dg::MaxEigenvalueStatistics
exahype2::dg::limiting::SubcellScheme<Derived, ComputePrecision>::reduceMaxEigenvalues(
  const StoragePrecision* NOALIAS const        subcells,
  const tarch::la::Vector<DIMENSIONS, double>& cellCentre,
  const tarch::la::Vector<DIMENSIONS, double>& cellSize,
  const double                                 timeStamp,
  const double                                 timeStepSize,
  const typename Derived::RuntimeParameters&   parameters
) {
  ASSERTION(subcells != nullptr);
  exahype2::dg::MaxEigenvalueStatistics result;
  forEachSubcell(
    cellCentre,
    cellSize,
    subcells,
    [&](
      const StoragePrecision* const                values,
      const tarch::la::Vector<DIMENSIONS, double>& x,
      const tarch::la::Vector<DIMENSIONS, double>& h
    ) {
      result.template accumulate<DIMENSIONS>(cellSize, [&](const int normal) {
        return Derived::maxEigenvalue(values, x, h, timeStamp, timeStepSize, normal, parameters);
      });
    }
  );
  return result;
}

/**
 * Calls functor(values, x, h) for every subcell in linearised order. x is the centre of the
 * subcell. h is its size.
 */
template <typename Derived, typename ComputePrecision>
template <typename Value, typename Functor>
INLINE_METHOD constexpr void
exahype2::dg::limiting::SubcellScheme<Derived, ComputePrecision>::forEachSubcell(
  const tarch::la::Vector<DIMENSIONS, double>& cellCentre,
  const tarch::la::Vector<DIMENSIONS, double>& cellSize,
  Value* const                                 values,
  Functor&&                                    functor
) {
  ASSERTION(values != nullptr);
  const auto subcellSize = exahype2::fv::getVolumeSize(cellSize, SubcellsPerAxis);
  for (int axis = 0; axis < DIMENSIONS; axis++) {
    ASSERTION(subcellSize(axis) > 0.0, subcellSize, axis);
  }
  peano4::dForEach(SubcellsPerAxis, [&](const tarch::la::Vector<DIMENSIONS, int>& subcell) {
    const int  index         = peano4::dLinearised(subcell, SubcellsPerAxis);
    const auto subcellCentre = exahype2::fv::getVolumeCentre(cellCentre, cellSize, SubcellsPerAxis, subcell);
    functor(values + static_cast<std::ptrdiff_t>(index) * NumberOfData, subcellCentre, subcellSize);
  });
}

/**
 * Projects the subcell averages of a cell back onto its nodes. The projection applies
 * subcellsToNodes along every axis. subcellsToNodes is its own mirror image.
 */
template <typename Derived, typename ComputePrecision>
template <typename StoragePrecision>
INLINE_METHOD GPU_CALLABLE_METHOD void
exahype2::dg::limiting::SubcellScheme<Derived, ComputePrecision>::projectSubcellsOntoNodes(
  const StoragePrecision* NOALIAS const subcells,
  StoragePrecision* NOALIAS const       nodes,
  const StoragePrecision* NOALIAS const subcellsToNodes
) {
  ASSERTION(subcells != nullptr);
  ASSERTION(nodes != nullptr);
  ASSERTION(subcellsToNodes != nullptr);
  exahype2::dg::projectTensorProduct<
    DIMENSIONS,
    SubcellsPerAxis,
    NodesPerAxis,
    NumberOfData,
    exahype2::dg::ProjectionRule::Butterfly
  >(subcells, nodes, subcellsToNodes);
}

/**
 * Writes the projection of projectSubcellsOntoNodes() into nodes. The threads of team divide the
 * values of the lines of every projection stage among themselves. scratch provides
 * NodeProjectionScratchValues values.
 */
template <typename Derived, typename ComputePrecision>
template <typename StoragePrecision>
INLINE_METHOD GPU_CALLABLE_METHOD void
exahype2::dg::limiting::SubcellScheme<Derived, ComputePrecision>::projectSubcellsOntoNodesInTeam(
  const tarch::accelerator::TeamHandle  team,
  const StoragePrecision* NOALIAS const subcells,
  StoragePrecision* NOALIAS const       nodes,
  const StoragePrecision* NOALIAS const subcellsToNodes,
  StoragePrecision* NOALIAS const       scratch
) {
  const int  thread  = tarch::accelerator::getThreadOfTeam(team);
  const int  threads = tarch::accelerator::getNumberOfThreadsPerTeam(team);
  const auto weights = exahype2::dg::getProjectionWeightsOfDofPairs<SubcellsPerAxis, NodesPerAxis>(subcellsToNodes);
  for (int stage = 0; stage < exahype2::dg::getStagesOfTensorProduct<DIMENSIONS>(); stage++) {
    projectSubcellsOntoNodes(subcells, nodes, subcellsToNodes, weights, scratch, stage, thread, threads);
    tarch::accelerator::teamBarrier(team);
  }
}

/**
 * Runs stage of projectSubcellsOntoNodes() for the values firstItem, firstItem + itemStride and so
 * on of the lines of every projection. weights contains the pair weights of subcellsToNodes. The
 * stages before it have written their values into scratch.
 */
template <typename Derived, typename ComputePrecision>
template <typename StoragePrecision>
INLINE_METHOD GPU_CALLABLE_METHOD void
exahype2::dg::limiting::SubcellScheme<Derived, ComputePrecision>::projectSubcellsOntoNodes(
  const StoragePrecision* NOALIAS const                                                             subcells,
  StoragePrecision* NOALIAS const                                                                   nodes,
  const StoragePrecision* NOALIAS const                                                             subcellsToNodes,
  const exahype2::dg::ProjectionWeightsOfDofPairs<SubcellsPerAxis, NodesPerAxis, StoragePrecision>& weights,
  StoragePrecision* NOALIAS const                                                                   scratch,
  const int                                                                                         stage,
  const int                                                                                         firstItem,
  const int                                                                                         itemStride
) {
  ASSERTION(subcells != nullptr);
  ASSERTION(nodes != nullptr);
  ASSERTION(subcellsToNodes != nullptr);
  ASSERTION(scratch != nullptr);
  exahype2::dg::projectTensorProductStage<
    DIMENSIONS,
    SubcellsPerAxis,
    NodesPerAxis,
    NumberOfData,
    exahype2::dg::ProjectionRule::Butterfly,
    exahype2::dg::ProjectionItem::ValueOfLine
  >(stage, subcells, nodes, subcellsToNodes, weights, scratch, firstItem, itemStride);
}

/**
 * Runs stage of projectNodesOntoSubcells() for the values firstItem, firstItem + itemStride and so
 * on of the lines of every projection. weights contains the pair weights of nodesToSubcells. The
 * stages before it have written their values into scratch.
 */
template <typename Derived, typename ComputePrecision>
template <typename StoragePrecision>
INLINE_METHOD GPU_CALLABLE_METHOD void
exahype2::dg::limiting::SubcellScheme<Derived, ComputePrecision>::projectNodesOntoSubcells(
  const StoragePrecision* NOALIAS const                                                             nodes,
  StoragePrecision* NOALIAS const                                                                   subcells,
  const StoragePrecision* NOALIAS const                                                             nodesToSubcells,
  const exahype2::dg::ProjectionWeightsOfDofPairs<NodesPerAxis, SubcellsPerAxis, StoragePrecision>& weights,
  StoragePrecision* NOALIAS const                                                                   scratch,
  const int                                                                                         stage,
  const int                                                                                         firstItem,
  const int                                                                                         itemStride
) {
  ASSERTION(nodes != nullptr);
  ASSERTION(subcells != nullptr);
  ASSERTION(nodesToSubcells != nullptr);
  ASSERTION(scratch != nullptr);
  exahype2::dg::projectTensorProductStage<
    DIMENSIONS,
    NodesPerAxis,
    SubcellsPerAxis,
    NumberOfData,
    exahype2::dg::ProjectionRule::Butterfly,
    exahype2::dg::ProjectionItem::ValueOfLine
  >(stage, nodes, subcells, nodesToSubcells, weights, scratch, firstItem, itemStride);
}

template <typename Derived, typename ComputePrecision>
template <typename Reconstruct>
template <typename Precision>
INLINE_METHOD GPU_CALLABLE_METHOD void
exahype2::dg::limiting::SubcellScheme<Derived, ComputePrecision>::SubgridSolver<Reconstruct>::flux(
  const Precision* const                       Q,
  const tarch::la::Vector<DIMENSIONS, double>& x,
  const tarch::la::Vector<DIMENSIONS, double>& h,
  const double                                 t,
  const double                                 dt,
  const int                                    normal,
  Precision* const                             F,
  const RuntimeParameters&                     parameters
)
  requires exahype2::terms::HasFlux<Derived, Precision>
{
  Derived::flux(Q, x, h, t, dt, normal, F, parameters);
}

template <typename Derived, typename ComputePrecision>
template <typename Reconstruct>
template <typename Precision>
INLINE_METHOD GPU_CALLABLE_METHOD void
exahype2::dg::limiting::SubcellScheme<Derived, ComputePrecision>::SubgridSolver<Reconstruct>::nonconservativeProduct(
  const Precision* const                       Q,
  const Precision* const                       deltaQ,
  const tarch::la::Vector<DIMENSIONS, double>& x,
  const tarch::la::Vector<DIMENSIONS, double>& h,
  const double                                 t,
  const double                                 dt,
  const int                                    normal,
  Precision* const                             BTimesDeltaQ,
  const RuntimeParameters&                     parameters
)
  requires exahype2::terms::HasNonconservativeProduct<Derived, Precision>
{
  Derived::nonconservativeProduct(Q, deltaQ, x, h, t, dt, normal, BTimesDeltaQ, parameters);
}

template <typename Derived, typename ComputePrecision>
