INLINE_METHOD GPU_CALLABLE_METHOD double
exahype2::dg::limiting::SubcellScheme<Derived, ComputePrecision>::SubgridSolver<Reconstruct>::maxEigenvalue(
  const Precision* const                       Q,
  const tarch::la::Vector<DIMENSIONS, double>& x,
