}

template <typename Derived, typename StoragePrecision, typename ComputePrecision>
INLINE_METHOD GPU_CALLABLE_METHOD void
exahype2::dg::limiting::ProjectSubgridsOntoFaces<Derived, StoragePrecision, ComputePrecision>::operator()(
  const int                            entry,
  const tarch::accelerator::TeamHandle team
) const {
  const int         slot = cells[entry];
  StoragePrecision* haloHalves[peano4::FacesPerCell];
  for (int faceNumber = 0; faceNumber < peano4::FacesPerCell; faceNumber++) {
    haloHalves[faceNumber] = halo.getChunk(cellConnectivity.getCellFace(slot, faceNumber));
  }
  Kernel::projectSubgridOntoFacesInTeam(
    team,
    statuses.getChunk(slot),
    subcells.getChunk(slot),
    previousSolution.getChunk(slot),
    haloHalves,
    nodesToSubcells,
    subcellsStoreInitialCondition,
    scratch
      + static_cast<std::ptrdiff_t>(tarch::accelerator::getScratchChunk(entry)) * Kernel::ScratchValuesPerRecomputedCell
  );
}

template <typename Derived, typename StoragePrecision, typename ComputePrecision>
INLINE_METHOD GPU_CALLABLE_METHOD void
exahype2::dg::limiting::ApplySubgridBoundaryConditions<Derived, StoragePrecision, ComputePrecision>::operator()(
  const int entry
) const {
  ASSERTION(
    entry >= 0 and entry < boundaryConditions.boundaryFaces.size * Kernel::Subgrid::VolumesPerLayer,
    entry,
    boundaryConditions.boundaryFaces.size
  );
  const int  face      = boundaryConditions.boundaryFaces[entry / Kernel::Subgrid::VolumesPerLayer];
  const int  lowerCell = boundaryConditions.cellConnectivity.getFaceCell(face, 0);
  const int  slot      = lowerCell >= 0 ? lowerCell : boundaryConditions.cellConnectivity.getFaceCell(face, 1);
  const auto status    = static_cast<exahype2::dg::limiting::LimiterStatus>(
    statuses.getChunk(slot)[static_cast<int>(exahype2::dg::limiting::StatusEntry::Status)]
  );
  if (status != exahype2::dg::limiting::LimiterStatus::Regular) {
    boundaryConditions(entry);
  }
}

template <typename Derived, typename StoragePrecision, typename ComputePrecision>
INLINE_METHOD GPU_CALLABLE_METHOD void
exahype2::dg::limiting::RecomputeSubcells<Derived, StoragePrecision, ComputePrecision>::operator()(
  const int                                             entry,
  [[maybe_unused]] const tarch::accelerator::TeamHandle team,
  exahype2::dg::MaxEigenvalueStatistics&                accumulator
) const {
  const int               slot = cells[entry];
  const StoragePrecision* haloHalves[peano4::FacesPerCell];
  for (int faceNumber = 0; faceNumber < peano4::FacesPerCell; faceNumber++) {
    haloHalves[faceNumber] = halo.getChunk(cellConnectivity.getCellFace(slot, faceNumber));
  }
  StoragePrecision* const evolvedSubcells = scratch
    + static_cast<std::ptrdiff_t>(tarch::accelerator::getScratchChunk(entry)) * Kernel::ScratchValuesPerRecomputedCell;
  const tarch::la::Vector<DIMENSIONS, double> centre     = cellConnectivity.getCellCentre(slot);
  const tarch::la::Vector<DIMENSIONS, double> width      = cellConnectivity.getCellWidth(slot);
  const exahype2::dg::MaxEigenvalueStatistics statistics = Kernel::recomputeInTeam(
    team,
    nodes.getChunk(slot),
    subcells.getChunk(slot),
    evolvedSubcells,
    haloHalves,
    subcellsToNodes,
    centre,
    width,
    exahype2::fv::getBoundaryFaceMask(cellConnectivity, slot),
    timeStamp,
    timeStepSize
  );
  COMPILE_IF_ON_HOST(accumulator = exahype2::dg::MaxEigenvalueStatistics::combine(accumulator, statistics);)
  COMPILE_IF_ON_DEVICE(
    tarch::accelerator::reduceOverTeam(
      team,
      statistics,
      tarch::accelerator::Custom<exahype2::dg::MaxEigenvalueStatistics>{accumulator}
    );
  )
}

template <typename Derived, typename StoragePrecision, typename ComputePrecision>
INLINE_METHOD GPU_CALLABLE_METHOD void
exahype2::dg::limiting::ProjectNodesOntoSubgrids<Derived, StoragePrecision, ComputePrecision>::operator()(
  const int                            entry,
  const tarch::accelerator::TeamHandle team
) const {
  ASSERTION(numberOfTeams > 0, numberOfTeams);
  ASSERTION(entry >= 0 and entry < numberOfTeams, entry, numberOfTeams);
  StoragePrecision* const chunk = scratch
    + static_cast<std::ptrdiff_t>(tarch::accelerator::getScratchChunk(entry)) * Kernel::SubcellProjectionScratchValues;
  for (int cell = entry; cell < cells.size; cell += numberOfTeams) {
    const int  slot   = cells[cell];
    const auto status = static_cast<exahype2::dg::limiting::LimiterStatus>(
      statuses.getChunk(slot)[static_cast<int>(exahype2::dg::limiting::StatusEntry::Status)]
    );
    if (not exahype2::dg::limiting::runsSubcellScheme(status)) {
      Kernel::projectNodesOntoSubcellsInTeam(
        team,
        nodes.getChunk(slot),
        subcells.getChunk(slot),
        nodesToSubcells,
        chunk
      );
    }
  }
}
TARGET_DECLARE_END
