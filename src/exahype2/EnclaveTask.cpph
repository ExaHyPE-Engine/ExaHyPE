template <typename T, int NumFaceTypes>
exahype2::EnclaveTask<T, NumFaceTypes>::EnclaveTask(
  int                                         enclaveTaskTypeId,
  const peano4::datamanagement::CellMarker&   marker,
  double                                      t,
  double                                      dt,
  T* NOALIAS const                            QIn,
  T* NOALIAS const                            faces[NumFaceTypes][TwoTimesD],
  T* NOALIAS const                            QOut,
  Functor                                     functor
):
  tarch::multicore::Task(enclaveTaskTypeId, tarch::multicore::Task::DefaultPriority),
  _marker(marker),
  _t(t),
  _dt(dt),
  _QIn(QIn),
  _faces{},
  _QOut(QOut),
  _functor(functor) {
  assertion(_QIn != nullptr);
  assertion(_QOut != nullptr);

  for (int type = 0; type < NumFaceTypes; ++type) {
    for (int d = 0; d < TwoTimesD; ++d) {
      _faces[type][d] = faces[type][d];
    }
  }
}

template <typename T, int NumFaceTypes>
bool exahype2::EnclaveTask<T, NumFaceTypes>::run() {
  assertion(_QIn != nullptr);
  assertion(_QOut != nullptr);

  _functor();
  return false;
}
