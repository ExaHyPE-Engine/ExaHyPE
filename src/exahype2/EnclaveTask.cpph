template <typename T>
exahype2::EnclaveTask<T>::EnclaveTask(
  int                                         enclaveTaskTypeId,
  const peano4::datamanagement::CellMarker&   marker,
  double                                      t,
  double                                      dt,
  /*const*/ T* __restrict__ const             QIn,
  T* __restrict__ const                       QOut,
  Functor                                     functor
):
  tarch::multicore::Task(enclaveTaskTypeId, tarch::multicore::Task::DefaultPriority),
  _marker(marker),
  _t(t),
  _dt(dt),
  _QIn(QIn),
  _QOut(QOut),
  _functor(functor) {
  assertion(_QIn != nullptr);
  assertion(_QOut != nullptr);
}

template <typename T>
bool exahype2::EnclaveTask<T>::run() {
  _functor();
  return false;
}
