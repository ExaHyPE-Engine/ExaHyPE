template <typename T>
exahype2::EnclaveTask<T>::EnclaveTask(
  int                                         enclaveTaskTypeId,
  const peano4::datamanagement::CellMarker&   marker,
  double                                      t,
  double                                      dt,
  T* NOALIAS const                            QIn,
  T* NOALIAS const                            faces[TwoTimesD],
  T* NOALIAS const                            QOut,
  Functor                                     functor
):
  tarch::multicore::Task(enclaveTaskTypeId, tarch::multicore::Task::DefaultPriority),
  _marker(marker),
  _t(t),
  _dt(dt),
  _QIn(QIn),
  _faces{},
  _QOut(QOut),
  _functor(functor) {
  assertion(_QIn != nullptr);
  assertion(_QOut != nullptr);

  for (int i = 0; i < TwoTimesD; ++i) {
    _faces[i] = faces[i];
  }
}

template <typename T>
bool exahype2::EnclaveTask<T>::run() {
  _functor();
  return false;
}
