template <typename... Solvers>
INLINE_METHOD void exahype2::SolverRepository<Solvers...>::suspendSolversForOneGridSweep() {
  forEachSolver([](auto& solver) { solver.suspendSolversForOneGridSweep(); });
}

template <typename... Solvers>
INLINE_METHOD void exahype2::SolverRepository<Solvers...>::startSimulation() {
