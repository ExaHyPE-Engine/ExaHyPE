#include "peano4/Partition.h"
#include "tarch/Assertions.h"
#include "tarch/mpi/ReductionRecord.h"

template <typename... Solvers>
INLINE_METHOD exahype2::SolverRepository<Solvers...>::SolverRepository(Solvers&... solvers) :
  _solvers{solvers...} {}

template <typename... Solvers>
template <typename Operation>
INLINE_METHOD void
exahype2::SolverRepository<Solvers...>::forEachSolver(const Operation& operation) {
  std::apply([&operation](Solvers&... solvers) { (operation(solvers), ...); }, _solvers);
}

template <typename... Solvers>
template <typename Operation>
INLINE_METHOD void
exahype2::SolverRepository<Solvers...>::forEachSolver(const Operation& operation) const {
  std::apply([&operation](const Solvers&... solvers) { (operation(solvers), ...); }, _solvers);
}

template <typename... Solvers>
INLINE_METHOD double
exahype2::SolverRepository<Solvers...>::getMinTimeStamp() const {
  double result = std::numeric_limits<double>::max();
  forEachSolver([&result](const auto& solver) { result = std::min(result, solver.getTimeStepping().getTimeStamp()); });
  return result;
}

template <typename... Solvers>
INLINE_METHOD double
exahype2::SolverRepository<Solvers...>::getMaxTimeStamp() const {
  double result = 0.0;
  forEachSolver([&result](const auto& solver) { result = std::max(result, solver.getTimeStepping().getTimeStamp()); });
  return result;
}

template <typename... Solvers>
template <typename Solver>
INLINE_METHOD int
exahype2::SolverRepository<Solvers...>::getNumberOfCellsOf(const Solver& solver, const peano4::Partition& partition) {
  int numberOfCells = partition.getCells().size;
  if constexpr (requires { solver.getNumberOfCells(partition); }) {
    numberOfCells = solver.getNumberOfCells(partition);
  }
  assertion(numberOfCells >= 0, numberOfCells);
  return numberOfCells;
}

/**
 * Returns the number of cell updates of one time step of all solvers on this rank.
 */
template <typename... Solvers>
INLINE_METHOD std::uint64_t
exahype2::SolverRepository<Solvers...>::getNumberOfSolverCells(const peano4::Partition& partition) const {
  std::uint64_t result = 0;
  forEachSolver([&result, &partition](const auto& solver) {
    result += static_cast<std::uint64_t>(getNumberOfCellsOf(solver, partition));
  });
  return result;
}

template <typename... Solvers>
INLINE_METHOD std::uint64_t
exahype2::SolverRepository<Solvers...>::getNumberOfCellDoFs(const peano4::Partition& partition) const {
  std::uint64_t result = 0;
  forEachSolver([&result, &partition](const auto& solver) {
    const int numberOfDoFs = solver.getNumberOfDoFs();
    assertion(numberOfDoFs >= 0, numberOfDoFs);
    result +=
      static_cast<std::uint64_t>(getNumberOfCellsOf(solver, partition)) * static_cast<std::uint64_t>(numberOfDoFs);
  });
  return result;
}

template <typename... Solvers>
INLINE_METHOD void
exahype2::SolverRepository<Solvers...>::startSimulation() {
  forEachSolver([](auto& solver) { solver.startSimulation(); });
}

template <typename... Solvers>
INLINE_METHOD void
exahype2::SolverRepository<Solvers...>::finishSimulation() {
  forEachSolver([](auto& solver) {
    solver.finishSimulation();
    solver.release();
  });
}

template <typename... Solvers>
INLINE_METHOD void
exahype2::SolverRepository<Solvers...>::allocate(const peano4::Partition& partition) {
  forEachSolver([&partition](auto& solver) { solver.allocate(partition); });
}

template <typename... Solvers>
INLINE_METHOD tarch::AllocatedBytes
exahype2::SolverRepository<Solvers...>::getAllocatedBytes() const {
  tarch::AllocatedBytes result{};
  forEachSolver([&result](const auto& solver) { result += solver.getAllocatedBytes(); });
  return result;
}

/**
 * Gathers the requests of all ranks at once. The grid construction applies them in the same step.
 * Every rank calls this function collectively.
 */
template <typename... Solvers>
INLINE_METHOD void
exahype2::SolverRepository<Solvers...>::requestRefinementForGridConstruction(const peano4::Partition& partition) {
  _refinementRequests.clear(partition.getNumberOfSlots());
  forEachSolver([this, &partition](auto& solver) {
    solver.requestRefinementForGridConstruction(partition, _refinementRequests);
  });
  _requestsOfTheRun     = _refinementRequests.getRefinementRequests(partition);
  _localRequestsPending = false;
}

template <typename... Solvers>
INLINE_METHOD void
exahype2::SolverRepository<Solvers...>::initialise(const peano4::Partition& partition) {
  _refinementRequests.clear(partition.getNumberOfSlots());
  forEachSolver([this, &partition](auto& solver) { solver.initialise(partition, _refinementRequests); });
  commitRefinementRequests(partition);
}

template <typename... Solvers>
INLINE_METHOD void
exahype2::SolverRepository<Solvers...>::performTimeStep(const peano4::Partition& partition) {
  _refinementRequests.clear(partition.getNumberOfSlots());
  forEachSolver([this, &partition](auto& solver) { solver.performTimeStep(partition, _refinementRequests); });
  commitRefinementRequests(partition);
}

template <typename... Solvers>
INLINE_METHOD void
exahype2::SolverRepository<Solvers...>::regrid(const peano4::Partition& partition, const peano4::Regrid& regrid) {
  _refinementRequests.clear(partition.getNumberOfSlots());
  forEachSolver([this, &partition, &regrid](auto& solver) { solver.regrid(partition, regrid, _refinementRequests); });
  commitRefinementRequests(partition);
}

template <typename... Solvers>
INLINE_METHOD void
exahype2::SolverRepository<Solvers...>::plot(
  const peano4::Partition&     partition,
  const tarch::plotter::Format format,
  const std::string&           outputDirectory
) {
  forEachSolver([&partition, format, &outputDirectory](auto& solver) {
    solver.plot(partition, format, outputDirectory);
  });
}

template <typename... Solvers>
INLINE_METHOD const std::vector<peano4::RefinementRequest>&
exahype2::SolverRepository<Solvers...>::getRefinementRequests() const {
  return _requestsOfTheRun;
}

/**
 * Collects the refinement requests of this rank. readValuesFromGlobalReduction() gathers them over
 * all ranks.
 */
template <typename... Solvers>
INLINE_METHOD void
exahype2::SolverRepository<Solvers...>::commitRefinementRequests(const peano4::Partition& partition) {
  _localRequests        = _refinementRequests.getLocalRefinementRequests(partition);
  _localRequestsPending = true;
}

/**
 * Adds the values of every solver and the number of committed refinement requests of this rank to
 * record.
 */
template <typename... Solvers>
INLINE_METHOD void
exahype2::SolverRepository<Solvers...>::addLocalValuesToGlobalReduction(tarch::mpi::ReductionRecord& record) {
  forEachSolver([&record](auto& solver) { solver.addLocalValuesToGlobalReduction(record); });
  _numberOfRequestsSlot = record.addSum(_localRequestsPending ? _localRequests.size() : 0U);
}

/**
 * Passes the reduced values to every solver. The committed requests replace the requests of the
 * run. Only a step in which some rank requests a change gathers the requests over all ranks. Every
 * rank calls this function collectively.
 */
template <typename... Solvers>
INLINE_METHOD void
exahype2::SolverRepository<Solvers...>::readValuesFromGlobalReduction(const tarch::mpi::ReductionRecord& record) {
  forEachSolver([&record](auto& solver) { solver.readValuesFromGlobalReduction(record); });
  if (not _localRequestsPending) {
    return;
  }
  _localRequestsPending = false;
  if (record.getSum(_numberOfRequestsSlot) > 0) {
    _requestsOfTheRun = exahype2::RefinementRequests::gatherRefinementRequests(std::move(_localRequests));
  } else {
    _requestsOfTheRun.clear();
  }
  _localRequests.clear();
}
