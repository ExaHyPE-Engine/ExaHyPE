TARGET_DECLARE
INLINE_METHOD GPU_CALLABLE_METHOD bool exahype2::NonNegativeStatistics::hasObservation() const {
  const auto minimumBits = std::bit_cast<std::uint64_t>(minimum);
  const auto maximumBits = std::bit_cast<std::uint64_t>(maximum);
  return minimumBits != std::bit_cast<std::uint64_t>(std::numeric_limits<double>::infinity())
    or maximumBits != std::bit_cast<std::uint64_t>(0.0);
}

INLINE_METHOD GPU_CALLABLE_METHOD bool exahype2::NonNegativeStatistics::hasPhysicalValues() const {
  return isPhysicalValue(minimum) and isPhysicalValue(maximum);
}

INLINE_METHOD GPU_CALLABLE_METHOD bool exahype2::NonNegativeStatistics::hasInvalidObservation() const {
  return hasObservation() and not hasPhysicalValues();
}

/**
 * Returns the bits of the extremum that is not physical, or the identity of the minimum
 * reduction when the statistics hold no invalid observation.
 */
INLINE_METHOD GPU_CALLABLE_METHOD std::uint64_t exahype2::NonNegativeStatistics::
  invalidObservationBitsOrIdentity() const {
  if (not hasInvalidObservation()) {
    return std::numeric_limits<std::uint64_t>::max();
  }
  return std::bit_cast<std::uint64_t>(isPhysicalValue(minimum) ? maximum : minimum);
}

INLINE_METHOD GPU_CALLABLE_METHOD exahype2::NonNegativeStatistics exahype2::NonNegativeStatistics::accumulate(
  const exahype2::NonNegativeStatistics& currentStatistics,
  const double                           observedValue
) {
  const bool currentContainsInvalidObservation = currentStatistics.hasInvalidObservation();
  const bool observedValueIsPhysical           = isPhysicalValue(observedValue);
  if (currentContainsInvalidObservation) {
    return currentStatistics;
  }
  if (not observedValueIsPhysical) {
    return {observedValue, observedValue};
  }
  return {std::min(currentStatistics.minimum, observedValue), std::max(currentStatistics.maximum, observedValue)};
}

INLINE_METHOD GPU_CALLABLE_METHOD exahype2::NonNegativeStatistics exahype2::NonNegativeStatistics::
  fromInvalidObservationBits(const std::uint64_t invalidObservationBits) {
  const auto invalidObservation = std::bit_cast<double>(invalidObservationBits);
  return {invalidObservation, invalidObservation};
}

INLINE_METHOD GPU_CALLABLE_METHOD bool exahype2::NonNegativeStatistics::isPhysicalValue(const double value) {
  return value >= 0.0 and std::isfinite(value);
}
TARGET_DECLARE_END
