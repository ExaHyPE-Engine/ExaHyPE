#include "tarch/Assertions.h"
#include "tarch/mpi/Collectives.h"
#include "tarch/mpi/Rank.h"

#include <mpi.h>

/**
 * Returns whether the database takes a snapshot of some particle of the rank at timeStamp. A time
 * stamp outside the closed window between initialRecordTime and lastRecordTime takes none.
 */
template <int NumberOfData>
INLINE_METHOD bool
exahype2::particles::isSnapshotDue(
  const ParticleSet<NumberOfData>& particles,
  const double                     timeStamp,
  const double                     initialRecordTime,
  const double                     lastRecordTime,
  TrajectoryDatabase&              database
) {
  assertion(initialRecordTime <= lastRecordTime, initialRecordTime, lastRecordTime);
  if (timeStamp < initialRecordTime or timeStamp > lastRecordTime) {
    return false;
  }
  bool someSnapshotIsDue = false;
  for (int index = 0; index < particles.getSize() and not someSnapshotIsDue; index++) {
    someSnapshotIsDue = database.isSnapshotDue(particles.getNumber(index), particles.getPosition(index), timeStamp);
  }
  return someSnapshotIsDue;
}

/**
 * Returns on every rank whether isSnapshotDue() holds on some rank. Every rank calls it at the same time.
 */
template <int NumberOfData>
INLINE_METHOD bool
exahype2::particles::isSnapshotDueOnSomeRank(
  const ParticleSet<NumberOfData>& particles,
  const double                     timeStamp,
  const double                     initialRecordTime,
  const double                     lastRecordTime,
  TrajectoryDatabase&              database
) {
  const auto& rank          = tarch::mpi::Rank::getInstance();
  const int   dueOnThisRank = isSnapshotDue(particles, timeStamp, initialRecordTime, lastRecordTime, database) ? 1 : 0;
  int         dueOnSomeRank = dueOnThisRank;
  if (rank.getNumberOfRanks() > 1) {
    tarch::mpi::allreduce(&dueOnThisRank, &dueOnSomeRank, 1, MPI_INT, MPI_MAX, rank.getCommunicator());
  }
  assertion(dueOnSomeRank >= dueOnThisRank, dueOnSomeRank, dueOnThisRank);
  return dueOnSomeRank > 0;
}

/**
 * Adds one snapshot of every particle of the rank to the database. A time stamp outside the
 * closed window between initialRecordTime and lastRecordTime records nothing, and the particle
 * data leaves the device only when the database stores a snapshot of some particle.
 */
template <int NumberOfData>
INLINE_METHOD void
exahype2::particles::recordSnapshots(
  ParticleSet<NumberOfData>& particles,
  const double               timeStamp,
  const double               initialRecordTime,
  const double               lastRecordTime,
  TrajectoryDatabase&        database
) {
  if (not isSnapshotDue(particles, timeStamp, initialRecordTime, lastRecordTime, database)) {
    return;
  }
  particles.download();
  for (int index = 0; index < particles.getSize(); index++) {
    const auto number = particles.getNumber(index);
    database.addParticleSnapshot(
      number.first,
      number.second,
      timeStamp,
      particles.getPosition(index),
      NumberOfData,
      particles.getData(index)
    );
  }
}
