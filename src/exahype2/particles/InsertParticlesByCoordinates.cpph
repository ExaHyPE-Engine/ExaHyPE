/**
 * Creates one particle per coordinate that the unrefined cell of marker owns, and adds it to the
 * vertex of that cell which lies closest to the coordinate.
 *
 * Every particle starts at its coordinate with a search radius of zero. The callback initialise
 * runs before insertParticleIntoCell(), which sets the particle local and overwrites its cell
 * width.
 */
template <typename Particle, std::size_t NumberOfParticles, typename Vertices, typename Initialisation>
INLINE_METHOD void exahype2::particles::insertParticlesByCoordinates(
  const peano4::dataview::CellMarker&                                         marker,
  const std::array<tarch::la::Vector<DIMENSIONS, double>, NumberOfParticles>& coordinates,
  const tarch::la::Vector<DIMENSIONS, double>&                                domainOffset,
  Vertices&                                                                   fineGridVertices,
  const int                                                                   treeId,
  Initialisation&&                                                            initialise
) {
  for (const auto& coordinate : coordinates) {
    if (not marker.willBeRefined() and exahype2::particles::ownsCoordinate(marker, coordinate, domainOffset)) {
      auto* const particle = new Particle();
      peano4::particles::init(*particle, coordinate, 0.0);
      initialise(particle);
      peano4::particles::insertParticleIntoCell(marker, particle, fineGridVertices, treeId);
    }
  }
}
