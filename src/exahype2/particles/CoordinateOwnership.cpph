/**
 * Returns whether the cell of marker owns coordinate. A coordinate on the face between two cells
 * belongs to the lower cell along the face normal, and a coordinate on the lower domain wall to
 * the cell on the wall, so exactly one unrefined cell of a level owns every coordinate.
 */
INLINE_METHOD bool exahype2::particles::ownsCoordinate(
  const peano4::dataview::CellMarker&          marker,
  const tarch::la::Vector<DIMENSIONS, double>& coordinate,
  const tarch::la::Vector<DIMENSIONS, double>& domainOffset
) {
  bool owned = marker.isContained(coordinate);
  for (int dimension = 0; dimension < DIMENSIONS; dimension++) {
    const double lowerFace = marker.getX()(dimension) - marker.getH()(dimension) / 2.0;
    owned                  = owned
      and (tarch::la::greater(coordinate(dimension), lowerFace)
           or not tarch::la::greater(lowerFace, domainOffset(dimension)));
  }
  return owned;
}
