INLINE_METHOD void exahype2::particles::ParallelStateStatistics::clear() {
  numberOfRemainingLocalParticles = 0;
  remainingLocalParticleNumbers.clear();
  numberOfExpiredHaloParticles             = 0;
  numberOfParticlesThatHaveLeftTheirDomain = 0;
}

/** Adds the counters of this tree to the particle-state statistics of the particle container. */
template <typename ParticleSet>
INLINE_METHOD void exahype2::particles::ParallelStateStatistics::record() const {
  ParticleSet::updateNumberOfLocalAndExpiredParticles(
    numberOfRemainingLocalParticles,
    numberOfExpiredHaloParticles,
    numberOfParticlesThatHaveLeftTheirDomain,
    remainingLocalParticleNumbers
  );
}

/**
 * Sets every particle of fineGridVertexParticles local when a local cell around the vertex of
 * marker owns it, and virtual when none does.
 */
template <typename ParticleSet>
INLINE_METHOD void exahype2::particles::updateParallelStateOfParticles(
  const peano4::dataview::VertexMarker& marker,
  ParticleSet&                          fineGridVertexParticles,
  const std::string&                    particleName,
  const int                             treeId,
  ParallelStateStatistics&              statistics
) {
  using Particle = typename ParticleSet::DoFType;

  for (auto* const particle : fineGridVertexParticles) {
    const bool particleWillBeLocal = peano4::particles::particleAssignedToVertexWillBeLocal(particle->getX(), marker);
    if (not particleWillBeLocal and particle->getParallelState() == Particle::ParallelState::Local) {
      particle->setParallelState(Particle::ParallelState::Virtual);
      logDebug(
        "Particle " << particle->toString() << " left tree " << treeId << " through " << marker.toString() << "."
      );
      ++statistics.numberOfParticlesThatHaveLeftTheirDomain;

#if PEANO_ASSERTIONS
      const int particleId = particle->getPartid();
#else
      const int particleId = -1;
#endif

      peano4::particles::assignmentchecks::detachParticleFromVertex(
        particleName,
        particle->getX(),
        particleId,
        true,
        marker.getX(),
        marker.getH(),
        treeId,
        "exahype2::particles::updateParallelStateOfParticles"
      );
      peano4::particles::assignmentchecks::assignParticleToVertex(
        particleName,
        particle->getX(),
        particleId,
        false,
        marker.getX(),
        marker.getH(),
        treeId,
        "exahype2::particles::updateParallelStateOfParticles",
        marker.getX(),
        marker.getH()
      );
    } else if (particleWillBeLocal and particle->getParallelState() == Particle::ParallelState::Virtual) {
      particle->setParallelState(Particle::ParallelState::Local);
      logDebug(
        "Virtual copy of particle " << particle->toString() << " lies in a local cell of tree " << treeId << " at "
                                    << marker.toString() << " and becomes local."
      );

#if PEANO_ASSERTIONS
      const int particleId = particle->getPartid();
#else
      const int particleId = -1;
#endif

      peano4::particles::assignmentchecks::detachParticleFromVertex(
        particleName,
        particle->getX(),
        particleId,
        false,
        marker.getX(),
        marker.getH(),
        treeId,
        "exahype2::particles::updateParallelStateOfParticles"
      );
      peano4::particles::assignmentchecks::assignParticleToVertex(
        particleName,
        particle->getX(),
        particleId,
        true,
        marker.getX(),
        marker.getH(),
        treeId,
        "exahype2::particles::updateParallelStateOfParticles",
        marker.getX(),
        marker.getH()
      );
    }
  }
}

/**
 * Deletes every virtual particle of fineGridVertexParticles and counts the local ones that stay
 * with the vertex of marker.
 */
template <typename ParticleSet>
INLINE_METHOD void exahype2::particles::deleteVirtualParticles(
  const peano4::dataview::VertexMarker& marker,
  ParticleSet&                          fineGridVertexParticles,
  const std::string&                    particleName,
  const int                             treeId,
  ParallelStateStatistics&              statistics
) {
  using Particle = typename ParticleSet::DoFType;

  auto particleIterator = fineGridVertexParticles.begin();
  while (particleIterator != fineGridVertexParticles.end()) {
    auto* const particle = *particleIterator;
    if (particle->getParallelState() == Particle::ParallelState::Local) {
      logDebug("Particle " << particle->toString() << " remains local.");
      ++statistics.numberOfRemainingLocalParticles;
      statistics.remainingLocalParticleNumbers.insert({particle->getNumber(0), particle->getNumber(1)});
      ++particleIterator;
    } else {
#if PEANO_ASSERTIONS
      const int particleId = particle->getPartid();
#else
      const int particleId = -1;
#endif

      logDebug(
        "Remove virtual particle " << particle->toString() << " from " << marker.toString() << " on tree " << treeId
                                   << "."
      );
      peano4::particles::assignmentchecks::detachParticleFromVertex(
        particleName,
        particle->getX(),
        particleId,
        false,
        marker.getX(),
        marker.getH(),
        treeId,
        "exahype2::particles::deleteVirtualParticles"
      );
      peano4::particles::assignmentchecks::eraseParticle(
        particleName,
        particle->getX(),
        particleId,
        false,
        marker.getX(),
        marker.getH(),
        treeId,
        "exahype2::particles::deleteVirtualParticles"
      );
      ++statistics.numberOfExpiredHaloParticles;
      particleIterator = fineGridVertexParticles.deleteParticle(particleIterator);
    }
  }
}
