/**
 * Appends the mesh position of every raw coordinate to coordinates.
 *
 * solver.invertProjection() maps a physical position onto the position the curvilinear mesh
 * gives it. A raw coordinate carries at least one component per axis; a build of fewer
 * dimensions drops the trailing components.
 */
template <std::size_t NumberOfCoordinates, std::size_t ComponentsPerCoordinate, typename SolverType>
INLINE_METHOD void exahype2::particles::invertCoordinates(
  SolverType& solver,
  const double (&rawCoordinates)[NumberOfCoordinates][ComponentsPerCoordinate],
  std::vector<tarch::la::Vector<DIMENSIONS, double>>& coordinates
) {
  static_assert(ComponentsPerCoordinate >= DIMENSIONS, "A coordinate carries one component per axis.");

  coordinates.reserve(coordinates.size() + NumberOfCoordinates);
  for (std::size_t entry = 0; entry < NumberOfCoordinates; entry++) {
    coordinates.push_back(solver.invertProjection(tarch::la::Vector<DIMENSIONS, double>(rawCoordinates[entry])));
  }
}

/** Returns whether the face of marker carries the fault at faultPosition along faultNormal. */
INLINE_METHOD bool exahype2::particles::isFaultFace(
  const peano4::dataview::FaceMarker& marker,
  const int                           faultNormal,
  const double                        faultPosition
) {
  assertion(faultNormal >= 0 and faultNormal < DIMENSIONS, faultNormal);

  const int normal = marker.getSelectedFaceNumber() % DIMENSIONS;
  return normal == faultNormal
    and std::abs(marker.getX()[faultNormal] - faultPosition) < 0.5 * marker.getH()[faultNormal];
}

/**
 * Adds one snapshot per coordinate the cell of marker owns to the database.
 *
 * The snapshot holds the first UnknownsToStore unknowns of the polynomial over solution, taken
 * at the coordinate, and carries the index of that coordinate as both particle numbers.
 */
template <int Order, int UnknownsPerDoF, int UnknownsToStore, typename StoragePrecision, typename Database>
INLINE_METHOD void exahype2::particles::recordCurvilinearCellSolution(
  const peano4::dataview::CellMarker&                       marker,
  const StoragePrecision* const                             quadraturePoints,
  const StoragePrecision* const                             solution,
  const std::vector<tarch::la::Vector<DIMENSIONS, double>>& coordinates,
  const tarch::la::Vector<DIMENSIONS, double>&              domainOffset,
  const double                                              timeStamp,
  Database&                                                 database
) {
  static_assert(UnknownsToStore > 0);
  static_assert(UnknownsToStore <= UnknownsPerDoF);
  assertion(quadraturePoints != nullptr);
  assertion(solution != nullptr);

  for (int coordinate = 0; coordinate < static_cast<int>(coordinates.size()); coordinate++) {
    if (exahype2::particles::ownsCoordinate(marker, coordinates[coordinate], domainOffset)) {
      double data[UnknownsToStore];
      for (int unknown = 0; unknown < UnknownsToStore; unknown++) {
        data[unknown] = exahype2::dg::evaluatePolynomial(
          marker,
          Order,
          quadraturePoints,
          UnknownsPerDoF,
          solution,
          coordinates[coordinate],
          unknown
        );
      }

      database.addParticleSnapshot(coordinate, coordinate, timeStamp, coordinates[coordinate], UnknownsToStore, data);
    }
  }
}

/**
 * Adds one snapshot per fault coordinate the face of marker contains to the database.
 *
 * faceEstimates holds the estimate of the left cell followed by the estimate of the right cell,
 * each of basisElementsPerFace values. A snapshot averages the two estimates, except for the
 * three components at FirstDisplacement and the three at FirstVelocity, which carry the
 * difference of the right estimate and the left one.
 */
template <
  int Order,
  int UnknownsPerDoF,
  int UnknownsToStore,
  int FirstDisplacement,
  int FirstVelocity,
  typename StoragePrecision,
  typename Database>
INLINE_METHOD void exahype2::particles::recordCurvilinearFaultSolution(
  const peano4::dataview::FaceMarker&                       marker,
  const StoragePrecision* const                             quadraturePoints,
  const StoragePrecision* const                             faceEstimates,
  const int                                                 basisElementsPerFace,
  const std::vector<tarch::la::Vector<DIMENSIONS, double>>& faultCoordinates,
  const int                                                 firstSnapshotId,
  const double                                              timeStamp,
  Database&                                                 database
) {
  constexpr int ComponentsPerVector = 3;
  static_assert(UnknownsToStore > 0);
  static_assert(UnknownsToStore <= UnknownsPerDoF);
  static_assert(FirstDisplacement >= 0 and FirstDisplacement + ComponentsPerVector <= UnknownsPerDoF);
  static_assert(FirstVelocity >= 0 and FirstVelocity + ComponentsPerVector <= UnknownsPerDoF);
  assertion(quadraturePoints != nullptr);
  assertion(faceEstimates != nullptr);
  assertion(basisElementsPerFace > 0, basisElementsPerFace);
  assertion(firstSnapshotId >= 0, firstSnapshotId);

  const StoragePrecision* const leftEstimate  = faceEstimates;
  const StoragePrecision* const rightEstimate = faceEstimates + basisElementsPerFace;

  const auto faceHoldsCoordinate = [&marker](const tarch::la::Vector<DIMENSIONS, double>& position) {
    const int normal   = marker.getSelectedFaceNumber() % DIMENSIONS;
    bool      isInside = true;
    for (int axis = 0; axis < DIMENSIONS; axis++) {
      if (axis == normal) {
        continue;
      }
      isInside = isInside and position[axis] < marker.getX()[axis] + 0.5 * marker.getH()[axis];
      isInside = isInside and position[axis] > marker.getX()[axis] - 0.5 * marker.getH()[axis];
    }
    return isInside;
  };

  for (int coordinate = 0; coordinate < static_cast<int>(faultCoordinates.size()); coordinate++) {
    if (faceHoldsCoordinate(faultCoordinates[coordinate])) {
      double data[UnknownsPerDoF];
      for (int unknown = 0; unknown < UnknownsToStore; unknown++) {
        data[unknown] = 0.5
          * static_cast<double>(
                          exahype2::dg::evaluatePolynomial(
                            marker,
                            Order,
                            quadraturePoints,
                            UnknownsPerDoF,
                            rightEstimate,
                            faultCoordinates[coordinate],
                            unknown
                          )
                          + exahype2::dg::evaluatePolynomial(
                            marker,
                            Order,
                            quadraturePoints,
                            UnknownsPerDoF,
                            leftEstimate,
                            faultCoordinates[coordinate],
                            unknown
                          )
          );
      }

      for (int unknown = FirstVelocity; unknown < FirstVelocity + ComponentsPerVector; unknown++) {
        data[unknown] = static_cast<double>(
          exahype2::dg::evaluatePolynomial(
            marker,
            Order,
            quadraturePoints,
            UnknownsPerDoF,
            rightEstimate,
            faultCoordinates[coordinate],
            unknown
          )
          - exahype2::dg::evaluatePolynomial(
            marker,
            Order,
            quadraturePoints,
            UnknownsPerDoF,
            leftEstimate,
            faultCoordinates[coordinate],
            unknown
          )
        );
      }

      for (int unknown = FirstDisplacement; unknown < FirstDisplacement + ComponentsPerVector; unknown++) {
        data[unknown] = static_cast<double>(
          exahype2::dg::evaluatePolynomial(
            marker,
            Order,
            quadraturePoints,
            UnknownsPerDoF,
            rightEstimate,
            faultCoordinates[coordinate],
            unknown
          )
          - exahype2::dg::evaluatePolynomial(
            marker,
            Order,
            quadraturePoints,
            UnknownsPerDoF,
            leftEstimate,
            faultCoordinates[coordinate],
            unknown
          )
        );
      }

      database.addParticleSnapshot(
        coordinate + firstSnapshotId,
        coordinate + firstSnapshotId,
        timeStamp,
        faultCoordinates[coordinate],
        UnknownsToStore,
        data
      );
    }
  }
}
