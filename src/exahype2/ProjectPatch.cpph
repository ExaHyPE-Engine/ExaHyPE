TARGET_DECLARE
/**
 * Copies patch boundary layers into the cell-owned halves of the face overlaps.
 * Every face stores @c 2*Overlap layers along its normal. The lower boundary is
 * written to the upper half of the lower face, and the upper boundary to the
 * lower half of the upper face; the neighbour-owned halves remain untouched.
 */
template <int NumberOfDofsPerAxis, int Overlap, int NumberOfUnknowns, typename Precision>
INLINE_METHOD GPU_CALLABLE_METHOD void exahype2::projectPatch(
  const Precision* NOALIAS const inputPatch,
  Precision* NOALIAS const       faces[peano4::FacesPerCell]
) {
  static_assert(Overlap > 0 and Overlap <= NumberOfDofsPerAxis);
  assertion(inputPatch != nullptr);
  for (int face = 0; face < peano4::FacesPerCell; face++) {
    assertion(faces[face] != nullptr, face);
  }

  int numberOfDofs = NumberOfDofsPerAxis;
  for (int dimension = 1; dimension < DIMENSIONS; dimension++) {
    numberOfDofs *= NumberOfDofsPerAxis;
  }

  for (int linearDof = 0; linearDof < numberOfDofs; linearDof++) {
    tarch::la::Vector<DIMENSIONS, int> dofIndex;
    int                                remainder = linearDof;
    for (int dimension = 0; dimension < DIMENSIONS; dimension++) {
      dofIndex(dimension) = remainder % NumberOfDofsPerAxis;
      remainder /= NumberOfDofsPerAxis;
    }

    for (int dimension = 0; dimension < DIMENSIONS; dimension++) {
      for (int layer = 0; layer < Overlap; layer++) {
        tarch::la::Vector<DIMENSIONS, int> patchDof   = dofIndex;
        tarch::la::Vector<DIMENSIONS, int> overlapDof = dofIndex;
        patchDof(dimension)                           = layer;
        overlapDof(dimension)                         = layer + Overlap;
        const int lowerPatchIndex                     = peano4::dLinearised(patchDof, NumberOfDofsPerAxis);
        const int lowerOverlapIndex =
          exahype2::serialiseVoxelIndexInOverlap(overlapDof, NumberOfDofsPerAxis, Overlap, dimension);
        SIMD()
        for (int unknown = 0; unknown < NumberOfUnknowns; unknown++) {
          faces[dimension][lowerOverlapIndex * NumberOfUnknowns + unknown] =
            inputPatch[lowerPatchIndex * NumberOfUnknowns + unknown];
        }

        patchDof(dimension)       = layer + NumberOfDofsPerAxis - Overlap;
        overlapDof(dimension)     = layer;
        const int upperPatchIndex = peano4::dLinearised(patchDof, NumberOfDofsPerAxis);
        const int upperOverlapIndex =
          exahype2::serialiseVoxelIndexInOverlap(overlapDof, NumberOfDofsPerAxis, Overlap, dimension);
        SIMD()
        for (int unknown = 0; unknown < NumberOfUnknowns; unknown++) {
          faces[dimension + DIMENSIONS][upperOverlapIndex * NumberOfUnknowns + unknown] =
            inputPatch[upperPatchIndex * NumberOfUnknowns + unknown];
        }
      }
    }
  }
}
TARGET_DECLARE_END
