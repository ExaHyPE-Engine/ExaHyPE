INLINE_METHOD int exahype2::amr::subfaceIndexWithinFatherFace(const peano4::dataview::FaceMarker& marker) {
#if DIMENSIONS == 3
  return marker.getRelativePositionWithinFatherFace()(0)
    + peano4::sfc::ActiveCurve::SubdivisionFactor * marker.getRelativePositionWithinFatherFace()(1);
#else
  return marker.getRelativePositionWithinFatherFace()(0);
#endif
}

INLINE_METHOD int exahype2::amr::childIndexWithinFatherCell(const peano4::dataview::CellMarker& marker) {
  return peano4::dLinearised(marker.getRelativePositionWithinFatherCell(), peano4::sfc::ActiveCurve::SubdivisionFactor);
}

/**
 * Returns whether the face the marker selects lies on a wall of the domain.
 */
INLINE_METHOD bool exahype2::amr::isOnDomainBoundary(
  const peano4::dataview::FaceMarker&          marker,
  const tarch::la::Vector<DIMENSIONS, double>& domainOffset,
  const tarch::la::Vector<DIMENSIONS, double>& domainSize
) {
  bool result = false;
  for (int axis = 0; axis < DIMENSIONS; axis++) {
    result = result or tarch::la::equals(marker.getX()(axis), domainOffset(axis));
    result = result or tarch::la::equals(marker.getX()(axis), domainOffset(axis) + domainSize(axis));
  }
  return result;
}

TARGET_DECLARE
template <typename T>
INLINE_METHOD GPU_CALLABLE_METHOD void exahype2::amr::clearTransferBuffer(
  T* NOALIAS const values,
  const int        numberOfValues
) {
  assertion(values != nullptr);
  assertion(numberOfValues >= 0, numberOfValues);
  for (int value = 0; value < numberOfValues; value++) {
    values[value] = static_cast<T>(0);
  }
}
TARGET_DECLARE_END

template <typename Record>
INLINE_METHOD void exahype2::amr::clearTransferRecord(Record& record) {
  exahype2::amr::clearTransferBuffer(record.data(), std::remove_reference_t<Record>::Cardinality);
}

/**
 * Interpolates one side of a hanging face from the coarse face it hangs below.
 *
 * A subface in the interior of the coarse cell has no coarse face above it, and its
 * adjacent fine cells write both of its sides, so the kernel runs on the subfaces of
 * the coarse cell's own faces only.
 */
template <typename T, exahype2::amr::FaceInterpolationKernel<T> FaceInterpolation>
INLINE_METHOD void exahype2::amr::interpolateFaceFromCoarseFace(
  const peano4::dataview::FaceMarker& marker,
  const T* NOALIAS                    coarseFaceValues,
  T* NOALIAS                          fineFaceValues,
  const int                           side,
  const FaceInterpolation&            interpolateFace
) {
  assertion(side == 0 or side == 1, side);
  if (not marker.isInteriorFaceWithinPatch()) {
    interpolateFace(marker, coarseFaceValues, fineFaceValues, side);
  }
}

/**
 * Stages one side of a hanging subface for the restriction of the coarse face.
 *
 * Returns whether the subface completes the set of subfaces below the coarse face.
 */
template <typename T>
INLINE_METHOD bool exahype2::amr::stageSubfaceForRestriction(
  const peano4::dataview::FaceMarker& marker,
  exahype2::amr::ChildDataStage<T>&   stage,
  const void*                         coarseFaceKey,
  const T* NOALIAS                    fineFaceValues
) {
  return stage.stage(coarseFaceKey, exahype2::amr::subfaceIndexWithinFatherFace(marker), fineFaceValues);
}

/**
 * Reduces the subfaces staged below one side of a face and returns whether any were staged.
 *
 * The kernel discards the frame, so a second call on the same key runs nothing. The key may
 * alias coarseFaceValues.
 */
template <typename T, exahype2::amr::FaceRestrictionKernel<T> FaceRestriction>
INLINE_METHOD bool exahype2::amr::restrictFaceFromStagedSubfaces(
  exahype2::amr::ChildDataStage<T>& stage,
  const void* const                 coarseFaceKey,
  T* const                          coarseFaceValues,
  const FaceRestriction&            restrictFace
) {
  if (not stage.hasFrame(coarseFaceKey)) {
    return false;
  }
  restrictFace(stage, coarseFaceKey, coarseFaceValues);
  return true;
}

/**
 * Fills stagedSubfaces with the SubfacesPerFace entries of the frame.
 *
 * An entry is null where another tree holds the subface.
 */
template <typename T>
INLINE_METHOD void exahype2::amr::collectStagedSubfaces(
  const exahype2::amr::ChildDataStage<T>& stage,
  const void*                             coarseFaceKey,
  const T**                               stagedSubfaces
) {
  assertion(stage.hasFrame(coarseFaceKey));
  for (int subface = 0; subface < exahype2::amr::SubfacesPerFace; subface++) {
    stagedSubfaces[subface] = stage.hasChild(coarseFaceKey, subface) ? stage.child(coarseFaceKey, subface) : nullptr;
  }
}

/**
 * Prolongs the coarse cell into the child the marker selects.
 */
template <typename T, exahype2::amr::CellProlongationKernel<T> CellProlongation>
INLINE_METHOD void exahype2::amr::prolongCellIntoChild(
  const peano4::dataview::CellMarker& marker,
  const T* NOALIAS                    coarseGridValues,
  T* NOALIAS                          fineGridValues,
  const CellProlongation&             prolongCell
) {
  assertion(coarseGridValues != nullptr);
  assertion(fineGridValues != nullptr);
  prolongCell(marker, coarseGridValues, fineGridValues);
}

/**
 * Stages one destroyed child for the restriction onto its parent.
 *
 * Returns whether the child completes the sibling set.
 */
template <typename T>
INLINE_METHOD bool exahype2::amr::stageChildForRestriction(
  const peano4::dataview::CellMarker& marker,
  exahype2::amr::ChildDataStage<T>&   stage,
  T* NOALIAS                          coarseGridValues,
  const T* NOALIAS                    fineGridValues
) {
  return stage.stage(coarseGridValues, exahype2::amr::childIndexWithinFatherCell(marker), fineGridValues);
}

/**
 * Reduces the children staged below one coarse buffer.
 *
 * The kernel discards the frame.
 */
template <typename T, exahype2::amr::CellRestrictionKernel<T> CellRestriction>
INLINE_METHOD void exahype2::amr::restrictStagedChildrenIntoCell(
  exahype2::amr::ChildDataStage<T>& stage,
  T* NOALIAS                        coarseGridValues,
  const CellRestriction&            restrictCell
) {
  assertion(stage.hasFrame(coarseGridValues));
  restrictCell(stage, coarseGridValues);
}

/**
 * Stages one destroyed child and reduces the sibling set once it is complete.
 *
 * Returns whether the reduction ran.
 */
template <typename T, exahype2::amr::CellRestrictionKernel<T> CellRestriction>
INLINE_METHOD bool exahype2::amr::restrictChildrenIntoCell(
  const peano4::dataview::CellMarker& marker,
  exahype2::amr::ChildDataStage<T>&   stage,
  T* NOALIAS                          coarseGridValues,
  const T* NOALIAS                    fineGridValues,
  const CellRestriction&              restrictCell
) {
  if (not exahype2::amr::stageChildForRestriction(marker, stage, coarseGridValues, fineGridValues)) {
    return false;
  }
  exahype2::amr::restrictStagedChildrenIntoCell(stage, coarseGridValues, restrictCell);
  return true;
}

/**
 * Fills stagedChildren with the ChildrenPerCell entries of the frame.
 *
 * An entry is null where another tree holds the child.
 */
template <typename T>
INLINE_METHOD void exahype2::amr::collectStagedChildren(
  const exahype2::amr::ChildDataStage<T>& stage,
  const void*                             coarseCellKey,
  const T**                               stagedChildren
) {
  assertion(stage.hasFrame(coarseCellKey));
  for (int child = 0; child < peano4::sfc::ActiveCurve::ChildrenPerCell; child++) {
    stagedChildren[child] = stage.hasChild(coarseCellKey, child) ? stage.child(coarseCellKey, child) : nullptr;
  }
}

template <typename FaceLabel>
INLINE_METHOD void exahype2::amr::copyFaceTimeStampsFromCoarseFace(
  const FaceLabel& coarseFaceLabel,
  FaceLabel&       fineFaceLabel,
  const int        side
) {
  assertion(side == 0 or side == 1, side);
  fineFaceLabel.setNewTimeStamp(side, coarseFaceLabel.getNewTimeStamp(side));
  fineFaceLabel.setOldTimeStamp(side, coarseFaceLabel.getOldTimeStamp(side));
}

template <typename FaceLabel>
INLINE_METHOD void exahype2::amr::raiseFaceTimeStampsFromCoarseFace(
  const FaceLabel& coarseFaceLabel,
  FaceLabel&       fineFaceLabel
) {
  for (int side = 0; side < 2; side++) {
    fineFaceLabel.setNewTimeStamp(
      side,
      std::max(coarseFaceLabel.getNewTimeStamp(side), fineFaceLabel.getNewTimeStamp(side))
    );
    fineFaceLabel.setOldTimeStamp(
      side,
      std::max(coarseFaceLabel.getOldTimeStamp(side), fineFaceLabel.getOldTimeStamp(side))
    );
  }
}

template <typename FaceLabel>
INLINE_METHOD void exahype2::amr::raiseFaceTimeStampsOntoCoarseFace(
  FaceLabel&       coarseFaceLabel,
  const FaceLabel& fineFaceLabel
) {
  for (int side = 0; side < 2; side++) {
    coarseFaceLabel.setNewTimeStamp(
      side,
      std::max(coarseFaceLabel.getNewTimeStamp(side), fineFaceLabel.getNewTimeStamp(side))
    );
    coarseFaceLabel.setOldTimeStamp(
      side,
      std::max(coarseFaceLabel.getOldTimeStamp(side), fineFaceLabel.getOldTimeStamp(side))
    );
    coarseFaceLabel.setUpdatedTimeStamp(
      side,
      std::max(coarseFaceLabel.getUpdatedTimeStamp(side), fineFaceLabel.getUpdatedTimeStamp(side))
    );
  }
}

template <typename FaceLabel>
INLINE_METHOD void exahype2::amr::raiseUpdatedTimeStampOntoCoarseFace(
  FaceLabel&       coarseFaceLabel,
  const FaceLabel& fineFaceLabel,
  const int        side
) {
  assertion(side == 0 or side == 1, side);
  const auto newTimeStamp =
    std::max(coarseFaceLabel.getUpdatedTimeStamp(side), fineFaceLabel.getUpdatedTimeStamp(side));
  coarseFaceLabel.setUpdated(side, true);
  coarseFaceLabel.setUpdatedTimeStamp(side, newTimeStamp);
}

template <typename FaceLabel>
INLINE_METHOD void exahype2::amr::copyUpdatedTimeStampOntoCoarseFace(
  FaceLabel&       coarseFaceLabel,
  const FaceLabel& fineFaceLabel,
  const int        side
) {
  assertion(side == 0 or side == 1, side);
  coarseFaceLabel.setUpdated(side, true);
  coarseFaceLabel.setUpdatedTimeStamp(side, fineFaceLabel.getUpdatedTimeStamp(side));
}

template <typename CellLabel, typename FaceLabel>
INLINE_METHOD void exahype2::amr::setFaceTimeStampsFromCoarseCell(
  const CellLabel& coarseCellLabel,
  FaceLabel&       fineFaceLabel
) {
  for (int side = 0; side < 2; side++) {
    fineFaceLabel.setNewTimeStamp(side, coarseCellLabel.getTimeStamp());
    fineFaceLabel.setOldTimeStamp(side, coarseCellLabel.getTimeStamp());
  }
}

/**
 * Copies the time stepping and update state of a parent onto a created child.
 *
 * The parent's pending roll-over travels with its data, and the criterion flag makes
 * the mesh-refinement sweeps evaluate the child's data once.
 */
template <typename CellLabel>
INLINE_METHOD void exahype2::amr::copyCellLabelIntoChild(const CellLabel& coarseCellLabel, CellLabel& fineCellLabel) {
  fineCellLabel.setTimeStamp(coarseCellLabel.getTimeStamp());
  fineCellLabel.setTimeStepSize(coarseCellLabel.getTimeStepSize());
  fineCellLabel.setHasUpdated(coarseCellLabel.getHasUpdated());
  fineCellLabel.setRequiresCriterionEvaluation(true);
}

template <typename CellLabel>
INLINE_METHOD void exahype2::amr::copyCellTimeStampsFromChild(
  CellLabel&       coarseCellLabel,
  const CellLabel& fineCellLabel
) {
  coarseCellLabel.setTimeStamp(fineCellLabel.getTimeStamp());
  coarseCellLabel.setTimeStepSize(fineCellLabel.getTimeStepSize());
}

template <typename CellLabel>
INLINE_METHOD void exahype2::amr::raiseCellTimeStampsFromChild(
  CellLabel&       coarseCellLabel,
  const CellLabel& fineCellLabel
) {
  coarseCellLabel.setTimeStamp(std::max(coarseCellLabel.getTimeStamp(), fineCellLabel.getTimeStamp()));
  coarseCellLabel.setTimeStepSize(std::max(coarseCellLabel.getTimeStepSize(), fineCellLabel.getTimeStepSize()));
}

/**
 * Copies the time stepping and update state of a destroyed child onto its parent.
 *
 * The children's pending roll-over travels with their data, and the criterion flag
 * makes the mesh-refinement sweeps evaluate the exposed parent's data once.
 */
template <typename CellLabel>
INLINE_METHOD void exahype2::amr::mergeCellLabelFromChild(CellLabel& coarseCellLabel, const CellLabel& fineCellLabel) {
  exahype2::amr::copyCellTimeStampsFromChild(coarseCellLabel, fineCellLabel);
  if (fineCellLabel.getHasUpdated()) {
    coarseCellLabel.setHasUpdated(true);
  }
  coarseCellLabel.setRequiresCriterionEvaluation(true);
}

/**
 * Flags the side of every adjacent face that this cell writes as awaiting its data.
 */
template <typename FaceLabelEnumerator>
INLINE_METHOD void exahype2::amr::requestDataTransferOnOwnSides(const FaceLabelEnumerator& faceLabels) {
  for (int face = 0; face < peano4::FacesPerCell; face++) {
    const int ownSide = face < DIMENSIONS ? 1 : 0;
    faceLabels(face).setRequiresDataTransfer(ownSide, true);
  }
}

/**
 * Clears the transfer flag on the side of every adjacent persistent face that this cell writes.
 */
template <typename FaceLabelEnumerator>
INLINE_METHOD void exahype2::amr::releaseDataTransferOnOwnSides(const FaceLabelEnumerator& faceLabels) {
  for (int face = 0; face < peano4::FacesPerCell; face++) {
    const int ownSide = face < DIMENSIONS ? 1 : 0;
    if (not faceLabels(face).getIsHanging()) {
      faceLabels(face).setRequiresDataTransfer(ownSide, false);
    }
  }
}

/**
 * Marks the side of every adjacent face that this cell writes as updated at the given stamp.
 */
template <typename FaceLabelEnumerator>
INLINE_METHOD void exahype2::amr::markOwnSidesUpdated(const FaceLabelEnumerator& faceLabels, const double timeStamp) {
  for (int face = 0; face < peano4::FacesPerCell; face++) {
    const int ownSide = face < DIMENSIONS ? 1 : 0;
    faceLabels(face).setUpdated(ownSide, true);
    faceLabels(face).setUpdatedTimeStamp(ownSide, timeStamp);
  }
}

/**
 * Returns whether this cell still owes data to one of its faces.
 *
 * A coarsening parent owes every face, and any persistent face whose own side still
 * carries the transfer flag owes its half.
 */
template <typename FaceLabelEnumerator>
INLINE_METHOD bool exahype2::amr::awaitsDataTransfer(
  const peano4::dataview::CellMarker& marker,
  const FaceLabelEnumerator&          faceLabels
) {
  bool result = marker.hasBeenRefined() and not marker.willBeRefined();
  for (int face = 0; face < peano4::FacesPerCell; face++) {
    const int ownSide = face < DIMENSIONS ? 1 : 0;
    result = result or (not faceLabels(face).getIsHanging() and faceLabels(face).getRequiresDataTransfer(ownSide));
  }
  return result;
}

template <typename T>
INLINE_METHOD exahype2::amr::CellAveragingInterpolation<T>::CellAveragingInterpolation(
  const int numberOfDofsPerAxis,
  const int numberOfValuesPerDof
) :
  _numberOfDofsPerAxis(numberOfDofsPerAxis),
  _numberOfValuesPerDof(numberOfValuesPerDof) {}

template <typename T>
INLINE_METHOD void exahype2::amr::CellAveragingInterpolation<T>::operator()(
  const peano4::dataview::CellMarker& marker,
  const T* NOALIAS                    coarseGridValues,
  T* NOALIAS                          fineGridValues
) const {
  exahype2::amr::interpolateCell(marker, coarseGridValues, fineGridValues, _numberOfDofsPerAxis, _numberOfValuesPerDof);
}

template <typename T>
INLINE_METHOD exahype2::amr::CellAveragingRestriction<T>::CellAveragingRestriction(
  const int numberOfDofsPerAxis,
  const int numberOfValuesPerDof
) :
  _numberOfDofsPerAxis(numberOfDofsPerAxis),
  _numberOfValuesPerDof(numberOfValuesPerDof) {}

template <typename T>
INLINE_METHOD void exahype2::amr::CellAveragingRestriction<T>::operator()(
  exahype2::amr::ChildDataStage<T>& stage,
  T* NOALIAS                        coarseGridValues
) const {
  const T* stagedChildren[peano4::sfc::ActiveCurve::ChildrenPerCell];
  exahype2::amr::collectStagedChildren(stage, coarseGridValues, stagedChildren);
  for (int child = 0; child < peano4::sfc::ActiveCurve::ChildrenPerCell; child++) {
    assertion(stagedChildren[child] != nullptr, child);
  }
  exahype2::amr::restrictCellFromChildren(
    coarseGridValues,
    stagedChildren,
    _numberOfDofsPerAxis,
    _numberOfValuesPerDof
  );
  stage.discard(coarseGridValues);
}
