/**
 * Prolongs a coarse halo layer onto a fine face with piecewise-constant values.
 */
template <typename T>
INLINE_METHOD void exahype2::amr::interpolateHaloLayer(
  const peano4::dataview::FaceMarker& marker,
  const T* NOALIAS                    coarseGridFaceValues,
  T* NOALIAS                          fineGridFaceValues,
  const int                           side,
  const int                           numberOfDofsPerAxis,
  const int                           numberOfUnknownsPlusAuxiliaryVariables
) {
  const auto normal = marker.getSelectedFaceNumber() % DIMENSIONS;

  int iStride    = 0;
  int jStride    = 0;
  int sideStride = 0;

  switch (normal) {
  case 0:
    iStride    = 2;
    jStride    = 2 * numberOfDofsPerAxis;
    sideStride = 1;
    break;
  case 1:
    iStride    = 1;
    jStride    = 2 * numberOfDofsPerAxis;
    sideStride = numberOfDofsPerAxis;
    break;
  case 2:
    iStride    = 1;
    jStride    = numberOfDofsPerAxis;
    sideStride = numberOfDofsPerAxis * numberOfDofsPerAxis;
    break;
  default:
    assertion(false);
    break;
  }

#if DIMENSIONS == 3
  for (int j = 0; j < numberOfDofsPerAxis; j++) {
    int jPos = jStride * ((j + numberOfDofsPerAxis * marker.getRelativePositionWithinFatherFace()[1]) / 3);
#else
  const int j    = 0;
  const int jPos = 0;
  {
#endif
    for (int i = 0; i < numberOfDofsPerAxis; i++) {
      const auto iPos = iStride * ((i + numberOfDofsPerAxis * marker.getRelativePositionWithinFatherFace()[0]) / 3);

      for (int unknown = 0; unknown < numberOfUnknownsPlusAuxiliaryVariables; unknown++) {
        fineGridFaceValues
          [(side * sideStride + i * iStride + j * jStride) * numberOfUnknownsPlusAuxiliaryVariables + unknown] =
            coarseGridFaceValues[(side * sideStride + iPos + jPos) * numberOfUnknownsPlusAuxiliaryVariables + unknown];
      }
    }
  }
}

/**
 * Prolongs a coarse halo layer and corrects it along the axes in the plane of the face.
 *
 * Per coarse volume c_j and such an axis, the three fine sub-volumes become c_j - d,
 * c_j and c_j + d with d = (c_{j+1} - c_{j-1})/6 in the interior and d = (c_{j+1} - c_j)/3
 * or d = (c_j - c_{j-1})/3 at a patch end, where only one neighbour exists.
 */
template <typename T>
INLINE_METHOD void exahype2::amr::interpolateHaloLayerWithTangentialSlope(
  const peano4::dataview::FaceMarker& marker,
  const T* NOALIAS                    coarseGridFaceValues,
  T* NOALIAS                          fineGridFaceValues,
  const int                           side,
  const int                           numberOfDofsPerAxis,
  const int                           numberOfUnknownsPlusAuxiliaryVariables
) {
  static_assert(std::is_floating_point_v<T>, "The tangential slope requires a floating-point type.");

  interpolateHaloLayer(
    marker,
    coarseGridFaceValues,
    fineGridFaceValues,
    side,
    numberOfDofsPerAxis,
    numberOfUnknownsPlusAuxiliaryVariables
  );

  const auto normal = marker.getSelectedFaceNumber() % DIMENSIONS;

  int iStride    = 0;
  int jStride    = 0;
  int sideStride = 0;

  switch (normal) {
  case 0:
    iStride    = 2;
    jStride    = 2 * numberOfDofsPerAxis;
    sideStride = 1;
    break;
  case 1:
    iStride    = 1;
    jStride    = 2 * numberOfDofsPerAxis;
    sideStride = numberOfDofsPerAxis;
    break;
  case 2:
    iStride    = 1;
    jStride    = numberOfDofsPerAxis;
    sideStride = numberOfDofsPerAxis * numberOfDofsPerAxis;
    break;
  default:
    assertion(false);
    break;
  }

  // Returns the slope at the coarse volume, scaled to the fine-volume offset of one
  // third of the coarse spacing. The divisor 3*(right-left) covers the central
  // difference in the interior and the one-sided difference at a patch end.
  const auto slopeAt =
    [&](const int coarseVolume, const int volumeStride, const int baseOffset, const int unknown) -> T {
    const int left  = (coarseVolume - 1 >= 0) ? coarseVolume - 1 : coarseVolume;
    const int right = (coarseVolume + 1 < numberOfDofsPerAxis) ? coarseVolume + 1 : coarseVolume;
    if (left == right) {
      return static_cast<T>(0.0);
    }
    return (coarseGridFaceValues[(baseOffset + right * volumeStride) * numberOfUnknownsPlusAuxiliaryVariables + unknown]
            - coarseGridFaceValues
              [(baseOffset + left * volumeStride) * numberOfUnknownsPlusAuxiliaryVariables + unknown])
      / static_cast<T>(3 * (right - left));
  };

#if DIMENSIONS == 3
  for (int j = 0; j < numberOfDofsPerAxis; j++) {
    const int jGlobal      = j + numberOfDofsPerAxis * marker.getRelativePositionWithinFatherFace()[1];
    const int jCell        = jGlobal / 3;
    const int jSubPosition = jGlobal % 3;
#else
  const int j     = 0;
  const int jCell = 0;
  {
#endif
    for (int i = 0; i < numberOfDofsPerAxis; i++) {
      const int iGlobal      = i + numberOfDofsPerAxis * marker.getRelativePositionWithinFatherFace()[0];
      const int iCell        = iGlobal / 3;
      const int iSubPosition = iGlobal % 3;

      for (int unknown = 0; unknown < numberOfUnknownsPlusAuxiliaryVariables; unknown++) {
        const T iSlope = slopeAt(iCell, iStride, side * sideStride + jCell * jStride, unknown);
#if DIMENSIONS == 3
        const T jSlope = slopeAt(jCell, jStride, side * sideStride + iCell * iStride, unknown);
        // Each axis term rounds on its own before the commutative sum, so a diagonal
        // axis swap of the face commutes bitwise with the correction.
        const T iTerm      = static_cast<T>(iSubPosition - 1) * iSlope;
        const T jTerm      = static_cast<T>(jSubPosition - 1) * jSlope;
        const T correction = iTerm + jTerm;
#else
        const T correction = static_cast<T>(iSubPosition - 1) * iSlope;
#endif
        fineGridFaceValues
          [(side * sideStride + i * iStride + j * jStride) * numberOfUnknownsPlusAuxiliaryVariables + unknown] +=
          correction;
      }
    }
  }
}

template <typename T>
INLINE_METHOD void exahype2::amr::interpolateHaloLayerFromCoarseCell(
  const peano4::dataview::FaceMarker& marker,
  const T* NOALIAS                    coarseGridCellValues,
  T* NOALIAS                          fineGridFaceValues,
  const int                           side,
  const int                           numberOfDofsPerAxis,
  const int                           numberOfUnknownsPlusAuxiliaryVariables
) {
  const auto normal = marker.getSelectedFaceNumber() % DIMENSIONS;

  tarch::la::Vector<DIMENSIONS, int> faceIndices;
  int                                sideStride = 0;

  switch (normal) {
  case 0:
    faceIndices[0] = 0;
    faceIndices[1] = 2;
#if DIMENSIONS == 3
    faceIndices[2] = 2 * numberOfDofsPerAxis;
#endif
    sideStride = 1;
    break;
  case 1:
    faceIndices[0] = 1;
    faceIndices[1] = 0;
#if DIMENSIONS == 3
    faceIndices[2] = 2 * numberOfDofsPerAxis;
#endif
    sideStride = numberOfDofsPerAxis;
    break;
#if DIMENSIONS == 3
  case 2:
    faceIndices[0] = 1;
    faceIndices[1] = numberOfDofsPerAxis;
    faceIndices[2] = 0;
    sideStride     = numberOfDofsPerAxis * numberOfDofsPerAxis;
    break;
#endif
  default:
    assertion(false);
    break;
  }

  peano4::dForEachExclusive(numberOfDofsPerAxis, normal, 0, [&](const tarch::la::Vector<DIMENSIONS, int>& volumePos) {
    // The right halo (side 1) samples the first layer of the coarse sub-cell, the
    // left halo (side 0) the last layer of the preceding sub-cell. The exclusive
    // traversal pins volumePos[normal] to 0, so the side term supplies the whole
    // normal dependence.
    tarch::la::Vector<DIMENSIONS, int> coarseVolume;
    for (int axis = 0; axis < DIMENSIONS; axis++) {
      coarseVolume[axis] =
        (volumePos[axis] + numberOfDofsPerAxis * marker.getRelativePositionWithinFatherCell()[axis]) / 3;
    }
    coarseVolume[normal] =
      (numberOfDofsPerAxis * marker.getRelativePositionWithinFatherCell()[normal] - (1 - side)) / 3;

    const auto coarseGridPos = coarseVolume[0] + numberOfDofsPerAxis * coarseVolume[1]
#if DIMENSIONS == 3
      + numberOfDofsPerAxis * numberOfDofsPerAxis * coarseVolume[2]
#endif
      ;

    const auto fineGridPos = faceIndices[0] * volumePos[0] + faceIndices[1] * volumePos[1]
#if DIMENSIONS == 3
      + faceIndices[2] * volumePos[2]
#endif
      ;

    for (int unknown = 0; unknown < numberOfUnknownsPlusAuxiliaryVariables; unknown++) {
      fineGridFaceValues[(side * sideStride + fineGridPos) * numberOfUnknownsPlusAuxiliaryVariables + unknown] =
        coarseGridCellValues[(coarseGridPos)*numberOfUnknownsPlusAuxiliaryVariables + unknown];
    }
  });
}

/**
 * Averages a fine halo layer back onto the coarse face.
 *
 * The coarse face must contain all zeroes before the restriction, as the routine cannot
 * know in which order the fine faces restrict into it.
 */
template <typename T>
INLINE_METHOD void exahype2::amr::restrictHaloLayer(
  const peano4::dataview::FaceMarker& marker,
  T* NOALIAS                          coarseGridFaceValues,
  const T* NOALIAS                    fineGridFaceValues,
  const int                           side,
  const int                           numberOfDofsPerAxis,
  const int                           numberOfUnknownsPlusAuxiliaryVariables
) {
  static_assert(std::is_floating_point_v<T>, "Averaging restriction requires a floating-point type");
  const auto normal = marker.getSelectedFaceNumber() % DIMENSIONS;

  int iStride    = 0;
  int jStride    = 0;
  int sideStride = 0;

  switch (normal) {
  case 0:
    iStride    = 2;
    jStride    = 2 * numberOfDofsPerAxis;
    sideStride = 1;
    break;
  case 1:
    iStride    = 1;
    jStride    = 2 * numberOfDofsPerAxis;
    sideStride = numberOfDofsPerAxis;
    break;
  case 2:
    iStride    = 1;
    jStride    = numberOfDofsPerAxis;
    sideStride = numberOfDofsPerAxis * numberOfDofsPerAxis;
    break;
  default:
    assertion(false);
    break;
  }

#if DIMENSIONS == 3
  constexpr T Scale = 1. / 9.;
  for (int j = 0; j < numberOfDofsPerAxis; j++) {
    int jPos = jStride * ((j + numberOfDofsPerAxis * marker.getRelativePositionWithinFatherFace()[1]) / 3);
#else
  constexpr T Scale = 1. / 3.;
  const int   j     = 0;
  const int   jPos  = 0;
  {
#endif
    for (int i = 0; i < numberOfDofsPerAxis; i++) {
      const auto iPos = iStride * ((i + numberOfDofsPerAxis * marker.getRelativePositionWithinFatherFace()[0]) / 3);

      for (int unknown = 0; unknown < numberOfUnknownsPlusAuxiliaryVariables; unknown++) {
        coarseGridFaceValues[(side * sideStride + iPos + jPos) * numberOfUnknownsPlusAuxiliaryVariables + unknown] +=
          Scale
          * fineGridFaceValues
            [(side * sideStride + i * iStride + j * jStride) * numberOfUnknownsPlusAuxiliaryVariables + unknown];
      }
    }
  }
}

/**
 * Stages one hanging subface's half of a face for the gathered restriction.
 *
 * The subface's values of the given side copy into the stage's slot for the
 * subface's tangential position within the father face, in compact node order,
 * and the frame's tag records the side. The father face reduces every
 * staged subface in one call when the sweep leaves it, so the restriction
 * cannot depend on the order the traversal visits the subfaces.
 */
template <typename T>
INLINE_METHOD void exahype2::amr::stageHaloLayerForGatheredRestriction(
  const peano4::dataview::FaceMarker& marker,
  exahype2::amr::ChildDataStage<T>&   stage,
  const void*                         coarseFaceKey,
  const T* NOALIAS                    fineGridFaceValues,
  const int                           side,
  const int                           numberOfDofsPerAxis,
  const int                           numberOfUnknownsPlusAuxiliaryVariables
) {
  const auto normal = marker.getSelectedFaceNumber() % DIMENSIONS;

  int iStride    = 0;
  int jStride    = 0;
  int sideStride = 0;

  switch (normal) {
  case 0:
    iStride    = 2;
    jStride    = 2 * numberOfDofsPerAxis;
    sideStride = 1;
    break;
  case 1:
    iStride    = 1;
    jStride    = 2 * numberOfDofsPerAxis;
    sideStride = numberOfDofsPerAxis;
    break;
  case 2:
    iStride    = 1;
    jStride    = numberOfDofsPerAxis;
    sideStride = numberOfDofsPerAxis * numberOfDofsPerAxis;
    break;
  default:
    assertion(false);
    break;
  }

#if DIMENSIONS == 3
  const int subfaceIndex =
    marker.getRelativePositionWithinFatherFace()[0] + 3 * marker.getRelativePositionWithinFatherFace()[1];
#else
  const int subfaceIndex = marker.getRelativePositionWithinFatherFace()[0];
#endif
  T* const stagedValues = stage.claim(coarseFaceKey, subfaceIndex, side);

#if DIMENSIONS == 3
  for (int j = 0; j < numberOfDofsPerAxis; j++) {
#else
  const int j = 0;
  {
#endif
    for (int i = 0; i < numberOfDofsPerAxis; i++) {
      for (int unknown = 0; unknown < numberOfUnknownsPlusAuxiliaryVariables; unknown++) {
        stagedValues[(j * numberOfDofsPerAxis + i) * numberOfUnknownsPlusAuxiliaryVariables + unknown] =
          fineGridFaceValues
            [(side * sideStride + i * iStride + j * jStride) * numberOfUnknownsPlusAuxiliaryVariables + unknown];
      }
    }
  }
}

/**
 * Restricts one half of a face from its staged hanging subfaces.
 *
 * Every coarse volume of the tagged half averages its covering fine volumes
 * over all staged subfaces through an exact accumulator and scales once, so
 * mirrored subface sets restrict to bitwise mirrored halves whatever the
 * staging order. A subface another rank holds is absent and contributes
 * nothing. The frame is discarded afterwards.
 */
template <typename T>
INLINE_METHOD void exahype2::amr::restrictHaloLayerFromStagedSubfaces(
  exahype2::amr::ChildDataStage<T>& stage,
  const void*                       coarseFaceKey,
  T* NOALIAS                        coarseGridFaceValues,
  const int                         normal,
  const int                         numberOfDofsPerAxis,
  const int                         numberOfUnknownsPlusAuxiliaryVariables
) {
  int iStride    = 0;
  int jStride    = 0;
  int sideStride = 0;

  switch (normal) {
  case 0:
    iStride    = 2;
    jStride    = 2 * numberOfDofsPerAxis;
    sideStride = 1;
    break;
  case 1:
    iStride    = 1;
    jStride    = 2 * numberOfDofsPerAxis;
    sideStride = numberOfDofsPerAxis;
    break;
  case 2:
    iStride    = 1;
    jStride    = numberOfDofsPerAxis;
    sideStride = numberOfDofsPerAxis * numberOfDofsPerAxis;
    break;
  default:
    assertion(false);
    break;
  }

  const int side = stage.frameTag(coarseFaceKey);
#if DIMENSIONS == 3
  constexpr double RestrictionScale = 1.0 / 9.0;
#else
  constexpr double RestrictionScale = 1.0 / 3.0;
#endif

  tarch::la::ExactAccumulator accumulator;
#if DIMENSIONS == 3
  for (int coarseJ = 0; coarseJ < numberOfDofsPerAxis; coarseJ++) {
#else
  const int coarseJ = 0;
  {
#endif
    for (int coarseI = 0; coarseI < numberOfDofsPerAxis; coarseI++) {
      for (int unknown = 0; unknown < numberOfUnknownsPlusAuxiliaryVariables; unknown++) {
        accumulator.clear();
#if DIMENSIONS == 3
        for (int offsetJ = 0; offsetJ < 3; offsetJ++) {
          const int globalJ  = 3 * coarseJ + offsetJ;
          const int subfaceJ = globalJ / numberOfDofsPerAxis;
          const int fineJ    = globalJ % numberOfDofsPerAxis;
#else
        const int subfaceJ = 0;
        const int fineJ    = 0;
        {
#endif
          for (int offsetI = 0; offsetI < 3; offsetI++) {
            const int globalI      = 3 * coarseI + offsetI;
            const int subfaceI     = globalI / numberOfDofsPerAxis;
            const int fineI        = globalI % numberOfDofsPerAxis;
            const int subfaceIndex = subfaceJ * 3 + subfaceI;
            if (not stage.hasChild(coarseFaceKey, subfaceIndex)) {
              continue;
            }
            const T* const subfaceValues = stage.child(coarseFaceKey, subfaceIndex);
            accumulator.add(
              static_cast<double>(
                subfaceValues[(fineJ * numberOfDofsPerAxis + fineI) * numberOfUnknownsPlusAuxiliaryVariables + unknown]
              )
            );
          }
        }
        coarseGridFaceValues
          [(side * sideStride + coarseI * iStride + coarseJ * jStride) * numberOfUnknownsPlusAuxiliaryVariables
           + unknown] = static_cast<T>(accumulator.round() * RestrictionScale);
      }
    }
  }
  stage.discard(coarseFaceKey);
}

/**
 * Restricts one half of a face from its staged hanging subfaces with the
 * mass-lumped projection operator.
 *
 * Entry [b * n * n + coarse * n + fine] of restrictionMatrix1D is the coarse
 * one-dimensional shape function at the fine node of child interval b, divided
 * by three; each fine node carries its quadrature weight divided by the coarse
 * node's weight, which makes the sum the mass-lumped L2 projection of the fine
 * trace. The matrices and weights must be mirror symmetric to the last bit for
 * mirrored subface sets to restrict to bitwise mirrored halves. A subface
 * another rank holds is absent and contributes nothing, and the frame is
 * discarded afterwards.
 */
template <typename T>
INLINE_METHOD void exahype2::amr::restrictHaloLayerFromStagedSubfaces(
  exahype2::amr::ChildDataStage<T>& stage,
  const void*                       coarseFaceKey,
  T* NOALIAS                        coarseGridFaceValues,
  const double* NOALIAS             restrictionMatrix1D,
  const double* NOALIAS             quadratureWeights1D,
  const int                         normal,
  const int                         numberOfDofsPerAxis,
  const int                         numberOfUnknownsPlusAuxiliaryVariables
) {
  int iStride    = 0;
  int jStride    = 0;
  int sideStride = 0;

  switch (normal) {
  case 0:
    iStride    = 2;
    jStride    = 2 * numberOfDofsPerAxis;
    sideStride = 1;
    break;
  case 1:
    iStride    = 1;
    jStride    = 2 * numberOfDofsPerAxis;
    sideStride = numberOfDofsPerAxis;
    break;
  case 2:
    iStride    = 1;
    jStride    = numberOfDofsPerAxis;
    sideStride = numberOfDofsPerAxis * numberOfDofsPerAxis;
    break;
  default:
    assertion(false);
    break;
  }

  const int side                       = stage.frameTag(coarseFaceKey);
  const int numberOfEntriesPerInterval = numberOfDofsPerAxis * numberOfDofsPerAxis;

  tarch::la::ExactAccumulator accumulator;
#if DIMENSIONS == 3
  for (int coarseJ = 0; coarseJ < numberOfDofsPerAxis; coarseJ++) {
#else
  const int coarseJ = 0;
  {
#endif
    for (int coarseI = 0; coarseI < numberOfDofsPerAxis; coarseI++) {
      for (int unknown = 0; unknown < numberOfUnknownsPlusAuxiliaryVariables; unknown++) {
        accumulator.clear();
#if DIMENSIONS == 3
        for (int subfaceJ = 0; subfaceJ < 3; subfaceJ++) {
#else
        const int subfaceJ = 0;
        {
#endif
          for (int subfaceI = 0; subfaceI < 3; subfaceI++) {
            const int subfaceIndex = subfaceJ * 3 + subfaceI;
            if (not stage.hasChild(coarseFaceKey, subfaceIndex)) {
              continue;
            }
            const T* const subfaceValues = stage.child(coarseFaceKey, subfaceIndex);
#if DIMENSIONS == 3
            for (int fineJ = 0; fineJ < numberOfDofsPerAxis; fineJ++) {
#else
            const int fineJ = 0;
            {
#endif
              for (int fineI = 0; fineI < numberOfDofsPerAxis; fineI++) {
#if DIMENSIONS == 3
                const double
                  weight =
                    (restrictionMatrix1D[subfaceI * numberOfEntriesPerInterval + coarseI * numberOfDofsPerAxis + fineI]
                     * quadratureWeights1D[fineI] / quadratureWeights1D[coarseI])
                  * (restrictionMatrix1D[subfaceJ * numberOfEntriesPerInterval + coarseJ * numberOfDofsPerAxis + fineJ]
                     * quadratureWeights1D[fineJ] / quadratureWeights1D[coarseJ]);
#else
                const double weight =
                  restrictionMatrix1D[subfaceI * numberOfEntriesPerInterval + coarseI * numberOfDofsPerAxis + fineI]
                  * quadratureWeights1D[fineI] / quadratureWeights1D[coarseI];
#endif
                accumulator.add(
                  weight
                  * static_cast<double>(
                    subfaceValues
                      [(fineJ * numberOfDofsPerAxis + fineI) * numberOfUnknownsPlusAuxiliaryVariables + unknown]
                  )
                );
              }
            }
          }
        }
        coarseGridFaceValues
          [(side * sideStride + coarseI * iStride + coarseJ * jStride) * numberOfUnknownsPlusAuxiliaryVariables
           + unknown] = static_cast<T>(accumulator.round());
      }
    }
  }
  stage.discard(coarseFaceKey);
}

template <typename T>
INLINE_METHOD void exahype2::amr::interpolateCell(
  const peano4::dataview::CellMarker& marker,
  const T* NOALIAS                    coarseGridValues,
  T* NOALIAS                          fineGridValues,
  const int                           numberOfDofsPerAxis,
  const int                           numberOfUnknownsPlusAuxiliaryVariables
) {
#if DIMENSIONS == 3
  for (int z = 0; z < numberOfDofsPerAxis; z++) {
    const auto zPos = numberOfDofsPerAxis * numberOfDofsPerAxis
      * ((z + numberOfDofsPerAxis * marker.getRelativePositionWithinFatherCell()[2]) / 3);
#else
  {
    const int z    = 0;
    const int zPos = 0;
#endif
    for (int y = 0; y < numberOfDofsPerAxis; y++) {
      const auto yPos =
        numberOfDofsPerAxis * ((y + numberOfDofsPerAxis * marker.getRelativePositionWithinFatherCell()[1]) / 3);
      for (int x = 0; x < numberOfDofsPerAxis; x++) {
        const auto xPos = (x + numberOfDofsPerAxis * marker.getRelativePositionWithinFatherCell()[0]) / 3;
        for (int unknown = 0; unknown < numberOfUnknownsPlusAuxiliaryVariables; unknown++) {
          fineGridValues
            [(z * numberOfDofsPerAxis * numberOfDofsPerAxis + y * numberOfDofsPerAxis + x)
               * numberOfUnknownsPlusAuxiliaryVariables
             + unknown] = coarseGridValues[(zPos + yPos + xPos) * numberOfUnknownsPlusAuxiliaryVariables + unknown];
        }
      }
    }
  }
}

/**
 * Interpolates nodal cell data with a matrix-based operator.
 *
 * Entry [b * n * n + fine * n + coarse] of interpolationMatrix1D is the coarse
 * one-dimensional shape function at the fine node of child interval b of the triadic
 * subdivision. The multidimensional evaluation is the tensor product of the per-axis
 * entries, so every polynomial the coarse basis represents is reproduced exactly on
 * the child.
 */
template <typename T>
INLINE_METHOD void exahype2::amr::interpolateCell(
  const peano4::dataview::CellMarker& marker,
  const T* NOALIAS                    coarseGridValues,
  T* NOALIAS                          fineGridValues,
  const double* NOALIAS               interpolationMatrix1D,
  const int                           numberOfDofsPerAxis,
  const int                           numberOfUnknownsPlusAuxiliaryVariables
) {
  const auto subcellIndex = marker.getRelativePositionWithinFatherCell();
  peano4::dForEach(numberOfDofsPerAxis, [&](const tarch::la::Vector<DIMENSIONS, int>& fineNode) {
    const int fineIndex = peano4::dLinearised(fineNode, numberOfDofsPerAxis) * numberOfUnknownsPlusAuxiliaryVariables;
    for (int unknown = 0; unknown < numberOfUnknownsPlusAuxiliaryVariables; unknown++) {
      fineGridValues[fineIndex + unknown] = 0.0;
    }
    peano4::dForEach(numberOfDofsPerAxis, [&](const tarch::la::Vector<DIMENSIONS, int>& coarseNode) {
      double weight = 1.0;
      for (int axis = 0; axis < DIMENSIONS; axis++) {
        weight *= interpolationMatrix1D
          [subcellIndex(axis) * numberOfDofsPerAxis * numberOfDofsPerAxis + fineNode(axis) * numberOfDofsPerAxis
           + coarseNode(axis)];
      }
      const int coarseIndex =
        peano4::dLinearised(coarseNode, numberOfDofsPerAxis) * numberOfUnknownsPlusAuxiliaryVariables;
      // The matrix holds doubles whatever the patch is stored in, so the product forms in
      // double and only the stored result narrows back to T.
      for (int unknown = 0; unknown < numberOfUnknownsPlusAuxiliaryVariables; unknown++) {
        const double accumulated = static_cast<double>(fineGridValues[fineIndex + unknown])
          + weight * static_cast<double>(coarseGridValues[coarseIndex + unknown]);
        fineGridValues[fineIndex + unknown] = static_cast<T>(accumulated);
      }
    });
  });
}

/**
 * Averages the fine cell values back onto the coarse cell.
 *
 * The coarse cell must contain all zeroes before the restriction, as the routine cannot
 * know in which order the fine cells restrict into it.
 */
template <typename T>
INLINE_METHOD void exahype2::amr::restrictCell(
  const peano4::dataview::CellMarker& marker,
  T* NOALIAS                          coarseGridValues,
  const T* NOALIAS                    fineGridValues,
  const int                           numberOfDofsPerAxis,
  const int                           numberOfUnknownsPlusAuxiliaryVariables
) {
  static_assert(std::is_floating_point_v<T>, "Averaging restriction requires a floating-point type");
#if DIMENSIONS == 3
  constexpr T Scale = 1. / 27.;
  for (int z = 0; z < numberOfDofsPerAxis; z++) {
    const auto zPos = numberOfDofsPerAxis * numberOfDofsPerAxis
      * ((z + numberOfDofsPerAxis * marker.getRelativePositionWithinFatherCell()[2]) / 3);
#else
  constexpr T Scale = 1. / 9.;
  {
    const int z    = 0;
    const int zPos = 0;
#endif
    for (int y = 0; y < numberOfDofsPerAxis; y++) {
      const auto yPos =
        numberOfDofsPerAxis * ((y + numberOfDofsPerAxis * marker.getRelativePositionWithinFatherCell()[1]) / 3);
      for (int x = 0; x < numberOfDofsPerAxis; x++) {
        const auto xPos = (x + numberOfDofsPerAxis * marker.getRelativePositionWithinFatherCell()[0]) / 3;
        for (int unknown = 0; unknown < numberOfUnknownsPlusAuxiliaryVariables; unknown++) {
          coarseGridValues[(zPos + yPos + xPos) * numberOfUnknownsPlusAuxiliaryVariables + unknown] += Scale
            * fineGridValues[(z * numberOfDofsPerAxis * numberOfDofsPerAxis + y * numberOfDofsPerAxis + x)
                               * numberOfUnknownsPlusAuxiliaryVariables
                             + unknown];
        }
      }
    }
  }
}

/**
 * Restricts nodal cell data with a matrix-based operator.
 *
 * Entry [b * n * n + coarse * n + fine] of restrictionMatrix1D is the coarse
 * one-dimensional shape function at the fine node of child interval b, divided by
 * three; each fine node carries its quadrature weight divided by the coarse node's
 * weight, which makes the sum over all 3^d children the mass-lumped L2 projection.
 * The coarse cell must contain all zeroes before its first child restricts into it.
 */
template <typename T>
INLINE_METHOD void exahype2::amr::restrictCell(
  const peano4::dataview::CellMarker& marker,
  T* NOALIAS                          coarseGridValues,
  const T* NOALIAS                    fineGridValues,
  const double* NOALIAS               restrictionMatrix1D,
  const double* NOALIAS               quadratureWeights1D,
  const int                           numberOfDofsPerAxis,
  const int                           numberOfUnknownsPlusAuxiliaryVariables
) {
  static_assert(std::is_floating_point_v<T>, "The mass-lumped projection requires a floating-point type");
  const auto subcellIndex = marker.getRelativePositionWithinFatherCell();
  peano4::dForEach(numberOfDofsPerAxis, [&](const tarch::la::Vector<DIMENSIONS, int>& coarseNode) {
    const int coarseIndex =
      peano4::dLinearised(coarseNode, numberOfDofsPerAxis) * numberOfUnknownsPlusAuxiliaryVariables;
    peano4::dForEach(numberOfDofsPerAxis, [&](const tarch::la::Vector<DIMENSIONS, int>& fineNode) {
      double weight = 1.0;
      for (int axis = 0; axis < DIMENSIONS; axis++) {
        weight *= restrictionMatrix1D
                    [subcellIndex(axis) * numberOfDofsPerAxis * numberOfDofsPerAxis
                     + coarseNode(axis) * numberOfDofsPerAxis + fineNode(axis)]
          * quadratureWeights1D[fineNode(axis)] / quadratureWeights1D[coarseNode(axis)];
      }
      const int fineIndex = peano4::dLinearised(fineNode, numberOfDofsPerAxis) * numberOfUnknownsPlusAuxiliaryVariables;
      // The matrix holds doubles whatever the patch is stored in, so the product forms in
      // double and only the stored result narrows back to T.
      for (int unknown = 0; unknown < numberOfUnknownsPlusAuxiliaryVariables; unknown++) {
        const double accumulated = static_cast<double>(coarseGridValues[coarseIndex + unknown])
          + weight * static_cast<double>(fineGridValues[fineIndex + unknown]);
        coarseGridValues[coarseIndex + unknown] = static_cast<T>(accumulated);
      }
    });
  });
}

/**
 * Multiplies three factors in ascending value order.
 *
 * A grid symmetry that swaps axes permutes the per-axis factors of a
 * tensor-product weight; multiplying them in a value-canonical order keeps the
 * rounded product identical for every permutation.
 */
INLINE_METHOD double exahype2::amr::orderInvariantProduct(double firstFactor, double secondFactor, double thirdFactor) {
  auto low    = firstFactor;
  auto middle = secondFactor;
  auto high   = thirdFactor;
  if (low > middle) {
    std::swap(low, middle);
  }
  if (middle > high) {
    std::swap(middle, high);
  }
  if (low > middle) {
    std::swap(low, middle);
  }
  return (low * middle) * high;
}

/**
 * Applies a separable operator through symmetry-invariant sums.
 *
 * Every target degree of freedom contracts the whole source patch against the
 * tensor product of the per-axis matrix entries, with entry
 * matrixPerAxis[axis][source * numberOfTargetDofsPerAxis + target]. The per-axis
 * factors combine through a value-canonical product and the terms sum through
 * an exact accumulator, so a reflection or axis swap of the patch maps the
 * computation onto itself term by term. The matrices must be mirror symmetric to
 * the last bit for mirrored data to yield the bitwise mirrored result.
 */
template <typename T>
INLINE_METHOD void exahype2::amr::applyTensorProductOrderInvariant(
  T* NOALIAS                   targetValues,
  const T* NOALIAS             sourceValues,
  const double* const* NOALIAS matrixPerAxis,
  const int                    numberOfSourceDofsPerAxis,
  const int                    numberOfTargetDofsPerAxis,
  const int                    numberOfUnknownsPlusAuxiliaryVariables
) {
  tarch::la::ExactAccumulator accumulator;
  peano4::dForEach(numberOfTargetDofsPerAxis, [&](const tarch::la::Vector<DIMENSIONS, int>& targetDof) {
    const int targetIndex =
      peano4::dLinearised(targetDof, numberOfTargetDofsPerAxis) * numberOfUnknownsPlusAuxiliaryVariables;
    for (int unknown = 0; unknown < numberOfUnknownsPlusAuxiliaryVariables; unknown++) {
      accumulator.clear();
      peano4::dForEach(numberOfSourceDofsPerAxis, [&](const tarch::la::Vector<DIMENSIONS, int>& sourceDof) {
#if DIMENSIONS == 2
        const double weight = matrixPerAxis[0][sourceDof(0) * numberOfTargetDofsPerAxis + targetDof(0)]
          * matrixPerAxis[1][sourceDof(1) * numberOfTargetDofsPerAxis + targetDof(1)];
#else
        const double weight = exahype2::amr::orderInvariantProduct(
          matrixPerAxis[0][sourceDof(0) * numberOfTargetDofsPerAxis + targetDof(0)],
          matrixPerAxis[1][sourceDof(1) * numberOfTargetDofsPerAxis + targetDof(1)],
          matrixPerAxis[2][sourceDof(2) * numberOfTargetDofsPerAxis + targetDof(2)]
        );
#endif
        const int sourceIndex =
          peano4::dLinearised(sourceDof, numberOfSourceDofsPerAxis) * numberOfUnknownsPlusAuxiliaryVariables;
        accumulator.add(weight * static_cast<double>(sourceValues[sourceIndex + unknown]));
      });
      targetValues[targetIndex + unknown] = static_cast<T>(accumulator.round());
    }
  });
}

/**
 * Restricts a complete sibling set onto the coarse cell with a mass-lumped operator.
 *
 * The caller collects all 3^d destroyed children, indexed by their linearised
 * position within the father, and hands them over in one call. Every coarse
 * node then sums the weighted contributions of every fine node of every child
 * through an exact accumulator, so the result does not depend on the order in
 * which the traversal destroyed the children, and mirrored sibling sets
 * restrict to bitwise mirrored coarse cells. The per-interval matrices hold
 * the weighted restriction operator with entry [fine * numberOfDofsPerAxis +
 * coarse] and must be mirror symmetric to the last bit.
 */
template <typename T>
INLINE_METHOD void exahype2::amr::restrictCellFromChildren(
  T* NOALIAS                   coarseGridValues,
  const T* const* NOALIAS      childGridValues,
  const double* const* NOALIAS restrictionMatrixPerInterval,
  const int                    numberOfDofsPerAxis,
  const int                    numberOfUnknownsPlusAuxiliaryVariables
) {
  tarch::la::ExactAccumulator accumulator;
  peano4::dForEach(numberOfDofsPerAxis, [&](const tarch::la::Vector<DIMENSIONS, int>& coarseNode) {
    const int coarseIndex =
      peano4::dLinearised(coarseNode, numberOfDofsPerAxis) * numberOfUnknownsPlusAuxiliaryVariables;
    for (int unknown = 0; unknown < numberOfUnknownsPlusAuxiliaryVariables; unknown++) {
      accumulator.clear();
      peano4::dForEach(3, [&](const tarch::la::Vector<DIMENSIONS, int>& childPosition) {
        const auto* const childValues = childGridValues[peano4::dLinearised(childPosition, 3)];
        peano4::dForEach(numberOfDofsPerAxis, [&](const tarch::la::Vector<DIMENSIONS, int>& fineNode) {
#if DIMENSIONS == 2
          const double weight =
            restrictionMatrixPerInterval[childPosition(0)][fineNode(0) * numberOfDofsPerAxis + coarseNode(0)]
            * restrictionMatrixPerInterval[childPosition(1)][fineNode(1) * numberOfDofsPerAxis + coarseNode(1)];
#else
          const double weight = exahype2::amr::orderInvariantProduct(
            restrictionMatrixPerInterval[childPosition(0)][fineNode(0) * numberOfDofsPerAxis + coarseNode(0)],
            restrictionMatrixPerInterval[childPosition(1)][fineNode(1) * numberOfDofsPerAxis + coarseNode(1)],
            restrictionMatrixPerInterval[childPosition(2)][fineNode(2) * numberOfDofsPerAxis + coarseNode(2)]
          );
#endif
          const int fineIndex =
            peano4::dLinearised(fineNode, numberOfDofsPerAxis) * numberOfUnknownsPlusAuxiliaryVariables;
          accumulator.add(weight * static_cast<double>(childValues[fineIndex + unknown]));
        });
      });
      coarseGridValues[coarseIndex + unknown] = static_cast<T>(accumulator.round());
    }
  });
}

/**
 * Restricts a complete sibling set onto the coarse cell by averaging.
 *
 * The caller collects all 3^d destroyed children, indexed by their linearised
 * position within the father, and hands them over in one call. Every coarse
 * volume averages its 3^d covering fine volumes, which reach across child
 * boundaries when the patch size is no multiple of three. An exact accumulator
 * adds the fine values and applies the scale once at the end, so the result does
 * not depend on the order in which the traversal destroyed the children, and
 * mirrored sibling sets restrict to bitwise mirrored coarse cells.
 */
template <typename T>
INLINE_METHOD void exahype2::amr::restrictCellFromChildren(
  T* NOALIAS              coarseGridValues,
  const T* const* NOALIAS childGridValues,
  const int               numberOfDofsPerAxis,
  const int               numberOfUnknownsPlusAuxiliaryVariables
) {
#if DIMENSIONS == 2
  constexpr double RestrictionScale = 1.0 / 9.0;
#else
  constexpr double RestrictionScale = 1.0 / 27.0;
#endif
  tarch::la::ExactAccumulator accumulator;
  peano4::dForEach(numberOfDofsPerAxis, [&](const tarch::la::Vector<DIMENSIONS, int>& coarseVolume) {
    const int coarseIndex =
      peano4::dLinearised(coarseVolume, numberOfDofsPerAxis) * numberOfUnknownsPlusAuxiliaryVariables;
    for (int unknown = 0; unknown < numberOfUnknownsPlusAuxiliaryVariables; unknown++) {
      accumulator.clear();
      peano4::dForEach(3, [&](const tarch::la::Vector<DIMENSIONS, int>& fineOffset) {
        tarch::la::Vector<DIMENSIONS, int> childPosition;
        tarch::la::Vector<DIMENSIONS, int> fineVolume;
        for (int axis = 0; axis < DIMENSIONS; axis++) {
          const int globalFineVolume = 3 * coarseVolume(axis) + fineOffset(axis);
          childPosition(axis)        = globalFineVolume / numberOfDofsPerAxis;
          fineVolume(axis)           = globalFineVolume % numberOfDofsPerAxis;
        }
        const auto* const childValues = childGridValues[peano4::dLinearised(childPosition, 3)];
        accumulator.add(
          static_cast<double>(
            childValues
              [peano4::dLinearised(fineVolume, numberOfDofsPerAxis) * numberOfUnknownsPlusAuxiliaryVariables + unknown]
          )
        );
      });
      coarseGridValues[coarseIndex + unknown] = static_cast<T>(accumulator.round() * RestrictionScale);
    }
  });
}

/**
 * Interpolates one hanging subface's half of a face from the coarse face it
 * hangs below.
 *
 * The caller selects, per tangential axis, the prolongation operator of the
 * subface's interval within the father face, with entry
 * [coarse * numberOfDofsPerAxis + fine]. Every fine node contracts the whole
 * coarse face half, the per-axis factors combine through a commutative product
 * and the terms sum through an exact accumulator, so mirrored coarse faces
 * interpolate to bitwise mirrored subfaces. The matrices must be mirror
 * symmetric to the last bit for that to hold.
 */
template <typename T>
INLINE_METHOD void exahype2::amr::interpolateFaceFromCoarse(
  T* NOALIAS                   fineFaceValues,
  const T* NOALIAS             coarseFaceValues,
  const double* const* NOALIAS prolongationMatrixPerAxis,
  const int                    numberOfDofsPerAxis,
  const int                    numberOfUnknownsPlusAuxiliaryVariables
) {
  tarch::la::ExactAccumulator accumulator;
#if DIMENSIONS == 2
  for (int fineNode = 0; fineNode < numberOfDofsPerAxis; fineNode++) {
    for (int unknown = 0; unknown < numberOfUnknownsPlusAuxiliaryVariables; unknown++) {
      accumulator.clear();
      for (int coarseNode = 0; coarseNode < numberOfDofsPerAxis; coarseNode++) {
        accumulator.add(
          prolongationMatrixPerAxis[0][coarseNode * numberOfDofsPerAxis + fineNode]
          * static_cast<double>(coarseFaceValues[coarseNode * numberOfUnknownsPlusAuxiliaryVariables + unknown])
        );
      }
      fineFaceValues[fineNode * numberOfUnknownsPlusAuxiliaryVariables + unknown] = static_cast<T>(accumulator.round());
    }
  }
#else
  for (int fineOuter = 0; fineOuter < numberOfDofsPerAxis; fineOuter++) {
    for (int fineInner = 0; fineInner < numberOfDofsPerAxis; fineInner++) {
      const int fineIndex = (fineOuter * numberOfDofsPerAxis + fineInner) * numberOfUnknownsPlusAuxiliaryVariables;
      for (int unknown = 0; unknown < numberOfUnknownsPlusAuxiliaryVariables; unknown++) {
        accumulator.clear();
        for (int coarseOuter = 0; coarseOuter < numberOfDofsPerAxis; coarseOuter++) {
          for (int coarseInner = 0; coarseInner < numberOfDofsPerAxis; coarseInner++) {
            const double weight = prolongationMatrixPerAxis[0][coarseInner * numberOfDofsPerAxis + fineInner]
              * prolongationMatrixPerAxis[1][coarseOuter * numberOfDofsPerAxis + fineOuter];
            accumulator.add(
              weight
              * static_cast<double>(
                coarseFaceValues
                  [(coarseOuter * numberOfDofsPerAxis + coarseInner) * numberOfUnknownsPlusAuxiliaryVariables + unknown]
              )
            );
          }
        }
        fineFaceValues[fineIndex + unknown] = static_cast<T>(accumulator.round());
      }
    }
  }
#endif
}

/**
 * Restricts one half of a face from its collected hanging subfaces.
 *
 * The caller stages the subface values it holds, indexed by their linearised
 * tangential position within the father face, and hands them over in one call
 * once the sweep leaves the face. Every coarse node sums the weighted
 * contributions of every fine node of every present subface through an exact
 * accumulator, and a null child stands for a subface another tree holds and
 * contributes nothing. The per-interval matrices use entry
 * [fine * numberOfDofsPerAxis + coarse] and must be mirror symmetric to the last
 * bit.
 */
template <typename T>
INLINE_METHOD void exahype2::amr::restrictFaceFromChildren(
  T* NOALIAS                   coarseFaceValues,
  const T* const* NOALIAS      childFaceValues,
  const double* const* NOALIAS restrictionMatrixPerInterval,
  const int                    numberOfDofsPerAxis,
  const int                    numberOfUnknownsPlusAuxiliaryVariables
) {
  tarch::la::ExactAccumulator accumulator;
#if DIMENSIONS == 2
  for (int coarseNode = 0; coarseNode < numberOfDofsPerAxis; coarseNode++) {
    for (int unknown = 0; unknown < numberOfUnknownsPlusAuxiliaryVariables; unknown++) {
      accumulator.clear();
      for (int subface = 0; subface < 3; subface++) {
        if (childFaceValues[subface] == nullptr) {
          continue;
        }
        for (int fineNode = 0; fineNode < numberOfDofsPerAxis; fineNode++) {
          accumulator.add(
            restrictionMatrixPerInterval[subface][fineNode * numberOfDofsPerAxis + coarseNode]
            * static_cast<double>(childFaceValues[subface][fineNode * numberOfUnknownsPlusAuxiliaryVariables + unknown])
          );
        }
      }
      coarseFaceValues[coarseNode * numberOfUnknownsPlusAuxiliaryVariables + unknown] =
        static_cast<T>(accumulator.round());
    }
  }
#else
  for (int coarseOuter = 0; coarseOuter < numberOfDofsPerAxis; coarseOuter++) {
    for (int coarseInner = 0; coarseInner < numberOfDofsPerAxis; coarseInner++) {
      const int coarseIndex =
        (coarseOuter * numberOfDofsPerAxis + coarseInner) * numberOfUnknownsPlusAuxiliaryVariables;
      for (int unknown = 0; unknown < numberOfUnknownsPlusAuxiliaryVariables; unknown++) {
        accumulator.clear();
        for (int subfaceOuter = 0; subfaceOuter < 3; subfaceOuter++) {
          for (int subfaceInner = 0; subfaceInner < 3; subfaceInner++) {
            const auto* const subfaceValues = childFaceValues[subfaceOuter * 3 + subfaceInner];
            if (subfaceValues == nullptr) {
              continue;
            }
            for (int fineOuter = 0; fineOuter < numberOfDofsPerAxis; fineOuter++) {
              for (int fineInner = 0; fineInner < numberOfDofsPerAxis; fineInner++) {
                const double weight =
                  restrictionMatrixPerInterval[subfaceInner][fineInner * numberOfDofsPerAxis + coarseInner]
                  * restrictionMatrixPerInterval[subfaceOuter][fineOuter * numberOfDofsPerAxis + coarseOuter];
                accumulator.add(
                  weight
                  * static_cast<double>(
                    subfaceValues
                      [(fineOuter * numberOfDofsPerAxis + fineInner) * numberOfUnknownsPlusAuxiliaryVariables + unknown]
                  )
                );
              }
            }
          }
        }
        coarseFaceValues[coarseIndex + unknown] = static_cast<T>(accumulator.round());
      }
    }
  }
#endif
}
