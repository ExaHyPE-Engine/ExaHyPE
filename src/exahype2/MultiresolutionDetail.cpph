#include "peano4/Loop.h"
#include "tarch/Assertions.h"
#include "tarch/Sort.h"
#include "tarch/la/Vector.h"

template <std::size_t NumberOfVolumesPerAxis>
INLINE_METHOD GPU_CALLABLE_METHOD constexpr std::array<double, NumberOfVolumesPerAxis>
exahype2::getVolumeCentresInUnitInterval() {
  const double                               inverseNumberOfVolumes = 1.0 / static_cast<double>(NumberOfVolumesPerAxis);
  std::array<double, NumberOfVolumesPerAxis> centres{};
  for (std::size_t volume = 0; volume < NumberOfVolumesPerAxis; volume++) {
    centres[volume] = (static_cast<double>(volume) + 0.5) * inverseNumberOfVolumes;
  }
  return centres;
}

/**
 * Returns the largest relative residual max_v |s(v) - s_hat(v)| / (|s(v)| + floor) of the
 * least-squares affine fit s_hat to the indicator s over the AoS patch Q. The node positions in
 * nodesInUnitInterval lie in [0,1] and are symmetric about one half. A reflected or axis-swapped
 * patch returns the bitwise identical detail if the indicator is invariant under that change.
 */
template <std::size_t NumberOfNodesPerAxis, typename Value, typename Indicator>
INLINE_METHOD GPU_CALLABLE_METHOD double
exahype2::computeMultiresolutionDetail(
  const Value* const NOALIAS                      Q,
  const std::array<double, NumberOfNodesPerAxis>& nodesInUnitInterval,
  const int                                       numberOfUnknownsPlusAuxiliaryVariables,
  const Indicator&                                indicator,
  const double                                    floor
) {
  static_assert(NumberOfNodesPerAxis > 0);
  assertion(Q != nullptr);
  assertion(numberOfUnknownsPlusAuxiliaryVariables > 0, numberOfUnknownsPlusAuxiliaryVariables);
  assertion(floor > 0.0, floor);

  if constexpr (NumberOfNodesPerAxis < 2) {
    return 0.0;
  }

  constexpr int NumberOfNodes   = static_cast<int>(NumberOfNodesPerAxis);
  constexpr int NumberOfVolumes = peano4::power(NumberOfNodes, DIMENSIONS);

  // The upper half negates the lower half, so the coordinates are antisymmetric to the last bit.
  double nodeCoordinate[NumberOfNodes];
  for (int i = 0; i < NumberOfNodes / 2; i++) {
    assertion(nodesInUnitInterval[i] >= 0.0 and nodesInUnitInterval[i] <= 1.0, i, nodesInUnitInterval[i]);
    nodeCoordinate[i]                     = nodesInUnitInterval[i] - 0.5;
    nodeCoordinate[NumberOfNodes - 1 - i] = -(nodesInUnitInterval[i] - 0.5);
  }
  if constexpr (NumberOfNodes % 2 == 1) {
    nodeCoordinate[NumberOfNodes / 2] = 0.0;
  }

  // The slope denominator is the same for every axis. Mirrored coordinates square to the same
  // bits, so its sum needs no sorting.
  double nodeCoordinateSquareSum = 0.0;
  for (int i = 0; i < NumberOfNodes; i++) {
    nodeCoordinateSquareSum += nodeCoordinate[i] * nodeCoordinate[i];
  }
  const double slopeDenominator =
    (static_cast<double>(NumberOfVolumes) / static_cast<double>(NumberOfNodes)) * nodeCoordinateSquareSum;

  double values[NumberOfVolumes];
  bool   allValuesAreFinite = true;
  peano4::dForEach(NumberOfNodes, [&](const tarch::la::Vector<DIMENSIONS, int>& counter) {
    const int    linearised = peano4::dLinearised(counter, NumberOfNodes);
    const double value      = indicator(Q + linearised * numberOfUnknownsPlusAuxiliaryVariables);
    values[linearised]      = value;
    allValuesAreFinite      = allValuesAreFinite and std::isfinite(value);
  });

  if (not allValuesAreFinite) {
    return std::numeric_limits<double>::infinity();
  }

  // The sorted summation fixes the addition order, so the values permuted by a reflection or an
  // axis swap give the bitwise identical sum.
  double scratch[NumberOfVolumes];
  for (int i = 0; i < NumberOfVolumes; i++) {
    scratch[i] = values[i];
  }
  tarch::sortAscending(scratch, NumberOfVolumes);
  double indicatorSum = 0.0;
  for (int i = 0; i < NumberOfVolumes; i++) {
    indicatorSum += scratch[i];
  }
  const double mean = indicatorSum / static_cast<double>(NumberOfVolumes);

  double slope[DIMENSIONS];
  for (int d = 0; d < DIMENSIONS; d++) {
    peano4::dForEach(NumberOfNodes, [&](const tarch::la::Vector<DIMENSIONS, int>& counter) {
      const int linearised = peano4::dLinearised(counter, NumberOfNodes);
      scratch[linearised]  = values[linearised] * nodeCoordinate[counter(d)];
    });
    // A reflection along d negates every product. Summing the positive and the negative products
    // separately in sorted order then negates the numerator to the last bit.
    tarch::sortAscending(scratch, NumberOfVolumes);
    int firstNonNegative = 0;
    while (firstNonNegative < NumberOfVolumes and scratch[firstNonNegative] < 0.0) {
      firstNonNegative++;
    }
    double positivePartSum = 0.0;
    for (int i = firstNonNegative; i < NumberOfVolumes; i++) {
      positivePartSum += scratch[i];
    }
    double negativePartSum = 0.0;
    for (int i = firstNonNegative - 1; i >= 0; i--) {
      negativePartSum += -scratch[i];
    }
    const double slopeNumerator = positivePartSum - negativePartSum;
    slope[d]                    = (slopeDenominator > 0.0) ? slopeNumerator / slopeDenominator : 0.0;
  }

  double maxRelativeResidual = 0.0;
  peano4::dForEach(NumberOfNodes, [&](const tarch::la::Vector<DIMENSIONS, int>& counter) {
    const int linearised = peano4::dLinearised(counter, NumberOfNodes);
    // A reflection negates a slope and its coordinate together, so each term keeps its bits. An
    // axis swap permutes the terms, and the sorted summation keeps their sum.
    double correction[DIMENSIONS];
    for (int d = 0; d < DIMENSIONS; d++) {
      correction[d] = slope[d] * nodeCoordinate[counter(d)];
    }
    tarch::sortAscending(correction, DIMENSIONS);
    double prediction = mean;
    for (int d = 0; d < DIMENSIONS; d++) {
      prediction += correction[d];
    }
    const double residual = std::abs(values[linearised] - prediction);
    maxRelativeResidual   = std::max(maxRelativeResidual, residual / (std::abs(values[linearised]) + floor));
  });

  return maxRelativeResidual;
}

TARGET_DECLARE
/**
 * Returns the refinement command for a detail of computeMultiresolutionDetail(). A caller applies
 * the admissible patch sizes to the returned command.
 */
INLINE_METHOD GPU_CALLABLE_METHOD exahype2::RefinementCommand
exahype2::getRefinementCommandFromDetail(const double detail, const double eps, const double coarsenSafetyFactor) {
  assertion(eps > 0.0, eps);
  assertion(coarsenSafetyFactor > 0.0, coarsenSafetyFactor);
  if (detail > eps) {
    return exahype2::RefinementCommand::Refine;
  }
  if (detail < eps / coarsenSafetyFactor) {
    return exahype2::RefinementCommand::Erase;
  }
  return exahype2::RefinementCommand::Keep;
}
TARGET_DECLARE_END

/**
 * Returns the refinement command for the largest detail of the indicators over the AoS patch Q,
 * or Keep for the null Q of the grid construction.
 */
template <std::size_t NumberOfNodesPerAxis, typename Value, typename... Indicators>
INLINE_METHOD GPU_CALLABLE_METHOD exahype2::RefinementCommand
exahype2::refineOnDetail(
  const Value* const                              Q,
  const std::array<double, NumberOfNodesPerAxis>& nodesInUnitInterval,
  const int                                       numberOfUnknownsPlusAuxiliaryVariables,
  const double                                    eps,
  const double                                    coarsenSafetyFactor,
  const Indicators&... indicators
) {
  static_assert(
    sizeof...(Indicators) > 0,
    "refineOnDetail() needs at least one indicator. Without one the detail stays zero, which "
    "maps to Erase."
  );

  if (Q == nullptr) {
    return exahype2::RefinementCommand::Keep;
  }
  double detail = 0.0;
  ((detail = std::max(
      detail,
      exahype2::computeMultiresolutionDetail(Q, nodesInUnitInterval, numberOfUnknownsPlusAuxiliaryVariables, indicators)
    )),
   ...);
  return exahype2::getRefinementCommandFromDetail(detail, eps, coarsenSafetyFactor);
}
