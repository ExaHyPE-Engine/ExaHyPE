TARGET_DECLARE
/**
 * Advances one patch through @c TimeStepping with states formed by
 * @c Reconstruction and returns the maximum eigenvalue encountered. It reads
 * boundary halos from @p faceInputPatches and writes updated values to
 * @p outputPatch and @p faceOutputPatches.
 */
template <
  exahype2::fv::ReconstructionScheme Reconstruction,
  exahype2::fv::TimeSteppingScheme   TimeStepping,
  typename SolverType,
  int  NumberOfVolumesPerAxis,
  int  NumberOfUnknowns,
  int  NumberOfAuxiliaryVariables,
  bool EvaluateFlux,
  bool EvaluateNonconservativeProduct,
  bool EvaluateSource,
  bool EvaluateDiffusiveSource,
  bool EvaluateCustomRiemann,
  bool EvaluateMaxEigenvalue,
  bool EvaluateMaxEigenvalueOfFinalState,
  typename StoragePrecision,
  typename ComputePrecision>
INLINE_METHOD GPU_CALLABLE_METHOD double exahype2::fv::applyFiniteVolume(
  const StoragePrecision* NOALIAS const        inputPatch,
  StoragePrecision* NOALIAS const              outputPatch,
  const StoragePrecision* NOALIAS const        faceInputPatches[peano4::FacesPerCell],
  StoragePrecision* NOALIAS const              faceOutputPatches[peano4::FacesPerCell],
  const tarch::la::Vector<DIMENSIONS, double>& patchCentre,
  const tarch::la::Vector<DIMENSIONS, double>& patchSize,
  const double                                 timeStamp,
  const double                                 timeStepSize
) {
  return TimeStepping::template apply<
    Reconstruction,
    SolverType,
    NumberOfVolumesPerAxis,
    NumberOfUnknowns,
    NumberOfAuxiliaryVariables,
    EvaluateFlux,
    EvaluateNonconservativeProduct,
    EvaluateSource,
    EvaluateDiffusiveSource,
    EvaluateCustomRiemann,
    EvaluateMaxEigenvalue,
    EvaluateMaxEigenvalueOfFinalState,
    StoragePrecision,
    ComputePrecision>(
    inputPatch,
    outputPatch,
    faceInputPatches,
    faceOutputPatches,
    patchCentre,
    patchSize,
    timeStamp,
    timeStepSize
  );
}
TARGET_DECLARE_END
