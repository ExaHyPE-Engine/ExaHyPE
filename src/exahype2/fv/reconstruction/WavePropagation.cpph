TARGET_DECLARE
/**
 * Returns the neighbour @p offset volumes away along @p normal: The interior volume when it exists,
 * otherwise the matching layer of the halo in the left or right face of the patch. The halo
 * coordinate runs in the positive normal direction on both faces.
 */
template <exahype2::fv::limiter::SlopeLimiter Limiter>
template <int NumberOfVolumesPerAxis, int NumberOfData, typename StoragePrecision>
INLINE_METHOD GPU_CALLABLE_METHOD const StoragePrecision* exahype2::fv::reconstruction::WavePropagation<Limiter>::
  neighbourAlongNormal(
    const StoragePrecision* NOALIAS const     inputPatch,
    const StoragePrecision* NOALIAS const     faceInputPatches[peano4::FacesPerCell],
    const tarch::la::Vector<DIMENSIONS, int>& volumeIndex,
    const int                                 centreOffset,
    const int                                 strideAlongNormal,
    const int                                 normal,
    const int                                 offset
  ) {
  const int neighbourIndexAlongNormal = volumeIndex(normal) + offset;
  if (neighbourIndexAlongNormal >= 0 and neighbourIndexAlongNormal < NumberOfVolumesPerAxis) {
    return &inputPatch[centreOffset + offset * strideAlongNormal];
  }
  tarch::la::Vector<DIMENSIONS, int> overlapCell = volumeIndex;
  if (neighbourIndexAlongNormal < 0) {
    overlapCell(normal) = neighbourIndexAlongNormal + HaloSize;
    const int overlapIndex =
      exahype2::serialiseVoxelIndexInOverlap(overlapCell, NumberOfVolumesPerAxis, HaloSize, normal);
    return &faceInputPatches[normal][static_cast<std::ptrdiff_t>(overlapIndex * NumberOfData)];
  }
  overlapCell(normal) = neighbourIndexAlongNormal - NumberOfVolumesPerAxis + HaloSize;
  const int overlapIndex =
    exahype2::serialiseVoxelIndexInOverlap(overlapCell, NumberOfVolumesPerAxis, HaloSize, normal);
  return &faceInputPatches[normal + DIMENSIONS][static_cast<std::ptrdiff_t>(overlapIndex * NumberOfData)];
}


template <exahype2::fv::limiter::SlopeLimiter Limiter>
template <typename SolverType, int NumberOfUnknowns,typename StoragePrecision>
INLINE_METHOD GPU_CALLABLE_METHOD void exahype2::fv::reconstruction::WavePropagation<Limiter>::f_waves(
    const StoragePrecision* const NOALIAS QL,
    const StoragePrecision* const NOALIAS QR, 
    const tarch::la::Vector<DIMENSIONS, double>& x,
    const tarch::la::Vector<DIMENSIONS, double>& h,
    const double t,
    const double dt,
    const int normal,
    tarch::la::Vector<NumberOfUnknowns,StoragePrecision>* const NOALIAS fWaves, 
    StoragePrecision* const NOALIAS roeEigenvalues
  ) {
      using Shortcuts = typename SolverType::Shortcuts;

      double DENSITY_THRESHOLD=1E-16;


      double fluxRight[NumberOfUnknowns] {0.0};
      double fluxLeft[NumberOfUnknowns] {0.0};
      double deltaXPsi[NumberOfUnknowns] {0.0};

      tarch::la::Vector<DIMENSIONS, double> xL(x);
      tarch::la::Vector<DIMENSIONS, double> xR(x);
      xR[normal] += 0.5 * h(normal);
      xL[normal] -= 0.5 * h(normal);

      SolverType::flux(QL, xL, h, t, dt, normal, fluxLeft);
      SolverType::flux(QR, xR, h, t, dt, normal, fluxRight);

      if (normal == 1) {
          auto densityPerturbationLeft = QL[Shortcuts::rho] - QL[Shortcuts::backgroundstate];
          auto densityPerturbationRight = QR[Shortcuts::rho] - QR[Shortcuts::backgroundstate];

          if (std::abs(densityPerturbationLeft) < DENSITY_THRESHOLD) {
          densityPerturbationLeft = 0.0;
          }

          if (std::abs(densityPerturbationRight) < DENSITY_THRESHOLD) {
          densityPerturbationRight = 0.0;
          }

          deltaXPsi[Shortcuts::j+1]  = 0.5 * h(normal) * -GRAVITY * (densityPerturbationLeft + densityPerturbationRight);
          deltaXPsi[Shortcuts::E]     = 0.5 * h(normal) * -GRAVITY * (QL[Shortcuts::j+1] + QR[Shortcuts::j+1]);
      }



      /********************
      * State extraction *
      *******************/ 

      // left state
      const auto rhoL     = QL[Shortcuts::rho];
      const auto sqrtRhoL = sqrt(rhoL);
      const auto uL       = QL[Shortcuts::j] / rhoL;
      const auto vL       = QL[Shortcuts::j+1] / rhoL;

      const auto EL       = QL[Shortcuts::E];

      assertion(rhoL > 0, rhoL);
      assertion(EL > 0, EL);

      const auto ML                 = QL[Shortcuts::O2] + QL[Shortcuts::O] + QL[Shortcuts::N2];
      const auto iML                = 1.0 / ML;
      const auto meanMolecularMassL = (MOLAR_MASS_NITROGEN * QL[Shortcuts::N2] + MOLAR_MASS_MOLECULAR_OXYGEN * QL[Shortcuts::O2] + MOLAR_MASS_ATOMIC_OXYGEN * QL[Shortcuts::O]) * iML; // in kg/mol
      const auto pressureL          = QL[Shortcuts::rho] * UNIVERSAL_GAS_CONSTANT * QL[Shortcuts::T] / meanMolecularMassL;
      assertion(pressureL > 0.0, ML, meanMolecularMassL, QL[Shortcuts::rho], QL[Shortcuts::T], pressureL);

      const auto gammaL = (1.4 * (ML - QL[Shortcuts::O]) + 1.67 * QL[Shortcuts::O]) * iML;
      const auto HL     = (EL + pressureL) / QL[Shortcuts::rho];

      // right state
      const auto rhoR     = QR[Shortcuts::rho];
      const auto sqrtRhoR = sqrt(rhoR);
      const auto uR       = QR[Shortcuts::j] / rhoR;
      const auto vR       = QR[Shortcuts::j+1] / rhoR;

      const auto ER       = QR[Shortcuts::E];

      assertion(rhoR > 0, rhoR);
      assertion(ER > 0, ER);

      const auto MR                 = QR[Shortcuts::O2] + QR[Shortcuts::O] + QR[Shortcuts::N2];
      const auto iMR                = 1.0 / MR;
      const auto meanMolecularMassR = (MOLAR_MASS_NITROGEN * QR[Shortcuts::N2] + MOLAR_MASS_MOLECULAR_OXYGEN * QR[Shortcuts::O2] + MOLAR_MASS_ATOMIC_OXYGEN * QR[Shortcuts::O]) * iMR; // in kg/mol
      const auto pressureR          = QR[Shortcuts::rho] * UNIVERSAL_GAS_CONSTANT * QR[Shortcuts::T] / meanMolecularMassR;
      assertion(pressureR > 0.0, MR, meanMolecularMassR, QR[Shortcuts::rho], QR[Shortcuts::T], pressureR);

      const auto gammaR = (1.4 * (MR - QR[Shortcuts::O]) + 1.67 * QR[Shortcuts::O]) * iMR;
      const auto HR     = (ER + pressureR) / QR[Shortcuts::rho];




      /********************************************
      * Roe averages from LeVeque Chapter 15.3.4 *
      *******************************************/

      const auto iSumSqrtRho  = 1 / (sqrtRhoL + sqrtRhoR);

      const auto gammaAvg = 0.5 * (gammaL + gammaR);
      const auto HRoe     = (HL * sqrtRhoL + HR * sqrtRhoR) * iSumSqrtRho;

      tarch::la::Vector<DIMENSIONS, double> roeAveragedVelocities(0.0); 
      roeAveragedVelocities(0)    = (sqrtRhoL * uL + sqrtRhoR * uR) * iSumSqrtRho;
      roeAveragedVelocities(1)    = (sqrtRhoL * vL + sqrtRhoR * vR) * iSumSqrtRho;

      //TODO: extend to 3D, wL and wR are undefined
      #if DIMENSIONS == 3
      roeAveragedVelocities(2)    = (sqrtRhoL * wL + sqrtRhoR * wR) * iSumSqrtRho;
      #endif
      const auto qSquared         = 0.5 * (roeAveragedVelocities * roeAveragedVelocities);
      const auto speedOfSoundRoe  = sqrt((gammaAvg - 1) * (HRoe - qSquared));

      /*************************************************************
      * Roe Eigenvalues from LeVeque Chapter 18.8, Equation 18.47 *
      ************************************************************/

      // in x-direction, these are uRoe - speedOfSoundRoe, DIMENSIONS x uRoe, and uRoe + speedOfSoundRoe

      // first eigenvalue is left uRoe - speedOfSoundRoe
      roeEigenvalues[0] = roeAveragedVelocities(normal) - speedOfSoundRoe;

      for (int eigenvalue = 1; eigenvalue <= DIMENSIONS; eigenvalue++) {
          roeEigenvalues[eigenvalue] = roeAveragedVelocities(normal);
      }

      // last eigenvalue is right uRoe + speedOfSoundRoe
      roeEigenvalues[DIMENSIONS + 1] = roeAveragedVelocities(normal) + speedOfSoundRoe;

      /***********************************************
      * Delta values from Bale et al. Equation 1.17 *
      **********************************************/ 

      tarch::la::Vector<NumberOfUnknowns, double> delta(0.0);

      for (int unknown = 0; unknown < NumberOfUnknowns; ++unknown) {
          delta(unknown) = fluxRight[unknown] - fluxLeft[unknown] - deltaXPsi[unknown];
      }

      /****************************************************************
      * Right Eigenvectors from LeVeque Chapter 18.8, Equation 18.48 *
      ***************************************************************/

      // @todo figure out for 3D 
      // => github.com/clawpack/riemann/blob/master/src/rpn3_euler.f90

      const int transverse = normal == 0 ? 1 : 0;

      // first right Eigenvector
      tarch::la::Vector<NumberOfUnknowns, double> r1(0.0);
      r1(0)               = 1.0;
      r1(1 + normal)      = roeAveragedVelocities(normal) - speedOfSoundRoe;
      r1(1 + transverse)  = roeAveragedVelocities(transverse);
      r1(3)               = HRoe - roeAveragedVelocities(normal) * speedOfSoundRoe;

      // second right Eigenvector
      tarch::la::Vector<NumberOfUnknowns, double> r2(0.0);
      r2(0)               = 0.0;
      r2(1 + normal)      = 0.0;
      r2(1 + transverse)  = 1.0;
      r2(3)               = roeAveragedVelocities(transverse);

      // third right Eigenvector
      tarch::la::Vector<NumberOfUnknowns, double> r3(0.0);
      r3(0) = 1.0;
      r3(1) = roeAveragedVelocities(0);
      r3(2) = roeAveragedVelocities(1);
      r3(3) = qSquared;


      // fourth right Eigenvector
      tarch::la::Vector<NumberOfUnknowns, double> r4(0.0);
      r4(0)               = 1.0;
      r4(1 + normal)      = roeAveragedVelocities(normal) + speedOfSoundRoe;
      r4(1 + transverse)  = roeAveragedVelocities(transverse);
      r4(3)               = HRoe + roeAveragedVelocities(normal) * speedOfSoundRoe;

      /***************************************************
      * Beta values following Bale et al. Equation 1.14 *
      **************************************************/
      // inverted Eigenvectors taken from https://github.com/clawpack/riemann/blob/master/src/rpn2_euler_4wave.f90

      // @todo figure out for 3D
      tarch::la::Vector<NumberOfUnknowns, double> beta(0.0);

      beta(2) = (
                  (HRoe - 2 * qSquared) * delta(0)
                  + roeAveragedVelocities(normal) * delta(1 + normal)
                  + roeAveragedVelocities(transverse) * delta(1 + transverse)
                  - delta(3)
                  ) / (HRoe - qSquared);

      beta(1) = delta(1 + transverse) - roeAveragedVelocities(transverse) * delta(0);

      beta(3) = (
                  delta(1 + normal) 
                  + (speedOfSoundRoe - roeAveragedVelocities(normal)) * delta(0)
                  - speedOfSoundRoe * beta(2)
                  ) / (2 * speedOfSoundRoe);

      beta(0) = delta(0) - beta(2) - beta(3);


      fWaves[0] = beta(0) * r1; 
      fWaves[1] = beta(1) * r2; 
      fWaves[2] = beta(2) * r3; 
      fWaves[3] = beta(3) * r4; 
      

  }






template <exahype2::fv::limiter::SlopeLimiter Limiter>
template <
  typename SolverType,
  int  NumberOfVolumesPerAxis,
  int  NumberOfUnknowns,
  int  NumberOfAuxiliaryVariables,
  bool EvaluateFlux,
  bool EvaluateNonconservativeProduct,
  bool EvaluateSource,
  bool EvaluateDiffusiveSource,
  bool EvaluateCustomRiemann,
  bool EvaluateMaxEigenvalue,
  typename StoragePrecision,
  typename ComputePrecision>
INLINE_METHOD GPU_CALLABLE_METHOD void exahype2::fv::reconstruction::WavePropagation<Limiter>::accumulateFluxDivergence(
  const StoragePrecision* NOALIAS const        inputPatch,
  const StoragePrecision* NOALIAS const        faceInputPatches[peano4::FacesPerCell],
  const tarch::la::Vector<DIMENSIONS, int>&    volumeIndex,
  const int                                    centreOffset,
  const StoragePrecision* NOALIAS const        centreState,
  const tarch::la::Vector<DIMENSIONS, double>& patchCentre,
  const tarch::la::Vector<DIMENSIONS, double>& patchSize,
  const tarch::la::Vector<DIMENSIONS, double>& volumeCentre,
  const tarch::la::Vector<DIMENSIONS, double>& volumeSize,
  const double                                 timeStamp,
  const double                                 timeStepSize,
  StoragePrecision* NOALIAS const              outputState,
  double&                                      maxEigenvalueAfterTimeStep
) {
  static_assert(
    not EvaluateDiffusiveSource,
    "The LimitedLinear reconstruction does not support a diffusive source term."
  );

  constexpr int NumberOfData = NumberOfUnknowns + NumberOfAuxiliaryVariables;
  using GeometryPrecision    = decltype(ComputePrecision{} * double{});
  using StateUpdatePrecision = decltype(StoragePrecision{} + ComputePrecision{});

  assertion(std::isfinite(timeStamp) and timeStamp >= 0.0, timeStamp);
  assertion(std::isfinite(timeStepSize) and timeStepSize >= 0.0, timeStepSize);


  for (int normal = 0; normal < DIMENSIONS; normal++) {
    int strideAlongNormal = NumberOfData;
    for (int dimension = 0; dimension < normal; dimension++) {
      strideAlongNormal *= NumberOfVolumesPerAxis;
    }

    auto leftVolumeIndex  = volumeIndex;
    auto rightVolumeIndex = volumeIndex;
    leftVolumeIndex(normal) -= 1;
    rightVolumeIndex(normal) += 1;
    [[maybe_unused]] const auto [leftVolumeSize, leftVolumeCentre] =
      exahype2::fv::getVolumeSizeAndCentre<DIMENSIONS, NumberOfVolumesPerAxis>(patchCentre, patchSize, leftVolumeIndex);
    [[maybe_unused]] const auto [rightVolumeSize, rightVolumeCentre] =
      exahype2::fv::getVolumeSizeAndCentre<DIMENSIONS, NumberOfVolumesPerAxis>(
        patchCentre,
        patchSize,
        rightVolumeIndex
      );

    const StoragePrecision* NOALIAS const leftLeftState = neighbourAlongNormal<NumberOfVolumesPerAxis, NumberOfData>(
      inputPatch,
      faceInputPatches,
      volumeIndex,
      centreOffset,
      strideAlongNormal,
      normal,
      -2
    );
    const StoragePrecision* NOALIAS const leftState = neighbourAlongNormal<NumberOfVolumesPerAxis, NumberOfData>(
      inputPatch,
      faceInputPatches,
      volumeIndex,
      centreOffset,
      strideAlongNormal,
      normal,
      -1
    );
    const StoragePrecision* NOALIAS const rightState = neighbourAlongNormal<NumberOfVolumesPerAxis, NumberOfData>(
      inputPatch,
      faceInputPatches,
      volumeIndex,
      centreOffset,
      strideAlongNormal,
      normal,
      1
    );
    const StoragePrecision* NOALIAS const rightRightState = neighbourAlongNormal<NumberOfVolumesPerAxis, NumberOfData>(
      inputPatch,
      faceInputPatches,
      volumeIndex,
      centreOffset,
      strideAlongNormal,
      normal,
      2
    );


    //get fwaves and eigenvalues at 4 interfaces: LL L R RR

    
    //interface locations
    auto leftFaceCentre(volumeCentre);
    leftFaceCentre(normal) -= 0.5 * volumeSize(normal);
    auto rightFaceCentre(volumeCentre);
    rightFaceCentre(normal) += 0.5 * volumeSize(normal);
    auto leftLeftFaceCentre(volumeCentre);
    leftLeftFaceCentre(normal) -= 1.5 * volumeSize(normal);
    auto rightRightFaceCentre(volumeCentre);
    rightRightFaceCentre(normal) += 1.5 * volumeSize(normal);


    tarch::la::Vector<NumberOfUnknowns, StoragePrecision> roeEigenvalues_LL = {}; 
    tarch::la::Vector<NumberOfUnknowns, StoragePrecision> roeEigenvalues_L = {}; 
    tarch::la::Vector<NumberOfUnknowns, StoragePrecision> roeEigenvalues_R = {}; 
    tarch::la::Vector<NumberOfUnknowns, StoragePrecision> roeEigenvalues_RR = {}; 
    
    tarch::la::Vector<NumberOfUnknowns, StoragePrecision> fWaves_LL[NumberOfUnknowns] = {};  
    tarch::la::Vector<NumberOfUnknowns, StoragePrecision> fWaves_L[NumberOfUnknowns] = {};  
    tarch::la::Vector<NumberOfUnknowns, StoragePrecision> fWaves_R[NumberOfUnknowns] = {};  
    tarch::la::Vector<NumberOfUnknowns, StoragePrecision> fWaves_RR[NumberOfUnknowns] = {};  


    //... Call here the wave propgation algorithm


    f_waves<SolverType, NumberOfUnknowns>(leftState, centreState, leftFaceCentre, volumeSize, timeStamp, timeStepSize, normal, fWaves_L, roeEigenvalues_L.data());
    f_waves<SolverType, NumberOfUnknowns>(leftLeftState, leftState, leftLeftFaceCentre, volumeSize, timeStamp, timeStepSize, normal, fWaves_LL, roeEigenvalues_LL.data());
    f_waves<SolverType, NumberOfUnknowns>(centreState, rightState, rightFaceCentre, volumeSize, timeStamp, timeStepSize, normal, fWaves_R, roeEigenvalues_R.data());
    f_waves<SolverType, NumberOfUnknowns>(rightState, rightRightState, rightRightFaceCentre, volumeSize, timeStamp, timeStepSize, normal, fWaves_RR, roeEigenvalues_RR.data());


    //A --> A_delta_Q from doi.org/10.1137/S106482750139738X
    //fWaves correspond to Z^p 


    //update and correction term initialization

    ComputePrecision Aplus[NumberOfUnknowns] __attribute__((aligned(PEANO_WITH_ALIGNMENT)))= {};  
    ComputePrecision Aminus[NumberOfUnknowns]  __attribute__((aligned(PEANO_WITH_ALIGNMENT)))= {};  
    ComputePrecision F_tilde_left[NumberOfUnknowns]  __attribute__((aligned(PEANO_WITH_ALIGNMENT)))= {};  
    ComputePrecision F_tilde_right[NumberOfUnknowns]  __attribute__((aligned(PEANO_WITH_ALIGNMENT)))= {};  



    for (int wave = 0; wave < NumberOfUnknowns; ++wave) {
      const auto eigenvalue = roeEigenvalues_L(wave);
      if (eigenvalue > 0.0) {
      for (int unknown = 0; unknown < NumberOfUnknowns; ++unknown) {
        Aplus[unknown] += fWaves_L[wave](unknown); 
      }
      }       
    }  

    for (int wave = 0; wave < NumberOfUnknowns; ++wave) {
      const auto eigenvalue = roeEigenvalues_R(wave);
      if (eigenvalue < 0.0) {
      for (int unknown = 0; unknown < NumberOfUnknowns; ++unknown) {
        Aminus[unknown] += fWaves_R[wave](unknown); 
      }
      }       
    }  


    //get phi for limiting 
    ComputePrecision phi_leftInterface[NumberOfUnknowns] = {}; 
    ComputePrecision phi_rightInterface[NumberOfUnknowns] = {}; 


    //test without limiting
    // std::fill_n(phi_leftInterface, NumberOfUnknowns, ComputePrecision(1));
    // std::fill_n(phi_rightInterface, NumberOfUnknowns, ComputePrecision(1));


    //limiting for left
    for (int wave = 0; wave < NumberOfUnknowns; ++wave) {
      const auto eigenvalue = roeEigenvalues_L(wave);

      auto fwave_lim = (eigenvalue > 0) ? fWaves_LL[wave] : fWaves_R[wave];
      auto bwd_fw = tarch::la::dot(fWaves_L[wave], fWaves_L[wave]); 
      phi_leftInterface[wave] = (bwd_fw > 0) ? Limiter::limitedDifference(tarch::la::dot(fwave_lim, fWaves_L[wave]), bwd_fw) / bwd_fw
      : ComputePrecision(0);    
    }

    //limiting for right interface
    for (int wave = 0; wave < NumberOfUnknowns; ++wave) {
      const auto eigenvalue = roeEigenvalues_R(wave);
      auto fwave_lim = (eigenvalue > 0) ? fWaves_L[wave] : fWaves_RR[wave];
      auto bwd_fw = tarch::la::dot(fWaves_R[wave], fWaves_R[wave]);
      phi_rightInterface[wave] = (bwd_fw > 0) ? Limiter::limitedDifference(tarch::la::dot(fwave_lim, fWaves_R[wave]), bwd_fw) / bwd_fw
      : ComputePrecision(0);    
    }
    

    //correction terms

    auto sign = [](double val) -> int {
        return (val > 0) - (val < 0);
    };

    for (int wave = 0; wave < NumberOfUnknowns; ++wave) {
      const auto eigenvalue = roeEigenvalues_L(wave);
      for (int unknown = 0; unknown < NumberOfUnknowns; ++unknown) {
        F_tilde_left[unknown] += 0.5*sign(eigenvalue)*(1- (timeStepSize/volumeSize(normal))*std::abs(eigenvalue))*fWaves_L[wave](unknown)*phi_leftInterface[wave];
      }
    }

    for (int wave = 0; wave < NumberOfUnknowns; ++wave) {
      const auto eigenvalue = roeEigenvalues_R(wave);
      for (int unknown = 0; unknown < NumberOfUnknowns; ++unknown) {
        F_tilde_right[unknown] += 0.5*sign(eigenvalue)*(1- (timeStepSize/volumeSize(normal))*std::abs(eigenvalue))*fWaves_R[wave](unknown)*phi_rightInterface[wave];
      }
    }


    const auto scale = static_cast<ComputePrecision>(
      (static_cast<GeometryPrecision>(timeStepSize) * static_cast<GeometryPrecision>(NumberOfVolumesPerAxis))
      / static_cast<GeometryPrecision>(patchSize(normal))
    );



      /***
      Max Eigenvalue Calculations to determine time step size
      */
      if constexpr (EvaluateMaxEigenvalue) {


        ComputePrecision leftGoingFluxLeftFace[NumberOfUnknowns] __attribute__((aligned(PEANO_WITH_ALIGNMENT)));
        ComputePrecision rightGoingFluxLeftFace[NumberOfUnknowns] __attribute__((aligned(PEANO_WITH_ALIGNMENT)));
        ComputePrecision leftGoingFluxRightFace[NumberOfUnknowns] __attribute__((aligned(PEANO_WITH_ALIGNMENT)));
        ComputePrecision rightGoingFluxRightFace[NumberOfUnknowns] __attribute__((aligned(PEANO_WITH_ALIGNMENT)));

        const ComputePrecision maxWaveSpeedLeft = SolverType::solveRiemannProblem(
          leftState,
          centreState,
          leftFaceCentre,
          volumeSize,
          timeStamp,
          timeStepSize,
          normal,
          leftGoingFluxLeftFace,
          rightGoingFluxLeftFace
        );
        const ComputePrecision maxWaveSpeedRight = SolverType::solveRiemannProblem(
          centreState,
          rightState,
          rightFaceCentre,
          volumeSize,
          timeStamp,
          timeStepSize,
          normal,
          leftGoingFluxRightFace,
          rightGoingFluxRightFace
        );

        // A solver that defines solveRiemannProblem need not define maxEigenvalue, so the wave
        // speed the Riemann solver returns is the only eigenvalue this branch reads.
        exahype2::fv::accumulateMaxEigenvalue(maxEigenvalueAfterTimeStep, maxWaveSpeedLeft);
        exahype2::fv::accumulateMaxEigenvalue(maxEigenvalueAfterTimeStep, maxWaveSpeedRight);
      }





      /***
      Actual Update, see equation 
      */

      SIMD()
      for (int unknown = 0; unknown < NumberOfUnknowns; unknown++) {
        outputState[unknown] = static_cast<StoragePrecision>(
          static_cast<StateUpdatePrecision>(outputState[unknown])
          - static_cast<StateUpdatePrecision>(scale * (Aplus[unknown] + Aminus[unknown] +  F_tilde_right[unknown] - F_tilde_left[unknown]))
        );
      }

      
      // Assertion diagnostics cannot run inside a vectorised loop.
      for (int unknown = 0; unknown < NumberOfUnknowns; unknown++) {
        [[maybe_unused]] const bool outputStateIsFinite = std::isfinite(outputState[unknown]);
        assertion(outputStateIsFinite, unknown, outputState[unknown]);
      }
    }
  }

TARGET_DECLARE_END
