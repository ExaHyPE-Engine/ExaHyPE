TARGET_DECLARE
/**
 * Returns the neighbour @p offset volumes away from the current volume along
 * @p normal. It is an interior volume when it exists, otherwise the matching
 * layer of the halo the framework stored in the left or right face of the
 * patch. The overlap coordinate runs in the positive normal direction across
 * the interface: the left face keeps the neighbour layers below the patch, the
 * right face the neighbour layers above it. Adding @c HaloSize on the left, or
 * subtracting @c NumberOfVolumesPerAxis and adding @c HaloSize on the right,
 * maps the signed neighbour index onto that lexicographic layout.
 */
template <exahype2::fv::limiter::SlopeLimiter Limiter>
template <int NumberOfVolumesPerAxis, int NumberOfData, typename StoragePrecision>
INLINE_METHOD GPU_CALLABLE_METHOD const StoragePrecision* exahype2::fv::reconstruction::LimitedLinear<Limiter>::
  neighbourAlongNormal(
    const StoragePrecision* NOALIAS const     inputPatch,
    const StoragePrecision* NOALIAS const     faceInputPatches[TWO_TIMES_D],
    const tarch::la::Vector<DIMENSIONS, int>& volumeIndex,
    const int                                 centreOffset,
    const int                                 strideAlongNormal,
    const int                                 normal,
    const int                                 offset
  ) {
  const int neighbourIndexAlongNormal = volumeIndex(normal) + offset;
  if (neighbourIndexAlongNormal >= 0 and neighbourIndexAlongNormal < NumberOfVolumesPerAxis) {
    return &inputPatch[centreOffset + offset * strideAlongNormal];
  }
  tarch::la::Vector<DIMENSIONS, int> overlapCell = volumeIndex;
  if (neighbourIndexAlongNormal < 0) {
    overlapCell(normal) = neighbourIndexAlongNormal + HaloSize;
    const int overlapIndex =
      exahype2::serialiseVoxelIndexInOverlap(overlapCell, NumberOfVolumesPerAxis, HaloSize, normal);
    return &faceInputPatches[normal][overlapIndex * NumberOfData];
  }
  overlapCell(normal) = neighbourIndexAlongNormal - NumberOfVolumesPerAxis + HaloSize;
  const int overlapIndex =
    exahype2::serialiseVoxelIndexInOverlap(overlapCell, NumberOfVolumesPerAxis, HaloSize, normal);
  return &faceInputPatches[normal + DIMENSIONS][overlapIndex * NumberOfData];
}

/**
 * Forms the two boundary-extrapolated states of one volume along @p normal and
 * evolves them by half a time step. The three states are converted to the
 * compute precision first, so the limiter and the half-step run in that
 * precision even when the patch is stored in a lower one. The @c Limiter maps
 * this neighbourhood onto the limited difference of each unknown, unless the
 * solver defines a static @c limitedDifference method, which then supplies the
 * differences instead and lets a scenario limit a derived quantity such as a
 * pressure perturbation. The default
 * extrapolation adds and subtracts half that difference; a solver that defines
 * a static @c reconstruct method replaces it, which lets a scenario keep a
 * physical quantity such as a hydrostatic pressure in balance across the two
 * boundaries. The auxiliary variables are extrapolated but not evolved in time.
 * The half-step uses the flux balance across this volume in direction
 * @p normal alone, minus the own-direction non-conservative product of the
 * volume state with the limited differences, plus the source term of the
 * volume state. Both boundaries therefore receive the same time increment,
 * and the stencil stays on the axis-aligned line, so the scheme never needs a
 * diagonal neighbour that the face exchange cannot supply.
 */
template <exahype2::fv::limiter::SlopeLimiter Limiter>
template <
  typename Solver,
  int  NumberOfUnknowns,
  int  NumberOfData,
  bool EvaluateFlux,
  bool EvaluateNonconservativeProduct,
  bool EvaluateSource,
  typename StoragePrecision,
  typename ComputePrecision>
INLINE_METHOD GPU_CALLABLE_METHOD void exahype2::fv::reconstruction::LimitedLinear<Limiter>::evolveFaceStates(
  const StoragePrecision* NOALIAS const        leftState,
  const StoragePrecision* NOALIAS const        centreState,
  const StoragePrecision* NOALIAS const        rightState,
  const tarch::la::Vector<DIMENSIONS, double>& volumeCentre,
  const tarch::la::Vector<DIMENSIONS, double>& volumeSize,
  const int                                    normal,
  const double                                 timeStamp,
  const double                                 timeStepSize,
  ComputePrecision* NOALIAS const              evolvedMinusState,
  ComputePrecision* NOALIAS const              evolvedPlusState
) {
  using GeometryPrecision = decltype(ComputePrecision{} * double{});
  ComputePrecision leftStateForCompute[NumberOfData] __attribute__((aligned(PEANO_WITH_ALIGNMENT)));
  ComputePrecision centreStateForCompute[NumberOfData] __attribute__((aligned(PEANO_WITH_ALIGNMENT)));
  ComputePrecision rightStateForCompute[NumberOfData] __attribute__((aligned(PEANO_WITH_ALIGNMENT)));
  for (int unknown = 0; unknown < NumberOfData; unknown++) {
    leftStateForCompute[unknown]   = static_cast<ComputePrecision>(leftState[unknown]);
    centreStateForCompute[unknown] = static_cast<ComputePrecision>(centreState[unknown]);
    rightStateForCompute[unknown]  = static_cast<ComputePrecision>(rightState[unknown]);
  }

  ComputePrecision limitedDifferences[NumberOfData] __attribute__((aligned(PEANO_WITH_ALIGNMENT)));
  if constexpr (requires {
                  Solver::limitedDifference(
                    leftStateForCompute,
                    centreStateForCompute,
                    rightStateForCompute,
                    volumeCentre,
                    volumeSize,
                    normal,
                    0
                  );
                }) {
    for (int unknown = 0; unknown < NumberOfData; unknown++) {
      limitedDifferences[unknown] = Solver::limitedDifference(
        leftStateForCompute,
        centreStateForCompute,
        rightStateForCompute,
        volumeCentre,
        volumeSize,
        normal,
        unknown
      );
    }
  } else {
    SIMD()
    for (int unknown = 0; unknown < NumberOfData; unknown++) {
      const ComputePrecision forwardDifference  = rightStateForCompute[unknown] - centreStateForCompute[unknown];
      const ComputePrecision backwardDifference = centreStateForCompute[unknown] - leftStateForCompute[unknown];
      limitedDifferences[unknown]               = Limiter::limitedDifference(forwardDifference, backwardDifference);
    }
  }

  if constexpr (requires {
                  Solver::reconstruct(
                    leftStateForCompute,
                    centreStateForCompute,
                    rightStateForCompute,
                    limitedDifferences,
                    volumeCentre,
                    volumeSize,
                    normal,
                    0,
                    evolvedMinusState[0],
                    evolvedPlusState[0]
                  );
                }) {
    for (int unknown = 0; unknown < NumberOfData; unknown++) {
      Solver::reconstruct(
        leftStateForCompute,
        centreStateForCompute,
        rightStateForCompute,
        limitedDifferences,
        volumeCentre,
        volumeSize,
        normal,
        unknown,
        evolvedMinusState[unknown],
        evolvedPlusState[unknown]
      );
    }
  } else {
    SIMD()
    for (int unknown = 0; unknown < NumberOfData; unknown++) {
      evolvedMinusState[unknown] =
        centreStateForCompute[unknown] - static_cast<ComputePrecision>(0.5) * limitedDifferences[unknown];
      evolvedPlusState[unknown] =
        centreStateForCompute[unknown] + static_cast<ComputePrecision>(0.5) * limitedDifferences[unknown];
    }
  }

  if constexpr (EvaluateFlux or EvaluateNonconservativeProduct or EvaluateSource) {
    ComputePrecision predictorUpdate[NumberOfUnknowns] __attribute__((aligned(PEANO_WITH_ALIGNMENT)));
    SIMD()
    for (int unknown = 0; unknown < NumberOfUnknowns; unknown++) {
      predictorUpdate[unknown] = ComputePrecision(0);
    }

    if constexpr (EvaluateFlux) {
      ComputePrecision minusFlux[NumberOfUnknowns] __attribute__((aligned(PEANO_WITH_ALIGNMENT)));
      ComputePrecision plusFlux[NumberOfUnknowns] __attribute__((aligned(PEANO_WITH_ALIGNMENT)));
      Solver::flux(evolvedMinusState, volumeCentre, volumeSize, timeStamp, timeStepSize, normal, minusFlux);
      Solver::flux(evolvedPlusState, volumeCentre, volumeSize, timeStamp, timeStepSize, normal, plusFlux);
      SIMD()
      for (int unknown = 0; unknown < NumberOfUnknowns; unknown++) {
        predictorUpdate[unknown] += minusFlux[unknown] - plusFlux[unknown];
      }
    }

    if constexpr (EvaluateNonconservativeProduct) {
      ComputePrecision predictorNonconservativeProduct[NumberOfUnknowns] __attribute__((aligned(PEANO_WITH_ALIGNMENT)));
      Solver::nonconservativeProduct(
        centreStateForCompute,
        limitedDifferences,
        volumeCentre,
        volumeSize,
        timeStamp,
        timeStepSize,
        normal,
        predictorNonconservativeProduct
      );
      SIMD()
      for (int unknown = 0; unknown < NumberOfUnknowns; unknown++) {
        predictorUpdate[unknown] -= predictorNonconservativeProduct[unknown];
      }
    }

    const ComputePrecision inverseSize = static_cast<ComputePrecision>(
      static_cast<GeometryPrecision>(1.0) / static_cast<GeometryPrecision>(volumeSize(normal))
    );
    SIMD()
    for (int unknown = 0; unknown < NumberOfUnknowns; unknown++) {
      const ComputePrecision halfStep = static_cast<ComputePrecision>(
        static_cast<GeometryPrecision>(0.5) * static_cast<GeometryPrecision>(timeStepSize)
        * static_cast<GeometryPrecision>(inverseSize) * static_cast<GeometryPrecision>(predictorUpdate[unknown])
      );
      evolvedMinusState[unknown] += halfStep;
      evolvedPlusState[unknown] += halfStep;
    }

    if constexpr (EvaluateSource) {
      ComputePrecision sources[NumberOfUnknowns] __attribute__((aligned(PEANO_WITH_ALIGNMENT)));
      Solver::sourceTerm(centreStateForCompute, volumeCentre, volumeSize, timeStamp, timeStepSize, sources);
      SIMD()
      for (int unknown = 0; unknown < NumberOfUnknowns; unknown++) {
        const ComputePrecision sourceHalfStep = static_cast<ComputePrecision>(
          static_cast<GeometryPrecision>(0.5) * static_cast<GeometryPrecision>(timeStepSize)
          * static_cast<GeometryPrecision>(sources[unknown])
        );
        evolvedMinusState[unknown] += sourceHalfStep;
        evolvedPlusState[unknown] += sourceHalfStep;
      }
    }
  }
}

/**
 * Returns the Rusanov flux across one interface into @p faceFlux, and the larger
 * of the two neighbouring maximum eigenvalues. This is the general two-state
 * form: the average of the two physical fluxes minus a diffusion proportional
 * to the larger eigenvalue and the jump in the state. The two evolved states
 * meeting at the interface differ, so the cell-centred flux does not cancel
 * between the two faces the way it does in the first-order scheme.
 */
template <exahype2::fv::limiter::SlopeLimiter Limiter>
template <typename Solver, int NumberOfUnknowns, bool EvaluateFlux, typename ComputePrecision>
INLINE_METHOD GPU_CALLABLE_METHOD ComputePrecision
exahype2::fv::reconstruction::LimitedLinear<Limiter>::rusanovFaceFlux(
  const ComputePrecision* NOALIAS const        leftState,
  const ComputePrecision* NOALIAS const        rightState,
  const tarch::la::Vector<DIMENSIONS, double>& faceCentre,
  const tarch::la::Vector<DIMENSIONS, double>& volumeSize,
  const int                                    normal,
  const double                                 timeStamp,
  const double                                 timeStepSize,
  ComputePrecision* NOALIAS const              faceFlux
) {
  ComputePrecision maxEigenvalue =
    Solver::maxEigenvalue(leftState, faceCentre, volumeSize, timeStamp, timeStepSize, normal);
  const ComputePrecision rightMaxEigenvalue =
    Solver::maxEigenvalue(rightState, faceCentre, volumeSize, timeStamp, timeStepSize, normal);
  ::exahype2::fv::accumulateMaxEigenvalue(maxEigenvalue, rightMaxEigenvalue);

  ComputePrecision leftFluxes[NumberOfUnknowns] __attribute__((aligned(PEANO_WITH_ALIGNMENT)));
  ComputePrecision rightFluxes[NumberOfUnknowns] __attribute__((aligned(PEANO_WITH_ALIGNMENT)));
  if constexpr (EvaluateFlux) {
    Solver::flux(leftState, faceCentre, volumeSize, timeStamp, timeStepSize, normal, leftFluxes);
    Solver::flux(rightState, faceCentre, volumeSize, timeStamp, timeStepSize, normal, rightFluxes);
  }

  for (int unknown = 0; unknown < NumberOfUnknowns; unknown++) {
    faceFlux[unknown] =
      -static_cast<ComputePrecision>(0.5) * maxEigenvalue * (rightState[unknown] - leftState[unknown]);
    if constexpr (EvaluateFlux) {
      faceFlux[unknown] += static_cast<ComputePrecision>(0.5) * (leftFluxes[unknown] + rightFluxes[unknown]);
    }
  }
  return maxEigenvalue;
}

/**
 * Advances one volume with the MUSCL-Hancock update. For every direction we
 * evolve the boundary states of the two neighbours and of this volume, then
 * feed the states that meet at each interface to the Riemann solver. The left
 * face uses the left neighbour's right-boundary state and this volume's
 * left-boundary state; the right face uses this volume's right-boundary state
 * and the right neighbour's left-boundary state. The non-conservative product
 * consists of half the product over the jump at either face plus a volume
 * part over the two evolved boundary states of this volume. Their average is
 * the half-time volume state and their difference is the limited difference,
 * since the flux part of the half-step cancels in both. With zero slopes every
 * jump sits at the faces and the treatment degenerates to the splitting of
 * the first-order scheme. The reconstruction does not support a diffusive
 * source term.
 */
template <exahype2::fv::limiter::SlopeLimiter Limiter>
template <
  typename Solver,
  int  NumberOfVolumesPerAxis,
  int  NumberOfUnknowns,
  int  NumberOfAuxiliaryVariables,
  bool EvaluateFlux,
  bool EvaluateNonconservativeProduct,
  bool EvaluateSource,
  bool EvaluateDiffusiveSource,
  bool EvaluateCustomRiemann,
  bool EvaluateMaxEigenvalue,
  typename StoragePrecision,
  typename ComputePrecision>
INLINE_METHOD GPU_CALLABLE_METHOD void exahype2::fv::reconstruction::LimitedLinear<Limiter>::accumulateFluxDivergence(
  const StoragePrecision* NOALIAS const        inputPatch,
  const StoragePrecision* NOALIAS const        faceInputPatches[TWO_TIMES_D],
  const tarch::la::Vector<DIMENSIONS, int>&    volumeIndex,
  const int                                    centreOffset,
  const StoragePrecision* NOALIAS const        centreState,
  const tarch::la::Vector<DIMENSIONS, double>& patchCentre,
  const tarch::la::Vector<DIMENSIONS, double>& patchSize,
  const tarch::la::Vector<DIMENSIONS, double>& volumeCentre,
  const tarch::la::Vector<DIMENSIONS, double>& volumeSize,
  const double                                 timeStamp,
  const double                                 timeStepSize,
  StoragePrecision* NOALIAS const              outputState,
  double&                                      maxEigenvalueAfterTimeStep
) {
  static_assert(
    not EvaluateDiffusiveSource,
    "The LimitedLinear reconstruction does not support a diffusive source term."
  );

  constexpr int NumberOfData = NumberOfUnknowns + NumberOfAuxiliaryVariables;
  using GeometryPrecision    = decltype(ComputePrecision{} * double{});
  using StateUpdatePrecision = decltype(StoragePrecision{} + ComputePrecision{});

  for (int normal = 0; normal < DIMENSIONS; normal++) {
    int strideAlongNormal = NumberOfData;
    for (int dimension = 0; dimension < normal; dimension++) {
      strideAlongNormal *= NumberOfVolumesPerAxis;
    }

    auto leftVolumeIndex  = volumeIndex;
    auto rightVolumeIndex = volumeIndex;
    leftVolumeIndex(normal) -= 1;
    rightVolumeIndex(normal) += 1;
    [[maybe_unused]] const auto [leftVolumeSize, leftVolumeCentre] =
      ::exahype2::fv::getVolumeSizeAndCentre<DIMENSIONS, NumberOfVolumesPerAxis>(
        patchCentre,
        patchSize,
        leftVolumeIndex
      );
    [[maybe_unused]] const auto [rightVolumeSize, rightVolumeCentre] =
      ::exahype2::fv::getVolumeSizeAndCentre<DIMENSIONS, NumberOfVolumesPerAxis>(
        patchCentre,
        patchSize,
        rightVolumeIndex
      );

    const StoragePrecision* NOALIAS const leftLeftState = neighbourAlongNormal<NumberOfVolumesPerAxis, NumberOfData>(
      inputPatch,
      faceInputPatches,
      volumeIndex,
      centreOffset,
      strideAlongNormal,
      normal,
      -2
    );
    const StoragePrecision* NOALIAS const leftState = neighbourAlongNormal<NumberOfVolumesPerAxis, NumberOfData>(
      inputPatch,
      faceInputPatches,
      volumeIndex,
      centreOffset,
      strideAlongNormal,
      normal,
      -1
    );
    const StoragePrecision* NOALIAS const rightState = neighbourAlongNormal<NumberOfVolumesPerAxis, NumberOfData>(
      inputPatch,
      faceInputPatches,
      volumeIndex,
      centreOffset,
      strideAlongNormal,
      normal,
      1
    );
    const StoragePrecision* NOALIAS const rightRightState = neighbourAlongNormal<NumberOfVolumesPerAxis, NumberOfData>(
      inputPatch,
      faceInputPatches,
      volumeIndex,
      centreOffset,
      strideAlongNormal,
      normal,
      2
    );

    [[maybe_unused]] ComputePrecision leftNeighbourMinus[NumberOfData] __attribute__((aligned(PEANO_WITH_ALIGNMENT)));
    ComputePrecision                  leftNeighbourPlus[NumberOfData] __attribute__((aligned(PEANO_WITH_ALIGNMENT)));
    ComputePrecision                  centreMinus[NumberOfData] __attribute__((aligned(PEANO_WITH_ALIGNMENT)));
    ComputePrecision                  centrePlus[NumberOfData] __attribute__((aligned(PEANO_WITH_ALIGNMENT)));
    ComputePrecision                  rightNeighbourMinus[NumberOfData] __attribute__((aligned(PEANO_WITH_ALIGNMENT)));
    [[maybe_unused]] ComputePrecision rightNeighbourPlus[NumberOfData] __attribute__((aligned(PEANO_WITH_ALIGNMENT)));

    evolveFaceStates<
      Solver,
      NumberOfUnknowns,
      NumberOfData,
      EvaluateFlux,
      EvaluateNonconservativeProduct,
      EvaluateSource>(
      leftLeftState,
      leftState,
      centreState,
      leftVolumeCentre,
      volumeSize,
      normal,
      timeStamp,
      timeStepSize,
      leftNeighbourMinus,
      leftNeighbourPlus
    );
    evolveFaceStates<
      Solver,
      NumberOfUnknowns,
      NumberOfData,
      EvaluateFlux,
      EvaluateNonconservativeProduct,
      EvaluateSource>(
      leftState,
      centreState,
      rightState,
      volumeCentre,
      volumeSize,
      normal,
      timeStamp,
      timeStepSize,
      centreMinus,
      centrePlus
    );
    evolveFaceStates<
      Solver,
      NumberOfUnknowns,
      NumberOfData,
      EvaluateFlux,
      EvaluateNonconservativeProduct,
      EvaluateSource>(
      centreState,
      rightState,
      rightRightState,
      rightVolumeCentre,
      volumeSize,
      normal,
      timeStamp,
      timeStepSize,
      rightNeighbourMinus,
      rightNeighbourPlus
    );

    auto leftFaceCentre(volumeCentre);
    leftFaceCentre(normal) -= static_cast<double>(0.5) * volumeSize(normal);
    auto rightFaceCentre(volumeCentre);
    rightFaceCentre(normal) += static_cast<double>(0.5) * volumeSize(normal);

    const ComputePrecision scale = static_cast<ComputePrecision>(
      (static_cast<GeometryPrecision>(timeStepSize) * static_cast<GeometryPrecision>(NumberOfVolumesPerAxis))
      / static_cast<GeometryPrecision>(patchSize(normal))
    );

    if constexpr (EvaluateCustomRiemann) {
      ComputePrecision leftGoingFluxLeftFace[NumberOfUnknowns] __attribute__((aligned(PEANO_WITH_ALIGNMENT)));
      ComputePrecision rightGoingFluxLeftFace[NumberOfUnknowns] __attribute__((aligned(PEANO_WITH_ALIGNMENT)));
      ComputePrecision leftGoingFluxRightFace[NumberOfUnknowns] __attribute__((aligned(PEANO_WITH_ALIGNMENT)));
      ComputePrecision rightGoingFluxRightFace[NumberOfUnknowns] __attribute__((aligned(PEANO_WITH_ALIGNMENT)));

      const ComputePrecision maxWaveSpeedLeft = Solver::solveRiemannProblem(
        leftNeighbourPlus,
        centreMinus,
        leftFaceCentre,
        volumeSize,
        timeStamp,
        timeStepSize,
        normal,
        leftGoingFluxLeftFace,
        rightGoingFluxLeftFace
      );
      const ComputePrecision maxWaveSpeedRight = Solver::solveRiemannProblem(
        centrePlus,
        rightNeighbourMinus,
        rightFaceCentre,
        volumeSize,
        timeStamp,
        timeStepSize,
        normal,
        leftGoingFluxRightFace,
        rightGoingFluxRightFace
      );
      // A custom Riemann solver may be the only thing that knows the speed it
      // resolved, since a solver offering one need not offer an eigenvalue as
      // well, so its verdict enters the step observation here. The Rusanov
      // branch below needs no such report: it has to evaluate the solver's own
      // eigenvalue for its diffusion coefficient, and the caller then measures
      // the step on the final state, at the time level the next step starts from.
      if constexpr (EvaluateMaxEigenvalue) {
        ::exahype2::fv::accumulateMaxEigenvalue(maxEigenvalueAfterTimeStep, maxWaveSpeedLeft);
        ::exahype2::fv::accumulateMaxEigenvalue(maxEigenvalueAfterTimeStep, maxWaveSpeedRight);
      }

      SIMD()
      for (int unknown = 0; unknown < NumberOfUnknowns; unknown++) {
        const ComputePrecision fluxFromLeftInterface = rightGoingFluxLeftFace[unknown];
        const ComputePrecision fluxToRightInterface  = leftGoingFluxRightFace[unknown];
        outputState[unknown]                         = static_cast<StoragePrecision>(
          static_cast<StateUpdatePrecision>(outputState[unknown])
          + static_cast<StateUpdatePrecision>(scale * (fluxFromLeftInterface - fluxToRightInterface))
        );
      }
      // The finiteness check stays out of the vectorised loop, whose body must
      // be free of the diagnostics an assertion emits.
      for (int unknown = 0; unknown < NumberOfUnknowns; unknown++) {
        assertion(std::isfinite(outputState[unknown]));
      }
    } else {
      ComputePrecision fluxLeftFace[NumberOfUnknowns] __attribute__((aligned(PEANO_WITH_ALIGNMENT)));
      ComputePrecision fluxRightFace[NumberOfUnknowns] __attribute__((aligned(PEANO_WITH_ALIGNMENT)));
      rusanovFaceFlux<Solver, NumberOfUnknowns, EvaluateFlux>(
        leftNeighbourPlus,
        centreMinus,
        leftFaceCentre,
        volumeSize,
        normal,
        timeStamp,
        timeStepSize,
        fluxLeftFace
      );
      rusanovFaceFlux<Solver, NumberOfUnknowns, EvaluateFlux>(
        centrePlus,
        rightNeighbourMinus,
        rightFaceCentre,
        volumeSize,
        normal,
        timeStamp,
        timeStepSize,
        fluxRightFace
      );

      [[maybe_unused]] ComputePrecision accumulatedNonconservativeProduct[NumberOfUnknowns]
        __attribute__((aligned(PEANO_WITH_ALIGNMENT)));
      if constexpr (EvaluateNonconservativeProduct) {
        ComputePrecision averageState[NumberOfData] __attribute__((aligned(PEANO_WITH_ALIGNMENT)));
        ComputePrecision stateJump[NumberOfData] __attribute__((aligned(PEANO_WITH_ALIGNMENT)));
        ComputePrecision nonconservativeProduct[NumberOfUnknowns] __attribute__((aligned(PEANO_WITH_ALIGNMENT)));

        SIMD()
        for (int unknown = 0; unknown < NumberOfData; unknown++) {
          averageState[unknown] =
            static_cast<ComputePrecision>(0.5) * (leftNeighbourPlus[unknown] + centreMinus[unknown]);
          stateJump[unknown] = centreMinus[unknown] - leftNeighbourPlus[unknown];
        }
        Solver::nonconservativeProduct(
          averageState,
          stateJump,
          leftFaceCentre,
          volumeSize,
          timeStamp,
          timeStepSize,
          normal,
          nonconservativeProduct
        );
        SIMD()
        for (int unknown = 0; unknown < NumberOfUnknowns; unknown++) {
          accumulatedNonconservativeProduct[unknown] =
            static_cast<ComputePrecision>(0.5) * nonconservativeProduct[unknown];
        }

        SIMD()
        for (int unknown = 0; unknown < NumberOfData; unknown++) {
          averageState[unknown] =
            static_cast<ComputePrecision>(0.5) * (centrePlus[unknown] + rightNeighbourMinus[unknown]);
          stateJump[unknown] = rightNeighbourMinus[unknown] - centrePlus[unknown];
        }
        Solver::nonconservativeProduct(
          averageState,
          stateJump,
          rightFaceCentre,
          volumeSize,
          timeStamp,
          timeStepSize,
          normal,
          nonconservativeProduct
        );
        SIMD()
        for (int unknown = 0; unknown < NumberOfUnknowns; unknown++) {
          accumulatedNonconservativeProduct[unknown] +=
            static_cast<ComputePrecision>(0.5) * nonconservativeProduct[unknown];
        }

        SIMD()
        for (int unknown = 0; unknown < NumberOfData; unknown++) {
          averageState[unknown] = static_cast<ComputePrecision>(0.5) * (centreMinus[unknown] + centrePlus[unknown]);
          stateJump[unknown]    = centrePlus[unknown] - centreMinus[unknown];
        }
        Solver::nonconservativeProduct(
          averageState,
          stateJump,
          volumeCentre,
          volumeSize,
          timeStamp,
          timeStepSize,
          normal,
          nonconservativeProduct
        );
        SIMD()
        for (int unknown = 0; unknown < NumberOfUnknowns; unknown++) {
          accumulatedNonconservativeProduct[unknown] += nonconservativeProduct[unknown];
        }
      }

      SIMD()
      for (int unknown = 0; unknown < NumberOfUnknowns; unknown++) {
        outputState[unknown] = static_cast<StoragePrecision>(
          static_cast<StateUpdatePrecision>(outputState[unknown])
          + static_cast<StateUpdatePrecision>(scale * (fluxLeftFace[unknown] - fluxRightFace[unknown]))
        );
        if constexpr (EvaluateNonconservativeProduct) {
          outputState[unknown] = static_cast<StoragePrecision>(
            static_cast<StateUpdatePrecision>(outputState[unknown])
            - static_cast<StateUpdatePrecision>(scale * accumulatedNonconservativeProduct[unknown])
          );
        }
      }
      // The finiteness check stays out of the vectorised loop, whose body must
      // be free of the diagnostics an assertion emits.
      for (int unknown = 0; unknown < NumberOfUnknowns; unknown++) {
        assertion(std::isfinite(outputState[unknown]));
      }
    }
  }
}
TARGET_DECLARE_END
