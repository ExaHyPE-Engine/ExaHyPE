#include "exahype2/TimeStepping.h"
#include "tarch/Assertions.h"
#include "tarch/la/ScalarOperations.h"

TARGET_DECLARE
/**
 * Returns the neighbour offset volumes away along normal, read from the patch or from the halo of
 * the lower or upper face.
 */
template <exahype2::fv::limiter::SlopeLimiter Limiter>
template <int NumberOfVolumesPerAxis, int NumberOfData, typename StoragePrecision>
INLINE_METHOD GPU_CALLABLE_METHOD const StoragePrecision*
exahype2::fv::reconstruction::LimitedLinear<Limiter>::getNeighbourAlongNormal(
  const StoragePrecision* NOALIAS const     inputPatch,
  const StoragePrecision* NOALIAS const     faceInputPatches[peano4::FacesPerCell],
  const tarch::la::Vector<DIMENSIONS, int>& volumeIndex,
  const int                                 centreOffset,
  const int                                 strideAlongNormal,
  const int                                 normal,
  const int                                 offset
) {
  const int neighbourIndexAlongNormal = volumeIndex(normal) + offset;
  if (neighbourIndexAlongNormal >= 0 and neighbourIndexAlongNormal < NumberOfVolumesPerAxis) {
    return &inputPatch[centreOffset + offset * strideAlongNormal];
  }
  tarch::la::Vector<DIMENSIONS, int> overlapCell = volumeIndex;
  if (neighbourIndexAlongNormal < 0) {
    overlapCell(normal)    = neighbourIndexAlongNormal + HaloSize;
    const int overlapIndex = exahype2::fv::getFaceVolumeIndex(overlapCell, NumberOfVolumesPerAxis, HaloSize, normal);
    return &faceInputPatches[normal][static_cast<std::ptrdiff_t>(overlapIndex * NumberOfData)];
  }
  overlapCell(normal)    = neighbourIndexAlongNormal - NumberOfVolumesPerAxis + HaloSize;
  const int overlapIndex = exahype2::fv::getFaceVolumeIndex(overlapCell, NumberOfVolumesPerAxis, HaloSize, normal);
  return &faceInputPatches[normal + DIMENSIONS][static_cast<std::ptrdiff_t>(overlapIndex * NumberOfData)];
}

/**
 * Reconstructs the two face states of centreState and evolves them by half a time step. A
 * SolverType with limitedDifference or reconstruct overrides the limiter or the linear
 * reconstruction. Auxiliary variables keep their reconstructed values.
 */
template <exahype2::fv::limiter::SlopeLimiter Limiter>
template <
  typename SolverType,
  int  NumberOfUnknowns,
  int  NumberOfData,
  bool EvaluateFlux,
  bool EvaluateNonconservativeProduct,
  bool EvaluateSource,
  typename StoragePrecision,
  typename ComputePrecision
>
INLINE_METHOD GPU_CALLABLE_METHOD void
exahype2::fv::reconstruction::LimitedLinear<Limiter>::evolveFaceStates(
  const StoragePrecision* NOALIAS const        leftState,
  const StoragePrecision* NOALIAS const        centreState,
  const StoragePrecision* NOALIAS const        rightState,
  const tarch::la::Vector<DIMENSIONS, double>& volumeCentre,
  const tarch::la::Vector<DIMENSIONS, double>& volumeSize,
  const int                                    normal,
  const double                                 timeStamp,
  const double                                 timeStepSize,
  ComputePrecision* NOALIAS const              evolvedMinusState,
  ComputePrecision* NOALIAS const              evolvedPlusState
) {
  using GeometryPrecision = decltype(ComputePrecision{} * double{});
  ASSERTION(normal >= 0 and normal < DIMENSIONS, normal);
  ASSERTION(std::isfinite(timeStepSize) and timeStepSize >= 0.0, timeStepSize);
  ComputePrecision leftStateForCompute[NumberOfData] __attribute__((aligned(PEANO_WITH_ALIGNMENT)));
  ComputePrecision centreStateForCompute[NumberOfData] __attribute__((aligned(PEANO_WITH_ALIGNMENT)));
  ComputePrecision rightStateForCompute[NumberOfData] __attribute__((aligned(PEANO_WITH_ALIGNMENT)));
  for (int unknown = 0; unknown < NumberOfData; unknown++) {
    leftStateForCompute[unknown]   = static_cast<ComputePrecision>(leftState[unknown]);
    centreStateForCompute[unknown] = static_cast<ComputePrecision>(centreState[unknown]);
    rightStateForCompute[unknown]  = static_cast<ComputePrecision>(rightState[unknown]);
  }

  ComputePrecision limitedDifferences[NumberOfData] __attribute__((aligned(PEANO_WITH_ALIGNMENT)));
  if constexpr (requires {
                  SolverType::limitedDifference(
                    leftStateForCompute,
                    centreStateForCompute,
                    rightStateForCompute,
                    volumeCentre,
                    volumeSize,
                    normal,
                    0
                  );
                }) {
    for (int unknown = 0; unknown < NumberOfData; unknown++) {
      limitedDifferences[unknown] = SolverType::limitedDifference(
        leftStateForCompute,
        centreStateForCompute,
        rightStateForCompute,
        volumeCentre,
        volumeSize,
        normal,
        unknown
      );
    }
  } else {
    SIMD()
    for (int unknown = 0; unknown < NumberOfData; unknown++) {
      const ComputePrecision forwardDifference  = rightStateForCompute[unknown] - centreStateForCompute[unknown];
      const ComputePrecision backwardDifference = centreStateForCompute[unknown] - leftStateForCompute[unknown];
      limitedDifferences[unknown]               = Limiter::limitedDifference(forwardDifference, backwardDifference);
    }
  }

  if constexpr (requires {
                  SolverType::reconstruct(
                    leftStateForCompute,
                    centreStateForCompute,
                    rightStateForCompute,
                    limitedDifferences,
                    volumeCentre,
                    volumeSize,
                    normal,
                    0,
                    evolvedMinusState[0],
                    evolvedPlusState[0]
                  );
                }) {
    for (int unknown = 0; unknown < NumberOfData; unknown++) {
      SolverType::reconstruct(
        leftStateForCompute,
        centreStateForCompute,
        rightStateForCompute,
        limitedDifferences,
        volumeCentre,
        volumeSize,
        normal,
        unknown,
        evolvedMinusState[unknown],
        evolvedPlusState[unknown]
      );
    }
  } else {
    SIMD()
    for (int unknown = 0; unknown < NumberOfData; unknown++) {
      evolvedMinusState[unknown] =
        centreStateForCompute[unknown] - static_cast<ComputePrecision>(0.5) * limitedDifferences[unknown];
      evolvedPlusState[unknown] =
        centreStateForCompute[unknown] + static_cast<ComputePrecision>(0.5) * limitedDifferences[unknown];
    }
  }

  if constexpr (EvaluateFlux or EvaluateNonconservativeProduct or EvaluateSource) {
    ComputePrecision predictorUpdate[NumberOfUnknowns] __attribute__((aligned(PEANO_WITH_ALIGNMENT)));
    SIMD()
    for (int unknown = 0; unknown < NumberOfUnknowns; unknown++) {
      predictorUpdate[unknown] = ComputePrecision(0);
    }

    if constexpr (EvaluateFlux) {
      ComputePrecision minusFlux[NumberOfUnknowns] __attribute__((aligned(PEANO_WITH_ALIGNMENT)));
      ComputePrecision plusFlux[NumberOfUnknowns] __attribute__((aligned(PEANO_WITH_ALIGNMENT)));
      SolverType::flux(evolvedMinusState, volumeCentre, volumeSize, timeStamp, timeStepSize, normal, minusFlux);
      SolverType::flux(evolvedPlusState, volumeCentre, volumeSize, timeStamp, timeStepSize, normal, plusFlux);
      SIMD()
      for (int unknown = 0; unknown < NumberOfUnknowns; unknown++) {
        predictorUpdate[unknown] += minusFlux[unknown] - plusFlux[unknown];
      }
    }

    if constexpr (EvaluateNonconservativeProduct) {
      ComputePrecision predictorNonconservativeProduct[NumberOfUnknowns] __attribute__((aligned(PEANO_WITH_ALIGNMENT)));
      SolverType::nonconservativeProduct(
        centreStateForCompute,
        limitedDifferences,
        volumeCentre,
        volumeSize,
        timeStamp,
        timeStepSize,
        normal,
        predictorNonconservativeProduct
      );
      SIMD()
      for (int unknown = 0; unknown < NumberOfUnknowns; unknown++) {
        predictorUpdate[unknown] -= predictorNonconservativeProduct[unknown];
      }
    }

    const auto inverseSize = static_cast<ComputePrecision>(
      static_cast<GeometryPrecision>(1.0) / static_cast<GeometryPrecision>(volumeSize(normal))
    );
    // A fused multiply-add pairs the half step with the state it advances. Every compiler then
    // rounds the evolved states the same way.
    const GeometryPrecision halfStepFactor = static_cast<GeometryPrecision>(0.5)
      * static_cast<GeometryPrecision>(timeStepSize) * static_cast<GeometryPrecision>(inverseSize);
    SIMD()
    for (int unknown = 0; unknown < NumberOfUnknowns; unknown++) {
      const auto update          = static_cast<GeometryPrecision>(predictorUpdate[unknown]);
      evolvedMinusState[unknown] = static_cast<ComputePrecision>(
        std::fma(halfStepFactor, update, static_cast<GeometryPrecision>(evolvedMinusState[unknown]))
      );
      evolvedPlusState[unknown] = static_cast<ComputePrecision>(
        std::fma(halfStepFactor, update, static_cast<GeometryPrecision>(evolvedPlusState[unknown]))
      );
    }

    if constexpr (EvaluateSource) {
      ComputePrecision sources[NumberOfUnknowns] __attribute__((aligned(PEANO_WITH_ALIGNMENT)));
      SolverType::sourceTerm(centreStateForCompute, volumeCentre, volumeSize, timeStamp, timeStepSize, sources);
      const GeometryPrecision sourceFactor =
        static_cast<GeometryPrecision>(0.5) * static_cast<GeometryPrecision>(timeStepSize);
      SIMD()
      for (int unknown = 0; unknown < NumberOfUnknowns; unknown++) {
        const auto source          = static_cast<GeometryPrecision>(sources[unknown]);
        evolvedMinusState[unknown] = static_cast<ComputePrecision>(
          std::fma(sourceFactor, source, static_cast<GeometryPrecision>(evolvedMinusState[unknown]))
        );
        evolvedPlusState[unknown] = static_cast<ComputePrecision>(
          std::fma(sourceFactor, source, static_cast<GeometryPrecision>(evolvedPlusState[unknown]))
        );
      }
    }
  }
  for (int unknown = 0; unknown < NumberOfData; unknown++) {
    ASSERTION(std::isfinite(evolvedMinusState[unknown]) and std::isfinite(evolvedPlusState[unknown]), unknown, normal);
  }
}

/**
 * Writes the Rusanov flux into faceFlux and returns its maximum wave speed.
 */
template <exahype2::fv::limiter::SlopeLimiter Limiter>
template <typename SolverType, int NumberOfUnknowns, bool EvaluateFlux, typename ComputePrecision>
INLINE_METHOD GPU_CALLABLE_METHOD ComputePrecision
exahype2::fv::reconstruction::LimitedLinear<Limiter>::rusanovFaceFlux(
  const ComputePrecision* NOALIAS const        leftState,
  const ComputePrecision* NOALIAS const        rightState,
  const tarch::la::Vector<DIMENSIONS, double>& faceCentre,
  const tarch::la::Vector<DIMENSIONS, double>& volumeSize,
  const int                                    normal,
  const double                                 timeStamp,
  const double                                 timeStepSize,
  ComputePrecision* NOALIAS const              faceFlux
) {
  const ComputePrecision leftMaxEigenvalue =
    SolverType::maxEigenvalue(leftState, faceCentre, volumeSize, timeStamp, timeStepSize, normal);
  const ComputePrecision rightMaxEigenvalue =
    SolverType::maxEigenvalue(rightState, faceCentre, volumeSize, timeStamp, timeStepSize, normal);
  ASSERTION(exahype2::MaxEigenvalueReduction::isPhysicalValue(leftMaxEigenvalue), leftMaxEigenvalue, normal);
  ASSERTION(exahype2::MaxEigenvalueReduction::isPhysicalValue(rightMaxEigenvalue), rightMaxEigenvalue, normal);
  const ComputePrecision maxEigenvalue =
    rightMaxEigenvalue > leftMaxEigenvalue ? rightMaxEigenvalue : leftMaxEigenvalue;

  ComputePrecision leftFluxes[NumberOfUnknowns] __attribute__((aligned(PEANO_WITH_ALIGNMENT)));
  ComputePrecision rightFluxes[NumberOfUnknowns] __attribute__((aligned(PEANO_WITH_ALIGNMENT)));
  if constexpr (EvaluateFlux) {
    SolverType::flux(leftState, faceCentre, volumeSize, timeStamp, timeStepSize, normal, leftFluxes);
    SolverType::flux(rightState, faceCentre, volumeSize, timeStamp, timeStepSize, normal, rightFluxes);
  }

  // A fused multiply-add pairs the Rusanov diffusion with the average flux of two exact halves.
  // Every compiler then rounds the face flux the same way.
  const ComputePrecision diffusionFactor = -static_cast<ComputePrecision>(0.5) * maxEigenvalue;
  for (int unknown = 0; unknown < NumberOfUnknowns; unknown++) {
    const ComputePrecision averageFlux = EvaluateFlux ? static_cast<ComputePrecision>(0.5) * leftFluxes[unknown]
        + static_cast<ComputePrecision>(0.5) * rightFluxes[unknown]
                                                      : ComputePrecision{0};
    faceFlux[unknown] = std::fma(diffusionFactor, rightState[unknown] - leftState[unknown], averageFlux);
  }
  return maxEigenvalue;
}

/**
 * Evolves the face states of one state along every axis from the state and its two neighbours.
 */
template <exahype2::fv::limiter::SlopeLimiter Limiter>
template <
  typename SolverType,
  int  NumberOfVolumesPerAxis,
  int  NumberOfUnknowns,
  int  NumberOfAuxiliaryVariables,
  bool EvaluateFlux,
  bool EvaluateNonconservativeProduct,
  bool EvaluateSource,
  bool EvaluateCustomRiemann,
  typename StoragePrecision,
  typename ComputePrecision
>
INLINE_METHOD void
exahype2::fv::reconstruction::LimitedLinear<Limiter>::StateTerms<
  SolverType,
  NumberOfVolumesPerAxis,
  NumberOfUnknowns,
  NumberOfAuxiliaryVariables,
  EvaluateFlux,
  EvaluateNonconservativeProduct,
  EvaluateSource,
  EvaluateCustomRiemann,
  StoragePrecision,
  ComputePrecision
>::
  evaluate(
    const StoragePrecision* NOALIAS const                         patch,
    const StoragePrecision* NOALIAS const                         faces[peano4::FacesPerCell],
    const tarch::la::Vector<DIMENSIONS, int>&                     volumeIndex,
    const int                                                     centreOffset,
    [[maybe_unused]] const tarch::la::Vector<DIMENSIONS, double>& patchCentre,
    [[maybe_unused]] const tarch::la::Vector<DIMENSIONS, double>& patchSize,
    const tarch::la::Vector<DIMENSIONS, double>&                  volumeCentre,
    const tarch::la::Vector<DIMENSIONS, double>&                  volumeSize,
    const double                                                  timeStamp,
    const double                                                  timeStepSize
  ) {
  constexpr int NumberOfData      = NumberOfUnknowns + NumberOfAuxiliaryVariables;
  int           strideAlongNormal = NumberOfData;
  for (int normal = 0; normal < DIMENSIONS; normal++) {
    const StoragePrecision* NOALIAS const lowerState = getNeighbourAlongNormal<NumberOfVolumesPerAxis, NumberOfData>(
      patch,
      faces,
      volumeIndex,
      centreOffset,
      strideAlongNormal,
      normal,
      -1
    );
    const StoragePrecision* NOALIAS const upperState = getNeighbourAlongNormal<NumberOfVolumesPerAxis, NumberOfData>(
      patch,
      faces,
      volumeIndex,
      centreOffset,
      strideAlongNormal,
      normal,
      1
    );
    evolveFaceStates<
      SolverType,
      NumberOfUnknowns,
      NumberOfData,
      EvaluateFlux,
      EvaluateNonconservativeProduct,
      EvaluateSource
    >(lowerState,
      patch + centreOffset,
      upperState,
      volumeCentre,
      volumeSize,
      normal,
      timeStamp,
      timeStepSize,
      minus[normal],
      plus[normal]);
    strideAlongNormal *= NumberOfVolumesPerAxis;
  }
}

/**
 * Evaluates the terms of the face between the lower and the upper evolved state into face. side
 * is 0 for the lower and 1 for the upper face of the volume with volumeIndex. A face of that
 * volume on the domain boundary reaches the Riemann solver of the solver class as such.
 */
template <exahype2::fv::limiter::SlopeLimiter Limiter>
template <
  typename SolverType,
  int  NumberOfVolumesPerAxis,
  int  NumberOfUnknowns,
  int  NumberOfData,
  bool EvaluateFlux,
  bool EvaluateNonconservativeProduct,
  bool EvaluateCustomRiemann,
  typename ComputePrecision
>
INLINE_METHOD GPU_CALLABLE_METHOD void
exahype2::fv::reconstruction::LimitedLinear<Limiter>::evaluateFaceTerms(
  const ComputePrecision* NOALIAS const                                                                 lowerState,
  const ComputePrecision* NOALIAS const                                                                 upperState,
  const tarch::la::Vector<DIMENSIONS, double>&                                                          faceCentre,
  const tarch::la::Vector<DIMENSIONS, double>&                                                          volumeSize,
  const double                                                                                          timeStamp,
  const double                                                                                          timeStepSize,
  const int                                                                                             normal,
  [[maybe_unused]] const tarch::la::Vector<DIMENSIONS, int>&                                            volumeIndex,
  [[maybe_unused]] const int                                                                            side,
  [[maybe_unused]] const int                                                                            boundaryFaces,
  FaceTerms<NumberOfUnknowns, EvaluateNonconservativeProduct, EvaluateCustomRiemann, ComputePrecision>& face
) {
  if constexpr (EvaluateCustomRiemann) {
    face.maxWaveSpeed =
      static_cast<ComputePrecision>(exahype2::fv::solveRiemannProblemOnVolumeFace<SolverType, NumberOfVolumesPerAxis>(
        lowerState,
        upperState,
        faceCentre,
        volumeSize,
        timeStamp,
        timeStepSize,
        normal,
        volumeIndex,
        side,
        boundaryFaces,
        face.leftGoingFlux,
        face.rightGoingFlux
      ));
  } else {
    rusanovFaceFlux<SolverType, NumberOfUnknowns, EvaluateFlux>(
      lowerState,
      upperState,
      faceCentre,
      volumeSize,
      normal,
      timeStamp,
      timeStepSize,
      face.flux
    );
    if constexpr (EvaluateNonconservativeProduct) {
      ComputePrecision averageState[NumberOfData] __attribute__((aligned(PEANO_WITH_ALIGNMENT)));
      ComputePrecision stateJump[NumberOfData] __attribute__((aligned(PEANO_WITH_ALIGNMENT)));
      SIMD()
      for (int unknown = 0; unknown < NumberOfData; unknown++) {
        averageState[unknown] = static_cast<ComputePrecision>(0.5) * (lowerState[unknown] + upperState[unknown]);
        stateJump[unknown]    = upperState[unknown] - lowerState[unknown];
      }
      SolverType::nonconservativeProduct(
        averageState,
        stateJump,
        faceCentre,
        volumeSize,
        timeStamp,
        timeStepSize,
        normal,
        face.nonconservativeProduct
      );
    }
  }
}

/**
 * Advances one volume with the MUSCL-Hancock update. A custom Riemann solver adds the
 * non-conservative product over the face jump to its fluxes. The evolved states of the interior
 * neighbours and the terms of the lower face come from the ring when it contains them and the terms
 * of the upper face go into the ring for the neighbour above.
 */
template <exahype2::fv::limiter::SlopeLimiter Limiter>
template <
  typename SolverType,
  int  NumberOfVolumesPerAxis,
  int  NumberOfUnknowns,
  int  NumberOfAuxiliaryVariables,
  bool EvaluateFlux,
  bool EvaluateNonconservativeProduct,
  bool EvaluateSource,
  bool EvaluateDiffusiveSource,
  bool EvaluateCustomRiemann,
  bool EvaluateMaxEigenvalue,
  typename StoragePrecision,
  typename ComputePrecision,
  typename Terms
>
INLINE_METHOD GPU_CALLABLE_METHOD void
exahype2::fv::reconstruction::LimitedLinear<Limiter>::accumulateFluxDivergence(
  const StoragePrecision* NOALIAS const        inputPatch,
  const StoragePrecision* NOALIAS const        faceInputPatches[peano4::FacesPerCell],
  const tarch::la::Vector<DIMENSIONS, int>&    volumeIndex,
  const int                                    centreOffset,
  const StoragePrecision* NOALIAS const        centreState,
  const tarch::la::Vector<DIMENSIONS, double>& patchCentre,
  const tarch::la::Vector<DIMENSIONS, double>& patchSize,
  const tarch::la::Vector<DIMENSIONS, double>& volumeCentre,
  const tarch::la::Vector<DIMENSIONS, double>& volumeSize,
  const double                                 timeStamp,
  const double                                 timeStepSize,
  [[maybe_unused]] const int                   boundaryFaces,
  StoragePrecision* NOALIAS const              outputState,
  double&                                      maxEigenvalueAfterTimeStep,
  [[maybe_unused]] Terms&                      terms
) {
  static_assert(not EvaluateDiffusiveSource, "The limited linear reconstruction cannot add a diffusive source term.");

  constexpr int  NumberOfData = NumberOfUnknowns + NumberOfAuxiliaryVariables;
  constexpr bool StoresTerms  = Terms::Lookahead > 0;
  using Face = FaceTerms<NumberOfUnknowns, EvaluateNonconservativeProduct, EvaluateCustomRiemann, ComputePrecision>;
  using GeometryPrecision    = decltype(ComputePrecision{} * double{});
  using StateUpdatePrecision = decltype(StoragePrecision{} + ComputePrecision{});
  const int volume           = centreOffset / NumberOfData;

  ASSERTION(std::isfinite(timeStamp) and timeStamp >= 0.0, timeStamp);
  ASSERTION(std::isfinite(timeStepSize) and timeStepSize >= 0.0, timeStepSize);
  const double halfTimeStamp = timeStamp + 0.5 * timeStepSize;
  ASSERTION(std::isfinite(halfTimeStamp), timeStamp, timeStepSize);

  // Every axis writes its flux difference into its own update. The updates of an unknown add with
  // tarch::la::sumInOrderOfValue() in 3D and enter outputState once. Mirrored and swapped volumes
  // receive mirrored and swapped states.
  StateUpdatePrecision axisUpdates[DIMENSIONS][NumberOfUnknowns];

  int strideInVolumes = 1;
  for (int normal = 0; normal < DIMENSIONS; normal++) {
    const int strideAlongNormal = strideInVolumes * NumberOfData;

    auto leftVolumeIndex  = volumeIndex;
    auto rightVolumeIndex = volumeIndex;
    leftVolumeIndex(normal) -= 1;
    rightVolumeIndex(normal) += 1;
    [[maybe_unused]] const auto leftVolumeCentre =
      exahype2::fv::getVolumeCentre(patchCentre, patchSize, NumberOfVolumesPerAxis, leftVolumeIndex);
    [[maybe_unused]] const auto rightVolumeCentre =
      exahype2::fv::getVolumeCentre(patchCentre, patchSize, NumberOfVolumesPerAxis, rightVolumeIndex);
    const bool leftInside  = leftVolumeIndex(normal) >= 0;
    const bool rightInside = rightVolumeIndex(normal) < NumberOfVolumesPerAxis;

    const StoragePrecision* NOALIAS const leftState = getNeighbourAlongNormal<NumberOfVolumesPerAxis, NumberOfData>(
      inputPatch,
      faceInputPatches,
      volumeIndex,
      centreOffset,
      strideAlongNormal,
      normal,
      -1
    );
    const StoragePrecision* NOALIAS const rightState = getNeighbourAlongNormal<NumberOfVolumesPerAxis, NumberOfData>(
      inputPatch,
      faceInputPatches,
      volumeIndex,
      centreOffset,
      strideAlongNormal,
      normal,
      1
    );

    // The evolved states come from the ring for the volume and its interior neighbours. This call
    // evolves a halo neighbour and, without a ring, every state.
    [[maybe_unused]] ComputePrecision leftNeighbourMinus[NumberOfData] __attribute__((aligned(PEANO_WITH_ALIGNMENT)));
    [[maybe_unused]] ComputePrecision leftNeighbourPlus[NumberOfData] __attribute__((aligned(PEANO_WITH_ALIGNMENT)));
    [[maybe_unused]] ComputePrecision centreMinusBuffer[NumberOfData] __attribute__((aligned(PEANO_WITH_ALIGNMENT)));
    [[maybe_unused]] ComputePrecision centrePlusBuffer[NumberOfData] __attribute__((aligned(PEANO_WITH_ALIGNMENT)));
    [[maybe_unused]] ComputePrecision rightNeighbourMinus[NumberOfData] __attribute__((aligned(PEANO_WITH_ALIGNMENT)));
    [[maybe_unused]] ComputePrecision rightNeighbourPlus[NumberOfData] __attribute__((aligned(PEANO_WITH_ALIGNMENT)));
    const ComputePrecision* NOALIAS   centreMinus = centreMinusBuffer;
    const ComputePrecision* NOALIAS   centrePlus  = centrePlusBuffer;
    const ComputePrecision* NOALIAS   leftPlus    = leftNeighbourPlus;
    const ComputePrecision* NOALIAS   rightMinus  = rightNeighbourMinus;
    bool                              evolveLeft  = true;
    bool                              evolveRight = true;
    if constexpr (StoresTerms) {
      centreMinus = terms.at(volume).minus[normal];
      centrePlus  = terms.at(volume).plus[normal];
      if (leftInside) {
        leftPlus   = terms.at(volume - strideInVolumes).plus[normal];
        evolveLeft = false;
      }
      if (rightInside) {
        rightMinus  = terms.at(volume + strideInVolumes).minus[normal];
        evolveRight = false;
      }
    } else {
      evolveFaceStates<
        SolverType,
        NumberOfUnknowns,
        NumberOfData,
        EvaluateFlux,
        EvaluateNonconservativeProduct,
        EvaluateSource
      >(leftState,
        centreState,
        rightState,
        volumeCentre,
        volumeSize,
        normal,
        timeStamp,
        timeStepSize,
        centreMinusBuffer,
        centrePlusBuffer);
    }
    if (evolveLeft) {
      const StoragePrecision* NOALIAS const leftLeftState =
        getNeighbourAlongNormal<NumberOfVolumesPerAxis, NumberOfData>(
          inputPatch,
          faceInputPatches,
          volumeIndex,
          centreOffset,
          strideAlongNormal,
          normal,
          -2
        );
      evolveFaceStates<
        SolverType,
        NumberOfUnknowns,
        NumberOfData,
        EvaluateFlux,
        EvaluateNonconservativeProduct,
        EvaluateSource
      >(leftLeftState,
        leftState,
        centreState,
        leftVolumeCentre,
        volumeSize,
        normal,
        timeStamp,
        timeStepSize,
        leftNeighbourMinus,
        leftNeighbourPlus);
    }
    if (evolveRight) {
      const StoragePrecision* NOALIAS const rightRightState =
        getNeighbourAlongNormal<NumberOfVolumesPerAxis, NumberOfData>(
          inputPatch,
          faceInputPatches,
          volumeIndex,
          centreOffset,
          strideAlongNormal,
          normal,
          2
        );
      evolveFaceStates<
        SolverType,
        NumberOfUnknowns,
        NumberOfData,
        EvaluateFlux,
        EvaluateNonconservativeProduct,
        EvaluateSource
      >(centreState,
        rightState,
        rightRightState,
        rightVolumeCentre,
        volumeSize,
        normal,
        timeStamp,
        timeStepSize,
        rightNeighbourMinus,
        rightNeighbourPlus);
    }

    // The offset of a face from the patch centre is a multiple of half the volume width. Two faces
    // that mirror at the patch centre therefore get exactly negated offsets.
    const double lowerFaceOffset = static_cast<double>(volumeIndex(normal)) - 0.5 * NumberOfVolumesPerAxis;
    auto         leftFaceCentre(volumeCentre);
    leftFaceCentre(normal) = std::fma(lowerFaceOffset, volumeSize(normal), patchCentre(normal));
    auto rightFaceCentre(volumeCentre);
    rightFaceCentre(normal) = std::fma(lowerFaceOffset + 1.0, volumeSize(normal), patchCentre(normal));

    // The lower face comes from the ring when the neighbour below is an interior volume that
    // evaluated it as its upper face. This call evaluates the upper face and stores it in the ring.
    [[maybe_unused]] Face leftFaceBuffer;
    [[maybe_unused]] Face rightFaceBuffer;
    const Face*           leftFace         = &leftFaceBuffer;
    Face*                 rightFace        = &rightFaceBuffer;
    bool                  evaluateLeftFace = true;
    if constexpr (StoresTerms) {
      rightFace = &terms.at(volume).upperFace[normal];
      if (leftInside) {
        leftFace         = &terms.at(volume - strideInVolumes).upperFace[normal];
        evaluateLeftFace = false;
      }
    }
    if (evaluateLeftFace) {
      evaluateFaceTerms<
        SolverType,
        NumberOfVolumesPerAxis,
        NumberOfUnknowns,
        NumberOfData,
        EvaluateFlux,
        EvaluateNonconservativeProduct,
        EvaluateCustomRiemann
      >(leftPlus,
        centreMinus,
        leftFaceCentre,
        volumeSize,
        halfTimeStamp,
        timeStepSize,
        normal,
        volumeIndex,
        0,
        boundaryFaces,
        leftFaceBuffer);
    }
    evaluateFaceTerms<
      SolverType,
      NumberOfVolumesPerAxis,
      NumberOfUnknowns,
      NumberOfData,
      EvaluateFlux,
      EvaluateNonconservativeProduct,
      EvaluateCustomRiemann
    >(centrePlus,
      rightMinus,
      rightFaceCentre,
      volumeSize,
      halfTimeStamp,
      timeStepSize,
      normal,
      volumeIndex,
      1,
      boundaryFaces,
      *rightFace);

    const auto scale = static_cast<ComputePrecision>(
      (static_cast<GeometryPrecision>(timeStepSize) * static_cast<GeometryPrecision>(NumberOfVolumesPerAxis))
      / static_cast<GeometryPrecision>(patchSize(normal))
    );

    [[maybe_unused]] ComputePrecision volumeNonconservativeProduct[NumberOfUnknowns]
      __attribute__((aligned(PEANO_WITH_ALIGNMENT)));
    if constexpr (EvaluateNonconservativeProduct) {
      ComputePrecision averageState[NumberOfData] __attribute__((aligned(PEANO_WITH_ALIGNMENT)));
      ComputePrecision stateJump[NumberOfData] __attribute__((aligned(PEANO_WITH_ALIGNMENT)));
      SIMD()
      for (int unknown = 0; unknown < NumberOfData; unknown++) {
        averageState[unknown] = static_cast<ComputePrecision>(0.5) * (centreMinus[unknown] + centrePlus[unknown]);
        stateJump[unknown]    = centrePlus[unknown] - centreMinus[unknown];
      }
      SolverType::nonconservativeProduct(
        averageState,
        stateJump,
        volumeCentre,
        volumeSize,
        halfTimeStamp,
        timeStepSize,
        normal,
        volumeNonconservativeProduct
      );
    }

    if constexpr (EvaluateCustomRiemann) {
      // A solver with solveRiemannProblem need not define maxEigenvalue. This branch reads the wave
      // speeds of the Riemann solver only.
      if constexpr (EvaluateMaxEigenvalue) {
        exahype2::fv::accumulateMaxEigenvalue(maxEigenvalueAfterTimeStep, leftFace->maxWaveSpeed);
        exahype2::fv::accumulateMaxEigenvalue(maxEigenvalueAfterTimeStep, rightFace->maxWaveSpeed);
      }

      // productRoundedOnce() rounds the term of the axis before it joins the sum. Both axis orders then
      // add the same rounded terms with and without fused multiply-adds.
      SIMD()
      for (int unknown = 0; unknown < NumberOfUnknowns; unknown++) {
        ComputePrecision divergence = leftFace->rightGoingFlux[unknown] - rightFace->leftGoingFlux[unknown];
        if constexpr (EvaluateNonconservativeProduct) {
          divergence -= volumeNonconservativeProduct[unknown];
        }
        const auto contribution = static_cast<StateUpdatePrecision>(tarch::la::productRoundedOnce(scale, divergence));
        axisUpdates[normal][unknown] = contribution;
      }
    } else {
      [[maybe_unused]] ComputePrecision accumulatedNonconservativeProduct[NumberOfUnknowns]
        __attribute__((aligned(PEANO_WITH_ALIGNMENT)));
      if constexpr (EvaluateNonconservativeProduct) {
        SIMD()
        for (int unknown = 0; unknown < NumberOfUnknowns; unknown++) {
          accumulatedNonconservativeProduct[unknown] =
            static_cast<ComputePrecision>(0.5) * leftFace->nonconservativeProduct[unknown];
        }
        SIMD()
        for (int unknown = 0; unknown < NumberOfUnknowns; unknown++) {
          accumulatedNonconservativeProduct[unknown] +=
            static_cast<ComputePrecision>(0.5) * rightFace->nonconservativeProduct[unknown];
        }
        SIMD()
        for (int unknown = 0; unknown < NumberOfUnknowns; unknown++) {
          accumulatedNonconservativeProduct[unknown] += volumeNonconservativeProduct[unknown];
        }
      }

      // productRoundedOnce() rounds the term of the axis before it joins the sum. Both axis orders then
      // add the same rounded terms with and without fused multiply-adds.
      SIMD()
      for (int unknown = 0; unknown < NumberOfUnknowns; unknown++) {
        ComputePrecision divergence = leftFace->flux[unknown] - rightFace->flux[unknown];
        if constexpr (EvaluateNonconservativeProduct) {
          divergence -= accumulatedNonconservativeProduct[unknown];
        }
        const auto contribution = static_cast<StateUpdatePrecision>(tarch::la::productRoundedOnce(scale, divergence));
        axisUpdates[normal][unknown] = contribution;
      }
    }
    strideInVolumes *= NumberOfVolumesPerAxis;
  }

  SIMD()
  for (int unknown = 0; unknown < NumberOfUnknowns; unknown++) {
#if DIMENSIONS == 2
    const StateUpdatePrecision update = axisUpdates[0][unknown] + axisUpdates[1][unknown];
#else
    const StateUpdatePrecision update =
      tarch::la::sumInOrderOfValue(axisUpdates[0][unknown], axisUpdates[1][unknown], axisUpdates[2][unknown]);
#endif
    outputState[unknown] =
      static_cast<StoragePrecision>(static_cast<StateUpdatePrecision>(outputState[unknown]) + update);
  }
  // The assertion stays out of the SIMD loop. The body of that loop must not emit diagnostics.
  for (int unknown = 0; unknown < NumberOfUnknowns; unknown++) {
    ASSERTION(std::isfinite(outputState[unknown]), unknown, outputState[unknown]);
  }
}
TARGET_DECLARE_END
