TARGET_DECLARE
/**
 * Forms the two boundary-extrapolated states of one volume along @p normal and
 * evolves them by half a time step. The three states are converted to the
 * compute precision first, so the limiter and the half-step run in that
 * precision even when the patch is stored in a lower one. The @c Limiter maps
 * this neighbourhood onto the limited difference of each unknown, unless the
 * solver defines a static @c limitedDifference method, which then supplies the
 * differences instead and lets a scenario limit a derived quantity such as a
 * pressure perturbation. The default
 * extrapolation adds and subtracts half that difference; a solver that defines
 * a static @c reconstruct method replaces it, which lets a scenario keep a
 * physical quantity such as a hydrostatic pressure in balance across the two
 * boundaries. The auxiliary variables are extrapolated but not evolved in time.
 * The half-step uses the flux balance across this volume in direction
 * @p normal alone, minus the own-direction non-conservative product of the
 * volume state with the limited differences, plus the source term of the
 * volume state. Both boundaries therefore receive the same time increment,
 * and the stencil stays on the axis-aligned line, so the scheme never needs a
 * diagonal neighbour that the face exchange cannot supply.
 */
template <exahype2::fv::limiter::SlopeLimiter Limiter>
template <
  typename SolverType,
  int  NumberOfUnknowns,
  int  NumberOfData,
  bool EvaluateFlux,
  bool EvaluateNonconservativeProduct,
  bool EvaluateSource,
  typename StoragePrecision,
  typename ComputePrecision>
INLINE_METHOD GPU_CALLABLE_METHOD void exahype2::fv::reconstruction::LimitedLinear<Limiter>::evolveFaceStates(
  const StoragePrecision* NOALIAS const        leftState,
  const StoragePrecision* NOALIAS const        centreState,
  const StoragePrecision* NOALIAS const        rightState,
  const tarch::la::Vector<DIMENSIONS, double>& volumeCentre,
  const tarch::la::Vector<DIMENSIONS, double>& volumeSize,
  const int                                    normal,
  const double                                 timeStamp,
  const double                                 timeStepSize,
  ComputePrecision* NOALIAS const              evolvedMinusState,
  ComputePrecision* NOALIAS const              evolvedPlusState
) {
  using GeometryPrecision = decltype(ComputePrecision{} * double{});
  ComputePrecision leftStateForCompute[NumberOfData] __attribute__((aligned(PEANO_WITH_ALIGNMENT)));
  ComputePrecision centreStateForCompute[NumberOfData] __attribute__((aligned(PEANO_WITH_ALIGNMENT)));
  ComputePrecision rightStateForCompute[NumberOfData] __attribute__((aligned(PEANO_WITH_ALIGNMENT)));
  for (int unknown = 0; unknown < NumberOfData; unknown++) {
    leftStateForCompute[unknown]   = static_cast<ComputePrecision>(leftState[unknown]);
    centreStateForCompute[unknown] = static_cast<ComputePrecision>(centreState[unknown]);
    rightStateForCompute[unknown]  = static_cast<ComputePrecision>(rightState[unknown]);
  }

  ComputePrecision limitedDifferences[NumberOfData] __attribute__((aligned(PEANO_WITH_ALIGNMENT)));
  if constexpr (requires {
                  SolverType::limitedDifference(
                    leftStateForCompute,
                    centreStateForCompute,
                    rightStateForCompute,
                    volumeCentre,
                    volumeSize,
                    normal,
                    0
                  );
                }) {
    for (int unknown = 0; unknown < NumberOfData; unknown++) {
      limitedDifferences[unknown] = SolverType::limitedDifference(
        leftStateForCompute,
        centreStateForCompute,
        rightStateForCompute,
        volumeCentre,
        volumeSize,
        normal,
        unknown
      );
    }
  } else {
    SIMD()
    for (int unknown = 0; unknown < NumberOfData; unknown++) {
      const ComputePrecision forwardDifference  = rightStateForCompute[unknown] - centreStateForCompute[unknown];
      const ComputePrecision backwardDifference = centreStateForCompute[unknown] - leftStateForCompute[unknown];
      limitedDifferences[unknown]               = Limiter::limitedDifference(forwardDifference, backwardDifference);
    }
  }

  if constexpr (requires {
                  SolverType::reconstruct(
                    leftStateForCompute,
                    centreStateForCompute,
                    rightStateForCompute,
                    limitedDifferences,
                    volumeCentre,
                    volumeSize,
                    normal,
                    0,
                    evolvedMinusState[0],
                    evolvedPlusState[0]
                  );
                }) {
    for (int unknown = 0; unknown < NumberOfData; unknown++) {
      SolverType::reconstruct(
        leftStateForCompute,
        centreStateForCompute,
        rightStateForCompute,
        limitedDifferences,
        volumeCentre,
        volumeSize,
        normal,
        unknown,
        evolvedMinusState[unknown],
        evolvedPlusState[unknown]
      );
    }
  } else {
    SIMD()
    for (int unknown = 0; unknown < NumberOfData; unknown++) {
      evolvedMinusState[unknown] =
        centreStateForCompute[unknown] - static_cast<ComputePrecision>(0.5) * limitedDifferences[unknown];
      evolvedPlusState[unknown] =
        centreStateForCompute[unknown] + static_cast<ComputePrecision>(0.5) * limitedDifferences[unknown];
    }
  }

  if constexpr (EvaluateFlux or EvaluateNonconservativeProduct or EvaluateSource) {
    ComputePrecision predictorUpdate[NumberOfUnknowns] __attribute__((aligned(PEANO_WITH_ALIGNMENT)));
    SIMD()
    for (int unknown = 0; unknown < NumberOfUnknowns; unknown++) {
      predictorUpdate[unknown] = ComputePrecision(0);
    }

    if constexpr (EvaluateFlux) {
      ComputePrecision minusFlux[NumberOfUnknowns] __attribute__((aligned(PEANO_WITH_ALIGNMENT)));
      ComputePrecision plusFlux[NumberOfUnknowns] __attribute__((aligned(PEANO_WITH_ALIGNMENT)));
      SolverType::flux(evolvedMinusState, volumeCentre, volumeSize, timeStamp, timeStepSize, normal, minusFlux);
      SolverType::flux(evolvedPlusState, volumeCentre, volumeSize, timeStamp, timeStepSize, normal, plusFlux);
      SIMD()
      for (int unknown = 0; unknown < NumberOfUnknowns; unknown++) {
        predictorUpdate[unknown] += minusFlux[unknown] - plusFlux[unknown];
      }
    }

    if constexpr (EvaluateNonconservativeProduct) {
      ComputePrecision predictorNonconservativeProduct[NumberOfUnknowns] __attribute__((aligned(PEANO_WITH_ALIGNMENT)));
      SolverType::nonconservativeProduct(
        centreStateForCompute,
        limitedDifferences,
        volumeCentre,
        volumeSize,
        timeStamp,
        timeStepSize,
        normal,
        predictorNonconservativeProduct
      );
      SIMD()
      for (int unknown = 0; unknown < NumberOfUnknowns; unknown++) {
        predictorUpdate[unknown] -= predictorNonconservativeProduct[unknown];
      }
    }

    const ComputePrecision inverseSize = static_cast<ComputePrecision>(
      static_cast<GeometryPrecision>(1.0) / static_cast<GeometryPrecision>(volumeSize(normal))
    );
    SIMD()
    for (int unknown = 0; unknown < NumberOfUnknowns; unknown++) {
      const ComputePrecision halfStep = static_cast<ComputePrecision>(
        static_cast<GeometryPrecision>(0.5) * static_cast<GeometryPrecision>(timeStepSize)
        * static_cast<GeometryPrecision>(inverseSize) * static_cast<GeometryPrecision>(predictorUpdate[unknown])
      );
      evolvedMinusState[unknown] += halfStep;
      evolvedPlusState[unknown] += halfStep;
    }

    if constexpr (EvaluateSource) {
      ComputePrecision sources[NumberOfUnknowns] __attribute__((aligned(PEANO_WITH_ALIGNMENT)));
      SolverType::sourceTerm(centreStateForCompute, volumeCentre, volumeSize, timeStamp, timeStepSize, sources);
      SIMD()
      for (int unknown = 0; unknown < NumberOfUnknowns; unknown++) {
        const ComputePrecision sourceHalfStep = static_cast<ComputePrecision>(
          static_cast<GeometryPrecision>(0.5) * static_cast<GeometryPrecision>(timeStepSize)
          * static_cast<GeometryPrecision>(sources[unknown])
        );
        evolvedMinusState[unknown] += sourceHalfStep;
        evolvedPlusState[unknown] += sourceHalfStep;
      }
    }
  }
}

/**
 * Advances one volume with the MUSCL-Hancock update. For every direction we
 * evolve the boundary states of the two neighbours and of this volume, then
 * feed the states that meet at each interface to the Riemann solver. The left
 * face uses the left neighbour's right-boundary state and this volume's
 * left-boundary state; the right face uses this volume's right-boundary state
 * and the right neighbour's left-boundary state. The non-conservative product
 * consists of half the product over the jump at either face plus a volume
 * part over the two evolved boundary states of this volume. Their average is
 * the half-time volume state and their difference is the limited difference,
 * since the flux part of the half-step cancels in both. With zero slopes every
 * jump sits at the faces and the treatment degenerates to the splitting of
 * the first-order scheme. The reconstruction does not support a diffusive
 * source term.
 */
template <exahype2::fv::limiter::SlopeLimiter Limiter>
template <
  typename SolverType,
  int  NumberOfVolumesPerAxis,
  int  NumberOfUnknowns,
  int  NumberOfAuxiliaryVariables,
  bool EvaluateFlux,
  bool EvaluateNonconservativeProduct,
  bool EvaluateSource,
  bool EvaluateDiffusiveSource,
  bool EvaluateCustomRiemann,
  bool EvaluateMaxEigenvalue,
  typename StoragePrecision,
  typename ComputePrecision>
INLINE_METHOD GPU_CALLABLE_METHOD void exahype2::fv::reconstruction::LimitedLinear<Limiter>::accumulateFluxDivergence(
  const StoragePrecision* NOALIAS const        inputPatch,
  const StoragePrecision* NOALIAS const        faceInputPatches[peano4::FacesPerCell],
  const tarch::la::Vector<DIMENSIONS, int>&    volumeIndex,
  const int                                    centreOffset,
  const StoragePrecision* NOALIAS const        centreState,
  const tarch::la::Vector<DIMENSIONS, double>& patchCentre,
  const tarch::la::Vector<DIMENSIONS, double>& patchSize,
  const tarch::la::Vector<DIMENSIONS, double>& volumeCentre,
  const tarch::la::Vector<DIMENSIONS, double>& volumeSize,
  const double                                 timeStamp,
  const double                                 timeStepSize,
  StoragePrecision* NOALIAS const              outputState,
  double&                                      maxEigenvalueAfterTimeStep
) {
  static_assert(
    not EvaluateDiffusiveSource,
    "The LimitedLinear reconstruction does not support a diffusive source term."
  );

  constexpr int NumberOfData = NumberOfUnknowns + NumberOfAuxiliaryVariables;

  for (int normal = 0; normal < DIMENSIONS; normal++) {
    int strideAlongNormal = NumberOfData;
    for (int dimension = 0; dimension < normal; dimension++) {
      strideAlongNormal *= NumberOfVolumesPerAxis;
    }

    auto leftVolumeIndex  = volumeIndex;
    auto rightVolumeIndex = volumeIndex;
    leftVolumeIndex(normal) -= 1;
    rightVolumeIndex(normal) += 1;
    [[maybe_unused]] const auto [leftVolumeSize, leftVolumeCentre] =
      exahype2::fv::getVolumeSizeAndCentre<DIMENSIONS, NumberOfVolumesPerAxis>(
        patchCentre,
        patchSize,
        leftVolumeIndex
      );
    [[maybe_unused]] const auto [rightVolumeSize, rightVolumeCentre] =
      exahype2::fv::getVolumeSizeAndCentre<DIMENSIONS, NumberOfVolumesPerAxis>(
        patchCentre,
        patchSize,
        rightVolumeIndex
      );

    const StoragePrecision* NOALIAS const leftLeftState = exahype2::fv::reconstruction::neighbourAlongNormal<HaloSize, NumberOfVolumesPerAxis, NumberOfData>(
      inputPatch,
      faceInputPatches,
      volumeIndex,
      centreOffset,
      strideAlongNormal,
      normal,
      -2
    );
    const StoragePrecision* NOALIAS const leftState = exahype2::fv::reconstruction::neighbourAlongNormal<HaloSize, NumberOfVolumesPerAxis, NumberOfData>(
      inputPatch,
      faceInputPatches,
      volumeIndex,
      centreOffset,
      strideAlongNormal,
      normal,
      -1
    );
    const StoragePrecision* NOALIAS const rightState = exahype2::fv::reconstruction::neighbourAlongNormal<HaloSize, NumberOfVolumesPerAxis, NumberOfData>(
      inputPatch,
      faceInputPatches,
      volumeIndex,
      centreOffset,
      strideAlongNormal,
      normal,
      1
    );
    const StoragePrecision* NOALIAS const rightRightState = exahype2::fv::reconstruction::neighbourAlongNormal<HaloSize, NumberOfVolumesPerAxis, NumberOfData>(
      inputPatch,
      faceInputPatches,
      volumeIndex,
      centreOffset,
      strideAlongNormal,
      normal,
      2
    );

    [[maybe_unused]] ComputePrecision leftNeighbourMinus[NumberOfData] __attribute__((aligned(PEANO_WITH_ALIGNMENT)));
    ComputePrecision                  leftNeighbourPlus[NumberOfData] __attribute__((aligned(PEANO_WITH_ALIGNMENT)));
    ComputePrecision                  centreMinus[NumberOfData] __attribute__((aligned(PEANO_WITH_ALIGNMENT)));
    ComputePrecision                  centrePlus[NumberOfData] __attribute__((aligned(PEANO_WITH_ALIGNMENT)));
    ComputePrecision                  rightNeighbourMinus[NumberOfData] __attribute__((aligned(PEANO_WITH_ALIGNMENT)));
    [[maybe_unused]] ComputePrecision rightNeighbourPlus[NumberOfData] __attribute__((aligned(PEANO_WITH_ALIGNMENT)));

    evolveFaceStates<
      SolverType,
      NumberOfUnknowns,
      NumberOfData,
      EvaluateFlux,
      EvaluateNonconservativeProduct,
      EvaluateSource>(
      leftLeftState,
      leftState,
      centreState,
      leftVolumeCentre,
      volumeSize,
      normal,
      timeStamp,
      timeStepSize,
      leftNeighbourMinus,
      leftNeighbourPlus
    );
    evolveFaceStates<
      SolverType,
      NumberOfUnknowns,
      NumberOfData,
      EvaluateFlux,
      EvaluateNonconservativeProduct,
      EvaluateSource>(
      leftState,
      centreState,
      rightState,
      volumeCentre,
      volumeSize,
      normal,
      timeStamp,
      timeStepSize,
      centreMinus,
      centrePlus
    );
    evolveFaceStates<
      SolverType,
      NumberOfUnknowns,
      NumberOfData,
      EvaluateFlux,
      EvaluateNonconservativeProduct,
      EvaluateSource>(
      centreState,
      rightState,
      rightRightState,
      rightVolumeCentre,
      volumeSize,
      normal,
      timeStamp,
      timeStepSize,
      rightNeighbourMinus,
      rightNeighbourPlus
    );

    exahype2::fv::reconstruction::accumulateFluxDivergenceFromFaceStates<
      SolverType,
      NumberOfVolumesPerAxis,
      NumberOfUnknowns,
      NumberOfData,
      EvaluateFlux,
      EvaluateNonconservativeProduct,
      EvaluateCustomRiemann,
      EvaluateMaxEigenvalue>(
      leftNeighbourPlus,
      centreMinus,
      centrePlus,
      rightNeighbourMinus,
      patchSize,
      volumeCentre,
      volumeSize,
      normal,
      timeStamp,
      timeStepSize,
      outputState,
      maxEigenvalueAfterTimeStep
    );
  }
}
TARGET_DECLARE_END
