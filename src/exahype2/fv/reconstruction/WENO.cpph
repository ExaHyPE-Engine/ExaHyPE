TARGET_DECLARE
/**
 * A volume is available if it lies in the patch or in the halo of one face, which excludes the
 * volumes beyond the edges and corners of the patch.
 */
template <int Order, exahype2::fv::weno::NonlinearWeighting Weighting>
template <int NumberOfVolumesPerAxis>
INLINE_METHOD GPU_CALLABLE_METHOD bool exahype2::fv::reconstruction::WENO<Order, Weighting>::volumeIsAvailable(
  const tarch::la::Vector<DIMENSIONS, int>& volumeIndex
) {
  int axesOutsideOfPatch = 0;
  for (int axis = 0; axis < DIMENSIONS; axis++) {
    if (volumeIndex(axis) < -HaloSize or volumeIndex(axis) >= NumberOfVolumesPerAxis + HaloSize) {
      return false;
    }
    if (volumeIndex(axis) < 0 or volumeIndex(axis) >= NumberOfVolumesPerAxis) {
      axesOutsideOfPatch++;
    }
  }
  return axesOutsideOfPatch <= 1;
}

template <int Order, exahype2::fv::weno::NonlinearWeighting Weighting>
template <int NumberOfVolumesPerAxis, int NumberOfData, typename StoragePrecision>
INLINE_METHOD GPU_CALLABLE_METHOD const StoragePrecision* exahype2::fv::reconstruction::WENO<Order, Weighting>::volumeState(
  const StoragePrecision* NOALIAS const     inputPatch,
  const StoragePrecision* NOALIAS const     faceInputPatches[peano4::FacesPerCell],
  const tarch::la::Vector<DIMENSIONS, int>& volumeIndex
) {
  assertion(volumeIsAvailable<NumberOfVolumesPerAxis>(volumeIndex));
  for (int axis = 0; axis < DIMENSIONS; axis++) {
    tarch::la::Vector<DIMENSIONS, int> overlapCell = volumeIndex;
    if (volumeIndex(axis) < 0) {
      overlapCell(axis) = volumeIndex(axis) + HaloSize;
      const int overlapIndex =
        exahype2::serialiseVoxelIndexInOverlap(overlapCell, NumberOfVolumesPerAxis, HaloSize, axis);
      return &faceInputPatches[axis][static_cast<std::ptrdiff_t>(overlapIndex * NumberOfData)];
    }
    if (volumeIndex(axis) >= NumberOfVolumesPerAxis) {
      overlapCell(axis) = volumeIndex(axis) - NumberOfVolumesPerAxis + HaloSize;
      const int overlapIndex =
        exahype2::serialiseVoxelIndexInOverlap(overlapCell, NumberOfVolumesPerAxis, HaloSize, axis);
      return &faceInputPatches[axis + DIMENSIONS][static_cast<std::ptrdiff_t>(overlapIndex * NumberOfData)];
    }
  }
  int offset = 0;
  int stride = NumberOfData;
  for (int axis = 0; axis < DIMENSIONS; axis++) {
    offset += volumeIndex(axis) * stride;
    stride *= NumberOfVolumesPerAxis;
  }
  return &inputPatch[offset];
}

/**
 * Reconstructs the nodal coefficients of every entry along one line of 2 * Order + 1 values that
 * centres on the reconstructed volume. The values of one line position are consecutive, and
 * only stencils whose positions are all available enter the combination.
 */
template <int Order, exahype2::fv::weno::NonlinearWeighting Weighting>
template <int NumberOfData, typename ComputePrecision>
INLINE_METHOD GPU_CALLABLE_METHOD void exahype2::fv::reconstruction::WENO<Order, Weighting>::reconstructAlongLine(
  const Tables&                         tables,
  const ComputePrecision* NOALIAS const lineValues,
  const bool* NOALIAS const             lineIsAvailable,
  ComputePrecision* NOALIAS const       coefficients
) {
  constexpr int Nodes    = Tables::NumberOfNodes;
  constexpr int Stencils = Tables::NumberOfStencils;

  bool stencilIsAdmissible[Stencils];
  for (int stencil = 0; stencil < Stencils; stencil++) {
    stencilIsAdmissible[stencil] = true;
    for (int volume = 0; volume < Nodes; volume++) {
      stencilIsAdmissible[stencil] = stencilIsAdmissible[stencil]
                                 and lineIsAvailable[Tables::firstVolumeOfStencil(stencil) + Order + volume];
    }
  }

  for (int entry = 0; entry < NumberOfData; entry++) {
    ComputePrecision candidates[Stencils][Nodes];
    ComputePrecision linearWeights[Stencils];
    ComputePrecision oscillationIndicators[Stencils];
    int              numberOfStencils = 0;

    for (int stencil = 0; stencil < Stencils; stencil++) {
      if (not stencilIsAdmissible[stencil]) {
        continue;
      }
      const int firstPosition = Tables::firstVolumeOfStencil(stencil) + Order;
      for (int node = 0; node < Nodes; node++) {
        ComputePrecision coefficient = ComputePrecision(0);
        for (int volume = 0; volume < Nodes; volume++) {
          coefficient += static_cast<ComputePrecision>(
                           tables.reconstructionMatrices[(stencil * Nodes + node) * Nodes + volume]
                         )
                       * lineValues[(firstPosition + volume) * NumberOfData + entry];
        }
        candidates[numberOfStencils][node] = coefficient;
      }
      ComputePrecision indicator = ComputePrecision(0);
      for (int row = 0; row < Nodes; row++) {
        for (int column = 0; column < Nodes; column++) {
          indicator += static_cast<ComputePrecision>(tables.oscillationIndicatorMatrix[row * Nodes + column])
                     * candidates[numberOfStencils][row] * candidates[numberOfStencils][column];
        }
      }
      linearWeights[numberOfStencils]         = static_cast<ComputePrecision>(Tables::linearWeight(stencil));
      oscillationIndicators[numberOfStencils] = indicator;
      numberOfStencils++;
    }
    assertion(numberOfStencils > 0);

    ComputePrecision nonlinearWeights[Stencils];
    Weighting::weights(numberOfStencils, linearWeights, oscillationIndicators, nonlinearWeights);

    for (int node = 0; node < Nodes; node++) {
      ComputePrecision coefficient = ComputePrecision(0);
      for (int stencil = 0; stencil < numberOfStencils; stencil++) {
        coefficient += nonlinearWeights[stencil] * candidates[stencil][node];
      }
      coefficients[node * NumberOfData + entry] = coefficient;
    }
  }
}

/**
 * Writes the nodal polynomial of @p volumeIndex into @p nodalState, the first axis running
 * fastest. A @p sharedFace of -1 reads every available volume, a face number of the patch only
 * the volumes that the patch across that face holds, too. The sweep along one axis reads a buffer whose already swept axes hold nodes and whose
 * remaining axes hold the positions of the window, and writes the same with one more axis swept.
 * The two buffers take the @c ScratchSize entries of @p scratch.
 */
template <int Order, exahype2::fv::weno::NonlinearWeighting Weighting>
template <int NumberOfVolumesPerAxis, int NumberOfData, typename StoragePrecision, typename ComputePrecision>
INLINE_METHOD GPU_CALLABLE_METHOD void exahype2::fv::reconstruction::WENO<Order, Weighting>::reconstructPolynomial(
  const StoragePrecision* NOALIAS const     inputPatch,
  const StoragePrecision* NOALIAS const     faceInputPatches[peano4::FacesPerCell],
  const tarch::la::Vector<DIMENSIONS, int>& volumeIndex,
  const int                                 sharedFace,
  ComputePrecision* NOALIAS const           nodalState,
  ComputePrecision* NOALIAS const           scratch
) {
  static_assert(
    NumberOfVolumesPerAxis >= 2 * Order,
    "Every volume needs a stencil that stays inside the patch along the tangential axes."
  );

  constexpr int    Nodes      = Tables::NumberOfNodes;
  constexpr int    Window     = 2 * Order + 1;
  constexpr int    BufferSize = peano4::power(Window, DIMENSIONS) * NumberOfData;
  constexpr Tables ReconstructionTables{};

  // A polynomial for the flux through a face of the patch reads only the volumes that the patch
  // across that face holds as well: the layers of halo depth on either side of the face within
  // the tangential extent of the patch.
  int lowerBound[DIMENSIONS];
  int upperBound[DIMENSIONS];
  for (int axis = 0; axis < DIMENSIONS; axis++) {
    lowerBound[axis] = -HaloSize;
    upperBound[axis] = NumberOfVolumesPerAxis + HaloSize;
    if (sharedFace >= 0 and axis == sharedFace % DIMENSIONS) {
      const int facePosition = sharedFace < DIMENSIONS ? 0 : NumberOfVolumesPerAxis;
      lowerBound[axis]       = facePosition - HaloSize;
      upperBound[axis]       = facePosition + HaloSize;
    } else if (sharedFace >= 0) {
      lowerBound[axis] = 0;
      upperBound[axis] = NumberOfVolumesPerAxis;
    }
  }
  const auto isUsable = [&](const tarch::la::Vector<DIMENSIONS, int>& index) {
    for (int axis = 0; axis < DIMENSIONS; axis++) {
      if (index(axis) < lowerBound[axis] or index(axis) >= upperBound[axis]) {
        return false;
      }
    }
    return volumeIsAvailable<NumberOfVolumesPerAxis>(index);
  };

  ComputePrecision* NOALIAS const buffers[2] = {scratch, scratch + BufferSize};

  for (int position = 0; position < peano4::power(Window, DIMENSIONS); position++) {
    tarch::la::Vector<DIMENSIONS, int> index     = volumeIndex;
    int                                remainder = position;
    for (int axis = 0; axis < DIMENSIONS; axis++) {
      index(axis) += remainder % Window - Order;
      remainder /= Window;
    }
    if (isUsable(index)) {
      const StoragePrecision* const state =
        volumeState<NumberOfVolumesPerAxis, NumberOfData>(inputPatch, faceInputPatches, index);
      for (int entry = 0; entry < NumberOfData; entry++) {
        buffers[0][position * NumberOfData + entry] = static_cast<ComputePrecision>(state[entry]);
      }
    }
  }

  for (int sweptAxis = 0; sweptAxis < DIMENSIONS; sweptAxis++) {
    const ComputePrecision* NOALIAS const input  = buffers[sweptAxis % 2];
    ComputePrecision* NOALIAS const       output = sweptAxis == DIMENSIONS - 1 ? nodalState : buffers[(sweptAxis + 1) % 2];

    int inputStrides[DIMENSIONS];
    int outputStrides[DIMENSIONS];
    int numberOfLines = 1;
    int inputStride   = 1;
    int outputStride  = 1;
    for (int axis = 0; axis < DIMENSIONS; axis++) {
      inputStrides[axis]  = inputStride;
      outputStrides[axis] = outputStride;
      inputStride *= axis < sweptAxis ? Nodes : Window;
      outputStride *= axis <= sweptAxis ? Nodes : Window;
      if (axis != sweptAxis) {
        numberOfLines *= axis < sweptAxis ? Nodes : Window;
      }
    }

    for (int line = 0; line < numberOfLines; line++) {
      int                                inputBase  = 0;
      int                                outputBase = 0;
      tarch::la::Vector<DIMENSIONS, int> lineIndex  = volumeIndex;
      int                                remainder  = line;
      for (int axis = 0; axis < DIMENSIONS; axis++) {
        if (axis == sweptAxis) {
          continue;
        }
        const int radix      = axis < sweptAxis ? Nodes : Window;
        const int coordinate = remainder % radix;
        remainder /= radix;
        inputBase += coordinate * inputStrides[axis];
        outputBase += coordinate * outputStrides[axis];
        if (axis > sweptAxis) {
          lineIndex(axis) += coordinate - Order;
        }
      }

      if (not isUsable(lineIndex)) {
        continue;
      }

      ComputePrecision lineValues[Window * NumberOfData];
      bool             lineIsAvailable[Window];
      for (int position = 0; position < Window; position++) {
        tarch::la::Vector<DIMENSIONS, int> positionIndex = lineIndex;
        positionIndex(sweptAxis) += position - Order;
        lineIsAvailable[position] = isUsable(positionIndex);
        for (int entry = 0; entry < NumberOfData; entry++) {
          lineValues[position * NumberOfData + entry] =
            lineIsAvailable[position] ? input[(inputBase + position * inputStrides[sweptAxis]) * NumberOfData + entry]
                                      : ComputePrecision(0);
        }
      }

      ComputePrecision coefficients[Nodes * NumberOfData];
      reconstructAlongLine<NumberOfData>(ReconstructionTables, lineValues, lineIsAvailable, coefficients);
      for (int node = 0; node < Nodes; node++) {
        for (int entry = 0; entry < NumberOfData; entry++) {
          output[(outputBase + node * outputStrides[sweptAxis]) * NumberOfData + entry] =
            coefficients[node * NumberOfData + entry];
        }
      }
    }
  }
}
TARGET_DECLARE_END
