#include "exahype2/TimeStepping.h"
#include "tarch/Assertions.h"
#include "tarch/la/ScalarOperations.h"

TARGET_DECLARE
/**
 * Evaluates the flux and the largest wave speed of the state at centreOffset of patch along
 * every axis.
 */
template <
  typename SolverType,
  int  NumberOfUnknowns,
  int  NumberOfAuxiliaryVariables,
  bool EvaluateFlux,
  typename StoragePrecision,
  typename ComputePrecision
>
INLINE_METHOD void
exahype2::fv::reconstruction::Constant::StateTerms<
  SolverType,
  NumberOfUnknowns,
  NumberOfAuxiliaryVariables,
  EvaluateFlux,
  StoragePrecision,
  ComputePrecision
>::
  evaluate(
    const StoragePrecision* NOALIAS const                         patch,
    [[maybe_unused]] const StoragePrecision* NOALIAS const        faces[peano4::FacesPerCell],
    [[maybe_unused]] const tarch::la::Vector<DIMENSIONS, int>&    volumeIndex,
    const int                                                     centreOffset,
    [[maybe_unused]] const tarch::la::Vector<DIMENSIONS, double>& patchCentre,
    [[maybe_unused]] const tarch::la::Vector<DIMENSIONS, double>& patchSize,
    const tarch::la::Vector<DIMENSIONS, double>&                  volumeCentre,
    const tarch::la::Vector<DIMENSIONS, double>&                  volumeSize,
    const double                                                  timeStamp,
    const double                                                  timeStepSize
  ) {
  constexpr int                         NumberOfData = NumberOfUnknowns + NumberOfAuxiliaryVariables;
  const StoragePrecision* NOALIAS const state        = patch + centreOffset;
  // The compiler unrolls the copy of the state into registers. No flux below writes into them. The
  // compiler then evaluates every expression of the state that does not depend on the normal once.
  ComputePrecision stateForCompute[NumberOfData] __attribute__((aligned(PEANO_WITH_ALIGNMENT)));
  for (int unknown = 0; unknown < NumberOfData; unknown++) {
    stateForCompute[unknown] = static_cast<ComputePrecision>(state[unknown]);
  }
  for (int normal = 0; normal < DIMENSIONS; normal++) {
    if constexpr (EvaluateFlux) {
      SolverType::flux(stateForCompute, volumeCentre, volumeSize, timeStamp, timeStepSize, normal, flux[normal]);
    }
    maxEigenvalue[normal] =
      SolverType::maxEigenvalue(stateForCompute, volumeCentre, volumeSize, timeStamp, timeStepSize, normal);
  }
}

/**
 * Returns the flux of state along normal and writes its largest wave speed into maxEigenvalue. The
 * call reads both from the ring entry of an interior volume. It evaluates every other flux into
 * fluxBuffer.
 */
template <typename SolverType, int NumberOfUnknowns, bool EvaluateFlux, typename Terms, typename ComputePrecision>
INLINE_METHOD GPU_CALLABLE_METHOD const ComputePrecision*
exahype2::fv::reconstruction::Constant::getFluxAndMaxEigenvalue(
  [[maybe_unused]] const Terms&                terms,
  [[maybe_unused]] const int                   volume,
  const ComputePrecision* NOALIAS const        state,
  const tarch::la::Vector<DIMENSIONS, double>& volumeCentre,
  const tarch::la::Vector<DIMENSIONS, double>& volumeSize,
  const double                                 timeStamp,
  const double                                 timeStepSize,
  const int                                    normal,
  ComputePrecision* NOALIAS const              fluxBuffer,
  ComputePrecision&                            maxEigenvalue
) {
  assertion(volume >= -1, volume);
  if constexpr (Terms::Lookahead > 0) {
    if (volume >= 0) {
      const auto& entry = terms.at(volume);
      maxEigenvalue     = entry.maxEigenvalue[normal];
      return entry.flux[normal];
    }
  }
  if constexpr (EvaluateFlux) {
    SolverType::flux(state, volumeCentre, volumeSize, timeStamp, timeStepSize, normal, fluxBuffer);
  }
  maxEigenvalue =
    getMaxEigenvalue<SolverType>(terms, volume, state, volumeCentre, volumeSize, timeStamp, timeStepSize, normal);
  return fluxBuffer;
}

/**
 * Returns the largest wave speed of state along normal from the entry of volume in the terms. The
 * call evaluates the wave speed of a halo state and every wave speed with a NoTermRing. The volume
 * -1 names a halo state.
 */
template <typename SolverType, typename Terms, typename ComputePrecision>
INLINE_METHOD GPU_CALLABLE_METHOD ComputePrecision
exahype2::fv::reconstruction::Constant::getMaxEigenvalue(
  [[maybe_unused]] const Terms&                terms,
  [[maybe_unused]] const int                   volume,
  const ComputePrecision* NOALIAS const        state,
  const tarch::la::Vector<DIMENSIONS, double>& volumeCentre,
  const tarch::la::Vector<DIMENSIONS, double>& volumeSize,
  const double                                 timeStamp,
  const double                                 timeStepSize,
  const int                                    normal
) {
  assertion(volume >= -1, volume);
  if constexpr (Terms::Lookahead > 0) {
    if (volume >= 0) {
      return terms.at(volume).maxEigenvalue[normal];
    }
  } else if constexpr (std::is_same_v<Terms, exahype2::fv::WaveSpeedsOfTeam<ComputePrecision>>) {
    if (volume >= 0) {
      return terms.at(volume, normal);
    }
  }
  return SolverType::maxEigenvalue(state, volumeCentre, volumeSize, timeStamp, timeStepSize, normal);
}

/**
 * Adds the flux divergence of one volume to outputState with a Rusanov flux or the Riemann
 * solver of the solver class. The call reads the flux and the wave speed of an interior neighbour
 * from the terms that contain them. The time-stepping policy evaluates the source.
 */
template <
  typename SolverType,
  int  NumberOfVolumesPerAxis,
  int  NumberOfUnknowns,
  int  NumberOfAuxiliaryVariables,
  bool EvaluateFlux,
  bool EvaluateNonconservativeProduct,
  bool EvaluateSource,
  bool EvaluateDiffusiveSource,
  bool EvaluateCustomRiemann,
  bool EvaluateMaxEigenvalue,
  typename StoragePrecision,
  typename ComputePrecision,
  typename Terms
>
INLINE_METHOD GPU_CALLABLE_METHOD void
exahype2::fv::reconstruction::Constant::accumulateFluxDivergence(
  const StoragePrecision* NOALIAS const        inputPatch,
  const StoragePrecision* NOALIAS const        faceInputPatches[peano4::FacesPerCell],
  const tarch::la::Vector<DIMENSIONS, int>&    volumeIndex,
  const int                                    centreOffset,
  const StoragePrecision* NOALIAS const        centreState,
  const tarch::la::Vector<DIMENSIONS, double>& patchCentre,
  const tarch::la::Vector<DIMENSIONS, double>& patchSize,
  const tarch::la::Vector<DIMENSIONS, double>& volumeCentre,
  const tarch::la::Vector<DIMENSIONS, double>& volumeSize,
  const double                                 timeStamp,
  const double                                 timeStepSize,
  [[maybe_unused]] const int                   boundaryFaces,
  StoragePrecision* NOALIAS const              outputState,
  double&                                      maxEigenvalueAfterTimeStep,
  [[maybe_unused]] const Terms&                terms
) {
  constexpr int NumberOfData = NumberOfUnknowns + NumberOfAuxiliaryVariables;
  const int     volume       = centreOffset / NumberOfData;
  using GeometryPrecision    = decltype(ComputePrecision{} * double{});
  using StateUpdatePrecision = decltype(StoragePrecision{} + ComputePrecision{});
  using TimeUpdatePrecision  = decltype(StoragePrecision{} + GeometryPrecision{});

  [[maybe_unused]] ComputePrecision centreStateComputeBuffer[NumberOfData]
    __attribute__((aligned(PEANO_WITH_ALIGNMENT)));
  const ComputePrecision* NOALIAS centreStateForCompute;
  if constexpr (std::is_same_v<StoragePrecision, ComputePrecision>) {
    centreStateForCompute = centreState;
  } else {
    SIMD(aligned(centreStateComputeBuffer : PEANO_WITH_ALIGNMENT))
    for (int unknown = 0; unknown < NumberOfData; unknown++) {
      centreStateComputeBuffer[unknown] = static_cast<ComputePrecision>(centreState[unknown]);
    }
    centreStateForCompute = centreStateComputeBuffer;
  }

  if constexpr (EvaluateDiffusiveSource) {
    ComputePrecision stateGradient[DIMENSIONS * NumberOfUnknowns] __attribute__((aligned(PEANO_WITH_ALIGNMENT)));
    for (int normal = 0; normal < DIMENSIONS; normal++) {
      int strideAlongNormal = NumberOfData;
      for (int dimension = 0; dimension < normal; dimension++) {
        strideAlongNormal *= NumberOfVolumesPerAxis;
      }

      const StoragePrecision* NOALIAS rightStateInStorage = nullptr;
      if (volumeIndex(normal) + HaloSize < NumberOfVolumesPerAxis) {
        rightStateInStorage = &inputPatch[centreOffset + HaloSize * strideAlongNormal];
      } else {
        tarch::la::Vector<DIMENSIONS, int> overlapCell = volumeIndex;
        overlapCell(normal)                            = volumeIndex(normal) + 2 * HaloSize - NumberOfVolumesPerAxis;
        const int overlapIndex =
          exahype2::fv::getFaceVolumeIndex(overlapCell, NumberOfVolumesPerAxis, HaloSize, normal);
        rightStateInStorage =
          &faceInputPatches[normal + DIMENSIONS][static_cast<std::ptrdiff_t>(overlapIndex) * NumberOfData];
      }

      const auto inverseSpacing = static_cast<ComputePrecision>(
        static_cast<GeometryPrecision>(NumberOfVolumesPerAxis)
        / (static_cast<GeometryPrecision>(HaloSize) * static_cast<GeometryPrecision>(patchSize(normal)))
      );
      SIMD(aligned(stateGradient : PEANO_WITH_ALIGNMENT))
      for (int unknown = 0; unknown < NumberOfUnknowns; unknown++) {
        stateGradient[normal * NumberOfUnknowns + unknown] = inverseSpacing
          * (static_cast<ComputePrecision>(rightStateInStorage[unknown]) - centreStateForCompute[unknown]);
      }
    }

    ComputePrecision diffusiveSources[NumberOfUnknowns] __attribute__((aligned(PEANO_WITH_ALIGNMENT)));
    SolverType::diffusiveSourceTerm(
      centreStateForCompute,
      stateGradient,
      volumeCentre,
      volumeSize,
      timeStamp,
      timeStepSize,
      diffusiveSources
    );
    SIMD(aligned(diffusiveSources : PEANO_WITH_ALIGNMENT))
    for (int unknown = 0; unknown < NumberOfUnknowns; unknown++) {
      outputState[unknown] = static_cast<StoragePrecision>(
        static_cast<TimeUpdatePrecision>(outputState[unknown])
        + static_cast<TimeUpdatePrecision>(timeStepSize) * static_cast<TimeUpdatePrecision>(diffusiveSources[unknown])
      );
    }
  }

  // Every axis writes its flux difference into its own update. The updates of an unknown add with
  // tarch::la::sumInOrderOfValue() in 3D and enter outputState once. Mirrored and swapped volumes
  // receive mirrored and swapped states.
  StateUpdatePrecision axisUpdates[DIMENSIONS][NumberOfUnknowns];

  UNROLL(DIMENSIONS)
  for (int normal = 0; normal < DIMENSIONS; normal++) {
    auto leftVolumeIndex  = volumeIndex;
    auto rightVolumeIndex = volumeIndex;
    leftVolumeIndex(normal) -= HaloSize;
    rightVolumeIndex(normal) += HaloSize;

    [[maybe_unused]] const auto leftVolumeCentre =
      exahype2::fv::getVolumeCentre(patchCentre, patchSize, NumberOfVolumesPerAxis, leftVolumeIndex);
    [[maybe_unused]] const auto rightVolumeCentre =
      exahype2::fv::getVolumeCentre(patchCentre, patchSize, NumberOfVolumesPerAxis, rightVolumeIndex);

    int strideInVolumes = 1;
    for (int dimension = 0; dimension < normal; dimension++) {
      strideInVolumes *= NumberOfVolumesPerAxis;
    }
    const int strideAlongNormal = strideInVolumes * NumberOfData;

    const StoragePrecision* NOALIAS leftStateInStorage = nullptr;
    int                             leftVolume         = -1;
    if (leftVolumeIndex(normal) >= 0) {
      leftStateInStorage = &inputPatch[centreOffset - HaloSize * strideAlongNormal];
      leftVolume         = volume - HaloSize * strideInVolumes;
    } else {
      tarch::la::Vector<DIMENSIONS, int> overlapCell = volumeIndex;
      overlapCell(normal)                            = volumeIndex(normal);
      const int overlapIndex = exahype2::fv::getFaceVolumeIndex(overlapCell, NumberOfVolumesPerAxis, HaloSize, normal);
      leftStateInStorage     = &faceInputPatches[normal][static_cast<std::ptrdiff_t>(overlapIndex) * NumberOfData];
    }

    const StoragePrecision* NOALIAS rightStateInStorage = nullptr;
    int                             rightVolume         = -1;
    if (rightVolumeIndex(normal) < NumberOfVolumesPerAxis) {
      rightStateInStorage = &inputPatch[centreOffset + HaloSize * strideAlongNormal];
      rightVolume         = volume + HaloSize * strideInVolumes;
    } else {
      tarch::la::Vector<DIMENSIONS, int> overlapCell = volumeIndex;
      overlapCell(normal)                            = volumeIndex(normal) + 2 * HaloSize - NumberOfVolumesPerAxis;
      const int overlapIndex = exahype2::fv::getFaceVolumeIndex(overlapCell, NumberOfVolumesPerAxis, HaloSize, normal);
      rightStateInStorage =
        &faceInputPatches[normal + DIMENSIONS][static_cast<std::ptrdiff_t>(overlapIndex) * NumberOfData];
    }

    [[maybe_unused]] ComputePrecision leftStateComputeBuffer[NumberOfData]
      __attribute__((aligned(PEANO_WITH_ALIGNMENT)));
    [[maybe_unused]] ComputePrecision rightStateComputeBuffer[NumberOfData]
      __attribute__((aligned(PEANO_WITH_ALIGNMENT)));
    const ComputePrecision* NOALIAS leftState;
    const ComputePrecision* NOALIAS rightState;
#if defined(PEANO_WITH_GPU_BACKEND)
    SIMD(aligned(leftStateComputeBuffer, rightStateComputeBuffer : PEANO_WITH_ALIGNMENT))
    for (int unknown = 0; unknown < NumberOfData; unknown++) {
      leftStateComputeBuffer[unknown]  = static_cast<ComputePrecision>(leftStateInStorage[unknown]);
      rightStateComputeBuffer[unknown] = static_cast<ComputePrecision>(rightStateInStorage[unknown]);
    }
    leftState  = leftStateComputeBuffer;
    rightState = rightStateComputeBuffer;
#else
    if constexpr (std::is_same_v<StoragePrecision, ComputePrecision>) {
      leftState  = leftStateInStorage;
      rightState = rightStateInStorage;
    } else {
      SIMD(aligned(leftStateComputeBuffer, rightStateComputeBuffer : PEANO_WITH_ALIGNMENT))
      for (int unknown = 0; unknown < NumberOfData; unknown++) {
        leftStateComputeBuffer[unknown]  = static_cast<ComputePrecision>(leftStateInStorage[unknown]);
        rightStateComputeBuffer[unknown] = static_cast<ComputePrecision>(rightStateInStorage[unknown]);
      }
      leftState  = leftStateComputeBuffer;
      rightState = rightStateComputeBuffer;
    }
    assertion(leftState);
    assertion(rightState);
#endif

    if constexpr (EvaluateCustomRiemann) {
      auto leftFaceCentre(volumeCentre);
      leftFaceCentre(normal) -=
        static_cast<GeometryPrecision>(0.5) * static_cast<GeometryPrecision>(volumeSize(normal));
      auto rightFaceCentre(volumeCentre);
      rightFaceCentre(normal) +=
        static_cast<GeometryPrecision>(0.5) * static_cast<GeometryPrecision>(volumeSize(normal));

      ComputePrecision leftGoingFluxLeftFace[NumberOfUnknowns] __attribute__((aligned(PEANO_WITH_ALIGNMENT)));
      ComputePrecision rightGoingFluxLeftFace[NumberOfUnknowns] __attribute__((aligned(PEANO_WITH_ALIGNMENT)));
      ComputePrecision leftGoingFluxRightFace[NumberOfUnknowns] __attribute__((aligned(PEANO_WITH_ALIGNMENT)));
      ComputePrecision rightGoingFluxRightFace[NumberOfUnknowns] __attribute__((aligned(PEANO_WITH_ALIGNMENT)));

      const auto maxWaveSpeedLeft =
        static_cast<ComputePrecision>(exahype2::fv::solveRiemannProblemOnVolumeFace<SolverType, NumberOfVolumesPerAxis>(
          leftState,
          centreStateForCompute,
          leftFaceCentre,
          volumeSize,
          timeStamp,
          timeStepSize,
          normal,
          volumeIndex,
          0,
          boundaryFaces,
          leftGoingFluxLeftFace,
          rightGoingFluxLeftFace
        ));
      const auto maxWaveSpeedRight =
        static_cast<ComputePrecision>(exahype2::fv::solveRiemannProblemOnVolumeFace<SolverType, NumberOfVolumesPerAxis>(
          centreStateForCompute,
          rightState,
          rightFaceCentre,
          volumeSize,
          timeStamp,
          timeStepSize,
          normal,
          volumeIndex,
          1,
          boundaryFaces,
          leftGoingFluxRightFace,
          rightGoingFluxRightFace
        ));
      // A solver that defines solveRiemannProblem need not define maxEigenvalue. The wave speed
      // the Riemann solver returns is the only eigenvalue this branch reads.
      if constexpr (EvaluateMaxEigenvalue) {
        exahype2::fv::accumulateMaxEigenvalue(maxEigenvalueAfterTimeStep, maxWaveSpeedLeft);
        exahype2::fv::accumulateMaxEigenvalue(maxEigenvalueAfterTimeStep, maxWaveSpeedRight);
      }

      const auto scale = static_cast<ComputePrecision>(
        (static_cast<GeometryPrecision>(timeStepSize) * static_cast<GeometryPrecision>(NumberOfVolumesPerAxis))
        / static_cast<GeometryPrecision>(patchSize(normal))
      );
      // productRoundedOnce() rounds the term of the axis before it joins the sum. Both axis orders then
      // add the same rounded terms with and without fused multiply-adds.
      SIMD(aligned(rightGoingFluxLeftFace, leftGoingFluxRightFace : PEANO_WITH_ALIGNMENT))
      for (int unknown = 0; unknown < NumberOfUnknowns; unknown++) {
        const ComputePrecision fluxFromLeftInterface = rightGoingFluxLeftFace[unknown];
        const ComputePrecision fluxToRightInterface  = leftGoingFluxRightFace[unknown];
        const auto             contribution          = static_cast<StateUpdatePrecision>(
          tarch::la::productRoundedOnce(scale, fluxFromLeftInterface - fluxToRightInterface)
        );
        axisUpdates[normal][unknown] = contribution;
      }
    } else {
      ComputePrecision              leftFluxBuffer[NumberOfUnknowns] __attribute__((aligned(PEANO_WITH_ALIGNMENT)));
      ComputePrecision              rightFluxBuffer[NumberOfUnknowns] __attribute__((aligned(PEANO_WITH_ALIGNMENT)));
      ComputePrecision              leftMaxEigenvalue;
      ComputePrecision              rightMaxEigenvalue;
      const ComputePrecision* const leftFluxes = getFluxAndMaxEigenvalue<SolverType, NumberOfUnknowns, EvaluateFlux>(
        terms,
        leftVolume,
        leftState,
        leftVolumeCentre,
        volumeSize,
        timeStamp,
        timeStepSize,
        normal,
        leftFluxBuffer,
        leftMaxEigenvalue
      );
      const ComputePrecision* const rightFluxes = getFluxAndMaxEigenvalue<SolverType, NumberOfUnknowns, EvaluateFlux>(
        terms,
        rightVolume,
        rightState,
        rightVolumeCentre,
        volumeSize,
        timeStamp,
        timeStepSize,
        normal,
        rightFluxBuffer,
        rightMaxEigenvalue
      );

      ComputePrecision centreNonconservativeProduct[NumberOfUnknowns] __attribute__((aligned(PEANO_WITH_ALIGNMENT)));
      ComputePrecision leftNonconservativeProduct[NumberOfUnknowns] __attribute__((aligned(PEANO_WITH_ALIGNMENT)));
      if constexpr (EvaluateNonconservativeProduct) {
        ComputePrecision centreAverageState[NumberOfData] __attribute__((aligned(PEANO_WITH_ALIGNMENT)));
        ComputePrecision leftAverageState[NumberOfData] __attribute__((aligned(PEANO_WITH_ALIGNMENT)));
        ComputePrecision centreStateJump[NumberOfData] __attribute__((aligned(PEANO_WITH_ALIGNMENT)));
        ComputePrecision leftStateJump[NumberOfData] __attribute__((aligned(PEANO_WITH_ALIGNMENT)));
        SIMD(aligned(centreAverageState, leftAverageState : PEANO_WITH_ALIGNMENT))
        for (int unknown = 0; unknown < NumberOfData; unknown++) {
          centreAverageState[unknown] =
            static_cast<ComputePrecision>(0.5) * (centreStateForCompute[unknown] + rightState[unknown]);
          leftAverageState[unknown] =
            static_cast<ComputePrecision>(0.5) * (leftState[unknown] + centreStateForCompute[unknown]);
        }
        SIMD(aligned(centreStateJump, leftStateJump : PEANO_WITH_ALIGNMENT))
        for (int unknown = 0; unknown < NumberOfData; unknown++) {
          centreStateJump[unknown] = rightState[unknown] - centreStateForCompute[unknown];
          leftStateJump[unknown]   = centreStateForCompute[unknown] - leftState[unknown];
        }
        SolverType::nonconservativeProduct(
          centreAverageState,
          centreStateJump,
          volumeCentre,
          volumeSize,
          timeStamp,
          timeStepSize,
          normal,
          centreNonconservativeProduct
        );
        SolverType::nonconservativeProduct(
          leftAverageState,
          leftStateJump,
          leftVolumeCentre,
          volumeSize,
          timeStamp,
          timeStepSize,
          normal,
          leftNonconservativeProduct
        );
      }

      const ComputePrecision centreMaxEigenvalue = getMaxEigenvalue<SolverType>(
        terms,
        volume,
        centreStateForCompute,
        volumeCentre,
        volumeSize,
        timeStamp,
        timeStepSize,
        normal
      );
      assertion(
        exahype2::MaxEigenvalueReduction::isPhysicalValue(leftMaxEigenvalue),
        leftMaxEigenvalue,
        volume,
        normal
      );
      assertion(
        exahype2::MaxEigenvalueReduction::isPhysicalValue(centreMaxEigenvalue),
        centreMaxEigenvalue,
        volume,
        normal
      );
      assertion(
        exahype2::MaxEigenvalueReduction::isPhysicalValue(rightMaxEigenvalue),
        rightMaxEigenvalue,
        volume,
        normal
      );
      leftMaxEigenvalue  = centreMaxEigenvalue > leftMaxEigenvalue ? centreMaxEigenvalue : leftMaxEigenvalue;
      rightMaxEigenvalue = centreMaxEigenvalue > rightMaxEigenvalue ? centreMaxEigenvalue : rightMaxEigenvalue;

      const auto scale = static_cast<ComputePrecision>(
        (static_cast<GeometryPrecision>(timeStepSize) * static_cast<GeometryPrecision>(NumberOfVolumesPerAxis)
         * static_cast<GeometryPrecision>(0.5))
        / static_cast<GeometryPrecision>(patchSize(normal))
      );
      // A fused multiply-add pairs the Rusanov diffusion of a face with its flux. Every compiler then
      // rounds the face flux once. productRoundedOnce() rounds the term of the axis before it joins
      // the sum. Both axis orders then add the same rounded terms.
      for (int unknown = 0; unknown < NumberOfUnknowns; unknown++) {
        const ComputePrecision leftJump  = centreStateForCompute[unknown] - leftState[unknown];
        const ComputePrecision rightJump = rightState[unknown] - centreStateForCompute[unknown];
        ComputePrecision       fluxLeftFace =
          std::fma(-leftMaxEigenvalue, leftJump, EvaluateFlux ? leftFluxes[unknown] : ComputePrecision{0});
        ComputePrecision fluxRightFace =
          std::fma(-rightMaxEigenvalue, rightJump, EvaluateFlux ? rightFluxes[unknown] : ComputePrecision{0});
        if constexpr (EvaluateNonconservativeProduct) {
          fluxLeftFace -= leftNonconservativeProduct[unknown];
          fluxRightFace += centreNonconservativeProduct[unknown];
        }
        const auto contribution =
          static_cast<StateUpdatePrecision>(tarch::la::productRoundedOnce(scale, fluxLeftFace - fluxRightFace));
        axisUpdates[normal][unknown] = contribution;
      }
    }
  }

  SIMD()
  for (int unknown = 0; unknown < NumberOfUnknowns; unknown++) {
#if DIMENSIONS == 2
    const StateUpdatePrecision update = axisUpdates[0][unknown] + axisUpdates[1][unknown];
#else
    const StateUpdatePrecision update =
      tarch::la::sumInOrderOfValue(axisUpdates[0][unknown], axisUpdates[1][unknown], axisUpdates[2][unknown]);
#endif
    outputState[unknown] =
      static_cast<StoragePrecision>(static_cast<StateUpdatePrecision>(outputState[unknown]) + update);
  }
  // The assertion stays out of the SIMD loop. The body of that loop must not emit diagnostics.
  for (int unknown = 0; unknown < NumberOfUnknowns; unknown++) {
    assertion(std::isfinite(outputState[unknown]), unknown, outputState[unknown]);
  }
}
/**
 * Writes the flux along the positive normal that the update of the volume with volumeIndex applies
 * through its face on patch face patchFace: The flux of the Riemann solver of the solver class, or
 * the Rusanov flux with half of the non-conservative product over the face jump. The flux of the
 * volume itself cancels between its faces in the update but belongs to each of its faces.
 */
template <
  typename SolverType,
  int  NumberOfVolumesPerAxis,
  int  NumberOfUnknowns,
  int  NumberOfAuxiliaryVariables,
  bool EvaluateFlux,
  bool EvaluateNonconservativeProduct,
  bool EvaluateSource,
  bool EvaluateCustomRiemann,
  typename StoragePrecision,
  typename ComputePrecision
>
INLINE_METHOD GPU_CALLABLE_METHOD void
exahype2::fv::reconstruction::Constant::patchFaceFlux(
  const StoragePrecision* NOALIAS const        inputPatch,
  const StoragePrecision* NOALIAS const        faceInputPatches[peano4::FacesPerCell],
  const tarch::la::Vector<DIMENSIONS, int>&    volumeIndex,
  const int                                    patchFace,
  const tarch::la::Vector<DIMENSIONS, double>& patchCentre,
  const tarch::la::Vector<DIMENSIONS, double>& patchSize,
  const double                                 timeStamp,
  const double                                 timeStepSize,
  const int                                    boundaryFaces,
  ComputePrecision* NOALIAS const              flux
) {
  constexpr int NumberOfData = NumberOfUnknowns + NumberOfAuxiliaryVariables;
  const int     normal       = patchFace % DIMENSIONS;
  const int     side         = patchFace / DIMENSIONS;
  auto          overlapCell  = volumeIndex;
  overlapCell(normal) = side == 0 ? volumeIndex(normal) : volumeIndex(normal) + 2 * HaloSize - NumberOfVolumesPerAxis;
  const int overlapIndex = exahype2::fv::getFaceVolumeIndex(overlapCell, NumberOfVolumesPerAxis, HaloSize, normal);

  ComputePrecision centre[NumberOfData];
  ComputePrecision outside[NumberOfData];
  for (int value = 0; value < NumberOfData; value++) {
    centre[value] = static_cast<ComputePrecision>(
      inputPatch[static_cast<std::ptrdiff_t>(peano4::dLinearised(volumeIndex, NumberOfVolumesPerAxis)) * NumberOfData + value]
    );
    outside[value] = static_cast<ComputePrecision>(
      faceInputPatches[patchFace][static_cast<std::ptrdiff_t>(overlapIndex) * NumberOfData + value]
    );
  }
  volumeFaceFlux<
    SolverType,
    NumberOfVolumesPerAxis,
    NumberOfUnknowns,
    NumberOfAuxiliaryVariables,
    EvaluateFlux,
    EvaluateNonconservativeProduct,
    EvaluateCustomRiemann,
    ComputePrecision
  >(centre, outside, volumeIndex, patchFace, patchCentre, patchSize, timeStamp, timeStepSize, boundaryFaces, flux);
}

/**
 * Writes the flux along the positive normal that the update of the volume with volumeIndex and the
 * state centre applies through its face face, with the state outside behind that face: The flux of
 * the Riemann solver of the solver class, or the Rusanov flux with half of the non-conservative
 * product over the face jump.
 */
template <
  typename SolverType,
  int  NumberOfVolumesPerAxis,
  int  NumberOfUnknowns,
  int  NumberOfAuxiliaryVariables,
  bool EvaluateFlux,
  bool EvaluateNonconservativeProduct,
  bool EvaluateCustomRiemann,
  typename ComputePrecision
>
INLINE_METHOD GPU_CALLABLE_METHOD void
exahype2::fv::reconstruction::Constant::volumeFaceFlux(
  const ComputePrecision* NOALIAS const        centre,
  const ComputePrecision* NOALIAS const        outside,
  const tarch::la::Vector<DIMENSIONS, int>&    volumeIndex,
  const int                                    face,
  const tarch::la::Vector<DIMENSIONS, double>& patchCentre,
  const tarch::la::Vector<DIMENSIONS, double>& patchSize,
  const double                                 timeStamp,
  const double                                 timeStepSize,
  [[maybe_unused]] const int                   boundaryFaces,
  ComputePrecision* NOALIAS const              flux
) {
  constexpr int NumberOfData = NumberOfUnknowns + NumberOfAuxiliaryVariables;
  const int     normal       = face % DIMENSIONS;
  const int     side         = face / DIMENSIONS;
  const auto    volumeSize   = exahype2::fv::getVolumeSize(patchSize, NumberOfVolumesPerAxis);
  const auto    volumeCentre = exahype2::fv::getVolumeCentre(patchCentre, patchSize, NumberOfVolumesPerAxis, volumeIndex);
  auto          outsideIndex = volumeIndex;
  outsideIndex(normal) += side == 0 ? -1 : 1;
  [[maybe_unused]] const auto outsideCentre =
    exahype2::fv::getVolumeCentre(patchCentre, patchSize, NumberOfVolumesPerAxis, outsideIndex);
  const ComputePrecision* const lower = side == 0 ? outside : centre;
  const ComputePrecision* const upper = side == 0 ? centre : outside;

  if constexpr (EvaluateCustomRiemann) {
    auto faceCentre = volumeCentre;
    faceCentre(normal) += (side == 0 ? -0.5 : 0.5) * volumeSize(normal);
    ComputePrecision leftGoingFlux[NumberOfUnknowns];
    ComputePrecision rightGoingFlux[NumberOfUnknowns];
    static_cast<void>(exahype2::fv::solveRiemannProblemOnVolumeFace<SolverType, NumberOfVolumesPerAxis>(
      lower,
      upper,
      faceCentre,
      volumeSize,
      timeStamp,
      timeStepSize,
      normal,
      volumeIndex,
      side,
      boundaryFaces,
      leftGoingFlux,
      rightGoingFlux
    ));
    for (int unknown = 0; unknown < NumberOfUnknowns; unknown++) {
      flux[unknown] = side == 0 ? rightGoingFlux[unknown] : leftGoingFlux[unknown];
    }
  } else {
    ComputePrecision centreFlux[NumberOfUnknowns]{};
    ComputePrecision outsideFlux[NumberOfUnknowns]{};
    if constexpr (EvaluateFlux) {
      SolverType::flux(centre, volumeCentre, volumeSize, timeStamp, timeStepSize, normal, centreFlux);
      SolverType::flux(outside, outsideCentre, volumeSize, timeStamp, timeStepSize, normal, outsideFlux);
    }
    const ComputePrecision centreMaxEigenvalue =
      SolverType::maxEigenvalue(centre, volumeCentre, volumeSize, timeStamp, timeStepSize, normal);
    const ComputePrecision outsideMaxEigenvalue =
      SolverType::maxEigenvalue(outside, outsideCentre, volumeSize, timeStamp, timeStepSize, normal);
    const ComputePrecision maxEigenvalue =
      centreMaxEigenvalue > outsideMaxEigenvalue ? centreMaxEigenvalue : outsideMaxEigenvalue;
    const auto half = static_cast<ComputePrecision>(0.5);
    for (int unknown = 0; unknown < NumberOfUnknowns; unknown++) {
      flux[unknown] =
        half * (outsideFlux[unknown] + centreFlux[unknown]) - half * maxEigenvalue * (upper[unknown] - lower[unknown]);
    }
    if constexpr (EvaluateNonconservativeProduct) {
      ComputePrecision averageState[NumberOfData];
      ComputePrecision stateJump[NumberOfData];
      for (int value = 0; value < NumberOfData; value++) {
        averageState[value] = half * (lower[value] + upper[value]);
        stateJump[value]    = upper[value] - lower[value];
      }
      ComputePrecision product[NumberOfUnknowns];
      SolverType::nonconservativeProduct(
        averageState,
        stateJump,
        side == 0 ? outsideCentre : volumeCentre,
        volumeSize,
        timeStamp,
        timeStepSize,
        normal,
        product
      );
      for (int unknown = 0; unknown < NumberOfUnknowns; unknown++) {
        flux[unknown] += side == 0 ? -half * product[unknown] : half * product[unknown];
      }
    }
  }
}
TARGET_DECLARE_END
