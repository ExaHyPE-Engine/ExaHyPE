/**
 * Copies the halo halves a sweep has written from the new face overlap into the old one and
 * moves the time stamps of every half one step on.
 *
 * The mesh-update sweeps clear the updated flag of every half their projection did not reach.
 * A caller that passes hasRealisedTopologyChanges rolls each of those halves over as well, so
 * the two sides of the face solve their Riemann problems on halo data of one age.
 */
template <
  int NumberOfValuesPerVolume,
  int NumberOfVolumesPerAxis,
  int HaloSize,
  typename FaceLabel,
  typename StoragePrecision>
INLINE_METHOD void exahype2::fv::rollOverFaceHalo(
  const peano4::dataview::FaceMarker& marker,
  FaceLabel&                          faceLabel,
  const StoragePrecision* const       newHalo,
  StoragePrecision* const             oldHalo,
  const bool                          hasRealisedTopologyChanges
) {
  assertion(newHalo != nullptr);
  assertion(oldHalo != nullptr);

  const int normal = marker.getSelectedFaceNumber() % DIMENSIONS;

  for (int half = 0; half < 2; half++) {
    if (faceLabel.getUpdated(half) or (hasRealisedTopologyChanges and not faceLabel.getRequiresDataTransfer(half))) {
      const bool isRightLayer = half == 1;
      exahype2::fv::copyHalfOfHalo(
        NumberOfValuesPerVolume,
        NumberOfVolumesPerAxis,
        HaloSize,
        normal,
        isRightLayer,
        newHalo,
        oldHalo
      );
      faceLabel.setUpdated(half, false);
    }
    faceLabel.setOldTimeStamp(half, faceLabel.getNewTimeStamp(half));
    faceLabel.setNewTimeStamp(half, faceLabel.getUpdatedTimeStamp(half));
  }
}

/**
 * Swaps the updated patch of one cell with the previous one and takes the updated flag down.
 * A cell no sweep has updated keeps both patches.
 */
template <typename CellLabel, typename OldPatch, typename NewPatch>
INLINE_METHOD void exahype2::fv::rollOverCellSolution(CellLabel& cellLabel, OldPatch& oldPatch, NewPatch& newPatch) {
  static_assert(OldPatch::Cardinality == NewPatch::Cardinality, "Both patches hold the values of one cell.");
  if (cellLabel.getHasUpdated()) {
    cellLabel.setHasUpdated(false);
    std::swap_ranges(newPatch.data(), newPatch.data() + newPatch.Cardinality, oldPatch.data());
  }
}
