template <
  class SolverType,
  bool EvaluateMaximumEigenvalueAfterTimeStep,
  class QInEnumeratorType,
  class QOutEnumeratorType>
double exahype2::fv::riemann::updateSolutionWithRiemann_LoopBody(
  SolverType&                                   solver,
  const double* const __restrict__              QIn,
  const QInEnumeratorType&                      QInEnumerator,
  const tarch::la::Vector<Dimensions, double>&  patchCentre,
  const tarch::la::Vector<Dimensions, double>&  patchSize,
  const tarch::la::Vector<Dimensions, int>&     volume,
  const double                                  timeStamp,
  const double                                  timeStep,
  double* const __restrict__                    QOut,
  const QOutEnumeratorType&                     QOutEnumerator
) {
  constexpr auto NumberOfUnknowns = SolverType::NumberOfUnknowns;
  constexpr auto NumberOfAuxiliaryVariables = SolverType::NumberOfAuxiliaryVariables;
  constexpr auto NumberOfFiniteVolumesPerAxisPerPatch = SolverType::NumberOfFiniteVolumesPerAxisPerPatch;

  double QInGathered[NumberOfUnknowns + NumberOfAuxiliaryVariables];
  double QInGatheredLeft[NumberOfUnknowns + NumberOfAuxiliaryVariables];
  double QInGatheredRight[NumberOfUnknowns + NumberOfAuxiliaryVariables];

  double QOutGathered[NumberOfUnknowns + NumberOfAuxiliaryVariables];

  double APDQ[NumberOfUnknowns];
  double AMDQ[NumberOfUnknowns];

  double APDQLeft[NumberOfUnknowns];
  double AMDQLeft[NumberOfUnknowns];

  double maxEigenvalueAfterTimeStep = 0.0;

  const auto volumeSize = getVolumeSize(patchSize, NumberOfFiniteVolumesPerAxisPerPatch);
  const auto volumeCentre = getVolumeCentre(patchCentre, patchSize, NumberOfFiniteVolumesPerAxisPerPatch, volume);

  // gather
  #if defined(SharedOMP)
  #pragma omp simd
  #else
  #pragma unroll
  #endif
  for (int unknown = 0; unknown < NumberOfUnknowns + NumberOfAuxiliaryVariables; unknown++) {
    QInGathered[unknown] = QIn[QInEnumerator(volume, unknown)];
    QOutGathered[unknown] = QInGathered[unknown];
  }

  #if defined(SharedOMP)
  #pragma omp simd
  #else
  #pragma unroll
  #endif
  for (int normal = 0; normal < Dimensions; normal++) { // Loop over directions
    #if Dimensions == 2
    const auto volumeLeft =
      normal == 0 ? volumeIndex(volume(0) - 1, volume(1))
                  : volumeIndex(volume(0),     volume(1) - 1);
    const auto volumeRight =
      normal == 0 ? volumeIndex(volume(0) + 1, volume(1))
                  : volumeIndex(volume(0),     volume(1) + 1);
    #else
    const auto volumeLeft =
      normal == 0 ? volumeIndex(volume(0) - 1, volume(1),     volume(2)) :
      normal == 1 ? volumeIndex(volume(0),     volume(1) - 1, volume(2))
                  : volumeIndex(volume(0),     volume(1),     volume(2) - 1);
    const auto volumeRight =
      normal == 0 ? volumeIndex(volume(0) + 1, volume(1),     volume(2)) :
      normal == 1 ? volumeIndex(volume(0),     volume(1) + 1, volume(2))
                  : volumeIndex(volume(0),     volume(1),     volume(2) + 1);
    #endif

    #if defined(SharedOMP)
    #pragma omp simd
    #else
    #pragma unroll
    #endif
    for (int unknown = 0; unknown < NumberOfUnknowns + NumberOfAuxiliaryVariables; unknown++) {
      QInGatheredLeft[unknown] = QIn[QInEnumerator(volumeLeft, unknown)];
      QInGatheredRight[unknown] = QIn[QInEnumerator(volumeRight, unknown)];
    }

    const auto volumeCentreLeft = getVolumeCentre(patchCentre, patchSize, NumberOfFiniteVolumesPerAxisPerPatch, volumeLeft);
    const auto volumeCentreRight = getVolumeCentre(patchCentre, patchSize, NumberOfFiniteVolumesPerAxisPerPatch, volumeRight);

    const double maxWaveSpeedLeft = solver.solveRiemannProblem(
      QInGatheredLeft,
      QInGathered,
      volumeCentreLeft,
      volumeSize,
      timeStamp,
      timeStep,
      normal,
      AMDQLeft,
      APDQLeft
    );

    const double maxWaveSpeedRight = solver.solveRiemannProblem(
      QInGathered,
      QInGatheredRight,
      volumeCentre,
      volumeSize,
      timeStamp,
      timeStep,
      normal,
      AMDQ,
      APDQ
    );

    if constexpr (EvaluateMaximumEigenvalueAfterTimeStep) {
      maxEigenvalueAfterTimeStep = std::fmax(maxEigenvalueAfterTimeStep, std::fmax(maxWaveSpeedLeft, maxWaveSpeedRight));
    }

    #if defined(SharedOMP)
    #pragma omp simd
    #else
    #pragma unroll
    #endif
    for (int unknown = 0; unknown < NumberOfUnknowns; unknown++) {
      const double fluxPos = APDQLeft[unknown];
      const double fluxNeg = AMDQ[unknown];
      QOutGathered[unknown] -= timeStep / patchSize(normal) * NumberOfFiniteVolumesPerAxisPerPatch * (fluxNeg - fluxPos);
    }
  } // end loop over directions

  // scatter
  #if defined(SharedOMP)
  #pragma omp simd
  #else
  #pragma unroll
  #endif
  for (int unknown = 0; unknown < NumberOfUnknowns + NumberOfAuxiliaryVariables; unknown++) {
    QOut[QOutEnumerator(volume, unknown)] = QOutGathered[unknown];
  }

  return maxEigenvalueAfterTimeStep;
}

template <
  class SolverType,
  bool EvaluateMaximumEigenvalueAfterTimeStep,
  class QInEnumeratorType,
  class QOutEnumeratorType>
double exahype2::fv::riemann::updateSolutionWithRiemann_LoopBody(
  const double* const __restrict__              QIn,
  const QInEnumeratorType&                      QInEnumerator,
  const tarch::la::Vector<Dimensions, double>&  patchCentre,
  const tarch::la::Vector<Dimensions, double>&  patchSize,
  const tarch::la::Vector<Dimensions, int>&     volume,
  const double                                  timeStamp,
  const double                                  timeStep,
  double* const __restrict__                    QOut,
  const QOutEnumeratorType&                     QOutEnumerator
) {
  constexpr auto NumberOfUnknowns = SolverType::NumberOfUnknowns;
  constexpr auto NumberOfAuxiliaryVariables = SolverType::NumberOfAuxiliaryVariables;
  constexpr auto NumberOfFiniteVolumesPerAxisPerPatch = SolverType::NumberOfFiniteVolumesPerAxisPerPatch;

  double QInGathered[NumberOfUnknowns + NumberOfAuxiliaryVariables];
  double QInGatheredLeft[NumberOfUnknowns + NumberOfAuxiliaryVariables];
  double QInGatheredRight[NumberOfUnknowns + NumberOfAuxiliaryVariables];

  double QOutGathered[NumberOfUnknowns + NumberOfAuxiliaryVariables];

  double APDQ[NumberOfUnknowns];
  double AMDQ[NumberOfUnknowns];

  double APDQLeft[NumberOfUnknowns];
  double AMDQLeft[NumberOfUnknowns];

  double maxEigenvalueAfterTimeStep = 0.0;

  const auto volumeSize = getVolumeSize(patchSize, NumberOfFiniteVolumesPerAxisPerPatch);
  const auto volumeCentre = getVolumeCentre(patchCentre, patchSize, NumberOfFiniteVolumesPerAxisPerPatch, volume);

  // gather
  #if defined(SharedOMP)
  #pragma omp simd
  #else
  #pragma unroll
  #endif
  for (int unknown = 0; unknown < NumberOfUnknowns + NumberOfAuxiliaryVariables; unknown++) {
    QInGathered[unknown] = QIn[QInEnumerator(volume, unknown)];
    QOutGathered[unknown] = QInGathered[unknown];
  }

  #if defined(SharedOMP)
  #pragma omp simd
  #else
  #pragma unroll
  #endif
  for (int normal = 0; normal < Dimensions; normal++) { // Loop over directions
    #if Dimensions == 2
    const auto volumeLeft =
      normal == 0 ? volumeIndex(volume(0) - 1, volume(1))
                  : volumeIndex(volume(0),     volume(1) - 1);
    const auto volumeRight =
      normal == 0 ? volumeIndex(volume(0) + 1, volume(1))
                  : volumeIndex(volume(0),     volume(1) + 1);
    #else
    const auto volumeLeft =
      normal == 0 ? volumeIndex(volume(0) - 1, volume(1),     volume(2)) :
      normal == 1 ? volumeIndex(volume(0),     volume(1) - 1, volume(2))
                  : volumeIndex(volume(0),     volume(1),     volume(2) - 1);
    const auto volumeRight =
      normal == 0 ? volumeIndex(volume(0) + 1, volume(1),     volume(2)) :
      normal == 1 ? volumeIndex(volume(0),     volume(1) + 1, volume(2))
                  : volumeIndex(volume(0),     volume(1),     volume(2) + 1);
    #endif

    #if defined(SharedOMP)
    #pragma omp simd
    #else
    #pragma unroll
    #endif
    for (int unknown = 0; unknown < NumberOfUnknowns + NumberOfAuxiliaryVariables; unknown++) {
      QInGatheredLeft[unknown] = QIn[QInEnumerator(volumeLeft, unknown)];
      QInGatheredRight[unknown] = QIn[QInEnumerator(volumeRight, unknown)];
    }

    const auto volumeCentreLeft = getVolumeCentre(patchCentre, patchSize, NumberOfFiniteVolumesPerAxisPerPatch, volumeLeft);
    const auto volumeCentreRight = getVolumeCentre(patchCentre, patchSize, NumberOfFiniteVolumesPerAxisPerPatch, volumeRight);

    const double maxWaveSpeedLeft = SolverType::solveRiemannProblem(
      QInGatheredLeft,
      QInGathered,
      volumeCentreLeft,
      volumeSize,
      timeStamp,
      timeStep,
      normal,
      AMDQLeft,
      APDQLeft,
      Solver::Offloadable::Yes
    );

    const double maxWaveSpeedRight = SolverType::solveRiemannProblem(
      QInGathered,
      QInGatheredRight,
      volumeCentre,
      volumeSize,
      timeStamp,
      timeStep,
      normal,
      AMDQ,
      APDQ,
      Solver::Offloadable::Yes
    );

    if constexpr (EvaluateMaximumEigenvalueAfterTimeStep) {
      maxEigenvalueAfterTimeStep = std::fmax(maxEigenvalueAfterTimeStep, std::fmax(maxWaveSpeedLeft, maxWaveSpeedRight));
    }

    #if defined(SharedOMP)
    #pragma omp simd
    #else
    #pragma unroll
    #endif
    for (int unknown = 0; unknown < NumberOfUnknowns; unknown++) {
      const double fluxPos = APDQLeft[unknown];
      const double fluxNeg = AMDQ[unknown];
      QOutGathered[unknown] -= timeStep / patchSize(normal) * NumberOfFiniteVolumesPerAxisPerPatch * (fluxNeg - fluxPos);
    }
  } // end loop over directions

  // scatter
  #if defined(SharedOMP)
  #pragma omp simd
  #else
  #pragma unroll
  #endif
  for (int unknown = 0; unknown < NumberOfUnknowns + NumberOfAuxiliaryVariables; unknown++) {
    QOut[QOutEnumerator(volume, unknown)] = QOutGathered[unknown];
  }

  return maxEigenvalueAfterTimeStep;
}
