template <
  class SolverType,
  int  HaloSize,
  bool EvaluateFlux,
  bool EvaluateNonconservativeProduct,
  bool EvaluateEigenvalues,
  bool EvaluateSource,
  bool EvaluateRiemann,
  bool EvaluateMaximumEigenvalueAfterTimeStep>
void exahype2::fv::riemann::timeStepWithRiemann(SolverType& solver, CellData<double, double>& patchData) {
  static_assert(HaloSize == 1);

  static tarch::logging::Log _log("exahype2::fv::riemann");
  logTraceIn("timeStepWithRiemann()");

  const Enumerator<SolverType::NumberOfFiniteVolumesPerAxisPerPatch, HaloSize, SolverType::NumberOfUnknowns, SolverType::NumberOfAuxiliaryVariables> QInEnumerator;
  const Enumerator<SolverType::NumberOfFiniteVolumesPerAxisPerPatch, 0, SolverType::NumberOfUnknowns, SolverType::NumberOfAuxiliaryVariables> QOutEnumerator;

  double** const QIn          = patchData.QIn;
  double** const QOut         = patchData.QOut;
  const double* patchCentre   = patchData.cellCentre[0].data();
  const double* patchSize     = patchData.cellSize[0].data();
  const double* timeStamp     = patchData.t;
  const double* timeStep      = patchData.dt;
  double* const maxEigenvalue = patchData.maxEigenvalue;

  for (int patchIndex = 0; patchIndex < patchData.numberOfCells; patchIndex++) {
    double maxEigenvalueAfterTimeStep = 0.0;

    #if Dimensions == 3
    for (int z = 0; z < SolverType::NumberOfFiniteVolumesPerAxisPerPatch; z++) {
    #endif
      for (int y = 0; y < SolverType::NumberOfFiniteVolumesPerAxisPerPatch; y++) {
        for (int x = 0; x < SolverType::NumberOfFiniteVolumesPerAxisPerPatch; x++) {
          const auto volume = volumeIndex(x, y
            #if Dimensions == 3
            , z
            #endif
          );
          if constexpr (EvaluateRiemann) {
            maxEigenvalueAfterTimeStep = std::fmax(
              maxEigenvalueAfterTimeStep,
              updateSolutionWithRiemann_LoopBody<SolverType, EvaluateMaximumEigenvalueAfterTimeStep>(
                solver,
                QIn[patchIndex], QInEnumerator,
                patchCentre[patchIndex], patchSize[patchIndex], volume, timeStamp[patchIndex], timeStep[patchIndex],
                QOut[patchIndex], QOutEnumerator
              )
            );
          }
        }
      }
    #if Dimensions == 3
    }
    #endif

    if constexpr (EvaluateMaximumEigenvalueAfterTimeStep) {
      maxEigenvalue[patchIndex] = maxEigenvalueAfterTimeStep;
    }
  }

  logTraceOut("timeStepWithRiemann()");
}

template <
  class SolverType,
  int  HaloSize,
  bool EvaluateFlux,
  bool EvaluateNonconservativeProduct,
  bool EvaluateEigenvalues,
  bool EvaluateSource,
  bool EvaluateRiemann,
  bool EvaluateMaximumEigenvalueAfterTimeStep>
void exahype2::fv::riemann::timeStepWithRiemann(CellData<double, double>& patchData, peano4::utils::LoopPlacement loopPlacement) {
  static_assert(HaloSize == 1);

  static tarch::logging::Log _log("exahype2::fv::riemann");
  logTraceIn("timeStepWithRiemann()");

  const Enumerator<SolverType::NumberOfFiniteVolumesPerAxisPerPatch, HaloSize, SolverType::NumberOfUnknowns, SolverType::NumberOfAuxiliaryVariables> QInEnumerator;
  const Enumerator<SolverType::NumberOfFiniteVolumesPerAxisPerPatch, 0, SolverType::NumberOfUnknowns, SolverType::NumberOfAuxiliaryVariables> QOutEnumerator;

  double** const QIn          = patchData.QIn;
  double** const QOut         = patchData.QOut;
  const double* patchCentre   = patchData.cellCentre[0].data();
  const double* patchSize     = patchData.cellSize[0].data();
  const double* timeStamp     = patchData.t;
  const double* timeStep      = patchData.dt;
  double* const maxEigenvalue = patchData.maxEigenvalue;

  parallelForWithSchedulerInstructions(patchIndex, patchData.numberOfCells, loopPlacement) {
    double maxEigenvalueAfterTimeStep = 0.0;

    #if Dimensions == 3
    for (int z = 0; z < SolverType::NumberOfFiniteVolumesPerAxisPerPatch; z++) {
    #endif
      for (int y = 0; y < SolverType::NumberOfFiniteVolumesPerAxisPerPatch; y++) {
        for (int x = 0; x < SolverType::NumberOfFiniteVolumesPerAxisPerPatch; x++) {
          const auto volume = volumeIndex(x, y
            #if Dimensions == 3
            , z
            #endif
          );
          if constexpr (EvaluateRiemann) {
            maxEigenvalueAfterTimeStep = std::fmax(
              maxEigenvalueAfterTimeStep,
              updateSolutionWithRiemann_LoopBody<SolverType, EvaluateMaximumEigenvalueAfterTimeStep>(
                QIn[patchIndex], QInEnumerator,
                patchCentre[patchIndex], patchSize[patchIndex], volume, timeStamp[patchIndex], timeStep[patchIndex],
                QOut[patchIndex], QOutEnumerator
              )
            );
          }
        }
      }
    #if Dimensions == 3
    }
    #endif

    if constexpr (EvaluateMaximumEigenvalueAfterTimeStep) {
      maxEigenvalue[patchIndex] = maxEigenvalueAfterTimeStep;
    }
  } endParallelFor

  logTraceOut("timeStepWithRiemann()");
}
