#include <chrono>
#include <string>
#include <utility>

#include "exahype2/LevelJumps.h"
#include "exahype2/fv/ader/Kernels.h"
#include "tarch/Assertions.h"
#include "tarch/Termination.h"
#include "tarch/accelerator/ParallelReduce.h"
#include "tarch/accelerator/Range.h"
#include "tarch/accelerator/Reducer.h"
#include "tarch/instrumentation/Info.h"
#include "tarch/instrumentation/Warning.h"
#include "tarch/mpi/Rank.h"
#include "tarch/mpi/ReductionRecord.h"

template <typename Derived, typename StoragePrecision, typename ComputePrecision>
INLINE_METHOD exahype2::fv::ader::Solver<Derived, StoragePrecision, ComputePrecision>::Solver(
  const double                              timeStepFactor,
  std::string                               name,
  std::vector<exahype2::plotter::DataField> plottedFields
) :
  Base(timeStepFactor, std::move(name), std::move(plottedFields)) {
  static_assert(
    Derived::PatchSize >= 2 * (Scheme::NodesPerAxis - 1),
    "ADER-WENO needs at least 2 * order volumes per patch axis."
  );
}

/**
 * Reserves the pools of the base and of the predicted face halves, builds their exchanges and
 * reserves the predictor. Every rank calls this at the same time. The exchanges of every solver
 * then take the same tags.
 */
template <typename Derived, typename StoragePrecision, typename ComputePrecision>
INLINE_METHOD void
exahype2::fv::ader::Solver<Derived, StoragePrecision, ComputePrecision>::allocate(const peano4::CellConnectivity& cellConnectivity) {
  Base::allocate(cellConnectivity);
  if constexpr (exahype2::fv::ader::fallsBack<Derived>()) {
    _previousSolution.reserve(cellConnectivity.getNumberOfSlots());
    _statuses.reserve(cellConnectivity.getNumberOfSlots());
    reserveVolumeStatuses(cellConnectivity.getNumberOfSlots());
  }
  reserveFaces(cellConnectivity);
  _predictor.template allocate<Derived>();
}

/**
 * Reserves the statuses of the volumes, every one Accepted, and with a fallback per volume the
 * updates through the faces inside the patches.
 */
template <typename Derived, typename StoragePrecision, typename ComputePrecision>
INLINE_METHOD void
exahype2::fv::ader::Solver<Derived, StoragePrecision, ComputePrecision>::reserveVolumeStatuses(const int numberOfSlots) {
  _volumeStatuses.reserve(numberOfSlots);
  _volumeStatuses.copyFromHost(std::vector<int>(
    static_cast<std::size_t>(_volumeStatuses.getNumberOfSegments()) * _volumeStatuses.getSegmentSize()
      * _volumeStatuses.getPaddedChunkSize(),
    static_cast<int>(exahype2::fv::ader::VolumeStatus::Accepted)
  ));
  if constexpr (exahype2::fv::ader::fallsBackPerVolume<Derived>()) {
    _interiorUpdates.reserve(numberOfSlots);
  }
}

template <typename Derived, typename StoragePrecision, typename ComputePrecision>
INLINE_METHOD void
exahype2::fv::ader::Solver<Derived, StoragePrecision, ComputePrecision>::reserveFaces(
  const peano4::CellConnectivity& cellConnectivity
) {
  _faceStates.reserve(cellConnectivity.getNumberOfFaces());
  _faceFluxes.reserve(cellConnectivity.getNumberOfFaces());
  _stateExchange.rebuild(cellConnectivity);
  _fluxExchange.rebuild(cellConnectivity);
  _restrictedFluxExchange.rebuild(cellConnectivity);
  if constexpr (exahype2::fv::ader::fallsBack<Derived>()) {
    _faceStatuses.reserve(cellConnectivity.getNumberOfFaces());
    _statusExchange.rebuild(cellConnectivity);
  }
}

/**
 * Advances every patch by the time step size the previous step admitted. The local patches predict
 * while the solution halves of the exchanged faces travel, and the local faces solve their Riemann
 * problems while the predicted halves travel. The fluxes restricted onto the coarse faces of a
 * rank boundary travel while the local patches correct. With a fallback, only the final states
 * of the step bound the next time step size, as in the limited ADER-DG solver, since the
 * predictions of a patch that falls back may not be finite.
 */
template <typename Derived, typename StoragePrecision, typename ComputePrecision>
INLINE_METHOD void
exahype2::fv::ader::Solver<Derived, StoragePrecision, ComputePrecision>::performTimeStep(
  const peano4::CellConnectivity&      cellConnectivity,
  exahype2::RefinementRequests& requests
) {
  constexpr auto Local        = peano4::Adjacency::Local;
  constexpr auto Remote       = peano4::Adjacency::Remote;
  const double   timeStepSize = this->_timeStepping.startTimeStep();

  this->_haloExchange.post();
  this->applyBoundaryConditions(cellConnectivity);
  this->interpolateCoarseHalos(cellConnectivity, Local);
  double maxEigenvalue = predictPatches(cellConnectivity, Local, timeStepSize);
  this->_haloExchange.wait();
  this->interpolateCoarseHalos(cellConnectivity, Remote);
  maxEigenvalue = exahype2::MaxEigenvalueReduction::combine(maxEigenvalue, predictPatches(cellConnectivity, Remote, timeStepSize));

  const exahype2::fv::ader::InterpolateFaceHalves<Derived, ComputePrecision> interpolateHalves{
    _faceStates.getView(),
    _faceFluxes.getView()
  };
  const exahype2::fv::ader::RestrictFluxHalves<Derived, ComputePrecision> restrictFluxes{
    cellConnectivity.onDevice(),
    _faceFluxes.getView()
  };
  _stateExchange.post();
  _fluxExchange.post();
  exahype2::interpolateCoarseFaces(cellConnectivity, Local, interpolateHalves);
  maxEigenvalue =
    exahype2::MaxEigenvalueReduction::combine(maxEigenvalue, solveRiemannProblems(cellConnectivity, Local, timeStepSize));
  _stateExchange.wait();
  _fluxExchange.wait();
  exahype2::interpolateCoarseFaces(cellConnectivity, Remote, interpolateHalves);
  maxEigenvalue =
    exahype2::MaxEigenvalueReduction::combine(maxEigenvalue, solveRiemannProblems(cellConnectivity, Remote, timeStepSize));

  exahype2::restrictFineFaces(cellConnectivity, Remote, restrictFluxes);
  _restrictedFluxExchange.post();
  exahype2::restrictFineFaces(cellConnectivity, Local, restrictFluxes);
  double finalMaxEigenvalue = correctPatches(cellConnectivity, Local, timeStepSize);
  _restrictedFluxExchange.wait();
  finalMaxEigenvalue =
    exahype2::MaxEigenvalueReduction::combine(finalMaxEigenvalue, correctPatches(cellConnectivity, Remote, timeStepSize));

  if constexpr (exahype2::fv::ader::fallsBack<Derived>()) {
    _statusExchange.post();
    finalMaxEigenvalue =
      exahype2::MaxEigenvalueReduction::combine(finalMaxEigenvalue, fixUpPatches(cellConnectivity, Local, timeStepSize));
    _statusExchange.wait();
    finalMaxEigenvalue =
      exahype2::MaxEigenvalueReduction::combine(finalMaxEigenvalue, fixUpPatches(cellConnectivity, Remote, timeStepSize));
    maxEigenvalue = finalMaxEigenvalue;
  } else {
    maxEigenvalue = exahype2::MaxEigenvalueReduction::combine(maxEigenvalue, finalMaxEigenvalue);
  }
  this->closeTimeStep(cellConnectivity, timeStepSize, maxEigenvalue, requests);
}

template <typename Derived, typename StoragePrecision, typename ComputePrecision>
INLINE_METHOD void
exahype2::fv::ader::Solver<Derived, StoragePrecision, ComputePrecision>::regrid(
  const peano4::CellConnectivity&      cellConnectivity,
  const peano4::Regrid&         regrid,
  exahype2::RefinementRequests& requests
) {
  Base::regrid(cellConnectivity, regrid, requests);
  if constexpr (exahype2::fv::ader::fallsBack<Derived>()) {
    _previousSolution.reserve(regrid.newNumberOfSlots);
    _statuses.reserve(regrid.newNumberOfSlots);
    reserveVolumeStatuses(regrid.newNumberOfSlots);
  }
  reserveFaces(cellConnectivity);
}

template <typename Derived, typename StoragePrecision, typename ComputePrecision>
INLINE_METHOD void
exahype2::fv::ader::Solver<Derived, StoragePrecision, ComputePrecision>::release() {
  Base::release();
  _faceStates.release();
  _faceFluxes.release();
  _stateExchange.release();
  _fluxExchange.release();
  _restrictedFluxExchange.release();
  _predictor.release();
  _previousSolution.release();
  _statuses.release();
  _faceStatuses.release();
  _statusExchange.release();
  _volumeStatuses.release();
  _interiorUpdates.release();
  _volumeStatusesOnHost.release();
  _unconvergedPredictions  = 0;
  _fallbackCells           = 0;
  _troubledFallbackCells = 0;
  _divergedPredictions     = 0;
}

/**
 * Adds the values of the base solver and the unconverged predictions of this rank since the last
 * reduction to record.
 */
template <typename Derived, typename StoragePrecision, typename ComputePrecision>
INLINE_METHOD void
exahype2::fv::ader::Solver<Derived, StoragePrecision, ComputePrecision>::addLocalValuesToGlobalReduction(
  tarch::mpi::ReductionRecord& record
) {
  Base::addLocalValuesToGlobalReduction(record);
  assertion(_unconvergedPredictions >= 0, _unconvergedPredictions);
  _unconvergedPredictionsSlot = record.addSum(static_cast<std::uint64_t>(_unconvergedPredictions));
  _unconvergedPredictions     = 0;
  if constexpr (exahype2::fv::ader::fallsBack<Derived>()) {
    _fallbackCellsSlot           = record.addSum(static_cast<std::uint64_t>(_fallbackCells));
    _troubledFallbackCellsSlot = record.addSum(static_cast<std::uint64_t>(_troubledFallbackCells));
    _divergedPredictionsSlot     = record.addSum(static_cast<std::uint64_t>(_divergedPredictions));
    _fallbackCells               = 0;
    _troubledFallbackCells     = 0;
    _divergedPredictions         = 0;
  }
}

/**
 * Reads the reduced values of the base solver. The global master warns when the Picard iteration of
 * any volume stopped at its sweep limit since the last reduction.
 */
template <typename Derived, typename StoragePrecision, typename ComputePrecision>
INLINE_METHOD void
exahype2::fv::ader::Solver<Derived, StoragePrecision, ComputePrecision>::readValuesFromGlobalReduction(
  const tarch::mpi::ReductionRecord& record
) {
  Base::readValuesFromGlobalReduction(record);
  const auto globalPredictions = record.getSum(_unconvergedPredictionsSlot);
  if (globalPredictions > 0 and tarch::mpi::Rank::getInstance().isGlobalMaster()) {
    logWarning(
      "The Picard iteration of " << globalPredictions
                                 << " volumes reaches its sweep limit at t = " << this->_timeStepping.getTimeStamp()
                                 << " before it converges. "
                                 << (exahype2::fv::ader::fallsBack<Derived>() ? "Their patches fall back."
                                                                              : "The volumes continue with the last iterate.")
    );
  }
  if constexpr (exahype2::fv::ader::fallsBack<Derived>()) {
    _reportedFallbackCells += record.getSum(_fallbackCellsSlot);
    _reportedTroubledFallbackCells += record.getSum(_troubledFallbackCellsSlot);
    _reportedDivergedPredictions += record.getSum(_divergedPredictionsSlot);
    constexpr double ReportInterval = 10.0;
    const auto       now            = std::chrono::steady_clock::now();
    if (
      _reportedFallbackCells > 0 and tarch::mpi::Rank::getInstance().isGlobalMaster()
      and std::chrono::duration<double>(now - _lastFallbackReport).count() >= ReportInterval
    ) {
      logInfo(
        "Since the last report, " << _reportedFallbackCells
                                  << (exahype2::fv::ader::fallsBackPerVolume<Derived>() ? " volumes" : " patches")
                                  << " repeated their step with the fallback scheme"
                                  << " up to t = " << this->_timeStepping.getTimeStamp() << ", "
                                  << _reportedTroubledFallbackCells << " of them stayed troubled and "
                                  << _reportedDivergedPredictions << " predictions diverged."
      );
      _reportedFallbackCells           = 0;
      _reportedTroubledFallbackCells   = 0;
      _reportedDivergedPredictions     = 0;
      _lastFallbackReport              = now;
    }
  }
}

template <typename Derived, typename StoragePrecision, typename ComputePrecision>
INLINE_METHOD tarch::AllocatedBytes
exahype2::fv::ader::Solver<Derived, StoragePrecision, ComputePrecision>::getAllocatedBytes() const {
  return Base::getAllocatedBytes() + _faceStates.getAllocatedBytes() + _faceFluxes.getAllocatedBytes()
    + _stateExchange.getAllocatedBytes() + _fluxExchange.getAllocatedBytes()
    + _restrictedFluxExchange.getAllocatedBytes() + _predictor.getAllocatedBytes()
    + _previousSolution.getAllocatedBytes() + _statuses.getAllocatedBytes() + _faceStatuses.getAllocatedBytes()
    + _statusExchange.getAllocatedBytes() + _volumeStatuses.getAllocatedBytes() + _interiorUpdates.getAllocatedBytes()
    + _volumeStatusesOnHost.getAllocatedBytes();
}

/**
 * Writes one snapshot of the reconstruction: the limited polynomial of every volume at
 * max(2 NodesPerAxis - 1, 2) equidistant points per axis from face to face, with a fallback the
 * status of every volume after its last step as LimiterStatus.
 */
template <typename Derived, typename StoragePrecision, typename ComputePrecision>
INLINE_METHOD void
exahype2::fv::ader::Solver<Derived, StoragePrecision, ComputePrecision>::plot(
  const peano4::CellConnectivity& cellConnectivity,
  const tarch::plotter::Format    format,
  const std::string&              outputDirectory
) {
  using Basis                      = typename Scheme::Basis;
  constexpr int NodesPerAxis       = Scheme::NodesPerAxis;
  constexpr int PointsPerAxis      = std::max(2 * NodesPerAxis - 1, 2);
  constexpr int NumberOfData       = Scheme::NumberOfData;
  constexpr int PointsPerVolume    = peano4::power(PointsPerAxis, DIMENSIONS);
  std::array<double, PointsPerAxis * NodesPerAxis> matrix1D{};
  for (int point = 0; point < PointsPerAxis; point++) {
    for (int node = 0; node < NodesPerAxis; node++) {
      matrix1D[static_cast<std::size_t>(point * NodesPerAxis + node)] =
        Basis::value(node, static_cast<double>(point) / (PointsPerAxis - 1));
    }
  }
  const auto matrix =
    exahype2::plotter::PatchPlotter::getTensorProductMatrix<PointsPerAxis, NodesPerAxis>(matrix1D.data());
  const auto evaluatePatch = [&](
                               const int                            cell,
                               const StoragePrecision* const        patch,
                               const StoragePrecision* const* const faces,
                               double* const                        values
                             ) {
    std::vector<ComputePrecision> scratch(Scheme::PatchScratchSize);
    Scheme::reconstructPatch(
      patch,
      faces,
      cellConnectivity.getCellCentre(cell),
      cellConnectivity.getCellWidth(cell),
      scratch.data(),
      exahype2::dg::ader::TeamWorkers{}
    );
    for (int volume = 0; volume < Scheme::VolumesPerPatch; volume++) {
      exahype2::plotter::PatchPlotter::evaluateNodes<PointsPerAxis, NodesPerAxis, NumberOfData>(
        matrix,
        scratch.data() + Scheme::NodalStatesOffset + volume * Scheme::NodalStateSize,
        values + volume * PointsPerVolume * NumberOfData
      );
    }
  };
  if constexpr (exahype2::fv::ader::fallsBack<Derived>()) {
    this->template plotReconstruction<PointsPerAxis>(
      cellConnectivity,
      format,
      outputDirectory,
      evaluatePatch,
      &std::as_const(_volumeStatuses).download(_volumeStatusesOnHost),
      exahype2::fv::ader::VolumeStatusFieldName
    );
  } else {
    this->template plotReconstruction<PointsPerAxis>(cellConnectivity, format, outputDirectory, evaluatePatch);
  }
}

/**
 * Predicts the local or the remote cells and returns the largest wave speed of the faces inside
 * their patches. With a fallback, a patch with a diverged or an unconverged volume falls back.
 * Without one, a diverged volume terminates the run and an unconverged volume continues with the
 * last iterate.
 */
template <typename Derived, typename StoragePrecision, typename ComputePrecision>
INLINE_METHOD double
exahype2::fv::ader::Solver<Derived, StoragePrecision, ComputePrecision>::predictPatches(
  const peano4::CellConnectivity& cellConnectivity,
  const peano4::Adjacency  adjacency,
  const double             timeStepSize
) {
  const auto statistics = _predictor.template predict<Derived>(
    cellConnectivity,
    cellConnectivity.onDevice().getCells(adjacency),
    this->_solution.getView(),
    std::as_const(this->_halo).getView(),
    _faceStates.getView(),
    _faceFluxes.getView(),
    this->_timeStepping.getTimeStamp(),
    timeStepSize,
    exahype2::fv::ader::fallsBack<Derived>() ? _previousSolution.getView() : typename Base::Patches::View{},
    exahype2::fv::ader::fallsBack<Derived>() ? _statuses.getView() : decltype(_statuses.getView()){},
    exahype2::fv::ader::fallsBackPerVolume<Derived>() ? _interiorUpdates.getView() : decltype(_interiorUpdates.getView()){}
  );
  if constexpr (exahype2::fv::ader::fallsBack<Derived>()) {
    _divergedPredictions += statistics.counts.divergedCells;
  } else if (statistics.counts.divergedCells > 0) {
    tarch::terminateWithError(
      "The space-time predictor diverges in " + std::to_string(statistics.counts.divergedCells) + " volumes."
    );
  }
  assertion(statistics.counts.unconvergedCells >= 0, statistics.counts.unconvergedCells);
  _unconvergedPredictions += statistics.counts.unconvergedCells;
  return statistics.maxEigenvalue;
}

/**
 * Solves the Riemann problems on the local or the remote faces with a cell on both sides or on the
 * domain boundary and returns the largest wave speed on them.
 */
template <typename Derived, typename StoragePrecision, typename ComputePrecision>
INLINE_METHOD double
exahype2::fv::ader::Solver<Derived, StoragePrecision, ComputePrecision>::solveRiemannProblems(
  const peano4::CellConnectivity& cellConnectivity,
  const peano4::Adjacency  adjacency,
  const double             timeStepSize
) {
  const auto faces = cellConnectivity.onDevice().getFaces(adjacency, peano4::FaceKind::Interior, peano4::FaceKind::Hanging);
  double     maxEigenvalue = 0.0;
  tarch::accelerator::parallelReduce(
    tarch::accelerator::Range(faces.size),
    exahype2::fv::ader::SolveRiemannProblems<Derived, StoragePrecision, ComputePrecision>{
      cellConnectivity.onDevice(),
      faces,
      _faceStates.getView(),
      _faceFluxes.getView(),
      this->_timeStepping.getTimeStamp(),
      timeStepSize
    },
    tarch::accelerator::Custom<exahype2::MaxEigenvalueReduction>{maxEigenvalue}
  );
  return maxEigenvalue;
}

/**
 * Returns the correction of the local or the remote cells, with the fallback of Derived.
 */
template <typename Derived, typename StoragePrecision, typename ComputePrecision>
INLINE_METHOD auto exahype2::fv::ader::Solver<Derived, StoragePrecision, ComputePrecision>::getCorrection(
  const peano4::CellConnectivity& cellConnectivity,
  const peano4::Adjacency  adjacency,
  const double             timeStepSize
) {
  exahype2::fv::ader::CorrectPatches<Derived, StoragePrecision, ComputePrecision, FallbackSolver<>> correction{
    cellConnectivity.onDevice(),
    cellConnectivity.onDevice().getCells(adjacency),
    this->_solution.getView(),
    std::as_const(_faceFluxes).getView(),
    this->_timeStepping.getTimeStamp(),
    timeStepSize
  };
  if constexpr (exahype2::fv::ader::fallsBack<Derived>()) {
    correction.previousSolution = std::as_const(_previousSolution).getView();
    correction.halo             = std::as_const(this->_halo).getView();
    correction.statuses         = _statuses.getView();
    correction.faceStatuses     = _faceStatuses.getView();
    correction.interiorUpdates  = std::as_const(_interiorUpdates).getView();
    correction.volumeStatuses   = _volumeStatuses.getView();
  }
  return correction;
}

/**
 * Adds the numerical fluxes on the faces of the local or the remote patches and returns the largest
 * wave speed of their updated volumes. A patch that repeats its step with the fallback scheme
 * counts into the fallback statistics.
 */
template <typename Derived, typename StoragePrecision, typename ComputePrecision>
INLINE_METHOD double
exahype2::fv::ader::Solver<Derived, StoragePrecision, ComputePrecision>::correctPatches(
  const peano4::CellConnectivity& cellConnectivity,
  const peano4::Adjacency  adjacency,
  const double             timeStepSize
) {
  const auto                               correction = getCorrection(cellConnectivity, adjacency, timeStepSize);
  exahype2::fv::ader::CorrectionStatistics statistics;
  tarch::accelerator::parallelReduce(
    tarch::accelerator::TeamRange(correction.cells.size),
    correction,
    tarch::accelerator::Custom<exahype2::fv::ader::CorrectionStatistics>{statistics}
  );
  _fallbackCells += statistics.fallbackCells;
  _troubledFallbackCells += statistics.troubledFallbackCells;
  return statistics.maxEigenvalue;
}

/**
 * Lets the local or the remote patches beside a patch that repeated its step take its fallback
 * flux and returns the largest wave speed of the patches that change.
 */
template <typename Derived, typename StoragePrecision, typename ComputePrecision>
INLINE_METHOD double
exahype2::fv::ader::Solver<Derived, StoragePrecision, ComputePrecision>::fixUpPatches(
  const peano4::CellConnectivity& cellConnectivity,
  const peano4::Adjacency  adjacency,
  const double             timeStepSize
) {
  double maxEigenvalue = 0.0;
  if constexpr (exahype2::fv::ader::fallsBack<Derived>()) {
    const auto correction = getCorrection(cellConnectivity, adjacency, timeStepSize);
    tarch::accelerator::parallelReduce(
      tarch::accelerator::TeamRange(correction.cells.size),
      exahype2::fv::ader::FixUpPatches<Derived, StoragePrecision, ComputePrecision, FallbackSolver<>>{correction},
      tarch::accelerator::Custom<exahype2::MaxEigenvalueReduction>{maxEigenvalue}
    );
  }
  return maxEigenvalue;
}
