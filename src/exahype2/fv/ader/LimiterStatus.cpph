TARGET_DECLARE
/**
 * Returns whether a patch or a volume of this status repeats its step with the fallback scheme.
 */
INLINE_METHOD GPU_CALLABLE_METHOD constexpr bool exahype2::fv::ader::runsFallbackScheme(const LimiterStatus status) {
  return static_cast<int>(status) >= static_cast<int>(exahype2::fv::ader::LimiterStatus::Limited);
}
TARGET_DECLARE_END
