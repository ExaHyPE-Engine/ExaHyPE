#include "exahype2/TimeStepping.h"
#include "exahype2/dg/Kernels.h"
#include "exahype2/dg/limiting/LimiterStatus.h"
#include "exahype2/fv/Kernels.h"
#include "exahype2/terms/PostprocessUpdatedPatch.h"
#include "tarch/accelerator/ParallelReduce.h"
#include "tarch/accelerator/Range.h"
#include "tarch/accelerator/Reducer.h"
#include "tarch/accelerator/Scratch.h"

TARGET_DECLARE
INLINE_METHOD GPU_CALLABLE_METHOD exahype2::fv::ader::PredictionStatistics
exahype2::fv::ader::PredictionStatistics::identity() {
  return ValueType{exahype2::MaxEigenvalueReduction::identity(), exahype2::dg::ader::PredictionCounts::identity()};
}

INLINE_METHOD GPU_CALLABLE_METHOD exahype2::fv::ader::PredictionStatistics
exahype2::fv::ader::PredictionStatistics::combine(const ValueType left, const ValueType right) {
  return ValueType{
    exahype2::MaxEigenvalueReduction::combine(left.maxEigenvalue, right.maxEigenvalue),
    exahype2::dg::ader::PredictionCounts::combine(left.counts, right.counts)
  };
}

INLINE_METHOD GPU_CALLABLE_METHOD exahype2::fv::ader::CorrectionStatistics
exahype2::fv::ader::CorrectionStatistics::identity() {
  return ValueType{exahype2::MaxEigenvalueReduction::identity(), 0, 0};
}

INLINE_METHOD GPU_CALLABLE_METHOD exahype2::fv::ader::CorrectionStatistics
exahype2::fv::ader::CorrectionStatistics::combine(const ValueType left, const ValueType right) {
  return ValueType{
    exahype2::MaxEigenvalueReduction::combine(left.maxEigenvalue, right.maxEigenvalue),
    left.fallbackCells + right.fallbackCells,
    left.troubledFallbackCells + right.troubledFallbackCells
  };
}

template <typename Derived, typename StoragePrecision, typename ComputePrecision>
INLINE_METHOD GPU_CALLABLE_METHOD void
exahype2::fv::ader::PredictPatches<Derived, StoragePrecision, ComputePrecision>::operator()(
  const int                            entry,
  const tarch::accelerator::TeamHandle team,
  PredictionStatistics&                accumulator
) const {
  assertion(numberOfTeams > 0, numberOfTeams);
  assertion(threadsPerVolume > 0, threadsPerVolume);
  exahype2::dg::ader::TeamWorkers workers = exahype2::dg::ader::getWorkers(team, threadsPerVolume);
  const bool                      inGroup = workers.hasCell;
  const int                       chunk   = tarch::accelerator::getScratchChunk(entry);
  assertion(chunk >= 0 and chunk < scratchChunks, chunk, scratchChunks, entry);
  ComputePrecision* const patchScratch  = scratch + static_cast<std::ptrdiff_t>(chunk) * scratchSizePerTeam;
  ComputePrecision* const volumeScratch = patchScratch + Scheme::PatchScratchSize
                                        + static_cast<std::ptrdiff_t>(inGroup ? workers.group : 0)
                                            * Scheme::VolumeScratchSize;
  assertion(
    Scheme::PatchScratchSize + workers.groups * Scheme::VolumeScratchSize <= scratchSizePerTeam,
    workers.groups,
    scratchSizePerTeam
  );

  PredictionStatistics statistics;
  for (int cell = entry; cell < cells.size; cell += numberOfTeams) {
    const int               slot = cells[cell];
    const StoragePrecision* haloOfCell[peano4::FacesPerCell];
    ComputePrecision*       stateHalves[peano4::FacesPerCell];
    ComputePrecision*       fluxHalves[peano4::FacesPerCell];
    for (int faceNumber = 0; faceNumber < peano4::FacesPerCell; faceNumber++) {
      const int face          = cellConnectivity.getCellFace(slot, faceNumber);
      const int half          = exahype2::dg::getOwnHalf(faceNumber);
      haloOfCell[faceNumber]  = halo.getChunk(face);
      stateHalves[faceNumber] = faceStates.getChunk(face) + half * Scheme::StateValuesPerHalf;
      fluxHalves[faceNumber]  = faceFluxes.getChunk(face) + half * Scheme::FluxValuesPerHalf;
    }
    StoragePrecision* const                     patch      = solution.getChunk(slot);
    const tarch::la::Vector<DIMENSIONS, double> cellCentre = cellConnectivity.getCellCentre(slot);
    const tarch::la::Vector<DIMENSIONS, double> cellSize   = cellConnectivity.getCellWidth(slot);

    if (previousSolution.segments != nullptr) {
      StoragePrecision* const previous = previousSolution.getChunk(slot);
      for (int value = workers.teamThread; value < Scheme::VolumesPerPatch * Scheme::NumberOfData;
           value += workers.teamThreads) {
        previous[value] = patch[value];
      }
    }
    Scheme::reconstructPatch(patch, haloOfCell, cellCentre, cellSize, patchScratch, workers);
    for (int first = 0; first < Scheme::VolumesPerPatch; first += workers.groups) {
      workers.hasCell = inGroup and first + workers.group < Scheme::VolumesPerPatch;
      // A thread without a volume keeps the barriers of the team on the first volume.
      const int volume  = workers.hasCell ? first + workers.group : 0;
      const int outcome = Scheme::predictVolume(
        volume,
        cellCentre,
        cellSize,
        timeStamp,
        timeStepSize,
        tables,
        patchScratch,
        volumeScratch,
        stateHalves,
        fluxHalves,
        workers,
        statuses.segments != nullptr
      );
      // The threads of a volume see the same outcome. The first thread of the volume records it once.
      if (workers.hasCell and workers.thread == 0) {
        if (outcome == exahype2::dg::ader::DivergedPicardIteration) {
          statistics.counts.divergedCells++;
        } else if (outcome == exahype2::dg::ader::UnconvergedPicardIteration) {
          statistics.counts.unconvergedCells++;
        }
        if (statuses.segments != nullptr and outcome < 0) {
          *statuses.getChunk(slot) = static_cast<int>(FallbackStatus::FailedPrediction);
        }
      }
    }

    for (int volume = workers.teamThread; volume < Scheme::VolumesPerPatch; volume += workers.teamThreads) {
      statistics.maxEigenvalue = exahype2::MaxEigenvalueReduction::combine(
        statistics.maxEigenvalue,
        Scheme::updateVolumeInsidePatch(volume, patch, cellCentre, cellSize, timeStamp, timeStepSize, patchScratch)
      );
    }
    // The next cell reuses the scratch chunk once every thread is done with this one.
    exahype2::dg::ader::synchronise(workers);
  }
  COMPILE_IF_ON_HOST(accumulator = PredictionStatistics::combine(accumulator, statistics);)
  COMPILE_IF_ON_DEVICE(
    const tarch::accelerator::Custom<exahype2::fv::ader::PredictionStatistics> reducer{accumulator};
    tarch::accelerator::reduceOverTeam(team, statistics, reducer);
  )
}

template <typename Derived, typename StoragePrecision, typename ComputePrecision>
INLINE_METHOD GPU_CALLABLE_METHOD void
exahype2::fv::ader::SolveRiemannProblems<Derived, StoragePrecision, ComputePrecision>::operator()(
  const int entry,
  double&   accumulator
) const {
  const int face = faces[entry];
  accumulator    = exahype2::MaxEigenvalueReduction::combine(
    accumulator,
    Scheme::template solveRiemannProblemsOnFace<StoragePrecision>(
      faceStates.getChunk(face),
      faceFluxes.getChunk(face),
      cellConnectivity.getFaceCentre(face),
      cellConnectivity.getFaceWidth(face),
      timeStamp,
      timeStepSize,
      cellConnectivity.getFaceNormal(face),
      exahype2::dg::getBoundaryFaceNumber(cellConnectivity, face)
    )
  );
}

/**
 * Corrects the patch of one cell in place and reduces the wave speeds of the updated volumes into
 * the accumulator, after the patch postprocessing of Derived where it defines one. With a fallback,
 * the patch judges its volumes after the postprocessing and repeats its step with the fallback
 * scheme when one of them is troubled.
 */
template <typename Derived, typename StoragePrecision, typename ComputePrecision, typename FallbackDerived>
INLINE_METHOD GPU_CALLABLE_METHOD void
exahype2::fv::ader::CorrectPatches<Derived, StoragePrecision, ComputePrecision, FallbackDerived>::operator()(
  const int                                             entry,
  [[maybe_unused]] const tarch::accelerator::TeamHandle team,
  CorrectionStatistics&                                 accumulator
) const {
  using Fallback          = exahype2::fv::ader::Fallback<Derived, std::conditional_t<FallsBack, FallbackDerived, Derived>, ComputePrecision>;
  const int               slot = cells[entry];
  const ComputePrecision* fluxHalves[peano4::FacesPerCell];
  for (int faceNumber = 0; faceNumber < peano4::FacesPerCell; faceNumber++) {
    const int face         = cellConnectivity.getCellFace(slot, faceNumber);
    fluxHalves[faceNumber] = faceFluxes.getChunk(face)
                           + exahype2::dg::getCorrectionHalf(cellConnectivity, face, faceNumber) * Scheme::FluxValuesPerHalf;
  }
  StoragePrecision* const                     patch         = solution.getChunk(slot);
  const tarch::la::Vector<DIMENSIONS, double> cellCentre    = cellConnectivity.getCellCentre(slot);
  const tarch::la::Vector<DIMENSIONS, double> cellSize      = cellConnectivity.getCellWidth(slot);
  const double                                stepStart     = timeStamp;
  const double                                stepEnd       = timeStamp + timeStepSize;
  const double                                stepSize      = timeStepSize;
  [[maybe_unused]] constexpr bool             PostprocessesPatch =
    exahype2::terms::HasPostprocessUpdatedPatch<Derived, StoragePrecision>;
  [[maybe_unused]] const StoragePrecision*    haloOfCell[peano4::FacesPerCell]{};
  [[maybe_unused]] const StoragePrecision*    previous      = nullptr;
  [[maybe_unused]] int                        sharedFaces   = 0;
  [[maybe_unused]] int                        boundaryFaces = 0;
  [[maybe_unused]] bool                       failedPrediction = false;
  if constexpr (FallsBack) {
    for (int faceNumber = 0; faceNumber < peano4::FacesPerCell; faceNumber++) {
      haloOfCell[faceNumber] = halo.getChunk(cellConnectivity.getCellFace(slot, faceNumber));
    }
    previous      = previousSolution.getChunk(slot);
    sharedFaces   = getSharedFallbackFaces(slot);
    boundaryFaces = exahype2::fv::getBoundaryFaceMask(cellConnectivity, slot);
    failedPrediction = *statuses.getChunk(slot) == static_cast<int>(FallbackStatus::FailedPrediction);
  }
  // Repeats the step of volume with the fallback scheme, with the ADER-WENO flux on the faces
  // where the patch does not share the fallback flux.
  [[maybe_unused]] const auto recomputeVolume = [&](const int volume) {
    if constexpr (FallsBack) {
      Fallback::recomputeVolume(volume, previous, haloOfCell, cellCentre, cellSize, stepStart, stepSize, boundaryFaces, patch);
      for (int faceNumber = 0; faceNumber < peano4::FacesPerCell; faceNumber++) {
        const bool keepsFlux = (sharedFaces & (1 << faceNumber)) == 0 and (boundaryFaces & (1 << faceNumber)) == 0;
        if (keepsFlux and Fallback::isOnPatchFace(volume, faceNumber)) {
          Fallback::swapFaceFlux(
            volume,
            faceNumber,
            false,
            previous,
            haloOfCell,
            fluxHalves[faceNumber],
            cellCentre,
            cellSize,
            stepStart,
            stepSize,
            boundaryFaces,
            patch
          );
        }
      }
    }
  };
  [[maybe_unused]] const auto writeStatus = [&](const bool fallsBack) {
    if constexpr (FallsBack) {
      const int status = static_cast<int>(fallsBack ? FallbackStatus::FallsBack : FallbackStatus::Accepted);
      *statuses.getChunk(slot) = status;
      for (int faceNumber = 0; faceNumber < peano4::FacesPerCell; faceNumber++) {
        faceStatuses.getChunk(cellConnectivity.getCellFace(slot, faceNumber))[exahype2::dg::getOwnHalf(faceNumber)] = status;
      }
    }
  };

  COMPILE_IF_ON_HOST(
    for (int volume = 0; volume < Scheme::VolumesPerPatch; volume++) {
      Scheme::correctVolume(volume, patch, fluxHalves, cellSize, stepSize);
    } Patch::postprocessUpdatedPatch(patch, cellCentre, cellSize, stepStart, stepSize);
    if constexpr (FallsBack) {
      const auto isTroubled = [&] {
        bool troubled = not Fallback::isPhysicallyAdmissible(patch, cellCentre, cellSize);
        for (int volume = 0; volume < Scheme::VolumesPerPatch and not troubled; volume++) {
          troubled = not Fallback::isAdmissible(volume, patch, previous, haloOfCell);
        }
        return troubled;
      };
      const bool fallsBack = failedPrediction or isTroubled();
      if (fallsBack) {
        for (int volume = 0; volume < Scheme::VolumesPerPatch; volume++) {
          recomputeVolume(volume);
        }
        Patch::postprocessUpdatedPatch(patch, cellCentre, cellSize, stepStart, stepSize);
        accumulator.fallbackCells++;
        if (isTroubled()) {
          accumulator.troubledFallbackCells++;
        }
      }
      writeStatus(fallsBack);
    } for (int volume = 0; volume < Scheme::VolumesPerPatch; volume++) {
      accumulator.maxEigenvalue = exahype2::MaxEigenvalueReduction::combine(
        accumulator.maxEigenvalue,
        Patch::getMaxEigenvalueOfVolume(volume, patch, cellCentre, cellSize, stepEnd, stepSize)
      );
    }
  )
  COMPILE_IF_ON_DEVICE(
    const tarch::accelerator::Custom<exahype2::fv::ader::CorrectionStatistics> reducer{accumulator};
    const int            thread  = tarch::accelerator::getThreadOfTeam(team);
    const int            threads = tarch::accelerator::getNumberOfThreadsPerTeam(team);
    CorrectionStatistics partial = CorrectionStatistics::identity();
    for (int volume = thread; volume < Scheme::VolumesPerPatch; volume += threads) {
      Scheme::correctVolume(volume, patch, fluxHalves, cellSize, stepSize);
    }
    const auto postprocess = [&] {
      if constexpr (PostprocessesPatch) {
        tarch::accelerator::teamBarrier(team);
        tarch::accelerator::parallelFor(team, tarch::accelerator::Range(1), [=]([[maybe_unused]] const int single) {
          Patch::postprocessUpdatedPatch(patch, cellCentre, cellSize, stepStart, stepSize);
        });
        tarch::accelerator::teamBarrier(team);
      }
    };
    postprocess();
    if constexpr (FallsBack) {
      // Every thread marks in the team scratch whether one of its volumes is troubled. The first
      // thread also judges the states of the patch together.
      unsigned char* const troubled   = tarch::accelerator::getTeamScratch(team);
      const auto           isTroubled = [&] {
        tarch::accelerator::teamBarrier(team);
        bool fails = thread == 0 and not Fallback::isPhysicallyAdmissible(patch, cellCentre, cellSize);
        for (int volume = thread; volume < Scheme::VolumesPerPatch; volume += threads) {
          fails = fails or not Fallback::isAdmissible(volume, patch, previous, haloOfCell);
        }
        troubled[thread] = fails ? 1 : 0;
        tarch::accelerator::teamBarrier(team);
        bool any = false;
        for (int other = 0; other < threads; other++) {
          any = any or troubled[other] != 0;
        }
        tarch::accelerator::teamBarrier(team);
        return any;
      };
      const bool fallsBack = isTroubled() or failedPrediction;
      if (fallsBack) {
        for (int volume = thread; volume < Scheme::VolumesPerPatch; volume += threads) {
          recomputeVolume(volume);
        }
        postprocess();
        const bool staysTroubled = isTroubled();
        if (thread == 0 and staysTroubled) {
          partial.troubledFallbackCells = 1;
        }
      }
      if (thread == 0) {
        partial.fallbackCells = fallsBack ? 1 : 0;
        writeStatus(fallsBack);
      }
    }
    if constexpr (PostprocessesPatch or FallsBack) {
      tarch::accelerator::teamBarrier(team);
    }
    for (int volume = thread; volume < Scheme::VolumesPerPatch; volume += threads) {
      partial.maxEigenvalue = exahype2::MaxEigenvalueReduction::combine(
        partial.maxEigenvalue,
        Patch::getMaxEigenvalueOfVolume(volume, patch, cellCentre, cellSize, stepEnd, stepSize)
      );
    }
    tarch::accelerator::reduceOverTeam(team, partial, reducer);
  )
}

/**
 * Returns the faces of the cell in slot, one bit per face number, on which the cell shares the
 * fallback flux with the cell on the other side: the faces between two cells of the same level that
 * both run the scheme.
 */
template <typename Derived, typename StoragePrecision, typename ComputePrecision, typename FallbackDerived>
INLINE_METHOD GPU_CALLABLE_METHOD int
exahype2::fv::ader::CorrectPatches<Derived, StoragePrecision, ComputePrecision, FallbackDerived>::getSharedFallbackFaces(
  const int slot
) const {
  int shared = 0;
  for (int faceNumber = 0; faceNumber < peano4::FacesPerCell; faceNumber++) {
    const int face    = cellConnectivity.getCellFace(slot, faceNumber);
    bool      sharing = cellConnectivity.getFaceKind(face) == peano4::FaceKind::Interior;
    if (sharing and limiterFaceStatuses.segments != nullptr) {
      const int* const halves = limiterFaceStatuses.getChunk(face);
      sharing = exahype2::dg::limiting::runsSubcellScheme(static_cast<exahype2::dg::limiting::LimiterStatus>(halves[0]))
            and exahype2::dg::limiting::runsSubcellScheme(static_cast<exahype2::dg::limiting::LimiterStatus>(halves[1]));
    }
    if (sharing) {
      shared |= 1 << faceNumber;
    }
  }
  return shared;
}

/**
 * Fixes the patch of one cell that keeps its corrected step: Every volume on a shared face whose
 * other side repeats its step takes the fallback flux on that face instead of the ADER-WENO flux.
 */
template <typename Derived, typename StoragePrecision, typename ComputePrecision, typename FallbackDerived>
INLINE_METHOD GPU_CALLABLE_METHOD void
exahype2::fv::ader::FixUpPatches<Derived, StoragePrecision, ComputePrecision, FallbackDerived>::operator()(
  const int                                             entry,
  [[maybe_unused]] const tarch::accelerator::TeamHandle team,
  double&                                               accumulator
) const {
  using Fallback = exahype2::fv::ader::Fallback<Derived, FallbackDerived, ComputePrecision>;
  using Scheme   = typename Correct::Scheme;
  const auto& cellConnectivity = correct.cellConnectivity;
  const int   slot      = correct.cells[entry];
  if (*correct.statuses.getChunk(slot) != static_cast<int>(FallbackStatus::Accepted)) {
    return;
  }
  const int sharedFaces = correct.getSharedFallbackFaces(slot);
  int       fixedFaces  = 0;
  for (int faceNumber = 0; faceNumber < peano4::FacesPerCell; faceNumber++) {
    const int face = cellConnectivity.getCellFace(slot, faceNumber);
    const int otherStatus =
      correct.faceStatuses.getChunk(face)[1 - exahype2::dg::getOwnHalf(faceNumber)];
    if ((sharedFaces & (1 << faceNumber)) != 0 and otherStatus == static_cast<int>(FallbackStatus::FallsBack)) {
      fixedFaces |= 1 << faceNumber;
    }
  }
  if (fixedFaces == 0) {
    return;
  }

  const ComputePrecision*       fluxHalves[peano4::FacesPerCell];
  const StoragePrecision*       haloOfCell[peano4::FacesPerCell];
  for (int faceNumber = 0; faceNumber < peano4::FacesPerCell; faceNumber++) {
    const int face         = cellConnectivity.getCellFace(slot, faceNumber);
    fluxHalves[faceNumber] = correct.faceFluxes.getChunk(face)
                           + exahype2::dg::getCorrectionHalf(cellConnectivity, face, faceNumber) * Scheme::FluxValuesPerHalf;
    haloOfCell[faceNumber] = correct.halo.getChunk(face);
  }
  StoragePrecision* const                     patch         = correct.solution.getChunk(slot);
  const StoragePrecision* const               previous      = correct.previousSolution.getChunk(slot);
  const tarch::la::Vector<DIMENSIONS, double> cellCentre    = cellConnectivity.getCellCentre(slot);
  const tarch::la::Vector<DIMENSIONS, double> cellSize      = cellConnectivity.getCellWidth(slot);
  const int                                   boundaryFaces = exahype2::fv::getBoundaryFaceMask(cellConnectivity, slot);
  const double                                stepStart     = correct.timeStamp;
  const double                                stepSize      = correct.timeStepSize;
  const double                                stepEnd       = stepStart + stepSize;
  const auto                                  fixVolume     = [&](const int volume) {
    for (int faceNumber = 0; faceNumber < peano4::FacesPerCell; faceNumber++) {
      if ((fixedFaces & (1 << faceNumber)) != 0 and Fallback::isOnPatchFace(volume, faceNumber)) {
        Fallback::swapFaceFlux(
          volume,
          faceNumber,
          true,
          previous,
          haloOfCell,
          fluxHalves[faceNumber],
          cellCentre,
          cellSize,
          stepStart,
          stepSize,
          boundaryFaces,
          patch
        );
      }
    }
  };

  COMPILE_IF_ON_HOST(
    for (int volume = 0; volume < Scheme::VolumesPerPatch; volume++) {
      fixVolume(volume);
    } Patch::postprocessUpdatedPatch(patch, cellCentre, cellSize, stepStart, stepSize);
    for (int volume = 0; volume < Scheme::VolumesPerPatch; volume++) {
      accumulator = exahype2::MaxEigenvalueReduction::combine(
        accumulator,
        Patch::getMaxEigenvalueOfVolume(volume, patch, cellCentre, cellSize, stepEnd, stepSize)
      );
    }
  )
  COMPILE_IF_ON_DEVICE(
    const tarch::accelerator::Custom<exahype2::MaxEigenvalueReduction> reducer{accumulator};
    const int thread  = tarch::accelerator::getThreadOfTeam(team);
    const int threads = tarch::accelerator::getNumberOfThreadsPerTeam(team);
    for (int volume = thread; volume < Scheme::VolumesPerPatch; volume += threads) {
      fixVolume(volume);
    }
    if constexpr (exahype2::terms::HasPostprocessUpdatedPatch<Derived, StoragePrecision>) {
      tarch::accelerator::teamBarrier(team);
      tarch::accelerator::parallelFor(team, tarch::accelerator::Range(1), [=]([[maybe_unused]] const int single) {
        Patch::postprocessUpdatedPatch(patch, cellCentre, cellSize, stepStart, stepSize);
      });
    }
    tarch::accelerator::teamBarrier(team);
    double partial = 0.0;
    for (int volume = thread; volume < Scheme::VolumesPerPatch; volume += threads) {
      partial = exahype2::MaxEigenvalueReduction::combine(
        partial,
        Patch::getMaxEigenvalueOfVolume(volume, patch, cellCentre, cellSize, stepEnd, stepSize)
      );
    }
    tarch::accelerator::reduceOverTeam(team, partial, reducer);
  )
}

template <typename Derived, typename ComputePrecision>
INLINE_METHOD GPU_CALLABLE_METHOD void
exahype2::fv::ader::InterpolateFaceHalves<Derived, ComputePrecision>::operator()(
  const peano4::LevelJump& levelJump
) const {
  const ComputePrecision* const coarseState =
    faceStates.getChunk(levelJump.coarseFace) + levelJump.coarseSide * Scheme::StateValuesPerHalf;
  const ComputePrecision* const coarseFlux =
    faceFluxes.getChunk(levelJump.coarseFace) + levelJump.coarseSide * Scheme::FluxValuesPerHalf;
  for (int subface = 0; subface < peano4::SubfacesPerFace; subface++) {
    const int fineFace = levelJump.fineFaces[subface];
    Scheme::template interpolateFaceHalf<Scheme::NumberOfData>(
      coarseState,
      faceStates.getChunk(fineFace) + levelJump.coarseSide * Scheme::StateValuesPerHalf,
      subface
    );
    Scheme::template interpolateFaceHalf<Scheme::NumberOfUnknowns>(
      coarseFlux,
      faceFluxes.getChunk(fineFace) + levelJump.coarseSide * Scheme::FluxValuesPerHalf,
      subface
    );
  }
}

template <typename Derived, typename ComputePrecision>
INLINE_METHOD GPU_CALLABLE_METHOD void
exahype2::fv::ader::RestrictFluxHalves<Derived, ComputePrecision>::operator()(const peano4::LevelJump& levelJump) const {
  const int               fineSide = 1 - levelJump.coarseSide;
  const ComputePrecision* fine[peano4::SubfacesPerFace];
  for (int subface = 0; subface < peano4::SubfacesPerFace; subface++) {
    const int fineFace = levelJump.fineFaces[subface];
    const int half     = cellConnectivity.getFaceKind(fineFace) == peano4::FaceKind::Hanging ? levelJump.coarseSide : fineSide;
    fine[subface]      = faceFluxes.getChunk(fineFace) + half * Scheme::FluxValuesPerHalf;
  }
  Scheme::template restrictFaceHalf<Scheme::NumberOfUnknowns>(
    fine,
    faceFluxes.getChunk(levelJump.coarseFace) + fineSide * Scheme::FluxValuesPerHalf
  );
}
TARGET_DECLARE_END
