#include <cmath>
#include <limits>

TARGET_DECLARE
/**
 * Points every face of fallbackHalo at the layers of the face of halo that the fallback reads. A
 * face holds its layers in the order along the normal, so these are the innermost ones.
 */
template <typename Derived, typename FallbackDerived, typename ComputePrecision>
template <typename StoragePrecision>
INLINE_METHOD GPU_CALLABLE_METHOD void
exahype2::fv::ader::Fallback<Derived, FallbackDerived, ComputePrecision>::getFallbackHalo(
  const StoragePrecision* const halo[peano4::FacesPerCell],
  const StoragePrecision*       fallbackHalo[peano4::FacesPerCell]
) {
  for (int face = 0; face < peano4::FacesPerCell; face++) {
    fallbackHalo[face] = halo[face] + HaloOffset;
  }
}

/**
 * Returns whether the candidate states of the patch together pass the physical admissibility term
 * of Derived.
 */
template <typename Derived, typename FallbackDerived, typename ComputePrecision>
template <typename StoragePrecision>
INLINE_METHOD GPU_CALLABLE_METHOD bool
exahype2::fv::ader::Fallback<Derived, FallbackDerived, ComputePrecision>::isPhysicallyAdmissible(
  const StoragePrecision* NOALIAS const        candidate,
  const tarch::la::Vector<DIMENSIONS, double>& cellCentre,
  const tarch::la::Vector<DIMENSIONS, double>& cellSize
) {
  if constexpr (exahype2::terms::HasPhysicalAdmissibility<Derived, StoragePrecision>) {
    return Derived::isPhysicallyAdmissible(candidate, VolumesPerPatch, cellCentre, cellSize);
  } else {
    return true;
  }
}

/**
 * Returns whether the candidate state of volume passes the physical admissibility term of Derived
 * on its own.
 */
template <typename Derived, typename FallbackDerived, typename ComputePrecision>
template <typename StoragePrecision>
INLINE_METHOD GPU_CALLABLE_METHOD bool
exahype2::fv::ader::Fallback<Derived, FallbackDerived, ComputePrecision>::isPhysicallyAdmissibleVolume(
  const int                                    volume,
  const StoragePrecision* NOALIAS const        candidate,
  const tarch::la::Vector<DIMENSIONS, double>& cellCentre,
  const tarch::la::Vector<DIMENSIONS, double>& cellSize
) {
  if constexpr (exahype2::terms::HasPhysicalAdmissibility<Derived, StoragePrecision>) {
    return Derived::isPhysicallyAdmissible(
      candidate + static_cast<std::ptrdiff_t>(volume) * NumberOfData,
      1,
      exahype2::fv::getVolumeCentre(cellCentre, cellSize, PatchSize, peano4::dDelinearised(volume, PatchSize)),
      exahype2::fv::getVolumeSize(cellSize, PatchSize)
    );
  } else {
    return true;
  }
}

/**
 * Returns whether the candidate state of volume is finite and inside the relaxed extrema of the
 * previous states around it.
 */
template <typename Derived, typename FallbackDerived, typename ComputePrecision>
template <typename StoragePrecision>
INLINE_METHOD GPU_CALLABLE_METHOD bool
exahype2::fv::ader::Fallback<Derived, FallbackDerived, ComputePrecision>::isAdmissible(
  const int                                    volume,
  const StoragePrecision* NOALIAS const        candidate,
  const StoragePrecision* NOALIAS const        previous,
  const StoragePrecision* const                halo[peano4::FacesPerCell]
) {
  const StoragePrecision* const state = candidate + static_cast<std::ptrdiff_t>(volume) * NumberOfData;
  for (int unknown = 0; unknown < NumberOfUnknowns; unknown++) {
    if (not std::isfinite(state[unknown])) {
      return false;
    }
  }
  if constexpr (NumberOfObservables > 0) {
    return satisfiesMaximumPrinciple(volume, candidate, previous, halo);
  } else {
    return true;
  }
}

/**
 * Writes the update of volume with the fallback scheme from the previous states into patch.
 */
template <typename Derived, typename FallbackDerived, typename ComputePrecision>
template <typename StoragePrecision>
INLINE_METHOD GPU_CALLABLE_METHOD void
exahype2::fv::ader::Fallback<Derived, FallbackDerived, ComputePrecision>::recomputeVolume(
  const int                                    volume,
  const StoragePrecision* NOALIAS const        previous,
  const StoragePrecision* const                halo[peano4::FacesPerCell],
  const tarch::la::Vector<DIMENSIONS, double>& cellCentre,
  const tarch::la::Vector<DIMENSIONS, double>& cellSize,
  const double                                 timeStamp,
  const double                                 timeStepSize,
  const int                                    boundaryFaces,
  StoragePrecision* NOALIAS const              patch
) {
  const StoragePrecision* fallbackHalo[peano4::FacesPerCell];
  getFallbackHalo(halo, fallbackHalo);
  static_cast<void>(FallbackPatch::computeVolumeUpdate(
    volume,
    previous,
    fallbackHalo,
    cellCentre,
    cellSize,
    timeStamp,
    timeStepSize,
    boundaryFaces,
    patch + static_cast<std::ptrdiff_t>(volume) * NumberOfData
  ));
}

/**
 * Replaces in the state of volume, which lies on the patch face face, the ADER-WENO flux of that
 * face from fluxHalf by the flux of the fallback scheme from the previous states, or the other way
 * round when toFallback is false.
 */
template <typename Derived, typename FallbackDerived, typename ComputePrecision>
template <typename StoragePrecision>
INLINE_METHOD GPU_CALLABLE_METHOD void
exahype2::fv::ader::Fallback<Derived, FallbackDerived, ComputePrecision>::swapFaceFlux(
  const int                                    volume,
  const int                                    face,
  const bool                                   toFallback,
  const StoragePrecision* NOALIAS const        previous,
  const StoragePrecision* const                halo[peano4::FacesPerCell],
  const ComputePrecision* NOALIAS const        fluxHalf,
  const tarch::la::Vector<DIMENSIONS, double>& cellCentre,
  const tarch::la::Vector<DIMENSIONS, double>& cellSize,
  const double                                 timeStamp,
  const double                                 timeStepSize,
  const int                                    boundaryFaces,
  StoragePrecision* NOALIAS const              patch
) {
  assertion(isOnPatchFace(volume, face), volume, face);
  const StoragePrecision* fallbackHalo[peano4::FacesPerCell];
  getFallbackHalo(halo, fallbackHalo);
  ComputePrecision fallbackFlux[NumberOfUnknowns];
  FallbackPatch::computePatchFaceFlux(
    volume,
    previous,
    fallbackHalo,
    cellCentre,
    cellSize,
    timeStamp,
    timeStepSize,
    boundaryFaces,
    face,
    fallbackFlux
  );
  double appliedFlux[NumberOfUnknowns];
  Scheme::getAppliedFaceFlux(volume, fluxHalf, face, appliedFlux);

  const int    normal = face % DIMENSIONS;
  const double scale  = (face < DIMENSIONS ? 1.0 : -1.0) * timeStepSize
                     / exahype2::fv::getVolumeSize(cellSize, PatchSize)(normal);
  StoragePrecision* const state = patch + static_cast<std::ptrdiff_t>(volume) * NumberOfData;
  for (int unknown = 0; unknown < NumberOfUnknowns; unknown++) {
    const double difference = static_cast<double>(fallbackFlux[unknown]) - appliedFlux[unknown];
    state[unknown]          = static_cast<StoragePrecision>(
      static_cast<double>(state[unknown]) + scale * (toFallback ? difference : -difference)
    );
  }
}

/**
 * Replaces in the state of volume the ADER-WENO update through its face face inside the patch,
 * stored in interiorUpdates, by the update with the flux of the fallback scheme from the previous
 * states of the volume and of its neighbour behind that face.
 */
template <typename Derived, typename FallbackDerived, typename ComputePrecision>
template <typename StoragePrecision>
INLINE_METHOD GPU_CALLABLE_METHOD void
exahype2::fv::ader::Fallback<Derived, FallbackDerived, ComputePrecision>::swapInteriorFlux(
  const int                                    volume,
  const int                                    face,
  const StoragePrecision* NOALIAS const        previous,
  const ComputePrecision* NOALIAS const        interiorUpdates,
  const tarch::la::Vector<DIMENSIONS, double>& cellCentre,
  const tarch::la::Vector<DIMENSIONS, double>& cellSize,
  const double                                 timeStamp,
  const double                                 timeStepSize,
  const int                                    boundaryFaces,
  StoragePrecision* NOALIAS const              patch
) {
  using Reconstruction = typename FallbackDerived::Reconstruction;
  static_assert(std::is_same_v<Reconstruction, exahype2::fv::reconstruction::Constant>, "The fallback is Godunov.");
  assertion(not isOnPatchFace(volume, face), volume, face);
  ComputePrecision              centre[NumberOfData];
  ComputePrecision              outside[NumberOfData];
  const StoragePrecision* const centreState  = previous + static_cast<std::ptrdiff_t>(volume) * NumberOfData;
  const StoragePrecision* const outsideState = previous + static_cast<std::ptrdiff_t>(getNeighbour(volume, face)) * NumberOfData;
  for (int value = 0; value < NumberOfData; value++) {
    centre[value]  = static_cast<ComputePrecision>(centreState[value]);
    outside[value] = static_cast<ComputePrecision>(outsideState[value]);
  }
  ComputePrecision fallbackFlux[NumberOfUnknowns];
  Reconstruction::template volumeFaceFlux<
    FallbackDerived,
    PatchSize,
    NumberOfUnknowns,
    Patch::NumberOfAuxiliaryVariables,
    exahype2::terms::HasFlux<FallbackDerived, ComputePrecision>,
    exahype2::terms::HasNonconservativeProduct<FallbackDerived, ComputePrecision>,
    exahype2::terms::HasRiemannSolver<FallbackDerived, ComputePrecision>,
    ComputePrecision
  >(centre,
    outside,
    peano4::dDelinearised(volume, PatchSize),
    face,
    cellCentre,
    cellSize,
    timeStamp,
    timeStepSize,
    boundaryFaces,
    fallbackFlux);

  const int                     normal = face % DIMENSIONS;
  const double                  scale  = (face < DIMENSIONS ? 1.0 : -1.0) * timeStepSize
                                      / exahype2::fv::getVolumeSize(cellSize, PatchSize)(normal);
  const ComputePrecision* const ader   = interiorUpdates + (volume * peano4::FacesPerCell + face) * NumberOfUnknowns;
  StoragePrecision* const       state  = patch + static_cast<std::ptrdiff_t>(volume) * NumberOfData;
  for (int unknown = 0; unknown < NumberOfUnknowns; unknown++) {
    state[unknown] = static_cast<StoragePrecision>(
      static_cast<double>(state[unknown]) + scale * static_cast<double>(fallbackFlux[unknown])
      - static_cast<double>(ader[unknown])
    );
  }
}

template <typename Derived, typename FallbackDerived, typename ComputePrecision>
INLINE_METHOD GPU_CALLABLE_METHOD int
exahype2::fv::ader::Fallback<Derived, FallbackDerived, ComputePrecision>::getNeighbour(const int volume, const int face) {
  auto index = peano4::dDelinearised(volume, PatchSize);
  index(face % DIMENSIONS) += face < DIMENSIONS ? -1 : 1;
  return peano4::dLinearised(index, PatchSize);
}

/**
 * Returns the position of the status of volume, which lies on the patch face face, in a half of
 * that face. Both cells beside the face number its volumes alike.
 */
template <typename Derived, typename FallbackDerived, typename ComputePrecision>
INLINE_METHOD GPU_CALLABLE_METHOD int
exahype2::fv::ader::Fallback<Derived, FallbackDerived, ComputePrecision>::getStatusOnFace(const int volume, const int face) {
  if constexpr (not PerVolume) {
    return 0;
  } else {
    const auto index  = peano4::dDelinearised(volume, PatchSize);
    int        result = 0;
    int        stride = 1;
    for (int axis = 0; axis < DIMENSIONS; axis++) {
      if (axis != face % DIMENSIONS) {
        result += index(axis) * stride;
        stride *= PatchSize;
      }
    }
    return result;
  }
}

template <typename Derived, typename FallbackDerived, typename ComputePrecision>
INLINE_METHOD GPU_CALLABLE_METHOD bool
exahype2::fv::ader::Fallback<Derived, FallbackDerived, ComputePrecision>::isOnPatchFace(
  const int volume,
  const int face
) {
  const auto index = peano4::dDelinearised(volume, PatchSize);
  return index(face % DIMENSIONS) == (face < DIMENSIONS ? 0 : PatchSize - 1);
}

/**
 * Returns the previous state of the volume at index, which lies in the patch or behind one of its
 * faces, or nullptr for a volume behind an edge or a corner of the patch.
 */
template <typename Derived, typename FallbackDerived, typename ComputePrecision>
template <typename StoragePrecision>
INLINE_METHOD GPU_CALLABLE_METHOD const StoragePrecision*
exahype2::fv::ader::Fallback<Derived, FallbackDerived, ComputePrecision>::getPreviousState(
  const tarch::la::Vector<DIMENSIONS, int>& index,
  const StoragePrecision* NOALIAS const     previous,
  const StoragePrecision* const             halo[peano4::FacesPerCell]
) {
  int outsideAxes = 0;
  int face        = 0;
  for (int axis = 0; axis < DIMENSIONS; axis++) {
    if (index(axis) < 0) {
      outsideAxes++;
      face = axis;
    } else if (index(axis) >= PatchSize) {
      outsideAxes++;
      face = axis + DIMENSIONS;
    }
  }
  if (outsideAxes == 0) {
    return previous + static_cast<std::ptrdiff_t>(peano4::dLinearised(index, PatchSize)) * NumberOfData;
  }
  if (outsideAxes > 1) {
    return nullptr;
  }
  const int normal     = face % DIMENSIONS;
  auto      faceVolume = index;
  faceVolume(normal)   = face < DIMENSIONS ? HaloSize - 1 : HaloSize;
  return halo[face]
       + static_cast<std::ptrdiff_t>(exahype2::fv::getFaceVolumeIndex(faceVolume, PatchSize, HaloSize, normal))
           * NumberOfData;
}

/**
 * Returns whether every observable of the candidate state of volume lies inside the extrema of
 * the previous states of the volume and of the volumes around it that share a face, an edge or a
 * corner with it inside the patch, or a face with it across a face of the patch.
 */
template <typename Derived, typename FallbackDerived, typename ComputePrecision>
template <typename StoragePrecision>
INLINE_METHOD GPU_CALLABLE_METHOD bool
exahype2::fv::ader::Fallback<Derived, FallbackDerived, ComputePrecision>::satisfiesMaximumPrinciple(
  const int                             volume,
  const StoragePrecision* NOALIAS const candidate,
  const StoragePrecision* NOALIAS const previous,
  const StoragePrecision* const         halo[peano4::FacesPerCell]
) {
  static_assert(exahype2::terms::HasDmpObservables<Derived, StoragePrecision>);
  StoragePrecision minimum[NumberOfObservables];
  StoragePrecision maximum[NumberOfObservables];
  StoragePrecision observables[NumberOfObservables];
  for (int observable = 0; observable < NumberOfObservables; observable++) {
    minimum[observable] = std::numeric_limits<StoragePrecision>::infinity();
    maximum[observable] = -std::numeric_limits<StoragePrecision>::infinity();
  }
  const auto index = peano4::dDelinearised(volume, PatchSize);
  for (int neighbour = 0; neighbour < peano4::power(3, DIMENSIONS); neighbour++) {
    auto neighbourIndex = index + peano4::dDelinearised(neighbour, 3);
    for (int axis = 0; axis < DIMENSIONS; axis++) {
      neighbourIndex(axis) -= 1;
    }
    const StoragePrecision* const state = getPreviousState(neighbourIndex, previous, halo);
    if (state == nullptr) {
      continue;
    }
    Derived::mapDmpObservables(observables, state);
    for (int observable = 0; observable < NumberOfObservables; observable++) {
      minimum[observable] = std::fmin(minimum[observable], observables[observable]);
      maximum[observable] = std::fmax(maximum[observable], observables[observable]);
    }
  }
  Derived::mapDmpObservables(observables, candidate + static_cast<std::ptrdiff_t>(volume) * NumberOfData);
  for (int observable = 0; observable < NumberOfObservables; observable++) {
    StoragePrecision relaxation = static_cast<StoragePrecision>(Derived::DmpRelaxationParameter);
    if constexpr (exahype2::terms::HasDmpRelaxationParameter<Derived, StoragePrecision>) {
      relaxation = Derived::dmpRelaxationParameter(observable, relaxation);
    }
    const StoragePrecision widening = std::fmax(
      relaxation,
      static_cast<StoragePrecision>(Derived::DmpDifferencesScaling) * (maximum[observable] - minimum[observable])
    );
    if (not(observables[observable] >= minimum[observable] - widening
            and observables[observable] <= maximum[observable] + widening)) {
      return false;
    }
  }
  return true;
}
TARGET_DECLARE_END
