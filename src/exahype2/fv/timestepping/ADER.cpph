#include <limits>

TARGET_DECLARE
/**
 * Advances every volume from @p inputPatch into @p outputPatch, projects updated boundary values
 * to @p faceOutputPatches, and returns the maximum eigenvalue encountered over the patch, or NaN
 * if the predictor of a volume diverged.
 */
template <
  typename Reconstruction,
  typename SolverType,
  int  NumberOfVolumesPerAxis,
  int  NumberOfUnknowns,
  int  NumberOfAuxiliaryVariables,
  bool EvaluateFlux,
  bool EvaluateNonconservativeProduct,
  bool EvaluateSource,
  bool EvaluateDiffusiveSource,
  bool EvaluateCustomRiemann,
  bool EvaluateMaxEigenvalue,
  bool EvaluateMaxEigenvalueOfFinalState,
  typename StoragePrecision,
  typename ComputePrecision>
INLINE_METHOD GPU_CALLABLE_METHOD double exahype2::fv::timestepping::ADER::apply(
  const StoragePrecision* NOALIAS const        inputPatch,
  StoragePrecision* NOALIAS const              outputPatch,
  const StoragePrecision* NOALIAS const        faceInputPatches[peano4::FacesPerCell],
  StoragePrecision* NOALIAS const              faceOutputPatches[peano4::FacesPerCell],
  const tarch::la::Vector<DIMENSIONS, double>& patchCentre,
  const tarch::la::Vector<DIMENSIONS, double>& patchSize,
  const double                                 timeStamp,
  const double                                 timeStepSize,
  ComputePrecision* NOALIAS const              scratch
) {
  static_assert(not EvaluateDiffusiveSource, "The ADER time stepping does not support a diffusive source term.");

  using GeometryPrecision    = decltype(ComputePrecision{} * double{});
  using StateUpdatePrecision = decltype(StoragePrecision{} + ComputePrecision{});

  using Layout = ScratchLayout<
    Reconstruction,
    NumberOfVolumesPerAxis,
    NumberOfUnknowns,
    NumberOfAuxiliaryVariables,
    EvaluateFlux,
    EvaluateNonconservativeProduct,
    EvaluateSource>;
  using Basis = typename Reconstruction::Basis;

  constexpr int HaloSize               = Reconstruction::HaloSize;
  constexpr int NumberOfNodes          = Basis::NumberOfNodes;
  constexpr int NumberOfData           = Layout::NumberOfData;
  constexpr int NumberOfVolumesInPatch = peano4::power(NumberOfVolumesPerAxis, DIMENSIONS);
  constexpr int NodesPerFace           = Layout::CellLayout::NodesPerFace;
  constexpr int NodesPerCell           = Layout::CellLayout::NodesPerCell;
  constexpr int StateEntriesPerSide    = Layout::StateEntriesPerSide;
  constexpr int FluxEntriesPerSide     = Layout::FluxEntriesPerSide;
  constexpr int EntriesPerInterface    = Layout::EntriesPerInterface;
  constexpr int InterfacesPerAxis      = Layout::InterfacesPerAxis;
  constexpr int NumberOfPredictedAxes  = NumberOfVolumesPerAxis + 2;

  // Local constexpr objects rather than static tables, which device code cannot read.
  constexpr ADERPredictorTables<Basis, ComputePrecision> PredictorTables{};
  constexpr auto                                         Nodes         = Basis::nodes();
  constexpr auto                                         Weights       = Basis::weights();
  const exahype2::dg::ader::BasisTables<ComputePrecision> predictorView = PredictorTables.view();

  assertion(scratch != nullptr);
  ComputePrecision* NOALIAS const interfaceData         = scratch + Layout::InterfaceDataOffset;
  ComputePrecision* NOALIAS const timeAveragedScratch   = scratch + Layout::TimeAveragedOffset;
  ComputePrecision* NOALIAS const picardScratch         = scratch + Layout::PicardOffset;
  ComputePrecision* NOALIAS const nodalState            = scratch + Layout::NodalStateOffset;
  ComputePrecision* NOALIAS const reconstructionScratch = scratch + Layout::ReconstructionOffset;

  const auto patchOffset = [](const tarch::la::Vector<DIMENSIONS, int>& volumeIndex) {
    int offset = 0;
    int stride = NumberOfData;
    for (int axis = 0; axis < DIMENSIONS; axis++) {
      offset += volumeIndex(axis) * stride;
      stride *= NumberOfVolumesPerAxis;
    }
    return offset;
  };

  const auto interfaceOffset = [](const int axis, const tarch::la::Vector<DIMENSIONS, int>& upperVolumeIndex) {
    int linear = upperVolumeIndex(axis);
    int stride = NumberOfVolumesPerAxis + 1;
    for (int tangential = 0; tangential < DIMENSIONS; tangential++) {
      if (tangential != axis) {
        linear += upperVolumeIndex(tangential) * stride;
        stride *= NumberOfVolumesPerAxis;
      }
    }
    return (axis * InterfacesPerAxis + linear) * EntriesPerInterface;
  };

  for (int predicted = 0; predicted < peano4::power(NumberOfPredictedAxes, DIMENSIONS); predicted++) {
    tarch::la::Vector<DIMENSIONS, int> volumeIndex;
    int                                remainder          = predicted;
    int                                axesOutsideOfPatch = 0;
    for (int axis = 0; axis < DIMENSIONS; axis++) {
      volumeIndex(axis) = remainder % NumberOfPredictedAxes - 1;
      remainder /= NumberOfPredictedAxes;
      if (volumeIndex(axis) < 0 or volumeIndex(axis) >= NumberOfVolumesPerAxis) {
        axesOutsideOfPatch++;
      }
    }
    if (axesOutsideOfPatch > 1) {
      continue;
    }

    const bool isInsidePatch = axesOutsideOfPatch == 0;
    const auto [volumeSize, volumeCentre] =
      exahype2::fv::getVolumeSizeAndCentre<DIMENSIONS, NumberOfVolumesPerAxis>(patchCentre, patchSize, volumeIndex);

    // The polynomial of every available volume feeds the volume update and the interfaces inside
    // the patch, the one restricted to a face of the patch only the flux through that face.
    for (int sharedFace = -1; sharedFace < peano4::FacesPerCell; sharedFace++) {
      ComputePrecision* faceStates[peano4::FacesPerCell];
      ComputePrecision* faceFluxes[peano4::FacesPerCell];
      bool              isNeeded = sharedFace < 0 and isInsidePatch;
      for (int face = 0; face < peano4::FacesPerCell; face++) {
        const int  axis             = face % DIMENSIONS;
        const bool isUpperFace      = face >= DIMENSIONS;
        auto       upperVolumeIndex = volumeIndex;
        upperVolumeIndex(axis) += isUpperFace ? 1 : 0;
        bool isInterfaceOfPatch = upperVolumeIndex(axis) >= 0 and upperVolumeIndex(axis) <= NumberOfVolumesPerAxis;
        for (int tangential = 0; tangential < DIMENSIONS; tangential++) {
          if (tangential != axis) {
            isInterfaceOfPatch = isInterfaceOfPatch and volumeIndex(tangential) >= 0
                             and volumeIndex(tangential) < NumberOfVolumesPerAxis;
          }
        }
        const bool isFaceOfPatch = upperVolumeIndex(axis) == 0 or upperVolumeIndex(axis) == NumberOfVolumesPerAxis;
        const int  faceOfPatch   = upperVolumeIndex(axis) == 0 ? axis : axis + DIMENSIONS;
        const bool keepsFace     = isInterfaceOfPatch
                              and (sharedFace < 0 ? not isFaceOfPatch : (isFaceOfPatch and faceOfPatch == sharedFace));
        if (keepsFace) {
          const int         side = isUpperFace ? 0 : 1;
          ComputePrecision* base = interfaceData + interfaceOffset(axis, upperVolumeIndex);
          faceStates[face]       = base + side * StateEntriesPerSide;
          faceFluxes[face]       = base + 2 * StateEntriesPerSide + side * FluxEntriesPerSide;
          isNeeded               = true;
        } else {
          faceStates[face] = scratch + Layout::DiscardedStatesOffset + face * StateEntriesPerSide;
          faceFluxes[face] = scratch + Layout::DiscardedFluxesOffset + face * FluxEntriesPerSide;
        }
      }
      if (not isNeeded) {
        continue;
      }

      Reconstruction::template reconstructPolynomial<NumberOfVolumesPerAxis, NumberOfData>(
        inputPatch,
        faceInputPatches,
        volumeIndex,
        sharedFace,
        nodalState,
        reconstructionScratch
      );

      ComputePrecision reconstructedAverage[NumberOfUnknowns]{};
      if (sharedFace < 0) {
        for (int unknown = 0; unknown < NumberOfUnknowns; unknown++) {
          reconstructedAverage[unknown] = ComputePrecision(0);
          for (int cellNode = 0; cellNode < NodesPerCell; cellNode++) {
            reconstructedAverage[unknown] +=
              PredictorTables.cellQuadratureWeights[cellNode] * nodalState[cellNode * NumberOfData + unknown];
          }
        }
      }

      const int numberOfPicardIterations = exahype2::dg::ader::spaceTimePredictor<
        SolverType,
        NumberOfNodes,
        NumberOfUnknowns,
        NumberOfAuxiliaryVariables,
        EvaluateFlux,
        EvaluateNonconservativeProduct,
        EvaluateSource,
        false,
        false>(
        faceStates,
        faceFluxes,
        nodalState,
        timeAveragedScratch,
        picardScratch,
        predictorView,
        predictorView,
        volumeCentre,
        volumeSize,
        timeStamp,
        timeStepSize,
        PicardResidualTolerance
      );
      if (numberOfPicardIterations < 0) {
        return std::numeric_limits<double>::quiet_NaN();
      }

      if (sharedFace < 0) {
        const int                             offset = patchOffset(volumeIndex);
        StoragePrecision* NOALIAS const       output = outputPatch + offset;
        const StoragePrecision* NOALIAS const input  = inputPatch + offset;
        for (int unknown = 0; unknown < NumberOfUnknowns; unknown++) {
          ComputePrecision predictedAverage = ComputePrecision(0);
          for (int cellNode = 0; cellNode < NodesPerCell; cellNode++) {
            predictedAverage +=
              PredictorTables.cellQuadratureWeights[cellNode] * nodalState[cellNode * NumberOfData + unknown];
          }
          output[unknown] = static_cast<StoragePrecision>(
            static_cast<StateUpdatePrecision>(input[unknown])
            + static_cast<StateUpdatePrecision>(predictedAverage - reconstructedAverage[unknown])
          );
        }
        for (int unknown = NumberOfUnknowns; unknown < NumberOfData; unknown++) {
          output[unknown] = input[unknown];
        }
      }
    }
  }

  double       maxEigenvalueAfterTimeStep = 0.0;
  const double halfTimeStamp              = timeStamp + 0.5 * timeStepSize;
  tarch::la::Vector<DIMENSIONS, double> volumeSize;
  tarch::la::Vector<DIMENSIONS, double> patchOrigin;
  for (int axis = 0; axis < DIMENSIONS; axis++) {
    volumeSize(axis)  = patchSize(axis) / NumberOfVolumesPerAxis;
    patchOrigin(axis) = patchCentre(axis) - 0.5 * patchSize(axis);
  }

  for (int axis = 0; axis < DIMENSIONS; axis++) {
    const auto scale = static_cast<ComputePrecision>(
      static_cast<GeometryPrecision>(timeStepSize) / static_cast<GeometryPrecision>(volumeSize(axis))
    );

    for (int interface = 0; interface < InterfacesPerAxis; interface++) {
      tarch::la::Vector<DIMENSIONS, int> upperVolumeIndex;
      upperVolumeIndex(axis) = interface % (NumberOfVolumesPerAxis + 1);
      int remainder          = interface / (NumberOfVolumesPerAxis + 1);
      for (int tangential = 0; tangential < DIMENSIONS; tangential++) {
        if (tangential != axis) {
          upperVolumeIndex(tangential) = remainder % NumberOfVolumesPerAxis;
          remainder /= NumberOfVolumesPerAxis;
        }
      }

      const ComputePrecision* const base        = interfaceData + interfaceOffset(axis, upperVolumeIndex);
      const ComputePrecision* const lowerStates = base;
      const ComputePrecision* const upperStates = base + StateEntriesPerSide;
      const ComputePrecision* const lowerFluxes = base + 2 * StateEntriesPerSide;
      const ComputePrecision* const upperFluxes = base + 2 * StateEntriesPerSide + FluxEntriesPerSide;

      ComputePrecision fluxOutOfLowerVolume[NumberOfUnknowns];
      ComputePrecision fluxIntoUpperVolume[NumberOfUnknowns];
      ComputePrecision nonconservativeFluctuation[NumberOfUnknowns];
      for (int unknown = 0; unknown < NumberOfUnknowns; unknown++) {
        fluxOutOfLowerVolume[unknown]       = ComputePrecision(0);
        fluxIntoUpperVolume[unknown]        = ComputePrecision(0);
        nonconservativeFluctuation[unknown] = ComputePrecision(0);
      }

      for (int faceNode = 0; faceNode < NodesPerFace; faceNode++) {
        tarch::la::Vector<DIMENSIONS, double> nodePosition;
        nodePosition(axis)       = patchOrigin(axis) + upperVolumeIndex(axis) * volumeSize(axis);
        double weight            = 1.0;
        int    nodeRemainder     = faceNode;
        for (int tangential = 0; tangential < DIMENSIONS; tangential++) {
          if (tangential != axis) {
            const int node           = nodeRemainder % NumberOfNodes;
            nodeRemainder           /= NumberOfNodes;
            weight                  *= Weights[node];
            nodePosition(tangential) = patchOrigin(tangential)
                                     + (upperVolumeIndex(tangential) + Nodes[node]) * volumeSize(tangential);
          }
        }
        const auto nodeWeight = static_cast<ComputePrecision>(weight);

        const ComputePrecision* const lowerState = lowerStates + faceNode * NumberOfData;
        const ComputePrecision* const upperState = upperStates + faceNode * NumberOfData;

        if constexpr (EvaluateCustomRiemann) {
          ComputePrecision leftGoingFlux[NumberOfUnknowns] __attribute__((aligned(PEANO_WITH_ALIGNMENT)));
          ComputePrecision rightGoingFlux[NumberOfUnknowns] __attribute__((aligned(PEANO_WITH_ALIGNMENT)));
          const ComputePrecision maxWaveSpeed = SolverType::solveRiemannProblem(
            lowerState,
            upperState,
            nodePosition,
            volumeSize,
            halfTimeStamp,
            timeStepSize,
            axis,
            leftGoingFlux,
            rightGoingFlux
          );
          if constexpr (EvaluateMaxEigenvalue) {
            exahype2::fv::accumulateMaxEigenvalue(maxEigenvalueAfterTimeStep, maxWaveSpeed);
          }
          for (int unknown = 0; unknown < NumberOfUnknowns; unknown++) {
            fluxOutOfLowerVolume[unknown] += nodeWeight * leftGoingFlux[unknown];
            fluxIntoUpperVolume[unknown] += nodeWeight * rightGoingFlux[unknown];
          }
        } else {
          ComputePrecision maxEigenvalue =
            SolverType::maxEigenvalue(lowerState, nodePosition, volumeSize, halfTimeStamp, timeStepSize, axis);
          exahype2::fv::accumulateMaxEigenvalue(
            maxEigenvalue,
            SolverType::maxEigenvalue(upperState, nodePosition, volumeSize, halfTimeStamp, timeStepSize, axis)
          );
          for (int unknown = 0; unknown < NumberOfUnknowns; unknown++) {
            ComputePrecision faceFlux =
              -static_cast<ComputePrecision>(0.5) * maxEigenvalue * (upperState[unknown] - lowerState[unknown]);
            if constexpr (EvaluateFlux) {
              faceFlux += static_cast<ComputePrecision>(0.5)
                        * (lowerFluxes[faceNode * NumberOfUnknowns + unknown]
                           + upperFluxes[faceNode * NumberOfUnknowns + unknown]);
            }
            fluxOutOfLowerVolume[unknown] += nodeWeight * faceFlux;
            fluxIntoUpperVolume[unknown] += nodeWeight * faceFlux;
          }

          if constexpr (EvaluateNonconservativeProduct) {
            ComputePrecision averageState[NumberOfData] __attribute__((aligned(PEANO_WITH_ALIGNMENT)));
            ComputePrecision stateJump[NumberOfData] __attribute__((aligned(PEANO_WITH_ALIGNMENT)));
            ComputePrecision fluctuation[NumberOfUnknowns] __attribute__((aligned(PEANO_WITH_ALIGNMENT)));
            for (int entry = 0; entry < NumberOfData; entry++) {
              averageState[entry] = static_cast<ComputePrecision>(0.5) * (lowerState[entry] + upperState[entry]);
              stateJump[entry]    = upperState[entry] - lowerState[entry];
            }
            SolverType::nonconservativeProduct(
              averageState,
              stateJump,
              nodePosition,
              volumeSize,
              halfTimeStamp,
              timeStepSize,
              axis,
              fluctuation
            );
            for (int unknown = 0; unknown < NumberOfUnknowns; unknown++) {
              nonconservativeFluctuation[unknown] += nodeWeight * static_cast<ComputePrecision>(0.5)
                                                   * fluctuation[unknown];
            }
          }
        }
      }

      if (upperVolumeIndex(axis) > 0) {
        auto lowerVolumeIndex = upperVolumeIndex;
        lowerVolumeIndex(axis)--;
        StoragePrecision* NOALIAS const output = outputPatch + patchOffset(lowerVolumeIndex);
        for (int unknown = 0; unknown < NumberOfUnknowns; unknown++) {
          output[unknown] = static_cast<StoragePrecision>(
            static_cast<StateUpdatePrecision>(output[unknown])
            - static_cast<StateUpdatePrecision>(scale * (fluxOutOfLowerVolume[unknown] + nonconservativeFluctuation[unknown]))
          );
        }
      }
      if (upperVolumeIndex(axis) < NumberOfVolumesPerAxis) {
        StoragePrecision* NOALIAS const output = outputPatch + patchOffset(upperVolumeIndex);
        for (int unknown = 0; unknown < NumberOfUnknowns; unknown++) {
          output[unknown] = static_cast<StoragePrecision>(
            static_cast<StateUpdatePrecision>(output[unknown])
            + static_cast<StateUpdatePrecision>(scale * (fluxIntoUpperVolume[unknown] - nonconservativeFluctuation[unknown]))
          );
        }
      }
    }
  }

  for (int linearisedVolumeIndex = 0; linearisedVolumeIndex < NumberOfVolumesInPatch; linearisedVolumeIndex++) {
    tarch::la::Vector<DIMENSIONS, int> volumeIndex;
    int                                remainder = linearisedVolumeIndex;
    for (int axis = 0; axis < DIMENSIONS; axis++) {
      volumeIndex(axis) = remainder % NumberOfVolumesPerAxis;
      remainder /= NumberOfVolumesPerAxis;
    }
    const StoragePrecision* NOALIAS const outputState = outputPatch + patchOffset(volumeIndex);

    for (int unknown = 0; unknown < NumberOfUnknowns; unknown++) {
      [[maybe_unused]] const bool outputStateIsFinite = std::isfinite(outputState[unknown]);
      assertion(outputStateIsFinite, unknown, outputState[unknown]);
    }

    if constexpr (EvaluateMaxEigenvalueOfFinalState) {
      const auto [volumeSizeOfState, volumeCentre] =
        exahype2::fv::getVolumeSizeAndCentre<DIMENSIONS, NumberOfVolumesPerAxis>(patchCentre, patchSize, volumeIndex);
      ComputePrecision finalState[NumberOfData] __attribute__((aligned(PEANO_WITH_ALIGNMENT)));
      for (int entry = 0; entry < NumberOfData; entry++) {
        finalState[entry] = static_cast<ComputePrecision>(outputState[entry]);
      }
      for (int normal = 0; normal < DIMENSIONS; normal++) {
        exahype2::fv::accumulateMaxEigenvalue(
          maxEigenvalueAfterTimeStep,
          SolverType::maxEigenvalue(
            finalState,
            volumeCentre,
            volumeSizeOfState,
            timeStamp + timeStepSize,
            timeStepSize,
            normal
          )
        );
      }
    }

    for (int normal = 0; normal < DIMENSIONS; normal++) {
      if (volumeIndex(normal) < HaloSize) {
        tarch::la::Vector<DIMENSIONS, int> overlapCell = volumeIndex;
        overlapCell(normal)                            = volumeIndex(normal) + HaloSize;
        const int overlapIndex =
          exahype2::serialiseVoxelIndexInOverlap(overlapCell, NumberOfVolumesPerAxis, HaloSize, normal);
        StoragePrecision* NOALIAS const faceData = faceOutputPatches[normal];
        for (int entry = 0; entry < NumberOfData; entry++) {
          faceData[overlapIndex * NumberOfData + entry] = outputState[entry];
        }
      }
      if (volumeIndex(normal) >= NumberOfVolumesPerAxis - HaloSize) {
        tarch::la::Vector<DIMENSIONS, int> overlapCell = volumeIndex;
        overlapCell(normal)                            = volumeIndex(normal) - (NumberOfVolumesPerAxis - HaloSize);
        const int overlapIndex =
          exahype2::serialiseVoxelIndexInOverlap(overlapCell, NumberOfVolumesPerAxis, HaloSize, normal);
        StoragePrecision* NOALIAS const faceData = faceOutputPatches[normal + DIMENSIONS];
        for (int entry = 0; entry < NumberOfData; entry++) {
          faceData[overlapIndex * NumberOfData + entry] = outputState[entry];
        }
      }
    }
  }

  return maxEigenvalueAfterTimeStep;
}
TARGET_DECLARE_END
