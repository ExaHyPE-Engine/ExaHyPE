#include <limits>

TARGET_DECLARE
template <
  typename Reconstruction,
  typename SolverType,
  int  NumberOfVolumesPerAxis,
  int  NumberOfUnknowns,
  int  NumberOfAuxiliaryVariables,
  bool EvaluateFlux,
  bool EvaluateNonconservativeProduct,
  bool EvaluateSource,
  bool EvaluateDiffusiveSource,
  bool EvaluateCustomRiemann,
  bool EvaluateMaxEigenvalue,
  typename StoragePrecision,
  typename ComputePrecision,
  typename Terms>
INLINE_METHOD GPU_CALLABLE_METHOD double
exahype2::fv::timestepping::ADER::applyToVolume(
  const int                                    volume,
  const StoragePrecision* NOALIAS const        inputPatch,
  const StoragePrecision* NOALIAS const        faceInputPatches[peano4::FacesPerCell],
  const tarch::la::Vector<DIMENSIONS, double>& patchCentre,
  const tarch::la::Vector<DIMENSIONS, double>& patchSize,
  const double                                 timeStamp,
  const double                                 timeStepSize,
  const int                                    boundaryFaces,
  [[maybe_unused]] Terms&                      terms,
  StoragePrecision* NOALIAS const              updatedState
) {
  static_assert(not EvaluateDiffusiveSource, "ADER-WENO does not support diffusive source terms.");
  using Basis     = typename Reconstruction::Basis;
  using Predictor = exahype2::dg::ader::NonlinearPredictor<
    PredictorTerms<SolverType, Reconstruction, NumberOfUnknowns, NumberOfAuxiliaryVariables>,
    ComputePrecision>;
  using Layout          = typename Predictor::CellLayout;
  using Scratch         = typename Predictor::Scratch;
  using UpdatePrecision = std::common_type_t<StoragePrecision, ComputePrecision, double>;
  constexpr int                                          Data         = NumberOfUnknowns + NumberOfAuxiliaryVariables;
  constexpr int                                          StateEntries = Layout::NodesPerFace * Data;
  constexpr int                                          FluxEntries  = Layout::NodesPerFace * NumberOfUnknowns;
  constexpr ADERPredictorTables<Basis, ComputePrecision> Tables{};
  constexpr auto                                         Nodes   = Basis::nodes();
  constexpr auto                                         Weights = Basis::weights();

  alignas(PEANO_WITH_ALIGNMENT) ComputePrecision scratch[Scratch::Size];
  alignas(PEANO_WITH_ALIGNMENT) ComputePrecision nodalState[Layout::NodesPerCell * Data];
  alignas(PEANO_WITH_ALIGNMENT) ComputePrecision reconstructionScratch[Reconstruction::template ScratchSize<Data>];
  alignas(PEANO_WITH_ALIGNMENT) ComputePrecision centreStates[peano4::FacesPerCell][StateEntries];
  alignas(PEANO_WITH_ALIGNMENT) ComputePrecision centreFluxes[peano4::FacesPerCell][FluxEntries];
  alignas(PEANO_WITH_ALIGNMENT) ComputePrecision otherStates[peano4::FacesPerCell][StateEntries];
  alignas(PEANO_WITH_ALIGNMENT) ComputePrecision otherFluxes[peano4::FacesPerCell][FluxEntries];
  const auto                                     index = peano4::dDelinearised(volume, NumberOfVolumesPerAxis);
  const auto volumeSize                                = exahype2::fv::getVolumeSize(patchSize, NumberOfVolumesPerAxis);

  const auto predict = [&](
                         const tarch::la::Vector<DIMENSIONS, int>& cell,
                         const int                                 sharedFace,
                         ComputePrecision                          states[peano4::FacesPerCell][StateEntries],
                         ComputePrecision                          fluxes[peano4::FacesPerCell][FluxEntries]
                       ) {
    Reconstruction::template reconstructPolynomial<NumberOfVolumesPerAxis, Data>(
      inputPatch,
      faceInputPatches,
      cell,
      sharedFace,
      nodalState,
      reconstructionScratch
    );
    ComputePrecision* statePointers[peano4::FacesPerCell];
    ComputePrecision* fluxPointers[peano4::FacesPerCell];
    for (int face = 0; face < peano4::FacesPerCell; face++) {
      statePointers[face] = states[face];
      fluxPointers[face]  = fluxes[face];
    }
    return Predictor::predict(
      statePointers,
      fluxPointers,
      nodalState,
      scratch,
      Tables.view(),
      exahype2::fv::getVolumeCentre(patchCentre, patchSize, NumberOfVolumesPerAxis, cell),
      volumeSize,
      timeStamp,
      timeStepSize,
      PicardResidualTolerance
    );
  };
  const auto diverged = [&](const int outcome) {
    if (outcome != exahype2::dg::ader::DivergedPicardIteration) {
      return false;
    }
    for (int entry = 0; entry < Data; entry++) {
      updatedState[entry] = entry < NumberOfUnknowns ? std::numeric_limits<StoragePrecision>::quiet_NaN()
                                                     : inputPatch[volume * Data + entry];
    }
    return true;
  };

  if (diverged(predict(index, -1, centreStates, centreFluxes))) {
    return std::numeric_limits<double>::quiet_NaN();
  }
  UpdatePrecision update[NumberOfUnknowns]{};
  // Against the constant FV test function the flux volume term vanishes. The
  // predictor's averaged source already includes minus B(Q) grad(Q).
  if constexpr (Predictor::AccumulatesSource) {
    for (int node = 0; node < Layout::NodesPerCell; node++) {
      for (int unknown = 0; unknown < NumberOfUnknowns; unknown++) {
        update[unknown] += timeStepSize * Tables.cellQuadratureWeights[node]
          * scratch[Scratch::TimeAveragedSourceOffset + node * Layout::PaddedNumberOfUnknowns + unknown];
      }
    }
  }
  double maximum = 0.0;
  for (int face = 0; face < peano4::FacesPerCell; face++) {
    const int  axis       = face % DIMENSIONS;
    const int  side       = face / DIMENSIONS;
    const int  opposite   = side == 0 ? axis + DIMENSIONS : axis;
    const bool patchFace  = index(axis) == (side == 0 ? 0 : NumberOfVolumesPerAxis - 1);
    const int  sharedFace = patchFace ? face : -1;
    alignas(PEANO_WITH_ALIGNMENT) ComputePrecision localState[StateEntries];
    alignas(PEANO_WITH_ALIGNMENT) ComputePrecision localFlux[FluxEntries];
    if (patchFace and diverged(predict(index, sharedFace, otherStates, otherFluxes))) {
      return std::numeric_limits<double>::quiet_NaN();
    }
    for (int entry = 0; entry < StateEntries; entry++) {
      localState[entry] = patchFace ? otherStates[face][entry] : centreStates[face][entry];
    }
    for (int entry = 0; entry < FluxEntries; entry++) {
      localFlux[entry] = patchFace ? otherFluxes[face][entry] : centreFluxes[face][entry];
    }
    auto neighbour = index;
    neighbour(axis) += side == 0 ? -1 : 1;
    if (diverged(predict(neighbour, sharedFace, otherStates, otherFluxes))) {
      return std::numeric_limits<double>::quiet_NaN();
    }
    for (int node = 0; node < Layout::NodesPerFace; node++) {
      const ComputePrecision* left  = side == 0 ? otherStates[opposite] + node * Data : localState + node * Data;
      const ComputePrecision* right = side == 0 ? localState + node * Data : otherStates[opposite] + node * Data;
      const ComputePrecision* leftFlux =
        side == 0 ? otherFluxes[opposite] + node * NumberOfUnknowns : localFlux + node * NumberOfUnknowns;
      const ComputePrecision* rightFlux =
        side == 0 ? localFlux + node * NumberOfUnknowns : otherFluxes[opposite] + node * NumberOfUnknowns;
      auto position = exahype2::fv::getVolumeCentre(patchCentre, patchSize, NumberOfVolumesPerAxis, index);
      position(axis) += (side == 0 ? -0.5 : 0.5) * volumeSize(axis);
      double weight    = 1.0;
      int    remainder = node;
      for (int tangent = 0; tangent < DIMENSIONS; tangent++) {
        if (tangent != axis) {
          const int n = remainder % Basis::NumberOfNodes;
          remainder /= Basis::NumberOfNodes;
          position(tangent) += (Nodes[n] - 0.5) * volumeSize(tangent);
          weight *= Weights[n];
        }
      }
      alignas(PEANO_WITH_ALIGNMENT) ComputePrecision fluxLeft[NumberOfUnknowns];
      alignas(PEANO_WITH_ALIGNMENT) ComputePrecision fluxRight[NumberOfUnknowns];
      double                                         eigenvalue;
      if constexpr (EvaluateCustomRiemann) {
        eigenvalue = exahype2::fv::solveRiemannProblemOnVolumeFace<SolverType, NumberOfVolumesPerAxis>(
          left,
          right,
          position,
          volumeSize,
          timeStamp + 0.5 * timeStepSize,
          timeStepSize,
          axis,
          index,
          side,
          boundaryFaces,
          fluxLeft,
          fluxRight
        );
      } else {
        eigenvalue = exahype2::MaxEigenvalueReduction::combine(
          SolverType::maxEigenvalue(left, position, volumeSize, timeStamp + 0.5 * timeStepSize, timeStepSize, axis),
          SolverType::maxEigenvalue(right, position, volumeSize, timeStamp + 0.5 * timeStepSize, timeStepSize, axis)
        );
        for (int unknown = 0; unknown < NumberOfUnknowns; unknown++) {
          ComputePrecision flux =
            -ComputePrecision(0.5) * static_cast<ComputePrecision>(eigenvalue) * (right[unknown] - left[unknown]);
          if constexpr (EvaluateFlux) {
            flux += ComputePrecision(0.5) * (leftFlux[unknown] + rightFlux[unknown]);
          }
          fluxLeft[unknown]  = flux;
          fluxRight[unknown] = flux;
        }
        if constexpr (EvaluateNonconservativeProduct) {
          alignas(PEANO_WITH_ALIGNMENT) ComputePrecision average[Data], jump[Data], fluctuation[NumberOfUnknowns];
          for (int entry = 0; entry < Data; entry++) {
            average[entry] = ComputePrecision(0.5) * (left[entry] + right[entry]);
            jump[entry]    = right[entry] - left[entry];
          }
          SolverType::nonconservativeProduct(
            average,
            jump,
            position,
            volumeSize,
            timeStamp + 0.5 * timeStepSize,
            timeStepSize,
            axis,
            fluctuation
          );
          for (int unknown = 0; unknown < NumberOfUnknowns; unknown++) {
            fluxLeft[unknown] += ComputePrecision(0.5) * fluctuation[unknown];
            fluxRight[unknown] -= ComputePrecision(0.5) * fluctuation[unknown];
          }
        }
      }
      if constexpr (EvaluateMaxEigenvalue) {
        maximum = exahype2::MaxEigenvalueReduction::combine(maximum, eigenvalue);
      }
      for (int unknown = 0; unknown < NumberOfUnknowns; unknown++) {
        update[unknown] +=
          timeStepSize * weight / volumeSize(axis) * (side == 0 ? fluxRight[unknown] : -fluxLeft[unknown]);
      }
    }
  }
  for (int entry = 0; entry < Data; entry++) {
    updatedState[entry] = static_cast<StoragePrecision>(
      static_cast<UpdatePrecision>(inputPatch[volume * Data + entry])
      + (entry < NumberOfUnknowns ? update[entry] : UpdatePrecision(0))
    );
  }
  return maximum;
}
TARGET_DECLARE_END
