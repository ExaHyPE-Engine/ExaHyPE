template <typename Particle>
double exahype2::fv::particles::utils::getRadius(const Particle& particle) {
  return particle.getData(exahype2::fv::particles::utils::ParticleRadiusAttributeOffset);
}

template <typename Particle>
void exahype2::fv::particles::utils::setRadius(Particle& particle, const double radius) {
  assertion(radius >= 0.0, radius);
  particle.setData(exahype2::fv::particles::utils::ParticleRadiusAttributeOffset, radius);
}

template <typename Particle>
double exahype2::fv::particles::utils::getMass(const Particle& particle) {
  return particle.getData(exahype2::fv::particles::utils::ParticleMassAttributeOffset);
}

template <typename Particle>
void exahype2::fv::particles::utils::setMass(Particle& particle, const double mass) {
  assertion(mass >= 0.0, mass);
  particle.setData(exahype2::fv::particles::utils::ParticleMassAttributeOffset, mass);
}

template <typename Particle>
tarch::la::Vector<DIMENSIONS, double> exahype2::fv::particles::utils::getVelocity(const Particle& particle) {
  tarch::la::Vector<DIMENSIONS, double> velocity;

  for (int axis = 0; axis < DIMENSIONS; ++axis) {
    velocity[axis] = particle.getData(exahype2::fv::particles::utils::ParticleVelocityAttributeOffset + axis);
  }

  return velocity;
}

template <typename Particle>
void exahype2::fv::particles::utils::setVelocity(
  Particle&                                    particle,
  const tarch::la::Vector<DIMENSIONS, double>& velocity
) {
  for (int axis = 0; axis < DIMENSIONS; ++axis) {
    particle.setData(exahype2::fv::particles::utils::ParticleVelocityAttributeOffset + axis, velocity[axis]);
  }
}

template <typename Particle>
double exahype2::fv::particles::utils::getInterpolatedRho(const Particle& particle) {
  return particle.getData(exahype2::fv::particles::utils::FluidDensityAttributeOffset);
}

template <typename Particle>
tarch::la::Vector<DIMENSIONS, double> exahype2::fv::particles::utils::getAcceleration(const Particle& particle) {
  tarch::la::Vector<DIMENSIONS, double> acceleration;

  for (int axis = 0; axis < DIMENSIONS; ++axis) {
    acceleration[axis] = particle.getData(exahype2::fv::particles::utils::ParticleAccelerationAttributeOffset + axis);
  }

  return acceleration;
}

template <typename Particle>
void exahype2::fv::particles::utils::setAcceleration(
  Particle&                                    particle,
  const tarch::la::Vector<DIMENSIONS, double>& acceleration
) {
  for (int axis = 0; axis < DIMENSIONS; ++axis) {
    particle.setData(exahype2::fv::particles::utils::ParticleAccelerationAttributeOffset + axis, acceleration[axis]);
  }
}

template <typename Particle>
void exahype2::fv::particles::utils::resetAcceleration(Particle& particle) {
  const tarch::la::Vector<DIMENSIONS, double> zeroAcceleration(0.0);
  exahype2::fv::particles::utils::setAcceleration(particle, zeroAcceleration);
}

template <typename Particle>
double exahype2::fv::particles::utils::computeKineticEnergy(const Particle& particle) {
  const tarch::la::Vector<DIMENSIONS, double> velocity = exahype2::fv::particles::utils::getVelocity(particle);
  const double                                mass     = exahype2::fv::particles::utils::getMass(particle);
  return 0.5 * mass * tarch::la::dot(velocity, velocity);
}

template <typename Particle>
tarch::la::Vector<DIMENSIONS, double> exahype2::fv::particles::utils::computeMomentum(const Particle& particle) {
  const tarch::la::Vector<DIMENSIONS, double> velocity = exahype2::fv::particles::utils::getVelocity(particle);
  const double                                mass     = exahype2::fv::particles::utils::getMass(particle);
  return mass * velocity;
}

template <typename Particle>
exahype2::fv::particles::utils::ParticleState exahype2::fv::particles::utils::getParticleState(
  const Particle& particle
) {
  exahype2::fv::particles::utils::ParticleState state;

  state.position     = particle.getX();
  state.velocity     = exahype2::fv::particles::utils::getVelocity(particle);
  state.acceleration = exahype2::fv::particles::utils::getAcceleration(particle);

  return state;
}

template <typename Particle>
void exahype2::fv::particles::utils::setParticleState(
  Particle&                                            particle,
  const exahype2::fv::particles::utils::ParticleState& state
) {
  exahype2::fv::particles::utils::setVelocity(particle, state.velocity);
  exahype2::fv::particles::utils::setAcceleration(particle, state.acceleration);
}
