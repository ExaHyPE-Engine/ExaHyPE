/**
 * Interpolates consecutive solver values into selected particle attributes,
 * evaluates the configured forces, advances the particle, and reflects it with
 * a damping factor of 0.8 at non-periodic domain boundaries.
 *
 * @tparam ParticleAttributeIndices Destination particle attributes for
 * consecutive solver values.
 */
template <int... ParticleAttributeIndices, typename Particle>
INLINE_METHOD void exahype2::fv::particles::updateParticleState(
  Particle&                           particle,
  const peano4::dataview::CellMarker& cellMarker,
  const double* NOALIAS const         cellValues,
  const double                        timeStepSize,
  const int                           integrationMethod
) {
  exahype2::fv::particles::utils::resetAcceleration(particle);
  exahype2::fv::particles::interpolation::applyInterpolation<ParticleAttributeIndices...>(
    particle,
    particle.getX(),
    cellMarker,
    cellValues
  );
  exahype2::fv::particles::forces::applyForces(particle, particle.getX());

  auto newPosition = exahype2::fv::particles::integration::applyIntegration<ParticleAttributeIndices...>(
    particle,
    cellMarker,
    cellValues,
    timeStepSize,
    integrationMethod
  );
  if (tarch::la::min(exahype2::fv::particles::utils::isPeriodic) == 0) {
    constexpr double BoundaryDamping = 0.8;
    exahype2::fv::particles::boundary::reflectIfOutOfDomain(particle, newPosition, BoundaryDamping);
  }

  particle.setX(newPosition);
}
