inline exahype2::fv::particles::utils::ParticleState exahype2::fv::particles::integration::updatePartialStep(
  const exahype2::fv::particles::utils::ParticleState& current,
  double                                               timeStepSize,
  double                                               stepFraction
) {
  exahype2::fv::particles::utils::ParticleState state;
  const double                                  factorDt = stepFraction * timeStepSize;

  for (int d = 0; d < DIMENSIONS; ++d) {
    state.velocity(d) = current.velocity(d) + factorDt * current.acceleration(d);
    state.position(d) = current.position(d) + factorDt * current.velocity(d);
  }

  return state;
}

inline exahype2::fv::particles::utils::ParticleState exahype2::fv::particles::integration::updatePartialStepWithBase(
  const exahype2::fv::particles::utils::ParticleState& base,
  const exahype2::fv::particles::utils::ParticleState& update,
  double                                               timeStepSize,
  double                                               factor
) {
  exahype2::fv::particles::utils::ParticleState result;
  const double                                  factorDt = factor * timeStepSize;

  for (int d = 0; d < DIMENSIONS; ++d) {
    result.velocity(d)     = base.velocity(d) + factorDt * update.acceleration(d);
    result.position(d)     = base.position(d) + factorDt * update.velocity(d);
    result.acceleration(d) = update.acceleration(d);
  }

  return result;
}

inline exahype2::fv::particles::utils::ParticleState exahype2::fv::particles::integration::updateMidpointStep(
  const exahype2::fv::particles::utils::ParticleState& current,
  double                                               timeStepSize,
  double                                               stepFraction
) {
  exahype2::fv::particles::utils::ParticleState state;
  const double                                  factorDt = stepFraction * timeStepSize;

  for (int d = 0; d < DIMENSIONS; ++d) {
    state.velocity(d) = current.velocity(d) + factorDt * current.acceleration(d);
    state.position(d) = current.position(d) + factorDt * state.velocity(d);
  }

  // The caller replaces the acceleration after the force evaluation of the midpoint state.
  state.acceleration = current.acceleration;
  return state;
}
