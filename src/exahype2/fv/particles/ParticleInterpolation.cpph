template <int... Indices, typename Particle>
void exahype2::fv::particles::interpolation::projectValues_piecewiseConstant(
  const peano4::datamanagement::CellMarker& marker,
  int                                       voxelsPerAxis,
  int                                       unknownsPerVoxel,
  const double* NOALIAS                     Q,
  Particle&                                 particle,
  tarch::la::Vector<DIMENSIONS, double>     pos
) {
  [&]<std::size_t... I>(std::index_sequence<I...>) {
    (particle.setData(
       Indices,
       ::exahype2::fv::particles::interpolation::internal::projectValueOntoParticle_piecewiseConstant(
         marker,
         voxelsPerAxis,
         unknownsPerVoxel,
         Q,
         pos,
         static_cast<int>(I)
       )
     ),
     ...);
  }(std::make_index_sequence<sizeof...(Indices)>{});
}

template <int... Indices, typename Particle>
void exahype2::fv::particles::interpolation::projectValues_piecewiseLinear(
  const peano4::datamanagement::CellMarker& marker,
  int                                       voxelsPerAxis,
  int                                       unknownsPerVoxel,
  const double* NOALIAS                     Q,
  Particle&                                 particle,
  tarch::la::Vector<DIMENSIONS, double>     pos
) {
  [&]<std::size_t... I>(std::index_sequence<I...>) {
    (particle.setData(
       Indices,
       ::exahype2::fv::particles::interpolation::internal::
         projectValueOntoParticle_piecewiseLinear(marker, voxelsPerAxis, unknownsPerVoxel, Q, pos, static_cast<int>(I))
     ),
     ...);
  }(std::make_index_sequence<sizeof...(Indices)>{});
}

template <int... Indices, typename Particle>
void exahype2::fv::particles::interpolation::applyInterpolation(
  Particle&                                 particle,
  tarch::la::Vector<DIMENSIONS, double>     pos,
  const peano4::datamanagement::CellMarker& marker,
  const double* NOALIAS                     Q
) {
  switch (_interpolationMethod) {
  case 0:
    break;
  case 1:
    exahype2::fv::particles::interpolation::projectValues_piecewiseConstant<Indices...>(
      marker,
      _voxelsPerAxis,
      _unknownsPerVoxel,
      Q,
      particle,
      pos
    );
    break;
  case 2:
    exahype2::fv::particles::interpolation::projectValues_piecewiseLinear<Indices...>(
      marker,
      _voxelsPerAxis,
      _unknownsPerVoxel,
      Q,
      particle,
      pos
    );
    break;
  default:
    exahype2::fv::particles::interpolation::projectValues_piecewiseConstant<Indices...>(
      marker,
      _voxelsPerAxis,
      _unknownsPerVoxel,
      Q,
      particle,
      pos
    );
    break;
  }
}

template <int... Indices, typename Particle>
void exahype2::fv::particles::interpolation::handleMidpoints(
  const peano4::datamanagement::CellMarker&    marker,
  const double* NOALIAS                        Q,
  Particle&                                    particle,
  const tarch::la::Vector<DIMENSIONS, double>& midpointPosition
) {
  auto interpolationPosition = midpointPosition;
  if (not marker.isContained(interpolationPosition)) {
    const auto volumeSize = marker.getH() / static_cast<double>(_voxelsPerAxis);
    for (int dimension = 0; dimension < DIMENSIONS; dimension++) {
      const double firstVolumeCentre = marker.getOffset()(dimension) + 0.5 * volumeSize(dimension);
      const double lastVolumeCentre =
        marker.getOffset()(dimension) + marker.getH()(dimension) - 0.5 * volumeSize(dimension);
      interpolationPosition(dimension) =
        std::max(firstVolumeCentre, std::min(interpolationPosition(dimension), lastVolumeCentre));
    }
  }

  exahype2::fv::particles::interpolation::applyInterpolation<Indices...>(particle, interpolationPosition, marker, Q);
}
