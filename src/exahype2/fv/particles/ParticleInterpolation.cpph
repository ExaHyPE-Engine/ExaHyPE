// ================================================================================================
// Projection Functions
// ================================================================================================

template <int... Indices, typename Particle>
void exahype2::fv::particles::interpolation::projectValues_piecewiseConstant(
  const peano4::datamanagement::CellMarker& marker,
  int                                       voxelsPerAxis,
  int                                       unknownsPerVoxel,
  const double* __restrict__ Q,
  Particle&                             particle,
  tarch::la::Vector<DIMENSIONS, double> pos
) {
  [&]<std::size_t... I>(std::index_sequence<I...>) {
    (particle.setData(
       Indices,
       ::exahype2::fv::particles::interpolation::internal::projectValueOntoParticle_piecewiseConstant(
         marker,
         voxelsPerAxis,
         unknownsPerVoxel,
         Q,
         pos,
         static_cast<int>(I)
       )
     ),
     ...);
  }(std::make_index_sequence<sizeof...(Indices)>{});
}

template <int... Indices, typename Particle>
void exahype2::fv::particles::interpolation::projectValues_piecewiseLinear(
  const peano4::datamanagement::CellMarker& marker,
  int                                       voxelsPerAxis,
  int                                       unknownsPerVoxel,
  const double* __restrict__ Q,
  Particle&                             particle,
  tarch::la::Vector<DIMENSIONS, double> pos
) {
  [&]<std::size_t... I>(std::index_sequence<I...>) {
    (particle.setData(
       Indices,
       ::exahype2::fv::particles::interpolation::internal::
         projectValueOntoParticle_piecewiseLinear(marker, voxelsPerAxis, unknownsPerVoxel, Q, pos, static_cast<int>(I))
     ),
     ...);
  }(std::make_index_sequence<sizeof...(Indices)>{});
}

// ================================================================================================
// Interpolation and Field Evaluation
// ================================================================================================

template <int... Indices, typename Particle>
void exahype2::fv::particles::interpolation::applyInterpolation(
  Particle&                                 particle,
  tarch::la::Vector<DIMENSIONS, double>     pos,
  const peano4::datamanagement::CellMarker& marker,
  const double* __restrict__ Q
) {
  switch (_interpolationMethod) {
  case 0:
    break;
  case 1:
    exahype2::fv::particles::interpolation::projectValues_piecewiseConstant<Indices...>(
      marker,
      _voxelsPerAxis,
      _unknownsPerVoxel,
      Q,
      particle,
      pos
    );
    break;
  case 2:
    exahype2::fv::particles::interpolation::projectValues_piecewiseLinear<Indices...>(
      marker,
      _voxelsPerAxis,
      _unknownsPerVoxel,
      Q,
      particle,
      pos
    );
    break;
  default:
    exahype2::fv::particles::interpolation::projectValues_piecewiseConstant<Indices...>(
      marker,
      _voxelsPerAxis,
      _unknownsPerVoxel,
      Q,
      particle,
      pos
    );
    break;
  }
}

template <int... Indices, typename Particle>
void exahype2::fv::particles::interpolation::handleMidpoints(
  const peano4::datamanagement::CellMarker& marker,
  const double* __restrict__ Q,
  Particle&                                    particle,
  const tarch::la::Vector<DIMENSIONS, double>& midpointPosition
) {
  if (marker.isContained(midpointPosition)) {
    exahype2::fv::particles::interpolation::applyInterpolation<Indices...>(particle, particle.getX(), marker, Q);
  } else {
    // Determine direction to neighbor
    tarch::la::Vector<DIMENSIONS, int> neighborDirection(0);
    for (int d = 0; d < DIMENSIONS; d++) {
      double cellMin = marker.getX()(d) - 0.5 * marker.getH()(d);
      double cellMax = marker.getX()(d) + 0.5 * marker.getH()(d);
      if (midpointPosition(d) < cellMin)
        neighborDirection(d) = -1;
      else if (midpointPosition(d) >= cellMax)
        neighborDirection(d) = 1;
    }

    exahype2::CellAccess cellAccess(Q, 1, _unknownsPerVoxel, 0, _voxelsPerAxis);
    const double*        neighborQ = cellAccess(neighborDirection);

    // Adjust midpoint position to neighbor cell's coordinates
    tarch::la::Vector<DIMENSIONS, double> adjustedMidpointPosition;
    for (int d = 0; d < DIMENSIONS; d++) {
      double offset               = neighborDirection(d) * marker.getH()(d);
      adjustedMidpointPosition(d) = midpointPosition(d) - offset;
    }

    exahype2::fv::particles::interpolation::applyInterpolation<Indices...>(
      particle,
      adjustedMidpointPosition,
      marker,
      neighborQ
    );
  }
}
