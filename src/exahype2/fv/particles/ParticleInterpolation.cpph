template <int... Indices, typename Particle>
void exahype2::fv::particles::interpolation::projectValuesPiecewiseConstant(
  const peano4::dataview::CellMarker&   marker,
  int                                   voxelsPerAxis,
  int                                   unknownsPerVoxel,
  const double* NOALIAS                 Q,
  Particle&                             particle,
  tarch::la::Vector<DIMENSIONS, double> pos
) {
  [&]<std::size_t... UnknownIndex>([[maybe_unused]] std::index_sequence<UnknownIndex...> unknownIndices) {
    (particle.setData(
       Indices,
       exahype2::fv::particles::interpolation::projectValueOntoParticlePiecewiseConstant(
         marker,
         voxelsPerAxis,
         unknownsPerVoxel,
         Q,
         pos,
         static_cast<int>(UnknownIndex)
       )
     ),
     ...);
  }(std::make_index_sequence<sizeof...(Indices)>{});
}

template <int... Indices, typename Particle>
void exahype2::fv::particles::interpolation::projectValuesPiecewiseLinear(
  const peano4::dataview::CellMarker&   marker,
  int                                   voxelsPerAxis,
  int                                   unknownsPerVoxel,
  const double* NOALIAS                 Q,
  Particle&                             particle,
  tarch::la::Vector<DIMENSIONS, double> pos
) {
  [&]<std::size_t... UnknownIndex>([[maybe_unused]] std::index_sequence<UnknownIndex...> unknownIndices) {
    (particle.setData(
       Indices,
       exahype2::fv::particles::interpolation::projectValueOntoParticlePiecewiseLinear(
         marker,
         voxelsPerAxis,
         unknownsPerVoxel,
         Q,
         pos,
         static_cast<int>(UnknownIndex)
       )
     ),
     ...);
  }(std::make_index_sequence<sizeof...(Indices)>{});
}

template <int... Indices, typename Particle>
void exahype2::fv::particles::interpolation::applyInterpolation(
  Particle&                             particle,
  tarch::la::Vector<DIMENSIONS, double> pos,
  const peano4::dataview::CellMarker&   marker,
  const double* NOALIAS                 Q
) {
  switch (globalInterpolationMethod) {
  case 0:
    break;
  case 2:
    exahype2::fv::particles::interpolation::projectValuesPiecewiseLinear<Indices...>(
      marker,
      globalVoxelsPerAxis,
      globalUnknownsPerVoxel,
      Q,
      particle,
      pos
    );
    break;
  case 1:
  default:
    exahype2::fv::particles::interpolation::projectValuesPiecewiseConstant<Indices...>(
      marker,
      globalVoxelsPerAxis,
      globalUnknownsPerVoxel,
      Q,
      particle,
      pos
    );
    break;
  }
}

template <int... Indices, typename Particle>
void exahype2::fv::particles::interpolation::interpolateMidpoints(
  const peano4::dataview::CellMarker&          marker,
  const double* NOALIAS                        Q,
  Particle&                                    particle,
  const tarch::la::Vector<DIMENSIONS, double>& midpointPosition
) {
  auto interpolationPosition = midpointPosition;
  if (not marker.isContained(interpolationPosition)) {
    const auto volumeSize = marker.getH() / static_cast<double>(globalVoxelsPerAxis);
    for (int dimension = 0; dimension < DIMENSIONS; dimension++) {
      const double firstVolumeCentre = marker.getOffset()(dimension) + 0.5 * volumeSize(dimension);
      const double lastVolumeCentre =
        marker.getOffset()(dimension) + marker.getH()(dimension) - 0.5 * volumeSize(dimension);
      interpolationPosition(dimension) =
        std::max(firstVolumeCentre, std::min(interpolationPosition(dimension), lastVolumeCentre));
    }
  }

  exahype2::fv::particles::interpolation::applyInterpolation<Indices...>(particle, interpolationPosition, marker, Q);
}
