/**
 * Advances a particle with explicit Euler integration:
 *
 * x(t + dt) = x(t) + v(t) dt.
 */
template <typename Particle>
INLINE_METHOD tarch::la::Vector<DIMENSIONS, double> exahype2::fv::particles::integration::explicitEulerIntegration(
  Particle&    particle,
  const double timeStepSize
) {
  const auto state    = exahype2::fv::particles::utils::getParticleState(particle);
  const auto newState = exahype2::fv::particles::integration::updatePartialStep(state, timeStepSize, 1.0);
  exahype2::fv::particles::utils::setParticleState(particle, newState);
  return newState.position;
}

/**
 * Advances velocity before position with semi-implicit Euler integration:
 *
 * v(t + dt) = v(t) + a(t) dt,
 * x(t + dt) = x(t) + v(t + dt) dt.
 */
template <typename Particle>
INLINE_METHOD tarch::la::Vector<DIMENSIONS, double> exahype2::fv::particles::integration::semiImplicitEulerIntegration(
  Particle&    particle,
  const double timeStepSize
) {
  const auto state    = exahype2::fv::particles::utils::getParticleState(particle);
  const auto newState = exahype2::fv::particles::integration::updateMidpointStep(state, timeStepSize, 1.0);
  exahype2::fv::particles::utils::setParticleState(particle, newState);
  return newState.position;
}

/**
 * Evaluates interpolation and forces at the half step before advancing the
 * particle with second-order midpoint integration:
 *
 * x_half = x(t) + 0.5 v(t) dt,
 * v_half = v(t) + 0.5 a(t) dt,
 * x(t + dt) = x(t) + v_half dt.
 */
template <int... ParticleAttributeIndices, typename Particle>
INLINE_METHOD tarch::la::Vector<DIMENSIONS, double> exahype2::fv::particles::integration::midpointIntegration(
  Particle&                           particle,
  const peano4::dataview::CellMarker& cellMarker,
  const double* NOALIAS const         cellValues,
  const double                        timeStepSize
) {
  const auto currentState  = exahype2::fv::particles::utils::getParticleState(particle);
  auto       midpointState = exahype2::fv::particles::integration::updateMidpointStep(currentState, timeStepSize, 0.5);

  exahype2::fv::particles::interpolation::handleMidpoints<ParticleAttributeIndices...>(
    cellMarker,
    cellValues,
    particle,
    midpointState.position
  );
  exahype2::fv::particles::forces::applyForces(particle, midpointState.position);
  midpointState.acceleration = exahype2::fv::particles::utils::getAcceleration(particle);

  const auto finalState =
    exahype2::fv::particles::integration::updatePartialStepWithBase(currentState, midpointState, timeStepSize, 1.0);
  exahype2::fv::particles::utils::setParticleState(particle, finalState);
  return finalState.position;
}

/**
 * Advances a particle with third-order Runge-Kutta integration:
 *
 * k1 = f(t, x),
 * k2 = f(t + dt / 2, x + dt k1 / 2),
 * k3 = f(t + dt, x - dt k1 + 2 dt k2),
 * x(t + dt) = x(t) + dt (k1 + 4 k2 + k3) / 6.
 */
template <int... ParticleAttributeIndices, typename Particle>
INLINE_METHOD tarch::la::Vector<DIMENSIONS, double> exahype2::fv::particles::integration::rk3Integration(
  Particle&                           particle,
  const peano4::dataview::CellMarker& cellMarker,
  const double* NOALIAS const         cellValues,
  const double                        timeStepSize
) {
  const auto currentState = exahype2::fv::particles::utils::getParticleState(particle);
  const auto k1           = currentState;

  auto k2 = exahype2::fv::particles::integration::updatePartialStep(k1, timeStepSize, 0.5);
  exahype2::fv::particles::interpolation::handleMidpoints<ParticleAttributeIndices...>(
    cellMarker,
    cellValues,
    particle,
    k2.position
  );
  exahype2::fv::particles::forces::applyForces(particle, k2.position);
  k2.acceleration = exahype2::fv::particles::utils::getAcceleration(particle);

  auto k3 = exahype2::fv::particles::integration::updatePartialStepWithBase(currentState, k1, timeStepSize, -1.0);
  k3      = exahype2::fv::particles::integration::updatePartialStepWithBase(k3, k2, timeStepSize, 2.0);
  exahype2::fv::particles::interpolation::handleMidpoints<ParticleAttributeIndices...>(
    cellMarker,
    cellValues,
    particle,
    k3.position
  );
  exahype2::fv::particles::forces::applyForces(particle, k3.position);
  k3.acceleration = exahype2::fv::particles::utils::getAcceleration(particle);

  exahype2::fv::particles::utils::ParticleState finalState;
  for (int dimension = 0; dimension < DIMENSIONS; dimension++) {
    finalState.position(dimension) = currentState.position(dimension)
      + (timeStepSize / 6.0) * (k1.velocity(dimension) + 4.0 * k2.velocity(dimension) + k3.velocity(dimension));
    finalState.velocity(dimension) = currentState.velocity(dimension)
      + (timeStepSize / 6.0)
        * (k1.acceleration(dimension) + 4.0 * k2.acceleration(dimension) + k3.acceleration(dimension));
    finalState.acceleration(dimension) = k3.acceleration(dimension);
  }

  exahype2::fv::particles::utils::setParticleState(particle, finalState);
  return finalState.position;
}

/**
 * Advances a particle with fourth-order Runge-Kutta integration:
 *
 * k1 = f(t, x),
 * k2 = f(t + dt / 2, x + dt k1 / 2),
 * k3 = f(t + dt / 2, x + dt k2 / 2),
 * k4 = f(t + dt, x + dt k3),
 * x(t + dt) = x(t) + dt (k1 + 2 k2 + 2 k3 + k4) / 6.
 */
template <int... ParticleAttributeIndices, typename Particle>
INLINE_METHOD tarch::la::Vector<DIMENSIONS, double> exahype2::fv::particles::integration::rk4Integration(
  Particle&                           particle,
  const peano4::dataview::CellMarker& cellMarker,
  const double* NOALIAS const         cellValues,
  const double                        timeStepSize
) {
  const auto currentState = exahype2::fv::particles::utils::getParticleState(particle);
  const auto k1           = currentState;

  auto k2 = exahype2::fv::particles::integration::updatePartialStep(k1, timeStepSize, 0.5);
  exahype2::fv::particles::interpolation::handleMidpoints<ParticleAttributeIndices...>(
    cellMarker,
    cellValues,
    particle,
    k2.position
  );
  exahype2::fv::particles::forces::applyForces(particle, k2.position);
  k2.acceleration = exahype2::fv::particles::utils::getAcceleration(particle);

  auto k3 = exahype2::fv::particles::integration::updatePartialStepWithBase(currentState, k2, timeStepSize, 0.5);
  exahype2::fv::particles::interpolation::handleMidpoints<ParticleAttributeIndices...>(
    cellMarker,
    cellValues,
    particle,
    k3.position
  );
  exahype2::fv::particles::forces::applyForces(particle, k3.position);
  k3.acceleration = exahype2::fv::particles::utils::getAcceleration(particle);

  auto k4 = exahype2::fv::particles::integration::updatePartialStepWithBase(currentState, k3, timeStepSize, 1.0);
  exahype2::fv::particles::interpolation::handleMidpoints<ParticleAttributeIndices...>(
    cellMarker,
    cellValues,
    particle,
    k4.position
  );
  exahype2::fv::particles::forces::applyForces(particle, k4.position);
  k4.acceleration = exahype2::fv::particles::utils::getAcceleration(particle);

  exahype2::fv::particles::utils::ParticleState finalState;
  for (int dimension = 0; dimension < DIMENSIONS; dimension++) {
    finalState.position(dimension) = currentState.position(dimension)
      + (timeStepSize / 6.0)
        * (k1.velocity(dimension) + 2.0 * k2.velocity(dimension) + 2.0 * k3.velocity(dimension) + k4.velocity(dimension));
    finalState.velocity(dimension) = currentState.velocity(dimension)
      + (timeStepSize / 6.0)
        * (k1.acceleration(dimension) + 2.0 * k2.acceleration(dimension) + 2.0 * k3.acceleration(dimension) + k4.acceleration(dimension));
    finalState.acceleration(dimension) = k4.acceleration(dimension);
  }

  exahype2::fv::particles::utils::setParticleState(particle, finalState);
  return finalState.position;
}

/**
 * Evaluates interpolation and forces at the updated position before completing
 * a velocity Verlet step:
 *
 * x(t + dt) = x(t) + v(t) dt + 0.5 a(t) dt²,
 * v(t + dt) = v(t) + 0.5 (a(t) + a(t + dt)) dt.
 */
template <int... ParticleAttributeIndices, typename Particle>
INLINE_METHOD tarch::la::Vector<DIMENSIONS, double> exahype2::fv::particles::integration::velocityVerletIntegration(
  Particle&                           particle,
  const peano4::dataview::CellMarker& cellMarker,
  const double* NOALIAS const         cellValues,
  const double                        timeStepSize
) {
  const auto currentState = exahype2::fv::particles::utils::getParticleState(particle);
  exahype2::fv::particles::utils::ParticleState midpointState;

  for (int dimension = 0; dimension < DIMENSIONS; dimension++) {
    midpointState.velocity(dimension) =
      currentState.velocity(dimension) + 0.5 * timeStepSize * currentState.acceleration(dimension);
    midpointState.position(dimension) =
      currentState.position(dimension) + timeStepSize * midpointState.velocity(dimension);
  }

  exahype2::fv::particles::interpolation::handleMidpoints<ParticleAttributeIndices...>(
    cellMarker,
    cellValues,
    particle,
    midpointState.position
  );
  exahype2::fv::particles::forces::applyForces(particle, midpointState.position);
  midpointState.acceleration = exahype2::fv::particles::utils::getAcceleration(particle);

  exahype2::fv::particles::utils::ParticleState finalState;
  for (int dimension = 0; dimension < DIMENSIONS; dimension++) {
    finalState.acceleration(dimension) = midpointState.acceleration(dimension);
    finalState.velocity(dimension) =
      midpointState.velocity(dimension) + 0.5 * timeStepSize * finalState.acceleration(dimension);
    finalState.position(dimension) = midpointState.position(dimension);
  }

  exahype2::fv::particles::utils::setParticleState(particle, finalState);
  return finalState.position;
}

/**
 * Selects the integration scheme by its configuration value: 0 keeps the
 * position fixed, 1 selects explicit Euler, 2 semi-implicit Euler, 3 velocity
 * Verlet, 4 midpoint, 5 RK3, and 6 RK4. Unknown values select explicit Euler.
 */
template <int... ParticleAttributeIndices, typename Particle>
INLINE_METHOD tarch::la::Vector<DIMENSIONS, double> exahype2::fv::particles::integration::applyIntegration(
  Particle&                           particle,
  const peano4::dataview::CellMarker& cellMarker,
  const double* NOALIAS const         cellValues,
  const double                        timeStepSize,
  const int                           integrationMethod
) {
  auto newPosition = particle.getX();

  switch (integrationMethod) {
  case 0:
    break;
  case 1:
    newPosition = exahype2::fv::particles::integration::explicitEulerIntegration(particle, timeStepSize);
    break;
  case 2:
    newPosition = exahype2::fv::particles::integration::semiImplicitEulerIntegration(particle, timeStepSize);
    break;
  case 3:
    newPosition = exahype2::fv::particles::integration::velocityVerletIntegration<ParticleAttributeIndices...>(
      particle,
      cellMarker,
      cellValues,
      timeStepSize
    );
    break;
  case 4:
    newPosition = exahype2::fv::particles::integration::midpointIntegration<ParticleAttributeIndices...>(
      particle,
      cellMarker,
      cellValues,
      timeStepSize
    );
    break;
  case 5:
    newPosition = exahype2::fv::particles::integration::rk3Integration<ParticleAttributeIndices...>(
      particle,
      cellMarker,
      cellValues,
      timeStepSize
    );
    break;
  case 6:
    newPosition = exahype2::fv::particles::integration::rk4Integration<ParticleAttributeIndices...>(
      particle,
      cellMarker,
      cellValues,
      timeStepSize
    );
    break;
  default:
    newPosition = exahype2::fv::particles::integration::explicitEulerIntegration(particle, timeStepSize);
    break;
  }

  return newPosition;
}
