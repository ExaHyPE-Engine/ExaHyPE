namespace exahype2 {
  namespace fv {
    namespace particles {
      namespace boundary {
        template <typename Particle>
        void reflectIfOutOfDomain(
          Particle&                              particle,
          tarch::la::Vector<DIMENSIONS, double>& newPosition,
          double                                 dampingFactor
        ) {
          tarch::la::Vector<DIMENSIONS, double> velocity = utils::getVelocity(particle);

          for (int d = 0; d < DIMENSIONS; ++d) {
            double lowerBound = utils::domainOffset(d);
            double upperBound = utils::domainOffset(d) + utils::domainSize(d);

            if (not utils::isPeriodic[d]) {
              if (newPosition[d] < lowerBound) {
                newPosition[d] = lowerBound + (lowerBound - newPosition[d]);
                velocity[d]    = -velocity[d] * dampingFactor;
              } else if (newPosition[d] > upperBound) {
                newPosition[d] = upperBound - (newPosition[d] - upperBound);
                velocity[d]    = -velocity[d] * dampingFactor;
              }
            }
          }

          utils::setVelocity(particle, velocity);
        }
      } // namespace boundary
    } // namespace particles
  } // namespace fv
} // namespace exahype2
