#include "tarch/Assertions.h"

TARGET_DECLARE
/**
 * Writes the value of every entry of the nodal polynomial at point into values. The points are the
 * nodes of the volume, followed by the nodes on every face of it, faces ordered as in Peano.
 */
template <typename Basis>
template <int NumberOfData, typename ComputePrecision>
INLINE_METHOD GPU_CALLABLE_METHOD void exahype2::fv::limiter::PolynomialScaling<Basis>::evaluate(
  const ComputePrecision* NOALIAS const nodalState,
  const int                             point,
  ComputePrecision* NOALIAS const       values
) {
  ASSERTION(point >= 0 and point < Points, point);
  if (point < NodesPerCell) {
    for (int entry = 0; entry < NumberOfData; entry++) {
      values[entry] = nodalState[point * NumberOfData + entry];
    }
    return;
  }
  constexpr auto extrapolation = [](const double x) {
    std::array<double, NodesPerAxis> weights{};
    for (int node = 0; node < NodesPerAxis; node++) {
      weights[node] = Basis::value(node, x);
    }
    return weights;
  };
  constexpr std::array<double, NodesPerAxis> Lower = extrapolation(0.0);
  constexpr std::array<double, NodesPerAxis> Upper = extrapolation(1.0);

  const int  face       = (point - NodesPerCell) / NodesPerFace;
  const int  axis       = face % DIMENSIONS;
  const auto& weights   = face < DIMENSIONS ? Lower : Upper;
  int        remainder  = (point - NodesPerCell) % NodesPerFace;
  int        firstNode  = 0;
  int        stride     = 1;
  int        axisStride = 1;
  for (int otherAxis = 0; otherAxis < DIMENSIONS; otherAxis++) {
    if (otherAxis == axis) {
      axisStride = stride;
    } else {
      firstNode += (remainder % NodesPerAxis) * stride;
      remainder /= NodesPerAxis;
    }
    stride *= NodesPerAxis;
  }
  for (int entry = 0; entry < NumberOfData; entry++) {
    values[entry] = ComputePrecision(0);
  }
  for (int node = 0; node < NodesPerAxis; node++) {
    for (int entry = 0; entry < NumberOfData; entry++) {
      values[entry] += static_cast<ComputePrecision>(weights[node])
                     * nodalState[(firstNode + node * axisStride) * NumberOfData + entry];
    }
  }
}

/**
 * Returns the position of point in a volume, with the points ordered as in evaluate().
 */
template <typename Basis>
INLINE_METHOD GPU_CALLABLE_METHOD tarch::la::Vector<DIMENSIONS, double>
exahype2::fv::limiter::PolynomialScaling<Basis>::getPosition(
  const int                                    point,
  const tarch::la::Vector<DIMENSIONS, double>& volumeCentre,
  const tarch::la::Vector<DIMENSIONS, double>& volumeSize
) {
  ASSERTION(point >= 0 and point < Points, point);
  constexpr auto Nodes = Basis::nodes();

  const bool isNode    = point < NodesPerCell;
  const int  face      = isNode ? -1 : (point - NodesPerCell) / NodesPerFace;
  const int  normal    = isNode ? -1 : face % DIMENSIONS;
  int        remainder = isNode ? point : (point - NodesPerCell) % NodesPerFace;

  tarch::la::Vector<DIMENSIONS, double> position;
  for (int axis = 0; axis < DIMENSIONS; axis++) {
    double coordinate;
    if (axis == normal) {
      coordinate = face < DIMENSIONS ? 0.0 : 1.0;
    } else {
      coordinate = Nodes[remainder % NodesPerAxis];
      remainder /= NodesPerAxis;
    }
    position(axis) = volumeCentre(axis) + (coordinate - 0.5) * volumeSize(axis);
  }
  return position;
}

/**
 * Scales nodalState towards average and returns the scaling factor theta.
 */
template <typename Basis>
template <typename Derived, int NumberOfData, typename StoragePrecision, typename ComputePrecision>
INLINE_METHOD GPU_CALLABLE_METHOD ComputePrecision
exahype2::fv::limiter::PolynomialScaling<Basis>::limit(
  const StoragePrecision* NOALIAS const        average,
  ComputePrecision* NOALIAS const              nodalState,
  const tarch::la::Vector<DIMENSIONS, double>& volumeCentre,
  const tarch::la::Vector<DIMENSIONS, double>& volumeSize,
  const typename Derived::RuntimeParameters&   parameters
) {
  StoragePrecision sample[NumberOfData];
  ComputePrecision values[NumberOfData];
  tarch::la::Vector<DIMENSIONS, double> position;
  const auto       isAdmissible = [&](const ComputePrecision theta) {
    for (int entry = 0; entry < NumberOfData; entry++) {
      sample[entry] = static_cast<StoragePrecision>(average[entry] + theta * (values[entry] - average[entry]));
    }
    return Derived::isPhysicallyAdmissible(sample, 1, position, volumeSize, parameters);
  };

  ComputePrecision theta = Derived::isPhysicallyAdmissible(average, 1, volumeCentre, volumeSize, parameters)
    ? ComputePrecision(1)
    : ComputePrecision(0);
  for (int point = 0; point < Points and theta > ComputePrecision(0); point++) {
    evaluate<NumberOfData>(nodalState, point, values);
    position = getPosition(point, volumeCentre, volumeSize);
    if (not isAdmissible(theta)) {
      ComputePrecision admissible = 0;
      for (int step = 0; step < BisectionSteps; step++) {
        const ComputePrecision middle = ComputePrecision(0.5) * (admissible + theta);
        if (isAdmissible(middle)) {
          admissible = middle;
        } else {
          theta = middle;
        }
      }
      theta = admissible;
    }
  }

  if (theta < ComputePrecision(1)) {
    for (int node = 0; node < NodesPerCell; node++) {
      for (int entry = 0; entry < NumberOfData; entry++) {
        ComputePrecision& value = nodalState[node * NumberOfData + entry];
        value                   = average[entry] + theta * (value - average[entry]);
      }
    }
  }
  return theta;
}
TARGET_DECLARE_END
