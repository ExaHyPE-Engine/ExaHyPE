#include "exahype2/TimeStepping.h"
#include "exahype2/terms/PostprocessUpdatedPatch.h"
#include "peano4/Constants.h"
#include "tarch/accelerator/ParallelReduce.h"
#include "tarch/accelerator/Range.h"
#include "tarch/accelerator/Reducer.h"

TARGET_DECLARE
/**
 * Returns the mask whose bit f is set when face f of the cell lies on the domain boundary.
 */
INLINE_METHOD GPU_CALLABLE_METHOD int
exahype2::fv::getBoundaryFaceMask(const peano4::CellConnectivity& cellConnectivity, const int cell) {
  int mask = 0;
  for (int faceNumber = 0; faceNumber < peano4::FacesPerCell; faceNumber++) {
    if (cellConnectivity.getFaceKind(cellConnectivity.getCellFace(cell, faceNumber)) == peano4::FaceKind::Boundary) {
      mask |= 1 << faceNumber;
    }
  }
  return mask;
}

template <typename Derived, typename StoragePrecision, typename ComputePrecision>
INLINE_METHOD GPU_CALLABLE_METHOD void
exahype2::fv::ApplyBoundaryConditions<Derived, StoragePrecision, ComputePrecision>::operator()(const int entry) const {
  const int face      = boundaryFaces[entry];
  const int lowerCell = cellConnectivity.getFaceCell(face, 0);
  const int slot      = lowerCell >= 0 ? lowerCell : cellConnectivity.getFaceCell(face, 1);
  const int normal    = cellConnectivity.getFaceNormal(face);
  // The face is the upper face of the cell on its lower side.
  const int faceNumber = lowerCell >= 0 ? normal + DIMENSIONS : normal;
  Kernel::applyBoundaryConditions(
    halo.getChunk(face),
    cellConnectivity.getCellCentre(slot),
    cellConnectivity.getCellWidth(slot),
    timeStamp,
    faceNumber
  );
}

template <typename Derived, typename StoragePrecision, typename ComputePrecision>
INLINE_METHOD GPU_CALLABLE_METHOD void
exahype2::fv::InterpolateHaloHalves<Derived, StoragePrecision, ComputePrecision>::operator()(
  const peano4::LevelJump& levelJump
) const {
  const int                     normal = cellConnectivity.getFaceNormal(levelJump.coarseFace);
  const StoragePrecision* const coarse = halo.getChunk(levelJump.coarseFace);
  for (int subface = 0; subface < peano4::SubfacesPerFace; subface++) {
    Kernel::interpolateHalo(coarse, halo.getChunk(levelJump.fineFaces[subface]), levelJump.coarseSide, normal, subface);
  }
}

template <typename Derived, typename StoragePrecision, typename ComputePrecision>
INLINE_METHOD GPU_CALLABLE_METHOD void
exahype2::fv::InjectHaloHalves<Derived, StoragePrecision, ComputePrecision>::operator()(
  const peano4::LevelJump& levelJump
) const {
  const int                     normal = cellConnectivity.getFaceNormal(levelJump.coarseFace);
  const StoragePrecision* const coarse = halo.getChunk(levelJump.coarseFace);
  for (int subface = 0; subface < peano4::SubfacesPerFace; subface++) {
    Kernel::injectHalo(coarse, halo.getChunk(levelJump.fineFaces[subface]), levelJump.coarseSide, normal, subface);
  }
}

template <typename Derived, typename StoragePrecision, typename ComputePrecision>
INLINE_METHOD GPU_CALLABLE_METHOD void
exahype2::fv::RestrictHaloHalves<Derived, StoragePrecision, ComputePrecision>::operator()(
  const peano4::LevelJump& levelJump
) const {
  const int               normal = cellConnectivity.getFaceNormal(levelJump.coarseFace);
  const StoragePrecision* fine[peano4::SubfacesPerFace];
  for (int subface = 0; subface < peano4::SubfacesPerFace; subface++) {
    fine[subface] = halo.getChunk(levelJump.fineFaces[subface]);
  }
  Kernel::restrictHalo(fine, halo.getChunk(levelJump.coarseFace), 1 - levelJump.coarseSide, normal);
}

template <typename Derived, typename StoragePrecision, typename ComputePrecision>
INLINE_METHOD GPU_CALLABLE_METHOD void
exahype2::fv::ProjectPatchesOntoFaces<Derived, StoragePrecision, ComputePrecision>::operator()(
  const int                            entry,
  const tarch::accelerator::TeamHandle team
) const {
  const int         slot = cellConnectivity.getCells()[entry];
  StoragePrecision* faces[peano4::FacesPerCell];
  for (int faceNumber = 0; faceNumber < peano4::FacesPerCell; faceNumber++) {
    faces[faceNumber] = halo.getChunk(cellConnectivity.getCellFace(slot, faceNumber));
  }
  const StoragePrecision* const patch = solution.getChunk(slot);
  tarch::accelerator::parallelFor(
    team,
    tarch::accelerator::Range(Kernel::LayerVolumesPerPatch),
    [=](const int layerVolume) { Kernel::projectVolumeOntoFace(layerVolume, patch, faces); }
  );
}

/**
 * Advances the patch of one cell in place and reduces the wave speeds of the update and of the
 * updated volumes into the accumulator. On the host one thread sweeps the patch. On a device the
 * team updates the volumes in rounds of one volume per thread and runs the patch postprocessing
 * of Derived before it reads the wave speeds of the updated volumes.
 */
template <typename Derived, typename StoragePrecision, typename ComputePrecision>
INLINE_METHOD GPU_CALLABLE_METHOD void
exahype2::fv::UpdatePatches<Derived, StoragePrecision, ComputePrecision>::operator()(
  const int                                             entry,
  [[maybe_unused]] const tarch::accelerator::TeamHandle team,
  double&                                               accumulator
) const {
  const int               slot = cells[entry];
  const StoragePrecision* faces[peano4::FacesPerCell];
  for (int faceNumber = 0; faceNumber < peano4::FacesPerCell; faceNumber++) {
    faces[faceNumber] = halo.getChunk(cellConnectivity.getCellFace(slot, faceNumber));
  }
  StoragePrecision* const                     patch         = solution.getChunk(slot);
  const tarch::la::Vector<DIMENSIONS, double> cellCentre    = cellConnectivity.getCellCentre(slot);
  const tarch::la::Vector<DIMENSIONS, double> cellSize      = cellConnectivity.getCellWidth(slot);
  const int                                   boundaryFaces = exahype2::fv::getBoundaryFaceMask(cellConnectivity, slot);
  const double                                stepStart     = timeStamp;
  const double                                stepSize      = timeStepSize;
  [[maybe_unused]] constexpr bool             PostprocessesPatch =
    exahype2::terms::HasPostprocessUpdatedPatch<Derived, StoragePrecision>;

  COMPILE_IF_ON_HOST(
    accumulator = exahype2::MaxEigenvalueReduction::combine(
      accumulator,
      Kernel::update(patch, patch, faces, cellCentre, cellSize, stepStart, stepSize, boundaryFaces)
    );
  )
  COMPILE_IF_ON_DEVICE(
    const tarch::accelerator::Custom<exahype2::MaxEigenvalueReduction> reducer{accumulator};
    const double                                                       partial =
      updatePatchOnDevice(team, patch, faces, cellCentre, cellSize, stepStart, stepSize, boundaryFaces);
    tarch::accelerator::reduceOverTeam(team, partial, reducer);
    if constexpr (PostprocessesPatch) {
      tarch::accelerator::teamBarrier(team);
      tarch::accelerator::parallelFor(team, tarch::accelerator::Range(1), [=]([[maybe_unused]] const int single) {
        Kernel::postprocessUpdatedPatch(patch, cellCentre, cellSize, stepStart, stepSize);
      });
      tarch::accelerator::teamBarrier(team);
      tarch::accelerator::parallelReduce(
        team,
        tarch::accelerator::Range(Kernel::VolumesPerPatch),
        [=](const int volume, double& eigenvalue) {
          eigenvalue = exahype2::MaxEigenvalueReduction::combine(
            eigenvalue,
            Kernel::getMaxEigenvalueOfVolume(volume, patch, cellCentre, cellSize, stepStart + stepSize, stepSize)
          );
        },
        reducer
      );
    }
  )
}

/**
 * Advances the patch in place with the team and returns the largest wave speed of the update that
 * the calling thread saw. Every thread reads the neighbours of its volumes from the team scratch
 * when the patch fits into it. A larger patch advances in rounds of one volume per thread that
 * write their updates Delay rounds late, after every round that reads those volumes.
 */
template <typename Derived, typename StoragePrecision, typename ComputePrecision>
INLINE_METHOD GPU_CALLABLE_METHOD double
exahype2::fv::UpdatePatches<Derived, StoragePrecision, ComputePrecision>::updatePatchOnDevice(
  [[maybe_unused]] const tarch::accelerator::TeamHandle         team,
  [[maybe_unused]] StoragePrecision* const                      patch,
  [[maybe_unused]] const StoragePrecision* const                faces[peano4::FacesPerCell],
  [[maybe_unused]] const tarch::la::Vector<DIMENSIONS, double>& cellCentre,
  [[maybe_unused]] const tarch::la::Vector<DIMENSIONS, double>& cellSize,
  [[maybe_unused]] const double                                 timeStamp,
  [[maybe_unused]] const double                                 timeStepSize,
  [[maybe_unused]] const int                                    boundaryFaces
) {
  [[maybe_unused]] constexpr bool PostprocessesPatch =
    exahype2::terms::HasPostprocessUpdatedPatch<Derived, StoragePrecision>;
  COMPILE_IF_ON_HOST(return 0.0;)
  COMPILE_IF_ON_DEVICE(
    constexpr int NumberOfData   = Kernel::NumberOfData;
    constexpr int PatchBytes     = Kernel::ValuesPerPatch * static_cast<int>(sizeof(StoragePrecision));
    constexpr int DefaultThreads = tarch::accelerator::DefaultThreadsPerTeam;
    const int     thread         = tarch::accelerator::getThreadOfTeam(team);
    const int     threads        = tarch::accelerator::getNumberOfThreadsPerTeam(team);
    assertion(threads >= DefaultThreads, threads, DefaultThreads);
    double partial = 0.0;
    if constexpr (PatchBytes <= tarch::accelerator::TeamScratchBytes) {
      auto* const staged = reinterpret_cast<StoragePrecision*>(tarch::accelerator::getTeamScratch(team));
      tarch::accelerator::parallelFor(team, tarch::accelerator::Range(Kernel::ValuesPerPatch), [=](const int value) {
        staged[value] = patch[value];
      });
      tarch::accelerator::teamBarrier(team);
      for (int volume = thread; volume < Kernel::VolumesPerPatch; volume += threads) {
        partial = exahype2::MaxEigenvalueReduction::combine(
          partial,
          Kernel::computeVolumeUpdate(
            volume,
            staged,
            faces,
            cellCentre,
            cellSize,
            timeStamp,
            timeStepSize,
            boundaryFaces,
            patch + static_cast<std::ptrdiff_t>(volume) * NumberOfData
          )
        );
        if constexpr (not PostprocessesPatch) {
          partial = exahype2::MaxEigenvalueReduction::combine(
            partial,
            Kernel::getMaxEigenvalueOfVolume(
              volume,
              patch,
              cellCentre,
              cellSize,
              timeStamp + timeStepSize,
              timeStepSize
            )
          );
        }
      }
      // The reduction of the team may run through the scratch. Every thread leaves it first.
      tarch::accelerator::teamBarrier(team);
    } else {
      // An update reads the states up to Reach volumes before and behind its volume.
      constexpr int Reach  = Kernel::HaloSize * Kernel::VolumesPerLayer;
      constexpr int Delay  = (Reach + DefaultThreads - 1) / DefaultThreads;
      constexpr int Slots  = Delay + 1;
      const int     rounds = (Kernel::VolumesPerPatch + threads - 1) / threads;

      StoragePrecision held[Slots][NumberOfData];
      for (int firstRound = 0; firstRound < rounds + Delay; firstRound += Slots) {
        const auto processRound = [&](const auto slotOfRound) {
          constexpr int Slot  = decltype(slotOfRound)::value;
          const int     round = firstRound + Slot;
          if (round >= rounds + Delay) {
            return;
          }
          const int computedVolume = round * threads + thread;
          if (round < rounds) {
            if (computedVolume < Kernel::VolumesPerPatch) {
              partial = exahype2::MaxEigenvalueReduction::combine(
                partial,
                Kernel::computeVolumeUpdate(
                  computedVolume,
                  patch,
                  faces,
                  cellCentre,
                  cellSize,
                  timeStamp,
                  timeStepSize,
                  boundaryFaces,
                  held[Slot]
                )
              );
            }
            tarch::accelerator::teamBarrier(team);
          }
          const int writtenVolume = (round - Delay) * threads + thread;
          if (round >= Delay and writtenVolume < Kernel::VolumesPerPatch) {
            StoragePrecision* const       target = patch + static_cast<std::ptrdiff_t>(writtenVolume) * NumberOfData;
            const StoragePrecision* const source = held[(Slot + 1) % Slots];
            for (int value = 0; value < NumberOfData; value++) {
              target[value] = source[value];
            }
            if constexpr (not PostprocessesPatch) {
              partial = exahype2::MaxEigenvalueReduction::combine(
                partial,
                Kernel::getMaxEigenvalueOfVolume(
                  writtenVolume,
                  patch,
                  cellCentre,
                  cellSize,
                  timeStamp + timeStepSize,
                  timeStepSize
                )
              );
            }
          }
        };
        [&]<int... Slot>(std::integer_sequence<int, Slot...>) {
          (processRound(std::integral_constant<int, Slot>{}), ...);
        }(std::make_integer_sequence<int, Slots>{});
      }
    } return partial;
  )
}

template <typename Derived, typename StoragePrecision, typename ComputePrecision>
INLINE_METHOD GPU_CALLABLE_METHOD void
exahype2::fv::MeasurePatchEigenvalues<Derived, StoragePrecision, ComputePrecision>::operator()(
  const int entry,
  double&   accumulator
) const {
  const int slot = cellConnectivity.getCells()[entry];
  accumulator    = exahype2::MaxEigenvalueReduction::combine(
    accumulator,
    Kernel::reduceMaxEigenvalue(
      solution.getChunk(slot),
      cellConnectivity.getCellCentre(slot),
      cellConnectivity.getCellWidth(slot),
      timeStamp
    )
  );
}

template <typename Derived, typename StoragePrecision, typename ComputePrecision>
INLINE_METHOD GPU_CALLABLE_METHOD void
exahype2::fv::MeasurePatchErrors<Derived, StoragePrecision, ComputePrecision>::operator()(const int entry) const {
  const int slot = cellConnectivity.getCells()[entry];
  Kernel::measureErrors(
    solution.getChunk(slot),
    cellConnectivity.getCellCentre(slot),
    cellConnectivity.getCellWidth(slot),
    timeStamp,
    timeStepSize,
    errorsPerCell + static_cast<std::ptrdiff_t>(entry) * NumberOfNorms
  );
}

template <typename Derived, typename StoragePrecision, typename ComputePrecision>
INLINE_METHOD GPU_CALLABLE_METHOD void
exahype2::fv::PatchTransfer<Derived, StoragePrecision, ComputePrecision>::copy(
  const int               slot,
  StoragePrecision* const target
) const {
  const StoragePrecision* const kept = source.getChunk(slot);
  for (int value = 0; value < Kernel::ValuesPerPatch; value++) {
    target[value] = kept[value];
  }
}

template <typename Derived, typename StoragePrecision, typename ComputePrecision>
INLINE_METHOD GPU_CALLABLE_METHOD void
exahype2::fv::PatchTransfer<Derived, StoragePrecision, ComputePrecision>::interpolateFromParent(
  const int               parentSlot,
  StoragePrecision* const target,
  const int               childPosition
) const {
  Kernel::interpolatePatch(source.getChunk(parentSlot), target, childPosition);
}

template <typename Derived, typename StoragePrecision, typename ComputePrecision>
INLINE_METHOD GPU_CALLABLE_METHOD void
exahype2::fv::PatchTransfer<Derived, StoragePrecision, ComputePrecision>::restrictFromChildren(
  const int* const        childSlots,
  StoragePrecision* const target
) const {
  const StoragePrecision* children[peano4::ChildrenPerCell];
  for (int child = 0; child < peano4::ChildrenPerCell; child++) {
    children[child] = source.getChunk(childSlots[child]);
  }
  Kernel::restrictPatch(children, target);
}
TARGET_DECLARE_END
