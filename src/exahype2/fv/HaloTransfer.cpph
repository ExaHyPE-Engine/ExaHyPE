template <typename T>
INLINE_METHOD exahype2::fv::FaceHaloInterpolation<T>::FaceHaloInterpolation(
  const int numberOfDofsPerAxis,
  const int numberOfUnknowns
) :
  _numberOfDofsPerAxis(numberOfDofsPerAxis),
  _numberOfUnknowns(numberOfUnknowns) {}

template <typename T>
INLINE_METHOD void exahype2::fv::FaceHaloInterpolation<T>::operator()(
  const peano4::dataview::FaceMarker& marker,
  const T* NOALIAS                    coarseFaceValues,
  T* NOALIAS                          fineFaceValues,
  const int                           side
) const {
  exahype2::amr::interpolateHaloLayerWithTangentialSlope(
    marker,
    coarseFaceValues,
    fineFaceValues,
    side,
    _numberOfDofsPerAxis,
    _numberOfUnknowns
  );
}

template <typename T>
INLINE_METHOD exahype2::fv::FaceHaloRestriction<T>::FaceHaloRestriction(
  const int normal,
  const int numberOfDofsPerAxis,
  const int numberOfUnknowns
) :
  _normal(normal),
  _numberOfDofsPerAxis(numberOfDofsPerAxis),
  _numberOfUnknowns(numberOfUnknowns) {}

template <typename T>
INLINE_METHOD void exahype2::fv::FaceHaloRestriction<T>::operator()(
  exahype2::amr::ChildDataStage<T>& stage,
  const void* const                 coarseFaceKey,
  T* const                          coarseFaceValues
) const {
  exahype2::amr::restrictHaloLayerFromStagedSubfaces(
    stage,
    coarseFaceKey,
    coarseFaceValues,
    _normal,
    _numberOfDofsPerAxis,
    _numberOfUnknowns
  );
}
