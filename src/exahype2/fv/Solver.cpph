#include "exahype2/LevelJumps.h"
#include "exahype2/fv/Kernels.h"
#include "exahype2/terms/InitialisesOnHost.h"
#include "exahype2/terms/MaxEigenvalue.h"
#include "exahype2/terms/MeasuredUnknowns.h"
#include "tarch/Assertions.h"
#include "tarch/MemoryUsage.h"
#include "tarch/accelerator/ParallelFor.h"
#include "tarch/accelerator/ParallelReduce.h"
#include "tarch/accelerator/Range.h"
#include "tarch/accelerator/Reducer.h"

/**
 * timeStepFactor is the CFL relaxation of an adaptive rule or the normalised time step size of a
 * fixed one.
 */
template <typename Derived, typename StoragePrecision, typename ComputePrecision>
INLINE_METHOD exahype2::fv::Solver<Derived, StoragePrecision, ComputePrecision>::Solver(
  const double                              timeStepFactor,
  std::string                               name,
  std::vector<exahype2::plotter::DataField> plottedFields
) :
  _timeStepping{Derived::TimeSteppingRule, timeStepFactor, exahype2::TimeStepping::Stability::PhysicalEigenvalue},
  _plotter(std::move(name), std::move(plottedFields)) {
  static_assert(exahype2::fv::ReconstructionScheme<typename Derived::Reconstruction>);
  static_assert(exahype2::fv::TimeSteppingScheme<typename Derived::TimeIntegration>);
}

template <typename Derived, typename StoragePrecision, typename ComputePrecision>
INLINE_METHOD void
exahype2::fv::Solver<Derived, StoragePrecision, ComputePrecision>::requestRefinementForGridConstruction(
  const peano4::Partition&      partition,
  exahype2::RefinementRequests& requests
) {
  _votes.voteOnGridConstruction<Derived, StoragePrecision>(partition, _timeStepping.getLimits(), requests);
}

/**
 * Reserves the pools for the partition and rebuilds the halo exchange. Every rank calls this
 * function collectively, so the exchanges get the same tags on every rank.
 */
template <typename Derived, typename StoragePrecision, typename ComputePrecision>
INLINE_METHOD void
exahype2::fv::Solver<Derived, StoragePrecision, ComputePrecision>::allocate(const peano4::Partition& partition) {
  _solution.reserve(partition.getNumberOfSlots());
  _previousSolution.reserve(partition.getNumberOfSlots());
  _halo.reserve(partition.getNumberOfFaces());
  _haloExchange.rebuild(partition);
  reduceMeshWidths(partition);
}

template <typename Derived, typename StoragePrecision, typename ComputePrecision>
INLINE_METHOD void
exahype2::fv::Solver<Derived, StoragePrecision, ComputePrecision>::initialise(
  const peano4::Partition&      partition,
  exahype2::RefinementRequests& requests
) {
  if constexpr (exahype2::terms::InitialisesOnHost<Derived>) {
    _solution.copyToHost(_solutionOnHost);
    const auto valuesPerSlot = static_cast<std::size_t>(_solution.getPaddedChunkSize());
    const auto cells         = partition.getCells();
    tarch::accelerator::parallelForOnHost(tarch::accelerator::Range(cells.size), [&](const int entry) {
      const int slot = cells[entry];
      FiniteVolume::initialise(
        _solutionOnHost.data() + static_cast<std::size_t>(slot) * valuesPerSlot,
        partition.getCellCentre(slot),
        partition.getCellWidth(slot)
      );
    });
    _solution.copyFromHost(_solutionOnHost);
  } else {
    tarch::accelerator::parallelFor(
      tarch::accelerator::Range(partition.getCells().size),
      exahype2::fv::InitialisePatches<Derived, StoragePrecision, ComputePrecision>{
        partition.onDevice(),
        _solution.getView()
      }
    );
  }

  projectOntoFaces(partition);
  exahype2::restrictFineFaces(
    partition,
    exahype2::fv::RestrictHaloHalves<Derived, StoragePrecision, ComputePrecision>{partition.onDevice(), _halo.getView()}
  );
  reduceMeshWidths(partition);
  measureError(partition);
  _votes.voteOnEveryCell<Derived>(
    partition,
    std::as_const(_solution).getView(),
    _timeStepping.getLimits(),
    _timeStepping.getTimeStamp(),
    requests
  );
}

/**
 * Advances every patch by one time step. The local cells update while the halo exchange runs, and
 * the remote cells update after it.
 */
template <typename Derived, typename StoragePrecision, typename ComputePrecision>
INLINE_METHOD void
exahype2::fv::Solver<Derived, StoragePrecision, ComputePrecision>::performTimeStep(
  const peano4::Partition&      partition,
  exahype2::RefinementRequests& requests
) {
  const double timeStepSize = _timeStepping.startTimeStep();
  const exahype2::fv::InterpolateHaloHalves<Derived, StoragePrecision, ComputePrecision> interpolateHalo{
    partition.onDevice(),
    _halo.getView()
  };

  _haloExchange.post();
  applyBoundaryConditions(partition);
  exahype2::interpolateCoarseFaces(partition, peano4::Adjacency::Local, interpolateHalo);
  double maxEigenvalue = updatePatches(partition, peano4::Adjacency::Local, timeStepSize);
  _haloExchange.wait();
  exahype2::interpolateCoarseFaces(partition, peano4::Adjacency::Remote, interpolateHalo);
  maxEigenvalue = exahype2::MaxEigenvalueReduction::combine(
    maxEigenvalue,
    updatePatches(partition, peano4::Adjacency::Remote, timeStepSize)
  );
  std::swap(_solution, _previousSolution);

  projectOntoFaces(partition);
  exahype2::restrictFineFaces(
    partition,
    exahype2::fv::RestrictHaloHalves<Derived, StoragePrecision, ComputePrecision>{partition.onDevice(), _halo.getView()}
  );

  _timeStepping.advanceTimeStamp(timeStepSize);
  reduceMeshWidths(partition);
  proposeTimeStepSize(maxEigenvalue);
  measureError(partition);
  if (_meshChangedSinceLastTimeStep) {
    _meshChangedSinceLastTimeStep = false;
  } else {
    _votes.voteOnEveryCell<Derived>(
      partition,
      std::as_const(_solution).getView(),
      _timeStepping.getLimits(),
      _timeStepping.getTimeStamp(),
      requests
    );
  }
}

/**
 * Moves the patches to their new slots and ranks and fills new patches from their parents or
 * children. Only the cells the regrid created vote on the refinement.
 */
template <typename Derived, typename StoragePrecision, typename ComputePrecision>
INLINE_METHOD void
exahype2::fv::Solver<Derived, StoragePrecision, ComputePrecision>::regrid(
  const peano4::Partition&      partition,
  const peano4::Regrid&         regrid,
  exahype2::RefinementRequests& requests
) {
  assertion(regrid.newNumberOfSlots >= regrid.oldNumberOfSlots, regrid.newNumberOfSlots, regrid.oldNumberOfSlots);
  _solution.reserve(regrid.newNumberOfSlots);
  _previousSolution.reserve(regrid.newNumberOfSlots);
  _migration.migrate(
    _solution,
    regrid,
    exahype2::fv::PatchTransfer<Derived, StoragePrecision, ComputePrecision>{std::as_const(_solution).getView()}
  );

  _halo.reserve(partition.getNumberOfFaces());
  _haloExchange.rebuild(partition);
  projectOntoFaces(partition);
  exahype2::restrictFineFaces(
    partition,
    exahype2::fv::RestrictHaloHalves<Derived, StoragePrecision, ComputePrecision>{partition.onDevice(), _halo.getView()}
  );

  reduceMeshWidths(partition);
  if (_timeStepping.getTimeStepSizeOfNextStep() > 0.0) {
    proposeTimeStepSize(measureMaxEigenvalue(partition));
  }
  _meshChangedSinceLastTimeStep = true;
  _votes.voteOnCells<Derived>(
    partition,
    regrid.createdSlots,
    std::as_const(_solution).getView(),
    _timeStepping.getLimits(),
    _timeStepping.getTimeStamp(),
    requests
  );
}

/**
 * Writes one snapshot of the solution. Every rank calls this function collectively.
 */
template <typename Derived, typename StoragePrecision, typename ComputePrecision>
INLINE_METHOD void
exahype2::fv::Solver<Derived, StoragePrecision, ComputePrecision>::plot(
  const peano4::Partition&     partition,
  const tarch::plotter::Format format,
  const std::string&           outputDirectory
) {
  _solution.copyToHost(_solutionOnHost);
  _plotter.template plotVolumes<Derived::PatchSize, Derived::NumberOfUnknowns + Derived::NumberOfAuxiliaryVariables>(
    partition,
    partition.getCells(),
    _solutionOnHost.data(),
    _solution.getPaddedChunkSize(),
    _timeStepping.getTimeStamp(),
    format,
    outputDirectory
  );
}

/**
 * Frees every buffer of the solver, so no device buffer outlives the accelerator runtime.
 */
template <typename Derived, typename StoragePrecision, typename ComputePrecision>
INLINE_METHOD void
exahype2::fv::Solver<Derived, StoragePrecision, ComputePrecision>::release() {
  _solution.release();
  _previousSolution.release();
  _halo.release();
  _haloExchange.release();
  _migration.release();
  _votes.release();
  _errorMeasurement.release();
  _solutionOnHost = std::vector<StoragePrecision>{};
}

template <typename Derived, typename StoragePrecision, typename ComputePrecision>
INLINE_METHOD void
exahype2::fv::Solver<Derived, StoragePrecision, ComputePrecision>::setLimits(const exahype2::Limits& limits) {
  _timeStepping.setLimits(limits);
}

template <typename Derived, typename StoragePrecision, typename ComputePrecision>
INLINE_METHOD void
exahype2::fv::Solver<Derived, StoragePrecision, ComputePrecision>::openErrorMeasurement(
  const std::string& fileName,
  const double       timeDeltaBetweenSnapshots
) {
  static_assert(exahype2::terms::HasMeasuredUnknowns<Derived>, "An error measurement needs the measured unknowns.");
  _errorMeasurement.open(fileName, timeDeltaBetweenSnapshots);
}

template <typename Derived, typename StoragePrecision, typename ComputePrecision>
INLINE_METHOD const exahype2::TimeStepping&
exahype2::fv::Solver<Derived, StoragePrecision, ComputePrecision>::getTimeStepping() const {
  return _timeStepping;
}

template <typename Derived, typename StoragePrecision, typename ComputePrecision>
INLINE_METHOD const typename exahype2::fv::Solver<Derived, StoragePrecision, ComputePrecision>::Patches&
exahype2::fv::Solver<Derived, StoragePrecision, ComputePrecision>::getSolution() const {
  return _solution;
}

/**
 * Returns the solution the last time step read. It stays valid until the next time step swaps the
 * pools.
 */
template <typename Derived, typename StoragePrecision, typename ComputePrecision>
INLINE_METHOD const typename exahype2::fv::Solver<Derived, StoragePrecision, ComputePrecision>::Patches&
exahype2::fv::Solver<Derived, StoragePrecision, ComputePrecision>::getPreviousSolution() const {
  return _previousSolution;
}

template <typename Derived, typename StoragePrecision, typename ComputePrecision>
INLINE_METHOD tarch::AllocatedBytes
exahype2::fv::Solver<Derived, StoragePrecision, ComputePrecision>::getAllocatedBytes() const {
  return _solution.getAllocatedBytes() + _previousSolution.getAllocatedBytes() + _halo.getAllocatedBytes()
    + _haloExchange.getAllocatedBytes() + _migration.getAllocatedBytes() + _votes.getAllocatedBytes()
    + _errorMeasurement.getAllocatedBytes()
    + tarch::AllocatedBytes::onHost(tarch::getAllocatedBytesOf(_solutionOnHost));
}

/**
 * Returns the number of values in one patch.
 */
template <typename Derived, typename StoragePrecision, typename ComputePrecision>
INLINE_METHOD int
exahype2::fv::Solver<Derived, StoragePrecision, ComputePrecision>::getNumberOfDoFs() const {
  return _solution.getChunkSize();
}

template <typename Derived, typename StoragePrecision, typename ComputePrecision>
INLINE_METHOD void
exahype2::fv::Solver<Derived, StoragePrecision, ComputePrecision>::applyBoundaryConditions(
  const peano4::Partition& partition
) {
  const auto boundaryFaces = partition.onDevice().getFaces(peano4::Adjacency::Local, peano4::FaceKind::Boundary);
  tarch::accelerator::parallelFor(
    tarch::accelerator::Range(boundaryFaces.size),
    exahype2::fv::ApplyBoundaryConditions<Derived, StoragePrecision, ComputePrecision>{
      partition.onDevice(),
      boundaryFaces,
      _halo.getView(),
      _timeStepping.getTimeStamp()
    }
  );
}

template <typename Derived, typename StoragePrecision, typename ComputePrecision>
INLINE_METHOD void
exahype2::fv::Solver<Derived, StoragePrecision, ComputePrecision>::projectOntoFaces(
  const peano4::Partition& partition
) {
  tarch::accelerator::parallelFor(
    tarch::accelerator::Range(partition.getCells().size),
    exahype2::fv::ProjectPatchesOntoFaces<Derived, StoragePrecision, ComputePrecision>{
      partition.onDevice(),
      std::as_const(_solution).getView(),
      _halo.getView()
    }
  );
}

/**
 * Writes the next state of the local or the remote cells into the previous solution and returns
 * their largest wave speed.
 */
template <typename Derived, typename StoragePrecision, typename ComputePrecision>
INLINE_METHOD double
exahype2::fv::Solver<Derived, StoragePrecision, ComputePrecision>::updatePatches(
  const peano4::Partition& partition,
  const peano4::Adjacency  adjacency,
  const double             timeStepSize
) {
  const auto cells         = partition.onDevice().getCells(adjacency);
  double     maxEigenvalue = 0.0;
  tarch::accelerator::parallelReduce(
    tarch::accelerator::Range(cells.size),
    exahype2::fv::UpdatePatches<Derived, StoragePrecision, ComputePrecision>{
      partition.onDevice(),
      cells,
      std::as_const(_solution).getView(),
      _previousSolution.getView(),
      std::as_const(_halo).getView(),
      _timeStepping.getTimeStamp(),
      timeStepSize
    },
    tarch::accelerator::Custom<exahype2::MaxEigenvalueReduction>{maxEigenvalue}
  );
  return maxEigenvalue;
}

/**
 * Returns the largest wave speed over the volumes of the solution, or zero for a fixed rule or a
 * Derived without maxEigenvalue().
 */
template <typename Derived, typename StoragePrecision, typename ComputePrecision>
INLINE_METHOD double
exahype2::fv::Solver<Derived, StoragePrecision, ComputePrecision>::measureMaxEigenvalue(
  const peano4::Partition& partition
) {
  if constexpr (
    Derived::TimeSteppingRule == exahype2::TimeStepping::Rule::Adaptive
    and exahype2::terms::HasMaxEigenvalue<Derived, ComputePrecision>
  ) {
    double maxEigenvalue = 0.0;
    tarch::accelerator::parallelReduce(
      tarch::accelerator::Range(partition.getCells().size),
      exahype2::fv::MeasurePatchEigenvalues<Derived, StoragePrecision, ComputePrecision>{
        partition.onDevice(),
        std::as_const(_solution).getView(),
        _timeStepping.getTimeStamp()
      },
      tarch::accelerator::Custom<exahype2::MaxEigenvalueReduction>{maxEigenvalue}
    );
    return maxEigenvalue;
  } else {
    return 0.0;
  }
}

template <typename Derived, typename StoragePrecision, typename ComputePrecision>
INLINE_METHOD void
exahype2::fv::Solver<Derived, StoragePrecision, ComputePrecision>::measureError(const peano4::Partition& partition) {
  if constexpr (exahype2::terms::HasMeasuredUnknowns<Derived>) {
    const double timeStamp = _timeStepping.getTimeStamp();
    if (not _errorMeasurement.isSnapshotDue(timeStamp)) {
      return;
    }
    const int numberOfCells = partition.getCells().size;
    tarch::accelerator::parallelFor(
      tarch::accelerator::Range(numberOfCells),
      exahype2::fv::MeasurePatchErrors<Derived, StoragePrecision, ComputePrecision>{
        partition.onDevice(),
        std::as_const(_solution).getView(),
        _errorMeasurement.getErrorsPerCell(numberOfCells),
        timeStamp,
        _timeStepping.getTimeStepSizeOfLastStep()
      }
    );
    _errorMeasurement.record(numberOfCells, timeStamp);
  }
}

template <typename Derived, typename StoragePrecision, typename ComputePrecision>
INLINE_METHOD void
exahype2::fv::Solver<Derived, StoragePrecision, ComputePrecision>::reduceMeshWidths(
  const peano4::Partition& partition
) {
  double minimum = std::numeric_limits<double>::infinity();
  double maximum = 0.0;
  if (not partition.getCells().isEmpty()) {
    for (int axis = 0; axis < DIMENSIONS; axis++) {
      minimum = std::min(minimum, partition.getWidthOfLevel(partition.getMaximumLevel(), axis) / Derived::PatchSize);
      maximum = std::max(maximum, partition.getWidthOfLevel(partition.getMinimumLevel(), axis) / Derived::PatchSize);
    }
  }
  _timeStepping.reduceMeshWidthsAcrossRanks(minimum, maximum);
}

template <typename Derived, typename StoragePrecision, typename ComputePrecision>
INLINE_METHOD void
exahype2::fv::Solver<Derived, StoragePrecision, ComputePrecision>::proposeTimeStepSize(const double maxEigenvalue) {
  if constexpr (Derived::TimeSteppingRule == exahype2::TimeStepping::Rule::Adaptive) {
    _timeStepping.raiseMaxEigenvalue(maxEigenvalue);
    _timeStepping.reduceMaxEigenvaluesAcrossRanks();
    if (
      _timeStepping.hasPositiveStabilityEigenvalue()
      and _timeStepping.getTimeStamp() < _timeStepping.getLimits().terminalTime
    ) {
      _timeStepping.setAdmissibleTimeStepSize(
        _timeStepping.getFactor() * _timeStepping.getMinMeshWidth()
        / (DIMENSIONS * _timeStepping.getMaxEigenvalueOfThisStep())
      );
    }
  } else {
    const double maxAdmissibleMeshWidth = _timeStepping.getLimits().maxAdmissibleMeshWidth;
    assertion(std::isfinite(maxAdmissibleMeshWidth) and maxAdmissibleMeshWidth > 0.0, maxAdmissibleMeshWidth);
    _timeStepping.setFixedTimeStepSize(
      _timeStepping.getFactor() * _timeStepping.getMinMeshWidth() / maxAdmissibleMeshWidth
    );
  }
}
