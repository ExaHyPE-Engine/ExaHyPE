#include "exahype2/LevelJumps.h"
#include "exahype2/fv/Kernels.h"
#include "exahype2/terms/MaxEigenvalue.h"
#include "exahype2/terms/MeasuredUnknowns.h"
#include "tarch/Assertions.h"
#include "tarch/MemoryUsage.h"
#include "tarch/accelerator/ParallelFor.h"
#include "tarch/accelerator/ParallelReduce.h"
#include "tarch/accelerator/Range.h"
#include "tarch/accelerator/Reducer.h"
#include "tarch/database/SnapshotDatabase.h"

/**
 * The factor timeStepFactor is the CFL relaxation of an adaptive rule or the normalised time step
 * size of a fixed one. The arguments name and plottedFields describe the plot files.
 */
template <typename Derived, typename StoragePrecision, typename ComputePrecision>
INLINE_METHOD exahype2::fv::Solver<Derived, StoragePrecision, ComputePrecision>::Solver(
  const double                              timeStepFactor,
  std::string                               name,
  std::vector<exahype2::plotter::DataField> plottedFields
) :
  _timeStepping{Derived::TimeSteppingRule, timeStepFactor, exahype2::TimeStepping::Stability::PhysicalEigenvalue},
  _plotter(std::move(name), std::move(plottedFields)) {
  static_assert(exahype2::fv::ReconstructionScheme<typename Derived::Reconstruction>);
  static_assert(exahype2::fv::TimeSteppingScheme<typename Derived::TimeIntegration>);
}

template <typename Derived, typename StoragePrecision, typename ComputePrecision>
template <typename RuntimeParameters>
INLINE_METHOD void
exahype2::fv::Solver<Derived, StoragePrecision, ComputePrecision>::requestRefinementForGridConstruction(
  const peano4::CellConnectivity& cellConnectivity,
  exahype2::RefinementRequests&   requests,
  const RuntimeParameters&        parameters
) {
  _votes.voteOnGridConstruction<Derived, StoragePrecision>(
    cellConnectivity,
    _timeStepping.getLimits(),
    requests,
    parameters
  );
}

/**
 * Reserves the pools for the slots and faces of cellConnectivity and builds the halo exchange.
 * Every rank calls this at the same time. The exchanges of every solver then take the same tags.
 */
template <typename Derived, typename StoragePrecision, typename ComputePrecision>
template <typename RuntimeParameters>
INLINE_METHOD void
exahype2::fv::Solver<Derived, StoragePrecision, ComputePrecision>::allocate(
  const peano4::CellConnectivity&           cellConnectivity,
  [[maybe_unused]] const RuntimeParameters& parameters
) {
  _solution.reserve(cellConnectivity.getNumberOfSlots());
  _halo.reserve(cellConnectivity.getNumberOfFaces());
  _auxVarsHalo.reserve(cellConnectivity.getNumberOfFaces());
  _haloExchange.rebuild(cellConnectivity);
  _auxVarsHaloExchange.rebuild(cellConnectivity);
  measureMeshWidths(cellConnectivity);
}

/**
 * Writes the initial condition of Derived on the host into every patch, fills the faces and votes
 * on the refinement.
 */
template <typename Derived, typename StoragePrecision, typename ComputePrecision>
template <typename RuntimeParameters>
INLINE_METHOD void
exahype2::fv::Solver<Derived, StoragePrecision, ComputePrecision>::initialise(
  const peano4::CellConnectivity& cellConnectivity,
  exahype2::RefinementRequests&   requests,
  const RuntimeParameters&        parameters
) {
  Patches    copyOnHost{FiniteVolumeScheme::ValuesPerPatch, tarch::MemoryLocation::Heap};
  Patches&   patches = _solution.download(copyOnHost);
  const auto cells   = cellConnectivity.getCells();
  tarch::accelerator::parallelForOnHost(tarch::accelerator::Range(cells.size), [&](const int entry) {
    const int slot = cells[entry];
    FiniteVolumeScheme::initialise(
      patches.getChunk(slot),
      cellConnectivity.getCellCentre(slot),
      cellConnectivity.getCellWidth(slot),
      parameters
    );
  });
  _solution.upload(patches);

  if constexpr (FiniteVolumeScheme::NumberOfAuxiliaryVariables){
    projectAuxVarsOntoFaces(cellConnectivity);
    exahype2::restrictFineFaces(
      cellConnectivity,
      exahype2::fv::RestrictAuxVarsHaloHalves<Derived, StoragePrecision, ComputePrecision>{
        cellConnectivity.onDevice(),
        _auxVarsHalo.getView()
      }
    );
    _auxVarsHaloExchange.post();
  }

  projectUnknownsOntoFaces(cellConnectivity);
  exahype2::restrictFineFaces(
    cellConnectivity,
    exahype2::fv::RestrictHaloHalves<Derived, StoragePrecision, ComputePrecision>{
      cellConnectivity.onDevice(),
      _halo.getView()
    }
  );

  if constexpr (FiniteVolumeScheme::NumberOfAuxiliaryVariables){
    const exahype2::fv::InterpolateAuxVarsHaloHalves<Derived, StoragePrecision, ComputePrecision> interpolateAuxVarsHalo{
      cellConnectivity.onDevice(),
      _auxVarsHalo.getView()
    };
    exahype2::interpolateCoarseFaces(cellConnectivity, peano4::Adjacency::Local, interpolateAuxVarsHalo);
    _auxVarsHaloExchange.wait();
    exahype2::interpolateCoarseFaces(cellConnectivity, peano4::Adjacency::Remote, interpolateAuxVarsHalo);
  }

  measureMeshWidths(cellConnectivity);
  measureError(cellConnectivity, parameters);
  _votes.voteOnEveryCell<Derived>(
    cellConnectivity,
    std::as_const(_solution).getView(),
    _timeStepping.getLimits(),
    _timeStepping.getTimeStamp(),
    requests,
    parameters
  );
}

/**
 * Advances every patch in place by the time step size the previous step admitted. The local
 * patches update while the own halves of the exchanged faces travel. The patches beside a rank
 * boundary update once the halves of the neighbour ranks arrive.
 */
template <typename Derived, typename StoragePrecision, typename ComputePrecision>
template <typename RuntimeParameters>
INLINE_METHOD void
exahype2::fv::Solver<Derived, StoragePrecision, ComputePrecision>::performTimeStep(
  const peano4::CellConnectivity& cellConnectivity,
  exahype2::RefinementRequests&   requests,
  const RuntimeParameters&        parameters
) {
  const double timeStepSize = _timeStepping.startTimeStep();
  const exahype2::fv::InterpolateHaloHalves<Derived, StoragePrecision, ComputePrecision> interpolateHalo{
    cellConnectivity.onDevice(),
    _halo.getView()
  };

  _haloExchange.post();
  applyBoundaryConditions(cellConnectivity, parameters);
  exahype2::interpolateCoarseFaces(cellConnectivity, peano4::Adjacency::Local, interpolateHalo);
  double maxEigenvalue = updatePatches(cellConnectivity, peano4::Adjacency::Local, timeStepSize, parameters);
  _haloExchange.wait();
  exahype2::interpolateCoarseFaces(cellConnectivity, peano4::Adjacency::Remote, interpolateHalo);
  maxEigenvalue = exahype2::MaxEigenvalueReduction::combine(
    maxEigenvalue,
    updatePatches(cellConnectivity, peano4::Adjacency::Remote, timeStepSize, parameters)
  );

  projectUnknownsOntoFaces(cellConnectivity);
  exahype2::restrictFineFaces(
    cellConnectivity,
    exahype2::fv::RestrictHaloHalves<Derived, StoragePrecision, ComputePrecision>{
      cellConnectivity.onDevice(),
      _halo.getView()
    }
  );

  _timeStepping.advanceTimeStamp(timeStepSize);
  proposeTimeStepSize(maxEigenvalue);
  measureError(cellConnectivity, parameters);
  if (_meshChangedSinceLastTimeStep) {
    _meshChangedSinceLastTimeStep = false;
  } else {
    _votes.voteOnEveryCell<Derived>(
      cellConnectivity,
      std::as_const(_solution).getView(),
      _timeStepping.getLimits(),
      _timeStepping.getTimeStamp(),
      requests,
      parameters
    );
  }
}

/**
 * Moves the patches of the solution through the slot moves of a regrid. A new child takes its
 * patch from its parent and a new parent from its children. The patches that change rank travel
 * in _migration.
 */
template <typename Derived, typename StoragePrecision, typename ComputePrecision>
template <typename RuntimeParameters>
INLINE_METHOD void
exahype2::fv::Solver<Derived, StoragePrecision, ComputePrecision>::regrid(
  const peano4::CellConnectivity& cellConnectivity,
  const peano4::Regrid&           regrid,
  exahype2::RefinementRequests&   requests,
  const RuntimeParameters&        parameters
) {
  ASSERTION(regrid.newNumberOfSlots >= regrid.oldNumberOfSlots, regrid.newNumberOfSlots, regrid.oldNumberOfSlots);
  _solution.reserve(regrid.newNumberOfSlots);
  _migration.migrate(
    _solution,
    regrid,
    exahype2::fv::PatchTransfer<Derived, StoragePrecision, ComputePrecision>{std::as_const(_solution).getView()}
  );

  _auxVarsHalo.reserve(cellConnectivity.getNumberOfFaces());
  _auxVarsHaloExchange.rebuild(cellConnectivity);
  if constexpr (FiniteVolumeScheme::NumberOfAuxiliaryVariables){
    projectAuxVarsOntoFaces(cellConnectivity);
    exahype2::restrictFineFaces(
      cellConnectivity,
      exahype2::fv::RestrictAuxVarsHaloHalves<Derived, StoragePrecision, ComputePrecision>{
        cellConnectivity.onDevice(),
        _auxVarsHalo.getView()
      }
    );

    _auxVarsHaloExchange.post();
  }


  _halo.reserve(cellConnectivity.getNumberOfFaces());
  _haloExchange.rebuild(cellConnectivity);
  projectUnknownsOntoFaces(cellConnectivity);
  exahype2::restrictFineFaces(
    cellConnectivity,
    exahype2::fv::RestrictHaloHalves<Derived, StoragePrecision, ComputePrecision>{
      cellConnectivity.onDevice(),
      _halo.getView()
    }
  );

  if constexpr (FiniteVolumeScheme::NumberOfAuxiliaryVariables){
    const exahype2::fv::InterpolateAuxVarsHaloHalves<Derived, StoragePrecision, ComputePrecision> interpolateAuxVarsHalo{
      cellConnectivity.onDevice(),
      _auxVarsHalo.getView()
    };
    exahype2::interpolateCoarseFaces(cellConnectivity, peano4::Adjacency::Local, interpolateAuxVarsHalo);
    _auxVarsHaloExchange.wait();
    exahype2::interpolateCoarseFaces(cellConnectivity, peano4::Adjacency::Remote, interpolateAuxVarsHalo);
  }

  measureMeshWidths(cellConnectivity);
  if constexpr (Derived::TimeSteppingRule == exahype2::TimeStepping::Rule::Adaptive) {
    if (_timeStepping.getTimeStepSizeOfNextStep() > 0.0) {
      _timeStepping.raiseMaxEigenvalue(measureMaxEigenvalue(cellConnectivity, parameters));
    }
  }
  _meshChangedSinceLastTimeStep = true;
  _votes.voteOnCells<Derived>(
    cellConnectivity,
    regrid.createdSlots,
    std::as_const(_solution).getView(),
    _timeStepping.getLimits(),
    _timeStepping.getTimeStamp(),
    requests,
    parameters
  );
}

/**
 * Writes one snapshot of the solution. Every rank calls this at the same time. In a build with a
 * GPU backend the plot reads a copy of the solution in _solutionOnHost.
 */
template <typename Derived, typename StoragePrecision, typename ComputePrecision>
template <typename RuntimeParameters>
INLINE_METHOD void
exahype2::fv::Solver<Derived, StoragePrecision, ComputePrecision>::plot(
  const peano4::CellConnectivity&           cellConnectivity,
  const tarch::plotter::Format              format,
  const std::string&                        outputDirectory,
  [[maybe_unused]] const RuntimeParameters& parameters
) {
  _plotter.template plotVolumes<Derived::PatchSize, Derived::NumberOfUnknowns + Derived::NumberOfAuxiliaryVariables>(
    cellConnectivity,
    cellConnectivity.getCells(),
    std::as_const(_solution).download(_solutionOnHost),
    _timeStepping.getTimeStamp(),
    format,
    outputDirectory
  );
}

/**
 * Frees the pools, the exchanges and every device buffer.
 */
template <typename Derived, typename StoragePrecision, typename ComputePrecision>
INLINE_METHOD void
exahype2::fv::Solver<Derived, StoragePrecision, ComputePrecision>::release() {
  _solution.release();
  _halo.release();
  _auxVarsHalo.release();
  _haloExchange.release();
  _auxVarsHaloExchange.release();
  _migration.release();
  _votes.release();
  _errorMeasurement.release();
  _solutionOnHost.release();
}

template <typename Derived, typename StoragePrecision, typename ComputePrecision>
INLINE_METHOD void
exahype2::fv::Solver<Derived, StoragePrecision, ComputePrecision>::setLimits(const exahype2::Limits& limits) {
  _timeStepping.setLimits(limits);
}

template <typename Derived, typename StoragePrecision, typename ComputePrecision>
INLINE_METHOD void
exahype2::fv::Solver<Derived, StoragePrecision, ComputePrecision>::openErrorMeasurement(
  const std::string& fileName,
  const double       timeDeltaBetweenSnapshots
) {
  static_assert(
    exahype2::terms::HasMeasuredUnknowns<Derived>,
    "The error measurement of the solver expects an analytical solution and the unknowns to measure."
  );
  _errorMeasurement.open(fileName, timeDeltaBetweenSnapshots);
}

/**
 * Records the error norms at the last time stamp of a run. The time loop calls it once after its
 * last time step.
 */
template <typename Derived, typename StoragePrecision, typename ComputePrecision>
template <typename RuntimeParameters>
INLINE_METHOD void
exahype2::fv::Solver<Derived, StoragePrecision, ComputePrecision>::recordLastTimeStamp(
  const peano4::CellConnectivity& cellConnectivity,
  const RuntimeParameters&        parameters
) {
  _errorMeasurement.setSnapshotRule(tarch::database::SnapshotRule::EveryLaterTimestamp);
  measureError(cellConnectivity, parameters);
}

template <typename Derived, typename StoragePrecision, typename ComputePrecision>
INLINE_METHOD const exahype2::TimeStepping&
exahype2::fv::Solver<Derived, StoragePrecision, ComputePrecision>::getTimeStepping() const {
  return _timeStepping;
}

template <typename Derived, typename StoragePrecision, typename ComputePrecision>
INLINE_METHOD const typename exahype2::fv::Solver<Derived, StoragePrecision, ComputePrecision>::Patches&
exahype2::fv::Solver<Derived, StoragePrecision, ComputePrecision>::getSolution() const {
  return _solution;
}

/**
 * Returns the bytes of the pools, the exchanges and the copy of the solution that a plot in a build
 * with a GPU backend reads.
 */
template <typename Derived, typename StoragePrecision, typename ComputePrecision>
INLINE_METHOD tarch::AllocatedBytes
exahype2::fv::Solver<Derived, StoragePrecision, ComputePrecision>::getAllocatedBytes() const {
  return _solution.getAllocatedBytes()
    + _halo.getAllocatedBytes() + _haloExchange.getAllocatedBytes()
    + _auxVarsHalo.getAllocatedBytes() + _auxVarsHaloExchange.getAllocatedBytes()
    + _migration.getAllocatedBytes() + _votes.getAllocatedBytes() + _errorMeasurement.getAllocatedBytes()
    + _solutionOnHost.getAllocatedBytes();
}

/**
 * Returns the number of values of one patch.
 */
template <typename Derived, typename StoragePrecision, typename ComputePrecision>
INLINE_METHOD int
exahype2::fv::Solver<Derived, StoragePrecision, ComputePrecision>::getNumberOfDoFs() const {
  return _solution.getChunkSize();
}

template <typename Derived, typename StoragePrecision, typename ComputePrecision>
template <typename RuntimeParameters>
INLINE_METHOD void
exahype2::fv::Solver<Derived, StoragePrecision, ComputePrecision>::applyBoundaryConditions(
  const peano4::CellConnectivity& cellConnectivity,
  const RuntimeParameters&        parameters
) {
  const auto boundaryFaces = cellConnectivity.onDevice().getFaces(peano4::Adjacency::Local, peano4::FaceKind::Boundary);
  tarch::accelerator::parallelFor(
    tarch::accelerator::Range(boundaryFaces.size * FiniteVolumeScheme::VolumesPerLayer),
    exahype2::fv::ApplyBoundaryConditions<Derived, StoragePrecision, ComputePrecision>{
      cellConnectivity.onDevice(),
      boundaryFaces,
      _halo.getView(),
      _auxVarsHalo.getView(),
      _timeStepping.getTimeStamp(),
      parameters
    }
  );
}

template <typename Derived, typename StoragePrecision, typename ComputePrecision>
INLINE_METHOD void
exahype2::fv::Solver<Derived, StoragePrecision, ComputePrecision>::projectUnknownsOntoFaces(
  const peano4::CellConnectivity& cellConnectivity
) {
  tarch::accelerator::parallelFor(
    tarch::accelerator::TeamRange(
      cellConnectivity.getCells().size,
      tarch::accelerator::getTeamThreads(FiniteVolumeScheme::UnknownsPerHalfFace),
      0
    ),
    exahype2::fv::ProjectUnknownsOntoFaces<Derived, StoragePrecision, ComputePrecision>{
      cellConnectivity.onDevice(),
      std::as_const(_solution).getView(),
      _halo.getView()
    }
  );
}

template <typename Derived, typename StoragePrecision, typename ComputePrecision>
INLINE_METHOD void
exahype2::fv::Solver<Derived, StoragePrecision, ComputePrecision>::projectAuxVarsOntoFaces(
  const peano4::CellConnectivity& cellConnectivity
) {
 tarch::accelerator::parallelFor(
    tarch::accelerator::TeamRange(
      cellConnectivity.getCells().size,
      tarch::accelerator::getTeamThreads(FiniteVolumeScheme::AuxVarsPerHalfFace),
      0
    ),
    exahype2::fv::ProjectAuxVarsOntoFaces<Derived, StoragePrecision, ComputePrecision>{
      cellConnectivity.onDevice(),
      std::as_const(_solution).getView(),
      _auxVarsHalo.getView()
    }
  );
}

/**
 * Advances the local or the remote cells in place and returns the largest wave speed over them.
 * Every patch reads its neighbours through the halo alone. The result does not depend on the
 * order of the cells.
 */
template <typename Derived, typename StoragePrecision, typename ComputePrecision>
template <typename RuntimeParameters>
INLINE_METHOD double
exahype2::fv::Solver<Derived, StoragePrecision, ComputePrecision>::updatePatches(
  const peano4::CellConnectivity& cellConnectivity,
  const peano4::Adjacency         adjacency,
  const double                    timeStepSize,
  const RuntimeParameters&        parameters
) {
  const auto cells         = cellConnectivity.onDevice().getCells(adjacency);
  double     maxEigenvalue = 0.0;
  tarch::accelerator::parallelReduce(
    tarch::accelerator::TeamRange(
      cells.size,
      FiniteVolumeScheme::getTeamThreads(),
      FiniteVolumeScheme::template getTeamScratchBytes<StoragePrecision>()
    ),
    exahype2::fv::UpdatePatches<Derived, StoragePrecision, ComputePrecision>{
      cellConnectivity.onDevice(),
      cells,
      _solution.getView(),
      std::as_const(_halo).getView(),
      std::as_const(_auxVarsHalo).getView(),
      _timeStepping.getTimeStamp(),
      timeStepSize,
      parameters
    },
    tarch::accelerator::Custom<exahype2::MaxEigenvalueReduction>{maxEigenvalue}
  );
  return maxEigenvalue;
}

/**
 * Returns the largest wave speed over the volumes of the solution. Returns zero unless a wave speed
 * feeds the time step size.
 */
template <typename Derived, typename StoragePrecision, typename ComputePrecision>
template <typename RuntimeParameters>
INLINE_METHOD double
exahype2::fv::Solver<Derived, StoragePrecision, ComputePrecision>::measureMaxEigenvalue(
  const peano4::CellConnectivity&           cellConnectivity,
  [[maybe_unused]] const RuntimeParameters& parameters
) {
  if constexpr (
    Derived::TimeSteppingRule == exahype2::TimeStepping::Rule::Adaptive
    and exahype2::terms::HasMaxEigenvalue<Derived, ComputePrecision>
  ) {
    double maxEigenvalue = 0.0;
    tarch::accelerator::parallelReduce(
      tarch::accelerator::Range(cellConnectivity.getCells().size),
      exahype2::fv::MeasurePatchEigenvalues<Derived, StoragePrecision, ComputePrecision>{
        cellConnectivity.onDevice(),
        std::as_const(_solution).getView(),
        _timeStepping.getTimeStamp(),
        parameters
      },
      tarch::accelerator::Custom<exahype2::MaxEigenvalueReduction>{maxEigenvalue}
    );
    return maxEigenvalue;
  } else {
    return 0.0;
  }
}

template <typename Derived, typename StoragePrecision, typename ComputePrecision>
template <typename RuntimeParameters>
INLINE_METHOD void
exahype2::fv::Solver<Derived, StoragePrecision, ComputePrecision>::measureError(
  const peano4::CellConnectivity&           cellConnectivity,
  [[maybe_unused]] const RuntimeParameters& parameters
) {
  if constexpr (exahype2::terms::HasMeasuredUnknowns<Derived>) {
    const double timeStamp = _timeStepping.getTimeStamp();
    if (not _errorMeasurement.isSnapshotDue(timeStamp)) {
      return;
    }
    const int numberOfCells = cellConnectivity.getCells().size;
    tarch::accelerator::parallelFor(
      tarch::accelerator::Range(numberOfCells),
      exahype2::fv::MeasurePatchErrors<Derived, StoragePrecision, ComputePrecision>{
        cellConnectivity.onDevice(),
        std::as_const(_solution).getView(),
        _errorMeasurement.getErrorsPerCell(numberOfCells),
        timeStamp,
        _timeStepping.getTimeStepSizeOfLastStep(),
        parameters
      }
    );
    _errorMeasurement.record(numberOfCells, timeStamp);
  }
}

/**
 * Passes the smallest and the largest volume width of this rank to the time stepping. The reduction
 * of the step reduces them over all ranks.
 */
template <typename Derived, typename StoragePrecision, typename ComputePrecision>
INLINE_METHOD void
exahype2::fv::Solver<Derived, StoragePrecision, ComputePrecision>::measureMeshWidths(
  const peano4::CellConnectivity& cellConnectivity
) {
  double minimum = std::numeric_limits<double>::infinity();
  double maximum = 0.0;
  if (not cellConnectivity.getCells().isEmpty()) {
    for (int axis = 0; axis < DIMENSIONS; axis++) {
      minimum = std::min(
        minimum,
        cellConnectivity.getWidthOfLevel(cellConnectivity.getMaximumLevel(), axis) / Derived::PatchSize
      );
      maximum = std::max(
        maximum,
        cellConnectivity.getWidthOfLevel(cellConnectivity.getMinimumLevel(), axis) / Derived::PatchSize
      );
    }
  }
  _timeStepping.setLocalMeshWidths(minimum, maximum);
}

/**
 * An adaptive rule raises maxEigenvalue of this rank. readValuesFromGlobalReduction() then derives
 * the size of the next time step. A fixed rule sets this size at once.
 */
template <typename Derived, typename StoragePrecision, typename ComputePrecision>
INLINE_METHOD void
exahype2::fv::Solver<Derived, StoragePrecision, ComputePrecision>::proposeTimeStepSize(const double maxEigenvalue) {
  if constexpr (Derived::TimeSteppingRule == exahype2::TimeStepping::Rule::Adaptive) {
    _timeStepping.raiseMaxEigenvalue(maxEigenvalue);
  } else {
    _timeStepping.setFixedTimeStepSize(getFixedTimeStepSize());
  }
}

/**
 * Returns the time step size of the CFL condition on the smallest volume for the reduced wave
 * speed.
 */
template <typename Derived, typename StoragePrecision, typename ComputePrecision>
INLINE_METHOD double
exahype2::fv::Solver<Derived, StoragePrecision, ComputePrecision>::getTimeStepSizeFromCFL() const {
  return _timeStepping.getFactor() * _timeStepping.getMinMeshWidth()
    / (DIMENSIONS * _timeStepping.getMaxEigenvalueOfThisStep());
}

/**
 * Returns the normalised fraction of the largest admissible mesh width.
 */
template <typename Derived, typename StoragePrecision, typename ComputePrecision>
INLINE_METHOD double
exahype2::fv::Solver<Derived, StoragePrecision, ComputePrecision>::getFixedTimeStepSize() const {
  const double                maxAdmissibleMeshWidth = _timeStepping.getLimits().maxAdmissibleMeshWidth;
  [[maybe_unused]] const bool meshWidthIsFinite      = std::isfinite(maxAdmissibleMeshWidth);
  ASSERTION(meshWidthIsFinite and maxAdmissibleMeshWidth > 0.0, maxAdmissibleMeshWidth);
  return _timeStepping.getFactor() * _timeStepping.getMinMeshWidth() / maxAdmissibleMeshWidth;
}

/**
 * Adds the mesh widths and the wave speed of this rank to the reduction of the step.
 */
template <typename Derived, typename StoragePrecision, typename ComputePrecision>
INLINE_METHOD void
exahype2::fv::Solver<Derived, StoragePrecision, ComputePrecision>::addLocalValuesToGlobalReduction(
  tarch::mpi::ReductionRecord& record
) {
  _timeStepping.addLocalValuesToGlobalReduction(record);
}

/**
 * Reads the reduced mesh widths and wave speed. Before the terminal time, a new wave speed sets the
 * size of the next step. New mesh widths reset a fixed time step size once the time stepping has
 * started.
 */
template <typename Derived, typename StoragePrecision, typename ComputePrecision>
INLINE_METHOD void
exahype2::fv::Solver<Derived, StoragePrecision, ComputePrecision>::readValuesFromGlobalReduction(
  const tarch::mpi::ReductionRecord& record
) {
  _timeStepping.readValuesFromGlobalReduction(record);
  if constexpr (Derived::TimeSteppingRule == exahype2::TimeStepping::Rule::Adaptive) {
    if (
      _timeStepping.hasNewMaxEigenvalues() and _timeStepping.hasPositiveStabilityEigenvalue()
      and _timeStepping.getTimeStamp() < _timeStepping.getLimits().terminalTime
    ) {
      _timeStepping.setAdmissibleTimeStepSize(getTimeStepSizeFromCFL());
    }
  } else if (_timeStepping.hasNewMeshWidths() and _timeStepping.getTimeStepSizeOfNextStep() > 0.0) {
    _timeStepping.setFixedTimeStepSize(getFixedTimeStepSize());
  }
}
