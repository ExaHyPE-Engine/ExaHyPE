#include "exahype2/fv/reconstruction/ReconstructionScheme.h"
#include "exahype2/LevelJumps.h"
#include "exahype2/fv/Kernels.h"
#include "exahype2/terms/MaxEigenvalue.h"
#include "exahype2/terms/MeasuredUnknowns.h"
#include "tarch/Assertions.h"
#include "tarch/MemoryUsage.h"
#include "tarch/accelerator/ParallelFor.h"
#include "tarch/accelerator/ParallelReduce.h"
#include "tarch/accelerator/Range.h"
#include "tarch/accelerator/Reducer.h"

/**
 * The factor timeStepFactor is the CFL relaxation of an adaptive rule or the normalised time step
 * size of a fixed one. The arguments name and plottedFields describe the plot files.
 */
template <typename Derived, typename StoragePrecision, typename ComputePrecision>
INLINE_METHOD exahype2::fv::Solver<Derived, StoragePrecision, ComputePrecision>::Solver(
  const double                              timeStepFactor,
  std::string                               name,
  std::vector<exahype2::plotter::DataField> plottedFields
) :
  _timeStepping{Derived::TimeSteppingRule, timeStepFactor, exahype2::TimeStepping::Stability::PhysicalEigenvalue},
  _plotter(std::move(name), std::move(plottedFields)) {
  static_assert(exahype2::fv::ReconstructionScheme<typename Derived::Reconstruction>);
}

template <typename Derived, typename StoragePrecision, typename ComputePrecision>
INLINE_METHOD void
exahype2::fv::Solver<Derived, StoragePrecision, ComputePrecision>::requestRefinementForGridConstruction(
  const peano4::CellConnectivity& cellConnectivity,
  exahype2::RefinementRequests&   requests
) {
  _votes.voteOnGridConstruction<Derived, StoragePrecision>(cellConnectivity, _timeStepping.getLimits(), requests);
}

/**
 * Reserves the pools for the slots and faces of cellConnectivity and builds the halo exchange.
 * Every rank calls this at the same time. The exchanges of every solver then take the same tags.
 */
template <typename Derived, typename StoragePrecision, typename ComputePrecision>
INLINE_METHOD void
exahype2::fv::Solver<Derived, StoragePrecision, ComputePrecision>::allocate(
  const peano4::CellConnectivity& cellConnectivity
) {
  _solution.reserve(cellConnectivity.getNumberOfSlots());
  _halo.reserve(cellConnectivity.getNumberOfFaces());
  _haloExchange.rebuild(cellConnectivity);
  measureMeshWidths(cellConnectivity);
}

/**
 * Writes the initial condition of Derived on the host into every patch, fills the faces and votes
 * on the refinement.
 */
template <typename Derived, typename StoragePrecision, typename ComputePrecision>
INLINE_METHOD void
exahype2::fv::Solver<Derived, StoragePrecision, ComputePrecision>::initialise(
  const peano4::CellConnectivity& cellConnectivity,
  exahype2::RefinementRequests&   requests
) {
  Patches    copyOnHost{Patch::ValuesPerPatch, tarch::MemoryLocation::Heap};
  Patches&   patches = _solution.download(copyOnHost);
  const auto cells   = cellConnectivity.getCells();
  tarch::accelerator::parallelForOnHost(tarch::accelerator::Range(cells.size), [&](const int entry) {
    const int slot = cells[entry];
    Patch::initialise(patches.getChunk(slot), cellConnectivity.getCellCentre(slot), cellConnectivity.getCellWidth(slot));
  });
  _solution.upload(patches);

  projectOntoFaces(cellConnectivity);
  exahype2::restrictFineFaces(
    cellConnectivity,
    exahype2::fv::RestrictHaloHalves<Derived, StoragePrecision, ComputePrecision>{
      cellConnectivity.onDevice(),
      _halo.getView()
    }
  );
  measureMeshWidths(cellConnectivity);
  measureError(cellConnectivity);
  _votes.voteOnEveryCell<Derived>(
    cellConnectivity,
    std::as_const(_solution).getView(),
    _timeStepping.getLimits(),
    _timeStepping.getTimeStamp(),
    requests
  );
}

/**
 * Moves the patches of the solution through the slot moves of a regrid. A new child takes its
 * patch from its parent and a new parent from its children. The patches that change rank travel
 * in _migration. readValuesFromGlobalReduction() derives the time step size of the new grid.
 */
template <typename Derived, typename StoragePrecision, typename ComputePrecision>
INLINE_METHOD void
exahype2::fv::Solver<Derived, StoragePrecision, ComputePrecision>::regrid(
  const peano4::CellConnectivity& cellConnectivity,
  const peano4::Regrid&           regrid,
  exahype2::RefinementRequests&   requests
) {
  assertion(regrid.newNumberOfSlots >= regrid.oldNumberOfSlots, regrid.newNumberOfSlots, regrid.oldNumberOfSlots);
  _solution.reserve(regrid.newNumberOfSlots);
  _migration.migrate(
    _solution,
    regrid,
    exahype2::fv::PatchTransfer<Derived, StoragePrecision, ComputePrecision>{std::as_const(_solution).getView()}
  );

  _halo.reserve(cellConnectivity.getNumberOfFaces());
  _haloExchange.rebuild(cellConnectivity);
  projectOntoFaces(cellConnectivity);
  exahype2::restrictFineFaces(
    cellConnectivity,
    exahype2::fv::RestrictHaloHalves<Derived, StoragePrecision, ComputePrecision>{
      cellConnectivity.onDevice(),
      _halo.getView()
    }
  );

  measureMeshWidths(cellConnectivity);
  if constexpr (Derived::TimeSteppingRule == exahype2::TimeStepping::Rule::Adaptive) {
    if (_timeStepping.getTimeStepSizeOfNextStep() > 0.0) {
      _timeStepping.raiseMaxEigenvalue(measureMaxEigenvalue(cellConnectivity));
    }
  }
  _meshChangedSinceLastTimeStep = true;
  _votes.voteOnCells<Derived>(
    cellConnectivity,
    regrid.createdSlots,
    std::as_const(_solution).getView(),
    _timeStepping.getLimits(),
    _timeStepping.getTimeStamp(),
    requests
  );
}

/**
 * Writes one snapshot with the value of every volume at its centre, so that a viewer interpolates
 * between the volumes. The points on a patch face hold the average of the volumes on both sides of
 * the face, which the halo provides, so both patches of a face plot the same values. A patch corner
 * extrapolates the volume beyond it bilinearly from the volumes around it. Every rank calls this at
 * the same time. In a build with a GPU backend the plot reads host copies of the solution and halo.
 */
template <typename Derived, typename StoragePrecision, typename ComputePrecision>
INLINE_METHOD void
exahype2::fv::Solver<Derived, StoragePrecision, ComputePrecision>::plot(
  const peano4::CellConnectivity& cellConnectivity,
  const tarch::plotter::Format    format,
  const std::string&              outputDirectory
) {
  constexpr int PatchSize       = Derived::PatchSize;
  constexpr int ExtendedPerAxis = PatchSize + 2;

  std::array<double, ExtendedPerAxis> pointPositions{};
  for (int point = 1; point <= PatchSize; point++) {
    pointPositions[static_cast<std::size_t>(point)] = (point - 0.5) / PatchSize;
  }
  pointPositions.back() = 1.0;

  fillHalo(cellConnectivity);
  const Patches& solution = std::as_const(_solution).download(_solutionOnHost);
  const Faces&   halo     = std::as_const(_halo).download(_haloOnHost);
  plotPatch<1, ExtendedPerAxis>(
    cellConnectivity,
    format,
    outputDirectory,
    [&](const int cell, double* const values) {
      const StoragePrecision* faces[peano4::FacesPerCell];
      for (int face = 0; face < peano4::FacesPerCell; face++) {
        faces[face] = halo.getChunk(cellConnectivity.getCellFace(cell, face));
      }
      evaluateVolumeCentres(solution.getChunk(cell), faces, values);
    },
    nullptr,
    nullptr,
    pointPositions.data()
  );
}

/**
 * Writes the values at the PatchSize + 2 points per axis of plot() into values: the
 * volume centres of patch and the faces between them, with the volumes beyond each face from the
 * halo in faces.
 */
template <typename Derived, typename StoragePrecision, typename ComputePrecision>
INLINE_METHOD void
exahype2::fv::Solver<Derived, StoragePrecision, ComputePrecision>::evaluateVolumeCentres(
  const StoragePrecision* const        patch,
  const StoragePrecision* const* const faces,
  double* const                        values
) {
  constexpr int PatchSize       = Derived::PatchSize;
  constexpr int NumberOfData    = Derived::NumberOfUnknowns + Derived::NumberOfAuxiliaryVariables;
  constexpr int ExtendedPerAxis = PatchSize + 2;
  constexpr int ExtendedValues  = peano4::power(ExtendedPerAxis, DIMENSIONS) * NumberOfData;
  std::vector<double>           extended(ExtendedValues);
  const auto                    getExtended = [&](const tarch::la::Vector<DIMENSIONS, int>& index) {
    return extended.data() + peano4::dLinearised(index, ExtendedPerAxis) * NumberOfData;
  };
  for (int outsideAxes = 0; outsideAxes <= DIMENSIONS; outsideAxes++) {
    peano4::dForEach(ExtendedPerAxis, [&](const tarch::la::Vector<DIMENSIONS, int>& index) {
      std::array<int, DIMENSIONS> outside{};
      int                         count = 0;
      for (int axis = 0; axis < DIMENSIONS; axis++) {
        if (index(axis) == 0 or index(axis) == ExtendedPerAxis - 1) {
          outside[static_cast<std::size_t>(count++)] = axis;
        }
      }
      if (count != outsideAxes) {
        return;
      }
      double* const target = getExtended(index);
      if (count == 0) {
        const auto volume = index - tarch::la::Vector<DIMENSIONS, int>(1);
        const auto source = patch + peano4::dLinearised(volume, PatchSize) * NumberOfData;
        std::copy_n(source, NumberOfData, target);
      } else if (count == 1) {
        const int  normal = outside[0];
        const bool upper  = index(normal) != 0;
        auto       layer  = index - tarch::la::Vector<DIMENSIONS, int>(1);
        layer(normal)     = upper ? Patch::HaloSize : Patch::HaloSize - 1;
        const auto source = faces[normal + (upper ? DIMENSIONS : 0)]
                          + exahype2::fv::getFaceVolumeIndex(layer, PatchSize, Patch::HaloSize, normal) * NumberOfData;
        std::copy_n(source, NumberOfData, target);
      } else {
        std::fill_n(target, NumberOfData, 0.0);
        for (int kept = 0; kept < (1 << count) - 1; kept++) {
          auto inner = index;
          int  moved = 0;
          for (int entry = 0; entry < count; entry++) {
            const int axis = outside[static_cast<std::size_t>(entry)];
            if ((kept & (1 << entry)) == 0) {
              inner(axis) = index(axis) == 0 ? 1 : ExtendedPerAxis - 2;
              moved++;
            }
          }
          const double  sign   = moved % 2 == 1 ? 1.0 : -1.0;
          const double* source = getExtended(inner);
          for (int value = 0; value < NumberOfData; value++) {
            target[value] += sign * source[value];
          }
        }
      }
    });
  }
  peano4::dForEach(ExtendedPerAxis, [&](const tarch::la::Vector<DIMENSIONS, int>& pointIndex) {
    double* const point = values + peano4::dLinearised(pointIndex, ExtendedPerAxis) * NumberOfData;
    std::fill_n(point, NumberOfData, 0.0);
    tarch::la::Vector<DIMENSIONS, int> width(1);
    for (int axis = 0; axis < DIMENSIONS; axis++) {
      width(axis) = pointIndex(axis) == 0 or pointIndex(axis) == ExtendedPerAxis - 1 ? 2 : 1;
    }
    int sources = 0;
    peano4::dForEach(width, [&](const tarch::la::Vector<DIMENSIONS, int>& offset) {
      auto index = pointIndex;
      for (int axis = 0; axis < DIMENSIONS; axis++) {
        if (width(axis) == 2) {
          index(axis) = pointIndex(axis) == 0 ? offset(axis) : ExtendedPerAxis - 2 + offset(axis);
        }
      }
      const double* const source = getExtended(index);
      for (int value = 0; value < NumberOfData; value++) {
        point[value] += source[value];
      }
      sources++;
    });
    for (int value = 0; value < NumberOfData; value++) {
      point[value] /= sources;
    }
  });
}

/**
 * Writes one snapshot in which every volume owns PointsPerAxis equidistant points per
 * axis from face to face. The call evaluatePatch(cell, patch, faces, values) writes the
 * reconstruction at these points from the patch and the halos on its faces into values, ordered
 * by volume, then by point. A fresh halo precedes the plot. Every rank calls this at the same time.
 */
template <typename Derived, typename StoragePrecision, typename ComputePrecision>
template <int PointsPerAxis, typename EvaluatePatch>
INLINE_METHOD void
exahype2::fv::Solver<Derived, StoragePrecision, ComputePrecision>::plotReconstruction(
  const peano4::CellConnectivity&                         cellConnectivity,
  const tarch::plotter::Format                            format,
  const std::string&                                      outputDirectory,
  const EvaluatePatch&                                    evaluatePatch,
  const tarch::accelerator::ChunkedMemoryPool<int>* const volumeStatuses,
  const char* const                                       statusName
) {
  fillHalo(cellConnectivity);
  const Patches& solution = std::as_const(_solution).download(_solutionOnHost);
  const Faces&   halo     = std::as_const(_halo).download(_haloOnHost);
  plotPatch<Derived::PatchSize, PointsPerAxis>(
    cellConnectivity,
    format,
    outputDirectory,
    [&](const int cell, double* const values) {
      const StoragePrecision* faces[peano4::FacesPerCell];
      for (int face = 0; face < peano4::FacesPerCell; face++) {
        faces[face] = halo.getChunk(cellConnectivity.getCellFace(cell, face));
      }
      evaluatePatch(cell, solution.getChunk(cell), faces, values);
    },
    volumeStatuses,
    statusName
  );
}

/**
 * Fills the halo for a reconstruction outside a time step as performTimeStep() does.
 */
template <typename Derived, typename StoragePrecision, typename ComputePrecision>
INLINE_METHOD void
exahype2::fv::Solver<Derived, StoragePrecision, ComputePrecision>::fillHalo(
  const peano4::CellConnectivity& cellConnectivity
) {
  _haloExchange.post();
  applyBoundaryConditions(cellConnectivity);
  interpolateCoarseHalos(cellConnectivity, peano4::Adjacency::Local);
  _haloExchange.wait();
  interpolateCoarseHalos(cellConnectivity, peano4::Adjacency::Remote);
}

/**
 * Writes one snapshot with ElementsPerAxis elements and PointsPerAxis points per axis
 * that evaluate fills, at pointPositions where given, with the status of every element from
 * volumeStatuses in the cell field statusName where given.
 */
template <typename Derived, typename StoragePrecision, typename ComputePrecision>
template <int ElementsPerAxis, int PointsPerAxis, typename Evaluate>
INLINE_METHOD void
exahype2::fv::Solver<Derived, StoragePrecision, ComputePrecision>::plotPatch(
  const peano4::CellConnectivity&                         cellConnectivity,
  const tarch::plotter::Format                            format,
  const std::string&                                      outputDirectory,
  const Evaluate&                                         evaluate,
  const tarch::accelerator::ChunkedMemoryPool<int>* const volumeStatuses,
  const char* const                                       statusName,
  const double* const                                     pointPositions
) {
  constexpr int NumberOfData = Derived::NumberOfUnknowns + Derived::NumberOfAuxiliaryVariables;
  assertion(volumeStatuses == nullptr or volumeStatuses->isHostAccessible());
  if (volumeStatuses == nullptr) {
    _plotter.template plotPatch<ElementsPerAxis, PointsPerAxis, NumberOfData>(
      cellConnectivity,
      cellConnectivity.getCells(),
      evaluate,
      _timeStepping.getTimeStamp(),
      format,
      outputDirectory,
      nullptr,
      nullptr,
      pointPositions
    );
  } else {
    _plotter.template plotPatch<ElementsPerAxis, PointsPerAxis, NumberOfData>(
      cellConnectivity,
      cellConnectivity.getCells(),
      evaluate,
      _timeStepping.getTimeStamp(),
      format,
      outputDirectory,
      [&](const int cell, const int volume) { return volumeStatuses->getChunk(cell)[volume]; },
      statusName,
      pointPositions
    );
  }
}

/**
 * Frees the pools, the exchanges and every device buffer. No allocation outlives the runtime.
 */
template <typename Derived, typename StoragePrecision, typename ComputePrecision>
INLINE_METHOD void
exahype2::fv::Solver<Derived, StoragePrecision, ComputePrecision>::release() {
  _solution.release();
  _halo.release();
  _haloExchange.release();
  _migration.release();
  _votes.release();
  _errorMeasurement.release();
  _solutionOnHost.release();
  _haloOnHost.release();
}

template <typename Derived, typename StoragePrecision, typename ComputePrecision>
INLINE_METHOD void
exahype2::fv::Solver<Derived, StoragePrecision, ComputePrecision>::setLimits(const exahype2::Limits& limits) {
  _timeStepping.setLimits(limits);
}

template <typename Derived, typename StoragePrecision, typename ComputePrecision>
INLINE_METHOD void
exahype2::fv::Solver<Derived, StoragePrecision, ComputePrecision>::openErrorMeasurement(
  const std::string& fileName,
  const double       timeDeltaBetweenSnapshots
) {
  static_assert(
    exahype2::terms::HasMeasuredUnknowns<Derived>,
    "The error measurement of the solver expects an analytical solution and the unknowns to measure."
  );
  _errorMeasurement.open(fileName, timeDeltaBetweenSnapshots);
}

template <typename Derived, typename StoragePrecision, typename ComputePrecision>
INLINE_METHOD const exahype2::TimeStepping&
exahype2::fv::Solver<Derived, StoragePrecision, ComputePrecision>::getTimeStepping() const {
  return _timeStepping;
}

template <typename Derived, typename StoragePrecision, typename ComputePrecision>
INLINE_METHOD const typename exahype2::fv::Solver<Derived, StoragePrecision, ComputePrecision>::Patches&
exahype2::fv::Solver<Derived, StoragePrecision, ComputePrecision>::getSolution() const {
  return _solution;
}

/**
 * Returns the bytes of the pools, the exchanges and the copy of the solution that a plot in a build
 * with a GPU backend reads.
 */
template <typename Derived, typename StoragePrecision, typename ComputePrecision>
INLINE_METHOD tarch::AllocatedBytes
exahype2::fv::Solver<Derived, StoragePrecision, ComputePrecision>::getAllocatedBytes() const {
  return _solution.getAllocatedBytes() + _halo.getAllocatedBytes() + _haloExchange.getAllocatedBytes()
    + _migration.getAllocatedBytes() + _votes.getAllocatedBytes() + _errorMeasurement.getAllocatedBytes()
    + _solutionOnHost.getAllocatedBytes() + _haloOnHost.getAllocatedBytes();
}

/**
 * Returns the number of values of one patch.
 */
template <typename Derived, typename StoragePrecision, typename ComputePrecision>
INLINE_METHOD int
exahype2::fv::Solver<Derived, StoragePrecision, ComputePrecision>::getNumberOfDoFs() const {
  return _solution.getChunkSize();
}

template <typename Derived, typename StoragePrecision, typename ComputePrecision>
INLINE_METHOD void
exahype2::fv::Solver<Derived, StoragePrecision, ComputePrecision>::applyBoundaryConditions(
  const peano4::CellConnectivity& cellConnectivity
) {
  const auto boundaryFaces = cellConnectivity.onDevice().getFaces(peano4::Adjacency::Local, peano4::FaceKind::Boundary);
  tarch::accelerator::parallelFor(
    tarch::accelerator::Range(boundaryFaces.size),
    exahype2::fv::ApplyBoundaryConditions<Derived, StoragePrecision, ComputePrecision>{
      cellConnectivity.onDevice(),
      boundaryFaces,
      _halo.getView(),
      _timeStepping.getTimeStamp()
    }
  );
}

template <typename Derived, typename StoragePrecision, typename ComputePrecision>
INLINE_METHOD void
exahype2::fv::Solver<Derived, StoragePrecision, ComputePrecision>::projectOntoFaces(
  const peano4::CellConnectivity& cellConnectivity
) {
  tarch::accelerator::parallelFor(
    tarch::accelerator::TeamRange(cellConnectivity.getCells().size),
    exahype2::fv::ProjectPatchesOntoFaces<Derived, StoragePrecision, ComputePrecision>{
      cellConnectivity.onDevice(),
      std::as_const(_solution).getView(),
      _halo.getView()
    }
  );
}

/**
 * Fills the coarse-side halves of the fine faces of the level jumps of the local or the remote
 * cells from their coarse faces.
 */
template <typename Derived, typename StoragePrecision, typename ComputePrecision>
INLINE_METHOD void
exahype2::fv::Solver<Derived, StoragePrecision, ComputePrecision>::interpolateCoarseHalos(
  const peano4::CellConnectivity& cellConnectivity,
  const peano4::Adjacency  adjacency
) {
  exahype2::interpolateCoarseFaces(
    cellConnectivity,
    adjacency,
    exahype2::fv::InterpolateHaloHalves<Derived, StoragePrecision, ComputePrecision>{
      cellConnectivity.onDevice(),
      _halo.getView()
    }
  );
}

/**
 * Finishes a time step of timeStepSize after every patch holds its new solution: Fills the halo
 * for the next step, advances the time stamp, derives the next time step size from
 * maxEigenvalue, the largest wave speed of the step, and votes on the refinement.
 */
template <typename Derived, typename StoragePrecision, typename ComputePrecision>
INLINE_METHOD void
exahype2::fv::Solver<Derived, StoragePrecision, ComputePrecision>::closeTimeStep(
  const peano4::CellConnectivity&      cellConnectivity,
  const double                  timeStepSize,
  const double                  maxEigenvalue,
  exahype2::RefinementRequests& requests
) {
  projectOntoFaces(cellConnectivity);
  exahype2::restrictFineFaces(
    cellConnectivity,
    exahype2::fv::RestrictHaloHalves<Derived, StoragePrecision, ComputePrecision>{cellConnectivity.onDevice(), _halo.getView()}
  );

  _timeStepping.advanceTimeStamp(timeStepSize);
  proposeTimeStepSize(maxEigenvalue);
  measureError(cellConnectivity);
  if (_meshChangedSinceLastTimeStep) {
    _meshChangedSinceLastTimeStep = false;
  } else {
    _votes.voteOnEveryCell<Derived>(
      cellConnectivity,
      std::as_const(_solution).getView(),
      _timeStepping.getLimits(),
      _timeStepping.getTimeStamp(),
      requests
    );
  }
}

/**
 * Returns the largest wave speed over the volumes of the solution. Returns zero when no wave speed
 * feeds the time step size.
 */
template <typename Derived, typename StoragePrecision, typename ComputePrecision>
INLINE_METHOD double
exahype2::fv::Solver<Derived, StoragePrecision, ComputePrecision>::measureMaxEigenvalue(
  const peano4::CellConnectivity& cellConnectivity
) {
  if constexpr (
    Derived::TimeSteppingRule == exahype2::TimeStepping::Rule::Adaptive
    and exahype2::terms::HasMaxEigenvalue<Derived, ComputePrecision>
  ) {
    double maxEigenvalue = 0.0;
    tarch::accelerator::parallelReduce(
      tarch::accelerator::Range(cellConnectivity.getCells().size),
      exahype2::fv::MeasurePatchEigenvalues<Derived, StoragePrecision, ComputePrecision>{
        cellConnectivity.onDevice(),
        std::as_const(_solution).getView(),
        _timeStepping.getTimeStamp()
      },
      tarch::accelerator::Custom<exahype2::MaxEigenvalueReduction>{maxEigenvalue}
    );
    return maxEigenvalue;
  } else {
    return 0.0;
  }
}

template <typename Derived, typename StoragePrecision, typename ComputePrecision>
INLINE_METHOD void
exahype2::fv::Solver<Derived, StoragePrecision, ComputePrecision>::measureError(
  const peano4::CellConnectivity& cellConnectivity
) {
  if constexpr (exahype2::terms::HasMeasuredUnknowns<Derived>) {
    const double timeStamp = _timeStepping.getTimeStamp();
    if (not _errorMeasurement.isSnapshotDue(timeStamp)) {
      return;
    }
    const int numberOfCells = cellConnectivity.getCells().size;
    tarch::accelerator::parallelFor(
      tarch::accelerator::Range(numberOfCells),
      exahype2::fv::MeasurePatchErrors<Derived, StoragePrecision, ComputePrecision>{
        cellConnectivity.onDevice(),
        std::as_const(_solution).getView(),
        _errorMeasurement.getErrorsPerCell(numberOfCells),
        timeStamp,
        _timeStepping.getTimeStepSizeOfLastStep()
      }
    );
    _errorMeasurement.record(numberOfCells, timeStamp);
  }
}

/**
 * Passes the smallest and the largest volume width of this rank to the time stepping. The reduction
 * of the step reduces them over all ranks.
 */
template <typename Derived, typename StoragePrecision, typename ComputePrecision>
INLINE_METHOD void
exahype2::fv::Solver<Derived, StoragePrecision, ComputePrecision>::measureMeshWidths(
  const peano4::CellConnectivity& cellConnectivity
) {
  double minimum = std::numeric_limits<double>::infinity();
  double maximum = 0.0;
  if (not cellConnectivity.getCells().isEmpty()) {
    for (int axis = 0; axis < DIMENSIONS; axis++) {
      minimum = std::min(
        minimum,
        cellConnectivity.getWidthOfLevel(cellConnectivity.getMaximumLevel(), axis) / Derived::PatchSize
      );
      maximum = std::max(
        maximum,
        cellConnectivity.getWidthOfLevel(cellConnectivity.getMinimumLevel(), axis) / Derived::PatchSize
      );
    }
  }
  _timeStepping.setLocalMeshWidths(minimum, maximum);
}

/**
 * An adaptive rule raises maxEigenvalue of this rank. readValuesFromGlobalReduction() then derives
 * the size of the next time step. A fixed rule sets this size at once.
 */
template <typename Derived, typename StoragePrecision, typename ComputePrecision>
INLINE_METHOD void
exahype2::fv::Solver<Derived, StoragePrecision, ComputePrecision>::proposeTimeStepSize(const double maxEigenvalue) {
  if constexpr (Derived::TimeSteppingRule == exahype2::TimeStepping::Rule::Adaptive) {
    _timeStepping.raiseMaxEigenvalue(maxEigenvalue);
  } else {
    _timeStepping.setFixedTimeStepSize(getFixedTimeStepSize());
  }
}

/**
 * Returns the time step size of the CFL condition on the smallest volume for the reduced wave
 * speed.
 */
template <typename Derived, typename StoragePrecision, typename ComputePrecision>
INLINE_METHOD double
exahype2::fv::Solver<Derived, StoragePrecision, ComputePrecision>::getTimeStepSizeFromCFL() const {
  return _timeStepping.getFactor() * _timeStepping.getMinMeshWidth()
    / (DIMENSIONS * _timeStepping.getMaxEigenvalueOfThisStep());
}

/**
 * Returns the normalised fraction of the largest admissible mesh width.
 */
template <typename Derived, typename StoragePrecision, typename ComputePrecision>
INLINE_METHOD double
exahype2::fv::Solver<Derived, StoragePrecision, ComputePrecision>::getFixedTimeStepSize() const {
  const double                maxAdmissibleMeshWidth = _timeStepping.getLimits().maxAdmissibleMeshWidth;
  [[maybe_unused]] const bool meshWidthIsFinite      = std::isfinite(maxAdmissibleMeshWidth);
  assertion(meshWidthIsFinite and maxAdmissibleMeshWidth > 0.0, maxAdmissibleMeshWidth);
  return _timeStepping.getFactor() * _timeStepping.getMinMeshWidth() / maxAdmissibleMeshWidth;
}

/**
 * Adds the mesh widths and the wave speed of this rank to the reduction of the step.
 */
template <typename Derived, typename StoragePrecision, typename ComputePrecision>
INLINE_METHOD void
exahype2::fv::Solver<Derived, StoragePrecision, ComputePrecision>::addLocalValuesToGlobalReduction(
  tarch::mpi::ReductionRecord& record
) {
  _timeStepping.addLocalValuesToGlobalReduction(record);
}

/**
 * Reads the reduced mesh widths and wave speed. Before the terminal time, a new wave speed sets the
 * size of the next step. New mesh widths reset a fixed time step size once the time stepping has
 * started.
 */
template <typename Derived, typename StoragePrecision, typename ComputePrecision>
INLINE_METHOD void
exahype2::fv::Solver<Derived, StoragePrecision, ComputePrecision>::readValuesFromGlobalReduction(
  const tarch::mpi::ReductionRecord& record
) {
  _timeStepping.readValuesFromGlobalReduction(record);
  if constexpr (Derived::TimeSteppingRule == exahype2::TimeStepping::Rule::Adaptive) {
    if (
      _timeStepping.hasNewMaxEigenvalues() and _timeStepping.hasPositiveStabilityEigenvalue()
      and _timeStepping.getTimeStamp() < _timeStepping.getLimits().terminalTime
    ) {
      _timeStepping.setAdmissibleTimeStepSize(getTimeStepSizeFromCFL());
    }
  } else if (_timeStepping.hasNewMeshWidths() and _timeStepping.getTimeStepSizeOfNextStep() > 0.0) {
    _timeStepping.setFixedTimeStepSize(getFixedTimeStepSize());
  }
}
