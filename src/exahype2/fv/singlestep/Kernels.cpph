#include "exahype2/TimeStepping.h"
#include "exahype2/terms/PostprocessUpdatedPatch.h"
#include "peano4/Constants.h"
#include "tarch/accelerator/ParallelReduce.h"
#include "tarch/accelerator/Range.h"
#include "tarch/accelerator/Reducer.h"

TARGET_DECLARE
/**
 * Advances the patch of one cell in place and reduces the wave speeds of the update and of the
 * updated volumes into the accumulator. On the host one thread sweeps the patch. On a device the
 * team updates the volumes in rounds of one volume per thread and runs the patch postprocessing
 * of Derived before it reads the wave speeds of the updated volumes.
 */
template <typename Derived, typename StoragePrecision, typename ComputePrecision>
INLINE_METHOD GPU_CALLABLE_METHOD void
exahype2::fv::singlestep::UpdatePatches<Derived, StoragePrecision, ComputePrecision>::operator()(
  const int                            entry,
  const tarch::accelerator::TeamHandle team,
  double&                              accumulator
) const {
  const int               slot = cells[entry];
  const StoragePrecision* faces[peano4::FacesPerCell];
  for (int faceNumber = 0; faceNumber < peano4::FacesPerCell; faceNumber++) {
    faces[faceNumber] = halo.getChunk(cellConnectivity.getCellFace(slot, faceNumber));
  }
  StoragePrecision* const                     patch         = solution.getChunk(slot);
  const tarch::la::Vector<DIMENSIONS, double> cellCentre    = cellConnectivity.getCellCentre(slot);
  const tarch::la::Vector<DIMENSIONS, double> cellSize      = cellConnectivity.getCellWidth(slot);
  const int                                   boundaryFaces = exahype2::fv::getBoundaryFaceMask(cellConnectivity, slot);
  const double                                stepStart     = timeStamp;
  const double                                stepSize      = timeStepSize;

  const double partial =
    Kernel::updateInTeam(team, patch, faces, cellCentre, cellSize, stepStart, stepSize, boundaryFaces, parameters);
  COMPILE_IF_ON_HOST(accumulator = exahype2::MaxEigenvalueReduction::combine(accumulator, partial);)
  COMPILE_IF_ON_DEVICE(reduceWaveSpeedsWithThreadsOfTeam(
                         team,
                         partial,
                         patch,
                         cellCentre,
                         cellSize,
                         stepStart,
                         stepSize,
                         accumulator,
                         parameters
  );)
}

/**
 * Reduces partial over team into accumulator. One thread then runs the patch postprocessing of
 * Derived on patch if Derived defines one. The team then reduces the wave speeds of the
 * postprocessed volumes into accumulator.
 */
template <typename Derived, typename StoragePrecision, typename ComputePrecision>
INLINE_METHOD GPU_CALLABLE_METHOD void
exahype2::fv::singlestep::UpdatePatches<Derived, StoragePrecision, ComputePrecision>::reduceWaveSpeedsWithThreadsOfTeam(
  const tarch::accelerator::TeamHandle         team,
  const double                                 partial,
  StoragePrecision* const                      patch,
  const tarch::la::Vector<DIMENSIONS, double>& cellCentre,
  const tarch::la::Vector<DIMENSIONS, double>& cellSize,
  const double                                 stepStart,
  const double                                 stepSize,
  double&                                      accumulator,
  const typename Derived::RuntimeParameters&   parameters
) const {
  const tarch::accelerator::Custom<exahype2::MaxEigenvalueReduction> reducer{accumulator};
  tarch::accelerator::reduceOverTeam(team, partial, reducer);
  if constexpr (exahype2::terms::HasPostprocessUpdatedPatch<Derived, StoragePrecision>) {
    tarch::accelerator::teamBarrier(team);
    tarch::accelerator::parallelFor(team, tarch::accelerator::Range(1), [=]([[maybe_unused]] const int single) {
      Kernel::postprocessUpdatedPatch(patch, cellCentre, cellSize, stepStart, stepSize, parameters);
    });
    tarch::accelerator::teamBarrier(team);
    tarch::accelerator::parallelReduce(
      team,
      tarch::accelerator::Range(Kernel::VolumesPerPatch),
      [=](const int volume, double& eigenvalue) {
        eigenvalue = exahype2::MaxEigenvalueReduction::combine(
          eigenvalue,
          Kernel::getMaxEigenvalueOfVolume(
            volume,
            patch,
            cellCentre,
            cellSize,
            stepStart + stepSize,
            stepSize,
            parameters
          )
        );
      },
      reducer
    );
  }
}
TARGET_DECLARE_END
