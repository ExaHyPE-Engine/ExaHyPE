#include "exahype2/dg/Kernels.h"
#include "exahype2/dg/limiting/LimiterStatus.h"
#include "exahype2/fv/Kernels.h"
#include "tarch/accelerator/ParallelFor.h"
#include "tarch/accelerator/Range.h"
#include "tarch/accelerator/Scratch.h"

template <typename Derived, typename StoragePrecision, typename ComputePrecision>
INLINE_METHOD void
exahype2::fv::singlestep::SubcellStep<Derived, StoragePrecision, ComputePrecision>::rebuild(
  [[maybe_unused]] const peano4::CellConnectivity& cellConnectivity
) {}

template <typename Derived, typename StoragePrecision, typename ComputePrecision>
INLINE_METHOD void
exahype2::fv::singlestep::SubcellStep<Derived, StoragePrecision, ComputePrecision>::release() {
  _scratch.release();
}

template <typename Derived, typename StoragePrecision, typename ComputePrecision>
INLINE_METHOD tarch::AllocatedBytes
exahype2::fv::singlestep::SubcellStep<Derived, StoragePrecision, ComputePrecision>::getAllocatedBytes() const {
  return _scratch.getAllocatedBytes();
}

/**
 * Advances every cell of the region by one step on its subgrid. exchangeHalo(work) completes the
 * halo of the subgrids and calls work for the local and then for the remote cells.
 */
template <typename Derived, typename StoragePrecision, typename ComputePrecision>
template <typename ExchangeHalo>
INLINE_METHOD void
exahype2::fv::singlestep::SubcellStep<Derived, StoragePrecision, ComputePrecision>::advance(
  const peano4::CellConnectivity& cellConnectivity,
  const Region&            region,
  const ExchangeHalo&      exchangeHalo,
  const double             timeStamp,
  const double             timeStepSize
) {
  const auto scratchValues = static_cast<std::size_t>(tarch::accelerator::getNumberOfScratchChunks(region.cells.size))
                           * Kernel::SubcellValuesPerCell;
  if (_scratch.getSize() < scratchValues) {
    _scratch.allocate(scratchValues);
  }
  exchangeHalo([this, &cellConnectivity, &region, timeStamp, timeStepSize](const peano4::Adjacency adjacency) {
    const auto cells = region.getCells(adjacency);
    tarch::accelerator::parallelFor(
      tarch::accelerator::TeamRange(cells.size),
      exahype2::fv::singlestep::AdvanceSubgrids<Derived, StoragePrecision, ComputePrecision>{
        cellConnectivity.onDevice(),
        cells,
        region.subcells,
        region.halo,
        region.faceStatuses,
        region.appliedFluxes,
        Derived::template SubcellProjection<double>::NodesToSubcells1D,
        _scratch.getData(),
        timeStamp,
        timeStepSize
      }
    );
  });
}

TARGET_DECLARE
/**
 * Advances the subgrid by one step in place. Bit f of boundaryFaces is set when face f lies on the
 * domain boundary. appliedHalves[f] is the Galerkin flux of face f that the cell applies, or null
 * where the cell keeps the flux of its own update.
 */
template <typename Derived, typename StoragePrecision, typename ComputePrecision>
INLINE_METHOD GPU_CALLABLE_METHOD void
exahype2::fv::singlestep::SubcellStep<Derived, StoragePrecision, ComputePrecision>::advanceSubgrid(
  StoragePrecision* NOALIAS const              subcells,
  StoragePrecision* NOALIAS const              evolvedSubcells,
  const StoragePrecision* const                haloHalves[peano4::FacesPerCell],
  const tarch::la::Vector<DIMENSIONS, double>& cellCentre,
  const tarch::la::Vector<DIMENSIONS, double>& cellSize,
  const int                                    boundaryFaces,
  const double                                 timeStamp,
  const double                                 timeStepSize,
  const ComputePrecision* const                appliedHalves[peano4::FacesPerCell],
  const double* const                          nodesToSubcells
) {
  static_cast<void>(SubgridUpdate<>::update(
    subcells,
    evolvedSubcells,
    haloHalves,
    cellCentre,
    cellSize,
    timeStamp,
    timeStepSize,
    boundaryFaces
  ));
  for (int volume = 0; volume < Kernel::SubcellsPerCell; volume++) {
    imposeAppliedFluxes(
      volume,
      subcells,
      evolvedSubcells,
      haloHalves,
      cellCentre,
      cellSize,
      boundaryFaces,
      timeStamp,
      timeStepSize,
      appliedHalves,
      nodesToSubcells
    );
  }
  for (int value = 0; value < Kernel::SubcellValuesPerCell; value++) {
    subcells[value] = evolvedSubcells[value];
  }
}

/**
 * Runs advanceSubgrid() on a host thread and advanceSubgridWithThreadsOfTeam() on a device.
 */
template <typename Derived, typename StoragePrecision, typename ComputePrecision>
INLINE_METHOD GPU_CALLABLE_METHOD void
exahype2::fv::singlestep::SubcellStep<Derived, StoragePrecision, ComputePrecision>::advanceSubgridInTeam(
  [[maybe_unused]] const tarch::accelerator::TeamHandle team,
  StoragePrecision* NOALIAS const                       subcells,
  StoragePrecision* NOALIAS const                       evolvedSubcells,
  const StoragePrecision* const                         haloHalves[peano4::FacesPerCell],
  const tarch::la::Vector<DIMENSIONS, double>&          cellCentre,
  const tarch::la::Vector<DIMENSIONS, double>&          cellSize,
  const int                                             boundaryFaces,
  const double                                          timeStamp,
  const double                                          timeStepSize,
  const ComputePrecision* const                         appliedHalves[peano4::FacesPerCell],
  const double* const                                   nodesToSubcells
) {
  COMPILE_IF_ON_HOST(advanceSubgrid(
    subcells,
    evolvedSubcells,
    haloHalves,
    cellCentre,
    cellSize,
    boundaryFaces,
    timeStamp,
    timeStepSize,
    appliedHalves,
    nodesToSubcells
  );)
  COMPILE_IF_ON_DEVICE(advanceSubgridWithThreadsOfTeam(
    team,
    subcells,
    evolvedSubcells,
    haloHalves,
    cellCentre,
    cellSize,
    boundaryFaces,
    timeStamp,
    timeStepSize,
    appliedHalves,
    nodesToSubcells
  );)
}

/**
 * Advances the subgrid by one step in place with the threads of team, as advanceSubgrid() does.
 * The threads divide the subcells among themselves. Every thread updates its subcells into
 * evolvedSubcells without the ring of the reconstruction, imposes the applied fluxes on them and
 * copies them back once every thread has imposed its fluxes.
 */
template <typename Derived, typename StoragePrecision, typename ComputePrecision>
INLINE_METHOD GPU_CALLABLE_METHOD void
exahype2::fv::singlestep::SubcellStep<Derived, StoragePrecision, ComputePrecision>::advanceSubgridWithThreadsOfTeam(
  const tarch::accelerator::TeamHandle                  team,
  StoragePrecision* NOALIAS const                       subcells,
  StoragePrecision* NOALIAS const                       evolvedSubcells,
  const StoragePrecision* const                         haloHalves[peano4::FacesPerCell],
  const tarch::la::Vector<DIMENSIONS, double>&          cellCentre,
  const tarch::la::Vector<DIMENSIONS, double>&          cellSize,
  const int                                             boundaryFaces,
  const double                                          timeStamp,
  const double                                          timeStepSize,
  const ComputePrecision* const                         appliedHalves[peano4::FacesPerCell],
  const double* const                                   nodesToSubcells
) {
  const int thread  = tarch::accelerator::getThreadOfTeam(team);
  const int threads = tarch::accelerator::getNumberOfThreadsPerTeam(team);
  for (int subcell = thread; subcell < Kernel::SubcellsPerCell; subcell += threads) {
    static_cast<void>(SubgridUpdate<>::computeVolumeUpdate(
      subcell,
      subcells,
      haloHalves,
      cellCentre,
      cellSize,
      timeStamp,
      timeStepSize,
      boundaryFaces,
      evolvedSubcells + static_cast<std::ptrdiff_t>(subcell) * Kernel::NumberOfData
    ));
  }
  tarch::accelerator::teamBarrier(team);
  for (int volume = thread; volume < Kernel::SubcellsPerCell; volume += threads) {
    imposeAppliedFluxes(
      volume,
      subcells,
      evolvedSubcells,
      haloHalves,
      cellCentre,
      cellSize,
      boundaryFaces,
      timeStamp,
      timeStepSize,
      appliedHalves,
      nodesToSubcells
    );
  }
  // The corrections read the subcells that the copy overwrites.
  tarch::accelerator::teamBarrier(team);
  for (int subcell = thread; subcell < Kernel::SubcellsPerCell; subcell += threads) {
    for (int value = subcell * Kernel::NumberOfData; value < (subcell + 1) * Kernel::NumberOfData; value++) {
      subcells[value] = evolvedSubcells[value];
    }
  }
  // The next kernel reads every subcell of the team. Every thread finishes its copy first.
  tarch::accelerator::teamBarrier(team);
}

/**
 * Replaces, in the evolved state of one volume, the flux of every patch face with an applied
 * Galerkin flux by the average of that flux over the volume face. The update with the
 * reconstruction of Derived applied the flux that PatchUpdate::computePatchFaceFlux()
 * evaluates from the subcells and the halo. Entry [galerkinNode][subcell] of nodesToSubcells averages
 * the Galerkin basis function galerkinNode over a subcell along one tangential axis.
 */
template <typename Derived, typename StoragePrecision, typename ComputePrecision>
INLINE_METHOD GPU_CALLABLE_METHOD void
exahype2::fv::singlestep::SubcellStep<Derived, StoragePrecision, ComputePrecision>::imposeAppliedFluxes(
  const int                                    volume,
  const StoragePrecision* NOALIAS const        subcells,
  StoragePrecision* NOALIAS const              evolvedSubcells,
  const StoragePrecision* const                haloHalves[peano4::FacesPerCell],
  const tarch::la::Vector<DIMENSIONS, double>& cellCentre,
  const tarch::la::Vector<DIMENSIONS, double>& cellSize,
  const int                                    boundaryFaces,
  const double                                 timeStamp,
  const double                                 timeStepSize,
  const ComputePrecision* const                appliedHalves[peano4::FacesPerCell],
  const double* const                          nodesToSubcells
) {
  constexpr int GalerkinNodesPerAxis = Kernel::NodesPerAxis;
  constexpr int GalerkinNodesPerFace = exahype2::dg::getNodesPerFace(GalerkinNodesPerAxis);
  const auto    index                = peano4::dDelinearised(volume, Kernel::SubcellsPerAxis);
  for (int face = 0; face < peano4::FacesPerCell; face++) {
    const int normal = face % DIMENSIONS;
    const int side   = face / DIMENSIONS;
    if (appliedHalves[face] == nullptr or index(normal) != (side == 0 ? 0 : Kernel::SubcellsPerAxis - 1)) {
      continue;
    }
    ComputePrecision ownFlux[Kernel::NumberOfUnknowns];
    SubgridUpdate<>::computePatchFaceFlux(
      volume,
      subcells,
      haloHalves,
      cellCentre,
      cellSize,
      timeStamp,
      timeStepSize,
      boundaryFaces,
      face,
      ownFlux
    );
    double average[Kernel::NumberOfUnknowns]{};
    for (int galerkinNode = 0; galerkinNode < GalerkinNodesPerFace; galerkinNode++) {
      const auto node   = peano4::dDelinearisedExclusive(galerkinNode, GalerkinNodesPerAxis, normal);
      double     weight = 1.0;
      for (int axis = 0; axis < DIMENSIONS; axis++) {
        if (axis != normal) {
          weight *= nodesToSubcells[node(axis) * Kernel::SubcellsPerAxis + index(axis)];
        }
      }
      for (int unknown = 0; unknown < Kernel::NumberOfUnknowns; unknown++) {
        average[unknown] +=
          weight * static_cast<double>(appliedHalves[face][galerkinNode * Kernel::NumberOfUnknowns + unknown]);
      }
    }
    const double scale = (side == 0 ? 1.0 : -1.0) * timeStepSize * Kernel::SubcellsPerAxis / cellSize(normal);
    StoragePrecision* const state = evolvedSubcells + static_cast<std::ptrdiff_t>(volume) * Kernel::NumberOfData;
    for (int unknown = 0; unknown < Kernel::NumberOfUnknowns; unknown++) {
      state[unknown] = static_cast<StoragePrecision>(
        static_cast<double>(state[unknown]) + scale * (average[unknown] - static_cast<double>(ownFlux[unknown]))
      );
    }
  }
}

template <typename Derived, typename StoragePrecision, typename ComputePrecision>
INLINE_METHOD GPU_CALLABLE_METHOD void
exahype2::fv::singlestep::AdvanceSubgrids<Derived, StoragePrecision, ComputePrecision>::operator()(
  const int                                             entry,
  [[maybe_unused]] const tarch::accelerator::TeamHandle team
) const {
  const int               slot = cells[entry];
  const StoragePrecision* haloHalves[peano4::FacesPerCell];
  for (int faceNumber = 0; faceNumber < peano4::FacesPerCell; faceNumber++) {
    haloHalves[faceNumber] = halo.getChunk(cellConnectivity.getCellFace(slot, faceNumber));
  }
  const ComputePrecision* appliedHalves[peano4::FacesPerCell];
  for (int faceNumber = 0; faceNumber < peano4::FacesPerCell; faceNumber++) {
    const int        face   = cellConnectivity.getCellFace(slot, faceNumber);
    const int        own    = exahype2::dg::getOwnHalf(faceNumber);
    const int* const status = faceStatuses.getChunk(face);
    const bool       outer  = appliedFluxes.segments != nullptr
                       and exahype2::dg::getBoundaryFaceNumber(cellConnectivity, face) < 0
                       and not exahype2::dg::limiting::runsSubcellScheme(
                         static_cast<exahype2::dg::limiting::LimiterStatus>(status[1 - own])
                       );
    appliedHalves[faceNumber] = outer ? appliedFluxes.getChunk(face)
                                          + exahype2::dg::getCorrectionHalf(cellConnectivity, face, faceNumber)
                                              * (Step::Kernel::AppliedFluxValuesPerFace / 2)
                                      : nullptr;
  }
  StoragePrecision* const evolvedSubcells =
    scratch + static_cast<std::ptrdiff_t>(tarch::accelerator::getScratchChunk(entry)) * Step::Kernel::SubcellValuesPerCell;
  Step::advanceSubgridInTeam(
    team,
    subcells.getChunk(slot),
    evolvedSubcells,
    haloHalves,
    cellConnectivity.getCellCentre(slot),
    cellConnectivity.getCellWidth(slot),
    exahype2::fv::getBoundaryFaceMask(cellConnectivity, slot),
    timeStamp,
    timeStepSize,
    appliedHalves,
    nodesToSubcells
  );
}
TARGET_DECLARE_END
