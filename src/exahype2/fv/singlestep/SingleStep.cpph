#include "exahype2/fv/Patch.h"
#include "peano4/Loop.h"
#include "tarch/Assertions.h"

TARGET_DECLARE
/**
 * Advances one volume of inputPatch into the NumberOfData values of updatedState outside
 * inputPatch and returns the largest wave speed of the update. volume is the linearised index of
 * the volume with the first axis fastest and bit f of boundaryFaces marks face f of the patch on
 * the domain boundary. terms is the ring of the reconstruction or a NoTermRing.
 */
template <
  typename Reconstruction,
  typename SolverType,
  int  NumberOfVolumesPerAxis,
  int  NumberOfUnknowns,
  int  NumberOfAuxiliaryVariables,
  bool EvaluateFlux,
  bool EvaluateNonconservativeProduct,
  bool EvaluateSource,
  bool EvaluateDiffusiveSource,
  bool EvaluateCustomRiemann,
  bool EvaluateMaxEigenvalue,
  typename StoragePrecision,
  typename ComputePrecision,
  typename Terms
>
INLINE_METHOD GPU_CALLABLE_METHOD double
exahype2::fv::singlestep::SingleStep::applyToVolume(
  const int                                    volume,
  const StoragePrecision* NOALIAS const        inputPatch,
  const StoragePrecision* NOALIAS const        faceInputPatches[peano4::FacesPerCell],
  const tarch::la::Vector<DIMENSIONS, double>& patchCentre,
  const tarch::la::Vector<DIMENSIONS, double>& patchSize,
  const double                                 timeStamp,
  const double                                 timeStepSize,
  const int                                    boundaryFaces,
  Terms&                                       terms,
  StoragePrecision* NOALIAS const              updatedState
) {
  constexpr int NumberOfData = NumberOfUnknowns + NumberOfAuxiliaryVariables;
  assertion(inputPatch != nullptr);
  assertion(updatedState != nullptr);

  double maxEigenvalueAfterTimeStep = 0.0;

  const tarch::la::Vector<DIMENSIONS, int> volumeIndex = peano4::dDelinearised(volume, NumberOfVolumesPerAxis);
  const auto                               volumeSize  = exahype2::fv::getVolumeSize(patchSize, NumberOfVolumesPerAxis);
  const auto volumeCentre = exahype2::fv::getVolumeCentre(patchCentre, patchSize, NumberOfVolumesPerAxis, volumeIndex);

  const int                             centreOffset = volume * NumberOfData;
  const StoragePrecision* NOALIAS const inputState   = &inputPatch[centreOffset];
  StoragePrecision* NOALIAS const       outputState  = updatedState;

#if defined(PEANO_WITH_GPU_BACKEND)
  StoragePrecision centreState[NumberOfData] __attribute__((aligned(PEANO_WITH_ALIGNMENT)));
  SIMD(aligned(centreState : PEANO_WITH_ALIGNMENT))
  for (int unknown = 0; unknown < NumberOfData; unknown++) {
    centreState[unknown] = inputState[unknown];
  }
#else
  const StoragePrecision* NOALIAS const centreState = inputState;
#endif

  SIMD()
  for (int unknown = 0; unknown < NumberOfData; unknown++) {
    outputState[unknown] = centreState[unknown];
  }

  if constexpr (EvaluateSource) {
    using TimeUpdatePrecision = decltype(StoragePrecision{} + ComputePrecision{} * double{});
    [[maybe_unused]] ComputePrecision centreStateComputeBuffer[NumberOfData]
      __attribute__((aligned(PEANO_WITH_ALIGNMENT)));
    const ComputePrecision* NOALIAS centreStateForCompute;
    if constexpr (std::is_same_v<StoragePrecision, ComputePrecision>) {
      centreStateForCompute = centreState;
    } else {
      SIMD(aligned(centreStateComputeBuffer : PEANO_WITH_ALIGNMENT))
      for (int unknown = 0; unknown < NumberOfData; unknown++) {
        centreStateComputeBuffer[unknown] = static_cast<ComputePrecision>(centreState[unknown]);
      }
      centreStateForCompute = centreStateComputeBuffer;
    }
    ComputePrecision sources[NumberOfUnknowns] __attribute__((aligned(PEANO_WITH_ALIGNMENT)));
    SolverType::sourceTerm(centreStateForCompute, volumeCentre, volumeSize, timeStamp, timeStepSize, sources);
    SIMD(aligned(sources : PEANO_WITH_ALIGNMENT))
    for (int unknown = 0; unknown < NumberOfUnknowns; unknown++) {
      outputState[unknown] = static_cast<StoragePrecision>(
        static_cast<TimeUpdatePrecision>(outputState[unknown])
        + static_cast<TimeUpdatePrecision>(timeStepSize) * static_cast<TimeUpdatePrecision>(sources[unknown])
      );
    }
  }

  Reconstruction::template accumulateFluxDivergence<
    SolverType,
    NumberOfVolumesPerAxis,
    NumberOfUnknowns,
    NumberOfAuxiliaryVariables,
    EvaluateFlux,
    EvaluateNonconservativeProduct,
    EvaluateSource,
    EvaluateDiffusiveSource,
    EvaluateCustomRiemann,
    EvaluateMaxEigenvalue,
    StoragePrecision,
    ComputePrecision
  >(inputPatch,
    faceInputPatches,
    volumeIndex,
    centreOffset,
    centreState,
    patchCentre,
    patchSize,
    volumeCentre,
    volumeSize,
    timeStamp,
    timeStepSize,
    boundaryFaces,
    outputState,
    maxEigenvalueAfterTimeStep,
    terms);

  return maxEigenvalueAfterTimeStep;
}
TARGET_DECLARE_END
