/**
 * Returns an enumerator over the faces of one cell, with face number zero at the first entry of
 * faces.
 */
template <typename Element>
INLINE_METHOD peano4::dataview::FaceEnumerator<Element> exahype2::fv::tests::enumerateFaces(
  std::array<Element, peano4::FacesPerCell>& faces
) {
  std::array<int, peano4::FacesPerCell> slots{};
  for (int faceNumber = 0; faceNumber < peano4::FacesPerCell; faceNumber++) {
    slots[faceNumber] = faceNumber;
  }
  return peano4::dataview::FaceEnumerator<Element>(faces.data(), slots.data(), 0);
}

