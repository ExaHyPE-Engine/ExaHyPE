TARGET_DECLARE
INLINE_METHOD GPU_CALLABLE_METHOD void exahype2::fv::tests::StubSolver::boundaryConditions(
  const double* NOALIAS const                                   insideState,
  double* NOALIAS const                                         outsideState,
  const tarch::la::Vector<DIMENSIONS, double>&                  position,
  [[maybe_unused]] const tarch::la::Vector<DIMENSIONS, double>& volumeSize,
  const double                                                  timeStamp,
  const int                                                     normal
) {
  for (int value = 0; value < DeviceKernelSetup::Data; value++) {
    outsideState[value] = -insideState[value] + position(normal) + timeStamp;
  }
}

INLINE_METHOD GPU_CALLABLE_METHOD double exahype2::fv::tests::StubSolver::maxEigenvalue(
  const double* NOALIAS const                                   state,
  const tarch::la::Vector<DIMENSIONS, double>&                  position,
  [[maybe_unused]] const tarch::la::Vector<DIMENSIONS, double>& volumeSize,
  [[maybe_unused]] const double                                 timeStamp,
  [[maybe_unused]] const double                                 timeStepSize,
  const int                                                     normal
) {
  return 0.5 + std::fabs(state[0]) + 0.25 * normal + 0.125 * std::fabs(position(0));
}

INLINE_METHOD GPU_CALLABLE_METHOD void exahype2::fv::tests::StubSolver::flux(
  const double* NOALIAS const                                   state,
  const tarch::la::Vector<DIMENSIONS, double>&                  position,
  [[maybe_unused]] const tarch::la::Vector<DIMENSIONS, double>& volumeSize,
  [[maybe_unused]] const double                                 timeStamp,
  [[maybe_unused]] const double                                 timeStepSize,
  const int                                                     normal,
  double* NOALIAS const                                         fluxes
) {
  for (int unknown = 0; unknown < DeviceKernelSetup::Unknowns; unknown++) {
    fluxes[unknown] = state[unknown] * (1.0 + normal) + position(0);
  }
}

INLINE_METHOD GPU_CALLABLE_METHOD void exahype2::fv::tests::StubSolver::sourceTerm(
  const double* NOALIAS const                                   state,
  const tarch::la::Vector<DIMENSIONS, double>&                  position,
  [[maybe_unused]] const tarch::la::Vector<DIMENSIONS, double>& volumeSize,
  [[maybe_unused]] const double                                 timeStamp,
  [[maybe_unused]] const double                                 timeStepSize,
  double* NOALIAS const                                         sources
) {
  for (int unknown = 0; unknown < DeviceKernelSetup::Unknowns; unknown++) {
    sources[unknown] = 0.5 * state[unknown] - position(0);
  }
}

INLINE_METHOD GPU_CALLABLE_METHOD void exahype2::fv::tests::StubSolver::diffusiveSourceTerm(
  const double* NOALIAS const                                   state,
  const double* NOALIAS const                                   stateGradient,
  const tarch::la::Vector<DIMENSIONS, double>&                  position,
  [[maybe_unused]] const tarch::la::Vector<DIMENSIONS, double>& volumeSize,
  [[maybe_unused]] const double                                 timeStamp,
  [[maybe_unused]] const double                                 timeStepSize,
  double* NOALIAS const                                         sources
) {
  for (int unknown = 0; unknown < DeviceKernelSetup::Unknowns; unknown++) {
    sources[unknown] = 0.25 * state[unknown] + position(0);
    for (int axis = 0; axis < DIMENSIONS; axis++) {
      sources[unknown] += (0.5 + axis) * stateGradient[axis * DeviceKernelSetup::Unknowns + unknown];
    }
  }
}

INLINE_METHOD GPU_CALLABLE_METHOD void exahype2::fv::tests::StubSolver::nonconservativeProduct(
  const double* NOALIAS const                                   averageState,
  const double* NOALIAS const                                   stateJump,
  const tarch::la::Vector<DIMENSIONS, double>&                  position,
  [[maybe_unused]] const tarch::la::Vector<DIMENSIONS, double>& volumeSize,
  [[maybe_unused]] const double                                 timeStamp,
  [[maybe_unused]] const double                                 timeStepSize,
  const int                                                     normal,
  double* NOALIAS const                                         values
) {
  for (int unknown = 0; unknown < DeviceKernelSetup::Unknowns; unknown++) {
    values[unknown] = stateJump[unknown] * (1.0 + 0.5 * normal) + averageState[unknown] + position(0);
  }
}

INLINE_METHOD GPU_CALLABLE_METHOD double exahype2::fv::tests::StubSolver::solveRiemannProblem(
  const double* NOALIAS const                                   leftState,
  const double* NOALIAS const                                   rightState,
  const tarch::la::Vector<DIMENSIONS, double>&                  faceCentre,
  [[maybe_unused]] const tarch::la::Vector<DIMENSIONS, double>& volumeSize,
  [[maybe_unused]] const double                                 timeStamp,
  [[maybe_unused]] const double                                 timeStepSize,
  const int                                                     normal,
  double* NOALIAS const                                         leftGoingFlux,
  double* NOALIAS const                                         rightGoingFlux
) {
  for (int unknown = 0; unknown < DeviceKernelSetup::Unknowns; unknown++) {
    const double centralFlux = 0.5 * (leftState[unknown] + rightState[unknown]) * (1.0 + normal) + faceCentre(0);
    const double diffusion   = 0.5 * (rightState[unknown] - leftState[unknown]);
    leftGoingFlux[unknown]   = centralFlux - diffusion;
    rightGoingFlux[unknown]  = centralFlux + diffusion;
  }
  return 1.0 + 0.25 * normal + std::fabs(leftState[0]);
}
TARGET_DECLARE_END

template <typename T>
INLINE_METHOD exahype2::fv::tests::DeviceBuffer<T>::DeviceBuffer(const std::vector<T>& hostData) :
  _count(hostData.size()),
  _data(tarch::allocateMemory<T>(_count, tarch::MemoryLocation::Device)) {
  tarch::copyTo(_data.get(), hostData.data(), _count, tarch::MemoryLocation::Device);
}

template <typename T>
INLINE_METHOD T* exahype2::fv::tests::DeviceBuffer<T>::data() const {
  return _data.get();
}

template <typename T>
INLINE_METHOD void exahype2::fv::tests::DeviceBuffer<T>::copyBack(std::vector<T>& target) const {
  tarch::copyFrom(_data.get(), target.data(), _count, tarch::MemoryLocation::Device);
}
