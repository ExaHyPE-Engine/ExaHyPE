TARGET_DECLARE
template <int NumberOfDofsPerAxis, int Overlap, int NumberOfUnknowns, typename T>
INLINE_METHOD GPU_CALLABLE_METHOD void exahype2::fv::clearFacePatch(T* NOALIAS const faceValues) {
  exahype2::amr::clearTransferBuffer(
    faceValues,
    2 * Overlap * exahype2::fv::ValuesPerFaceLayer<NumberOfDofsPerAxis, NumberOfUnknowns>
  );
}

template <int NumberOfDofsPerAxis, int NumberOfUnknowns, typename T>
INLINE_METHOD GPU_CALLABLE_METHOD void exahype2::fv::clearCellPatch(T* NOALIAS const cellValues) {
  exahype2::amr::clearTransferBuffer(
    cellValues,
    exahype2::fv::ValuesPerCellPatch<NumberOfDofsPerAxis, NumberOfUnknowns>
  );
}
TARGET_DECLARE_END

/**
 * Fills the halo layer a hanging face takes from the coarse face.
 *
 * The hanging face lies on the side of the coarse cell that its selected face number
 * names, so one side of the face patch is interpolated and the other one stays with
 * whatever the adjacent fine cell projects into it.
 */
template <int NumberOfDofsPerAxis, int NumberOfUnknowns, typename T, typename FaceLabel>
INLINE_METHOD void exahype2::fv::interpolateHangingFace(
  const peano4::dataview::FaceMarker& marker,
  const T* NOALIAS                    coarseFaceValues,
  T* NOALIAS                          fineFaceValues,
  const FaceLabel&                    coarseFaceLabel,
  FaceLabel&                          fineFaceLabel
) {
  const int side = marker.getSelectedFaceNumber() < DIMENSIONS ? 0 : 1;
  exahype2::amr::interpolateFaceFromCoarseFace(
    marker,
    coarseFaceValues,
    fineFaceValues,
    side,
    exahype2::fv::FaceHaloInterpolation<T>(NumberOfDofsPerAxis, NumberOfUnknowns)
  );
  exahype2::amr::copyFaceTimeStampsFromCoarseFace(coarseFaceLabel, fineFaceLabel, side);
}

/**
 * Stages the halo layer this hanging face carries for the coarse face above it.
 *
 * Across a level jump of two or more this face carries staged subfaces of its own, and
 * they reduce first, so the chained restriction is complete before the face stages itself.
 */
template <int NumberOfDofsPerAxis, int NumberOfUnknowns, typename T, typename FaceLabel>
INLINE_METHOD void exahype2::fv::restrictHangingFace(
  const peano4::dataview::FaceMarker& marker,
  exahype2::amr::ChildDataStage<T>&   stage,
  const T* NOALIAS                    coarseFaceValues,
  T* NOALIAS                          fineFaceValues,
  FaceLabel&                          coarseFaceLabel,
  const FaceLabel&                    fineFaceLabel
) {
  const int facePosition = marker.getSelectedFaceNumber() < DIMENSIONS ? 1 : 0;
  const int normal       = marker.getSelectedFaceNumber() % DIMENSIONS;
  exahype2::amr::restrictFaceFromStagedSubfaces(
    stage,
    fineFaceValues + facePosition,
    fineFaceValues,
    exahype2::fv::FaceHaloRestriction<T>(normal, NumberOfDofsPerAxis, NumberOfUnknowns)
  );
  exahype2::amr::stageHaloLayerForGatheredRestriction(
    marker,
    stage,
    coarseFaceValues + facePosition,
    fineFaceValues,
    facePosition,
    NumberOfDofsPerAxis,
    NumberOfUnknowns
  );
  exahype2::amr::raiseUpdatedTimeStampOntoCoarseFace(coarseFaceLabel, fineFaceLabel, facePosition);
}

/**
 * Reduces the subfaces staged below either side of this face.
 *
 * The last touch of every subface precedes the last touch of this face, so the staged
 * set is complete apart from subfaces other ranks hold.
 */
template <int NumberOfDofsPerAxis, int NumberOfUnknowns, typename T>
INLINE_METHOD void exahype2::fv::restrictFaceHalves(
  const peano4::dataview::FaceMarker& marker,
  exahype2::amr::ChildDataStage<T>&   stage,
  T* NOALIAS                          fineFaceValues
) {
  const int normal = marker.getSelectedFaceNumber() % DIMENSIONS;
  for (int facePosition = 0; facePosition < 2; facePosition++) {
    exahype2::amr::restrictFaceFromStagedSubfaces(
      stage,
      fineFaceValues + facePosition,
      fineFaceValues,
      exahype2::fv::FaceHaloRestriction<T>(normal, NumberOfDofsPerAxis, NumberOfUnknowns)
    );
  }
}

/**
 * Zeroes the face patches of a coarsening parent and flags both halves for transfer.
 *
 * The clear also overwrites the half a surviving equal-level neighbour projected. Each
 * side's projection completes its half and takes its flag back down.
 */
template <int NumberOfDofsPerAxis, int Overlap, int NumberOfUnknowns, typename T, typename FaceLabel>
INLINE_METHOD void exahype2::fv::clearCoarseningFace(
  const peano4::dataview::FaceMarker& marker,
  FaceLabel&                          fineFaceLabel,
  T* NOALIAS                          fineFaceValuesNew,
  T* NOALIAS                          fineFaceValuesOld
) {
  if (marker.hasBeenRefined() and not marker.willBeRefined()) {
    fineFaceLabel.setRequiresDataTransfer(0, true);
    fineFaceLabel.setRequiresDataTransfer(1, true);
    exahype2::fv::clearFacePatch<NumberOfDofsPerAxis, Overlap, NumberOfUnknowns>(fineFaceValuesNew);
    exahype2::fv::clearFacePatch<NumberOfDofsPerAxis, Overlap, NumberOfUnknowns>(fineFaceValuesOld);
  }
}

/**
 * Zeroes the cell patches of a coarsening parent before its children restrict into them.
 */
template <int NumberOfDofsPerAxis, int NumberOfUnknowns, typename T>
INLINE_METHOD void exahype2::fv::clearCoarseningCell(
  const peano4::dataview::CellMarker& marker,
  T* NOALIAS                          fineCellValuesNew,
  T* NOALIAS                          fineCellValuesOld
) {
  if (marker.hasBeenRefined() and not marker.willBeRefined()) {
    exahype2::fv::clearCellPatch<NumberOfDofsPerAxis, NumberOfUnknowns>(fineCellValuesNew);
    exahype2::fv::clearCellPatch<NumberOfDofsPerAxis, NumberOfUnknowns>(fineCellValuesOld);
  }
}

/**
 * Reduces the subfaces every destroyed child staged into either side of this face.
 *
 * A half whose transfer flag is still up takes its content from the staged subfaces,
 * and a half that a projection completed discards its staged subfaces, so each half
 * has one writer.
 */
template <int NumberOfDofsPerAxis, int NumberOfUnknowns, typename T, typename FaceLabel>
INLINE_METHOD void exahype2::fv::restrictCoarseningFaceHalves(
  const peano4::dataview::FaceMarker& marker,
  exahype2::amr::ChildDataStage<T>&   stageNew,
  exahype2::amr::ChildDataStage<T>&   stageOld,
  T* NOALIAS                          fineFaceValuesNew,
  T* NOALIAS                          fineFaceValuesOld,
  FaceLabel&                          fineFaceLabel
) {
  const int normal = marker.getSelectedFaceNumber() % DIMENSIONS;
  for (int facePosition = 0; facePosition < 2; facePosition++) {
    if (stageNew.hasFrame(fineFaceValuesNew + facePosition)) {
      if (fineFaceLabel.getRequiresDataTransfer(facePosition)) {
        const exahype2::fv::FaceHaloRestriction<T> restrictFace(normal, NumberOfDofsPerAxis, NumberOfUnknowns);
        restrictFace(stageNew, fineFaceValuesNew + facePosition, fineFaceValuesNew);
        restrictFace(stageOld, fineFaceValuesOld + facePosition, fineFaceValuesOld);
        fineFaceLabel.setUpdated(facePosition, true);
        fineFaceLabel.setRequiresDataTransfer(facePosition, false);
      } else {
        stageNew.discard(fineFaceValuesNew + facePosition);
        stageOld.discard(fineFaceValuesOld + facePosition);
      }
    }
  }
}

/**
 * Fills both sides of a created face.
 *
 * A face inside the parent patch has no coarse face above it and takes its halo from
 * the volumes of the parent cell; every other face takes it from the coarse face it
 * subdivides.
 */
template <int NumberOfDofsPerAxis, int NumberOfUnknowns, typename T, typename CellLabel, typename FaceLabel>
INLINE_METHOD void exahype2::fv::createFace(
  const peano4::dataview::FaceMarker& marker,
  const T* NOALIAS                    coarseCellValuesOld,
  const T* NOALIAS                    coarseCellValuesNew,
  const T* NOALIAS                    coarseFaceValuesOld,
  const T* NOALIAS                    coarseFaceValuesNew,
  T* NOALIAS                          fineFaceValuesOld,
  T* NOALIAS                          fineFaceValuesNew,
  const CellLabel&                    coarseCellLabel,
  FaceLabel&                          fineFaceLabel
) {
  if (marker.isInteriorFaceWithinPatch()) {
    for (int side = 0; side < 2; side++) {
      exahype2::amr::interpolateHaloLayerFromCoarseCell(
        marker,
        coarseCellValuesOld,
        fineFaceValuesOld,
        side,
        NumberOfDofsPerAxis,
        NumberOfUnknowns
      );
      exahype2::amr::interpolateHaloLayerFromCoarseCell(
        marker,
        coarseCellValuesNew,
        fineFaceValuesNew,
        side,
        NumberOfDofsPerAxis,
        NumberOfUnknowns
      );
    }
  } else {
    const exahype2::fv::FaceHaloInterpolation<T> interpolateFace(NumberOfDofsPerAxis, NumberOfUnknowns);
    for (int side = 0; side < 2; side++) {
      interpolateFace(marker, coarseFaceValuesOld, fineFaceValuesOld, side);
      interpolateFace(marker, coarseFaceValuesNew, fineFaceValuesNew, side);
    }
  }
  exahype2::amr::setFaceTimeStampsFromCoarseCell(coarseCellLabel, fineFaceLabel);
}

/**
 * Stages both halo layers of a destroyed face for the face above it.
 *
 * The coarse face's last touch reduces the halves whose transfer flag is still up.
 */
template <int NumberOfDofsPerAxis, int NumberOfUnknowns, typename T, typename FaceLabel>
INLINE_METHOD void exahype2::fv::destroyFace(
  const peano4::dataview::FaceMarker&          marker,
  exahype2::amr::ChildDataStage<T>&            stageNew,
  exahype2::amr::ChildDataStage<T>&            stageOld,
  const T* NOALIAS                             coarseFaceValuesNew,
  const T* NOALIAS                             coarseFaceValuesOld,
  const T* NOALIAS                             fineFaceValuesNew,
  const T* NOALIAS                             fineFaceValuesOld,
  FaceLabel&                                   coarseFaceLabel,
  const FaceLabel&                             fineFaceLabel,
  const tarch::la::Vector<DIMENSIONS, double>& domainOffset,
  const tarch::la::Vector<DIMENSIONS, double>& domainSize
) {
  if (marker.isInteriorFaceWithinPatch()) {
    return;
  }
  for (int facePosition = 0; facePosition < 2; facePosition++) {
    exahype2::amr::stageHaloLayerForGatheredRestriction(
      marker,
      stageNew,
      coarseFaceValuesNew + facePosition,
      fineFaceValuesNew,
      facePosition,
      NumberOfDofsPerAxis,
      NumberOfUnknowns
    );
    exahype2::amr::stageHaloLayerForGatheredRestriction(
      marker,
      stageOld,
      coarseFaceValuesOld + facePosition,
      fineFaceValuesOld,
      facePosition,
      NumberOfDofsPerAxis,
      NumberOfUnknowns
    );
  }
  coarseFaceLabel.setBoundary(exahype2::amr::isOnDomainBoundary(marker, domainOffset, domainSize));
  exahype2::amr::raiseFaceTimeStampsOntoCoarseFace(coarseFaceLabel, fineFaceLabel);
}

/**
 * Fills both cell patches of a created child from its parent.
 */
template <int NumberOfDofsPerAxis, int NumberOfUnknowns, typename T, typename CellLabel>
INLINE_METHOD void exahype2::fv::createCell(
  const peano4::dataview::CellMarker& marker,
  const T* NOALIAS                    coarseCellValuesNew,
  T* NOALIAS                          fineCellValuesNew,
  const T* NOALIAS                    coarseCellValuesOld,
  T* NOALIAS                          fineCellValuesOld,
  const CellLabel&                    coarseCellLabel,
  CellLabel&                          fineCellLabel
) {
  const exahype2::amr::CellAveragingInterpolation<T> prolongCell(NumberOfDofsPerAxis, NumberOfUnknowns);
  exahype2::amr::prolongCellIntoChild(marker, coarseCellValuesNew, fineCellValuesNew, prolongCell);
  exahype2::amr::prolongCellIntoChild(marker, coarseCellValuesOld, fineCellValuesOld, prolongCell);

#if PEANO_DEBUG
  exahype2::fv::validatePatch(
    fineCellValuesNew,
    NumberOfUnknowns,
    0,
    NumberOfDofsPerAxis,
    0,
    std::string(__FILE__) + "(" + std::to_string(__LINE__) + "): " + marker.toString()
  );
  exahype2::fv::validatePatch(
    fineCellValuesOld,
    NumberOfUnknowns,
    0,
    NumberOfDofsPerAxis,
    0,
    std::string(__FILE__) + "(" + std::to_string(__LINE__) + "): " + marker.toString()
  );
#endif

  exahype2::amr::copyCellLabelIntoChild(coarseCellLabel, fineCellLabel);
}

/**
 * Stages both cell patches of a destroyed child and reduces the complete sibling set.
 *
 * The load balancer places no rank boundary inside a cell that has a leaf child, so
 * the set always completes on one rank.
 */
template <int NumberOfDofsPerAxis, int NumberOfUnknowns, typename T, typename CellLabel>
INLINE_METHOD void exahype2::fv::destroyCell(
  const peano4::dataview::CellMarker& marker,
  exahype2::amr::ChildDataStage<T>&   stageNew,
  exahype2::amr::ChildDataStage<T>&   stageOld,
  T* NOALIAS                          coarseCellValuesNew,
  const T* NOALIAS                    fineCellValuesNew,
  T* NOALIAS                          coarseCellValuesOld,
  const T* NOALIAS                    fineCellValuesOld,
  CellLabel&                          coarseCellLabel,
  const CellLabel&                    fineCellLabel
) {
  const exahype2::amr::CellAveragingRestriction<T> restrictCell(NumberOfDofsPerAxis, NumberOfUnknowns);
  exahype2::amr::stageChildForRestriction(marker, stageOld, coarseCellValuesOld, fineCellValuesOld);
  if (exahype2::amr::restrictChildrenIntoCell(marker, stageNew, coarseCellValuesNew, fineCellValuesNew, restrictCell)) {
    exahype2::amr::restrictStagedChildrenIntoCell(stageOld, coarseCellValuesOld, restrictCell);

#if PEANO_DEBUG
    exahype2::fv::validatePatch(
      coarseCellValuesNew,
      NumberOfUnknowns,
      0,
      NumberOfDofsPerAxis,
      0,
      std::string(__FILE__) + "(" + std::to_string(__LINE__) + "): " + marker.toString()
    );
    exahype2::fv::validatePatch(
      coarseCellValuesOld,
      NumberOfUnknowns,
      0,
      NumberOfDofsPerAxis,
      0,
      std::string(__FILE__) + "(" + std::to_string(__LINE__) + "): " + marker.toString()
    );
#endif
  }
  exahype2::amr::mergeCellLabelFromChild(coarseCellLabel, fineCellLabel);
}

/**
 * Projects a cell patch onto its faces once the transfer has changed a face half.
 *
 * The interpolated or restricted content of a face half differs from the boundary
 * volumes of the cell that owns it, so the owner projects its patch onto that half
 * again. The criterion pass of this sweep runs before this projection and has
 * evaluated any freshly created cell by now.
 */
template <
  int NumberOfDofsPerAxis,
  int Overlap,
  int NumberOfUnknowns,
  typename T,
  typename CellLabel,
  typename FaceDataEnumerator,
  typename FaceLabelEnumerator>
INLINE_METHOD void exahype2::fv::projectPatchAfterTransfer(
  const peano4::dataview::CellMarker& marker,
  const T* NOALIAS                    cellValuesNew,
  const FaceDataEnumerator&           fineFaceValuesNew,
  const FaceLabelEnumerator&          fineFaceLabels,
  CellLabel&                          fineCellLabel
) {
  if (not exahype2::amr::awaitsDataTransfer(marker, fineFaceLabels)) {
    return;
  }

  T* facesOut[peano4::FacesPerCell];
  for (int face = 0; face < peano4::FacesPerCell; face++) {
    facesOut[face] = fineFaceValuesNew(face).data();
  }
  exahype2::projectPatch<NumberOfDofsPerAxis, Overlap, NumberOfUnknowns, T>(cellValuesNew, facesOut);

  exahype2::amr::markOwnSidesUpdated(fineFaceLabels, fineCellLabel.getTimeStamp());
  exahype2::amr::releaseDataTransferOnOwnSides(fineFaceLabels);
  fineCellLabel.setRequiresCriterionEvaluation(false);
}
