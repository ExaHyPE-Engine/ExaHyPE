TARGET_DECLARE

template <int Dimensions, int NumberOfVolumesPerAxisInPatch>
INLINE_METHOD GPU_CALLABLE_METHOD exahype2::fv::VolumeSizeAndCentre<Dimensions> exahype2::fv::getVolumeSizeAndCentre(
  const tarch::la::Vector<Dimensions, double>& x,
  const tarch::la::Vector<Dimensions, double>& h,
  const tarch::la::Vector<Dimensions, int>&    index
) {
  static_assert(NumberOfVolumesPerAxisInPatch >= 1, "NumberOfVolumesPerAxisInPatch must be >= 1");

  tarch::la::Vector<Dimensions, double> size;
  tarch::la::Vector<Dimensions, double> centre;

  const auto* cellCentreData  = x.data();
  const auto* cellSizeData    = h.data();
  const auto* volumeIndexData = index.data();

  auto* volumeSizeData   = size.data();
  auto* volumeCentreData = centre.data();

  constexpr double InverseVolumesPerAxis = 1.0 / NumberOfVolumesPerAxisInPatch;

  UNROLL(Dimensions)
  for (int axis = 0; axis < Dimensions; axis++) {
    const double volumeSize = cellSizeData[axis] * InverseVolumesPerAxis;
    volumeSizeData[axis]    = volumeSize;
    volumeCentreData[axis] =
      cellCentreData[axis] - 0.5 * cellSizeData[axis] + (0.5 + volumeIndexData[axis]) * volumeSize;
  }

  return {size, centre};
}

template <int Dimensions, int NumberOfVolumesPerAxisInPatch>
INLINE_METHOD GPU_CALLABLE_METHOD
  std::pair<tarch::la::Vector<Dimensions, double>, tarch::la::Vector<Dimensions, double>>
  exahype2::fv::getFaceSizeAndCentre(
    const tarch::la::Vector<Dimensions, double>& x,
    const tarch::la::Vector<Dimensions, double>& h,
    const int                                    overlap,
    const int                                    normal,
    const tarch::la::Vector<Dimensions, int>&    index
  ) {
  static_assert(NumberOfVolumesPerAxisInPatch >= 1, "NumberOfVolumesPerAxisInPatch must be >= 1");

  tarch::la::Vector<Dimensions, double> faceSize;
  tarch::la::Vector<Dimensions, double> faceCentre;

  const auto* cellCentreData = x.data();
  const auto* cellSizeData   = h.data();
  const auto* faceIndexData  = index.data();

  auto* faceSizeData   = faceSize.data();
  auto* faceCentreData = faceCentre.data();

  constexpr double InverseVolumesPerAxis = 1.0 / NumberOfVolumesPerAxisInPatch;

  UNROLL(Dimensions)
  for (int axis = 0; axis < Dimensions; axis++) {
    const double volumeSize = cellSizeData[axis] * InverseVolumesPerAxis;
    faceSizeData[axis]      = volumeSize;

    const double faceCentreOnAxis = (axis == normal)
      ? cellCentreData[axis] - overlap * volumeSize + 0.5 * volumeSize
      : cellCentreData[axis] - 0.5 * cellSizeData[axis] + 0.5 * volumeSize;

    faceCentreData[axis] = faceCentreOnAxis + faceIndexData[axis] * volumeSize;
  }

  return {faceSize, faceCentre};
}

INLINE_METHOD GPU_CALLABLE_METHOD tarch::la::Vector<2, double> exahype2::fv::getVolumeSize(
  const tarch::la::Vector<2, double>& h,
  const int                           numberOfVolumesPerAxisInPatch
) {
  assertion(numberOfVolumesPerAxisInPatch >= 1, h, numberOfVolumesPerAxisInPatch);
  tarch::la::Vector<2, double> volumeSize;
  for (int axis = 0; axis < 2; axis++) {
    volumeSize(axis) = h(axis) / numberOfVolumesPerAxisInPatch;
  }
  return volumeSize;
}

INLINE_METHOD GPU_CALLABLE_METHOD tarch::la::Vector<3, double> exahype2::fv::getVolumeSize(
  const tarch::la::Vector<3, double>& h,
  const int                           numberOfVolumesPerAxisInPatch
) {
  assertion(numberOfVolumesPerAxisInPatch >= 1, h, numberOfVolumesPerAxisInPatch);
  tarch::la::Vector<3, double> volumeSize;
  for (int axis = 0; axis < 3; axis++) {
    volumeSize(axis) = h(axis) / numberOfVolumesPerAxisInPatch;
  }
  return volumeSize;
}

INLINE_METHOD GPU_CALLABLE_METHOD tarch::la::Vector<2, double> exahype2::fv::getFaceSize(
  const tarch::la::Vector<2, double>& h,
  const int                           numberOfVolumesPerAxisInPatch
) {
  return exahype2::fv::getVolumeSize(h, numberOfVolumesPerAxisInPatch);
}

INLINE_METHOD GPU_CALLABLE_METHOD tarch::la::Vector<3, double> exahype2::fv::getFaceSize(
  const tarch::la::Vector<3, double>& h,
  const int                           numberOfVolumesPerAxisInPatch
) {
  return exahype2::fv::getVolumeSize(h, numberOfVolumesPerAxisInPatch);
}

INLINE_METHOD GPU_CALLABLE_METHOD tarch::la::Vector<2, double> exahype2::fv::getVolumeCentre(
  const tarch::la::Vector<2, double>& x,
  const tarch::la::Vector<2, double>& h,
  const int                           numberOfVolumesPerAxisInPatch,
  const tarch::la::Vector<2, int>&    index
) {
  const tarch::la::Vector<2, double> volumeSize   = exahype2::fv::getVolumeSize(h, numberOfVolumesPerAxisInPatch);
  tarch::la::Vector<2, double>       volumeCentre = x - 0.5 * h + 0.5 * volumeSize;
  for (int axis = 0; axis < 2; axis++) {
    volumeCentre(axis) += index(axis) * volumeSize(axis);
  }
  return volumeCentre;
}

INLINE_METHOD GPU_CALLABLE_METHOD tarch::la::Vector<3, double> exahype2::fv::getVolumeCentre(
  const tarch::la::Vector<3, double>& x,
  const tarch::la::Vector<3, double>& h,
  const int                           numberOfVolumesPerAxisInPatch,
  const tarch::la::Vector<3, int>&    index
) {
  const tarch::la::Vector<3, double> volumeSize   = exahype2::fv::getVolumeSize(h, numberOfVolumesPerAxisInPatch);
  tarch::la::Vector<3, double>       volumeCentre = x - 0.5 * h + 0.5 * volumeSize;
  for (int axis = 0; axis < 3; axis++) {
    volumeCentre(axis) += index(axis) * volumeSize(axis);
  }
  return volumeCentre;
}

INLINE_METHOD GPU_CALLABLE_METHOD tarch::la::Vector<2, double> exahype2::fv::getFaceCentre(
  const tarch::la::Vector<2, double>& x,
  const tarch::la::Vector<2, double>& h,
  const int                           numberOfVolumesPerAxisInPatch,
  const int                           overlap,
  const int                           normal,
  const tarch::la::Vector<2, int>&    index
) {
  const tarch::la::Vector<2, double> volumeSize = exahype2::fv::getFaceSize(h, numberOfVolumesPerAxisInPatch);
  tarch::la::Vector<2, double>       faceCentre;
  for (int axis = 0; axis < 2; axis++) {
    if (axis == normal) {
      faceCentre(axis) = x(axis) - overlap * volumeSize(axis) + 0.5 * volumeSize(axis);
    } else {
      faceCentre(axis) = x(axis) - 0.5 * h(axis) + 0.5 * volumeSize(axis);
    }
    faceCentre(axis) += index(axis) * volumeSize(axis);
  }
  return faceCentre;
}

INLINE_METHOD GPU_CALLABLE_METHOD tarch::la::Vector<3, double> exahype2::fv::getFaceCentre(
  const tarch::la::Vector<3, double>& x,
  const tarch::la::Vector<3, double>& h,
  const int                           numberOfVolumesPerAxisInPatch,
  const int                           overlap,
  const int                           normal,
  const tarch::la::Vector<3, int>&    index
) {
  const tarch::la::Vector<3, double> volumeSize = exahype2::fv::getFaceSize(h, numberOfVolumesPerAxisInPatch);
  tarch::la::Vector<3, double>       faceCentre;
  for (int axis = 0; axis < 3; axis++) {
    if (axis == normal) {
      faceCentre(axis) = x(axis) - overlap * volumeSize(axis) + 0.5 * volumeSize(axis);
    } else {
      faceCentre(axis) = x(axis) - 0.5 * h(axis) + 0.5 * volumeSize(axis);
    }
    faceCentre(axis) += index(axis) * volumeSize(axis);
  }
  return faceCentre;
}

TARGET_DECLARE_END

/** Copies either the lower or upper half of an array-of-structures face overlap. */
template <typename T>
void exahype2::fv::copyHalfOfHalo(
  int              unknownsPlusAuxiliaryVariables,
  int              numberOfVolumesPerAxisInPatch,
  int              haloSize,
  int              normal,
  bool             isRightLayer,
  const T* NOALIAS sourceQ,
  T* NOALIAS       destinationQ
) {
  peano4::dForEachExclusive(
    numberOfVolumesPerAxisInPatch,
    normal,
    0,
    [&](const tarch::la::Vector<DIMENSIONS, int>& tangentialIndex) {
      for (int overlapIndex = (isRightLayer ? haloSize : 0); overlapIndex < (isRightLayer ? 2 * haloSize : haloSize);
           overlapIndex++) {
        tarch::la::Vector<DIMENSIONS, int> overlapCell = tangentialIndex;
        overlapCell(normal)                            = overlapIndex;
        const int serialisedOverlapIndex =
          exahype2::serialiseVoxelIndexInOverlap(overlapCell, numberOfVolumesPerAxisInPatch, haloSize, normal);
        for (int quantity = 0; quantity < unknownsPlusAuxiliaryVariables; quantity++) {
          destinationQ[serialisedOverlapIndex * unknownsPlusAuxiliaryVariables + quantity] =
            sourceQ[serialisedOverlapIndex * unknownsPlusAuxiliaryVariables + quantity];
        }
      }
    }
  );
}

/**
 * Validates every interior and face-connected halo value of an array-of-structures patch.
 *
 * Diagonal halo entries are skipped because dimension-split halo exchange does not
 * initialise them. minValues and maxValues, when non-null, contain one bound per
 * unknown or auxiliary variable. The routine only reads Q and is thread-safe when
 * its data and bound arrays are not mutated concurrently.
 */
template <typename T>
void exahype2::fv::validatePatch(
  const T* NOALIAS                    Q,
  int                                 unknowns,
  int                                 auxiliaryVariables,
  int                                 numberOfVolumesPerAxisInPatch,
  int                                 haloSize,
  [[maybe_unused]] const std::string& location,
  bool                                triggerNonCriticalAssertion,
  const double*                       minValues,
  const double*                       maxValues
) {
  const int patchSize = numberOfVolumesPerAxisInPatch + 2 * haloSize;
  peano4::dForEach(patchSize, [&](const tarch::la::Vector<DIMENSIONS, int>& patchIndex) {
    const int volumeOffset = peano4::dLinearised(patchIndex, patchSize) * (unknowns + auxiliaryVariables);

    int outsidePatchAlongCoordinateAxis = 0;
    for (int axis = 0; axis < DIMENSIONS; axis++) {
      if (patchIndex(axis) < haloSize) {
        outsidePatchAlongCoordinateAxis++;
      }
      if (patchIndex(axis) >= haloSize + numberOfVolumesPerAxisInPatch) {
        outsidePatchAlongCoordinateAxis++;
      }
    }
    const bool isDiagonal = outsidePatchAlongCoordinateAxis > 1;

    if (haloSize == 0 or not isDiagonal) {
      for (int quantity = 0; quantity < unknowns + auxiliaryVariables; quantity++) {
        const int             entry     = volumeOffset + quantity;
        [[maybe_unused]] bool dataValid = true;
        if (minValues != nullptr and minValues[quantity] > Q[entry]) {
          dataValid = false;
        }
        if (maxValues != nullptr and maxValues[quantity] < Q[entry]) {
          dataValid = false;
        }
        const bool isValid = std::isfinite(Q[entry]) and dataValid;
        if (triggerNonCriticalAssertion) {
          if (not isValid) {
            std::ostringstream details;
            details << "Q[entry]=" << Q[entry] << ", unknowns=" << unknowns
                    << ", auxiliaryVariables=" << auxiliaryVariables << ", isDiagonal=" << isDiagonal
                    << ", haloSize=" << haloSize << ", entry=" << entry
                    << ", numberOfVolumesPerAxisInPatch=" << numberOfVolumesPerAxisInPatch
                    << ", patchIndex=" << patchIndex << ", unknown=" << quantity << ", location=" << location;
            ::tarch::triggerNonCriticalAssertion(
              __FILE__,
              __LINE__,
              "std::isfinite(Q[entry]) and dataValid",
              details.str()
            );
          }
        } else {
          assertion(
            isValid,
            Q[entry],
            unknowns,
            auxiliaryVariables,
            isDiagonal,
            haloSize,
            quantity,
            numberOfVolumesPerAxisInPatch,
            haloSize,
            patchIndex,
            quantity,
            location,
            exahype2::fv::plotPatch(Q, unknowns, auxiliaryVariables, numberOfVolumesPerAxisInPatch, haloSize)
          );
        }
      }
    }
  });
}
