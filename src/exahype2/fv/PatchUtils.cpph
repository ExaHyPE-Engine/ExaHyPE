/** Copies either the lower or upper half of an array-of-structures face overlap. */
template <typename T>
void exahype2::fv::copyHalfOfHalo(
  int              unknownsPlusAuxiliaryVariables,
  int              numberOfVolumesPerAxisInPatch,
  int              haloSize, // same as overlap
  int              normal,
  bool             isRightLayer,
  const T* NOALIAS srcQ,
  T* NOALIAS       destQ
) {
  peano4::dForEachExclusive(
    numberOfVolumesPerAxisInPatch,
    normal,
    0,
    [&](const tarch::la::Vector<DIMENSIONS, int>& tangentialIndex) {
      for (int overlapIndex = (isRightLayer ? haloSize : 0); overlapIndex < (isRightLayer ? 2 * haloSize : haloSize);
           overlapIndex++) {
        tarch::la::Vector<DIMENSIONS, int> overlapCell = tangentialIndex;
        overlapCell(normal)                            = overlapIndex;
        const int serialisedOverlapIndex               = exahype2::serialiseVoxelIndexInOverlap(
          overlapCell,
          numberOfVolumesPerAxisInPatch,
          haloSize,
          normal
        );
        for (int quantity = 0; quantity < unknownsPlusAuxiliaryVariables; quantity++) {
          destQ[serialisedOverlapIndex * unknownsPlusAuxiliaryVariables + quantity] =
            srcQ[serialisedOverlapIndex * unknownsPlusAuxiliaryVariables + quantity];
        }
      }
    }
  );
}

/**
 * Validates every interior and face-connected halo value of an array-of-structures patch.
 *
 * Diagonal halo entries are skipped because dimension-split halo exchange does not
 * initialise them. minValues and maxValues, when non-null, contain one bound per
 * unknown or auxiliary variable. The routine only reads Q and is thread-safe when
 * its data and bound arrays are not mutated concurrently.
 */
template <typename T>
void exahype2::fv::validatePatch(
  const T* NOALIAS                    Q,
  int                                 unknowns,
  int                                 auxiliaryVariables,
  int                                 numberOfVolumesPerAxisInPatch,
  int                                 haloSize,
  [[maybe_unused]] const std::string& location,
  bool                                triggerNonCriticalAssertion,
  double*                             minValues,
  double*                             maxValues
) {
  const int patchSize = numberOfVolumesPerAxisInPatch + 2 * haloSize;
  peano4::dForEach(patchSize, [&](const tarch::la::Vector<DIMENSIONS, int>& patchIndex) {
    const int volumeOffset = peano4::dLinearised(patchIndex, patchSize) * (unknowns + auxiliaryVariables);

    int outsidePatchAlongCoordinateAxis = 0;
    for (int axis = 0; axis < DIMENSIONS; axis++) {
      if (patchIndex(axis) < haloSize) {
        outsidePatchAlongCoordinateAxis++;
      }
      if (patchIndex(axis) >= haloSize + numberOfVolumesPerAxisInPatch) {
        outsidePatchAlongCoordinateAxis++;
      }
    }
    const bool isDiagonal = outsidePatchAlongCoordinateAxis > 1;

    if (haloSize == 0 or not isDiagonal) {
      for (int quantity = 0; quantity < unknowns + auxiliaryVariables; quantity++) {
        const int             entry     = volumeOffset + quantity;
        [[maybe_unused]] bool dataValid = true;
        if (minValues != nullptr and minValues[quantity] > Q[entry]) {
          dataValid = false;
        }
        if (maxValues != nullptr and maxValues[quantity] < Q[entry]) {
          dataValid = false;
        }
        const bool isValid = Q[entry] == Q[entry] and std::isfinite(Q[entry]) and dataValid;
        if (triggerNonCriticalAssertion) {
          if (not isValid) {
            std::ostringstream details;
            details << "Q[entry]=" << Q[entry] << ", unknowns=" << unknowns
                    << ", auxiliaryVariables=" << auxiliaryVariables << ", isDiagonal=" << isDiagonal
                    << ", haloSize=" << haloSize << ", entry=" << entry
                    << ", numberOfVolumesPerAxisInPatch=" << numberOfVolumesPerAxisInPatch
                    << ", patchIndex=" << patchIndex << ", unknown=" << quantity << ", location=" << location;
            ::tarch::triggerNonCriticalAssertion(
              __FILE__,
              __LINE__,
              "Q[entry] == Q[entry] and std::isfinite(Q[entry]) and dataValid",
              details.str()
            );
          }
        } else {
          assertion(
            isValid,
            Q[entry],
            unknowns,
            auxiliaryVariables,
            isDiagonal,
            haloSize,
            quantity,
            numberOfVolumesPerAxisInPatch,
            haloSize,
            patchIndex,
            quantity,
            location,
            plotPatch(Q, unknowns, auxiliaryVariables, numberOfVolumesPerAxisInPatch, haloSize)
          );
        }
      }
    }
  });
}
