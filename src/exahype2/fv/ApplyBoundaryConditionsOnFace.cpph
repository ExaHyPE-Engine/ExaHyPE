TARGET_DECLARE
/**
 * Fills one face overlap's outer halo layers through the solver's boundary
 * condition. The inner half mirrors the adjacent patch and supplies the state
 * from which each outer layer is derived. Face indices below @c DIMENSIONS
 * select lower faces; the remaining indices select upper faces.
 */
template <
  typename Solver,
  int NumberOfVolumesPerAxis,
  int HaloSize,
  int NumberOfUnknowns,
  int NumberOfAuxiliaryVariables,
  typename StoragePrecision>
INLINE_METHOD GPU_CALLABLE_METHOD void exahype2::fv::applyBoundaryConditionsOnFace(
  Solver&                                      solver,
  const tarch::la::Vector<DIMENSIONS, double>& patchCentre,
  const tarch::la::Vector<DIMENSIONS, double>& patchSize,
  const double                                 timeStamp,
  const int                                    faceNumber,
  StoragePrecision* const                      faceData
) {
  const int                             normal     = faceNumber % DIMENSIONS;
  const auto                            volumeSize = exahype2::fv::getVolumeSize(patchSize, NumberOfVolumesPerAxis);
  tarch::la::Vector<DIMENSIONS, double> faceOffset = patchCentre - 0.5 * patchSize;
  if (faceNumber >= DIMENSIONS) {
    faceOffset(normal) += patchSize(normal);
  }

  constexpr int NumberOfData = NumberOfUnknowns + NumberOfAuxiliaryVariables;

  int numberOfTangentialVolumes = 1;
  for (int dimension = 0; dimension < DIMENSIONS - 1; dimension++) {
    numberOfTangentialVolumes *= NumberOfVolumesPerAxis;
  }

  for (int tangentialVolume = 0; tangentialVolume < numberOfTangentialVolumes; tangentialVolume++) {
    // Spread the running tangential index across every axis but the normal one;
    // the halo loop below sets the layer along the normal.
    tarch::la::Vector<DIMENSIONS, int> overlapVolume;
    int                                remainder = tangentialVolume;
    for (int dimension = 0; dimension < DIMENSIONS; dimension++) {
      if (dimension == normal) {
        overlapVolume(dimension) = 0;
      } else {
        overlapVolume(dimension) = remainder % NumberOfVolumesPerAxis;
        remainder /= NumberOfVolumesPerAxis;
      }
    }

    tarch::la::Vector<DIMENSIONS, double> position;
    for (int dimension = 0; dimension < DIMENSIONS; dimension++) {
      position(dimension) =
        faceOffset(dimension) + (static_cast<double>(overlapVolume(dimension)) + 0.5) * volumeSize(dimension);
    }
    position(normal) -= 0.5 * volumeSize(normal);

    tarch::la::Vector<DIMENSIONS, int> insideVolume  = overlapVolume;
    tarch::la::Vector<DIMENSIONS, int> outsideVolume = overlapVolume;
    for (int layer = 0; layer < HaloSize; layer++) {
      insideVolume(normal)  = (faceNumber < DIMENSIONS) ? (HaloSize + layer) : (HaloSize - 1 - layer);
      outsideVolume(normal) = (faceNumber < DIMENSIONS) ? (HaloSize - 1 - layer) : (layer + HaloSize);

      // Linearise a face-overlap volume: The normal axis holds 2 * HaloSize
      // layers, every tangential axis holds NumberOfVolumesPerAxis layers.
      int insideVolumeSerialised  = 0;
      int outsideVolumeSerialised = 0;
      int base                    = 1;
      for (int dimension = 0; dimension < DIMENSIONS; dimension++) {
        insideVolumeSerialised += insideVolume(dimension) * base;
        outsideVolumeSerialised += outsideVolume(dimension) * base;
        base *= (dimension == normal) ? (2 * HaloSize) : NumberOfVolumesPerAxis;
      }

      solver.boundaryConditions(
        faceData + insideVolumeSerialised * NumberOfData,
        faceData + outsideVolumeSerialised * NumberOfData,
        position,
        volumeSize,
        timeStamp,
        normal
      );
    }
  }
}
TARGET_DECLARE_END
