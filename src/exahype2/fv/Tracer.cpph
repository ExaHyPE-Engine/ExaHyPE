template <int SourceIndex, int... SourceIndices, typename Particle>
void exahype2::fv::projectValuesOntoParticle_piecewiseConstant(
  const peano4::datamanagement::CellMarker& marker,
  int                                       voxelsPerAxis,
  int                                       unknownsPerVoxel,
  const double* __restrict__ Q,
  Particle& particle
) {
  internal::projectValuesOntoParticle_piecewiseConstant<
    Particle,
    SourceIndex,
    SourceIndices...>(marker, voxelsPerAxis, unknownsPerVoxel, Q, particle, 0);
}

template <int SourceIndex, int... SourceIndices, typename Particle>
void exahype2::fv::projectValuesOntoParticle_piecewiseLinear(
  const peano4::datamanagement::CellMarker& marker,
  int                                       voxelsPerAxis,
  int                                       unknownsPerVoxel,
  const double* __restrict__ Q,
  Particle& particle
) {
  internal::projectValuesOntoParticle_piecewiseLinear<
    Particle,
    SourceIndex,
    SourceIndices...>(marker, voxelsPerAxis, unknownsPerVoxel, Q, particle, 0);
}

template <typename Particle, int SourceIndex, int... SourceIndices>
void exahype2::fv::internal::projectValuesOntoParticle_piecewiseConstant(
  const peano4::datamanagement::CellMarker& marker,
  int                                       voxelsPerAxis,
  int                                       unknownsPerVoxel,
  const double* __restrict__ Q,
  Particle& particle,
  int       destinationIndex
) {
  particle.setData(
    destinationIndex,
    internal::projectValueOntoParticle_piecewiseConstant(
      marker,
      voxelsPerAxis,
      unknownsPerVoxel,
      Q,
      particle.getX(),
      destinationIndex
    )
  );
  internal::projectValuesOntoParticle_piecewiseConstant<
    Particle,
    SourceIndices...>(marker, voxelsPerAxis, unknownsPerVoxel, Q, particle, destinationIndex + 1);
}

template <typename Particle, int SourceIndex, int... SourceIndices>
void exahype2::fv::internal::projectValuesOntoParticle_piecewiseLinear(
  const peano4::datamanagement::CellMarker& marker,
  int                                       voxelsPerAxis,
  int                                       unknownsPerVoxel,
  const double* __restrict__ Q,
  Particle& particle,
  int       destinationIndex
) {
  particle.setData(
    destinationIndex,
    internal::projectValueOntoParticle_piecewiseLinear(
      marker,
      voxelsPerAxis,
      unknownsPerVoxel,
      Q,
      particle.getX(),
      destinationIndex
    )
  );
  internal::projectValuesOntoParticle_piecewiseLinear<
    Particle,
    SourceIndices...>(marker, voxelsPerAxis, unknownsPerVoxel, Q, particle, destinationIndex + 1);
}

template <typename Particle>
void exahype2::fv::internal::projectValuesOntoParticle_piecewiseConstant(
  const peano4::datamanagement::CellMarker& /*marker*/,
  int                                       /*voxelsPerAxis*/,
  int                                       /*unknownsPerVoxel*/,
  const double* __restrict__ /*Q*/,
  Particle& /*particle*/,
  int       /*destinationIndex*/
) {}

template <typename Particle>
void exahype2::fv::internal::projectValuesOntoParticle_piecewiseLinear(
  const peano4::datamanagement::CellMarker& /*marker*/,
  int                                       /*voxelsPerAxis*/,
  int                                       /*unknownsPerVoxel*/,
  const double* __restrict__ /*Q*/,
  Particle& /*particle*/,
  int       /*destinationIndex*/
) {}

template <int SourceIndex, int DestIndex, typename Particle>
void exahype2::fv::projectValueOntoParticle_piecewiseConstant(
  const peano4::datamanagement::CellMarker& marker,
  int                                       voxelsPerAxis,
  int                                       unknownsPerVoxel,
  const double* __restrict__ Q,
  Particle& particle
) {
  particle.setData(
    DestIndex,
    internal::projectValueOntoParticle_piecewiseConstant(
      marker,
      voxelsPerAxis,
      unknownsPerVoxel,
      Q,
      particle.getX(),
      SourceIndex
    )
  );
}

template <typename Particle>
void exahype2::fv::projectAllValuesOntoParticle_piecewiseConstant(
  const peano4::datamanagement::CellMarker& marker,
  int                                       voxelsPerAxis,
  int                                       unknownsPerVoxel,
  const double* __restrict__ Q,
  Particle& particle
) {
  for (int unknown = 0; unknown < unknownsPerVoxel; unknown++) {
    particle.setData(
      unknown,
      internal::projectValueOntoParticle_piecewiseConstant(marker, voxelsPerAxis, unknownsPerVoxel, Q, particle.getX(), unknown)
    );
  }
}

template <int SourceIndex, int DestIndex, typename Particle>
void exahype2::fv::projectValueOntoParticle_piecewiseLinear(
  const peano4::datamanagement::CellMarker& marker,
  int                                       voxelsPerAxis,
  int                                       unknownsPerVoxel,
  const double* __restrict__ Q,
  Particle& particle
) {
  particle.setData(DestIndex) = internal::projectValueOntoParticle_piecewiseLinear(marker, voxelsPerAxis, unknownsPerVoxel, Q, particle.getX(), SourceIndex);
}

template <typename Particle>
void exahype2::fv::projectAllValuesOntoParticle_piecewiseLinear(
  const peano4::datamanagement::CellMarker& marker,
  int                                       voxelsPerAxis,
  int                                       unknownsPerVoxel,
  const double* __restrict__ Q,
  Particle& particle
) {
  for (int unknown = 0; unknown < unknownsPerVoxel; unknown++) {
    double value = internal::projectValueOntoParticle_piecewiseLinear(marker, voxelsPerAxis, unknownsPerVoxel, Q, particle.getX(), unknown);

    assertion(value == value);
    particle.setData(unknown, value);
  }
}

template <typename Particle>
void exahype2::fv::projectAllValuesOntoParticle_piecewiseLinear_explicit_Euler(
  const peano4::datamanagement::CellMarker& marker,
  int                                       voxelsPerAxis,
  int                                       unknownsPerVoxel,
  const double* __restrict__ Q,
  double                                timeStepSize,
  tarch::la::Vector<Dimensions, int>    indices,
  tarch::la::Vector<Dimensions, double> factors,
  Particle&                             particle
) {
  for (int unknown = 0; unknown < unknownsPerVoxel; unknown++) {
    double value = internal::projectValueOntoParticle_piecewiseLinear(marker, voxelsPerAxis, unknownsPerVoxel, Q, particle.getX(), unknown);

    assertion(value == value); // Ensure value is not NaN
    particle.setData(unknown, value);
  }
}

template <int SourceIndex, int... SourceIndices, typename Particle>
void exahype2::fv::updateParticleState(
  Particle&                                 particle,
  double                                    timeStepSize,
  const peano4::datamanagement::CellMarker& marker,
  int                                       voxelsPerAxis,
  int                                       unknownsPerVoxel,
  const double* __restrict__ Q,
  tarch::la::Vector<Dimensions, double> DomainSize,
  tarch::la::Vector<Dimensions, double> DomainOffset,
  tarch::la::Vector<Dimensions, double> PeriodicBC
) {
  // 🔹 Step 1: Interpolation (Store values directly in the particle)
  projectValuesOntoParticle_piecewiseLinear<
    SourceIndex,
    SourceIndices...>(marker, voxelsPerAxis, unknownsPerVoxel, Q, particle);

  // 🔹 Step 2: Compute Forces (e.g., gravity, drag) - To be implemented
  // Example: Applying only gravity for now
  particle.setData(5, 0.0);
  particle.setData(6, -9.81);

  // 🔹 Step 3: Perform Integration
  tarch::la::Vector<Dimensions, double> newPosition;

  newPosition = explicitEulerIntegration(particle, timeStepSize);

  // 🔹 Step 4: Handle Boundary Collisions (if periodic BC is not active)
  if (tarch::la::max(PeriodicBC) == 1.0) {
    handleBoundaryCollisions(particle, newPosition, DomainSize, DomainOffset);
  }

  // 🔹 Step 5: Update Particle Position
  particle.setX(newPosition);
}

template <typename Particle>
tarch::la::Vector<Dimensions, double> exahype2::fv::explicitEulerIntegration(Particle& particle, double timeStepSize) {
  tarch::la::Vector<Dimensions, double> newPosition;
  // Set initial acceleration for testing purposes
  for (int d = 0; d < Dimensions; ++d) {
    double velocity     = particle.getData(3 + d);
    double acceleration = particle.getData(5 + d);
    velocity += acceleration * timeStepSize; // Update velocity
    velocity = std::min(std::max(velocity, -10.0), 10.0);

    particle.setData(3 + d, velocity);

    newPosition[d] = particle.getX(d) + velocity * timeStepSize + 0.5 * acceleration * timeStepSize * timeStepSize;
  }

  return newPosition;
}

template <typename Particle>
void exahype2::fv::handleBoundaryCollisions(
  Particle&                              particle,
  tarch::la::Vector<Dimensions, double>& newPosition,
  tarch::la::Vector<Dimensions, double>  DomainSize,
  tarch::la::Vector<Dimensions, double>  DomainOffset
) {
  for (int d = 0; d < Dimensions; d++) {
    double lowerBound = DomainOffset[d];
    double upperBound = DomainOffset[d] + DomainSize[d];

    double velocity = particle.getData(3 + d);

    if (newPosition[d] < lowerBound) {
      // Reflect at lower boundary
      newPosition[d] = lowerBound + (lowerBound - newPosition[d]);
      particle.setData(3 + d, -velocity * 0.9); // Reverse & damp velocity

    } else if (newPosition[d] > upperBound) {
      // Reflect at upper boundary
      newPosition[d] = upperBound - (newPosition[d] - upperBound);
      particle.setData(3 + d, -velocity * 0.9); // Reverse & damp velocity
    }
  }
}
