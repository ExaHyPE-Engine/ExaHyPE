template <typename DataType>
DataType exahype2::fv::internal::projectValueOntoParticle_piecewiseConstant(
  const peano4::datamanagement::CellMarker&    marker,
  int                                          voxelsPerAxis,
  int                                          unknownsPerVoxel,
  const DataType* NOALIAS                      Q,
  const tarch::la::Vector<DIMENSIONS, double>& particleX,
  int                                          unknown
) {
  tarch::la::Vector<DIMENSIONS, int> voxel =
    exahype2::fv::internal::mapParticleOntoVoxel(marker, voxelsPerAxis, particleX);

  int voxelIndex = peano4::dLinearised(voxel, voxelsPerAxis);

  return Q[voxelIndex * unknownsPerVoxel + unknown];
}

template <typename DataType>
DataType exahype2::fv::internal::projectValueOntoParticle_piecewiseLinear(
  const peano4::datamanagement::CellMarker&    marker,
  int                                          voxelsPerAxis,
  int                                          unknownsPerVoxel,
  const DataType* NOALIAS                      Q,
  const tarch::la::Vector<DIMENSIONS, double>& particleX,
  int                                          unknown
) {
  tarch::la::Vector<DIMENSIONS, int> biasedVoxel = mapBiasedParticleOntoVoxel(marker, voxelsPerAxis, particleX);

  double h = getVolumeLength(marker.getH(), voxelsPerAxis);

  double result = 0.0;
  peano4::dForEachCorner([&](const tarch::la::Vector<DIMENSIONS, int>& k, int kScalar) {
    tarch::la::Vector<DIMENSIONS, int>    currentVoxel = biasedVoxel + k;
    tarch::la::Vector<DIMENSIONS, double> currentVoxelX =
      getVolumeCentre(marker.getX(), marker.getH(), voxelsPerAxis, currentVoxel);
    int    currentVoxelIndex = peano4::dLinearised(currentVoxel, voxelsPerAxis);
    double weight            = 1.0;
    for (int d = 0; d < DIMENSIONS; d++) {
      double relativeDistance = std::abs(currentVoxelX(d) - particleX(d)) / h;
      if (particleX(d) < currentVoxelX(d) and currentVoxel(d) == 0) {
        weight = 1.0;
      } else if (particleX(d) > currentVoxelX(d) and currentVoxel(d) == voxelsPerAxis - 1) {
        weight = 1.0;
      } else if (relativeDistance < 1.0) {
        weight *= (1.0 - relativeDistance);
      } else {
        weight = 0.0;
      }
      assertion(tarch::la::smallerEquals(weight, 1.0), weight, k, relativeDistance);
    }
    if (weight > 0.0) {
      result += weight * Q[currentVoxelIndex * unknownsPerVoxel + unknown];
    }
  });
  // if (unknown==0){
  //   //std::cout << "exahype2::fv::internal::projectValueOntoParticle_piecewiseLinear(): Q_0(should close to 1.0
  //   always)=" << result <<std::endl;
  // }

  return result;
}

template <typename DataType, int SourceIndex, int... SourceIndices, typename Particle>
void exahype2::fv::projectValuesOntoParticle_piecewiseConstant(
  const peano4::datamanagement::CellMarker& marker,
  int                                       voxelsPerAxis,
  int                                       unknownsPerVoxel,
  const DataType* NOALIAS                   Q,
  Particle&                                 particle
) {
  internal::projectValuesOntoParticle_piecewiseConstant<DataType, Particle, SourceIndex, SourceIndices...>(
    marker,
    voxelsPerAxis,
    unknownsPerVoxel,
    Q,
    particle,
    0
  );
}

template <typename DataType, int SourceIndex, int... SourceIndices, typename Particle>
void exahype2::fv::projectValuesOntoParticle_piecewiseLinear(
  const peano4::datamanagement::CellMarker& marker,
  int                                       voxelsPerAxis,
  int                                       unknownsPerVoxel,
  const DataType* NOALIAS                   Q,
  Particle&                                 particle
) {
  internal::projectValuesOntoParticle_piecewiseLinear<DataType, Particle, SourceIndex, SourceIndices...>(
    marker,
    voxelsPerAxis,
    unknownsPerVoxel,
    Q,
    particle,
    0
  );
}

template <typename DataType, typename Particle, int SourceIndex, int... SourceIndices>
void exahype2::fv::internal::projectValuesOntoParticle_piecewiseConstant(
  const peano4::datamanagement::CellMarker& marker,
  int                                       voxelsPerAxis,
  int                                       unknownsPerVoxel,
  const DataType* NOALIAS                   Q,
  Particle&                                 particle,
  int                                       destinationIndex
) {
  particle.setData(
    destinationIndex,
    internal::projectValueOntoParticle_piecewiseConstant(
      marker,
      voxelsPerAxis,
      unknownsPerVoxel,
      Q,
      particle.getX(),
      destinationIndex
    )
  );
}

template <typename DataType, typename Particle, int SourceIndex, int... SourceIndices>
void exahype2::fv::internal::projectValuesOntoParticle_piecewiseLinear(
  const peano4::datamanagement::CellMarker& marker,
  int                                       voxelsPerAxis,
  int                                       unknownsPerVoxel,
  const DataType* NOALIAS                   Q,
  Particle&                                 particle,
  int                                       destinationIndex
) {
  particle.setData(
    destinationIndex,
    internal::projectValueOntoParticle_piecewiseLinear(
      marker,
      voxelsPerAxis,
      unknownsPerVoxel,
      Q,
      particle.getX(),
      destinationIndex
    )
  );
}

template <int SourceIndex, int DestIndex, typename Particle, typename DataType>
void exahype2::fv::projectValueOntoParticle_piecewiseConstant(
  const peano4::datamanagement::CellMarker& marker,
  int                                       voxelsPerAxis,
  int                                       unknownsPerVoxel,
  const DataType* NOALIAS                   Q,
  Particle&                                 particle
) {
  particle.setData(
    DestIndex,
    internal::projectValueOntoParticle_piecewiseConstant(
      marker,
      voxelsPerAxis,
      unknownsPerVoxel,
      Q,
      particle.getX(),
      SourceIndex
    )
  );
}

template <typename Particle, typename DataType>
void exahype2::fv::projectAllValuesOntoParticle_piecewiseConstant(
  const peano4::datamanagement::CellMarker& marker,
  int                                       voxelsPerAxis,
  int                                       unknownsPerVoxel,
  const DataType* NOALIAS                   Q,
  Particle&                                 particle
) {
  for (int unknown = 0; unknown < unknownsPerVoxel; unknown++) {
    particle.setData(
      unknown,
      internal::projectValueOntoParticle_piecewiseConstant(
        marker,
        voxelsPerAxis,
        unknownsPerVoxel,
        Q,
        particle.getX(),
        unknown
      )
    );
  }
}

template <int SourceIndex, int DestIndex, typename Particle, typename DataType>
void exahype2::fv::projectValueOntoParticle_piecewiseLinear(
  const peano4::datamanagement::CellMarker& marker,
  int                                       voxelsPerAxis,
  int                                       unknownsPerVoxel,
  const DataType* NOALIAS                   Q,
  Particle&                                 particle
) {
  particle.setData(DestIndex) = internal::projectValueOntoParticle_piecewiseLinear(
    marker,
    voxelsPerAxis,
    unknownsPerVoxel,
    Q,
    particle.getX(),
    SourceIndex
  );
}

template <typename Particle, typename DataType>
void exahype2::fv::projectAllValuesOntoParticle_piecewiseLinear(
  const peano4::datamanagement::CellMarker& marker,
  int                                       voxelsPerAxis,
  int                                       unknownsPerVoxel,
  const DataType* NOALIAS                   Q,
  Particle&                                 particle
) {
  for (int unknown = 0; unknown < unknownsPerVoxel; unknown++) {
    double value = internal::projectValueOntoParticle_piecewiseLinear(
      marker,
      voxelsPerAxis,
      unknownsPerVoxel,
      Q,
      particle.getX(),
      unknown
    );

    assertion(value == value);
    particle.setData(unknown, value);
  }
}

template <typename Particle, typename DataType>
void exahype2::fv::projectAllValuesOntoParticle_piecewiseLinear_explicit_Euler(
  const peano4::datamanagement::CellMarker& marker,
  int                                       voxelsPerAxis,
  int                                       unknownsPerVoxel,
  const DataType* NOALIAS                   Q,
  double                                    timeStepSize,
  tarch::la::Vector<DIMENSIONS, int>        indices,
  tarch::la::Vector<DIMENSIONS, double>     factors,
  Particle&                                 particle
) {
  for (int unknown = 0; unknown < unknownsPerVoxel; unknown++) {
    double value = internal::projectValueOntoParticle_piecewiseLinear(
      marker,
      voxelsPerAxis,
      unknownsPerVoxel,
      Q,
      particle.getX(),
      unknown
    );

    assertion(value == value); // Ensure value is not NaN
    particle.setData(unknown, value);
  }
}

template <int SourceIndex, int... SourceIndices, typename Particle, typename DataType>
void exahype2::fv::updateParticleState(
  Particle&                                 particle,
  double                                    timeStepSize,
  const peano4::datamanagement::CellMarker& marker,
  int                                       voxelsPerAxis,
  int                                       unknownsPerVoxel,
  const DataType* NOALIAS                   Q,
  tarch::la::Vector<DIMENSIONS, double>     DomainSize,
  tarch::la::Vector<DIMENSIONS, double>     DomainOffset,
  tarch::la::Vector<DIMENSIONS, double>     PeriodicBC
) {
  // 🔹 Step 1: Interpolation (Store values directly in the particle)
  projectValuesOntoParticle_piecewiseLinear<DataType, SourceIndex, SourceIndices...>(
    marker,
    voxelsPerAxis,
    unknownsPerVoxel,
    Q,
    particle
  );

  // 🔹 Step 2: Compute Forces (e.g., gravity, drag) - To be implemented
  // Example: Applying only gravity for now
  particle.setData(5, 0.0);
  particle.setData(6, -9.81);

  // 🔹 Step 3: Perform Integration
  tarch::la::Vector<DIMENSIONS, double> newPosition;

  newPosition = explicitEulerIntegration(particle, timeStepSize);

  // 🔹 Step 4: Handle Boundary Collisions (if periodic BC is not active)
  if (tarch::la::max(PeriodicBC) == 1.0) {
    handleBoundaryCollisions(particle, newPosition, DomainSize, DomainOffset);
  }

  // 🔹 Step 5: Update Particle Position
  particle.setX(newPosition);
}

template <typename Particle>
tarch::la::Vector<DIMENSIONS, double> exahype2::fv::explicitEulerIntegration(Particle& particle, double timeStepSize) {
  tarch::la::Vector<DIMENSIONS, double> newPosition;
  // Set initial acceleration for testing purposes
  for (int d = 0; d < DIMENSIONS; ++d) {
    double velocity     = particle.getData(3 + d);
    double acceleration = particle.getData(5 + d);
    velocity += acceleration * timeStepSize; // Update velocity
    velocity = std::min(std::max(velocity, -10.0), 10.0);

    particle.setData(3 + d, velocity);

    newPosition[d] = particle.getX(d) + velocity * timeStepSize + 0.5 * acceleration * timeStepSize * timeStepSize;
  }

  return newPosition;
}

template <typename Particle>
void exahype2::fv::handleBoundaryCollisions(
  Particle&                              particle,
  tarch::la::Vector<DIMENSIONS, double>& newPosition,
  tarch::la::Vector<DIMENSIONS, double>  DomainSize,
  tarch::la::Vector<DIMENSIONS, double>  DomainOffset
) {
  for (int d = 0; d < DIMENSIONS; d++) {
    double lowerBound = DomainOffset[d];
    double upperBound = DomainOffset[d] + DomainSize[d];

    double velocity = particle.getData(3 + d);

    if (newPosition[d] < lowerBound) {
      // Reflect at lower boundary
      newPosition[d] = lowerBound + (lowerBound - newPosition[d]);
      particle.setData(3 + d, -velocity * 0.9); // Reverse & damp velocity

    } else if (newPosition[d] > upperBound) {
      // Reflect at upper boundary
      newPosition[d] = upperBound - (newPosition[d] - upperBound);
      particle.setData(3 + d, -velocity * 0.9); // Reverse & damp velocity
    }
  }
}
