/** Returns one attribute from the halo-free volume containing particleX. */
template <typename DataType>
DataType exahype2::fv::internal::projectValueOntoParticle_piecewiseConstant(
  const peano4::datamanagement::CellMarker&    marker,
  int                                          voxelsPerAxis,
  int                                          unknownsPerVoxel,
  const DataType* NOALIAS                      Q,
  const tarch::la::Vector<DIMENSIONS, double>& particleX,
  int                                          unknown
) {
  const tarch::la::Vector<DIMENSIONS, int> voxel =
    exahype2::fv::internal::mapParticleOntoVoxel(marker, voxelsPerAxis, particleX);

  const int voxelIndex = peano4::dLinearised(voxel, voxelsPerAxis);

  return Q[voxelIndex * unknownsPerVoxel + unknown];
}

/**
 * Returns one multilinearly interpolated attribute at particleX.
 * Boundary points use the closest volume value along directions lacking a neighbour.
 */
template <typename DataType>
DataType exahype2::fv::internal::projectValueOntoParticle_piecewiseLinear(
  const peano4::datamanagement::CellMarker&    marker,
  int                                          voxelsPerAxis,
  int                                          unknownsPerVoxel,
  const DataType* NOALIAS                      Q,
  const tarch::la::Vector<DIMENSIONS, double>& particleX,
  int                                          unknown
) {
  const tarch::la::Vector<DIMENSIONS, int> biasedVoxel = mapBiasedParticleOntoVoxel(marker, voxelsPerAxis, particleX);

  const double volumeWidth = getVolumeLength(marker.getH(), voxelsPerAxis);

  double interpolatedValue = 0.0;
  peano4::dForEachCorner([&](const tarch::la::Vector<DIMENSIONS, int>& corner, int /*linearisedCorner*/) {
    const tarch::la::Vector<DIMENSIONS, int>    currentVoxel = biasedVoxel + corner;
    const tarch::la::Vector<DIMENSIONS, double> currentVoxelX =
      getVolumeCentre(marker.getX(), marker.getH(), voxelsPerAxis, currentVoxel);
    const int currentVoxelIndex = peano4::dLinearised(currentVoxel, voxelsPerAxis);
    double    weight            = 1.0;
    for (int axis = 0; axis < DIMENSIONS; axis++) {
      const double relativeDistance     = std::abs(currentVoxelX(axis) - particleX(axis)) / volumeWidth;
      const bool   extendsBoundaryValue = (particleX(axis) < currentVoxelX(axis) and currentVoxel(axis) == 0)
        or (particleX(axis) > currentVoxelX(axis) and currentVoxel(axis) == voxelsPerAxis - 1);
      if (extendsBoundaryValue) {
        continue;
      } else if (relativeDistance < 1.0) {
        weight *= (1.0 - relativeDistance);
      } else {
        weight = 0.0;
      }
      assertion(tarch::la::smallerEquals(weight, 1.0), weight, corner, relativeDistance);
    }
    if (weight > 0.0) {
      interpolatedValue += weight * Q[currentVoxelIndex * unknownsPerVoxel + unknown];
    }
  });

  return interpolatedValue;
}

/** Maps the source attribute pack to particle data entries starting at zero. */
template <typename DataType, int SourceIndex, int... SourceIndices, typename Particle>
void exahype2::fv::projectValuesOntoParticle_piecewiseConstant(
  const peano4::datamanagement::CellMarker& marker,
  int                                       voxelsPerAxis,
  int                                       unknownsPerVoxel,
  const DataType* NOALIAS                   Q,
  Particle&                                 particle
) {
  internal::projectValuesOntoParticle_piecewiseConstant<DataType, Particle, SourceIndex, SourceIndices...>(
    marker,
    voxelsPerAxis,
    unknownsPerVoxel,
    Q,
    particle,
    0
  );
}

/** Multilinearly maps the source attribute pack to particle data entries starting at zero. */
template <typename DataType, int SourceIndex, int... SourceIndices, typename Particle>
void exahype2::fv::projectValuesOntoParticle_piecewiseLinear(
  const peano4::datamanagement::CellMarker& marker,
  int                                       voxelsPerAxis,
  int                                       unknownsPerVoxel,
  const DataType* NOALIAS                   Q,
  Particle&                                 particle
) {
  internal::projectValuesOntoParticle_piecewiseLinear<DataType, Particle, SourceIndex, SourceIndices...>(
    marker,
    voxelsPerAxis,
    unknownsPerVoxel,
    Q,
    particle,
    0
  );
}

/** Writes one piecewise-constant source attribute and recursively processes the remaining pack. */
template <typename DataType, typename Particle, int SourceIndex, int... SourceIndices>
void exahype2::fv::internal::projectValuesOntoParticle_piecewiseConstant(
  const peano4::datamanagement::CellMarker& marker,
  int                                       voxelsPerAxis,
  int                                       unknownsPerVoxel,
  const DataType* NOALIAS                   Q,
  Particle&                                 particle,
  int                                       destinationIndex
) {
  particle.setData(
    destinationIndex,
    internal::projectValueOntoParticle_piecewiseConstant(
      marker,
      voxelsPerAxis,
      unknownsPerVoxel,
      Q,
      particle.getX(),
      SourceIndex
    )
  );
  if constexpr (sizeof...(SourceIndices) > 0) {
    internal::projectValuesOntoParticle_piecewiseConstant<DataType, Particle, SourceIndices...>(
      marker,
      voxelsPerAxis,
      unknownsPerVoxel,
      Q,
      particle,
      destinationIndex + 1
    );
  }
}

/** Writes one multilinear source attribute and recursively processes the remaining pack. */
template <typename DataType, typename Particle, int SourceIndex, int... SourceIndices>
void exahype2::fv::internal::projectValuesOntoParticle_piecewiseLinear(
  const peano4::datamanagement::CellMarker& marker,
  int                                       voxelsPerAxis,
  int                                       unknownsPerVoxel,
  const DataType* NOALIAS                   Q,
  Particle&                                 particle,
  int                                       destinationIndex
) {
  particle.setData(
    destinationIndex,
    internal::projectValueOntoParticle_piecewiseLinear(
      marker,
      voxelsPerAxis,
      unknownsPerVoxel,
      Q,
      particle.getX(),
      SourceIndex
    )
  );
  if constexpr (sizeof...(SourceIndices) > 0) {
    internal::projectValuesOntoParticle_piecewiseLinear<DataType, Particle, SourceIndices...>(
      marker,
      voxelsPerAxis,
      unknownsPerVoxel,
      Q,
      particle,
      destinationIndex + 1
    );
  }
}

/** Maps SourceIndex from the containing volume to particle data entry DestIndex. */
template <int SourceIndex, int DestIndex, typename Particle, typename DataType>
void exahype2::fv::projectValueOntoParticle_piecewiseConstant(
  const peano4::datamanagement::CellMarker& marker,
  int                                       voxelsPerAxis,
  int                                       unknownsPerVoxel,
  const DataType* NOALIAS                   Q,
  Particle&                                 particle
) {
  particle.setData(
    DestIndex,
    internal::projectValueOntoParticle_piecewiseConstant(
      marker,
      voxelsPerAxis,
      unknownsPerVoxel,
      Q,
      particle.getX(),
      SourceIndex
    )
  );
}

/** Maps every volume attribute to the particle entry with the same index. */
template <typename Particle, typename DataType>
void exahype2::fv::projectAllValuesOntoParticle_piecewiseConstant(
  const peano4::datamanagement::CellMarker& marker,
  int                                       voxelsPerAxis,
  int                                       unknownsPerVoxel,
  const DataType* NOALIAS                   Q,
  Particle&                                 particle
) {
  for (int sourceAttribute = 0; sourceAttribute < unknownsPerVoxel; sourceAttribute++) {
    particle.setData(
      sourceAttribute,
      internal::projectValueOntoParticle_piecewiseConstant(
        marker,
        voxelsPerAxis,
        unknownsPerVoxel,
        Q,
        particle.getX(),
        sourceAttribute
      )
    );
  }
}

/** Multilinearly maps SourceIndex to particle data entry DestIndex. */
template <int SourceIndex, int DestIndex, typename Particle, typename DataType>
void exahype2::fv::projectValueOntoParticle_piecewiseLinear(
  const peano4::datamanagement::CellMarker& marker,
  int                                       voxelsPerAxis,
  int                                       unknownsPerVoxel,
  const DataType* NOALIAS                   Q,
  Particle&                                 particle
) {
  particle.setData(
    DestIndex,
    internal::projectValueOntoParticle_piecewiseLinear(
      marker,
      voxelsPerAxis,
      unknownsPerVoxel,
      Q,
      particle.getX(),
      SourceIndex
    )
  );
}

/** Multilinearly maps every volume attribute to the particle entry with the same index. */
template <typename Particle, typename DataType>
void exahype2::fv::projectAllValuesOntoParticle_piecewiseLinear(
  const peano4::datamanagement::CellMarker& marker,
  int                                       voxelsPerAxis,
  int                                       unknownsPerVoxel,
  const DataType* NOALIAS                   Q,
  Particle&                                 particle
) {
  for (int sourceAttribute = 0; sourceAttribute < unknownsPerVoxel; sourceAttribute++) {
    const DataType interpolatedValue = internal::projectValueOntoParticle_piecewiseLinear(
      marker,
      voxelsPerAxis,
      unknownsPerVoxel,
      Q,
      particle.getX(),
      sourceAttribute
    );

    assertion(interpolatedValue == interpolatedValue);
    particle.setData(sourceAttribute, interpolatedValue);
  }
}

/**
 * Multilinearly maps every volume attribute to the corresponding particle data index.
 */
template <typename Particle, typename DataType>
void exahype2::fv::projectAllValuesOntoParticle_piecewiseLinear_explicit_Euler(
  const peano4::datamanagement::CellMarker&              marker,
  int                                                    voxelsPerAxis,
  int                                                    unknownsPerVoxel,
  const DataType* NOALIAS                                Q,
  [[maybe_unused]] double                                timeStepSize,
  [[maybe_unused]] tarch::la::Vector<DIMENSIONS, int>    indices,
  [[maybe_unused]] tarch::la::Vector<DIMENSIONS, double> factors,
  Particle&                                              particle
) {
  for (int sourceAttribute = 0; sourceAttribute < unknownsPerVoxel; sourceAttribute++) {
    const DataType interpolatedValue = internal::projectValueOntoParticle_piecewiseLinear(
      marker,
      voxelsPerAxis,
      unknownsPerVoxel,
      Q,
      particle.getX(),
      sourceAttribute
    );

    assertion(interpolatedValue == interpolatedValue);
    particle.setData(sourceAttribute, interpolatedValue);
  }
}

/**
 * Interpolates selected attributes, applies gravity along the last coordinate axis,
 * advances the particle, and commits its position.
 *
 * Particle data entries beginning at ParticleVelocityAttributeOffset hold
 * velocity; entries beginning at ParticleAccelerationAttributeOffset hold
 * acceleration. The reflection at the domain boundary runs when one component
 * of periodicBoundaryConditions equals one.
 */
template <int SourceIndex, int... SourceIndices, typename Particle, typename DataType>
void exahype2::fv::updateParticleState(
  Particle&                                 particle,
  double                                    timeStepSize,
  const peano4::datamanagement::CellMarker& marker,
  int                                       voxelsPerAxis,
  int                                       unknownsPerVoxel,
  const DataType* NOALIAS                   Q,
  tarch::la::Vector<DIMENSIONS, double>     domainSize,
  tarch::la::Vector<DIMENSIONS, double>     domainOffset,
  tarch::la::Vector<DIMENSIONS, double>     periodicBoundaryConditions
) {
  projectValuesOntoParticle_piecewiseLinear<DataType, SourceIndex, SourceIndices...>(
    marker,
    voxelsPerAxis,
    unknownsPerVoxel,
    Q,
    particle
  );

  for (int axis = 0; axis < DIMENSIONS; axis++) {
    particle.setData(internal::ParticleAccelerationAttributeOffset + axis, axis == DIMENSIONS - 1 ? -9.81 : 0.0);
  }

  tarch::la::Vector<DIMENSIONS, double> newPosition = explicitEulerIntegration(particle, timeStepSize);

  if (tarch::la::max(periodicBoundaryConditions) == 1.0) {
    reflectParticleAtDomainBoundary(particle, newPosition, domainSize, domainOffset);
  }

  particle.setX(newPosition);
}

/**
 * Updates the velocity and derives a candidate particle position.
 *
 * For each axis, the method computes v_new = clamp(v_old + a*dt) and then
 * x_new = x_old + v_new*dt + 0.5*a*dt^2.
 */
template <typename Particle>
tarch::la::Vector<DIMENSIONS, double> exahype2::fv::explicitEulerIntegration(Particle& particle, double timeStepSize) {
  tarch::la::Vector<DIMENSIONS, double> newPosition;
  for (int axis = 0; axis < DIMENSIONS; ++axis) {
    double       velocity     = particle.getData(internal::ParticleVelocityAttributeOffset + axis);
    const double acceleration = particle.getData(internal::ParticleAccelerationAttributeOffset + axis);
    velocity += acceleration * timeStepSize;
    velocity = std::min(std::max(velocity, -internal::MaximumParticleSpeed), internal::MaximumParticleSpeed);

    particle.setData(internal::ParticleVelocityAttributeOffset + axis, velocity);

    newPosition[axis] =
      particle.getX(axis) + velocity * timeStepSize + 0.5 * acceleration * timeStepSize * timeStepSize;
  }

  return newPosition;
}

/**
 * Mirrors an out-of-domain candidate position and reverses its normal velocity.
 * CollisionVelocityRetention supplies the damping factor after each impact.
 */
template <typename Particle>
void exahype2::fv::reflectParticleAtDomainBoundary(
  Particle&                              particle,
  tarch::la::Vector<DIMENSIONS, double>& newPosition,
  tarch::la::Vector<DIMENSIONS, double>  domainSize,
  tarch::la::Vector<DIMENSIONS, double>  domainOffset
) {
  for (int axis = 0; axis < DIMENSIONS; axis++) {
    const double lowerBound = domainOffset[axis];
    const double upperBound = domainOffset[axis] + domainSize[axis];

    const double velocity = particle.getData(internal::ParticleVelocityAttributeOffset + axis);

    if (newPosition[axis] < lowerBound) {
      newPosition[axis] = lowerBound + (lowerBound - newPosition[axis]);
      particle.setData(
        internal::ParticleVelocityAttributeOffset + axis,
        -velocity * internal::CollisionVelocityRetention
      );
    } else if (newPosition[axis] > upperBound) {
      newPosition[axis] = upperBound - (newPosition[axis] - upperBound);
      particle.setData(
        internal::ParticleVelocityAttributeOffset + axis,
        -velocity * internal::CollisionVelocityRetention
      );
    }
  }
}
