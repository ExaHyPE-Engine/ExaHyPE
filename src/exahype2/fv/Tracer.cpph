/** Returns one attribute from the halo-free volume containing particleX. */
template <typename DataType>
DataType exahype2::fv::interpolateValueAtPositionPiecewiseConstant(
  const peano4::dataview::CellMarker&          marker,
  int                                          voxelsPerAxis,
  int                                          unknownsPerVoxel,
  const DataType* NOALIAS                      Q,
  const tarch::la::Vector<DIMENSIONS, double>& particleX,
  int                                          unknown
) {
  const tarch::la::Vector<DIMENSIONS, int> voxel =
    exahype2::fv::particles::interpolation::mapParticleOntoVoxel(marker, voxelsPerAxis, particleX);

  const int voxelIndex = peano4::dLinearised(voxel, voxelsPerAxis);

  return Q[voxelIndex * unknownsPerVoxel + unknown];
}

/**
 * Returns one multilinearly interpolated attribute at particleX.
 * Boundary points use the closest volume value along directions lacking a neighbour.
 */
template <typename DataType>
DataType exahype2::fv::interpolateValueAtPositionPiecewiseLinear(
  const peano4::dataview::CellMarker&          marker,
  int                                          voxelsPerAxis,
  int                                          unknownsPerVoxel,
  const DataType* NOALIAS                      Q,
  const tarch::la::Vector<DIMENSIONS, double>& particleX,
  int                                          unknown
) {
  const tarch::la::Vector<DIMENSIONS, int> biasedVoxel =
    exahype2::fv::particles::interpolation::mapBiasedParticleOntoVoxel(marker, voxelsPerAxis, particleX);

  const double volumeWidth = getVolumeLength(marker.getH(), voxelsPerAxis);

  double interpolatedValue = 0.0;
  peano4::dForEachCorner([&](const tarch::la::Vector<DIMENSIONS, int>& corner, [[maybe_unused]] int linearisedCorner) {
    const tarch::la::Vector<DIMENSIONS, int>    currentVoxel = biasedVoxel + corner;
    const tarch::la::Vector<DIMENSIONS, double> currentVoxelX =
      getVolumeCentre(marker.getX(), marker.getH(), voxelsPerAxis, currentVoxel);
    const int currentVoxelIndex = peano4::dLinearised(currentVoxel, voxelsPerAxis);
    double    weight            = 1.0;
    for (int axis = 0; axis < DIMENSIONS; axis++) {
      const double relativeDistance     = std::abs(currentVoxelX(axis) - particleX(axis)) / volumeWidth;
      const bool   extendsBoundaryValue = (particleX(axis) < currentVoxelX(axis) and currentVoxel(axis) == 0)
        or (particleX(axis) > currentVoxelX(axis) and currentVoxel(axis) == voxelsPerAxis - 1);
      if (extendsBoundaryValue) {
        continue;
      } else if (relativeDistance < 1.0) {
        weight *= (1.0 - relativeDistance);
      } else {
        weight = 0.0;
      }
      [[maybe_unused]] const bool weightIsAtMostOne = tarch::la::smallerEquals(weight, 1.0);
      assertion(weightIsAtMostOne, weight, corner, relativeDistance);
    }
    if (weight > 0.0) {
      interpolatedValue += weight * Q[currentVoxelIndex * unknownsPerVoxel + unknown];
    }
  });

  return interpolatedValue;
}

/** Maps the source attribute pack to particle data entries starting at zero. */
template <typename DataType, int SourceIndex, int... SourceIndices, typename Particle>
void exahype2::fv::projectValuesOntoParticlePiecewiseConstant(
  const peano4::dataview::CellMarker& marker,
  int                                 voxelsPerAxis,
  int                                 unknownsPerVoxel,
  const DataType* NOALIAS             Q,
  Particle&                           particle
) {
  exahype2::fv::projectValuePackOntoParticlePiecewiseConstant<DataType, Particle, SourceIndex, SourceIndices...>(
    marker,
    voxelsPerAxis,
    unknownsPerVoxel,
    Q,
    particle,
    0
  );
}

/** Multilinearly maps the source attribute pack to particle data entries starting at zero. */
template <typename DataType, int SourceIndex, int... SourceIndices, typename Particle>
void exahype2::fv::projectValuesOntoParticlePiecewiseLinear(
  const peano4::dataview::CellMarker& marker,
  int                                 voxelsPerAxis,
  int                                 unknownsPerVoxel,
  const DataType* NOALIAS             Q,
  Particle&                           particle
) {
  exahype2::fv::projectValuePackOntoParticlePiecewiseLinear<DataType, Particle, SourceIndex, SourceIndices...>(
    marker,
    voxelsPerAxis,
    unknownsPerVoxel,
    Q,
    particle,
    0
  );
}

/** Writes one piecewise-constant source attribute and recursively processes the remaining pack. */
template <typename DataType, typename Particle, int SourceIndex, int... SourceIndices>
void exahype2::fv::projectValuePackOntoParticlePiecewiseConstant(
  const peano4::dataview::CellMarker& marker,
  int                                 voxelsPerAxis,
  int                                 unknownsPerVoxel,
  const DataType* NOALIAS             Q,
  Particle&                           particle,
  int                                 destinationIndex
) {
  particle.setData(
    destinationIndex,
    exahype2::fv::interpolateValueAtPositionPiecewiseConstant(
      marker,
      voxelsPerAxis,
      unknownsPerVoxel,
      Q,
      particle.getX(),
      SourceIndex
    )
  );
  if constexpr (sizeof...(SourceIndices) > 0) {
    exahype2::fv::projectValuePackOntoParticlePiecewiseConstant<DataType, Particle, SourceIndices...>(
      marker,
      voxelsPerAxis,
      unknownsPerVoxel,
      Q,
      particle,
      destinationIndex + 1
    );
  }
}

/** Writes one multilinear source attribute and recursively processes the remaining pack. */
template <typename DataType, typename Particle, int SourceIndex, int... SourceIndices>
void exahype2::fv::projectValuePackOntoParticlePiecewiseLinear(
  const peano4::dataview::CellMarker& marker,
  int                                 voxelsPerAxis,
  int                                 unknownsPerVoxel,
  const DataType* NOALIAS             Q,
  Particle&                           particle,
  int                                 destinationIndex
) {
  particle.setData(
    destinationIndex,
    exahype2::fv::interpolateValueAtPositionPiecewiseLinear(
      marker,
      voxelsPerAxis,
      unknownsPerVoxel,
      Q,
      particle.getX(),
      SourceIndex
    )
  );
  if constexpr (sizeof...(SourceIndices) > 0) {
    exahype2::fv::projectValuePackOntoParticlePiecewiseLinear<DataType, Particle, SourceIndices...>(
      marker,
      voxelsPerAxis,
      unknownsPerVoxel,
      Q,
      particle,
      destinationIndex + 1
    );
  }
}

/** Maps SourceIndex from the containing volume to particle data entry DestinationIndex. */
template <int SourceIndex, int DestinationIndex, typename Particle, typename DataType>
void exahype2::fv::projectValueOntoParticlePiecewiseConstant(
  const peano4::dataview::CellMarker& marker,
  int                                 voxelsPerAxis,
  int                                 unknownsPerVoxel,
  const DataType* NOALIAS             Q,
  Particle&                           particle
) {
  particle.setData(
    DestinationIndex,
    exahype2::fv::interpolateValueAtPositionPiecewiseConstant(
      marker,
      voxelsPerAxis,
      unknownsPerVoxel,
      Q,
      particle.getX(),
      SourceIndex
    )
  );
}

/** Maps every volume attribute to the particle entry with the same index. */
template <typename Particle, typename DataType>
void exahype2::fv::projectAllValuesOntoParticlePiecewiseConstant(
  const peano4::dataview::CellMarker& marker,
  int                                 voxelsPerAxis,
  int                                 unknownsPerVoxel,
  const DataType* NOALIAS             Q,
  Particle&                           particle
) {
  for (int sourceAttribute = 0; sourceAttribute < unknownsPerVoxel; sourceAttribute++) {
    particle.setData(
      sourceAttribute,
      exahype2::fv::interpolateValueAtPositionPiecewiseConstant(
        marker,
        voxelsPerAxis,
        unknownsPerVoxel,
        Q,
        particle.getX(),
        sourceAttribute
      )
    );
  }
}

/** Multilinearly maps SourceIndex to particle data entry DestinationIndex. */
template <int SourceIndex, int DestinationIndex, typename Particle, typename DataType>
void exahype2::fv::projectValueOntoParticlePiecewiseLinear(
  const peano4::dataview::CellMarker& marker,
  int                                 voxelsPerAxis,
  int                                 unknownsPerVoxel,
  const DataType* NOALIAS             Q,
  Particle&                           particle
) {
  particle.setData(
    DestinationIndex,
    exahype2::fv::interpolateValueAtPositionPiecewiseLinear(
      marker,
      voxelsPerAxis,
      unknownsPerVoxel,
      Q,
      particle.getX(),
      SourceIndex
    )
  );
}

/** Multilinearly maps every volume attribute to the particle entry with the same index. */
template <typename Particle, typename DataType>
void exahype2::fv::projectAllValuesOntoParticlePiecewiseLinear(
  const peano4::dataview::CellMarker& marker,
  int                                 voxelsPerAxis,
  int                                 unknownsPerVoxel,
  const DataType* NOALIAS             Q,
  Particle&                           particle
) {
  for (int sourceAttribute = 0; sourceAttribute < unknownsPerVoxel; sourceAttribute++) {
    const DataType interpolatedValue = exahype2::fv::interpolateValueAtPositionPiecewiseLinear(
      marker,
      voxelsPerAxis,
      unknownsPerVoxel,
      Q,
      particle.getX(),
      sourceAttribute
    );

    assertion(interpolatedValue == interpolatedValue, interpolatedValue, sourceAttribute);
    particle.setData(sourceAttribute, interpolatedValue);
  }
}

/**
 * Interpolates selected attributes, applies gravity along the last coordinate axis,
 * advances the particle, and commits its position.
 *
 * The reflection at the domain boundary runs when one component of
 * periodicBoundaryConditions equals one.
 */
template <int SourceIndex, int... SourceIndices, typename Particle, typename DataType>
void exahype2::fv::updateParticleState(
  Particle&                             particle,
  double                                timeStepSize,
  const peano4::dataview::CellMarker&   marker,
  int                                   voxelsPerAxis,
  int                                   unknownsPerVoxel,
  const DataType* NOALIAS               Q,
  tarch::la::Vector<DIMENSIONS, double> domainSize,
  tarch::la::Vector<DIMENSIONS, double> domainOffset,
  tarch::la::Vector<DIMENSIONS, double> periodicBoundaryConditions
) {
  projectValuesOntoParticlePiecewiseLinear<DataType, SourceIndex, SourceIndices...>(
    marker,
    voxelsPerAxis,
    unknownsPerVoxel,
    Q,
    particle
  );

  for (int axis = 0; axis < DIMENSIONS; axis++) {
    particle.setData(
      exahype2::fv::particles::utils::ParticleAccelerationAttributeOffset + axis,
      axis == DIMENSIONS - 1 ? -9.81 : 0.0
    );
  }

  tarch::la::Vector<DIMENSIONS, double> newPosition = explicitEulerIntegration(particle, timeStepSize);

  if (tarch::la::max(periodicBoundaryConditions) == 1.0) {
    reflectParticleAtDomainBoundary(particle, newPosition, domainSize, domainOffset);
  }

  particle.setX(newPosition);
}

/**
 * Updates the velocity and derives a candidate particle position.
 *
 * For each axis, the method computes v_new = clamp(v_old + a*dt) and then
 * x_new = x_old + v_new*dt + 0.5*a*dt^2.
 */
template <typename Particle>
tarch::la::Vector<DIMENSIONS, double> exahype2::fv::explicitEulerIntegration(Particle& particle, double timeStepSize) {
  tarch::la::Vector<DIMENSIONS, double> newPosition;
  for (int axis = 0; axis < DIMENSIONS; ++axis) {
    double       velocity = particle.getData(exahype2::fv::particles::utils::ParticleVelocityAttributeOffset + axis);
    const double acceleration =
      particle.getData(exahype2::fv::particles::utils::ParticleAccelerationAttributeOffset + axis);
    velocity += acceleration * timeStepSize;
    velocity = std::min(std::max(velocity, -exahype2::fv::MaximumParticleSpeed), exahype2::fv::MaximumParticleSpeed);

    particle.setData(exahype2::fv::particles::utils::ParticleVelocityAttributeOffset + axis, velocity);

    newPosition[axis] =
      particle.getX(axis) + velocity * timeStepSize + 0.5 * acceleration * timeStepSize * timeStepSize;
  }

  return newPosition;
}

/**
 * Mirrors an out-of-domain candidate position and reverses its normal velocity.
 * CollisionVelocityRetention supplies the damping factor after each impact.
 */
template <typename Particle>
void exahype2::fv::reflectParticleAtDomainBoundary(
  Particle&                              particle,
  tarch::la::Vector<DIMENSIONS, double>& newPosition,
  tarch::la::Vector<DIMENSIONS, double>  domainSize,
  tarch::la::Vector<DIMENSIONS, double>  domainOffset
) {
  for (int axis = 0; axis < DIMENSIONS; axis++) {
    const double lowerBound = domainOffset[axis];
    const double upperBound = domainOffset[axis] + domainSize[axis];

    const double velocity = particle.getData(exahype2::fv::particles::utils::ParticleVelocityAttributeOffset + axis);

    if (newPosition[axis] < lowerBound) {
      newPosition[axis] = lowerBound + (lowerBound - newPosition[axis]);
      particle.setData(
        exahype2::fv::particles::utils::ParticleVelocityAttributeOffset + axis,
        -velocity * exahype2::fv::CollisionVelocityRetention
      );
    } else if (newPosition[axis] > upperBound) {
      newPosition[axis] = upperBound - (newPosition[axis] - upperBound);
      particle.setData(
        exahype2::fv::particles::utils::ParticleVelocityAttributeOffset + axis,
        -velocity * exahype2::fv::CollisionVelocityRetention
      );
    }
  }
}
