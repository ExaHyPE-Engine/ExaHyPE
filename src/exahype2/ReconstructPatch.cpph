/**
 * Gathers a patch and its face overlaps into an enlarged patch with
 * @c (NumberOfDofsPerAxis+2*Overlap)^DIMENSIONS volumes. The interior copies
 * the patch. Each halo reads the neighbour-owned half of its face. Face data
 * has no diagonal neighbour values, so corner halos are overwritten once per
 * normal and must not be read by a diagonal stencil.
 */
template <int NumberOfDofsPerAxis, int Overlap, int NumberOfUnknowns, typename Precision>
INLINE_METHOD void exahype2::reconstructPatch(
  const Precision* NOALIAS const inputPatch,
  Precision* NOALIAS const       faces[TWO_TIMES_D],
  Precision* NOALIAS const       reconstructedPatch
) {
  const tarch::la::Vector<DIMENSIONS, int> overlapShift(Overlap);

  int numberOfVolumes = NumberOfDofsPerAxis;
  for (int dimension = 1; dimension < DIMENSIONS; dimension++) {
    numberOfVolumes *= NumberOfDofsPerAxis;
  }

  for (int linearVolume = 0; linearVolume < numberOfVolumes; linearVolume++) {
    tarch::la::Vector<DIMENSIONS, int> volumeIndex;
    int                                remainder = linearVolume;
    for (int dimension = 0; dimension < DIMENSIONS; dimension++) {
      volumeIndex(dimension) = remainder % NumberOfDofsPerAxis;
      remainder /= NumberOfDofsPerAxis;
    }

    const tarch::la::Vector<DIMENSIONS, int> reconstructedVolume = volumeIndex + overlapShift;
    const int                                sourceIndex = peano4::dLinearised(volumeIndex, NumberOfDofsPerAxis);
    const int reconstructedIndex = peano4::dLinearised(reconstructedVolume, NumberOfDofsPerAxis + 2 * Overlap);
    SIMD()
    for (int unknown = 0; unknown < NumberOfUnknowns; unknown++) {
      reconstructedPatch[reconstructedIndex * NumberOfUnknowns + unknown] =
        inputPatch[sourceIndex * NumberOfUnknowns + unknown];
    }

    for (int dimension = 0; dimension < DIMENSIONS; dimension++) {
      for (int layer = 0; layer < Overlap; layer++) {
        tarch::la::Vector<DIMENSIONS, int> overlapVolume     = volumeIndex;
        tarch::la::Vector<DIMENSIONS, int> reconstructedHalo = volumeIndex + overlapShift;
        overlapVolume(dimension)                             = layer;
        reconstructedHalo(dimension)                         = layer;
        const int lowerOverlapIndex                          = exahype2::serialiseVoxelIndexInOverlap(
          overlapVolume,
          NumberOfDofsPerAxis,
          Overlap,
          dimension
        );
        const int lowerHaloIndex = peano4::dLinearised(reconstructedHalo, NumberOfDofsPerAxis + 2 * Overlap);
        SIMD()
        for (int unknown = 0; unknown < NumberOfUnknowns; unknown++) {
          reconstructedPatch[lowerHaloIndex * NumberOfUnknowns + unknown] =
            faces[dimension][lowerOverlapIndex * NumberOfUnknowns + unknown];
        }

        overlapVolume(dimension)     = layer + Overlap;
        reconstructedHalo(dimension) = layer + NumberOfDofsPerAxis + Overlap;
        const int upperOverlapIndex  = exahype2::serialiseVoxelIndexInOverlap(
          overlapVolume,
          NumberOfDofsPerAxis,
          Overlap,
          dimension
        );
        const int upperHaloIndex = peano4::dLinearised(reconstructedHalo, NumberOfDofsPerAxis + 2 * Overlap);
        SIMD()
        for (int unknown = 0; unknown < NumberOfUnknowns; unknown++) {
          reconstructedPatch[upperHaloIndex * NumberOfUnknowns + unknown] =
            faces[dimension + DIMENSIONS][upperOverlapIndex * NumberOfUnknowns + unknown];
        }
      }
    }
  }
}
