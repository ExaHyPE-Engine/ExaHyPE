INLINE_METHOD bool
tarch::mpi::PollPacing::reportProgressNow() {
  if (_iterationsUntilNextTurn > 0) {
    --_iterationsUntilNextTurn;
    return false;
  }

  if (_stride < MaxStride) {
    _stride *= 2;
  } else {
    std::this_thread::yield();
  }
  _iterationsUntilNextTurn = _stride;
  return true;
}
