template <class T>
void tarch::plotter::FileWriter::VertexDataPlotter::plotVertexData(int index, T value) {
  _impl.writeTuple<T>(index, &value, 1);
}

template <class T>
void tarch::plotter::FileWriter::VertexDataPlotter::plotVertexData(int index, const tarch::la::Vector<2, T>& value) {
  _impl.writeTuple<T>(index, value.data(), 2);
}

template <class T>
void tarch::plotter::FileWriter::VertexDataPlotter::plotVertexData(int index, const tarch::la::Vector<3, T>& value) {
  _impl.writeTuple<T>(index, value.data(), 3);
}

template <class T>
void tarch::plotter::FileWriter::VertexDataPlotter::plotVertexData(int index, T* values, int numberOfValues) {
  _impl.writeTuple<T>(index, values, numberOfValues);
}
