template<typename T>
void tarch::plotter::griddata::blockstructured::PeanoTextPatchFileWriter::CellDataWriter::plotCell( [[maybe_unused]] int index, T value ) {
  for (int i=0; i<_numberOfUnknowns; i++) {
    if (std::isnan(value)) {
      _out << " nan";
    } else {
      if ( std::abs(value) < std::numeric_limits<T>::min() ) value = 0.0;
      if (tarch::la::equals(value,0.0)) {
        _out << " 0";
      } else {
        _out << " " << value;
      }
    }
    _entryCounter++;
  }
  flushIfPatchIsComplete();
}


template<typename T>
void tarch::plotter::griddata::blockstructured::PeanoTextPatchFileWriter::CellDataWriter::plotCell( [[maybe_unused]] int index, T* values ) {
  for (int i=0; i<_numberOfUnknowns; i++) {
    if (std::isnan(values[i])) {
      _out << " nan";
    } else {
      if ( std::abs(values[i]) < std::numeric_limits<T>::min() ) values[i] = 0.0;
      if (tarch::la::equals(values[i],0.0)) {
        _out << " 0";
      } else {
        _out << " " << values[i];
      }
    }
    _entryCounter++;
  }
  flushIfPatchIsComplete();
}