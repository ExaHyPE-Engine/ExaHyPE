template <class T>
void tarch::plotter::FileWriter::DataPlotter::writeTuple(
  const int      index,
  const T* const values,
  const int      numberOfValues
) {
  assertion(index >= 0, index);
  assertion(values != nullptr);
  assertion(numberOfValues == _components, numberOfValues, _components);

  // The field is looked up on every call, as adding a field elsewhere reallocates _targetFields.
  assertion(_fieldIndex >= 0, _fieldIndex);
  assertion(static_cast<std::size_t>(_fieldIndex) < _targetFields.size(), _fieldIndex, _targetFields.size());
  DataField& field = _targetFields[_fieldIndex];

  const auto tupleIndex     = static_cast<std::size_t>(index);
  const auto componentCount = static_cast<std::size_t>(_components);
  const auto base           = tupleIndex * componentCount;
  const auto need           = base + componentCount;

  // An append needs no zero fill, so a sequential write skips the resize below.
  if (base == field.values.size()) {
    field.values.insert(field.values.end(), values, values + numberOfValues);
    return;
  }

  if (field.values.size() < need) {
    if (field.values.capacity() < need) {
      field.values.reserve(std::max(need, field.values.capacity() * 2));
    }
    field.values.resize(need, 0.0);
  }

  for (int component = 0; component < numberOfValues; component++) {
    field.values[base + component] = values[component];
  }
}
