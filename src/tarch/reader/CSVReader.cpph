/**
 * Returns the entry valueIndex, counted from zero, of row as the fundamental type T. The last entry
 * of row needs no trailing separator. A missing or unparsable entry throws std::runtime_error.
 */
template <class T>
INLINE_METHOD T
tarch::reader::CSVReader::extractFundamentalTypeFromRow(
  const char         separator,
  const int          valueIndex,
  const std::string& row
) {
  static_assert(std::is_fundamental_v<T>, "CSVReader extracts fundamental types only.");

  std::size_t entryBegin = 0;
  for (int entry = 0; entry < valueIndex; entry++) {
    const std::size_t separatorPosition = row.find(separator, entryBegin);
    if (separatorPosition == std::string::npos) {
      throw std::runtime_error(
        "Row \"" + row + "\" has no entry " + std::to_string(valueIndex) + " for the separator \"" + separator + "\"."
      );
    }
    entryBegin = separatorPosition + 1;
  }

  const std::size_t  entryEnd = row.find(separator, entryBegin);
  const std::size_t  length   = entryEnd == std::string::npos ? std::string::npos : entryEnd - entryBegin;
  std::istringstream entryStream(row.substr(entryBegin, length));
  T                  extractedValue{};
  if (not(entryStream >> extractedValue)) {
    throw std::runtime_error(
      "Entry " + std::to_string(valueIndex) + " of row \"" + row + "\" does not parse as the requested type."
    );
  }
  return extractedValue;
}
