namespace tarch::accelerator {
  // The cub library takes the reduction as a binary functor, so CubCombine wraps Op::combine.
  template <typename Op>
  struct CubCombine final {
    INLINE_METHOD GPU_CALLABLE_METHOD typename Op::ValueType operator()(
      const typename Op::ValueType& left,
      const typename Op::ValueType& right
    ) const {
      return Op::combine(left, right);
    }
  };

  // Every kernel that calls this routine runs CudaBlockSize threads per block. The barrier after
  // the read of entry zero keeps a thread that calls the routine again from overwriting the entry
  // while another thread still reads it.
  template <typename Reducer, typename T>
  INLINE_METHOD __device__ T blockReduce(const T threadValue) {
    __shared__ T blockValues[CudaBlockSize];
    const int    threadIndex = threadIdx.x;
    blockValues[threadIndex] = threadValue;
    __syncthreads();
    for (int half = CudaBlockSize / 2; half > 0; half >>= 1) {
      if (threadIndex < half) {
        blockValues[threadIndex] = Reducer::combine(blockValues[threadIndex], blockValues[threadIndex + half]);
      }
      __syncthreads();
    }
    const T blockResult = blockValues[0];
    __syncthreads();
    return blockResult;
  }

  /**
   * Combines the partial value of every thread of the team into the target of the reducer. One
   * host thread runs a whole team, so its partial value is already the team's result.
   */
  template <typename Reducer, typename T>
  INLINE_METHOD GPU_CALLABLE_METHOD void reduceOverTeam(
    [[maybe_unused]] const CudaTeam& team,
    const T                          threadValue,
    const Reducer                    reducer
  ) {
    COMPILE_IF_ON_DEVICE(
      const T blockResult = tarch::accelerator::blockReduce<Reducer>(threadValue);
      if (threadIdx.x == 0) { reducer.target = Reducer::combine(reducer.target, blockResult); }
    )
    COMPILE_IF_ON_HOST(reducer.target = Reducer::combine(reducer.target, threadValue);)
  }

  // The reducer parameter deduces Reducer, because the type of blockResults is a non-deduced
  // context. Its target is a host reference that no device thread dereferences.
  template <typename Reducer, typename Functor>
  __global__ void teamReduceKernel(
    const Functor                      functor,
    [[maybe_unused]] const Reducer     reducer,
    typename Reducer::ValueType* const blockResults
  ) {
    __shared__ typename Reducer::ValueType teamAccumulator;
    if (threadIdx.x == 0) {
      teamAccumulator = Reducer::identity();
    }
    __syncthreads();

    functor(static_cast<int>(blockIdx.x), CudaTeam{}, teamAccumulator);

    __syncthreads();
    if (threadIdx.x == 0) {
      blockResults[blockIdx.x] = teamAccumulator;
    }
  }

  template <typename Reducer, typename Functor>
  __global__ void flatReduceKernel1D(
    const Functor                      functor,
    [[maybe_unused]] const Reducer     reducer,
    const int                          numberOfItems,
    typename Reducer::ValueType* const blockResults
  ) {
    typename Reducer::ValueType threadAccumulator = Reducer::identity();
    const int                   firstIndex        = blockIdx.x * blockDim.x + threadIdx.x;
    const int                   stride            = gridDim.x * blockDim.x;
    for (int i = firstIndex; i < numberOfItems; i += stride) {
      functor(i, threadAccumulator);
    }
    const typename Reducer::ValueType blockResult = tarch::accelerator::blockReduce<Reducer>(threadAccumulator);
    if (threadIdx.x == 0) {
      blockResults[blockIdx.x] = blockResult;
    }
  }

  // The cub library reports the size of its temporary storage in a first call and reduces
  // in a second call with that storage allocated. cudaMallocAsync and cudaFreeAsync need
  // CUDA Toolkit 11.2 or newer and a device with stream-ordered memory pools.
  template <typename CubCall>
  INLINE_METHOD void runCubReduction(const CubCall cubCall, const cudaStream_t stream) {
    void*       temporaryStorage      = nullptr;
    std::size_t temporaryStorageBytes = 0;
    CHECK_CUDA_ERROR(cubCall(temporaryStorage, temporaryStorageBytes));
    CHECK_CUDA_ERROR(cudaMallocAsync(&temporaryStorage, temporaryStorageBytes, stream));
    CHECK_CUDA_ERROR(cubCall(temporaryStorage, temporaryStorageBytes));
    CHECK_CUDA_ERROR(cudaFreeAsync(temporaryStorage, stream));
  }

  template <typename T>
  INLINE_METHOD void cubReduce(
    [[maybe_unused]] const Max<T> reducer,
    const T* const                input,
    T* const                      output,
    const int                     numberOfItems,
    const cudaStream_t            stream
  ) {
    tarch::accelerator::runCubReduction(
      [&](void* const temporaryStorage, std::size_t& temporaryStorageBytes) {
        return cub::DeviceReduce::Max(temporaryStorage, temporaryStorageBytes, input, output, numberOfItems, stream);
      },
      stream
    );
  }
  template <typename T>
  INLINE_METHOD void cubReduce(
    [[maybe_unused]] const Min<T> reducer,
    const T* const                input,
    T* const                      output,
    const int                     numberOfItems,
    const cudaStream_t            stream
  ) {
    tarch::accelerator::runCubReduction(
      [&](void* const temporaryStorage, std::size_t& temporaryStorageBytes) {
        return cub::DeviceReduce::Min(temporaryStorage, temporaryStorageBytes, input, output, numberOfItems, stream);
      },
      stream
    );
  }
  template <typename T>
  INLINE_METHOD void cubReduce(
    [[maybe_unused]] const Sum<T> reducer,
    const T* const                input,
    T* const                      output,
    const int                     numberOfItems,
    const cudaStream_t            stream
  ) {
    tarch::accelerator::runCubReduction(
      [&](void* const temporaryStorage, std::size_t& temporaryStorageBytes) {
        return cub::DeviceReduce::Sum(temporaryStorage, temporaryStorageBytes, input, output, numberOfItems, stream);
      },
      stream
    );
  }
  template <typename Op, typename T>
  INLINE_METHOD void cubReduce(
    [[maybe_unused]] const Custom<Op> reducer,
    const T* const                    input,
    T* const                          output,
    const int                         numberOfItems,
    const cudaStream_t                stream
  ) {
    tarch::accelerator::runCubReduction(
      [&](void* const temporaryStorage, std::size_t& temporaryStorageBytes) {
        return cub::DeviceReduce::Reduce(
          temporaryStorage,
          temporaryStorageBytes,
          input,
          output,
          numberOfItems,
          CubCombine<Op>{},
          Op::identity(),
          stream
        );
      },
      stream
    );
  }

  template <typename Reducer>
  INLINE_METHOD void finaliseReduction(
    const Reducer                            reducer,
    const typename Reducer::ValueType* const deviceResult,
    const cudaStream_t                       stream
  ) {
    typename Reducer::ValueType hostResult = Reducer::identity();
    CHECK_CUDA_ERROR(
      cudaMemcpyAsync(&hostResult, deviceResult, sizeof(typename Reducer::ValueType), cudaMemcpyDeviceToHost, stream)
    );
    CHECK_CUDA_ERROR(cudaStreamSynchronize(stream));
    reducer.target = Reducer::combine(reducer.target, hostResult);
  }

  template <typename Reducer, typename Functor>
  INLINE_METHOD GPU_CALLABLE_METHOD void parallelReduce(
    const CudaTeam& team,
    const Range&    range,
    const Functor   functor,
    const Reducer   reducer
  ) {
    typename Reducer::ValueType threadAccumulator = Reducer::identity();
    for (int i = tarch::accelerator::getThreadOfTeam(team); i < range.n;
         i += tarch::accelerator::getNumberOfThreadsPerTeam(team)) {
      functor(i, threadAccumulator);
    }
    tarch::accelerator::reduceOverTeam<Reducer>(team, threadAccumulator, reducer);
  }
  template <typename Reducer, typename Functor>
  INLINE_METHOD GPU_CALLABLE_METHOD void parallelReduce(
    const CudaTeam&   team,
    const RangeMD<2>& range,
    const Functor     functor,
    const Reducer     reducer
  ) {
    typename Reducer::ValueType threadAccumulator = Reducer::identity();
    const int                   numberOfItems     = range.n[0] * range.n[1];
    const int                   extentY           = range.n[1];
    for (int index = tarch::accelerator::getThreadOfTeam(team); index < numberOfItems;
         index += tarch::accelerator::getNumberOfThreadsPerTeam(team)) {
      functor(index / extentY, index % extentY, threadAccumulator);
    }
    tarch::accelerator::reduceOverTeam<Reducer>(team, threadAccumulator, reducer);
  }
  template <typename Reducer, typename Functor>
  INLINE_METHOD GPU_CALLABLE_METHOD void parallelReduce(
    const CudaTeam&   team,
    const RangeMD<3>& range,
    const Functor     functor,
    const Reducer     reducer
  ) {
    typename Reducer::ValueType threadAccumulator = Reducer::identity();
    const int                   numberOfItems     = range.n[0] * range.n[1] * range.n[2];
    const int                   extentY           = range.n[1];
    const int                   extentZ           = range.n[2];
    for (int index = tarch::accelerator::getThreadOfTeam(team); index < numberOfItems;
         index += tarch::accelerator::getNumberOfThreadsPerTeam(team)) {
      functor(index / (extentY * extentZ), (index / extentZ) % extentY, index % extentZ, threadAccumulator);
    }
    tarch::accelerator::reduceOverTeam<Reducer>(team, threadAccumulator, reducer);
  }

  template <typename Reducer, typename Functor>
  INLINE_METHOD void parallelReduce(const Range& range, const Functor functor, const Reducer reducer) {
    assertion(range.n >= 0, range.n);
    if (range.n <= 0) {
      return;
    }
    using ValueType  = typename Reducer::ValueType;
    const int device = tarch::accelerator::getCurrentDevice();
    CHECK_CUDA_ERROR(cudaSetDevice(device));
    const int numberOfBlocks = std::min(
      (range.n + tarch::accelerator::CudaBlockSize - 1) / tarch::accelerator::CudaBlockSize,
      tarch::accelerator::CudaMaxNumberOfBlocks
    );

    ValueType* const blockResults =
      tarch::allocateMemory<ValueType>(numberOfBlocks, tarch::MemoryLocation::Device, device);
    ValueType* const deviceResult = tarch::allocateMemory<ValueType>(1, tarch::MemoryLocation::Device, device);

    tarch::accelerator::flatReduceKernel1D<<<
      numberOfBlocks,
      tarch::accelerator::CudaBlockSize,
      0,
      tarch::accelerator::getDeviceStream()
    >>>(functor, reducer, range.n, blockResults);
    CHECK_CUDA_ERROR(cudaGetLastError());
    tarch::accelerator::cubReduce(
      reducer,
      blockResults,
      deviceResult,
      numberOfBlocks,
      tarch::accelerator::getDeviceStream()
    );
    tarch::accelerator::finaliseReduction(reducer, deviceResult, tarch::accelerator::getDeviceStream());

    // finaliseReduction synchronises the stream before the scratch buffers are freed.
    tarch::freeMemory(blockResults, tarch::MemoryLocation::Device, device);
    tarch::freeMemory(deviceResult, tarch::MemoryLocation::Device, device);
  }

  template <typename Reducer, typename Functor>
  INLINE_METHOD void parallelReduce(const TeamRange& range, const Functor functor, const Reducer reducer) {
    assertion(range.n >= 0, range.n);
    if (range.n <= 0) {
      return;
    }
    using ValueType  = typename Reducer::ValueType;
    const int device = tarch::accelerator::getCurrentDevice();
    CHECK_CUDA_ERROR(cudaSetDevice(device));

    ValueType* const blockResults = tarch::allocateMemory<ValueType>(range.n, tarch::MemoryLocation::Device, device);
    ValueType* const deviceResult = tarch::allocateMemory<ValueType>(1, tarch::MemoryLocation::Device, device);

    tarch::accelerator::
      teamReduceKernel<<<range.n, tarch::accelerator::CudaBlockSize, 0, tarch::accelerator::getDeviceStream()>>>(
        functor,
        reducer,
        blockResults
      );
    CHECK_CUDA_ERROR(cudaGetLastError());
    tarch::accelerator::cubReduce(reducer, blockResults, deviceResult, range.n, tarch::accelerator::getDeviceStream());
    tarch::accelerator::finaliseReduction(reducer, deviceResult, tarch::accelerator::getDeviceStream());

    tarch::freeMemory(blockResults, tarch::MemoryLocation::Device, device);
    tarch::freeMemory(deviceResult, tarch::MemoryLocation::Device, device);
  }

  template <typename Reducer, typename Functor>
  INLINE_METHOD void parallelReduce(const RangeMD<2>& range, const Functor functor, const Reducer reducer) {
    assertion(range.n[0] >= 0, range.n[0]);
    assertion(range.n[1] >= 0, range.n[1]);
    const int extentY = range.n[1];
    tarch::accelerator::parallelReduce(
      Range(range.n[0] * range.n[1]),
      [=] __device__(const int index, typename Reducer::ValueType& accumulator) {
        functor(index / extentY, index % extentY, accumulator);
      },
      reducer
    );
  }
  template <typename Reducer, typename Functor>
  INLINE_METHOD void parallelReduce(const RangeMD<3>& range, const Functor functor, const Reducer reducer) {
    assertion(range.n[0] >= 0, range.n[0]);
    assertion(range.n[1] >= 0, range.n[1]);
    assertion(range.n[2] >= 0, range.n[2]);
    const int extentY = range.n[1];
    const int extentZ = range.n[2];
    tarch::accelerator::parallelReduce(
      Range(range.n[0] * range.n[1] * range.n[2]),
      [=] __device__(const int index, typename Reducer::ValueType& accumulator) {
        functor(index / (extentY * extentZ), (index / extentZ) % extentY, index % extentZ, accumulator);
      },
      reducer
    );
  }
} // namespace tarch::accelerator
