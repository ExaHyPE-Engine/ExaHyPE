/** Returns the bytes as device bytes if the location is a GPU in this build, else as host bytes. */
INLINE_METHOD tarch::AllocatedBytes
tarch::AllocatedBytes::in([[maybe_unused]] const MemoryLocation location, const std::size_t bytes) {
#if defined(PEANO_WITH_GPU_BACKEND)
  if (location == MemoryLocation::Device) {
    return {0, bytes};
  }
#endif
  return {bytes, 0};
}

INLINE_METHOD tarch::AllocatedBytes
tarch::AllocatedBytes::onHost(const std::size_t bytes) {
  return {bytes, 0};
}

INLINE_METHOD std::size_t
tarch::AllocatedBytes::getTotal() const {
  return host + device;
}

INLINE_METHOD tarch::AllocatedBytes&
tarch::AllocatedBytes::operator+=(const AllocatedBytes& other) {
  host += other.host;
  device += other.device;
  return *this;
}

INLINE_METHOD tarch::AllocatedBytes
tarch::operator+(const AllocatedBytes& left, const AllocatedBytes& right) {
  return {left.host + right.host, left.device + right.device};
}
