namespace tarch::accelerator {
  template <typename F>
  inline void parallelFor(const CpuTeam&, const Range& r, F f) {
    for (int i = 0; i < r.n; ++i) {
      f(i);
    }
  }
  template <typename F>
  inline void parallelFor(const CpuTeam&, const RangeMD<2>& r, F f) {
    for (int x = 0; x < r.n[0]; ++x) {
      for (int y = 0; y < r.n[1]; ++y) {
        f(x, y);
      }
    }
  }
  template <typename F>
  inline void parallelFor(const CpuTeam&, const RangeMD<3>& r, F f) {
    for (int x = 0; x < r.n[0]; ++x) {
      for (int y = 0; y < r.n[1]; ++y) {
        for (int z = 0; z < r.n[2]; ++z) {
          f(x, y, z);
        }
      }
    }
  }
} // namespace tarch::accelerator

namespace tarch {
  template <typename F>
  inline void parallelFor(const Range& r, F f) {
    accelerator::run_in_parallel_region([&]() {
#pragma omp for schedule(static)
      for (int i = 0; i < r.n; ++i) {
        f(i);
      }
    });
  }

  template <typename F>
  inline void parallelFor(const RangeMD<2>& r, F f) {
    accelerator::run_in_parallel_region([&]() {
#pragma omp for collapse(2) schedule(static)
      for (int x = 0; x < r.n[0]; ++x) {
        for (int y = 0; y < r.n[1]; ++y) {
          f(x, y);
        }
      }
    });
  }

  template <typename F>
  inline void parallelFor(const RangeMD<3>& r, F f) {
    accelerator::run_in_parallel_region([&]() {
#pragma omp for collapse(3) schedule(static)
      for (int x = 0; x < r.n[0]; ++x) {
        for (int y = 0; y < r.n[1]; ++y) {
          for (int z = 0; z < r.n[2]; ++z) {
            f(x, y, z);
          }
        }
      }
    });
  }

  // On the host the team model parallelises only across teams; the inner Range/RangeMD
  // (the CpuTeam overloads above) runs serially. This mirrors the GPU hierarchy but
  // means few/large teams (numberOfPatches < threads) leave cores idle — unlike the old
  // host kernels that flattened the whole patch x volume iteration space.
  template <typename F>
  inline void parallelFor(const TeamRange& r, F f) {
    accelerator::run_in_parallel_region([&]() {
#pragma omp for schedule(static)
      for (int i = 0; i < r.n; ++i) {
        f(i, accelerator::CpuTeam{});
      }
    });
  }
} // namespace tarch
