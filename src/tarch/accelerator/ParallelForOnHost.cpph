namespace tarch::accelerator {
  /**
   * Runs functor over the range on the host threads in every accelerator backend. Inside a parallel
   * region the loop becomes tasks of the enclosing team. The time per item of the previous call
   * with this functor type sets the number of tasks.
   */
  template <typename Functor>
  INLINE_METHOD void parallelForOnHost(const Range& range, const Functor functor) {
    ASSERTION(range.n >= 0, range.n);
    if (range.n == 0) {
      return;
    }
    if (omp_in_parallel()) {
      static std::atomic<double> secondsPerItem{0.0};
      const auto                 startTime       = std::chrono::steady_clock::now();
      const int                  numberOfThreads = omp_get_num_threads();
      const int                  numberOfTasks =
        getNumberOfHostTasks(range.n, numberOfThreads, secondsPerItem.load(std::memory_order_relaxed));
      // GCC and icpx fail to compile a task body that inherits always_inline from the enclosing
      // function. The tasks start in a lambda.
      [](const Range& range, const Functor& functor, const int numberOfTasks) {
        const int rangeSize = range.n;
#if defined(PEANO_OPENMP_TASKLOOP_SUPPORTED)
        const auto numberOfTaskItems = static_cast<unsigned long>(numberOfTasks);
#pragma omp taskloop default(none) num_tasks(numberOfTasks) firstprivate(numberOfTasks, numberOfTaskItems, rangeSize) \
  shared(functor)
        for (unsigned long taskNumber = 0; taskNumber < numberOfTaskItems; taskNumber++) {
          const auto task  = static_cast<int>(taskNumber);
          const int  begin = static_cast<int>(static_cast<std::int64_t>(rangeSize) * task / numberOfTasks);
          const int  end   = static_cast<int>(static_cast<std::int64_t>(rangeSize) * (task + 1) / numberOfTasks);
          for (int i = begin; i < end; i++) {
            functor(i);
          }
        }
#else
        tarch::accelerator::reportMissingTaskloopSupportOnce();
        for (int taskNumber = 0; taskNumber < numberOfTasks; taskNumber++) {
          const int begin = static_cast<int>(static_cast<std::int64_t>(rangeSize) * taskNumber / numberOfTasks);
          const int end   = static_cast<int>(static_cast<std::int64_t>(rangeSize) * (taskNumber + 1) / numberOfTasks);
#pragma omp task firstprivate(begin, end) shared(functor)
          {
            for (int i = begin; i < end; i++) {
              functor(i);
            }
          }
        }
#pragma omp taskwait
#endif
      }(range, functor, numberOfTasks);
      if (range.n > 0) {
        const std::chrono::duration<double> elapsed = std::chrono::steady_clock::now() - startTime;
        secondsPerItem.store(elapsed.count() * numberOfThreads / range.n, std::memory_order_relaxed);
      }
      return;
    }
    tarch::accelerator::runInParallelRegion([&]() {
#pragma omp for schedule(static)
      for (int i = 0; i < range.n; ++i) {
        functor(i);
      }
    });
  }
} // namespace tarch::accelerator
