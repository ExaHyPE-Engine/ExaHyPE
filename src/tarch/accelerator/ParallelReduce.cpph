namespace tarch::accelerator {
  template <typename T>
  inline void combine([[maybe_unused]] Max<T> reducer, T& acc, T value) {
    acc = (value > acc) ? value : acc;
  }
  template <typename T>
  inline void combine([[maybe_unused]] Min<T> reducer, T& acc, T value) {
    acc = (value < acc) ? value : acc;
  }
  template <typename T>
  inline void combine([[maybe_unused]] Sum<T> reducer, T& acc, T value) {
    acc = acc + value;
  }

  template <typename Reducer, typename F>
  inline void parallelReduce([[maybe_unused]] const CpuTeam& team, const Range& range, F body, Reducer reducer) {
    using T = typename Reducer::value_type;
    assertion(range.n >= 0, range.n);
    T local = Reducer::identity();
    for (int i = 0; i < range.n; ++i) {
      body(i, local);
    }
    tarch::accelerator::combine(reducer, reducer.target, local);
  }
  template <typename Reducer, typename F>
  inline void parallelReduce([[maybe_unused]] const CpuTeam& team, const RangeMD<2>& range, F body, Reducer reducer) {
    using T = typename Reducer::value_type;
    assertion(range.n[0] >= 0, range.n[0]);
    assertion(range.n[1] >= 0, range.n[1]);
    T local = Reducer::identity();
    for (int x = 0; x < range.n[0]; ++x) {
      for (int y = 0; y < range.n[1]; ++y) {
        body(x, y, local);
      }
    }
    tarch::accelerator::combine(reducer, reducer.target, local);
  }
  template <typename Reducer, typename F>
  inline void parallelReduce([[maybe_unused]] const CpuTeam& team, const RangeMD<3>& range, F body, Reducer reducer) {
    using T = typename Reducer::value_type;
    assertion(range.n[0] >= 0, range.n[0]);
    assertion(range.n[1] >= 0, range.n[1]);
    assertion(range.n[2] >= 0, range.n[2]);
    T local = Reducer::identity();
    for (int x = 0; x < range.n[0]; ++x) {
      for (int y = 0; y < range.n[1]; ++y) {
        for (int z = 0; z < range.n[2]; ++z) {
          body(x, y, z, local);
        }
      }
    }
    tarch::accelerator::combine(reducer, reducer.target, local);
  }

  template <typename Reducer, typename F>
  inline void parallelReduce(const Range& range, F body, Reducer reducer) {
    using T = typename Reducer::value_type;
    assertion(range.n >= 0, range.n);
    tarch::accelerator::runInParallelRegion([&]() {
      T local = Reducer::identity();
#pragma omp for schedule(static) nowait
      for (int i = 0; i < range.n; ++i) {
        body(i, local);
      }
#pragma omp critical(tarch_parallelReduce_merge)
      {
        tarch::accelerator::combine(reducer, reducer.target, local);
      }
    });
  }

  template <typename Reducer, typename F>
  inline void parallelReduce(const RangeMD<2>& range, F body, Reducer reducer) {
    using T = typename Reducer::value_type;
    assertion(range.n[0] >= 0, range.n[0]);
    assertion(range.n[1] >= 0, range.n[1]);
    tarch::accelerator::runInParallelRegion([&]() {
      T local = Reducer::identity();
#pragma omp for collapse(2) schedule(static) nowait
      for (int x = 0; x < range.n[0]; ++x) {
        for (int y = 0; y < range.n[1]; ++y) {
          body(x, y, local);
        }
      }
#pragma omp critical(tarch_parallelReduce_merge)
      {
        tarch::accelerator::combine(reducer, reducer.target, local);
      }
    });
  }

  template <typename Reducer, typename F>
  inline void parallelReduce(const RangeMD<3>& range, F body, Reducer reducer) {
    using T = typename Reducer::value_type;
    assertion(range.n[0] >= 0, range.n[0]);
    assertion(range.n[1] >= 0, range.n[1]);
    assertion(range.n[2] >= 0, range.n[2]);
    tarch::accelerator::runInParallelRegion([&]() {
      T local = Reducer::identity();
#pragma omp for collapse(3) schedule(static) nowait
      for (int x = 0; x < range.n[0]; ++x) {
        for (int y = 0; y < range.n[1]; ++y) {
          for (int z = 0; z < range.n[2]; ++z) {
            body(x, y, z, local);
          }
        }
      }
#pragma omp critical(tarch_parallelReduce_merge)
      {
        tarch::accelerator::combine(reducer, reducer.target, local);
      }
    });
  }

  template <typename Reducer, typename F>
  inline void parallelReduce(const TeamRange& range, F body, Reducer reducer) {
    using T = typename Reducer::value_type;
    assertion(range.n >= 0, range.n);
    tarch::accelerator::runInParallelRegion([&]() {
      T local = Reducer::identity();
#pragma omp for schedule(static) nowait
      for (int i = 0; i < range.n; ++i) {
        body(i, tarch::accelerator::CpuTeam{}, local);
      }
#pragma omp critical(tarch_parallelReduce_merge)
      {
        tarch::accelerator::combine(reducer, reducer.target, local);
      }
    });
  }
} // namespace tarch::accelerator
