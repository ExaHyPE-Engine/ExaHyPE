namespace tarch::accelerator {
  template <typename Reducer, typename Functor>
  INLINE_METHOD void parallelReduce(
    [[maybe_unused]] const CpuTeam& team,
    const Range&                    range,
    const Functor                   functor,
    const Reducer                   reducer
  ) {
    assertion(range.n >= 0, range.n);
    typename Reducer::ValueType teamAccumulator = Reducer::identity();
    for (int i = 0; i < range.n; ++i) {
      functor(i, teamAccumulator);
    }
    reducer.target = Reducer::combine(reducer.target, teamAccumulator);
  }
  template <typename Reducer, typename Functor>
  INLINE_METHOD void parallelReduce(
    [[maybe_unused]] const CpuTeam& team,
    const RangeMD<2>&               range,
    const Functor                   functor,
    const Reducer                   reducer
  ) {
    assertion(range.n[0] >= 0, range.n[0]);
    assertion(range.n[1] >= 0, range.n[1]);
    typename Reducer::ValueType teamAccumulator = Reducer::identity();
    for (int x = 0; x < range.n[0]; ++x) {
      for (int y = 0; y < range.n[1]; ++y) {
        functor(x, y, teamAccumulator);
      }
    }
    reducer.target = Reducer::combine(reducer.target, teamAccumulator);
  }
  template <typename Reducer, typename Functor>
  INLINE_METHOD void parallelReduce(
    [[maybe_unused]] const CpuTeam& team,
    const RangeMD<3>&               range,
    const Functor                   functor,
    const Reducer                   reducer
  ) {
    assertion(range.n[0] >= 0, range.n[0]);
    assertion(range.n[1] >= 0, range.n[1]);
    assertion(range.n[2] >= 0, range.n[2]);
    typename Reducer::ValueType teamAccumulator = Reducer::identity();
    for (int x = 0; x < range.n[0]; ++x) {
      for (int y = 0; y < range.n[1]; ++y) {
        for (int z = 0; z < range.n[2]; ++z) {
          functor(x, y, z, teamAccumulator);
        }
      }
    }
    reducer.target = Reducer::combine(reducer.target, teamAccumulator);
  }

  /**
   * Reduces over the range on the host threads. The partial values merge in thread order, so
   * the result depends on the thread count alone. Inside a parallel region the range splits into
   * tasks of the enclosing team, whose partial values merge in task order.
   */
  template <typename Reducer, typename Functor>
  INLINE_METHOD void parallelReduce(const Range& range, const Functor functor, const Reducer reducer) {
    assertion(range.n >= 0, range.n);
    using ValueType = typename Reducer::ValueType;
#if defined(_OPENMP)
    if (omp_in_parallel()) {
      constexpr int          TasksPerThread = 4;
      const int              numberOfTasks  = std::max(1, std::min(range.n, TasksPerThread * omp_get_num_threads()));
      const int              rangeSize      = range.n;
      std::vector<ValueType> partials(static_cast<std::size_t>(numberOfTasks), Reducer::identity());
      ValueType* const       partialValues = partials.data();
#if defined(PEANO_OPENMP_TASKLOOP_SUPPORTED)
      const auto numberOfTaskItems = static_cast<unsigned long>(numberOfTasks);
#pragma omp taskloop default(none) num_tasks(numberOfTasks) firstprivate(numberOfTasks, numberOfTaskItems, rangeSize) \
  shared(functor, partialValues)
      for (unsigned long taskNumber = 0; taskNumber < numberOfTaskItems; taskNumber++) {
        const auto task    = static_cast<int>(taskNumber);
        const int  begin   = static_cast<int>(static_cast<std::int64_t>(rangeSize) * task / numberOfTasks);
        const int  end     = static_cast<int>(static_cast<std::int64_t>(rangeSize) * (task + 1) / numberOfTasks);
        ValueType  partial = Reducer::identity();
        for (int i = begin; i < end; i++) {
          functor(i, partial);
        }
        partialValues[task] = partial;
      }
#else
      tarch::accelerator::reportMissingTaskloopSupportOnce();
      for (int task = 0; task < numberOfTasks; task++) {
#pragma omp task default(none) firstprivate(task, numberOfTasks, rangeSize) shared(functor, partialValues)
        {
          const int begin   = static_cast<int>(static_cast<std::int64_t>(rangeSize) * task / numberOfTasks);
          const int end     = static_cast<int>(static_cast<std::int64_t>(rangeSize) * (task + 1) / numberOfTasks);
          ValueType partial = Reducer::identity();
          for (int i = begin; i < end; i++) {
            functor(i, partial);
          }
          partialValues[task] = partial;
        }
      }
#pragma omp taskwait
#endif
      ValueType accumulator = Reducer::identity();
      for (const ValueType& partial : partials) {
        accumulator = Reducer::combine(accumulator, partial);
      }
      reducer.target = Reducer::combine(reducer.target, accumulator);
      return;
    }
#endif
    std::vector<ValueType> partials(static_cast<std::size_t>(omp_get_max_threads()), Reducer::identity());
#pragma omp parallel default(none) shared(range, functor, partials)
    {
      ValueType partial = Reducer::identity();
#pragma omp for schedule(static) nowait
      for (int i = 0; i < range.n; ++i) {
        functor(i, partial);
      }
      partials[static_cast<std::size_t>(omp_get_thread_num())] = partial;
    }
    ValueType accumulator = Reducer::identity();
    for (const ValueType& partial : partials) {
      accumulator = Reducer::combine(accumulator, partial);
    }
    reducer.target = Reducer::combine(reducer.target, accumulator);
  }

  template <typename Reducer, typename Functor>
  INLINE_METHOD void parallelReduce(const RangeMD<2>& range, const Functor functor, const Reducer reducer) {
    assertion(range.n[0] >= 0, range.n[0]);
    assertion(range.n[1] >= 0, range.n[1]);
    using ValueType = typename Reducer::ValueType;
    std::vector<ValueType> partials(static_cast<std::size_t>(omp_get_max_threads()), Reducer::identity());
#pragma omp parallel default(none) shared(range, functor, partials) if (not omp_in_parallel())
    {
      ValueType partial = Reducer::identity();
#pragma omp for collapse(2) schedule(static) nowait
      for (int x = 0; x < range.n[0]; ++x) {
        for (int y = 0; y < range.n[1]; ++y) {
          functor(x, y, partial);
        }
      }
      partials[static_cast<std::size_t>(omp_get_thread_num())] = partial;
    }
    ValueType accumulator = Reducer::identity();
    for (const ValueType& partial : partials) {
      accumulator = Reducer::combine(accumulator, partial);
    }
    reducer.target = Reducer::combine(reducer.target, accumulator);
  }

  template <typename Reducer, typename Functor>
  INLINE_METHOD void parallelReduce(const RangeMD<3>& range, const Functor functor, const Reducer reducer) {
    assertion(range.n[0] >= 0, range.n[0]);
    assertion(range.n[1] >= 0, range.n[1]);
    assertion(range.n[2] >= 0, range.n[2]);
    using ValueType = typename Reducer::ValueType;
    std::vector<ValueType> partials(static_cast<std::size_t>(omp_get_max_threads()), Reducer::identity());
#pragma omp parallel default(none) shared(range, functor, partials) if (not omp_in_parallel())
    {
      ValueType partial = Reducer::identity();
#pragma omp for collapse(3) schedule(static) nowait
      for (int x = 0; x < range.n[0]; ++x) {
        for (int y = 0; y < range.n[1]; ++y) {
          for (int z = 0; z < range.n[2]; ++z) {
            functor(x, y, z, partial);
          }
        }
      }
      partials[static_cast<std::size_t>(omp_get_thread_num())] = partial;
    }
    ValueType accumulator = Reducer::identity();
    for (const ValueType& partial : partials) {
      accumulator = Reducer::combine(accumulator, partial);
    }
    reducer.target = Reducer::combine(reducer.target, accumulator);
  }

  template <typename Reducer, typename Functor>
  INLINE_METHOD void parallelReduce(const TeamRange& range, const Functor functor, const Reducer reducer) {
    assertion(range.n >= 0, range.n);
    using ValueType = typename Reducer::ValueType;
    std::vector<ValueType> partials(static_cast<std::size_t>(omp_get_max_threads()), Reducer::identity());
#pragma omp parallel default(none) shared(range, functor, partials) if (not omp_in_parallel())
    {
      ValueType partial = Reducer::identity();
#pragma omp for schedule(static) nowait
      for (int i = 0; i < range.n; ++i) {
        functor(i, tarch::accelerator::CpuTeam{}, partial);
      }
      partials[static_cast<std::size_t>(omp_get_thread_num())] = partial;
    }
    ValueType accumulator = Reducer::identity();
    for (const ValueType& partial : partials) {
      accumulator = Reducer::combine(accumulator, partial);
    }
    reducer.target = Reducer::combine(reducer.target, accumulator);
  }
} // namespace tarch::accelerator
