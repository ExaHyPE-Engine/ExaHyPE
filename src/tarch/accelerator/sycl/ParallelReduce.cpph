namespace tarch::accelerator {
  template <typename T>
  INLINE_METHOD auto getSYCLOperator([[maybe_unused]] const Max<T> reducer) {
    return ::sycl::maximum<T>{};
  }
  template <typename T>
  INLINE_METHOD auto getSYCLOperator([[maybe_unused]] const Min<T> reducer) {
    return ::sycl::minimum<T>{};
  }
  template <typename T>
  INLINE_METHOD auto getSYCLOperator([[maybe_unused]] const Sum<T> reducer) {
    return ::sycl::plus<T>{};
  }

  template <typename Op>
  struct SyclCombine final {
    INLINE_METHOD GPU_CALLABLE_METHOD typename Op::ValueType operator()(
      const typename Op::ValueType& left,
      const typename Op::ValueType& right
    ) const {
      return Op::combine(left, right);
    }
  };

  template <typename Op>
  INLINE_METHOD auto getSYCLOperator([[maybe_unused]] const Custom<Op> reducer) {
    return SyclCombine<Op>{};
  }

  /**
   * Combines the partial value of every work item of the team into the target of the reducer.
   */
  template <typename Reducer>
  INLINE_METHOD GPU_CALLABLE_METHOD void reduceOverTeam(
    const SyclTeam&                   team,
    const typename Reducer::ValueType threadValue,
    const Reducer                     reducer
  ) {
    const typename Reducer::ValueType groupResult = tarch::accelerator::reduceTeamValue(team, threadValue, reducer);
    if (team.item.get_local_id(0) == 0) {
      reducer.target = Reducer::combine(reducer.target, groupResult);
    }
  }

  template <typename Reducer, typename Functor>
  INLINE_METHOD void parallelReduce(
    const SyclTeam& team,
    const Range&    range,
    const Functor   functor,
    const Reducer   reducer
  ) {
    typename Reducer::ValueType threadAccumulator = Reducer::identity();
    const int                   localIndex        = static_cast<int>(team.item.get_local_id(0));
    const int                   localSize         = static_cast<int>(team.item.get_local_range(0));
    for (int i = localIndex; i < range.n; i += localSize) {
      functor(i, threadAccumulator);
    }
    const typename Reducer::ValueType groupResult =
      tarch::accelerator::reduceTeamValue(team, threadAccumulator, reducer);
    if (localIndex == 0) {
      reducer.target = Reducer::combine(reducer.target, groupResult);
    }
  }
  template <typename Reducer, typename Functor>
  INLINE_METHOD void parallelReduce(
    const SyclTeam&   team,
    const RangeMD<2>& range,
    const Functor     functor,
    const Reducer     reducer
  ) {
    typename Reducer::ValueType threadAccumulator = Reducer::identity();
    const int                   numberOfItems     = range.n[0] * range.n[1];
    const int                   extentY           = range.n[1];
    const int                   localIndex        = static_cast<int>(team.item.get_local_id(0));
    const int                   localSize         = static_cast<int>(team.item.get_local_range(0));
    for (int index = localIndex; index < numberOfItems; index += localSize) {
      functor(index / extentY, index % extentY, threadAccumulator);
    }
    const typename Reducer::ValueType groupResult =
      tarch::accelerator::reduceTeamValue(team, threadAccumulator, reducer);
    if (localIndex == 0) {
      reducer.target = Reducer::combine(reducer.target, groupResult);
    }
  }
  template <typename Reducer, typename Functor>
  INLINE_METHOD void parallelReduce(
    const SyclTeam&   team,
    const RangeMD<3>& range,
    const Functor     functor,
    const Reducer     reducer
  ) {
    typename Reducer::ValueType threadAccumulator = Reducer::identity();
    const int                   numberOfItems     = range.n[0] * range.n[1] * range.n[2];
    const int                   extentY           = range.n[1];
    const int                   extentZ           = range.n[2];
    const int                   localIndex        = static_cast<int>(team.item.get_local_id(0));
    const int                   localSize         = static_cast<int>(team.item.get_local_range(0));
    for (int index = localIndex; index < numberOfItems; index += localSize) {
      functor(index / (extentY * extentZ), (index / extentZ) % extentY, index % extentZ, threadAccumulator);
    }
    const typename Reducer::ValueType groupResult =
      tarch::accelerator::reduceTeamValue(team, threadAccumulator, reducer);
    if (localIndex == 0) {
      reducer.target = Reducer::combine(reducer.target, groupResult);
    }
  }

  template <typename Reducer, typename Functor>
  INLINE_METHOD void parallelReduce(const Range& range, const Functor functor, const Reducer reducer) {
    ASSERTION(range.n >= 0, range.n);
    if (range.n <= 0) {
      return;
    }
    using ValueType = typename Reducer::ValueType;
    auto& queue =
      *static_cast<::sycl::queue*>(tarch::accelerator::getSYCLQueue(tarch::accelerator::getCurrentDevice()));
    tarch::accelerator::lockReductionScratch(sizeof(ValueType));
    auto* const deviceTarget = static_cast<ValueType*>(tarch::accelerator::getReductionStaging(sizeof(ValueType)));
    *deviceTarget            = reducer.target;
    queue
      .submit([&](::sycl::handler& handler) {
        auto reduction = ::sycl::reduction(deviceTarget, tarch::accelerator::getSYCLOperator(reducer));
        handler.parallel_for(::sycl::range<1>(range.n), reduction, [=](const ::sycl::id<1> itemId, auto& accumulator) {
          ValueType threadAccumulator = Reducer::identity();
          functor(static_cast<int>(itemId[0]), threadAccumulator);
          accumulator.combine(threadAccumulator);
        });
      })
      .wait();
    reducer.target = *deviceTarget;
    tarch::accelerator::unlockReductionScratch();
  }

  template <typename Reducer, typename Functor>
  INLINE_METHOD void parallelReduce(const RangeMD<2>& range, const Functor functor, const Reducer reducer) {
    ASSERTION(range.n[0] >= 0, range.n[0]);
    ASSERTION(range.n[1] >= 0, range.n[1]);
    const int extentY = range.n[1];
    tarch::accelerator::parallelReduce(
      Range(range.n[0] * range.n[1]),
      [=](const int index, typename Reducer::ValueType& accumulator) {
        functor(index / extentY, index % extentY, accumulator);
      },
      reducer
    );
  }
  template <typename Reducer, typename Functor>
  INLINE_METHOD void parallelReduce(const RangeMD<3>& range, const Functor functor, const Reducer reducer) {
    ASSERTION(range.n[0] >= 0, range.n[0]);
    ASSERTION(range.n[1] >= 0, range.n[1]);
    ASSERTION(range.n[2] >= 0, range.n[2]);
    const int extentY = range.n[1];
    const int extentZ = range.n[2];
    tarch::accelerator::parallelReduce(
      Range(range.n[0] * range.n[1] * range.n[2]),
      [=](const int index, typename Reducer::ValueType& accumulator) {
        functor(index / (extentY * extentZ), (index / extentZ) % extentY, index % extentZ, accumulator);
      },
      reducer
    );
  }

  template <typename Reducer, typename Functor>
  INLINE_METHOD void parallelReduce(const TeamRange& range, const Functor functor, const Reducer reducer) {
    ASSERTION(range.n >= 0, range.n);
    if (range.n <= 0) {
      return;
    }
    using ValueType = typename Reducer::ValueType;
    static_assert(
      std::is_trivially_copyable_v<Functor>,
      "The SYCL backend supports team reductions with trivially copyable functors only."
    );
    auto& queue =
      *static_cast<::sycl::queue*>(tarch::accelerator::getSYCLQueue(tarch::accelerator::getCurrentDevice()));
    // AdaptiveCpp outlines a large kernel body and copies the kernel arguments into the stack of every
    // work item. The kernel therefore receives the address of a copy of the functor in device memory.
    constexpr std::size_t TeamValuesOffset =
      (sizeof(Functor) + alignof(ValueType) - 1) / alignof(ValueType) * alignof(ValueType);
    auto* const deviceScratch = static_cast<unsigned char*>(
      tarch::accelerator::lockReductionScratch(TeamValuesOffset + static_cast<std::size_t>(range.n) * sizeof(ValueType))
    );
    auto* const functorOnDevice = reinterpret_cast<Functor*>(deviceScratch);
    auto* const teamValues      = reinterpret_cast<ValueType*>(deviceScratch + TeamValuesOffset);
    auto* const deviceTarget    = static_cast<ValueType*>(tarch::accelerator::getReductionStaging(sizeof(ValueType)));
    *deviceTarget               = reducer.target;
    const ::sycl::event       functorCopied = queue.memcpy(functorOnDevice, &functor, sizeof(Functor));
    const int                 threads       = tarch::accelerator::getTeamThreads(range.threads);
    const ::sycl::nd_range<1> groupedRange(::sycl::range<1>(range.n * threads), ::sycl::range<1>(threads));
    // A custom team reduction writes one value per work item into the team scratch.
    const int partialWords = static_cast<int>(
      (static_cast<std::size_t>(threads) * sizeof(ValueType) + sizeof(std::uint64_t) - 1) / sizeof(std::uint64_t)
    );
    const int scratchWords = std::max(tarch::accelerator::getTeamScratchWords(range.scratchBytes), partialWords);
    // A reduction of AdaptiveCpp combines the values of its work groups correctly only for work groups
    // whose size is a power of two. reduceOverTeam() combines the value of a team into the accumulator
    // of its first work item.
    const ::sycl::event teamsReduced = queue.submit([&](::sycl::handler& handler) {
      handler.depends_on(functorCopied);
      const ::sycl::local_accessor<std::uint64_t, 1> scratch(::sycl::range<1>(scratchWords), handler);
      handler.parallel_for(groupedRange, [=](const ::sycl::nd_item<1> item) {
        ValueType threadAccumulator = Reducer::identity();
        (*functorOnDevice)(
          static_cast<int>(item.get_group(0)),
          tarch::accelerator::SyclTeam{item, reinterpret_cast<unsigned char*>(&scratch[0])},
          threadAccumulator
        );
        if (item.get_local_id(0) == 0) {
          teamValues[item.get_group(0)] = threadAccumulator;
        }
      });
    });
    queue
      .submit([&](::sycl::handler& handler) {
        handler.depends_on(teamsReduced);
        auto reduction = ::sycl::reduction(deviceTarget, tarch::accelerator::getSYCLOperator(reducer));
        handler.parallel_for(::sycl::range<1>(range.n), reduction, [=](const ::sycl::id<1> team, auto& accumulator) {
          accumulator.combine(teamValues[team[0]]);
        });
      })
      .wait();
    reducer.target = *deviceTarget;
    tarch::accelerator::unlockReductionScratch();
  }
} // namespace tarch::accelerator

template <typename Reducer>
INLINE_METHOD GPU_CALLABLE_METHOD typename Reducer::ValueType
tarch::accelerator::reduceTeamValue(
  const tarch::accelerator::SyclTeam& team,
  const typename Reducer::ValueType   value,
  const Reducer                       reducer
) {
  return ::sycl::reduce_over_group(team.item.get_group(), value, tarch::accelerator::getSYCLOperator(reducer));
}

/**
 * Combines the values of all work items through the team scratch. The group algorithms of SYCL
 * take arithmetic types only.
 */
template <typename Op>
INLINE_METHOD GPU_CALLABLE_METHOD typename Op::ValueType
tarch::accelerator::reduceTeamValue(
  const tarch::accelerator::SyclTeam&                   team,
  const typename Op::ValueType                          value,
  [[maybe_unused]] const tarch::accelerator::Custom<Op> reducer
) {
  using ValueType = typename Op::ValueType;
  static_assert(
    sizeof(ValueType) * tarch::accelerator::SyclLocalSize <= tarch::accelerator::TeamScratchBytes,
    "A team reduction of the SYCL backend supports values of at most 64 bytes."
  );
  static_assert(alignof(ValueType) <= alignof(std::uint64_t), "A reduction value must align to 8 bytes or less.");
  ValueType* const partials   = reinterpret_cast<ValueType*>(team.scratch);
  const auto       group      = team.item.get_group();
  const int        localIndex = static_cast<int>(team.item.get_local_id(0));
  const int        localSize  = static_cast<int>(team.item.get_local_range(0));
  partials[localIndex]        = value;
  ::sycl::group_barrier(group);
  if (localIndex == 0) {
    ValueType teamValue = Op::identity();
    for (int source = 0; source < localSize; source++) {
      teamValue = Op::combine(teamValue, partials[source]);
    }
    partials[0] = teamValue;
  }
  ::sycl::group_barrier(group);
  const ValueType result = partials[0];
  ::sycl::group_barrier(group);
  return result;
}
