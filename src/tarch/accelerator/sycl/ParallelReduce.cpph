namespace tarch::accelerator {
  template <typename T>
  inline auto syclOp([[maybe_unused]] Max<T> reducer) {
    return ::sycl::maximum<T>{};
  }
  template <typename T>
  inline auto syclOp([[maybe_unused]] Min<T> reducer) {
    return ::sycl::minimum<T>{};
  }
  template <typename T>
  inline auto syclOp([[maybe_unused]] Sum<T> reducer) {
    return ::sycl::plus<T>{};
  }

  template <typename T>
  inline T combineOp([[maybe_unused]] Max<T> reducer, T left, T right) {
    return left > right ? left : right;
  }
  template <typename T>
  inline T combineOp([[maybe_unused]] Min<T> reducer, T left, T right) {
    return left < right ? left : right;
  }
  template <typename T>
  inline T combineOp([[maybe_unused]] Sum<T> reducer, T left, T right) {
    return left + right;
  }

  template <typename Reducer, typename F>
  inline void parallelReduce(const SyclTeam& team, const Range& range, F body, Reducer reducer) {
    using T            = typename Reducer::value_type;
    T         localAcc = Reducer::identity();
    const int local    = static_cast<int>(team.item.get_local_id(0));
    const int stride   = static_cast<int>(team.item.get_local_range(0));
    for (int i = local; i < range.n; i += stride) {
      body(i, localAcc);
    }
    const T groupResult = ::sycl::reduce_over_group(team.item.get_group(), localAcc, syclOp(reducer));
    if (local == 0) {
      reducer.target = combineOp(reducer, reducer.target, groupResult);
    }
  }
  template <typename Reducer, typename F>
  inline void parallelReduce(const SyclTeam& team, const RangeMD<2>& range, F body, Reducer reducer) {
    using T            = typename Reducer::value_type;
    T         localAcc = Reducer::identity();
    const int total    = range.n[0] * range.n[1];
    const int n1       = range.n[1];
    const int local    = static_cast<int>(team.item.get_local_id(0));
    const int stride   = static_cast<int>(team.item.get_local_range(0));
    for (int idx = local; idx < total; idx += stride) {
      const int x = idx / n1;
      const int y = idx % n1;
      body(x, y, localAcc);
    }
    const T groupResult = ::sycl::reduce_over_group(team.item.get_group(), localAcc, syclOp(reducer));
    if (local == 0) {
      reducer.target = combineOp(reducer, reducer.target, groupResult);
    }
  }
  template <typename Reducer, typename F>
  inline void parallelReduce(const SyclTeam& team, const RangeMD<3>& range, F body, Reducer reducer) {
    using T            = typename Reducer::value_type;
    T         localAcc = Reducer::identity();
    const int total    = range.n[0] * range.n[1] * range.n[2];
    const int n1       = range.n[1];
    const int n2       = range.n[2];
    const int local    = static_cast<int>(team.item.get_local_id(0));
    const int stride   = static_cast<int>(team.item.get_local_range(0));
    for (int idx = local; idx < total; idx += stride) {
      const int x = idx / (n1 * n2);
      const int y = (idx / n2) % n1;
      const int z = idx % n2;
      body(x, y, z, localAcc);
    }
    const T groupResult = ::sycl::reduce_over_group(team.item.get_group(), localAcc, syclOp(reducer));
    if (local == 0) {
      reducer.target = combineOp(reducer, reducer.target, groupResult);
    }
  }

  template <typename Reducer, typename F>
  inline void parallelReduce(const Range& range, F body, Reducer reducer) {
    if (range.n <= 0) {
      return;
    }
    using T = typename Reducer::value_type;
    auto& queue =
      *static_cast<::sycl::queue*>(tarch::accelerator::getSYCLQueue(tarch::accelerator::getCurrentDevice()));
    const T initialValue = reducer.target;
    T*      devTarget    = ::sycl::malloc_shared<T>(1, queue);
    *devTarget           = initialValue;
    queue
      .submit([&](::sycl::handler& handler) {
        auto reduction = ::sycl::reduction(devTarget, tarch::accelerator::syclOp(reducer));
        handler.parallel_for(::sycl::range<1>(range.n), reduction, [=](::sycl::id<1> id, auto& acc) {
          T threadLocal = Reducer::identity();
          body(static_cast<int>(id[0]), threadLocal);
          acc.combine(threadLocal);
        });
      })
      .wait();
    reducer.target = *devTarget;
    ::sycl::free(devTarget, queue);
  }

  template <typename Reducer, typename F>
  inline void parallelReduce(const RangeMD<2>& range, F body, Reducer reducer) {
    const int total = range.n[0] * range.n[1];
    const int n1    = range.n[1];
    parallelReduce(
      Range(total),
      [=](int idx, typename Reducer::value_type& acc) {
        const int x = idx / n1;
        const int y = idx % n1;
        body(x, y, acc);
      },
      reducer
    );
  }
  template <typename Reducer, typename F>
  inline void parallelReduce(const RangeMD<3>& range, F body, Reducer reducer) {
    const int total = range.n[0] * range.n[1] * range.n[2];
    const int n1    = range.n[1];
    const int n2    = range.n[2];
    parallelReduce(
      Range(total),
      [=](int idx, typename Reducer::value_type& acc) {
        const int x = idx / (n1 * n2);
        const int y = (idx / n2) % n1;
        const int z = idx % n2;
        body(x, y, z, acc);
      },
      reducer
    );
  }

  template <typename Reducer, typename F>
  inline void parallelReduce(const TeamRange& range, F body, Reducer reducer) {
    if (range.n <= 0) {
      return;
    }
    using T = typename Reducer::value_type;
    auto& queue =
      *static_cast<::sycl::queue*>(tarch::accelerator::getSYCLQueue(tarch::accelerator::getCurrentDevice()));
    const T initialValue = reducer.target;
    T*      devTarget    = ::sycl::malloc_shared<T>(1, queue);
    *devTarget           = initialValue;
    const ::sycl::nd_range<1> ndRange(
      ::sycl::range<1>(range.n * tarch::accelerator::SyclLocalSize),
      ::sycl::range<1>(tarch::accelerator::SyclLocalSize)
    );
    queue
      .submit([&](::sycl::handler& handler) {
        auto reduction = ::sycl::reduction(devTarget, tarch::accelerator::syclOp(reducer));
        handler.parallel_for(ndRange, reduction, [=](::sycl::nd_item<1> item, auto& acc) {
          T threadLocal = Reducer::identity();
          body(static_cast<int>(item.get_group(0)), tarch::accelerator::SyclTeam{item}, threadLocal);
          acc.combine(threadLocal);
        });
      })
      .wait();
    reducer.target = *devTarget;
    ::sycl::free(devTarget, queue);
  }
} // namespace tarch::accelerator
