namespace tarch::accelerator {
  template <typename T>
  inline auto sycl_op(Max<T>) {
    return ::sycl::maximum<T>{};
  }
  template <typename T>
  inline auto sycl_op(Min<T>) {
    return ::sycl::minimum<T>{};
  }
  template <typename T>
  inline auto sycl_op(Sum<T>) {
    return ::sycl::plus<T>{};
  }

  // Device-side leader combine (folds a work-group result into red.target). In SYCL
  // single-source no __device__ annotation is needed; the name matches the CUDA/HIP
  // helper. TODO: the TeamRange path uses a 1D nd_range of local size kSyclLocalSize
  // (=256); the deleted per-backend kernels used 16x16 (2D)/8x8x8=512 (3D) tiling, so
  // the 3D work-group is now smaller — retune kSyclLocalSize if profiling regresses.
  template <typename T>
  inline T combine_op(Max<T>, T a, T b) {
    return a > b ? a : b;
  }
  template <typename T>
  inline T combine_op(Min<T>, T a, T b) {
    return a < b ? a : b;
  }
  template <typename T>
  inline T combine_op(Sum<T>, T a, T b) {
    return a + b;
  }

  template <typename Reducer, typename F>
  inline void parallelReduce(const SyclTeam& team, const Range& r, F f, Reducer red) {
    using T            = typename Reducer::value_type;
    T         localAcc = Reducer::identity();
    const int local    = static_cast<int>(team.item.get_local_id(0));
    const int stride   = static_cast<int>(team.item.get_local_range(0));
    for (int i = local; i < r.n; i += stride) {
      f(i, localAcc);
    }
    T groupResult = ::sycl::reduce_over_group(team.item.get_group(), localAcc, sycl_op(red));
    if (local == 0) {
      red.target = combine_op(red, red.target, groupResult);
    }
  }
  template <typename Reducer, typename F>
  inline void parallelReduce(const SyclTeam& team, const RangeMD<2>& r, F f, Reducer red) {
    using T            = typename Reducer::value_type;
    T         localAcc = Reducer::identity();
    const int total    = r.n[0] * r.n[1];
    const int n1       = r.n[1];
    const int local    = static_cast<int>(team.item.get_local_id(0));
    const int stride   = static_cast<int>(team.item.get_local_range(0));
    for (int idx = local; idx < total; idx += stride) {
      const int x = idx / n1;
      const int y = idx % n1;
      f(x, y, localAcc);
    }
    T groupResult = ::sycl::reduce_over_group(team.item.get_group(), localAcc, sycl_op(red));
    if (local == 0) {
      red.target = combine_op(red, red.target, groupResult);
    }
  }
  template <typename Reducer, typename F>
  inline void parallelReduce(const SyclTeam& team, const RangeMD<3>& r, F f, Reducer red) {
    using T            = typename Reducer::value_type;
    T         localAcc = Reducer::identity();
    const int total    = r.n[0] * r.n[1] * r.n[2];
    const int n1       = r.n[1];
    const int n2       = r.n[2];
    const int local    = static_cast<int>(team.item.get_local_id(0));
    const int stride   = static_cast<int>(team.item.get_local_range(0));
    for (int idx = local; idx < total; idx += stride) {
      const int x = idx / (n1 * n2);
      const int y = (idx / n2) % n1;
      const int z = idx % n2;
      f(x, y, z, localAcc);
    }
    T groupResult = ::sycl::reduce_over_group(team.item.get_group(), localAcc, sycl_op(red));
    if (local == 0) {
      red.target = combine_op(red, red.target, groupResult);
    }
  }
} // namespace tarch::accelerator

namespace tarch {
  template <typename Reducer, typename F>
  inline void parallelReduce(const Range& r, F f, Reducer red) {
    if (r.n <= 0) {
      return;
    }
    using T         = typename Reducer::value_type;
    auto& q         = *static_cast<::sycl::queue*>(accelerator::getSYCLQueue(accelerator::getCurrentDevice()));
    T     accInit   = red.target;
    T*    devTarget = ::sycl::malloc_shared<T>(1, q);
    *devTarget      = accInit;
    q.submit(
       [&](::sycl::handler& h) {
         auto reduction = ::sycl::reduction(devTarget, accelerator::sycl_op(red));
         h.parallel_for(::sycl::range<1>(r.n), reduction, [=](::sycl::id<1> id, auto& acc) {
           T threadLocal = Reducer::identity();
           f(static_cast<int>(id[0]), threadLocal);
           acc.combine(threadLocal);
         });
       }
    ).wait();
    red.target = *devTarget;
    ::sycl::free(devTarget, q);
  }

  template <typename Reducer, typename F>
  inline void parallelReduce(const RangeMD<2>& r, F f, Reducer red) {
    const int total = r.n[0] * r.n[1];
    const int n1    = r.n[1];
    parallelReduce(
      Range(total),
      [=](int idx, typename Reducer::value_type& acc) {
        const int x = idx / n1;
        const int y = idx % n1;
        f(x, y, acc);
      },
      red
    );
  }
  template <typename Reducer, typename F>
  inline void parallelReduce(const RangeMD<3>& r, F f, Reducer red) {
    const int total = r.n[0] * r.n[1] * r.n[2];
    const int n1    = r.n[1];
    const int n2    = r.n[2];
    parallelReduce(
      Range(total),
      [=](int idx, typename Reducer::value_type& acc) {
        const int x = idx / (n1 * n2);
        const int y = (idx / n2) % n1;
        const int z = idx % n2;
        f(x, y, z, acc);
      },
      red
    );
  }

  template <typename Reducer, typename F>
  inline void parallelReduce(const TeamRange& r, F f, Reducer red) {
    if (r.n <= 0) {
      return;
    }
    using T         = typename Reducer::value_type;
    auto& q         = *static_cast<::sycl::queue*>(accelerator::getSYCLQueue(accelerator::getCurrentDevice()));
    T     accInit   = red.target;
    T*    devTarget = ::sycl::malloc_shared<T>(1, q);
    *devTarget      = accInit;
    ::sycl::nd_range<1> nd(
      ::sycl::range<1>(r.n * accelerator::kSyclLocalSize),
      ::sycl::range<1>(accelerator::kSyclLocalSize)
    );
    q.submit(
       [&](::sycl::handler& h) {
         auto reduction = ::sycl::reduction(devTarget, accelerator::sycl_op(red));
         h.parallel_for(nd, reduction, [=](::sycl::nd_item<1> item, auto& acc) {
           T threadLocal = Reducer::identity();
           f(static_cast<int>(item.get_group(0)), accelerator::SyclTeam{item}, threadLocal);
           acc.combine(threadLocal);
         });
       }
    ).wait();
    red.target = *devTarget;
    ::sycl::free(devTarget, q);
  }
} // namespace tarch
