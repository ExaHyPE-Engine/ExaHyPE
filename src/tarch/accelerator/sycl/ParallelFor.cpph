namespace tarch::accelerator {
  /**
   * Returns the work items per team of a launch that asks for requested work items. The count
   * rounds requested up to whole sub-groups and stops at SyclLocalSize. TeamRange::BackendDefault
   * asks for SyclLocalSize work items.
   */
  INLINE_METHOD int getTeamThreads(const int requested) {
    if (requested == tarch::accelerator::TeamRange::BackendDefault) {
      return tarch::accelerator::SyclLocalSize;
    }
    assertion(requested > 0, requested);
    const int warps = (requested + tarch::accelerator::ThreadsPerWarp - 1) / tarch::accelerator::ThreadsPerWarp;
    return std::min(tarch::accelerator::SyclLocalSize, warps * tarch::accelerator::ThreadsPerWarp);
  }

  /**
   * Returns the local memory per team of a launch that asks for requested bytes.
   * TeamRange::BackendDefault asks for TeamScratchBytes.
   */
  INLINE_METHOD int getTeamScratchBytes(const int requested) {
    if (requested == tarch::accelerator::TeamRange::BackendDefault) {
      return tarch::accelerator::TeamScratchBytes;
    }
    assertion(requested >= 0 and requested <= tarch::accelerator::TeamScratchBytes, requested);
    return requested;
  }

  /**
   * Returns the 64-bit words of the local accessor of a team launch, at least one. The address of
   * its first entry then exists.
   */
  INLINE_METHOD int getTeamScratchWords(const int requested) {
    constexpr auto WordBytes = static_cast<int>(sizeof(std::uint64_t));
    return std::max(1, (tarch::accelerator::getTeamScratchBytes(requested) + WordBytes - 1) / WordBytes);
  }

  template <typename Functor>
  INLINE_METHOD void parallelFor(const SyclTeam& team, const Range& range, const Functor functor) {
    const int localIndex = static_cast<int>(team.item.get_local_id(0));
    const int localSize  = static_cast<int>(team.item.get_local_range(0));
    for (int i = localIndex; i < range.n; i += localSize) {
      functor(i);
    }
  }
  template <typename Functor>
  INLINE_METHOD void parallelFor(const SyclTeam& team, const RangeMD<2>& range, const Functor functor) {
    const int numberOfItems = range.n[0] * range.n[1];
    const int extentY       = range.n[1];
    const int localIndex    = static_cast<int>(team.item.get_local_id(0));
    const int localSize     = static_cast<int>(team.item.get_local_range(0));
    for (int index = localIndex; index < numberOfItems; index += localSize) {
      functor(index / extentY, index % extentY);
    }
  }
  template <typename Functor>
  INLINE_METHOD void parallelFor(const SyclTeam& team, const RangeMD<3>& range, const Functor functor) {
    const int numberOfItems = range.n[0] * range.n[1] * range.n[2];
    const int extentY       = range.n[1];
    const int extentZ       = range.n[2];
    const int localIndex    = static_cast<int>(team.item.get_local_id(0));
    const int localSize     = static_cast<int>(team.item.get_local_range(0));
    for (int index = localIndex; index < numberOfItems; index += localSize) {
      functor(index / (extentY * extentZ), (index / extentZ) % extentY, index % extentZ);
    }
  }

  INLINE_METHOD GPU_CALLABLE_METHOD int getThreadOfTeam(const SyclTeam& team) {
    return static_cast<int>(team.item.get_local_id(0));
  }

  INLINE_METHOD GPU_CALLABLE_METHOD unsigned char* getTeamScratch(const SyclTeam& team) { return team.scratch; }

  INLINE_METHOD GPU_CALLABLE_METHOD int getNumberOfThreadsPerTeam(const SyclTeam& team) {
    return static_cast<int>(team.item.get_local_range(0));
  }

  INLINE_METHOD GPU_CALLABLE_METHOD void teamBarrier(const SyclTeam& team) {
    ::sycl::group_barrier(team.item.get_group());
  }

  /**
   * Returns whether condition is true in every work item of the team. Every work item receives the
   * same value.
   */
  INLINE_METHOD GPU_CALLABLE_METHOD bool isTrueInEveryThreadOfTeam(const SyclTeam& team, const bool condition) {
    return ::sycl::all_of_group(team.item.get_group(), condition);
  }

  /**
   * Returns whether condition is true in any work item of the team. Every work item receives the
   * same value.
   */
  INLINE_METHOD GPU_CALLABLE_METHOD bool isTrueInAnyThreadOfTeam(const SyclTeam& team, const bool condition) {
    return ::sycl::any_of_group(team.item.get_group(), condition);
  }

  template <typename Functor>
  INLINE_METHOD void parallelFor(const Range& range, const Functor functor) {
    assertion(range.n >= 0, range.n);
    if (range.n <= 0) {
      return;
    }
    auto& queue =
      *static_cast<::sycl::queue*>(tarch::accelerator::getSYCLQueue(tarch::accelerator::getCurrentDevice()));
    queue
      .submit([&](::sycl::handler& handler) {
        handler.parallel_for(::sycl::range<1>(range.n), [=](const ::sycl::id<1> itemId) {
          functor(static_cast<int>(itemId[0]));
        });
      })
      .wait();
  }

  template <typename Functor>
  INLINE_METHOD void parallelFor(const RangeMD<2>& range, const Functor functor) {
    assertion(range.n[0] >= 0, range.n[0]);
    assertion(range.n[1] >= 0, range.n[1]);
    if (range.n[0] <= 0 or range.n[1] <= 0) {
      return;
    }
    auto& queue =
      *static_cast<::sycl::queue*>(tarch::accelerator::getSYCLQueue(tarch::accelerator::getCurrentDevice()));
    queue
      .submit([&](::sycl::handler& handler) {
        handler.parallel_for(::sycl::range<2>(range.n[0], range.n[1]), [=](const ::sycl::id<2> itemId) {
          functor(static_cast<int>(itemId[0]), static_cast<int>(itemId[1]));
        });
      })
      .wait();
  }

  template <typename Functor>
  INLINE_METHOD void parallelFor(const RangeMD<3>& range, const Functor functor) {
    assertion(range.n[0] >= 0, range.n[0]);
    assertion(range.n[1] >= 0, range.n[1]);
    assertion(range.n[2] >= 0, range.n[2]);
    if (range.n[0] <= 0 or range.n[1] <= 0 or range.n[2] <= 0) {
      return;
    }
    auto& queue =
      *static_cast<::sycl::queue*>(tarch::accelerator::getSYCLQueue(tarch::accelerator::getCurrentDevice()));
    queue
      .submit([&](::sycl::handler& handler) {
        handler.parallel_for(::sycl::range<3>(range.n[0], range.n[1], range.n[2]), [=](const ::sycl::id<3> itemId) {
          functor(static_cast<int>(itemId[0]), static_cast<int>(itemId[1]), static_cast<int>(itemId[2]));
        });
      })
      .wait();
  }

  template <typename Functor>
  INLINE_METHOD void parallelFor(const TeamRange& range, const Functor functor) {
    assertion(range.n >= 0, range.n);
    if (range.n <= 0) {
      return;
    }
    auto& queue =
      *static_cast<::sycl::queue*>(tarch::accelerator::getSYCLQueue(tarch::accelerator::getCurrentDevice()));
    const int                 threads = tarch::accelerator::getTeamThreads(range.threads);
    const ::sycl::nd_range<1> groupedRange(::sycl::range<1>(range.n * threads), ::sycl::range<1>(threads));
    queue
      .submit([&](::sycl::handler& handler) {
        const ::sycl::local_accessor<std::uint64_t, 1> scratch(
          ::sycl::range<1>(tarch::accelerator::getTeamScratchWords(range.scratchBytes)),
          handler
        );
        handler.parallel_for(groupedRange, [=](const ::sycl::nd_item<1> item) {
          functor(
            static_cast<int>(item.get_group(0)),
            tarch::accelerator::SyclTeam{item, reinterpret_cast<unsigned char*>(&scratch[0])}
          );
        });
      })
      .wait();
  }
} // namespace tarch::accelerator
