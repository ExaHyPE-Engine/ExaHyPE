namespace tarch::accelerator {
  template <typename F>
  inline void parallelFor(const SyclTeam& team, const Range& range, F body) {
    const int local  = static_cast<int>(team.item.get_local_id(0));
    const int stride = static_cast<int>(team.item.get_local_range(0));
    for (int i = local; i < range.n; i += stride) {
      body(i);
    }
  }
  template <typename F>
  inline void parallelFor(const SyclTeam& team, const RangeMD<2>& range, F body) {
    const int total  = range.n[0] * range.n[1];
    const int n1     = range.n[1];
    const int local  = static_cast<int>(team.item.get_local_id(0));
    const int stride = static_cast<int>(team.item.get_local_range(0));
    for (int idx = local; idx < total; idx += stride) {
      const int x = idx / n1;
      const int y = idx % n1;
      body(x, y);
    }
  }
  template <typename F>
  inline void parallelFor(const SyclTeam& team, const RangeMD<3>& range, F body) {
    const int total  = range.n[0] * range.n[1] * range.n[2];
    const int n1     = range.n[1];
    const int n2     = range.n[2];
    const int local  = static_cast<int>(team.item.get_local_id(0));
    const int stride = static_cast<int>(team.item.get_local_range(0));
    for (int idx = local; idx < total; idx += stride) {
      const int x = idx / (n1 * n2);
      const int y = (idx / n2) % n1;
      const int z = idx % n2;
      body(x, y, z);
    }
  }

  template <typename F>
  inline void parallelFor(const Range& range, F body) {
    if (range.n <= 0) {
      return;
    }
    auto& queue =
      *static_cast<::sycl::queue*>(tarch::accelerator::getSYCLQueue(tarch::accelerator::getCurrentDevice()));
    queue
      .submit([&](::sycl::handler& handler) {
        handler.parallel_for(::sycl::range<1>(range.n), [=](::sycl::id<1> id) { body(static_cast<int>(id[0])); });
      })
      .wait();
  }

  template <typename F>
  inline void parallelFor(const RangeMD<2>& range, F body) {
    if (range.n[0] <= 0 or range.n[1] <= 0) {
      return;
    }
    auto& queue =
      *static_cast<::sycl::queue*>(tarch::accelerator::getSYCLQueue(tarch::accelerator::getCurrentDevice()));
    queue
      .submit([&](::sycl::handler& handler) {
        handler.parallel_for(::sycl::range<2>(range.n[0], range.n[1]), [=](::sycl::id<2> id) {
          body(static_cast<int>(id[0]), static_cast<int>(id[1]));
        });
      })
      .wait();
  }

  template <typename F>
  inline void parallelFor(const RangeMD<3>& range, F body) {
    if (range.n[0] <= 0 or range.n[1] <= 0 or range.n[2] <= 0) {
      return;
    }
    auto& queue =
      *static_cast<::sycl::queue*>(tarch::accelerator::getSYCLQueue(tarch::accelerator::getCurrentDevice()));
    queue
      .submit([&](::sycl::handler& handler) {
        handler.parallel_for(::sycl::range<3>(range.n[0], range.n[1], range.n[2]), [=](::sycl::id<3> id) {
          body(static_cast<int>(id[0]), static_cast<int>(id[1]), static_cast<int>(id[2]));
        });
      })
      .wait();
  }

  template <typename F>
  inline void parallelFor(const TeamRange& range, F body) {
    if (range.n <= 0) {
      return;
    }
    auto& queue =
      *static_cast<::sycl::queue*>(tarch::accelerator::getSYCLQueue(tarch::accelerator::getCurrentDevice()));
    const ::sycl::nd_range<1> ndRange(
      ::sycl::range<1>(range.n * tarch::accelerator::SyclLocalSize),
      ::sycl::range<1>(tarch::accelerator::SyclLocalSize)
    );
    queue
      .submit([&](::sycl::handler& handler) {
        handler.parallel_for(ndRange, [=](::sycl::nd_item<1> item) {
          body(static_cast<int>(item.get_group(0)), tarch::accelerator::SyclTeam{item});
        });
      })
      .wait();
  }
} // namespace tarch::accelerator
