  template <typename Op, typename Functor>
  inline void parallelReduce(
    const OmptTeam&   team,
    const RangeMD<3>& range,
    const Functor     functor,
    const Custom<Op>  reducer
  ) {
    using ValueType = typename Op::ValueType;
    static_assert(
      sizeof(ValueType) * MaxThreadsPerTeam <= TeamScratchBytes,
      "The custom value exceeds the team scratch."
    );
    ValueType partial = Custom<Op>::identity();
#pragma omp for collapse(3) nowait
    for (int x = 0; x < range.n[0]; ++x) {
      for (int y = 0; y < range.n[1]; ++y) {
        for (int z = 0; z < range.n[2]; ++z) {
          functor(x, y, z, partial);
        }
      }
    }
    ValueType* const partials      = reinterpret_cast<ValueType*>(team.scratch);
    partials[omp_get_thread_num()] = partial;
#pragma omp barrier
#pragma omp master
    {
      ValueType teamValue = Custom<Op>::identity();
      for (int thread = 0; thread < omp_get_num_threads(); thread++) {
        teamValue = Custom<Op>::combine(teamValue, partials[thread]);
      }
      reducer.target = Custom<Op>::combine(reducer.target, teamValue);
    }
#pragma omp barrier
  }
  TARGET_DECLARE_END

  template <typename T, typename Functor>
  inline void parallelReduce(const Range& range, const Functor functor, const Max<T> reducer) {
    assertion(range.n >= 0, range.n);
    if (range.n <= 0) {
      return;
    }
    T         accumulator = Max<T>::identity();
    const int device      = tarch::accelerator::getCurrentDevice();
#pragma omp target teams distribute parallel for reduction(max : accumulator) device(device)
    for (int i = 0; i < range.n; ++i) {
      functor(i, accumulator);
    }
    reducer.target = Max<T>::combine(reducer.target, accumulator);
  }
  template <typename T, typename Functor>
  inline void parallelReduce(const Range& range, const Functor functor, const Min<T> reducer) {
    assertion(range.n >= 0, range.n);
    if (range.n <= 0) {
      return;
    }
    T         accumulator = Min<T>::identity();
    const int device      = tarch::accelerator::getCurrentDevice();
#pragma omp target teams distribute parallel for reduction(min : accumulator) device(device)
    for (int i = 0; i < range.n; ++i) {
      functor(i, accumulator);
    }
    reducer.target = Min<T>::combine(reducer.target, accumulator);
  }
  template <typename T, typename Functor>
  inline void parallelReduce(const Range& range, const Functor functor, const Sum<T> reducer) {
    assertion(range.n >= 0, range.n);
    if (range.n <= 0) {
      return;
    }
    T         accumulator = Sum<T>::identity();
    const int device      = tarch::accelerator::getCurrentDevice();
#pragma omp target teams distribute parallel for reduction(+ : accumulator) device(device)
    for (int i = 0; i < range.n; ++i) {
      functor(i, accumulator);
    }
    reducer.target = Sum<T>::combine(reducer.target, accumulator);
  }
  template <typename Op, typename Functor>
  inline void parallelReduce(const Range& range, const Functor functor, const Custom<Op> reducer) {
    assertion(range.n >= 0, range.n);
    if (range.n <= 0) {
      return;
    }
    using ValueType         = typename Op::ValueType;
    const int numberOfTeams = (range.n + CustomTeamChunk - 1) / CustomTeamChunk;
    const int count         = range.n;
    parallelReduce(
      TeamRange(numberOfTeams),
      [=](const int team, const OmptTeam handle, ValueType& teamAccumulator) {
        const int first = team * CustomTeamChunk;
        const int last  = (count - first < CustomTeamChunk) ? count : first + CustomTeamChunk;
        parallelReduce(
          handle,
          Range(last - first),
          [=](const int i, ValueType& accumulator) { functor(first + i, accumulator); },
          Custom<Op>{teamAccumulator}
        );
      },
      reducer
    );
  }

  template <typename T, typename Functor>
  inline void parallelReduce(const RangeMD<2>& range, const Functor functor, const Max<T> reducer) {
    assertion(range.n[0] >= 0, range.n[0]);
    assertion(range.n[1] >= 0, range.n[1]);
    if (range.n[0] <= 0 or range.n[1] <= 0) {
      return;
    }
    T         accumulator = Max<T>::identity();
    const int device      = tarch::accelerator::getCurrentDevice();
#pragma omp target teams distribute parallel for collapse(2) reduction(max : accumulator) device(device)
    for (int x = 0; x < range.n[0]; ++x) {
      for (int y = 0; y < range.n[1]; ++y) {
        functor(x, y, accumulator);
      }
    }
    reducer.target = Max<T>::combine(reducer.target, accumulator);
  }
  template <typename T, typename Functor>
  inline void parallelReduce(const RangeMD<2>& range, const Functor functor, const Min<T> reducer) {
    assertion(range.n[0] >= 0, range.n[0]);
    assertion(range.n[1] >= 0, range.n[1]);
    if (range.n[0] <= 0 or range.n[1] <= 0) {
      return;
    }
    T         accumulator = Min<T>::identity();
    const int device      = tarch::accelerator::getCurrentDevice();
#pragma omp target teams distribute parallel for collapse(2) reduction(min : accumulator) device(device)
    for (int x = 0; x < range.n[0]; ++x) {
      for (int y = 0; y < range.n[1]; ++y) {
        functor(x, y, accumulator);
      }
    }
    reducer.target = Min<T>::combine(reducer.target, accumulator);
  }
  template <typename T, typename Functor>
  inline void parallelReduce(const RangeMD<2>& range, const Functor functor, const Sum<T> reducer) {
    assertion(range.n[0] >= 0, range.n[0]);
    assertion(range.n[1] >= 0, range.n[1]);
    if (range.n[0] <= 0 or range.n[1] <= 0) {
      return;
    }
    T         accumulator = Sum<T>::identity();
    const int device      = tarch::accelerator::getCurrentDevice();
#pragma omp target teams distribute parallel for collapse(2) reduction(+ : accumulator) device(device)
    for (int x = 0; x < range.n[0]; ++x) {
      for (int y = 0; y < range.n[1]; ++y) {
        functor(x, y, accumulator);
      }
    }
    reducer.target = Sum<T>::combine(reducer.target, accumulator);
  }
  template <typename Op, typename Functor>
  inline void parallelReduce(const RangeMD<2>& range, const Functor functor, const Custom<Op> reducer) {
    assertion(range.n[0] >= 0, range.n[0]);
    assertion(range.n[1] >= 0, range.n[1]);
    if (range.n[0] <= 0 or range.n[1] <= 0) {
      return;
    }
    const int extentY = range.n[1];
    parallelReduce(
      Range(range.n[0] * range.n[1]),
      [=](const int index, typename Op::ValueType& accumulator) {
        functor(index / extentY, index % extentY, accumulator);
      },
      reducer
    );
  }

  template <typename T, typename Functor>
  inline void parallelReduce(const RangeMD<3>& range, const Functor functor, const Max<T> reducer) {
    assertion(range.n[0] >= 0, range.n[0]);
    assertion(range.n[1] >= 0, range.n[1]);
    assertion(range.n[2] >= 0, range.n[2]);
    if (range.n[0] <= 0 or range.n[1] <= 0 or range.n[2] <= 0) {
      return;
    }
    T         accumulator = Max<T>::identity();
    const int device      = tarch::accelerator::getCurrentDevice();
#pragma omp target teams distribute parallel for collapse(3) reduction(max : accumulator) device(device)
    for (int x = 0; x < range.n[0]; ++x) {
      for (int y = 0; y < range.n[1]; ++y) {
        for (int z = 0; z < range.n[2]; ++z) {
          functor(x, y, z, accumulator);
        }
      }
    }
    reducer.target = Max<T>::combine(reducer.target, accumulator);
  }
  template <typename T, typename Functor>
  inline void parallelReduce(const RangeMD<3>& range, const Functor functor, const Min<T> reducer) {
    assertion(range.n[0] >= 0, range.n[0]);
    assertion(range.n[1] >= 0, range.n[1]);
    assertion(range.n[2] >= 0, range.n[2]);
    if (range.n[0] <= 0 or range.n[1] <= 0 or range.n[2] <= 0) {
      return;
    }
    T         accumulator = Min<T>::identity();
    const int device      = tarch::accelerator::getCurrentDevice();
#pragma omp target teams distribute parallel for collapse(3) reduction(min : accumulator) device(device)
    for (int x = 0; x < range.n[0]; ++x) {
      for (int y = 0; y < range.n[1]; ++y) {
        for (int z = 0; z < range.n[2]; ++z) {
          functor(x, y, z, accumulator);
        }
      }
    }
    reducer.target = Min<T>::combine(reducer.target, accumulator);
  }
  template <typename T, typename Functor>
  inline void parallelReduce(const RangeMD<3>& range, const Functor functor, const Sum<T> reducer) {
    assertion(range.n[0] >= 0, range.n[0]);
    assertion(range.n[1] >= 0, range.n[1]);
    assertion(range.n[2] >= 0, range.n[2]);
    if (range.n[0] <= 0 or range.n[1] <= 0 or range.n[2] <= 0) {
      return;
    }
    T         accumulator = Sum<T>::identity();
    const int device      = tarch::accelerator::getCurrentDevice();
#pragma omp target teams distribute parallel for collapse(3) reduction(+ : accumulator) device(device)
    for (int x = 0; x < range.n[0]; ++x) {
      for (int y = 0; y < range.n[1]; ++y) {
        for (int z = 0; z < range.n[2]; ++z) {
          functor(x, y, z, accumulator);
        }
      }
    }
    reducer.target = Sum<T>::combine(reducer.target, accumulator);
  }
  template <typename Op, typename Functor>
  inline void parallelReduce(const RangeMD<3>& range, const Functor functor, const Custom<Op> reducer) {
    assertion(range.n[0] >= 0, range.n[0]);
    assertion(range.n[1] >= 0, range.n[1]);
    assertion(range.n[2] >= 0, range.n[2]);
    if (range.n[0] <= 0 or range.n[1] <= 0 or range.n[2] <= 0) {
      return;
    }
    const int extentY = range.n[1];
    const int extentZ = range.n[2];
    parallelReduce(
      Range(range.n[0] * range.n[1] * range.n[2]),
      [=](const int index, typename Op::ValueType& accumulator) {
        functor(index / (extentY * extentZ), (index / extentZ) % extentY, index % extentZ, accumulator);
      },
      reducer
    );
  }

  template <typename T, typename Functor>
  inline void parallelReduce(const TeamRange& range, const Functor functor, const Max<T> reducer) {
    assertion(range.n >= 0, range.n);
    if (range.n <= 0) {
      return;
    }
    T         accumulator = Max<T>::identity();
    const int device      = tarch::accelerator::getCurrentDevice();
#pragma omp target teams distribute reduction(max : accumulator) device(device)
    for (int i = 0; i < range.n; ++i) {
      T                                           teamAccumulator = Max<T>::identity();
      alignas(PEANO_WITH_ALIGNMENT) unsigned char teamScratch[TeamScratchBytes];
#pragma omp                         parallel default(none) shared(functor, i, teamAccumulator, teamScratch)
      {
        functor(i, tarch::accelerator::OmptTeam{teamScratch}, teamAccumulator);
      }
      accumulator = Max<T>::combine(accumulator, teamAccumulator);
    }
    reducer.target = Max<T>::combine(reducer.target, accumulator);
  }
  template <typename T, typename Functor>
  inline void parallelReduce(const TeamRange& range, const Functor functor, const Min<T> reducer) {
    assertion(range.n >= 0, range.n);
    if (range.n <= 0) {
      return;
    }
    T         accumulator = Min<T>::identity();
    const int device      = tarch::accelerator::getCurrentDevice();
#pragma omp target teams distribute reduction(min : accumulator) device(device)
    for (int i = 0; i < range.n; ++i) {
      T                                           teamAccumulator = Min<T>::identity();
      alignas(PEANO_WITH_ALIGNMENT) unsigned char teamScratch[TeamScratchBytes];
#pragma omp                         parallel default(none) shared(functor, i, teamAccumulator, teamScratch)
      {
        functor(i, tarch::accelerator::OmptTeam{teamScratch}, teamAccumulator);
      }
      accumulator = Min<T>::combine(accumulator, teamAccumulator);
    }
    reducer.target = Min<T>::combine(reducer.target, accumulator);
  }
  template <typename T, typename Functor>
  inline void parallelReduce(const TeamRange& range, const Functor functor, const Sum<T> reducer) {
    assertion(range.n >= 0, range.n);
    if (range.n <= 0) {
      return;
    }
    T         accumulator = Sum<T>::identity();
    const int device      = tarch::accelerator::getCurrentDevice();
#pragma omp target teams distribute reduction(+ : accumulator) device(device)
    for (int i = 0; i < range.n; ++i) {
      T                                           teamAccumulator = Sum<T>::identity();
      alignas(PEANO_WITH_ALIGNMENT) unsigned char teamScratch[TeamScratchBytes];
#pragma omp                         parallel default(none) shared(functor, i, teamAccumulator, teamScratch)
      {
        functor(i, tarch::accelerator::OmptTeam{teamScratch}, teamAccumulator);
      }
      accumulator = Sum<T>::combine(accumulator, teamAccumulator);
    }
    reducer.target = Sum<T>::combine(reducer.target, accumulator);
  }
  template <typename Op, typename Functor>
  inline void parallelReduce(const TeamRange& range, const Functor functor, const Custom<Op> reducer) {
    assertion(range.n >= 0, range.n);
    if (range.n <= 0) {
      return;
    }
    using ValueType              = typename Op::ValueType;
    const int        device      = tarch::accelerator::getCurrentDevice();
    ValueType* const teamResults = tarch::allocateMemory<ValueType>(range.n, tarch::MemoryLocation::Device, device);
#pragma omp target teams distribute device(device) is_device_ptr(teamResults)
    for (int i = 0; i < range.n; ++i) {
      ValueType                                   teamAccumulator = Custom<Op>::identity();
      alignas(PEANO_WITH_ALIGNMENT) unsigned char teamScratch[TeamScratchBytes];
#pragma omp                         parallel default(none) shared(functor, i, teamAccumulator, teamScratch)
      {
        functor(i, tarch::accelerator::OmptTeam{teamScratch}, teamAccumulator);
      }
      teamResults[i] = teamAccumulator;
    }
    std::vector<ValueType> hostResults(range.n);
    tarch::copyFrom(teamResults, hostResults.data(), range.n, tarch::MemoryLocation::Device, device);
    for (const ValueType& teamResult : hostResults) {
      reducer.target = Custom<Op>::combine(reducer.target, teamResult);
    }
    tarch::freeMemory(teamResults, tarch::MemoryLocation::Device, device);
  }
} // namespace tarch::accelerator

#endif // defined(PEANO_WITH_GPU_BACKEND_OMPT)
