  template <typename T, typename Functor>
  INLINE_METHOD void parallelReduce(
    [[maybe_unused]] const OmptTeam& team,
    const RangeMD<3>&                range,
    const Functor                    functor,
    const Max<T>                     reducer
  ) {
    T partial = Max<T>::identity();
#pragma omp for collapse(3) nowait
    for (int x = 0; x < range.n[0]; ++x) {
      for (int y = 0; y < range.n[1]; ++y) {
        for (int z = 0; z < range.n[2]; ++z) {
          functor(x, y, z, partial);
        }
      }
    }
    T& target = reducer.target;
#pragma omp atomic compare
    if (target < partial) {
      target = partial;
    }
#pragma omp barrier
  }
  template <typename T, typename Functor>
  INLINE_METHOD void parallelReduce(
    [[maybe_unused]] const OmptTeam& team,
    const RangeMD<3>&                range,
    const Functor                    functor,
    const Min<T>                     reducer
  ) {
    T partial = Min<T>::identity();
#pragma omp for collapse(3) nowait
    for (int x = 0; x < range.n[0]; ++x) {
      for (int y = 0; y < range.n[1]; ++y) {
        for (int z = 0; z < range.n[2]; ++z) {
          functor(x, y, z, partial);
        }
      }
    }
    T& target = reducer.target;
#pragma omp atomic compare
    if (target > partial) {
      target = partial;
    }
#pragma omp barrier
  }
  template <typename T, typename Functor>
  INLINE_METHOD void parallelReduce(
    [[maybe_unused]] const OmptTeam& team,
    const RangeMD<3>&                range,
    const Functor                    functor,
    const Sum<T>                     reducer
  ) {
    T partial = Sum<T>::identity();
#pragma omp for collapse(3) nowait
    for (int x = 0; x < range.n[0]; ++x) {
      for (int y = 0; y < range.n[1]; ++y) {
        for (int z = 0; z < range.n[2]; ++z) {
          functor(x, y, z, partial);
        }
      }
    }
    T& target = reducer.target;
#pragma omp atomic update
    target += partial;
#pragma omp barrier
  }
  template <typename Op, typename Functor>
  INLINE_METHOD void parallelReduce(
    const OmptTeam&   team,
    const RangeMD<3>& range,
    const Functor     functor,
    const Custom<Op>  reducer
  ) {
    using ValueType = typename Op::ValueType;
    static_assert(
      sizeof(ValueType) * OmptThreadsPerTeam <= TeamScratchBytes,
      "The scratch memory of a team needs room for one reduction value per thread."
    );
    ValueType partial = Custom<Op>::identity();
#pragma omp for collapse(3) nowait
    for (int x = 0; x < range.n[0]; ++x) {
      for (int y = 0; y < range.n[1]; ++y) {
        for (int z = 0; z < range.n[2]; ++z) {
          functor(x, y, z, partial);
        }
      }
    }
    ValueType* const partials      = reinterpret_cast<ValueType*>(team.scratch);
    partials[omp_get_thread_num()] = partial;
#pragma omp barrier
#pragma omp master
    {
      ValueType teamValue = Custom<Op>::identity();
      for (int thread = 0; thread < omp_get_num_threads(); thread++) {
        teamValue = Custom<Op>::combine(teamValue, partials[thread]);
      }
      reducer.target = Custom<Op>::combine(reducer.target, teamValue);
    }
#pragma omp barrier
  }
  TARGET_DECLARE_END

  template <typename T, typename Functor>
  INLINE_METHOD void parallelReduce(const Range& range, const Functor functor, const Max<T> reducer) {
    ASSERTION(range.n >= 0, range.n);
    if (range.n <= 0) {
      return;
    }
    T         accumulator   = Max<T>::identity();
    const int device        = tarch::accelerator::getCurrentDevice();
    const int numberOfItems = range.n;
#pragma omp target teams distribute parallel for reduction(max : accumulator) firstprivate(functor) device(device)
    for (int i = 0; i < numberOfItems; ++i) {
      functor(i, accumulator);
    }
    reducer.target = Max<T>::combine(reducer.target, accumulator);
  }
  template <typename T, typename Functor>
  INLINE_METHOD void parallelReduce(const Range& range, const Functor functor, const Min<T> reducer) {
    ASSERTION(range.n >= 0, range.n);
    if (range.n <= 0) {
      return;
    }
    T         accumulator   = Min<T>::identity();
    const int device        = tarch::accelerator::getCurrentDevice();
    const int numberOfItems = range.n;
#pragma omp target teams distribute parallel for reduction(min : accumulator) firstprivate(functor) device(device)
    for (int i = 0; i < numberOfItems; ++i) {
      functor(i, accumulator);
    }
    reducer.target = Min<T>::combine(reducer.target, accumulator);
  }
  template <typename T, typename Functor>
  INLINE_METHOD void parallelReduce(const Range& range, const Functor functor, const Sum<T> reducer) {
    ASSERTION(range.n >= 0, range.n);
    if (range.n <= 0) {
      return;
    }
    T         accumulator   = Sum<T>::identity();
    const int device        = tarch::accelerator::getCurrentDevice();
    const int numberOfItems = range.n;
#pragma omp target teams distribute parallel for reduction(+ : accumulator) firstprivate(functor) device(device)
    for (int i = 0; i < numberOfItems; ++i) {
      functor(i, accumulator);
    }
    reducer.target = Sum<T>::combine(reducer.target, accumulator);
  }
  template <typename Op, typename Functor>
  INLINE_METHOD void parallelReduce(const Range& range, const Functor functor, const Custom<Op> reducer) {
    ASSERTION(range.n >= 0, range.n);
    if (range.n <= 0) {
      return;
    }
    using PaddedValue = PaddedReductionValue<Op>;
#pragma omp declare reduction(custom:PaddedValue : omp_out.value = Custom<Op>::combine(omp_out.value, omp_in.value)) \
  initializer(omp_priv = PaddedValue{Custom<Op>::identity()})
    PaddedValue accumulator{Custom<Op>::identity()};
    const int   device        = tarch::accelerator::getCurrentDevice();
    const int   numberOfItems = range.n;
#pragma omp target teams distribute parallel for reduction(custom : accumulator) firstprivate(functor) device(device)
    for (int i = 0; i < numberOfItems; ++i) {
      functor(i, accumulator.value);
    }
    reducer.target = Custom<Op>::combine(reducer.target, accumulator.value);
  }

  template <typename T, typename Functor>
  INLINE_METHOD void parallelReduce(const RangeMD<2>& range, const Functor functor, const Max<T> reducer) {
    ASSERTION(range.n[0] >= 0, range.n[0]);
    ASSERTION(range.n[1] >= 0, range.n[1]);
    if (range.n[0] <= 0 or range.n[1] <= 0) {
      return;
    }
    T         accumulator = Max<T>::identity();
    const int device      = tarch::accelerator::getCurrentDevice();
    const int extentX     = range.n[0];
    const int extentY     = range.n[1];
#pragma omp target teams distribute parallel for collapse(2) reduction(max : accumulator) firstprivate(functor) \
  device(device)
    for (int x = 0; x < extentX; ++x) {
      for (int y = 0; y < extentY; ++y) {
        functor(x, y, accumulator);
      }
    }
    reducer.target = Max<T>::combine(reducer.target, accumulator);
  }
  template <typename T, typename Functor>
  INLINE_METHOD void parallelReduce(const RangeMD<2>& range, const Functor functor, const Min<T> reducer) {
    ASSERTION(range.n[0] >= 0, range.n[0]);
    ASSERTION(range.n[1] >= 0, range.n[1]);
    if (range.n[0] <= 0 or range.n[1] <= 0) {
      return;
    }
    T         accumulator = Min<T>::identity();
    const int device      = tarch::accelerator::getCurrentDevice();
    const int extentX     = range.n[0];
    const int extentY     = range.n[1];
#pragma omp target teams distribute parallel for collapse(2) reduction(min : accumulator) firstprivate(functor) \
  device(device)
    for (int x = 0; x < extentX; ++x) {
      for (int y = 0; y < extentY; ++y) {
        functor(x, y, accumulator);
      }
    }
    reducer.target = Min<T>::combine(reducer.target, accumulator);
  }
  template <typename T, typename Functor>
  INLINE_METHOD void parallelReduce(const RangeMD<2>& range, const Functor functor, const Sum<T> reducer) {
    ASSERTION(range.n[0] >= 0, range.n[0]);
    ASSERTION(range.n[1] >= 0, range.n[1]);
    if (range.n[0] <= 0 or range.n[1] <= 0) {
      return;
    }
    T         accumulator = Sum<T>::identity();
    const int device      = tarch::accelerator::getCurrentDevice();
    const int extentX     = range.n[0];
    const int extentY     = range.n[1];
#pragma omp target teams distribute parallel for collapse(2) reduction(+ : accumulator) firstprivate(functor) \
  device(device)
    for (int x = 0; x < extentX; ++x) {
      for (int y = 0; y < extentY; ++y) {
        functor(x, y, accumulator);
      }
    }
    reducer.target = Sum<T>::combine(reducer.target, accumulator);
  }
  template <typename Op, typename Functor>
  INLINE_METHOD void parallelReduce(const RangeMD<2>& range, const Functor functor, const Custom<Op> reducer) {
    ASSERTION(range.n[0] >= 0, range.n[0]);
    ASSERTION(range.n[1] >= 0, range.n[1]);
    if (range.n[0] <= 0 or range.n[1] <= 0) {
      return;
    }
    const int extentY = range.n[1];
    parallelReduce(
      Range(range.n[0] * range.n[1]),
      [=](const int index, typename Op::ValueType& accumulator) {
        functor(index / extentY, index % extentY, accumulator);
      },
      reducer
    );
  }

  template <typename T, typename Functor>
  INLINE_METHOD void parallelReduce(const RangeMD<3>& range, const Functor functor, const Max<T> reducer) {
    ASSERTION(range.n[0] >= 0, range.n[0]);
    ASSERTION(range.n[1] >= 0, range.n[1]);
    ASSERTION(range.n[2] >= 0, range.n[2]);
    if (range.n[0] <= 0 or range.n[1] <= 0 or range.n[2] <= 0) {
      return;
    }
    T         accumulator = Max<T>::identity();
    const int device      = tarch::accelerator::getCurrentDevice();
    const int extentX     = range.n[0];
    const int extentY     = range.n[1];
    const int extentZ     = range.n[2];
#pragma omp target teams distribute parallel for collapse(3) reduction(max : accumulator) firstprivate(functor) \
  device(device)
    for (int x = 0; x < extentX; ++x) {
      for (int y = 0; y < extentY; ++y) {
        for (int z = 0; z < extentZ; ++z) {
          functor(x, y, z, accumulator);
        }
      }
    }
    reducer.target = Max<T>::combine(reducer.target, accumulator);
  }
  template <typename T, typename Functor>
  INLINE_METHOD void parallelReduce(const RangeMD<3>& range, const Functor functor, const Min<T> reducer) {
    ASSERTION(range.n[0] >= 0, range.n[0]);
    ASSERTION(range.n[1] >= 0, range.n[1]);
    ASSERTION(range.n[2] >= 0, range.n[2]);
    if (range.n[0] <= 0 or range.n[1] <= 0 or range.n[2] <= 0) {
      return;
    }
    T         accumulator = Min<T>::identity();
    const int device      = tarch::accelerator::getCurrentDevice();
    const int extentX     = range.n[0];
    const int extentY     = range.n[1];
    const int extentZ     = range.n[2];
#pragma omp target teams distribute parallel for collapse(3) reduction(min : accumulator) firstprivate(functor) \
  device(device)
    for (int x = 0; x < extentX; ++x) {
      for (int y = 0; y < extentY; ++y) {
        for (int z = 0; z < extentZ; ++z) {
          functor(x, y, z, accumulator);
        }
      }
    }
    reducer.target = Min<T>::combine(reducer.target, accumulator);
  }
  template <typename T, typename Functor>
  INLINE_METHOD void parallelReduce(const RangeMD<3>& range, const Functor functor, const Sum<T> reducer) {
    ASSERTION(range.n[0] >= 0, range.n[0]);
    ASSERTION(range.n[1] >= 0, range.n[1]);
    ASSERTION(range.n[2] >= 0, range.n[2]);
    if (range.n[0] <= 0 or range.n[1] <= 0 or range.n[2] <= 0) {
      return;
    }
    T         accumulator = Sum<T>::identity();
    const int device      = tarch::accelerator::getCurrentDevice();
    const int extentX     = range.n[0];
    const int extentY     = range.n[1];
    const int extentZ     = range.n[2];
#pragma omp target teams distribute parallel for collapse(3) reduction(+ : accumulator) firstprivate(functor) \
  device(device)
    for (int x = 0; x < extentX; ++x) {
      for (int y = 0; y < extentY; ++y) {
        for (int z = 0; z < extentZ; ++z) {
          functor(x, y, z, accumulator);
        }
      }
    }
    reducer.target = Sum<T>::combine(reducer.target, accumulator);
  }
  template <typename Op, typename Functor>
  INLINE_METHOD void parallelReduce(const RangeMD<3>& range, const Functor functor, const Custom<Op> reducer) {
    ASSERTION(range.n[0] >= 0, range.n[0]);
    ASSERTION(range.n[1] >= 0, range.n[1]);
    ASSERTION(range.n[2] >= 0, range.n[2]);
    if (range.n[0] <= 0 or range.n[1] <= 0 or range.n[2] <= 0) {
      return;
    }
    const int extentY = range.n[1];
    const int extentZ = range.n[2];
    parallelReduce(
      Range(range.n[0] * range.n[1] * range.n[2]),
      [=](const int index, typename Op::ValueType& accumulator) {
        functor(index / (extentY * extentZ), (index / extentZ) % extentY, index % extentZ, accumulator);
      },
      reducer
    );
  }

  template <typename Reducer, typename Functor>
  INLINE_METHOD void parallelReduce(const TeamRange& range, const Functor functor, const Reducer reducer) {
    ASSERTION(range.n >= 0, range.n);
    if (range.n <= 0) {
      return;
    }
    using ValueType                = typename Reducer::ValueType;
    const int        device        = tarch::accelerator::getCurrentDevice();
    const int        numberOfTeams = range.n;
    const int        threads       = tarch::accelerator::getTeamThreads(range.threads);
    const auto       resultBytes   = static_cast<std::size_t>(range.n) * sizeof(ValueType);
    ValueType* const teamResults   = static_cast<ValueType*>(tarch::accelerator::lockReductionScratch(resultBytes));
#pragma omp target teams num_teams(numberOfTeams) thread_limit(threads) is_device_ptr(teamResults) \
  firstprivate(functor) device(device)
#pragma omp parallel num_threads(threads)
    {
      // A static of a class type with default member initialisers needs an initialisation at run
      // time. teamAccumulatorBytes therefore stores the accumulator of the team as raw bytes.
      alignas(PEANO_WITH_ALIGNMENT) static unsigned char teamScratch[TeamScratchBytes];
      static int                                         teamVotes[OmptThreadsPerTeam];
      alignas(ValueType) static unsigned char            teamAccumulatorBytes[sizeof(ValueType)];
#pragma omp allocate(teamScratch, teamVotes, teamAccumulatorBytes) allocator(omp_pteam_mem_alloc)
      ValueType& teamAccumulator = *std::launder(reinterpret_cast<ValueType*>(teamAccumulatorBytes));
      for (int team = omp_get_team_num(); team < numberOfTeams; team += omp_get_num_teams()) {
        if (omp_get_thread_num() == 0) {
          teamAccumulator = Reducer::identity();
        }
#pragma omp barrier
        functor(team, tarch::accelerator::OmptTeam{teamScratch, teamVotes}, teamAccumulator);
#pragma omp barrier
        if (omp_get_thread_num() == 0) {
          teamResults[team] = teamAccumulator;
        }
      }
    }
    auto* const hostResults = static_cast<ValueType*>(tarch::accelerator::getReductionStaging(resultBytes));
    tarch::copyFrom(teamResults, hostResults, range.n, tarch::MemoryLocation::Device, device);
    for (int team = 0; team < range.n; team++) {
      reducer.target = Reducer::combine(reducer.target, hostResults[team]);
    }
    tarch::accelerator::unlockReductionScratch();
  }
} // namespace tarch::accelerator

#endif // defined(PEANO_WITH_GPU_BACKEND_OMPT)
