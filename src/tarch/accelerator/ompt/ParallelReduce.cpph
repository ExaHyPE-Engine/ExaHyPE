#if defined(PEANO_WITH_GPU_BACKEND_OMPT)

namespace tarch::accelerator {
  // OMPT cannot express a generic reducer through the `reduction(...)` clause, so it
  // only supports Max/Min/Sum (one explicit overload set per reducer). Any new reducer
  // added to Reducer.h needs a matching overload + clause here, or OMPT will not build.
  //
  // combineOp and the inner OmptTeam overloads run inside the outer `target` region,
  // so they carry the declare-target wrapping that makes them device-compilable. The
  // inner overloads spread the iteration space over the team's threads with
  // `parallel for`.
  TARGET_DECLARE
  template <typename T>
  inline T combineOp([[maybe_unused]] Max<T> reducer, T left, T right) {
    return left > right ? left : right;
  }
  template <typename T>
  inline T combineOp([[maybe_unused]] Min<T> reducer, T left, T right) {
    return left < right ? left : right;
  }
  template <typename T>
  inline T combineOp([[maybe_unused]] Sum<T> reducer, T left, T right) {
    return left + right;
  }

  template <typename T, typename F>
  inline void parallelReduce([[maybe_unused]] const OmptTeam& team, const Range& range, F body, Max<T> reducer) {
    T local = Max<T>::identity();
#pragma omp                         parallel for reduction(max : local)
    for (int i = 0; i < range.n; ++i) {
      body(i, local);
    }
    reducer.target = tarch::accelerator::combineOp(reducer, reducer.target, local);
  }
  template <typename T, typename F>
  inline void parallelReduce([[maybe_unused]] const OmptTeam& team, const Range& range, F body, Min<T> reducer) {
    T local = Min<T>::identity();
#pragma omp parallel for reduction(min : local)
    for (int i = 0; i < range.n; ++i) {
      body(i, local);
    }
    reducer.target = tarch::accelerator::combineOp(reducer, reducer.target, local);
  }
  template <typename T, typename F>
  inline void parallelReduce([[maybe_unused]] const OmptTeam& team, const Range& range, F body, Sum<T> reducer) {
    T local = Sum<T>::identity();
#pragma omp parallel for reduction(+ : local)
    for (int i = 0; i < range.n; ++i) {
      body(i, local);
    }
    reducer.target = tarch::accelerator::combineOp(reducer, reducer.target, local);
  }

  template <typename T, typename F>
  inline void parallelReduce([[maybe_unused]] const OmptTeam& team, const RangeMD<2>& range, F body, Max<T> reducer) {
    T local = Max<T>::identity();
#pragma omp parallel for collapse(2) reduction(max : local)
    for (int x = 0; x < range.n[0]; ++x) {
      for (int y = 0; y < range.n[1]; ++y) {
        body(x, y, local);
      }
    }
    reducer.target = tarch::accelerator::combineOp(reducer, reducer.target, local);
  }
  template <typename T, typename F>
  inline void parallelReduce([[maybe_unused]] const OmptTeam& team, const RangeMD<2>& range, F body, Min<T> reducer) {
    T local = Min<T>::identity();
#pragma omp parallel for collapse(2) reduction(min : local)
    for (int x = 0; x < range.n[0]; ++x) {
      for (int y = 0; y < range.n[1]; ++y) {
        body(x, y, local);
      }
    }
    reducer.target = tarch::accelerator::combineOp(reducer, reducer.target, local);
  }
  template <typename T, typename F>
  inline void parallelReduce([[maybe_unused]] const OmptTeam& team, const RangeMD<2>& range, F body, Sum<T> reducer) {
    T local = Sum<T>::identity();
#pragma omp parallel for collapse(2) reduction(+ : local)
    for (int x = 0; x < range.n[0]; ++x) {
      for (int y = 0; y < range.n[1]; ++y) {
        body(x, y, local);
      }
    }
    reducer.target = tarch::accelerator::combineOp(reducer, reducer.target, local);
  }

  template <typename T, typename F>
  inline void parallelReduce([[maybe_unused]] const OmptTeam& team, const RangeMD<3>& range, F body, Max<T> reducer) {
    T local = Max<T>::identity();
#pragma omp parallel for collapse(3) reduction(max : local)
    for (int x = 0; x < range.n[0]; ++x) {
      for (int y = 0; y < range.n[1]; ++y) {
        for (int z = 0; z < range.n[2]; ++z) {
          body(x, y, z, local);
        }
      }
    }
    reducer.target = tarch::accelerator::combineOp(reducer, reducer.target, local);
  }
  template <typename T, typename F>
  inline void parallelReduce([[maybe_unused]] const OmptTeam& team, const RangeMD<3>& range, F body, Min<T> reducer) {
    T local = Min<T>::identity();
#pragma omp parallel for collapse(3) reduction(min : local)
    for (int x = 0; x < range.n[0]; ++x) {
      for (int y = 0; y < range.n[1]; ++y) {
        for (int z = 0; z < range.n[2]; ++z) {
          body(x, y, z, local);
        }
      }
    }
    reducer.target = tarch::accelerator::combineOp(reducer, reducer.target, local);
  }
  template <typename T, typename F>
  inline void parallelReduce([[maybe_unused]] const OmptTeam& team, const RangeMD<3>& range, F body, Sum<T> reducer) {
    T local = Sum<T>::identity();
#pragma omp parallel for collapse(3) reduction(+ : local)
    for (int x = 0; x < range.n[0]; ++x) {
      for (int y = 0; y < range.n[1]; ++y) {
        for (int z = 0; z < range.n[2]; ++z) {
          body(x, y, z, local);
        }
      }
    }
    reducer.target = tarch::accelerator::combineOp(reducer, reducer.target, local);
  }
  TARGET_DECLARE_END

  template <typename T, typename F>
  inline void parallelReduce(const Range& range, F body, Max<T> reducer) {
    if (range.n <= 0) {
      return;
    }
    T         acc    = Max<T>::identity();
    const int device = tarch::accelerator::getCurrentDevice();
#pragma omp target teams distribute parallel for reduction(max : acc) device(device)
    for (int i = 0; i < range.n; ++i) {
      body(i, acc);
    }
    reducer.target = tarch::accelerator::combineOp(reducer, reducer.target, acc);
  }
  template <typename T, typename F>
  inline void parallelReduce(const Range& range, F body, Min<T> reducer) {
    if (range.n <= 0) {
      return;
    }
    T         acc    = Min<T>::identity();
    const int device = tarch::accelerator::getCurrentDevice();
#pragma omp target teams distribute parallel for reduction(min : acc) device(device)
    for (int i = 0; i < range.n; ++i) {
      body(i, acc);
    }
    reducer.target = tarch::accelerator::combineOp(reducer, reducer.target, acc);
  }
  template <typename T, typename F>
  inline void parallelReduce(const Range& range, F body, Sum<T> reducer) {
    if (range.n <= 0) {
      return;
    }
    T         acc    = Sum<T>::identity();
    const int device = tarch::accelerator::getCurrentDevice();
#pragma omp target teams distribute parallel for reduction(+ : acc) device(device)
    for (int i = 0; i < range.n; ++i) {
      body(i, acc);
    }
    reducer.target = tarch::accelerator::combineOp(reducer, reducer.target, acc);
  }

  template <typename T, typename F>
  inline void parallelReduce(const RangeMD<2>& range, F body, Max<T> reducer) {
    if (range.n[0] <= 0 or range.n[1] <= 0) {
      return;
    }
    T         acc    = Max<T>::identity();
    const int device = tarch::accelerator::getCurrentDevice();
#pragma omp target teams distribute parallel for collapse(2) reduction(max : acc) device(device)
    for (int x = 0; x < range.n[0]; ++x) {
      for (int y = 0; y < range.n[1]; ++y) {
        body(x, y, acc);
      }
    }
    reducer.target = tarch::accelerator::combineOp(reducer, reducer.target, acc);
  }
  template <typename T, typename F>
  inline void parallelReduce(const RangeMD<2>& range, F body, Min<T> reducer) {
    if (range.n[0] <= 0 or range.n[1] <= 0) {
      return;
    }
    T         acc    = Min<T>::identity();
    const int device = tarch::accelerator::getCurrentDevice();
#pragma omp target teams distribute parallel for collapse(2) reduction(min : acc) device(device)
    for (int x = 0; x < range.n[0]; ++x) {
      for (int y = 0; y < range.n[1]; ++y) {
        body(x, y, acc);
      }
    }
    reducer.target = tarch::accelerator::combineOp(reducer, reducer.target, acc);
  }
  template <typename T, typename F>
  inline void parallelReduce(const RangeMD<2>& range, F body, Sum<T> reducer) {
    if (range.n[0] <= 0 or range.n[1] <= 0) {
      return;
    }
    T         acc    = Sum<T>::identity();
    const int device = tarch::accelerator::getCurrentDevice();
#pragma omp target teams distribute parallel for collapse(2) reduction(+ : acc) device(device)
    for (int x = 0; x < range.n[0]; ++x) {
      for (int y = 0; y < range.n[1]; ++y) {
        body(x, y, acc);
      }
    }
    reducer.target = tarch::accelerator::combineOp(reducer, reducer.target, acc);
  }

  template <typename T, typename F>
  inline void parallelReduce(const RangeMD<3>& range, F body, Max<T> reducer) {
    if (range.n[0] <= 0 or range.n[1] <= 0 or range.n[2] <= 0) {
      return;
    }
    T         acc    = Max<T>::identity();
    const int device = tarch::accelerator::getCurrentDevice();
#pragma omp target teams distribute parallel for collapse(3) reduction(max : acc) device(device)
    for (int x = 0; x < range.n[0]; ++x) {
      for (int y = 0; y < range.n[1]; ++y) {
        for (int z = 0; z < range.n[2]; ++z) {
          body(x, y, z, acc);
        }
      }
    }
    reducer.target = tarch::accelerator::combineOp(reducer, reducer.target, acc);
  }
  template <typename T, typename F>
  inline void parallelReduce(const RangeMD<3>& range, F body, Min<T> reducer) {
    if (range.n[0] <= 0 or range.n[1] <= 0 or range.n[2] <= 0) {
      return;
    }
    T         acc    = Min<T>::identity();
    const int device = tarch::accelerator::getCurrentDevice();
#pragma omp target teams distribute parallel for collapse(3) reduction(min : acc) device(device)
    for (int x = 0; x < range.n[0]; ++x) {
      for (int y = 0; y < range.n[1]; ++y) {
        for (int z = 0; z < range.n[2]; ++z) {
          body(x, y, z, acc);
        }
      }
    }
    reducer.target = tarch::accelerator::combineOp(reducer, reducer.target, acc);
  }
  template <typename T, typename F>
  inline void parallelReduce(const RangeMD<3>& range, F body, Sum<T> reducer) {
    if (range.n[0] <= 0 or range.n[1] <= 0 or range.n[2] <= 0) {
      return;
    }
    T         acc    = Sum<T>::identity();
    const int device = tarch::accelerator::getCurrentDevice();
#pragma omp target teams distribute parallel for collapse(3) reduction(+ : acc) device(device)
    for (int x = 0; x < range.n[0]; ++x) {
      for (int y = 0; y < range.n[1]; ++y) {
        for (int z = 0; z < range.n[2]; ++z) {
          body(x, y, z, acc);
        }
      }
    }
    reducer.target = tarch::accelerator::combineOp(reducer, reducer.target, acc);
  }

  template <typename T, typename F>
  inline void parallelReduce(const TeamRange& range, F body, Max<T> reducer) {
    if (range.n <= 0) {
      return;
    }
    T         acc    = Max<T>::identity();
    const int device = tarch::accelerator::getCurrentDevice();
#pragma omp target teams distribute reduction(max : acc) device(device)
    for (int i = 0; i < range.n; ++i) {
      body(i, tarch::accelerator::OmptTeam{}, acc);
    }
    reducer.target = tarch::accelerator::combineOp(reducer, reducer.target, acc);
  }
  template <typename T, typename F>
  inline void parallelReduce(const TeamRange& range, F body, Min<T> reducer) {
    if (range.n <= 0) {
      return;
    }
    T         acc    = Min<T>::identity();
    const int device = tarch::accelerator::getCurrentDevice();
#pragma omp target teams distribute reduction(min : acc) device(device)
    for (int i = 0; i < range.n; ++i) {
      body(i, tarch::accelerator::OmptTeam{}, acc);
    }
    reducer.target = tarch::accelerator::combineOp(reducer, reducer.target, acc);
  }
  template <typename T, typename F>
  inline void parallelReduce(const TeamRange& range, F body, Sum<T> reducer) {
    if (range.n <= 0) {
      return;
    }
    T         acc    = Sum<T>::identity();
    const int device = tarch::accelerator::getCurrentDevice();
#pragma omp target teams distribute reduction(+ : acc) device(device)
    for (int i = 0; i < range.n; ++i) {
      body(i, tarch::accelerator::OmptTeam{}, acc);
    }
    reducer.target = tarch::accelerator::combineOp(reducer, reducer.target, acc);
  }
} // namespace tarch::accelerator

#endif // defined(PEANO_WITH_GPU_BACKEND_OMPT)
