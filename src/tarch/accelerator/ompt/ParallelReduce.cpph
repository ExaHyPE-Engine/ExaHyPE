#if defined(PEANO_WITH_GPU_BACKEND_OMPT)

namespace tarch::accelerator {
  TARGET_DECLARE
  constexpr int MaxThreadsPerTeam = 1024;
  // Iterations one team takes of a custom reduction over a flat range.
  constexpr int CustomTeamChunk = 256;

  template <typename T, typename Functor>
  inline void parallelReduce(
    [[maybe_unused]] const OmptTeam& team,
    const Range&                     range,
    const Functor                    functor,
    const Max<T>                     reducer
  ) {
    T partial = Max<T>::identity();
#pragma omp for nowait
    for (int i = 0; i < range.n; ++i) {
      functor(i, partial);
    }
    T& target = reducer.target;
#pragma omp atomic compare
    if (target < partial) {
      target = partial;
    }
#pragma omp barrier
  }
  template <typename T, typename Functor>
  inline void parallelReduce(
    [[maybe_unused]] const OmptTeam& team,
    const Range&                     range,
    const Functor                    functor,
    const Min<T>                     reducer
  ) {
    T partial = Min<T>::identity();
#pragma omp for nowait
    for (int i = 0; i < range.n; ++i) {
      functor(i, partial);
    }
    T& target = reducer.target;
#pragma omp atomic compare
    if (target > partial) {
      target = partial;
    }
#pragma omp barrier
  }
  template <typename T, typename Functor>
  inline void parallelReduce(
    [[maybe_unused]] const OmptTeam& team,
    const Range&                     range,
    const Functor                    functor,
    const Sum<T>                     reducer
  ) {
    T partial = Sum<T>::identity();
#pragma omp for nowait
    for (int i = 0; i < range.n; ++i) {
      functor(i, partial);
    }
    T& target = reducer.target;
#pragma omp atomic update
    target += partial;
#pragma omp barrier
  }
  template <typename Op, typename Functor>
  inline void parallelReduce(
    const OmptTeam&  team,
    const Range&     range,
    const Functor    functor,
    const Custom<Op> reducer
  ) {
    using ValueType = typename Op::ValueType;
    static_assert(
      sizeof(ValueType) * MaxThreadsPerTeam <= TeamScratchBytes,
      "The custom value exceeds the team scratch."
    );
    ValueType partial = Custom<Op>::identity();
#pragma omp for nowait
    for (int i = 0; i < range.n; ++i) {
      functor(i, partial);
    }
    ValueType* const partials      = reinterpret_cast<ValueType*>(team.scratch);
    partials[omp_get_thread_num()] = partial;
#pragma omp barrier
#pragma omp master
    {
      ValueType teamValue = Custom<Op>::identity();
      for (int thread = 0; thread < omp_get_num_threads(); thread++) {
        teamValue = Custom<Op>::combine(teamValue, partials[thread]);
      }
      reducer.target = Custom<Op>::combine(reducer.target, teamValue);
    }
#pragma omp barrier
  }

  template <typename T, typename Functor>
  inline void parallelReduce(
    [[maybe_unused]] const OmptTeam& team,
    const RangeMD<2>&                range,
    const Functor                    functor,
    const Max<T>                     reducer
  ) {
    T partial = Max<T>::identity();
#pragma omp for collapse(2) nowait
    for (int x = 0; x < range.n[0]; ++x) {
      for (int y = 0; y < range.n[1]; ++y) {
        functor(x, y, partial);
      }
    }
    T& target = reducer.target;
#pragma omp atomic compare
    if (target < partial) {
      target = partial;
    }
#pragma omp barrier
  }
