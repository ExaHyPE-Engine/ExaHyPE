namespace tarch::accelerator {
  TARGET_DECLARE
  /**
   * The value of a custom reduction padded to whole eight-byte words. A device reduction over a
   * value of another size reads it at misaligned addresses.
   */
  template <typename Op>
  struct alignas(8) PaddedReductionValue final {
    typename Op::ValueType value{};
  };

  /**
   * Combines the partial value of every thread of the team into the target of the reducer. The
   * partial values pass through the team scratch and merge in thread order.
   */
  template <typename Reducer>
  INLINE_METHOD void reduceOverTeam(
    const OmptTeam&                   team,
    const typename Reducer::ValueType threadValue,
    const Reducer                     reducer
  ) {
    using ValueType = typename Reducer::ValueType;
    static_assert(
      sizeof(ValueType) * OmptThreadsPerTeam <= TeamScratchBytes,
      "The scratch memory of a team needs room for one reduction value per thread."
    );
    ValueType* const partials      = reinterpret_cast<ValueType*>(team.scratch);
    partials[omp_get_thread_num()] = threadValue;
#pragma omp barrier
#pragma omp master
    {
      ValueType teamValue = Reducer::identity();
      for (int thread = 0; thread < omp_get_num_threads(); thread++) {
        teamValue = Reducer::combine(teamValue, partials[thread]);
      }
      reducer.target = Reducer::combine(reducer.target, teamValue);
    }
#pragma omp barrier
  }

  template <typename T, typename Functor>
  INLINE_METHOD void parallelReduce(
    [[maybe_unused]] const OmptTeam& team,
    const Range&                     range,
    const Functor                    functor,
    const Max<T>                     reducer
  ) {
    T partial = Max<T>::identity();
#pragma omp for nowait
    for (int i = 0; i < range.n; ++i) {
      functor(i, partial);
    }
    T& target = reducer.target;
#pragma omp atomic compare
    if (target < partial) {
      target = partial;
    }
#pragma omp barrier
  }
  template <typename T, typename Functor>
  INLINE_METHOD void parallelReduce(
    [[maybe_unused]] const OmptTeam& team,
    const Range&                     range,
    const Functor                    functor,
    const Min<T>                     reducer
  ) {
    T partial = Min<T>::identity();
#pragma omp for nowait
    for (int i = 0; i < range.n; ++i) {
      functor(i, partial);
    }
    T& target = reducer.target;
#pragma omp atomic compare
    if (target > partial) {
      target = partial;
    }
#pragma omp barrier
  }
  template <typename T, typename Functor>
  INLINE_METHOD void parallelReduce(
    [[maybe_unused]] const OmptTeam& team,
    const Range&                     range,
    const Functor                    functor,
    const Sum<T>                     reducer
  ) {
    T partial = Sum<T>::identity();
#pragma omp for nowait
    for (int i = 0; i < range.n; ++i) {
      functor(i, partial);
    }
    T& target = reducer.target;
#pragma omp atomic update
    target += partial;
#pragma omp barrier
  }
  template <typename Op, typename Functor>
  INLINE_METHOD void parallelReduce(
    const OmptTeam&  team,
    const Range&     range,
    const Functor    functor,
    const Custom<Op> reducer
  ) {
    using ValueType = typename Op::ValueType;
    static_assert(
      sizeof(ValueType) * OmptThreadsPerTeam <= TeamScratchBytes,
      "The scratch memory of a team needs room for one reduction value per thread."
    );
    ValueType partial = Custom<Op>::identity();
#pragma omp for nowait
    for (int i = 0; i < range.n; ++i) {
      functor(i, partial);
    }
    ValueType* const partials      = reinterpret_cast<ValueType*>(team.scratch);
    partials[omp_get_thread_num()] = partial;
#pragma omp barrier
#pragma omp master
    {
      ValueType teamValue = Custom<Op>::identity();
      for (int thread = 0; thread < omp_get_num_threads(); thread++) {
        teamValue = Custom<Op>::combine(teamValue, partials[thread]);
      }
      reducer.target = Custom<Op>::combine(reducer.target, teamValue);
    }
#pragma omp barrier
  }

  template <typename T, typename Functor>
  INLINE_METHOD void parallelReduce(
    [[maybe_unused]] const OmptTeam& team,
    const RangeMD<2>&                range,
    const Functor                    functor,
    const Max<T>                     reducer
  ) {
    T partial = Max<T>::identity();
#pragma omp for collapse(2) nowait
    for (int x = 0; x < range.n[0]; ++x) {
      for (int y = 0; y < range.n[1]; ++y) {
        functor(x, y, partial);
      }
    }
    T& target = reducer.target;
#pragma omp atomic compare
    if (target < partial) {
      target = partial;
    }
#pragma omp barrier
  }
