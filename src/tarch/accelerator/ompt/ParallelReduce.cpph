#pragma omp for collapse(2) nowait
    for (int x = 0; x < range.n[0]; ++x) {
      for (int y = 0; y < range.n[1]; ++y) {
        functor(x, y, partial);
      }
    }
    T& target = reducer.target;
#pragma omp atomic compare
    if (target > partial) {
      target = partial;
    }
#pragma omp barrier
  }
