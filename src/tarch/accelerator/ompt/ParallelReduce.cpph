  inline void parallelReduce(
    const OmptTeam&   team,
    const RangeMD<2>& range,
    const Functor     functor,
    const Custom<Op>  reducer
  ) {
    using ValueType = typename Op::ValueType;
    static_assert(
      sizeof(ValueType) * MaxThreadsPerTeam <= TeamScratchBytes,
      "The custom value exceeds the team scratch."
    );
