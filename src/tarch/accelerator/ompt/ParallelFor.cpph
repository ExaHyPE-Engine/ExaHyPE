#if defined(PEANO_WITH_GPU_BACKEND_OMPT)

namespace tarch::accelerator {
  TARGET_DECLARE
  // One partial value per thread of a custom team reduction.
  constexpr int TeamScratchBytes = 16384;

  struct OmptTeam final {
    unsigned char* scratch{nullptr};
  };
  using TeamHandle = OmptTeam;

  template <typename Functor>
  inline void parallelFor([[maybe_unused]] const OmptTeam& team, const Range& range, const Functor functor) {
#pragma omp for
    for (int i = 0; i < range.n; ++i) {
      functor(i);
    }
  }

  template <typename Functor>
  inline void parallelFor([[maybe_unused]] const OmptTeam& team, const RangeMD<2>& range, const Functor functor) {
#pragma omp for collapse(2)
    for (int x = 0; x < range.n[0]; ++x) {
      for (int y = 0; y < range.n[1]; ++y) {
        functor(x, y);
      }
    }
  }

  template <typename Functor>
  inline void parallelFor([[maybe_unused]] const OmptTeam& team, const RangeMD<3>& range, const Functor functor) {
#pragma omp for collapse(3)
    for (int x = 0; x < range.n[0]; ++x) {
      for (int y = 0; y < range.n[1]; ++y) {
        for (int z = 0; z < range.n[2]; ++z) {
          functor(x, y, z);
        }
      }
    }
  }

  inline void teamBarrier([[maybe_unused]] const OmptTeam& team) {
#pragma omp barrier
  }
  TARGET_DECLARE_END

  template <typename Functor>
  inline void parallelFor(const Range& range, const Functor functor) {
    assertion(range.n >= 0, range.n);
    if (range.n <= 0) {
      return;
    }
    const int device = tarch::accelerator::getCurrentDevice();
#pragma omp target teams distribute parallel for device(device)
    for (int i = 0; i < range.n; ++i) {
      functor(i);
    }
  }

  template <typename Functor>
  inline void parallelFor(const RangeMD<2>& range, const Functor functor) {
    assertion(range.n[0] >= 0, range.n[0]);
    assertion(range.n[1] >= 0, range.n[1]);
    if (range.n[0] <= 0 or range.n[1] <= 0) {
      return;
    }
    const int device = tarch::accelerator::getCurrentDevice();
#pragma omp target teams distribute parallel for collapse(2) device(device)
    for (int x = 0; x < range.n[0]; ++x) {
      for (int y = 0; y < range.n[1]; ++y) {
        functor(x, y);
      }
    }
  }

  template <typename Functor>
  inline void parallelFor(const RangeMD<3>& range, const Functor functor) {
    assertion(range.n[0] >= 0, range.n[0]);
    assertion(range.n[1] >= 0, range.n[1]);
    assertion(range.n[2] >= 0, range.n[2]);
    if (range.n[0] <= 0 or range.n[1] <= 0 or range.n[2] <= 0) {
      return;
    }
    const int device = tarch::accelerator::getCurrentDevice();
#pragma omp target teams distribute parallel for collapse(3) device(device)
    for (int x = 0; x < range.n[0]; ++x) {
      for (int y = 0; y < range.n[1]; ++y) {
        for (int z = 0; z < range.n[2]; ++z) {
          functor(x, y, z);
        }
      }
    }
  }

  template <typename Functor>
  inline void parallelFor(const TeamRange& range, const Functor functor) {
    assertion(range.n >= 0, range.n);
    if (range.n <= 0) {
      return;
    }
    const int device = tarch::accelerator::getCurrentDevice();
#pragma omp target teams distribute device(device)
    for (int i = 0; i < range.n; ++i) {
      alignas(PEANO_WITH_ALIGNMENT) unsigned char teamScratch[TeamScratchBytes];
#pragma omp parallel default(none) shared(functor, i, teamScratch)
      {
        functor(i, tarch::accelerator::OmptTeam{teamScratch});
      }
    }
  }
} // namespace tarch::accelerator

#endif // defined(PEANO_WITH_GPU_BACKEND_OMPT)
