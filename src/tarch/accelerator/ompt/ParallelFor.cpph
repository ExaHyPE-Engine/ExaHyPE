#if defined(PEANO_WITH_GPU_BACKEND_OMPT)

namespace tarch::accelerator {
  struct OmptTeam {};
  using TeamHandle = OmptTeam;

  // The inner team overloads run inside the outer `target teams distribute` region,
  // one team per outer index, so they carry the declare-target wrapping that makes
  // them device-compilable. They spread the inner iteration space over the team's
  // threads with `parallel for`.
  TARGET_DECLARE
  template <typename F>
  inline void parallelFor([[maybe_unused]] const OmptTeam& team, const Range& range, F body) {
#pragma omp parallel for
    for (int i = 0; i < range.n; ++i) {
      body(i);
    }
  }

  template <typename F>
  inline void parallelFor([[maybe_unused]] const OmptTeam& team, const RangeMD<2>& range, F body) {
#pragma omp                         parallel for collapse(2)
    for (int x = 0; x < range.n[0]; ++x) {
      for (int y = 0; y < range.n[1]; ++y) {
        body(x, y);
      }
    }
  }

  template <typename F>
  inline void parallelFor([[maybe_unused]] const OmptTeam& team, const RangeMD<3>& range, F body) {
#pragma omp                         parallel for collapse(3)
    for (int x = 0; x < range.n[0]; ++x) {
      for (int y = 0; y < range.n[1]; ++y) {
        for (int z = 0; z < range.n[2]; ++z) {
          body(x, y, z);
        }
      }
    }
  }
  TARGET_DECLARE_END

  template <typename F>
  inline void parallelFor(const Range& range, F body) {
    if (range.n <= 0) {
      return;
    }
    const int device = tarch::accelerator::getCurrentDevice();
#pragma omp target teams distribute parallel for device(device)
    for (int i = 0; i < range.n; ++i) {
      body(i);
    }
  }

  template <typename F>
  inline void parallelFor(const RangeMD<2>& range, F body) {
    if (range.n[0] <= 0 or range.n[1] <= 0) {
      return;
    }
    const int device = tarch::accelerator::getCurrentDevice();
#pragma omp target teams distribute parallel for collapse(2) device(device)
    for (int x = 0; x < range.n[0]; ++x) {
      for (int y = 0; y < range.n[1]; ++y) {
        body(x, y);
      }
    }
  }

  template <typename F>
  inline void parallelFor(const RangeMD<3>& range, F body) {
    if (range.n[0] <= 0 or range.n[1] <= 0 or range.n[2] <= 0) {
      return;
    }
    const int device = tarch::accelerator::getCurrentDevice();
#pragma omp target teams distribute parallel for collapse(3) device(device)
    for (int x = 0; x < range.n[0]; ++x) {
      for (int y = 0; y < range.n[1]; ++y) {
        for (int z = 0; z < range.n[2]; ++z) {
          body(x, y, z);
        }
      }
    }
  }

  template <typename F>
  inline void parallelFor(const TeamRange& range, F body) {
    if (range.n <= 0) {
      return;
    }
    const int device = tarch::accelerator::getCurrentDevice();
#pragma omp target teams distribute device(device)
    for (int i = 0; i < range.n; ++i) {
      body(i, tarch::accelerator::OmptTeam{});
    }
                          }
} // namespace tarch::accelerator

#endif // defined(PEANO_WITH_GPU_BACKEND_OMPT)
