#if defined(PEANO_WITH_GPU_BACKEND_OMPT)

namespace tarch::accelerator {
  struct OmptTeam {};
  using TeamHandle = OmptTeam;

  // The inner team overloads execute inside the outer `target teams distribute`
  // region (one team per outer index). They must be device-compilable, hence the
  // declare-target wrapping, and they spread the inner iteration space across the
  // team's threads with `parallel for`, restoring the intra-patch parallelism the
  // old per-backend `collapse(DIMENSIONS+1)` kernels had.
  // TODO: this nested `teams distribute` + `parallel for` offload should be
  // compile/perf-validated on the target OMPT toolchain.
  TARGET_DECLARE
  template <typename F>
  inline void parallelFor(const OmptTeam&, const Range& r, F f) {
#pragma omp parallel for
    for (int i = 0; i < r.n; ++i) {
      f(i);
    }
  }

  template <typename F>
  inline void parallelFor(const OmptTeam&, const RangeMD<2>& r, F f) {
#pragma omp parallel for collapse(2)
    for (int x = 0; x < r.n[0]; ++x) {
      for (int y = 0; y < r.n[1]; ++y) {
        f(x, y);
      }
    }
  }

  template <typename F>
  inline void parallelFor(const OmptTeam&, const RangeMD<3>& r, F f) {
#pragma omp parallel for collapse(3)
    for (int x = 0; x < r.n[0]; ++x) {
      for (int y = 0; y < r.n[1]; ++y) {
        for (int z = 0; z < r.n[2]; ++z) {
          f(x, y, z);
        }
      }
    }
  }
  TARGET_DECLARE_END
} // namespace tarch::accelerator

namespace tarch {
  template <typename F>
  inline void parallelFor(const Range& r, F f) {
    if (r.n <= 0) {
      return;
    }
    const int device = accelerator::getCurrentDevice();
#pragma omp target teams distribute parallel for device(device)
    for (int i = 0; i < r.n; ++i) {
      f(i);
    }
  }

  template <typename F>
  inline void parallelFor(const RangeMD<2>& r, F f) {
    if (r.n[0] <= 0 || r.n[1] <= 0) {
      return;
    }
    const int device = accelerator::getCurrentDevice();
#pragma omp target teams distribute parallel for collapse(2) device(device)
    for (int x = 0; x < r.n[0]; ++x) {
      for (int y = 0; y < r.n[1]; ++y) {
        f(x, y);
      }
    }
  }

  template <typename F>
  inline void parallelFor(const RangeMD<3>& r, F f) {
    if (r.n[0] <= 0 || r.n[1] <= 0 || r.n[2] <= 0) {
      return;
    }
    const int device = accelerator::getCurrentDevice();
#pragma omp target teams distribute parallel for collapse(3) device(device)
    for (int x = 0; x < r.n[0]; ++x) {
      for (int y = 0; y < r.n[1]; ++y) {
        for (int z = 0; z < r.n[2]; ++z) {
          f(x, y, z);
        }
      }
    }
  }

  template <typename F>
  inline void parallelFor(const TeamRange& r, F f) {
    if (r.n <= 0) {
      return;
    }
    const int device = accelerator::getCurrentDevice();
#pragma omp target teams distribute device(device)
    for (int i = 0; i < r.n; ++i) {
      f(i, accelerator::OmptTeam{});
    }
  }
} // namespace tarch

#endif // defined(PEANO_WITH_GPU_BACKEND_OMPT)
