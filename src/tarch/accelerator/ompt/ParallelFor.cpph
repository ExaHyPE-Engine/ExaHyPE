#if defined(PEANO_WITH_GPU_BACKEND_OMPT)

namespace tarch::accelerator {
  TARGET_DECLARE
  INLINE_METHOD int getThreadOfTeam([[maybe_unused]] const OmptTeam& team) { return omp_get_thread_num(); }

  INLINE_METHOD unsigned char* getTeamScratch(const OmptTeam& team) { return team.scratch; }

  INLINE_METHOD int getNumberOfThreadsPerTeam([[maybe_unused]] const OmptTeam& team) { return omp_get_num_threads(); }

  template <typename Functor>
  INLINE_METHOD void parallelFor([[maybe_unused]] const OmptTeam& team, const Range& range, const Functor functor) {
#pragma omp for
    for (int i = 0; i < range.n; ++i) {
      functor(i);
    }
  }

  template <typename Functor>
  INLINE_METHOD void parallelFor(
    [[maybe_unused]] const OmptTeam& team,
    const RangeMD<2>&                range,
    const Functor                    functor
  ) {
#pragma omp for collapse(2)
    for (int x = 0; x < range.n[0]; ++x) {
      for (int y = 0; y < range.n[1]; ++y) {
        functor(x, y);
      }
    }
  }

  template <typename Functor>
  INLINE_METHOD void parallelFor(
    [[maybe_unused]] const OmptTeam& team,
    const RangeMD<3>&                range,
    const Functor                    functor
  ) {
#pragma omp for collapse(3)
    for (int x = 0; x < range.n[0]; ++x) {
      for (int y = 0; y < range.n[1]; ++y) {
        for (int z = 0; z < range.n[2]; ++z) {
          functor(x, y, z);
        }
      }
    }
  }

  INLINE_METHOD void teamBarrier([[maybe_unused]] const OmptTeam& team) {
#pragma omp barrier
  }

  /**
   * Returns whether condition is true in every thread of the team. Every thread receives the same
   * value.
   */
  INLINE_METHOD bool isTrueInEveryThreadOfTeam(const OmptTeam& team, const bool condition) {
    team.votes[omp_get_thread_num()] = condition ? 1 : 0;
#pragma omp barrier
    bool isTrueInEveryThread = true;
    for (int thread = 0; thread < omp_get_num_threads(); thread++) {
      isTrueInEveryThread = isTrueInEveryThread and team.votes[thread] != 0;
    }
#pragma omp barrier
    return isTrueInEveryThread;
  }

  /**
   * Returns whether condition is true in any thread of the team. Every thread receives the same
   * value.
   */
  INLINE_METHOD bool isTrueInAnyThreadOfTeam(const OmptTeam& team, const bool condition) {
    team.votes[omp_get_thread_num()] = condition ? 1 : 0;
#pragma omp barrier
    bool isTrueInAnyThread = false;
    for (int thread = 0; thread < omp_get_num_threads(); thread++) {
      isTrueInAnyThread = isTrueInAnyThread or team.votes[thread] != 0;
    }
#pragma omp barrier
    return isTrueInAnyThread;
  }
  TARGET_DECLARE_END

  /**
   * Returns the threads per team of a launch that asks for requested threads. The count rounds
   * requested up to whole warps and stops at OmptThreadsPerTeam. TeamRange::BackendDefault asks
   * for OmptThreadsPerTeam threads.
   */
  INLINE_METHOD int getTeamThreads(const int requested) {
    if (requested == tarch::accelerator::TeamRange::BackendDefault) {
      return tarch::accelerator::OmptThreadsPerTeam;
    }
    ASSERTION(requested > 0, requested);
    const int warps = (requested + tarch::accelerator::ThreadsPerWarp - 1) / tarch::accelerator::ThreadsPerWarp;
    return std::min(tarch::accelerator::OmptThreadsPerTeam, warps * tarch::accelerator::ThreadsPerWarp);
  }

  /**
   * Returns the team scratch bytes of a launch that asks for requested bytes. Every team provides
   * TeamScratchBytes.
   */
  INLINE_METHOD int getTeamScratchBytes(const int requested) {
    ASSERTION(
      requested == tarch::accelerator::TeamRange::BackendDefault
        or (requested >= 0 and requested <= tarch::accelerator::TeamScratchBytes),
      requested
    );
    return tarch::accelerator::TeamScratchBytes;
  }

  template <typename Functor>
  INLINE_METHOD void parallelFor(const Range& range, const Functor functor) {
    ASSERTION(range.n >= 0, range.n);
    if (range.n <= 0) {
      return;
    }
    const int device        = tarch::accelerator::getCurrentDevice();
    const int numberOfItems = range.n;
#pragma omp target teams distribute parallel for firstprivate(functor) device(device)
    for (int i = 0; i < numberOfItems; ++i) {
      functor(i);
    }
  }

  template <typename Functor>
  INLINE_METHOD void parallelFor(const RangeMD<2>& range, const Functor functor) {
    ASSERTION(range.n[0] >= 0, range.n[0]);
    ASSERTION(range.n[1] >= 0, range.n[1]);
    if (range.n[0] <= 0 or range.n[1] <= 0) {
      return;
    }
    const int device  = tarch::accelerator::getCurrentDevice();
    const int extentX = range.n[0];
    const int extentY = range.n[1];
#pragma omp target teams distribute parallel for collapse(2) firstprivate(functor) device(device)
    for (int x = 0; x < extentX; ++x) {
      for (int y = 0; y < extentY; ++y) {
        functor(x, y);
      }
    }
  }

  template <typename Functor>
  INLINE_METHOD void parallelFor(const RangeMD<3>& range, const Functor functor) {
    ASSERTION(range.n[0] >= 0, range.n[0]);
    ASSERTION(range.n[1] >= 0, range.n[1]);
    ASSERTION(range.n[2] >= 0, range.n[2]);
    if (range.n[0] <= 0 or range.n[1] <= 0 or range.n[2] <= 0) {
      return;
    }
    const int device  = tarch::accelerator::getCurrentDevice();
    const int extentX = range.n[0];
    const int extentY = range.n[1];
    const int extentZ = range.n[2];
#pragma omp target teams distribute parallel for collapse(3) firstprivate(functor) device(device)
    for (int x = 0; x < extentX; ++x) {
      for (int y = 0; y < extentY; ++y) {
        for (int z = 0; z < extentZ; ++z) {
          functor(x, y, z);
        }
      }
    }
  }

  template <typename Functor>
#if defined(__INTEL_LLVM_COMPILER)
  // The OpenMP outlining pass of the Intel compiler icpx crashes on a host function that contains a
  // forcibly inlined team launch and a host parallel region.
  inline
#else
  INLINE_METHOD
#endif
    void parallelFor(const TeamRange& range, const Functor functor) {
    ASSERTION(range.n >= 0, range.n);
    if (range.n <= 0) {
      return;
    }
    const int device        = tarch::accelerator::getCurrentDevice();
    const int numberOfTeams = range.n;
    const int threads       = tarch::accelerator::getTeamThreads(range.threads);
    // The Intel compiler icpx places a static with omp_pteam_mem_alloc in global memory for all
    // teams. Clang moves a local of the teams region onto the stack of every thread.
#pragma omp target teams num_teams(numberOfTeams) thread_limit(threads) firstprivate(functor) device(device)
    {
#if defined(__INTEL_LLVM_COMPILER)
      alignas(PEANO_WITH_ALIGNMENT) unsigned char teamScratch[TeamScratchBytes];
      int                                         teamVotes[OmptThreadsPerTeam];
#endif
#pragma omp parallel num_threads(threads)
      {
#if not defined(__INTEL_LLVM_COMPILER)
        alignas(PEANO_WITH_ALIGNMENT) static unsigned char teamScratch[TeamScratchBytes];
        static int                                         teamVotes[OmptThreadsPerTeam];
#pragma omp allocate(teamScratch, teamVotes) allocator(omp_pteam_mem_alloc)
#endif
        for (int team = omp_get_team_num(); team < numberOfTeams; team += omp_get_num_teams()) {
          functor(team, tarch::accelerator::OmptTeam{teamScratch, teamVotes});
#pragma omp barrier
        }
      }
    }
  }
} // namespace tarch::accelerator

#endif // defined(PEANO_WITH_GPU_BACKEND_OMPT)
