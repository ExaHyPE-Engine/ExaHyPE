#include "tarch/accelerator/ParallelFor.h"
#include "tarch/accelerator/Range.h"

/**
 * Adds an upload that reads hostValue at every call of uploadDeviceCopies(), so hostValue has to
 * outlive the last call. WriteDeviceCopy writes the value into the device copy of the calling
 * translation unit. A translation unit that a CUDA or HIP build compiles for the host alone adds no
 * upload and returns false.
 */
template <typename WriteDeviceCopy, typename Value>
INLINE_METHOD bool
tarch::accelerator::addDeviceCopy([[maybe_unused]] const Value& hostValue) {
  static_assert(std::is_trivially_copyable_v<Value>, "A kernel receives the host value as a byte copy");
#if (defined(PEANO_WITH_GPU_BACKEND_CUDA) and not defined(__CUDACC__)) \
  or (defined(PEANO_WITH_GPU_BACKEND_HIP) and not defined(__HIPCC__))
  return false;
#else
  return addDeviceCopyUpload([&hostValue]() {
    tarch::accelerator::parallelFor(tarch::accelerator::Range(1), WriteDeviceCopy{hostValue});
  });
#endif
}
