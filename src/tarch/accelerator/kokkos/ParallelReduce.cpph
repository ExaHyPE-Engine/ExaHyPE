namespace tarch::accelerator {
  template <typename T>
  KOKKOS_INLINE_FUNCTION auto getKokkosReducer(const Max<T> reducer) {
    return Kokkos::Max<T>(reducer.target);
  }
  template <typename T>
  KOKKOS_INLINE_FUNCTION auto getKokkosReducer(const Min<T> reducer) {
    return Kokkos::Min<T>(reducer.target);
  }
  template <typename T>
  KOKKOS_INLINE_FUNCTION auto getKokkosReducer(const Sum<T> reducer) {
    return Kokkos::Sum<T>(reducer.target);
  }

  // HostSpace lets Kokkos copy the device result into the caller's host scalar.
  template <typename Op>
  struct KokkosCustomReducer final {
    using reducer          = KokkosCustomReducer<Op>;
    using value_type       = typename Op::ValueType;
    using result_view_type = Kokkos::View<value_type, Kokkos::HostSpace, Kokkos::MemoryUnmanaged>;

    value_type& target;

    KOKKOS_INLINE_FUNCTION explicit KokkosCustomReducer(value_type& boundTarget) :
      target(boundTarget) {}

    KOKKOS_INLINE_FUNCTION void join(value_type& destination, const value_type& source) const {
      destination = Op::combine(destination, source);
    }
    KOKKOS_INLINE_FUNCTION void init(value_type& value) const { value = Op::identity(); }
    KOKKOS_INLINE_FUNCTION value_type& reference() const { return target; }
    KOKKOS_INLINE_FUNCTION result_view_type view() const { return result_view_type(&target); }
    KOKKOS_INLINE_FUNCTION bool references_scalar() const { return true; }
  };

  template <typename Op>
  KOKKOS_INLINE_FUNCTION auto getKokkosReducer(const Custom<Op> reducer) {
    return KokkosCustomReducer<Op>(reducer.target);
  }

  template <typename Functor, typename ValueType>
  struct LeagueReduce final {
    Functor functor;
    KOKKOS_INLINE_FUNCTION void operator()(
      const tarch::accelerator::KokkosTeam::MemberType& team,
      ValueType&                                        accumulator
    ) const {
      functor(team.league_rank(), tarch::accelerator::KokkosTeam{team}, accumulator);
    }
  };

  template <typename Functor, typename ValueType>
  struct TeamReduce1D final {
    Functor functor;
    KOKKOS_INLINE_FUNCTION void operator()(const int i, ValueType& accumulator) const { functor(i, accumulator); }
  };

  template <typename Functor, typename ValueType>
  struct TeamReduce2D final {
    Functor functor;
    int     extentY;
    KOKKOS_INLINE_FUNCTION void operator()(const int index, ValueType& accumulator) const {
      functor(index / extentY, index % extentY, accumulator);
    }
  };

  template <typename Functor, typename ValueType>
  struct TeamReduce3D final {
    Functor functor;
    int     extentY;
    int     extentZ;
    KOKKOS_INLINE_FUNCTION void operator()(const int index, ValueType& accumulator) const {
      functor(index / (extentY * extentZ), (index / extentZ) % extentY, index % extentZ, accumulator);
    }
  };

  template <typename Reducer, typename Functor>
  KOKKOS_INLINE_FUNCTION void parallelReduce(
    const KokkosTeam& team,
    const Range&      range,
    const Functor     functor,
    const Reducer     reducer
  ) {
    assertion(range.n >= 0, range.n);
    typename Reducer::ValueType partialResult = Reducer::identity();
    Kokkos::parallel_reduce(
      Kokkos::TeamVectorRange(team.member, range.n),
      TeamReduce1D<Functor, typename Reducer::ValueType>{functor},
      tarch::accelerator::getKokkosReducer(Reducer{partialResult})
    );
    Kokkos::single(Kokkos::PerTeam(team.member), [&]() {
      reducer.target = Reducer::combine(reducer.target, partialResult);
    });
  }

  template <typename Reducer, typename Functor>
  KOKKOS_INLINE_FUNCTION void parallelReduce(
    const KokkosTeam& team,
    const RangeMD<2>& range,
    const Functor     functor,
    const Reducer     reducer
  ) {
    assertion(range.n[0] >= 0, range.n[0]);
    assertion(range.n[1] >= 0, range.n[1]);
    typename Reducer::ValueType partialResult = Reducer::identity();
    Kokkos::parallel_reduce(
      Kokkos::TeamVectorRange(team.member, range.n[0] * range.n[1]),
      TeamReduce2D<Functor, typename Reducer::ValueType>{functor, range.n[1]},
      tarch::accelerator::getKokkosReducer(Reducer{partialResult})
    );
    Kokkos::single(Kokkos::PerTeam(team.member), [&]() {
      reducer.target = Reducer::combine(reducer.target, partialResult);
    });
  }

  template <typename Reducer, typename Functor>
  KOKKOS_INLINE_FUNCTION void parallelReduce(
    const KokkosTeam& team,
    const RangeMD<3>& range,
    const Functor     functor,
    const Reducer     reducer
  ) {
    assertion(range.n[0] >= 0, range.n[0]);
    assertion(range.n[1] >= 0, range.n[1]);
    assertion(range.n[2] >= 0, range.n[2]);
    typename Reducer::ValueType partialResult = Reducer::identity();
    Kokkos::parallel_reduce(
      Kokkos::TeamVectorRange(team.member, range.n[0] * range.n[1] * range.n[2]),
      TeamReduce3D<Functor, typename Reducer::ValueType>{functor, range.n[1], range.n[2]},
      tarch::accelerator::getKokkosReducer(Reducer{partialResult})
    );
    Kokkos::single(Kokkos::PerTeam(team.member), [&]() {
      reducer.target = Reducer::combine(reducer.target, partialResult);
    });
  }

  // Kokkos overwrites the reduction output.
  template <typename Reducer, typename Functor>
  inline void parallelReduce(const Range& range, const Functor functor, const Reducer reducer) {
    assertion(range.n >= 0, range.n);
    if (range.n <= 0) {
      return;
    }
    using ValueType             = typename Reducer::ValueType;
    ValueType     partialResult = Reducer::identity();
    const Reducer partialReducer{partialResult};
    Kokkos::parallel_reduce(
      Kokkos::RangePolicy<Kokkos::DefaultExecutionSpace>(0, range.n),
      functor,
      tarch::accelerator::getKokkosReducer(partialReducer)
    );
    reducer.target = Reducer::combine(reducer.target, partialResult);
  }

  template <typename Reducer, typename Functor>
  inline void parallelReduce(const RangeMD<2>& range, const Functor functor, const Reducer reducer) {
    assertion(range.n[0] >= 0, range.n[0]);
    assertion(range.n[1] >= 0, range.n[1]);
    if (range.n[0] <= 0 or range.n[1] <= 0) {
      return;
    }
    using ValueType             = typename Reducer::ValueType;
    ValueType     partialResult = Reducer::identity();
    const Reducer partialReducer{partialResult};
    Kokkos::parallel_reduce(
      Kokkos::MDRangePolicy<Kokkos::DefaultExecutionSpace, Kokkos::Rank<2>>({0, 0}, {range.n[0], range.n[1]}),
      functor,
      tarch::accelerator::getKokkosReducer(partialReducer)
    );
    reducer.target = Reducer::combine(reducer.target, partialResult);
  }

  template <typename Reducer, typename Functor>
  inline void parallelReduce(const RangeMD<3>& range, const Functor functor, const Reducer reducer) {
    assertion(range.n[0] >= 0, range.n[0]);
    assertion(range.n[1] >= 0, range.n[1]);
    assertion(range.n[2] >= 0, range.n[2]);
    if (range.n[0] <= 0 or range.n[1] <= 0 or range.n[2] <= 0) {
      return;
    }
    using ValueType             = typename Reducer::ValueType;
    ValueType     partialResult = Reducer::identity();
    const Reducer partialReducer{partialResult};
    Kokkos::parallel_reduce(
      Kokkos::MDRangePolicy<Kokkos::DefaultExecutionSpace, Kokkos::Rank<3>>(
        {0, 0, 0},
        {range.n[0], range.n[1], range.n[2]}
      ),
      functor,
      tarch::accelerator::getKokkosReducer(partialReducer)
    );
    reducer.target = Reducer::combine(reducer.target, partialResult);
  }

  template <typename Reducer, typename Functor>
  inline void parallelReduce(const TeamRange& range, const Functor functor, const Reducer reducer) {
    assertion(range.n >= 0, range.n);
    if (range.n <= 0) {
      return;
    }
    using ValueType                                                       = typename Reducer::ValueType;
    ValueType                                               partialResult = Reducer::identity();
    const Reducer                                           partialReducer{partialResult};
    const Kokkos::TeamPolicy<Kokkos::DefaultExecutionSpace> policy(range.n, Kokkos::AUTO);
    Kokkos::parallel_reduce(
      policy,
      LeagueReduce<Functor, ValueType>{functor},
      tarch::accelerator::getKokkosReducer(partialReducer)
    );
    reducer.target = Reducer::combine(reducer.target, partialResult);
  }
} // namespace tarch::accelerator
