namespace tarch::accelerator {
  template <typename T>
  KOKKOS_INLINE_FUNCTION auto kokkosReducer(Max<T> reducer) {
    return Kokkos::Max<T>(reducer.target);
  }
  template <typename T>
  KOKKOS_INLINE_FUNCTION auto kokkosReducer(Min<T> reducer) {
    return Kokkos::Min<T>(reducer.target);
  }
  template <typename T>
  KOKKOS_INLINE_FUNCTION auto kokkosReducer(Sum<T> reducer) {
    return Kokkos::Sum<T>(reducer.target);
  }

  // A Kokkos reducer starts from its identity and overwrites the scalar it binds, so every overload
  // below reduces into a local scratch value. combineOnHost() merges that scratch into the target
  // the caller passed in.
  template <typename T>
  inline T combineOnHost([[maybe_unused]] Max<T> reducer, T left, T right) {
    return left > right ? left : right;
  }
  template <typename T>
  inline T combineOnHost([[maybe_unused]] Min<T> reducer, T left, T right) {
    return left < right ? left : right;
  }
  template <typename T>
  inline T combineOnHost([[maybe_unused]] Sum<T> reducer, T left, T right) {
    return left + right;
  }

  template <typename F, typename T>
  struct TeamReduce1D {
    F                           body;
    KOKKOS_INLINE_FUNCTION void operator()(const int i, T& acc) const { body(i, acc); }
  };

  template <typename F, typename T>
  struct TeamReduce2D {
    F                           body;
    int                         n1;
    KOKKOS_INLINE_FUNCTION void operator()(const int idx, T& acc) const { body(idx / n1, idx % n1, acc); }
  };

  template <typename F, typename T>
  struct TeamReduce3D {
    F                           body;
    int                         n1;
    int                         n2;
    KOKKOS_INLINE_FUNCTION void operator()(const int idx, T& acc) const {
      body(idx / (n1 * n2), (idx / n2) % n1, idx % n2, acc);
    }
  };

  template <typename Reducer, typename F>
  KOKKOS_INLINE_FUNCTION void parallelReduce(const KokkosTeam& team, const Range& range, F body, Reducer reducer) {
    Kokkos::parallel_reduce(
      Kokkos::TeamVectorRange(team.m, range.n),
      tarch::accelerator::TeamReduce1D<F, typename Reducer::value_type>{body},
      kokkosReducer(reducer)
    );
  }

  template <typename Reducer, typename F>
  KOKKOS_INLINE_FUNCTION void parallelReduce(const KokkosTeam& team, const RangeMD<2>& range, F body, Reducer reducer) {
    const int total = range.n[0] * range.n[1];
    Kokkos::parallel_reduce(
      Kokkos::TeamVectorRange(team.m, total),
      tarch::accelerator::TeamReduce2D<F, typename Reducer::value_type>{body, range.n[1]},
      kokkosReducer(reducer)
    );
  }

  template <typename Reducer, typename F>
  KOKKOS_INLINE_FUNCTION void parallelReduce(const KokkosTeam& team, const RangeMD<3>& range, F body, Reducer reducer) {
    const int total = range.n[0] * range.n[1] * range.n[2];
    Kokkos::parallel_reduce(
      Kokkos::TeamVectorRange(team.m, total),
      tarch::accelerator::TeamReduce3D<F, typename Reducer::value_type>{body, range.n[1], range.n[2]},
      kokkosReducer(reducer)
    );
  }

  template <typename Reducer, typename F>
  inline void parallelReduce(const Range& range, F body, Reducer reducer) {
    using T         = typename Reducer::value_type;
    T       scratch = Reducer::identity();
    Reducer scratchRed{scratch};
    Kokkos::parallel_reduce(
      Kokkos::RangePolicy<Kokkos::DefaultExecutionSpace>(0, range.n),
      KOKKOS_LAMBDA(const int i, T& acc) { body(i, acc); },
      tarch::accelerator::kokkosReducer(scratchRed)
    );
    reducer.target = tarch::accelerator::combineOnHost(reducer, reducer.target, scratch);
  }

  template <typename Reducer, typename F>
  inline void parallelReduce(const RangeMD<2>& range, F body, Reducer reducer) {
    using T         = typename Reducer::value_type;
    T       scratch = Reducer::identity();
    Reducer scratchRed{scratch};
    Kokkos::parallel_reduce(
      Kokkos::MDRangePolicy<Kokkos::DefaultExecutionSpace, Kokkos::Rank<2>>({0, 0}, {range.n[0], range.n[1]}),
      KOKKOS_LAMBDA(const int x, const int y, T& acc) { body(x, y, acc); },
      tarch::accelerator::kokkosReducer(scratchRed)
    );
    reducer.target = tarch::accelerator::combineOnHost(reducer, reducer.target, scratch);
  }

  template <typename Reducer, typename F>
  inline void parallelReduce(const RangeMD<3>& range, F body, Reducer reducer) {
    using T         = typename Reducer::value_type;
    T       scratch = Reducer::identity();
    Reducer scratchRed{scratch};
    Kokkos::parallel_reduce(
      Kokkos::MDRangePolicy<Kokkos::DefaultExecutionSpace, Kokkos::Rank<3>>(
        {0, 0, 0},
        {range.n[0], range.n[1], range.n[2]}
      ),
      KOKKOS_LAMBDA(const int x, const int y, const int z, T& acc) { body(x, y, z, acc); },
      tarch::accelerator::kokkosReducer(scratchRed)
    );
    reducer.target = tarch::accelerator::combineOnHost(reducer, reducer.target, scratch);
  }

  template <typename Reducer, typename F>
  inline void parallelReduce(const TeamRange& range, F body, Reducer reducer) {
    using T                                                   = typename Reducer::value_type;
    T                                                 scratch = Reducer::identity();
    Reducer                                           scratchRed{scratch};
    Kokkos::TeamPolicy<Kokkos::DefaultExecutionSpace> policy(range.n, Kokkos::AUTO);
    Kokkos::parallel_reduce(
      policy,
      KOKKOS_LAMBDA(const tarch::accelerator::KokkosTeam::member_type& team, T& acc) {
        body(team.league_rank(), tarch::accelerator::KokkosTeam{team}, acc);
      },
      tarch::accelerator::kokkosReducer(scratchRed)
    );
    reducer.target = tarch::accelerator::combineOnHost(reducer, reducer.target, scratch);
  }
} // namespace tarch::accelerator
