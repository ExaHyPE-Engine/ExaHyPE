namespace tarch::accelerator {
  template <typename T>
  KOKKOS_INLINE_FUNCTION auto kokkosReducer(Max<T> reducer) {
    return Kokkos::Max<T>(reducer.target);
  }
  template <typename T>
  KOKKOS_INLINE_FUNCTION auto kokkosReducer(Min<T> reducer) {
    return Kokkos::Min<T>(reducer.target);
  }
  template <typename T>
  KOKKOS_INLINE_FUNCTION auto kokkosReducer(Sum<T> reducer) {
    return Kokkos::Sum<T>(reducer.target);
  }

  // A Kokkos reducer starts from its identity and overwrites the scalar it binds, so every overload
  // below reduces into a local scratch value. combineOnHost() merges that scratch into the target
  // the caller passed in.
  template <typename T>
  inline T combineOnHost([[maybe_unused]] Max<T> reducer, T left, T right) {
    return left > right ? left : right;
  }
  template <typename T>
  inline T combineOnHost([[maybe_unused]] Min<T> reducer, T left, T right) {
    return left < right ? left : right;
  }
  template <typename T>
  inline T combineOnHost([[maybe_unused]] Sum<T> reducer, T left, T right) {
    return left + right;
  }

  namespace internal {
    template <typename F, typename T>
    struct TeamReduce1D {
      F                           f;
      KOKKOS_INLINE_FUNCTION void operator()(const int i, T& acc) const { f(i, acc); }
    };

    template <typename F, typename T>
    struct TeamReduce2D {
      F                           f;
      int                         n1;
      KOKKOS_INLINE_FUNCTION void operator()(const int idx, T& acc) const { f(idx / n1, idx % n1, acc); }
    };

    template <typename F, typename T>
    struct TeamReduce3D {
      F                           f;
      int                         n1;
      int                         n2;
      KOKKOS_INLINE_FUNCTION void operator()(const int idx, T& acc) const {
        f(idx / (n1 * n2), (idx / n2) % n1, idx % n2, acc);
      }
    };
  } // namespace internal

  template <typename Reducer, typename F>
  KOKKOS_INLINE_FUNCTION void parallelReduce(const KokkosTeam& team, const Range& r, F f, Reducer red) {
    Kokkos::parallel_reduce(
      Kokkos::TeamVectorRange(team.m, r.n),
      internal::TeamReduce1D<F, typename Reducer::value_type>{f},
      kokkosReducer(red)
    );
  }

  template <typename Reducer, typename F>
  KOKKOS_INLINE_FUNCTION void parallelReduce(const KokkosTeam& team, const RangeMD<2>& r, F f, Reducer red) {
    const int total = r.n[0] * r.n[1];
    Kokkos::parallel_reduce(
      Kokkos::TeamVectorRange(team.m, total),
      internal::TeamReduce2D<F, typename Reducer::value_type>{f, r.n[1]},
      kokkosReducer(red)
    );
  }

  template <typename Reducer, typename F>
  KOKKOS_INLINE_FUNCTION void parallelReduce(const KokkosTeam& team, const RangeMD<3>& r, F f, Reducer red) {
    const int total = r.n[0] * r.n[1] * r.n[2];
    Kokkos::parallel_reduce(
      Kokkos::TeamVectorRange(team.m, total),
      internal::TeamReduce3D<F, typename Reducer::value_type>{f, r.n[1], r.n[2]},
      kokkosReducer(red)
    );
  }
} // namespace tarch::accelerator

namespace tarch {
  template <typename Reducer, typename F>
  inline void parallelReduce(const Range& r, F f, Reducer red) {
    using T         = typename Reducer::value_type;
    T       scratch = Reducer::identity();
    Reducer scratchRed{scratch};
    Kokkos::parallel_reduce(
      Kokkos::RangePolicy<Kokkos::DefaultExecutionSpace>(0, r.n),
      KOKKOS_LAMBDA(const int i, T& acc) { f(i, acc); },
      accelerator::kokkosReducer(scratchRed)
    );
    red.target = accelerator::combineOnHost(red, red.target, scratch);
  }

  template <typename Reducer, typename F>
  inline void parallelReduce(const RangeMD<2>& r, F f, Reducer red) {
    using T         = typename Reducer::value_type;
    T       scratch = Reducer::identity();
    Reducer scratchRed{scratch};
    Kokkos::parallel_reduce(
      Kokkos::MDRangePolicy<Kokkos::DefaultExecutionSpace, Kokkos::Rank<2>>({0, 0}, {r.n[0], r.n[1]}),
      KOKKOS_LAMBDA(const int x, const int y, T& acc) { f(x, y, acc); },
      accelerator::kokkosReducer(scratchRed)
    );
    red.target = accelerator::combineOnHost(red, red.target, scratch);
  }

  template <typename Reducer, typename F>
  inline void parallelReduce(const RangeMD<3>& r, F f, Reducer red) {
    using T         = typename Reducer::value_type;
    T       scratch = Reducer::identity();
    Reducer scratchRed{scratch};
    Kokkos::parallel_reduce(
      Kokkos::MDRangePolicy<Kokkos::DefaultExecutionSpace, Kokkos::Rank<3>>({0, 0, 0}, {r.n[0], r.n[1], r.n[2]}),
      KOKKOS_LAMBDA(const int x, const int y, const int z, T& acc) { f(x, y, z, acc); },
      accelerator::kokkosReducer(scratchRed)
    );
    red.target = accelerator::combineOnHost(red, red.target, scratch);
  }

  template <typename Reducer, typename F>
  inline void parallelReduce(const TeamRange& r, F f, Reducer red) {
    using T                                                   = typename Reducer::value_type;
    T                                                 scratch = Reducer::identity();
    Reducer                                           scratchRed{scratch};
    Kokkos::TeamPolicy<Kokkos::DefaultExecutionSpace> policy(r.n, Kokkos::AUTO);
    Kokkos::parallel_reduce(
      policy,
      KOKKOS_LAMBDA(const accelerator::KokkosTeam::member_type& team, T& acc) {
        f(team.league_rank(), accelerator::KokkosTeam{team}, acc);
      },
      accelerator::kokkosReducer(scratchRed)
    );
    red.target = accelerator::combineOnHost(red, red.target, scratch);
  }
} // namespace tarch
