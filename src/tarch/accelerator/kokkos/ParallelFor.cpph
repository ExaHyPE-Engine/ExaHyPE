namespace tarch::accelerator {
  // The nvcc and hipcc compilers reject an extended [=] __device__ lambda inside the
  // __host__ __device__ team overloads below when F is a type local to a function
  // (the caller's functor always is). A named functor with a KOKKOS_INLINE_FUNCTION
  // operator() carries no such restriction.
  template <typename F>
  struct TeamFor1D {
    F                           body;
    KOKKOS_INLINE_FUNCTION void operator()(const int i) const { body(i); }
  };

  template <typename F>
  struct TeamFor2D {
    F                           body;
    int                         n1;
    KOKKOS_INLINE_FUNCTION void operator()(const int idx) const { body(idx / n1, idx % n1); }
  };

  template <typename F>
  struct TeamFor3D {
    F                           body;
    int                         n1;
    int                         n2;
    KOKKOS_INLINE_FUNCTION void operator()(const int idx) const { body(idx / (n1 * n2), (idx / n2) % n1, idx % n2); }
  };

  template <typename F>
  KOKKOS_INLINE_FUNCTION void parallelFor(const KokkosTeam& team, const Range& range, F body) {
    Kokkos::parallel_for(Kokkos::TeamVectorRange(team.m, range.n), tarch::accelerator::TeamFor1D<F>{body});
  }

  template <typename F>
  KOKKOS_INLINE_FUNCTION void parallelFor(const KokkosTeam& team, const RangeMD<2>& range, F body) {
    const int total = range.n[0] * range.n[1];
    Kokkos::parallel_for(Kokkos::TeamVectorRange(team.m, total), tarch::accelerator::TeamFor2D<F>{body, range.n[1]});
  }

  template <typename F>
  KOKKOS_INLINE_FUNCTION void parallelFor(const KokkosTeam& team, const RangeMD<3>& range, F body) {
    const int total = range.n[0] * range.n[1] * range.n[2];
    Kokkos::parallel_for(
      Kokkos::TeamVectorRange(team.m, total),
      tarch::accelerator::TeamFor3D<F>{body, range.n[1], range.n[2]}
    );
  }

  // Kokkos::parallel_for is asynchronous for device execution spaces, so every host
  // overload fences before returning and a caller reads the output right after the
  // call. The parallelReduce overloads need no fence: Reducing into a host scalar blocks.
  template <typename F>
  inline void parallelFor(const Range& range, F body) {
    Kokkos::parallel_for(
      Kokkos::RangePolicy<Kokkos::DefaultExecutionSpace>(0, range.n),
      KOKKOS_LAMBDA(const int i) { body(i); }
    );
    Kokkos::fence();
  }

  template <typename F>
  inline void parallelFor(const RangeMD<2>& range, F body) {
    Kokkos::parallel_for(
      Kokkos::MDRangePolicy<Kokkos::DefaultExecutionSpace, Kokkos::Rank<2>>({0, 0}, {range.n[0], range.n[1]}),
      KOKKOS_LAMBDA(const int x, const int y) { body(x, y); }
    );
    Kokkos::fence();
  }

  template <typename F>
  inline void parallelFor(const RangeMD<3>& range, F body) {
    Kokkos::parallel_for(
      Kokkos::MDRangePolicy<Kokkos::DefaultExecutionSpace, Kokkos::Rank<3>>(
        {0, 0, 0},
        {range.n[0], range.n[1], range.n[2]}
      ),
      KOKKOS_LAMBDA(const int x, const int y, const int z) { body(x, y, z); }
    );
    Kokkos::fence();
  }

  template <typename F>
  inline void parallelFor(const TeamRange& range, F body) {
    Kokkos::TeamPolicy<Kokkos::DefaultExecutionSpace> policy(range.n, Kokkos::AUTO);
    Kokkos::parallel_for(
      policy,
      KOKKOS_LAMBDA(const tarch::accelerator::KokkosTeam::member_type& team) {
        body(team.league_rank(), tarch::accelerator::KokkosTeam{team});
      }
    );
    Kokkos::fence();
  }
} // namespace tarch::accelerator
