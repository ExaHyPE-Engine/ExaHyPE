namespace tarch::accelerator {
  // The nvcc and hipcc compilers reject an extended lambda inside a __host__ __device__
  // function when the lambda's type is local to a function, so the team overloads wrap
  // the caller's functor in a named functor.
  template <typename Functor>
  struct TeamFor1D final {
    Functor                     functor;
    KOKKOS_INLINE_FUNCTION void operator()(const int i) const { functor(i); }
  };

  template <typename Functor>
  struct TeamFor2D final {
    Functor                     functor;
    int                         extentY;
    KOKKOS_INLINE_FUNCTION void operator()(const int index) const { functor(index / extentY, index % extentY); }
  };

  template <typename Functor>
  struct TeamFor3D final {
    Functor                     functor;
    int                         extentY;
    int                         extentZ;
    KOKKOS_INLINE_FUNCTION void operator()(const int index) const {
      functor(index / (extentY * extentZ), (index / extentZ) % extentY, index % extentZ);
    }
  };

  template <typename Functor>
  KOKKOS_INLINE_FUNCTION void parallelFor(const KokkosTeam& team, const Range& range, const Functor functor) {
    Kokkos::parallel_for(Kokkos::TeamVectorRange(team.member, range.n), TeamFor1D<Functor>{functor});
  }

  template <typename Functor>
  KOKKOS_INLINE_FUNCTION void parallelFor(const KokkosTeam& team, const RangeMD<2>& range, const Functor functor) {
    Kokkos::parallel_for(
      Kokkos::TeamVectorRange(team.member, range.n[0] * range.n[1]),
      TeamFor2D<Functor>{functor, range.n[1]}
    );
  }

  template <typename Functor>
  KOKKOS_INLINE_FUNCTION void parallelFor(const KokkosTeam& team, const RangeMD<3>& range, const Functor functor) {
    Kokkos::parallel_for(
      Kokkos::TeamVectorRange(team.member, range.n[0] * range.n[1] * range.n[2]),
      TeamFor3D<Functor>{functor, range.n[1], range.n[2]}
    );
  }

  KOKKOS_INLINE_FUNCTION void teamBarrier(const KokkosTeam& team) { team.member.team_barrier(); }

  // Kokkos::parallel_for returns before a device execution space completes, so every host
  // overload fences before it returns.
  template <typename Functor>
  inline void parallelFor(const Range& range, const Functor functor) {
    assertion(range.n >= 0, range.n);
    if (range.n <= 0) {
      return;
    }
    Kokkos::parallel_for(
      Kokkos::RangePolicy<Kokkos::DefaultExecutionSpace>(0, range.n),
      KOKKOS_LAMBDA(const int i) { functor(i); }
    );
    Kokkos::fence();
  }

  template <typename Functor>
  inline void parallelFor(const RangeMD<2>& range, const Functor functor) {
    assertion(range.n[0] >= 0, range.n[0]);
    assertion(range.n[1] >= 0, range.n[1]);
    if (range.n[0] <= 0 or range.n[1] <= 0) {
      return;
    }
    Kokkos::parallel_for(
      Kokkos::MDRangePolicy<Kokkos::DefaultExecutionSpace, Kokkos::Rank<2>>({0, 0}, {range.n[0], range.n[1]}),
      KOKKOS_LAMBDA(const int x, const int y) { functor(x, y); }
    );
    Kokkos::fence();
  }

  template <typename Functor>
  inline void parallelFor(const RangeMD<3>& range, const Functor functor) {
    assertion(range.n[0] >= 0, range.n[0]);
    assertion(range.n[1] >= 0, range.n[1]);
    assertion(range.n[2] >= 0, range.n[2]);
    if (range.n[0] <= 0 or range.n[1] <= 0 or range.n[2] <= 0) {
      return;
    }
    Kokkos::parallel_for(
      Kokkos::MDRangePolicy<Kokkos::DefaultExecutionSpace, Kokkos::Rank<3>>(
        {0, 0, 0},
        {range.n[0], range.n[1], range.n[2]}
      ),
      KOKKOS_LAMBDA(const int x, const int y, const int z) { functor(x, y, z); }
    );
    Kokkos::fence();
  }

  template <typename Functor>
  inline void parallelFor(const TeamRange& range, const Functor functor) {
    assertion(range.n >= 0, range.n);
    if (range.n <= 0) {
      return;
    }
    const Kokkos::TeamPolicy<Kokkos::DefaultExecutionSpace> policy(range.n, Kokkos::AUTO);
    Kokkos::parallel_for(
      policy,
      KOKKOS_LAMBDA(const tarch::accelerator::KokkosTeam::MemberType& team) {
        functor(team.league_rank(), tarch::accelerator::KokkosTeam{team});
      }
    );
    Kokkos::fence();
  }
} // namespace tarch::accelerator
