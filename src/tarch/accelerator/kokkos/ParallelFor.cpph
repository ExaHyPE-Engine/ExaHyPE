namespace tarch::accelerator {
  template <typename Functor>
  struct LeagueFor final {
    Functor functor;
    INLINE_METHOD GPU_CALLABLE_METHOD void operator()(const tarch::accelerator::KokkosTeam::MemberType& team) const {
      functor(team.league_rank(), tarch::accelerator::KokkosTeam{team});
    }
  };

  template <typename Functor>
  struct TeamFor1D final {
    Functor functor;
    INLINE_METHOD GPU_CALLABLE_METHOD void operator()(const int i) const { functor(i); }
  };

  template <typename Functor>
  struct TeamFor2D final {
    Functor functor;
    int     extentY;
    INLINE_METHOD GPU_CALLABLE_METHOD void operator()(const int index) const {
      functor(index / extentY, index % extentY);
    }
  };

  template <typename Functor>
  struct TeamFor3D final {
    Functor functor;
    int     extentY;
    int     extentZ;
    INLINE_METHOD GPU_CALLABLE_METHOD void operator()(const int index) const {
      functor(index / (extentY * extentZ), (index / extentZ) % extentY, index % extentZ);
    }
  };

  template <typename Functor>
  INLINE_METHOD GPU_CALLABLE_METHOD void parallelFor(
    const KokkosTeam& team,
    const Range&      range,
    const Functor     functor
  ) {
    Kokkos::parallel_for(Kokkos::TeamVectorRange(team.member, range.n), TeamFor1D<Functor>{functor});
  }

  template <typename Functor>
  INLINE_METHOD GPU_CALLABLE_METHOD void parallelFor(
    const KokkosTeam& team,
    const RangeMD<2>& range,
    const Functor     functor
  ) {
    Kokkos::parallel_for(
      Kokkos::TeamVectorRange(team.member, range.n[0] * range.n[1]),
      TeamFor2D<Functor>{functor, range.n[1]}
    );
  }

  template <typename Functor>
  INLINE_METHOD GPU_CALLABLE_METHOD void parallelFor(
    const KokkosTeam& team,
    const RangeMD<3>& range,
    const Functor     functor
  ) {
    Kokkos::parallel_for(
      Kokkos::TeamVectorRange(team.member, range.n[0] * range.n[1] * range.n[2]),
      TeamFor3D<Functor>{functor, range.n[1], range.n[2]}
    );
  }

  INLINE_METHOD GPU_CALLABLE_METHOD void teamBarrier(const KokkosTeam& team) { team.member.team_barrier(); }

  // Kokkos::parallel_for returns before a device execution space completes, so every host
  // overload fences before it returns.
  template <typename Functor>
  INLINE_METHOD void parallelFor(const Range& range, const Functor functor) {
    assertion(range.n >= 0, range.n);
    if (range.n <= 0) {
      return;
    }
    Kokkos::parallel_for(Kokkos::RangePolicy<Kokkos::DefaultExecutionSpace>(0, range.n), functor);
    Kokkos::fence();
  }

  template <typename Functor>
  INLINE_METHOD void parallelFor(const RangeMD<2>& range, const Functor functor) {
    assertion(range.n[0] >= 0, range.n[0]);
    assertion(range.n[1] >= 0, range.n[1]);
    if (range.n[0] <= 0 or range.n[1] <= 0) {
      return;
    }
    Kokkos::parallel_for(
      Kokkos::MDRangePolicy<Kokkos::DefaultExecutionSpace, Kokkos::Rank<2>>({0, 0}, {range.n[0], range.n[1]}),
      functor
    );
    Kokkos::fence();
  }

  template <typename Functor>
  INLINE_METHOD void parallelFor(const RangeMD<3>& range, const Functor functor) {
    assertion(range.n[0] >= 0, range.n[0]);
    assertion(range.n[1] >= 0, range.n[1]);
    assertion(range.n[2] >= 0, range.n[2]);
    if (range.n[0] <= 0 or range.n[1] <= 0 or range.n[2] <= 0) {
      return;
    }
    Kokkos::parallel_for(
      Kokkos::MDRangePolicy<Kokkos::DefaultExecutionSpace, Kokkos::Rank<3>>(
        {0, 0, 0},
        {range.n[0], range.n[1], range.n[2]}
      ),
      functor
    );
    Kokkos::fence();
  }

  template <typename Functor>
  INLINE_METHOD void parallelFor(const TeamRange& range, const Functor functor) {
    assertion(range.n >= 0, range.n);
    if (range.n <= 0) {
      return;
    }
    const Kokkos::TeamPolicy<Kokkos::DefaultExecutionSpace> policy(range.n, Kokkos::AUTO);
    Kokkos::parallel_for(policy, LeagueFor<Functor>{functor});
    Kokkos::fence();
  }
} // namespace tarch::accelerator
