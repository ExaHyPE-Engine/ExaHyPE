namespace tarch::accelerator {
  template <typename F>
  __global__ void flatKernel1D(F body, int n) {
    const int idx    = blockIdx.x * blockDim.x + threadIdx.x;
    const int stride = gridDim.x * blockDim.x;
    for (int i = idx; i < n; i += stride) {
      body(i);
    }
  }

  template <typename F>
  __global__ void teamKernel(F body) {
    body(static_cast<int>(blockIdx.x), HipTeam{});
  }

  template <typename F>
  __device__ inline void parallelFor([[maybe_unused]] const HipTeam& team, const Range& range, F body) {
    for (int i = threadIdx.x; i < range.n; i += blockDim.x) {
      body(i);
    }
  }
  template <typename F>
  __device__ inline void parallelFor([[maybe_unused]] const HipTeam& team, const RangeMD<2>& range, F body) {
    const int total = range.n[0] * range.n[1];
    const int n1    = range.n[1];
    for (int idx = threadIdx.x; idx < total; idx += blockDim.x) {
      const int x = idx / n1;
      const int y = idx % n1;
      body(x, y);
    }
  }
  template <typename F>
  __device__ inline void parallelFor([[maybe_unused]] const HipTeam& team, const RangeMD<3>& range, F body) {
    const int total = range.n[0] * range.n[1] * range.n[2];
    const int n1    = range.n[1];
    const int n2    = range.n[2];
    for (int idx = threadIdx.x; idx < total; idx += blockDim.x) {
      const int x = idx / (n1 * n2);
      const int y = (idx / n2) % n1;
      const int z = idx % n2;
      body(x, y, z);
    }
  }

  template <typename F>
  inline void parallelFor(const Range& range, F body) {
    if (range.n <= 0) {
      return;
    }
    CHECK_HIP_ERROR(hipSetDevice(tarch::accelerator::getCurrentDevice()));
    int blocks = (range.n + tarch::accelerator::HipBlockSize - 1) / tarch::accelerator::HipBlockSize;
    blocks     = std::min(blocks, 65535);
    tarch::accelerator::
      flatKernel1D<<<blocks, tarch::accelerator::HipBlockSize, 0, tarch::accelerator::deviceStreamGet()>>>(
        body,
        range.n
      );
    CHECK_HIP_ERROR(hipStreamSynchronize(tarch::accelerator::deviceStreamGet()));
  }

  template <typename F>
  inline void parallelFor(const RangeMD<2>& range, F body) {
    const int total = range.n[0] * range.n[1];
    const int n1    = range.n[1];
    parallelFor(Range(total), [=] __device__(int idx) {
      const int x = idx / n1;
      const int y = idx % n1;
      body(x, y);
    });
  }

  template <typename F>
  inline void parallelFor(const RangeMD<3>& range, F body) {
    const int total = range.n[0] * range.n[1] * range.n[2];
    const int n1    = range.n[1];
    const int n2    = range.n[2];
    parallelFor(Range(total), [=] __device__(int idx) {
      const int x = idx / (n1 * n2);
      const int y = (idx / n2) % n1;
      const int z = idx % n2;
      body(x, y, z);
    });
  }

  template <typename F>
  inline void parallelFor(const TeamRange& range, F body) {
    if (range.n <= 0) {
      return;
    }
    CHECK_HIP_ERROR(hipSetDevice(tarch::accelerator::getCurrentDevice()));
    tarch::accelerator::
      teamKernel<<<range.n, tarch::accelerator::HipBlockSize, 0, tarch::accelerator::deviceStreamGet()>>>(body);
    CHECK_HIP_ERROR(hipStreamSynchronize(tarch::accelerator::deviceStreamGet()));
  }
} // namespace tarch::accelerator
