namespace tarch::accelerator {
  template <typename Functor>
  __global__ void flatKernel1D(const Functor functor, const int numberOfItems) {
    const int firstIndex = blockIdx.x * blockDim.x + threadIdx.x;
    const int stride     = gridDim.x * blockDim.x;
    for (int i = firstIndex; i < numberOfItems; i += stride) {
      functor(i);
    }
  }

  template <typename Functor>
  __global__ void teamKernel(const Functor functor) {
    functor(static_cast<int>(blockIdx.x), HipTeam{});
  }

  template <typename Functor>
  __device__ inline void parallelFor([[maybe_unused]] const HipTeam& team, const Range& range, const Functor functor) {
    for (int i = threadIdx.x; i < range.n; i += blockDim.x) {
      functor(i);
    }
  }
  template <typename Functor>
  __device__ inline void parallelFor(
    [[maybe_unused]] const HipTeam& team,
    const RangeMD<2>&               range,
    const Functor                   functor
  ) {
    const int numberOfItems = range.n[0] * range.n[1];
    const int extentY       = range.n[1];
    for (int index = threadIdx.x; index < numberOfItems; index += blockDim.x) {
      functor(index / extentY, index % extentY);
    }
  }
  template <typename Functor>
  __device__ inline void parallelFor(
    [[maybe_unused]] const HipTeam& team,
    const RangeMD<3>&               range,
    const Functor                   functor
  ) {
    const int numberOfItems = range.n[0] * range.n[1] * range.n[2];
    const int extentY       = range.n[1];
    const int extentZ       = range.n[2];
    for (int index = threadIdx.x; index < numberOfItems; index += blockDim.x) {
      functor(index / (extentY * extentZ), (index / extentZ) % extentY, index % extentZ);
    }
  }

  __device__ inline void teamBarrier([[maybe_unused]] const HipTeam& team) { __syncthreads(); }

  template <typename Functor>
  inline void parallelFor(const Range& range, const Functor functor) {
    assertion(range.n >= 0, range.n);
    if (range.n <= 0) {
      return;
    }
    CHECK_HIP_ERROR(hipSetDevice(tarch::accelerator::getCurrentDevice()));
    const int numberOfBlocks = std::min(
      (range.n + tarch::accelerator::HipBlockSize - 1) / tarch::accelerator::HipBlockSize,
      tarch::accelerator::HipMaxNumberOfBlocks
    );
    tarch::accelerator::
      flatKernel1D<<<numberOfBlocks, tarch::accelerator::HipBlockSize, 0, tarch::accelerator::deviceStreamGet()>>>(
        functor,
        range.n
      );
    CHECK_HIP_ERROR(hipStreamSynchronize(tarch::accelerator::deviceStreamGet()));
  }

  template <typename Functor>
  inline void parallelFor(const RangeMD<2>& range, const Functor functor) {
    assertion(range.n[0] >= 0, range.n[0]);
    assertion(range.n[1] >= 0, range.n[1]);
    const int extentY = range.n[1];
    tarch::accelerator::parallelFor(Range(range.n[0] * range.n[1]), [=] __device__(const int index) {
      functor(index / extentY, index % extentY);
    });
  }

  template <typename Functor>
  inline void parallelFor(const RangeMD<3>& range, const Functor functor) {
    assertion(range.n[0] >= 0, range.n[0]);
    assertion(range.n[1] >= 0, range.n[1]);
    assertion(range.n[2] >= 0, range.n[2]);
    const int extentY = range.n[1];
    const int extentZ = range.n[2];
    tarch::accelerator::parallelFor(Range(range.n[0] * range.n[1] * range.n[2]), [=] __device__(const int index) {
      functor(index / (extentY * extentZ), (index / extentZ) % extentY, index % extentZ);
    });
  }

  template <typename Functor>
  inline void parallelFor(const TeamRange& range, const Functor functor) {
    assertion(range.n >= 0, range.n);
    if (range.n <= 0) {
      return;
    }
    CHECK_HIP_ERROR(hipSetDevice(tarch::accelerator::getCurrentDevice()));
    tarch::accelerator::
      teamKernel<<<range.n, tarch::accelerator::HipBlockSize, 0, tarch::accelerator::deviceStreamGet()>>>(functor);
    CHECK_HIP_ERROR(hipStreamSynchronize(tarch::accelerator::deviceStreamGet()));
  }
} // namespace tarch::accelerator
