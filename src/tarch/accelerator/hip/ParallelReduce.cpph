namespace tarch::accelerator {
  // The hipcub library takes the reduction as a binary functor, so HipcubCombine wraps Op::combine.
  template <typename Op>
  struct HipcubCombine final {
    __device__ __host__ typename Op::ValueType operator()(
      const typename Op::ValueType& left,
      const typename Op::ValueType& right
    ) const {
      return Op::combine(left, right);
    }
  };

  // Every kernel that calls this routine runs HipBlockSize threads per block. The barrier after
  // the read of entry zero lets a thread call the routine again while another thread still reads.
  template <typename Reducer, typename T>
  __device__ inline T blockReduce(const T threadValue) {
    __shared__ T blockValues[HipBlockSize];
    const int    threadIndex = threadIdx.x;
    blockValues[threadIndex] = threadValue;
    __syncthreads();
    for (int half = HipBlockSize / 2; half > 0; half >>= 1) {
      if (threadIndex < half) {
        blockValues[threadIndex] = Reducer::combine(blockValues[threadIndex], blockValues[threadIndex + half]);
      }
      __syncthreads();
    }
    const T blockResult = blockValues[0];
    __syncthreads();
    return blockResult;
  }

  // The reducer parameter deduces Reducer, as the type of blockResults is a non-deduced context;
  // the reducer's target is a host reference that no device thread dereferences.
  template <typename Reducer, typename Functor>
  __global__ void teamReduceKernel(
    const Functor                      functor,
    [[maybe_unused]] const Reducer     reducer,
    typename Reducer::ValueType* const blockResults
  ) {
    __shared__ typename Reducer::ValueType teamAccumulator;
    if (threadIdx.x == 0) {
      teamAccumulator = Reducer::identity();
    }
    __syncthreads();

    functor(static_cast<int>(blockIdx.x), HipTeam{}, teamAccumulator);

    __syncthreads();
    if (threadIdx.x == 0) {
      blockResults[blockIdx.x] = teamAccumulator;
    }
  }

  template <typename Reducer, typename Functor>
  __global__ void flatReduceKernel1D(
    const Functor                      functor,
    [[maybe_unused]] const Reducer     reducer,
    const int                          numberOfItems,
    typename Reducer::ValueType* const blockResults
  ) {
    typename Reducer::ValueType threadAccumulator = Reducer::identity();
    const int                   firstIndex        = blockIdx.x * blockDim.x + threadIdx.x;
    const int                   stride            = gridDim.x * blockDim.x;
    for (int i = firstIndex; i < numberOfItems; i += stride) {
      functor(i, threadAccumulator);
    }
    const typename Reducer::ValueType blockResult = tarch::accelerator::blockReduce<Reducer>(threadAccumulator);
    if (threadIdx.x == 0) {
      blockResults[blockIdx.x] = blockResult;
    }
  }

  // The hipcub library reports the size of its temporary storage in a first call and
  // reduces in a second call with that storage allocated.
  template <typename HipcubCall>
  inline void runHipcubReduction(const HipcubCall hipcubCall, const hipStream_t stream) {
    void*       temporaryStorage      = nullptr;
    std::size_t temporaryStorageBytes = 0;
    CHECK_HIP_ERROR(hipcubCall(temporaryStorage, temporaryStorageBytes));
    CHECK_HIP_ERROR(hipMallocAsync(&temporaryStorage, temporaryStorageBytes, stream));
    CHECK_HIP_ERROR(hipcubCall(temporaryStorage, temporaryStorageBytes));
    CHECK_HIP_ERROR(hipFreeAsync(temporaryStorage, stream));
  }

  template <typename T>
  inline void hipcubReduce(
    [[maybe_unused]] const Max<T> reducer,
    const T* const                input,
    T* const                      output,
    const int                     numberOfItems,
    const hipStream_t             stream
  ) {
    tarch::accelerator::runHipcubReduction(
      [&](void* const temporaryStorage, std::size_t& temporaryStorageBytes) {
        return hipcub::DeviceReduce::Max(temporaryStorage, temporaryStorageBytes, input, output, numberOfItems, stream);
      },
      stream
    );
  }
  template <typename T>
  inline void hipcubReduce(
    [[maybe_unused]] const Min<T> reducer,
    const T* const                input,
    T* const                      output,
    const int                     numberOfItems,
    const hipStream_t             stream
  ) {
    tarch::accelerator::runHipcubReduction(
      [&](void* const temporaryStorage, std::size_t& temporaryStorageBytes) {
        return hipcub::DeviceReduce::Min(temporaryStorage, temporaryStorageBytes, input, output, numberOfItems, stream);
      },
      stream
    );
  }
  template <typename T>
  inline void hipcubReduce(
    [[maybe_unused]] const Sum<T> reducer,
    const T* const                input,
    T* const                      output,
    const int                     numberOfItems,
    const hipStream_t             stream
  ) {
    tarch::accelerator::runHipcubReduction(
      [&](void* const temporaryStorage, std::size_t& temporaryStorageBytes) {
        return hipcub::DeviceReduce::Sum(temporaryStorage, temporaryStorageBytes, input, output, numberOfItems, stream);
      },
      stream
    );
  }
  template <typename Op, typename T>
  inline void hipcubReduce(
    [[maybe_unused]] const Custom<Op> reducer,
    const T* const                    input,
    T* const                          output,
    const int                         numberOfItems,
    const hipStream_t                 stream
  ) {
    tarch::accelerator::runHipcubReduction(
      [&](void* const temporaryStorage, std::size_t& temporaryStorageBytes) {
        return hipcub::DeviceReduce::Reduce(
          temporaryStorage,
          temporaryStorageBytes,
          input,
          output,
          numberOfItems,
          HipcubCombine<Op>{},
          Op::identity(),
          stream
        );
      },
      stream
    );
  }

  template <typename Reducer>
  inline void finaliseReduction(
    const Reducer                            reducer,
    const typename Reducer::ValueType* const deviceResult,
    const hipStream_t                        stream
  ) {
    typename Reducer::ValueType hostResult = Reducer::identity();
    CHECK_HIP_ERROR(
      hipMemcpyAsync(&hostResult, deviceResult, sizeof(typename Reducer::ValueType), hipMemcpyDeviceToHost, stream)
    );
    CHECK_HIP_ERROR(hipStreamSynchronize(stream));
    reducer.target = Reducer::combine(reducer.target, hostResult);
  }

  template <typename Reducer, typename Functor>
  __device__ inline void parallelReduce(
    [[maybe_unused]] const HipTeam& team,
    const Range&                    range,
    const Functor                   functor,
    const Reducer                   reducer
  ) {
    typename Reducer::ValueType threadAccumulator = Reducer::identity();
    for (int i = threadIdx.x; i < range.n; i += blockDim.x) {
      functor(i, threadAccumulator);
    }
    const typename Reducer::ValueType blockResult = tarch::accelerator::blockReduce<Reducer>(threadAccumulator);
    if (threadIdx.x == 0) {
      reducer.target = Reducer::combine(reducer.target, blockResult);
    }
  }
  template <typename Reducer, typename Functor>
  __device__ inline void parallelReduce(
    [[maybe_unused]] const HipTeam& team,
    const RangeMD<2>&               range,
    const Functor                   functor,
    const Reducer                   reducer
  ) {
    typename Reducer::ValueType threadAccumulator = Reducer::identity();
    const int                   numberOfItems     = range.n[0] * range.n[1];
    const int                   extentY           = range.n[1];
    for (int index = threadIdx.x; index < numberOfItems; index += blockDim.x) {
      functor(index / extentY, index % extentY, threadAccumulator);
    }
    const typename Reducer::ValueType blockResult = tarch::accelerator::blockReduce<Reducer>(threadAccumulator);
    if (threadIdx.x == 0) {
      reducer.target = Reducer::combine(reducer.target, blockResult);
    }
  }
  template <typename Reducer, typename Functor>
  __device__ inline void parallelReduce(
    [[maybe_unused]] const HipTeam& team,
    const RangeMD<3>&               range,
    const Functor                   functor,
    const Reducer                   reducer
  ) {
    typename Reducer::ValueType threadAccumulator = Reducer::identity();
    const int                   numberOfItems     = range.n[0] * range.n[1] * range.n[2];
    const int                   extentY           = range.n[1];
    const int                   extentZ           = range.n[2];
    for (int index = threadIdx.x; index < numberOfItems; index += blockDim.x) {
      functor(index / (extentY * extentZ), (index / extentZ) % extentY, index % extentZ, threadAccumulator);
    }
    const typename Reducer::ValueType blockResult = tarch::accelerator::blockReduce<Reducer>(threadAccumulator);
    if (threadIdx.x == 0) {
      reducer.target = Reducer::combine(reducer.target, blockResult);
    }
  }

  template <typename Reducer, typename Functor>
  inline void parallelReduce(const Range& range, const Functor functor, const Reducer reducer) {
    assertion(range.n >= 0, range.n);
    if (range.n <= 0) {
      return;
    }
    using ValueType  = typename Reducer::ValueType;
    const int device = tarch::accelerator::getCurrentDevice();
    CHECK_HIP_ERROR(hipSetDevice(device));
    const int numberOfBlocks = std::min(
      (range.n + tarch::accelerator::HipBlockSize - 1) / tarch::accelerator::HipBlockSize,
      tarch::accelerator::HipMaxNumberOfBlocks
    );

    ValueType* const blockResults =
      tarch::allocateMemory<ValueType>(numberOfBlocks, tarch::MemoryLocation::Device, device);
    ValueType* const deviceResult = tarch::allocateMemory<ValueType>(1, tarch::MemoryLocation::Device, device);

    tarch::accelerator::
      flatReduceKernel1D<<<numberOfBlocks, tarch::accelerator::HipBlockSize, 0, tarch::accelerator::deviceStreamGet()>>>(
        functor,
        reducer,
        range.n,
        blockResults
      );
    tarch::accelerator::hipcubReduce(
      reducer,
      blockResults,
      deviceResult,
      numberOfBlocks,
      tarch::accelerator::deviceStreamGet()
    );
    tarch::accelerator::finaliseReduction(reducer, deviceResult, tarch::accelerator::deviceStreamGet());

    // finaliseReduction synchronises the stream before the scratch buffers are freed.
    tarch::freeMemory(blockResults, tarch::MemoryLocation::Device, device);
    tarch::freeMemory(deviceResult, tarch::MemoryLocation::Device, device);
  }

  template <typename Reducer, typename Functor>
  inline void parallelReduce(const TeamRange& range, const Functor functor, const Reducer reducer) {
    assertion(range.n >= 0, range.n);
    if (range.n <= 0) {
      return;
    }
    using ValueType  = typename Reducer::ValueType;
    const int device = tarch::accelerator::getCurrentDevice();
    CHECK_HIP_ERROR(hipSetDevice(device));

    ValueType* const blockResults = tarch::allocateMemory<ValueType>(range.n, tarch::MemoryLocation::Device, device);
    ValueType* const deviceResult = tarch::allocateMemory<ValueType>(1, tarch::MemoryLocation::Device, device);

    tarch::accelerator::
      teamReduceKernel<<<range.n, tarch::accelerator::HipBlockSize, 0, tarch::accelerator::deviceStreamGet()>>>(
        functor,
        reducer,
        blockResults
      );
    tarch::accelerator::hipcubReduce(
      reducer,
      blockResults,
      deviceResult,
      range.n,
      tarch::accelerator::deviceStreamGet()
    );
    tarch::accelerator::finaliseReduction(reducer, deviceResult, tarch::accelerator::deviceStreamGet());

    tarch::freeMemory(blockResults, tarch::MemoryLocation::Device, device);
    tarch::freeMemory(deviceResult, tarch::MemoryLocation::Device, device);
  }

  template <typename Reducer, typename Functor>
  inline void parallelReduce(const RangeMD<2>& range, const Functor functor, const Reducer reducer) {
    assertion(range.n[0] >= 0, range.n[0]);
    assertion(range.n[1] >= 0, range.n[1]);
    const int extentY = range.n[1];
    tarch::accelerator::parallelReduce(
      Range(range.n[0] * range.n[1]),
      [=] __device__(const int index, typename Reducer::ValueType& accumulator) {
        functor(index / extentY, index % extentY, accumulator);
      },
      reducer
    );
  }
  template <typename Reducer, typename Functor>
  inline void parallelReduce(const RangeMD<3>& range, const Functor functor, const Reducer reducer) {
    assertion(range.n[0] >= 0, range.n[0]);
    assertion(range.n[1] >= 0, range.n[1]);
    assertion(range.n[2] >= 0, range.n[2]);
    const int extentY = range.n[1];
    const int extentZ = range.n[2];
    tarch::accelerator::parallelReduce(
      Range(range.n[0] * range.n[1] * range.n[2]),
      [=] __device__(const int index, typename Reducer::ValueType& accumulator) {
        functor(index / (extentY * extentZ), (index / extentZ) % extentY, index % extentZ, accumulator);
      },
      reducer
    );
  }
} // namespace tarch::accelerator
