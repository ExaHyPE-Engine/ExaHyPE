namespace tarch::accelerator {
#if defined(__HIPCC__)
  // Every kernel that calls this routine runs at most HipBlockSize threads per block. The barrier
  // after the read of entry zero keeps a thread that calls the routine again from overwriting the
  // entry while another thread still reads it.
  template <typename Reducer, typename T>
  INLINE_METHOD __device__ T blockReduce(const T threadValue) {
    // The hipcc compiler rejects the initialiser of a __shared__ declaration. Raw bytes store a type with
    // default member initialisers.
    alignas(T) __shared__ unsigned char blockStorage[HipBlockSize * sizeof(T)];
    T* const                            blockValues = reinterpret_cast<T*>(blockStorage);
    const int                           threadIndex = threadIdx.x;
    const auto                          threads     = static_cast<int>(blockDim.x);
    blockValues[threadIndex]                        = threadValue;
    __syncthreads();
    int span = 1;
    while (span < threads) {
      span <<= 1;
    }
    for (int half = span / 2; half > 0; half >>= 1) {
      if (threadIndex < half and threadIndex + half < threads) {
        blockValues[threadIndex] = Reducer::combine(blockValues[threadIndex], blockValues[threadIndex + half]);
      }
      __syncthreads();
    }
    const T blockResult = blockValues[0];
    __syncthreads();
    return blockResult;
  }

  /**
   * Combines the partial value of every thread of the block into the target of the reducer.
   * Thread 0 writes the target.
   */
  template <typename Reducer>
  INLINE_METHOD __device__ void reduceOverBlock(const typename Reducer::ValueType threadValue, const Reducer reducer) {
    const typename Reducer::ValueType blockResult = tarch::accelerator::blockReduce<Reducer>(threadValue);
    if (threadIdx.x == 0) {
      reducer.target = Reducer::combine(reducer.target, blockResult);
    }
  }
#endif

  /**
   * Combines the partial value of every thread of the team into the target of the reducer. One
   * host thread runs a whole team. Its partial value is the result of the team.
   */
  template <typename Reducer>
  INLINE_METHOD GPU_CALLABLE_METHOD void reduceOverTeam(
    [[maybe_unused]] const HipTeam&   team,
    const typename Reducer::ValueType threadValue,
    const Reducer                     reducer
  ) {
    COMPILE_IF_ON_DEVICE(tarch::accelerator::reduceOverBlock<Reducer>(threadValue, reducer);)
    COMPILE_IF_ON_HOST(reducer.target = Reducer::combine(reducer.target, threadValue);)
  }

#if defined(__HIPCC__)
  // Every launch runs at most HipBlockSize threads per block. The AMD compiler limits the registers
  // of a kernel without launch bounds to those of a block of 1024 threads. The parameter reducer
  // deduces Reducer for the non-deduced type of blockResults. Its target is a host reference that
  // only host code dereferences.
  template <typename Reducer, typename Functor>
  __global__ void __launch_bounds__(tarch::accelerator::HipBlockSize) teamReduceKernel(
    const Functor                      functor,
    [[maybe_unused]] const Reducer     reducer,
    typename Reducer::ValueType* const blockResults
  ) {
    using ValueType = typename Reducer::ValueType;
    alignas(ValueType) __shared__ unsigned char teamAccumulatorStorage[sizeof(ValueType)];
    extern __shared__ unsigned char             teamScratch[];
    ValueType&                                  teamAccumulator = *reinterpret_cast<ValueType*>(teamAccumulatorStorage);
    if (threadIdx.x == 0) {
      teamAccumulator = Reducer::identity();
    }
    __syncthreads();

    functor(static_cast<int>(blockIdx.x), HipTeam{teamScratch}, teamAccumulator);

    __syncthreads();
    if (threadIdx.x == 0) {
      blockResults[blockIdx.x] = teamAccumulator;
    }
  }

  template <typename Reducer, typename Functor>
  __global__ void __launch_bounds__(tarch::accelerator::HipBlockSize) flatReduceKernel1D(
    const Functor                      functor,
    [[maybe_unused]] const Reducer     reducer,
    const int                          numberOfItems,
    typename Reducer::ValueType* const blockResults
  ) {
    typename Reducer::ValueType threadAccumulator = Reducer::identity();
    const int                   firstIndex        = blockIdx.x * blockDim.x + threadIdx.x;
    const int                   stride            = gridDim.x * blockDim.x;
    for (int i = firstIndex; i < numberOfItems; i += stride) {
      functor(i, threadAccumulator);
    }
    const typename Reducer::ValueType blockResult = tarch::accelerator::blockReduce<Reducer>(threadAccumulator);
    if (threadIdx.x == 0) {
      blockResults[blockIdx.x] = blockResult;
    }
  }

  // The host combines at most HostReductionEntries block results. More block results pass through
  // a second reduction on the device first.
  inline constexpr int HostReductionEntries = 16384;

  INLINE_METHOD int getNumberOfSecondStageBlocks(const int numberOfBlocks) {
    if (numberOfBlocks <= HostReductionEntries) {
      return 0;
    }
    return std::min(
      (numberOfBlocks + tarch::accelerator::HipBlockSize - 1) / tarch::accelerator::HipBlockSize,
      tarch::accelerator::HipMaxNumberOfBlocks
    );
  }

  template <typename Reducer>
  struct CombineBlockResults final {
    const typename Reducer::ValueType* blockResults{nullptr};

    INLINE_METHOD __device__ void operator()(const int block, typename Reducer::ValueType& accumulator) const {
      accumulator = Reducer::combine(accumulator, blockResults[block]);
    }
  };

  // The block results lie in the scratch before the room for the second-stage results. The host
  // waits once for the stream copy into pinned memory and combines the results in order.
  template <typename Reducer>
  INLINE_METHOD void finaliseReduction(
    const Reducer                      reducer,
    typename Reducer::ValueType* const blockResults,
    const int                          numberOfBlocks,
    const hipStream_t                  stream
  ) {
    using ValueType                    = typename Reducer::ValueType;
    const ValueType* results           = blockResults;
    int              numberOfResults   = numberOfBlocks;
    const int        secondStageBlocks = getNumberOfSecondStageBlocks(numberOfBlocks);
    if (secondStageBlocks > 0) {
      ValueType* const secondStage = blockResults + numberOfBlocks;
      tarch::accelerator::flatReduceKernel1D<<<secondStageBlocks, tarch::accelerator::HipBlockSize, 0, stream>>>(
        CombineBlockResults<Reducer>{blockResults},
        reducer,
        numberOfBlocks,
        secondStage
      );
      CHECK_HIP_ERROR(hipGetLastError());
      results         = secondStage;
      numberOfResults = secondStageBlocks;
    }
    const std::size_t bytes       = static_cast<std::size_t>(numberOfResults) * sizeof(ValueType);
    auto* const       hostResults = static_cast<ValueType*>(tarch::accelerator::getReductionStaging(bytes));
    CHECK_HIP_ERROR(hipMemcpyAsync(hostResults, results, bytes, hipMemcpyDeviceToHost, stream));
    CHECK_HIP_ERROR(hipStreamSynchronize(stream));
    ValueType result = Reducer::identity();
    for (int entry = 0; entry < numberOfResults; entry++) {
      result = Reducer::combine(result, hostResults[entry]);
    }
    reducer.target = Reducer::combine(reducer.target, result);
    tarch::accelerator::unlockReductionScratch();
  }
#endif

  template <typename Reducer, typename Functor>
  INLINE_METHOD GPU_CALLABLE_METHOD void parallelReduce(
    const HipTeam& team,
    const Range&   range,
    const Functor  functor,
    const Reducer  reducer
  ) {
    typename Reducer::ValueType threadAccumulator = Reducer::identity();
    for (int i = tarch::accelerator::getThreadOfTeam(team); i < range.n;
         i += tarch::accelerator::getNumberOfThreadsPerTeam(team)) {
      functor(i, threadAccumulator);
    }
    tarch::accelerator::reduceOverTeam<Reducer>(team, threadAccumulator, reducer);
  }
  template <typename Reducer, typename Functor>
  INLINE_METHOD GPU_CALLABLE_METHOD void parallelReduce(
    const HipTeam&    team,
    const RangeMD<2>& range,
    const Functor     functor,
    const Reducer     reducer
  ) {
    typename Reducer::ValueType threadAccumulator = Reducer::identity();
    const int                   numberOfItems     = range.n[0] * range.n[1];
    const int                   extentY           = range.n[1];
    for (int index = tarch::accelerator::getThreadOfTeam(team); index < numberOfItems;
         index += tarch::accelerator::getNumberOfThreadsPerTeam(team)) {
      functor(index / extentY, index % extentY, threadAccumulator);
    }
    tarch::accelerator::reduceOverTeam<Reducer>(team, threadAccumulator, reducer);
  }
  template <typename Reducer, typename Functor>
  INLINE_METHOD GPU_CALLABLE_METHOD void parallelReduce(
    const HipTeam&    team,
    const RangeMD<3>& range,
    const Functor     functor,
    const Reducer     reducer
  ) {
    typename Reducer::ValueType threadAccumulator = Reducer::identity();
    const int                   numberOfItems     = range.n[0] * range.n[1] * range.n[2];
    const int                   extentY           = range.n[1];
    const int                   extentZ           = range.n[2];
    for (int index = tarch::accelerator::getThreadOfTeam(team); index < numberOfItems;
         index += tarch::accelerator::getNumberOfThreadsPerTeam(team)) {
      functor(index / (extentY * extentZ), (index / extentZ) % extentY, index % extentZ, threadAccumulator);
    }
    tarch::accelerator::reduceOverTeam<Reducer>(team, threadAccumulator, reducer);
  }

#if defined(__HIPCC__)
  template <typename Reducer, typename Functor>
  INLINE_METHOD void parallelReduce(const Range& range, const Functor functor, const Reducer reducer) {
    ASSERTION(range.n >= 0, range.n);
    if (range.n <= 0) {
      return;
    }
    using ValueType  = typename Reducer::ValueType;
    const int device = tarch::accelerator::getCurrentDevice();
    CHECK_HIP_ERROR(hipSetDevice(device));
    const int numberOfBlocks = std::min(
      (range.n + tarch::accelerator::HipBlockSize - 1) / tarch::accelerator::HipBlockSize,
      tarch::accelerator::HipMaxNumberOfBlocks
    );

    ValueType* const blockResults = static_cast<ValueType*>(tarch::accelerator::lockReductionScratch(
      static_cast<std::size_t>(numberOfBlocks + getNumberOfSecondStageBlocks(numberOfBlocks)) * sizeof(ValueType)
    ));

    tarch::accelerator::flatReduceKernel1D<<<
      numberOfBlocks,
      tarch::accelerator::HipBlockSize,
      0,
      tarch::accelerator::getDeviceStream()
    >>>(functor, reducer, range.n, blockResults);
    CHECK_HIP_ERROR(hipGetLastError());
    tarch::accelerator::finaliseReduction(reducer, blockResults, numberOfBlocks, tarch::accelerator::getDeviceStream());
  }

  template <typename Reducer, typename Functor>
  INLINE_METHOD void parallelReduce(const TeamRange& range, const Functor functor, const Reducer reducer) {
    ASSERTION(range.n >= 0, range.n);
    if (range.n <= 0) {
      return;
    }
    using ValueType  = typename Reducer::ValueType;
    const int device = tarch::accelerator::getCurrentDevice();
    CHECK_HIP_ERROR(hipSetDevice(device));

    ValueType* const blockResults = static_cast<ValueType*>(tarch::accelerator::lockReductionScratch(
      static_cast<std::size_t>(range.n + getNumberOfSecondStageBlocks(range.n)) * sizeof(ValueType)
    ));

    tarch::accelerator::teamReduceKernel<<<
      range.n,
      tarch::accelerator::getTeamThreads(range.threads),
      tarch::accelerator::getTeamScratchBytes(range.scratchBytes),
      tarch::accelerator::getDeviceStream()
    >>>(functor, reducer, blockResults);
    CHECK_HIP_ERROR(hipGetLastError());
    tarch::accelerator::finaliseReduction(reducer, blockResults, range.n, tarch::accelerator::getDeviceStream());
  }

  template <typename Reducer, typename Functor>
  INLINE_METHOD void parallelReduce(const RangeMD<2>& range, const Functor functor, const Reducer reducer) {
    ASSERTION(range.n[0] >= 0, range.n[0]);
    ASSERTION(range.n[1] >= 0, range.n[1]);
    const int extentY = range.n[1];
    tarch::accelerator::parallelReduce(
      Range(range.n[0] * range.n[1]),
      [=] __device__(const int index, typename Reducer::ValueType& accumulator) {
        functor(index / extentY, index % extentY, accumulator);
      },
      reducer
    );
  }
  template <typename Reducer, typename Functor>
  INLINE_METHOD void parallelReduce(const RangeMD<3>& range, const Functor functor, const Reducer reducer) {
    ASSERTION(range.n[0] >= 0, range.n[0]);
    ASSERTION(range.n[1] >= 0, range.n[1]);
    ASSERTION(range.n[2] >= 0, range.n[2]);
    const int extentY = range.n[1];
    const int extentZ = range.n[2];
    tarch::accelerator::parallelReduce(
      Range(range.n[0] * range.n[1] * range.n[2]),
      [=] __device__(const int index, typename Reducer::ValueType& accumulator) {
        functor(index / (extentY * extentZ), (index / extentZ) % extentY, index % extentZ, accumulator);
      },
      reducer
    );
  }
#endif
} // namespace tarch::accelerator
