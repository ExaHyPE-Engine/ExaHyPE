#include "tarch/CompilerSpecificSettings.h"
#include "tarch/accelerator/CompileTarget.h"
#include "tarch/accelerator/DeviceCopies.h"

namespace {
  TARGET_DECLARE
  struct WriteDeviceValue final {
    double value{0.0};

    INLINE_METHOD GPU_CALLABLE_METHOD void operator()([[maybe_unused]] const int workItem) const {
      tarch::accelerator::getDeviceCopy<double>() = value;
    }
  };
  TARGET_DECLARE_END

  [[maybe_unused]] const bool deviceValueIsAdded =
    tarch::accelerator::addDeviceCopy<WriteDeviceValue>(tarch::accelerator::tests::hostValue);
} // namespace
