#include "tarch/Assertions.h"
#include "tarch/accelerator/accelerator.h"

template <typename T>
INLINE_METHOD tarch::accelerator::Buffer<T>::Buffer(const tarch::MemoryLocation location) noexcept :
  _location(location) {}

template <typename T>
INLINE_METHOD tarch::accelerator::Buffer<T>::Buffer(const std::size_t size, const tarch::MemoryLocation location) :
  _location(location) {
  allocate(size);
}

template <typename T>
INLINE_METHOD tarch::accelerator::Buffer<T>::Buffer(tarch::accelerator::Buffer<T>&& other) noexcept :
  _data(std::exchange(other._data, nullptr)),
  _size(std::exchange(other._size, 0)),
  _location(other._location),
  _device(other._device) {}

template <typename T>
INLINE_METHOD tarch::accelerator::Buffer<T>&
tarch::accelerator::Buffer<T>::operator=(tarch::accelerator::Buffer<T>&& other) noexcept {
  if (this != &other) {
    release();
    _data     = std::exchange(other._data, nullptr);
    _size     = std::exchange(other._size, 0);
    _location = other._location;
    _device   = other._device;
  }
  return *this;
}

template <typename T>
INLINE_METHOD tarch::accelerator::Buffer<T>::Buffer::~Buffer() noexcept {
  release();
}

/**
 * Replaces the array by an uninitialised one of the given size. A size of zero leaves the buffer
 * empty.
 */
template <typename T>
INLINE_METHOD void
tarch::accelerator::Buffer<T>::allocate(const std::size_t size) {
  release();
  if (size == 0) {
    return;
  }
  _device = tarch::accelerator::getCurrentDevice();
  _data   = tarch::allocateMemory<T>(size, _location, _device);
  _size   = size;
}

template <typename T>
INLINE_METHOD void
tarch::accelerator::Buffer<T>::release() noexcept {
  if (_data != nullptr) {
    tarch::freeMemory(static_cast<void*>(_data), _location, _device);
  }
  _data = nullptr;
  _size = 0;
}

template <typename T>
INLINE_METHOD void
tarch::accelerator::Buffer<T>::copyFromHost(const T* const source, const std::size_t count) {
  ASSERTION(count <= _size, count, _size);
  if (count == 0) {
    return;
  }
  tarch::copyTo(_data, source, count, _location, _device);
}

template <typename T>
INLINE_METHOD void
tarch::accelerator::Buffer<T>::copyToHost(T* const target, const std::size_t count) const {
  ASSERTION(count <= _size, count, _size);
  if (count == 0) {
    return;
  }
  tarch::copyFrom(_data, target, count, _location, _device);
}

template <typename T>
INLINE_METHOD void
tarch::accelerator::Buffer<T>::setValues(const std::vector<T>& values) {
  allocate(values.size());
  copyFromHost(values.data(), values.size());
}

template <typename T>
INLINE_METHOD std::vector<T>
tarch::accelerator::Buffer<T>::getValues() const {
  std::vector<T> result(_size);
  copyToHost(result.data(), _size);
  return result;
}

template <typename T>
INLINE_METHOD T*
tarch::accelerator::Buffer<T>::getData() noexcept {
  return _data;
}

template <typename T>
INLINE_METHOD const T*
tarch::accelerator::Buffer<T>::getData() const noexcept {
  return _data;
}

template <typename T>
INLINE_METHOD std::size_t
tarch::accelerator::Buffer<T>::getSize() const noexcept {
  return _size;
}

template <typename T>
INLINE_METHOD std::size_t
tarch::accelerator::Buffer<T>::getSizeInBytes() const noexcept {
  return _size * sizeof(T);
}

template <typename T>
INLINE_METHOD tarch::AllocatedBytes
tarch::accelerator::Buffer<T>::getAllocatedBytes() const noexcept {
  return tarch::AllocatedBytes::in(_location, getSizeInBytes());
}

template <typename T>
INLINE_METHOD bool
tarch::accelerator::Buffer<T>::isEmpty() const noexcept {
  return _size == 0;
}

template <typename T>
INLINE_METHOD tarch::MemoryLocation
tarch::accelerator::Buffer<T>::getLocation() const noexcept {
  return _location;
}
