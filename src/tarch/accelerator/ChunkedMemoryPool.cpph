/**
 * Creates a host-accessible pool and rejects device-only storage.
 */
template <typename T, int N>
tarch::accelerator::ChunkedMemoryPool<T, N>::ChunkedMemoryPool(MemoryLocation location, int device) noexcept :
  _location(location),
  _device(device) {
  if (_location == MemoryLocation::Device) {
    tarch::terminateWithError("The pool needs host-accessible storage because chunk resolution runs on the host.");
  }
}

template <typename T, int N>
tarch::accelerator::ChunkedMemoryPool<T, N>::ChunkedMemoryPool(ChunkedMemoryPool&& other) noexcept :
  _data(std::exchange(other._data, nullptr)),
  _capacity(std::exchange(other._capacity, 0)),
  _size(std::exchange(other._size, 0)),
  _touchedChunks(std::exchange(other._touchedChunks, 0)),
  _location(other._location),
  _device(other._device) {}

template <typename T, int N>
tarch::accelerator::ChunkedMemoryPool<T, N>& tarch::accelerator::ChunkedMemoryPool<T, N>::operator=(
  ChunkedMemoryPool&& other
) noexcept {
  if (this != &other) {
    clear();
    _data          = std::exchange(other._data, nullptr);
    _capacity      = std::exchange(other._capacity, 0);
    _size          = std::exchange(other._size, 0);
    _touchedChunks = std::exchange(other._touchedChunks, 0);
    _location      = other._location;
    _device        = other._device;
  }
  return *this;
}

template <typename T, int N>
tarch::accelerator::ChunkedMemoryPool<T, N>::ChunkedMemoryPool::~ChunkedMemoryPool() noexcept {
  clear();
}

/**
 * Releases the backing buffer and resets the pool.
 */
template <typename T, int N>
void tarch::accelerator::ChunkedMemoryPool<T, N>::clear() noexcept {
  rawFree(_data, _capacity);
  _data          = nullptr;
  _capacity      = 0;
  _size          = 0;
  _touchedChunks = 0;
}

/**
 * Allocates zero-filled aligned backing storage. A heap buffer is a mapping
 * whose pages turn resident on their first write. A pinned buffer comes from
 * the backend allocator and gets cleared after the allocation.
 */
template <typename T, int N>
T* tarch::accelerator::ChunkedMemoryPool<T, N>::rawAllocate(const std::size_t chunks) const {
  constexpr std::size_t BytesPerChunk = static_cast<std::size_t>(PaddedChunkSize) * sizeof(T);
  if (chunks > std::numeric_limits<std::size_t>::max() / BytesPerChunk) {
    tarch::terminateWithError(
      "A pool buffer of " + std::to_string(chunks) + " chunks of " + std::to_string(BytesPerChunk)
      + " bytes overflows std::size_t."
    );
  }
  const std::size_t bytes  = chunks * BytesPerChunk;
  T*                buffer = nullptr;
  switch (_location) {
  case MemoryLocation::Heap:
    buffer = static_cast<T*>(allocateZeroedHeapMemory(bytes));
    break;
  case MemoryLocation::Pinned:
    buffer = static_cast<T*>(allocatePinnedMemory(bytes, _device));
    std::memset(buffer, 0, bytes);
    break;
  case MemoryLocation::Device:
    assertion(false, "The constructor rejects device-resident pools.");
    break;
  }
  // The padded stride keeps chunks aligned only relative to the buffer base;
  // a backend whose pinned allocator returns a weaker-aligned base breaks the
  // alignment guarantee for every chunk.
  assertion(reinterpret_cast<std::uintptr_t>(buffer) % PEANO_WITH_ALIGNMENT == 0, bytes);
  return buffer;
}

template <typename T, int N>
void tarch::accelerator::ChunkedMemoryPool<T, N>::rawFree(T* const buffer, const std::size_t chunks) const noexcept {
  if (buffer == nullptr) {
    return;
  }
  switch (_location) {
  case MemoryLocation::Heap:
    freeZeroedHeapMemory(buffer, chunks * static_cast<std::size_t>(PaddedChunkSize) * sizeof(T));
    break;
  case MemoryLocation::Pinned:
    freePinnedMemory(buffer, _device);
    break;
  case MemoryLocation::Device:
    assertion(false, "The constructor rejects device-resident pools.");
    break;
  }
}

/**
 * Returns a writable pointer to the chunk selected by @p slot.
 *
 * The size conversion prevents 32-bit offset overflow in large pools.
 */
template <typename T, int N>
INLINE_METHOD GPU_CALLABLE_METHOD T* tarch::accelerator::ChunkedMemoryPool<T, N>::chunk(SlotIndex slot) noexcept {
  assertion(slot != InvalidSlot);
  assertion(static_cast<std::size_t>(slot) < _size, slot, _size);
  return _data + static_cast<std::size_t>(slot) * static_cast<std::size_t>(PaddedChunkSize);
}

/**
 * Returns a read-only pointer to the chunk selected by @p slot.
 */
template <typename T, int N>
INLINE_METHOD GPU_CALLABLE_METHOD const T* tarch::accelerator::ChunkedMemoryPool<T, N>::chunk(
  SlotIndex slot
) const noexcept {
  assertion(slot != InvalidSlot);
  assertion(static_cast<std::size_t>(slot) < _size, slot, _size);
  return _data + static_cast<std::size_t>(slot) * static_cast<std::size_t>(PaddedChunkSize);
}

/**
 * Returns the writable strided backing buffer.
 */
template <typename T, int N>
INLINE_METHOD T* tarch::accelerator::ChunkedMemoryPool<T, N>::rawData() noexcept {
  return _data;
}

/**
 * Returns the read-only strided backing buffer.
 */
template <typename T, int N>
INLINE_METHOD const T* tarch::accelerator::ChunkedMemoryPool<T, N>::rawData() const noexcept {
  return _data;
}

/**
 * Returns the number of live chunks.
 */
template <typename T, int N>
INLINE_METHOD std::size_t tarch::accelerator::ChunkedMemoryPool<T, N>::size() const noexcept {
  return _size;
}

/**
 * Returns the number of chunks the buffer can hold.
 */
template <typename T, int N>
INLINE_METHOD std::size_t tarch::accelerator::ChunkedMemoryPool<T, N>::capacity() const noexcept {
  return _capacity;
}

/**
 * Returns whether the pool has no live chunks.
 */
template <typename T, int N>
INLINE_METHOD bool tarch::accelerator::ChunkedMemoryPool<T, N>::empty() const noexcept {
  return _size == 0;
}

/**
 * Returns the live element count including padding.
 */
template <typename T, int N>
INLINE_METHOD std::size_t tarch::accelerator::ChunkedMemoryPool<T, N>::rawSize() const noexcept {
  return _size * static_cast<std::size_t>(PaddedChunkSize);
}

/**
 * Returns the live byte count including padding.
 */
template <typename T, int N>
INLINE_METHOD std::size_t tarch::accelerator::ChunkedMemoryPool<T, N>::rawSizeInBytes() const noexcept {
  return rawSize() * sizeof(T);
}

/**
 * Returns the backing-buffer size in bytes.
 */
template <typename T, int N>
INLINE_METHOD std::size_t tarch::accelerator::ChunkedMemoryPool<T, N>::allocatedBytes() const noexcept {
  return _capacity * static_cast<std::size_t>(PaddedChunkSize) * sizeof(T);
}

/**
 * Clears the chunks in [firstChunk, endChunk) through tarch::accelerator::parallelFor.
 */
template <typename T, int N>
void tarch::accelerator::ChunkedMemoryPool<T, N>::clearChunks(
  const std::size_t firstChunk,
  const std::size_t endChunk
) noexcept {
  assertion(firstChunk <= endChunk, firstChunk, endChunk);
  assertion(endChunk <= _capacity, endChunk, _capacity);
  constexpr auto        ElementsPerChunk = static_cast<std::size_t>(PaddedChunkSize);
  constexpr std::size_t BytesPerChunk    = ElementsPerChunk * sizeof(T);
  T* const              buffer           = _data;
  tarch::accelerator::parallelForOnHost(
    tarch::accelerator::Range(static_cast<int>(endChunk - firstChunk)),
    [buffer, firstChunk](const int chunk) {
      std::memset(buffer + (firstChunk + static_cast<std::size_t>(chunk)) * ElementsPerChunk, 0, BytesPerChunk);
    }
  );
}

/**
 * Resizes the live chunk range and preserves retained data.
 *
 * Resizing within capacity keeps chunk pointers valid and clears the chunks
 * that re-enter the live range. Reallocation invalidates the pointers and
 * grows the capacity geometrically. The retained chunks move through
 * tarch::accelerator::parallelFor.
 */
template <typename T, int N>
void tarch::accelerator::ChunkedMemoryPool<T, N>::resize(const std::size_t numberOfChunks) {
  constexpr auto MaximumNumberOfChunks = static_cast<std::size_t>(std::numeric_limits<int>::max());
  if (numberOfChunks > MaximumNumberOfChunks) {
    tarch::terminateWithError("A pool has more chunks than the 32-bit parallel range supports.");
  }
  if (numberOfChunks <= _capacity) {
    if (numberOfChunks > _size and _touchedChunks > _size) {
      clearChunks(_size, std::min(numberOfChunks, _touchedChunks));
    }
    _size          = numberOfChunks;
    _touchedChunks = std::max(_touchedChunks, _size);
    return;
  }

  const auto geometricCapacity = _capacity + std::min(_capacity / 2, MaximumNumberOfChunks - _capacity);
  const auto newCapacity       = std::max(numberOfChunks, geometricCapacity);
  T* const   newBuffer         = rawAllocate(newCapacity);
  if (_size > 0) {
    constexpr auto        ElementsPerChunk = static_cast<std::size_t>(PaddedChunkSize);
    constexpr std::size_t BytesPerChunk    = ElementsPerChunk * sizeof(T);
    T* const              oldBuffer        = _data;
    tarch::accelerator::parallelForOnHost(
      tarch::accelerator::Range(static_cast<int>(_size)),
      [newBuffer, oldBuffer](const int chunk) {
        const auto offset = static_cast<std::size_t>(chunk) * ElementsPerChunk;
        std::memcpy(newBuffer + offset, oldBuffer + offset, BytesPerChunk);
      }
    );
  }
  rawFree(_data, _capacity);
  _data          = newBuffer;
  _capacity      = newCapacity;
  _size          = numberOfChunks;
  _touchedChunks = numberOfChunks;
}
