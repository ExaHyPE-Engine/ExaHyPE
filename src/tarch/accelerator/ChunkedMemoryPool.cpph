#include "tarch/Assertions.h"
#include "tarch/Termination.h"

template <typename T>
INLINE_METHOD GPU_CALLABLE_METHOD T*
tarch::accelerator::ChunkedMemoryPool<T>::View::getChunk(const int slot) const noexcept {
  return segments[slot >> segmentSizeExponent]
    + static_cast<std::size_t>(slot & slotMask) * static_cast<std::size_t>(paddedChunkSize);
}

template <typename T>
INLINE_METHOD GPU_CALLABLE_METHOD const T*
tarch::accelerator::ChunkedMemoryPool<T>::ConstView::getChunk(const int slot) const noexcept {
  return segments[slot >> segmentSizeExponent]
    + static_cast<std::size_t>(slot & slotMask) * static_cast<std::size_t>(paddedChunkSize);
}

/** Returns the smallest chunk stride at or above chunkSize at which every chunk starts aligned. */
template <typename T>
INLINE_METHOD int
tarch::accelerator::ChunkedMemoryPool<T>::getPaddedChunkSizeOf(const int chunkSize) noexcept {
  const auto alignment            = static_cast<std::size_t>(PEANO_WITH_ALIGNMENT);
  const auto elementsPerAlignment = alignment / std::gcd(alignment, sizeof(T));
  return static_cast<int>(
    (static_cast<std::size_t>(chunkSize) + elementsPerAlignment - 1) / elementsPerAlignment * elementsPerAlignment
  );
}

template <typename T>
tarch::accelerator::ChunkedMemoryPool<T>::ChunkedMemoryPool(
  const int                   chunkSize,
  const tarch::MemoryLocation location
) noexcept :
  _chunkSize(chunkSize),
  _paddedChunkSize(getPaddedChunkSizeOf(chunkSize)),
  _segmentTable(location),
  _location(location) {
  assertion(chunkSize > 0, chunkSize);
}

template <typename T>
tarch::accelerator::ChunkedMemoryPool<T>::ChunkedMemoryPool(tarch::accelerator::ChunkedMemoryPool<T>&& other) noexcept :
  _chunkSize(other._chunkSize),
  _paddedChunkSize(other._paddedChunkSize),
  _segments(std::move(other._segments)),
  _segmentBasesOnHost(std::move(other._segmentBasesOnHost)),
  _segmentTable(std::move(other._segmentTable)),
  _segmentSizeExponent(std::exchange(other._segmentSizeExponent, 0)),
  _location(other._location) {
  other._segments.clear();
  other._segmentBasesOnHost.clear();
}

template <typename T>
tarch::accelerator::ChunkedMemoryPool<T>&
tarch::accelerator::ChunkedMemoryPool<T>::operator=(tarch::accelerator::ChunkedMemoryPool<T>&& other) noexcept {
  if (this != &other) {
    release();
    _chunkSize           = other._chunkSize;
    _paddedChunkSize     = other._paddedChunkSize;
    _segments            = std::move(other._segments);
    _segmentBasesOnHost  = std::move(other._segmentBasesOnHost);
    _segmentTable        = std::move(other._segmentTable);
    _segmentSizeExponent = std::exchange(other._segmentSizeExponent, 0);
    _location            = other._location;
    other._segments.clear();
    other._segmentBasesOnHost.clear();
  }
  return *this;
}

template <typename T>
tarch::accelerator::ChunkedMemoryPool<T>::ChunkedMemoryPool::~ChunkedMemoryPool() noexcept {
  release();
}

/**
 * Grows the capacity without moving existing chunks. The first reservation fixes the segment size.
 */
template <typename T>
void
tarch::accelerator::ChunkedMemoryPool<T>::reserve(const int numberOfSlots) {
  assertion(numberOfSlots >= 0, numberOfSlots);
  if (numberOfSlots <= getCapacity()) {
    return;
  }
  if (_segments.empty()) {
    const auto slotsPerSegment =
      std::bit_ceil(static_cast<unsigned int>(std::max(1, numberOfSlots / SegmentsPerFirstReservation)));
    _segmentSizeExponent = std::max(MinimumSegmentSizeExponent, std::countr_zero(slotsPerSegment));
  }
  while (numberOfSlots > getCapacity()) {
    appendSegment();
  }
  uploadSegmentTable();
}

template <typename T>
void
tarch::accelerator::ChunkedMemoryPool<T>::appendSegment() {
  constexpr auto MaximumNumberOfSlots = static_cast<std::size_t>(std::numeric_limits<int>::max());
  if (static_cast<std::size_t>(getCapacity()) + static_cast<std::size_t>(getSegmentSize()) > MaximumNumberOfSlots) {
    tarch::terminateWithError("A pool has more slots than the 32-bit parallel range supports.");
  }
  auto& segment = _segments.emplace_back(_location);
  segment.allocate(static_cast<std::size_t>(getSegmentSize()) * static_cast<std::size_t>(_paddedChunkSize));
  assertion(reinterpret_cast<std::uintptr_t>(segment.getData()) % PEANO_WITH_ALIGNMENT == 0, _segments.size());
  _segmentBasesOnHost.push_back(segment.getData());
}

/**
 * Copies the segment bases into the table that the views read. The table lies in the memory
 * location of the pool, so a device view reads device memory only.
 */
template <typename T>
void
tarch::accelerator::ChunkedMemoryPool<T>::uploadSegmentTable() {
  _segmentTable.allocate(_segmentBasesOnHost.size());
  _segmentTable.copyFromHost(_segmentBasesOnHost.data(), _segmentBasesOnHost.size());
}

template <typename T>
void
tarch::accelerator::ChunkedMemoryPool<T>::release() noexcept {
  _segments.clear();
  _segmentBasesOnHost.clear();
  _segmentTable.release();
  _segmentSizeExponent = 0;
}

/** Resizes target to the padded chunks of every slot of the pool and copies them into it. */
template <typename T>
void
tarch::accelerator::ChunkedMemoryPool<T>::copyToHost(std::vector<T>& target) const {
  const auto valuesPerSegment = static_cast<std::size_t>(getSegmentSize()) * static_cast<std::size_t>(_paddedChunkSize);
  target.resize(_segments.size() * valuesPerSegment);
  for (std::size_t segment = 0; segment < _segments.size(); segment++) {
    _segments[segment].copyToHost(target.data() + segment * valuesPerSegment, valuesPerSegment);
  }
}

/** Overwrites the padded chunks of every slot of the pool from source, which holds what copyToHost() writes. */
template <typename T>
void
tarch::accelerator::ChunkedMemoryPool<T>::copyFromHost(const std::vector<T>& source) {
  const auto valuesPerSegment = static_cast<std::size_t>(getSegmentSize()) * static_cast<std::size_t>(_paddedChunkSize);
  assertion(source.size() == _segments.size() * valuesPerSegment, source.size(), _segments.size(), valuesPerSegment);
  for (std::size_t segment = 0; segment < _segments.size(); segment++) {
    _segments[segment].copyFromHost(source.data() + segment * valuesPerSegment, valuesPerSegment);
  }
}

template <typename T>
INLINE_METHOD typename tarch::accelerator::ChunkedMemoryPool<T>::View
tarch::accelerator::ChunkedMemoryPool<T>::getView() noexcept {
  return typename tarch::accelerator::ChunkedMemoryPool<T>::View{
    _segmentTable.getData(),
    _segmentSizeExponent,
    getSegmentSize() - 1,
    _paddedChunkSize
  };
}

template <typename T>
INLINE_METHOD typename tarch::accelerator::ChunkedMemoryPool<T>::ConstView
tarch::accelerator::ChunkedMemoryPool<T>::getView() const noexcept {
  return typename tarch::accelerator::ChunkedMemoryPool<T>::ConstView{
    _segmentTable.getData(),
    _segmentSizeExponent,
    getSegmentSize() - 1,
    _paddedChunkSize
  };
}

/**
 * Returns the address of a chunk from the host copy of the segment table. Host code dereferences
 * the address of a host-accessible pool only.
 */
template <typename T>
INLINE_METHOD T*
tarch::accelerator::ChunkedMemoryPool<T>::getChunk(const int slot) noexcept {
  assertion(slot >= 0 and slot < getCapacity(), slot, getCapacity());
  return _segmentBasesOnHost[static_cast<std::size_t>(slot >> _segmentSizeExponent)]
    + static_cast<std::size_t>(slot & (getSegmentSize() - 1)) * static_cast<std::size_t>(_paddedChunkSize);
}

template <typename T>
INLINE_METHOD const T*
tarch::accelerator::ChunkedMemoryPool<T>::getChunk(const int slot) const noexcept {
  assertion(slot >= 0 and slot < getCapacity(), slot, getCapacity());
  return _segmentBasesOnHost[static_cast<std::size_t>(slot >> _segmentSizeExponent)]
    + static_cast<std::size_t>(slot & (getSegmentSize() - 1)) * static_cast<std::size_t>(_paddedChunkSize);
}

template <typename T>
INLINE_METHOD tarch::accelerator::Buffer<T>&
tarch::accelerator::ChunkedMemoryPool<T>::getSegment(const int segmentNumber) noexcept {
  assertion(segmentNumber >= 0 and segmentNumber < getNumberOfSegments(), segmentNumber, getNumberOfSegments());
  return _segments[static_cast<std::size_t>(segmentNumber)];
}

template <typename T>
INLINE_METHOD const tarch::accelerator::Buffer<T>&
tarch::accelerator::ChunkedMemoryPool<T>::getSegment(const int segmentNumber) const noexcept {
  assertion(segmentNumber >= 0 and segmentNumber < getNumberOfSegments(), segmentNumber, getNumberOfSegments());
  return _segments[static_cast<std::size_t>(segmentNumber)];
}

template <typename T>
INLINE_METHOD int
tarch::accelerator::ChunkedMemoryPool<T>::getChunkSize() const noexcept {
  return _chunkSize;
}

template <typename T>
INLINE_METHOD int
tarch::accelerator::ChunkedMemoryPool<T>::getPaddedChunkSize() const noexcept {
  return _paddedChunkSize;
}

template <typename T>
INLINE_METHOD int
tarch::accelerator::ChunkedMemoryPool<T>::getCapacity() const noexcept {
  return getNumberOfSegments() * getSegmentSize();
}

/** Returns the slots per segment, which is zero before the first reservation. */
template <typename T>
INLINE_METHOD int
tarch::accelerator::ChunkedMemoryPool<T>::getSegmentSize() const noexcept {
  return _segments.empty() ? 0 : 1 << _segmentSizeExponent;
}

template <typename T>
INLINE_METHOD int
tarch::accelerator::ChunkedMemoryPool<T>::getNumberOfSegments() const noexcept {
  return static_cast<int>(_segments.size());
}

template <typename T>
INLINE_METHOD tarch::AllocatedBytes
tarch::accelerator::ChunkedMemoryPool<T>::getAllocatedBytes() const noexcept {
  return tarch::AllocatedBytes::in(
    _location,
    static_cast<std::size_t>(getCapacity()) * static_cast<std::size_t>(_paddedChunkSize) * sizeof(T)
  );
}

template <typename T>
INLINE_METHOD tarch::MemoryLocation
tarch::accelerator::ChunkedMemoryPool<T>::getLocation() const noexcept {
  return _location;
}
