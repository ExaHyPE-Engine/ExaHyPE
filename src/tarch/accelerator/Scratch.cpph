#include <omp.h>

/**
 * Returns the scratch chunk of the caller inside a dispatch: The work item on a device, where
 * every work item runs at once, and the thread number on the host, where a thread runs its work
 * items one after the other.
 */
INLINE_METHOD GPU_CALLABLE_METHOD int
tarch::accelerator::getScratchChunk([[maybe_unused]] const int workItem) {
  COMPILE_IF_ON_DEVICE(return workItem;)
  COMPILE_IF_ON_HOST(return omp_get_thread_num();)
}
