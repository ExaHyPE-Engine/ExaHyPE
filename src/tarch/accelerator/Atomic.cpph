TARGET_DECLARE
/**
 * Reads one value whose caller excludes concurrent access to the same address.
 *
 * The host uses a relaxed atomic load, while device backends use an ordinary
 * load. This routine is not a synchronisation boundary.
 */
template <typename T>
INLINE_METHOD GPU_CALLABLE_METHOD T tarch::accelerator::loadAtomic(const T& target) {
  T result{};
  COMPILE_IF_ON_HOST(result = std::atomic_ref<T>(const_cast<T&>(target)).load(std::memory_order_relaxed);)
  COMPILE_IF_ON_DEVICE(result = target;)
  return result;
}

/**
 * Overwrites the target with relaxed memory ordering. Device backends use an
 * ordinary store, so this routine is not a synchronisation boundary.
 */
template <typename T>
INLINE_METHOD GPU_CALLABLE_METHOD void tarch::accelerator::storeAtomic(T& target, const T value) {
  COMPILE_IF_ON_HOST(std::atomic_ref<T>(target).store(value, std::memory_order_relaxed);)
  COMPILE_IF_ON_DEVICE(target = value;)
}

/**
 * Raises the target to a larger value, keeping the maximum over concurrent
 * writers so the result is independent of their order.
 */
template <typename T>
INLINE_METHOD GPU_CALLABLE_METHOD void tarch::accelerator::updateAtomicMax(T& target, const T value) {
#if defined(PEANO_WITH_GPU_BACKEND_KOKKOS)
  Kokkos::atomic_max(&target, value);
#elif defined(PEANO_WITH_GPU_BACKEND_SYCL)
  const ::sycl::atomic_ref<T, ::sycl::memory_order::relaxed, ::sycl::memory_scope::device> reference(target);
  if constexpr (std::is_integral_v<T>) {
    reference.fetch_max(value);
  } else {
    // AdaptiveCpp implements fetch_max on a floating-point type through an atomic load with a
    // run-time memory order, which a device backend rejects without optimisation, so the maximum
    // runs through compare-and-exchange from a plain read.
    T current = target;
    while (current < value and not reference.compare_exchange_weak(current, value)) {
    }
  }
#elif defined(PEANO_WITH_GPU_BACKEND_OMPT)
#pragma omp atomic compare
  if (target < value) {
    target = value;
  }
#else
  COMPILE_IF_ON_HOST(
    const std::atomic_ref<T> reference(target); T current = reference.load(std::memory_order_relaxed);
    while (current < value and not reference.compare_exchange_weak(current, value, std::memory_order_relaxed)){}
  )
  COMPILE_IF_ON_DEVICE(
    if constexpr (std::is_integral_v<T>) { atomicMax(&target, value); } else {
      tarch::accelerator::updateAtomicMaxThroughCompareAndSwap(target, value);
    }
  )
#endif
}

/**
 * Raises a floating-point target on a CUDA or HIP device through
 * compare-and-swap on its bit pattern, as both offer atomicMax for integers
 * only. The routine compiles to nothing on the host.
 */
template <typename T>
INLINE_METHOD GPU_CALLABLE_METHOD void tarch::accelerator::updateAtomicMaxThroughCompareAndSwap(
  [[maybe_unused]] T&      target,
  [[maybe_unused]] const T value
) {
  COMPILE_IF_ON_DEVICE(
    using Bits           = typename tarch::accelerator::UnsignedOfWidth<sizeof(T)>::Type;
    Bits* const address  = reinterpret_cast<Bits*>(&target);
    Bits        observed = *address;
    Bits        assumed  = observed;
    do {
      assumed = observed;
      T current;
      std::memcpy(&current, &assumed, sizeof(T));
      if (not(current < value)) {
        return;
      }
      Bits candidate;
      std::memcpy(&candidate, &value, sizeof(T));
      observed = atomicCAS(address, assumed, candidate);
    } while (assumed != observed);
  )
}
TARGET_DECLARE_END

/**
 * Lowers the target when the candidate value is smaller.
 *
 * Relaxed ordering makes the numeric update atomic without ordering other
 * memory. Callers provide any additional ordering.
 */
template <typename T>
INLINE_METHOD void tarch::accelerator::updateAtomicMin(T& target, const T value) {
  const std::atomic_ref<T> atomicTarget(target);
  auto                     current = atomicTarget.load(std::memory_order_relaxed);
  while (value < current) {
    if (atomicTarget.compare_exchange_weak(current, value, std::memory_order_relaxed)) {
      return;
    }
  }
}

/**
 * Increments the target with relaxed memory ordering.
 *
 * @return The value stored after the increment.
 */
template <typename T>
INLINE_METHOD T tarch::accelerator::incrementAtomic(T& target) {
  const std::atomic_ref<T> atomicTarget(target);
  return atomicTarget.fetch_add(1, std::memory_order_relaxed) + 1;
}

/**
 * Adds the value with relaxed memory ordering.
 *
 * @return The value stored after the addition.
 */
template <typename T>
INLINE_METHOD T tarch::accelerator::addAtomic(T& target, const T value) {
  const std::atomic_ref<T> atomicTarget(target);
  auto                     current = atomicTarget.load(std::memory_order_relaxed);
  while (true) {
    const auto updatedValue = current + value;
    if (atomicTarget.compare_exchange_weak(current, updatedValue, std::memory_order_relaxed)) {
      return updatedValue;
    }
  }
}
