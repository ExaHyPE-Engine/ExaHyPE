TARGET_DECLARE
template <typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD tarch::la::Vector<3, Scalar>::Vector(const Scalar* const values) :
  _values{values[0], values[1], values[2]} {}

template <typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD constexpr tarch::la::Vector<3, Scalar>::Vector(
  const std::initializer_list<Scalar> values
) {
  auto p = values.begin();
  if (p != values.end()) {
    _values[0] = *p;
    p++;
  }
  if (p != values.end()) {
    _values[1] = *p;
    p++;
  }
  if (p != values.end()) {
    _values[2] = *p;
  }
}

template <typename Scalar>
INLINE_METHOD tarch::la::Vector<3, Scalar>::Vector(const std::bitset<3>& values) :
  _values{values[0] ? Scalar(1) : Scalar(0), values[1] ? Scalar(1) : Scalar(0), values[2] ? Scalar(1) : Scalar(0)} {}

template <typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD tarch::la::Vector<3, Scalar>::Vector(const Scalar& initialValue) :
  _values{initialValue, initialValue, initialValue} {}

template <typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD int
tarch::la::Vector<3, Scalar>::getSize() const {
  return 3;
}

template <typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD const Scalar&
tarch::la::Vector<3, Scalar>::operator[](const int index) const {
  ASSERTION(index >= 0, index, 3, ::toString(*this));
  ASSERTION(index < 3, index, 3, ::toString(*this));
  return _values[index];
}

template <typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD Scalar&
tarch::la::Vector<3, Scalar>::operator[](const int index) {
  ASSERTION(index >= 0, index, 3, ::toString(*this));
  ASSERTION(index < 3, index, 3, ::toString(*this));
  return _values[index];
}

template <typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD const Scalar&
tarch::la::Vector<3, Scalar>::operator()(const int index) const {
  return (*this)[index];
}

template <typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD Scalar&
tarch::la::Vector<3, Scalar>::operator()(const int index) {
  return (*this)[index];
}

template <typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD Scalar*
tarch::la::Vector<3, Scalar>::getData() {
  return _values;
}

template <typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD const Scalar*
tarch::la::Vector<3, Scalar>::getData() const {
  return _values;
}
TARGET_DECLARE_END
