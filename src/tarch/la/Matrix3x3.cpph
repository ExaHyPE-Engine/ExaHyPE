template <typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD tarch::la::Matrix<3, 3, Scalar>::Matrix():
  _values() {}

template <typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD tarch::la::Matrix<3, 3, Scalar>::Matrix(const Scalar& value) {
  for (int i = 0; i < 9; i++) {
    _values[i] = value;
  }
}

template <typename Scalar>
INLINE_METHOD tarch::la::Matrix<3, 3, Scalar>::Matrix(std::initializer_list<Scalar> values):
  _values() {
  assertion2(values.size() <= 9, values.size(), 9);
  int index = 0;
  for (auto p = values.begin(); p != values.end(); p++) {
    _values[index] = *p;
    index++;
  }
}

template <typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD int tarch::la::Matrix<3, 3, Scalar>::rows() const {
  return 3;
}

template <typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD int tarch::la::Matrix<3, 3, Scalar>::cols() const {
  return 3;
}

template <typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD int tarch::la::Matrix<3, 3, Scalar>::size() const {
  return 9;
}

template <typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD Scalar& tarch::la::Matrix<3, 3, Scalar>::operator()(int rowIndex, int colIndex) {
  assertion5(rowIndex >= 0, 3, 3, rowIndex, colIndex, toString());
  assertion5(colIndex >= 0, 3, 3, rowIndex, colIndex, toString());
  assertion5(rowIndex < 3, 3, 3, rowIndex, colIndex, toString());
  assertion5(colIndex < 3, 3, 3, rowIndex, colIndex, toString());
  return _values[rowIndex * 3 + colIndex];
}

template <typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD const Scalar& tarch::la::Matrix<3, 3, Scalar>::operator()(
  int rowIndex,
  int colIndex
) const {
  assertion5(rowIndex >= 0, 3, 3, rowIndex, colIndex, toString());
  assertion5(colIndex >= 0, 3, 3, rowIndex, colIndex, toString());
  assertion5(rowIndex < 3, 3, 3, rowIndex, colIndex, toString());
  assertion5(colIndex < 3, 3, 3, rowIndex, colIndex, toString());
  return _values[rowIndex * 3 + colIndex];
}

template <typename Scalar>
std::string tarch::la::Matrix<3, 3, Scalar>::toString() const {
  std::ostringstream os;
  os << "[";
  for (int i = 0; i < 3; i++) {
    os << "[";
    for (int j = 0; j < 3; j++) {
      os << _values[i * 3 + j];
      if (j + 1 < 3) {
        os << ",";
      }
    }
    os << "]";
    if (i + 1 < 3) {
      os << ",";
    }
  }
  os << "]";
  return os.str();
}

template <typename Scalar>
std::string tarch::la::Matrix<3, 3, Scalar>::toPrettyString(int numberOfDigits) const {
  std::ostringstream os;
  os << "[" << std::setiosflags(std::ios::fixed) << std::setprecision(numberOfDigits);
  for (int i = 0; i < 3; i++) {
    os << std::endl;
    for (int j = 0; j < 3; j++) {
      if (tarch::la::abs(_values[i * 3 + j]) >= 0.0) {
        os << " ";
      }
      os << _values[i * 3 + j];
      if (j + 1 < 3) {
        os << ", ";
      }
    }
    if (i + 1 < 3) {
      os << ",";
    }
  }
  os << std::endl << "]";
  return os.str();
}

template <typename Scalar>
template <typename NewScalarType>
INLINE_METHOD GPU_CALLABLE_METHOD tarch::la::Matrix<3, 3, NewScalarType> tarch::la::Matrix<3, 3, Scalar>::
  convertScalar() const {
  tarch::la::Matrix<3, 3, NewScalarType> result;
  for (int i = 0; i < 3; i++) {
    for (int j = 0; j < 3; j++) {
      result(i, j) = operator()(i, j);
    }
  }
  return result;
}

template <typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD Scalar* tarch::la::Matrix<3, 3, Scalar>::data() {
  return _values;
}

template <typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD const Scalar* tarch::la::Matrix<3, 3, Scalar>::data() const {
  return _values;
}
