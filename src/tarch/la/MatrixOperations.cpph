TARGET_DECLARE
template <int Rows, typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD tarch::la::Matrix<Rows, Rows, Scalar>
tarch::la::identity() {
  tarch::la::Matrix<Rows, Rows, Scalar> result(0.0);

  for (int i = 0; i < Rows; i++) {
    result(i, i) = 1.0;
  }

  return result;
}

template <int Rows, int Cols, typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD Scalar
tarch::la::frobeniusNorm(const Matrix<Rows, Cols, Scalar>& matrix) {
  Scalar result(0);

  for (int row = 0; row < Rows; row++) {
    for (int col = 0; col < Cols; col++) {
      result += matrix(row, col) * matrix(row, col);
    }
  }

  return std::sqrt(result);
}

template <typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD Scalar
tarch::la::frobeniusNorm(const Matrix<2, 2, Scalar>& matrix) {
  const Scalar* values = matrix.getData();
  return std::sqrt(values[0] * values[0] + values[1] * values[1] + values[2] * values[2] + values[3] * values[3]);
}

template <typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD Scalar
tarch::la::frobeniusNorm(const Matrix<3, 3, Scalar>& matrix) {
  const Scalar* values = matrix.getData();
  Scalar        result = 0;
  for (int i = 0; i < 9; i++) {
    result += values[i] * values[i];
  }
  return std::sqrt(result);
}

template <typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD Scalar
tarch::la::frobeniusNorm(const Matrix<4, 4, Scalar>& matrix) {
  const Scalar* values = matrix.getData();
  Scalar        result = 0;
  for (int i = 0; i < 16; i++) {
    result += values[i] * values[i];
  }
  return std::sqrt(result);
}

/**
 * Returns the largest absolute entry of the matrix.
 */
template <int Rows, int Cols, typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD Scalar
tarch::la::elementMax(const Matrix<Rows, Cols, Scalar>& matrix) {
  Scalar result(0);

  for (int row = 0; row < Rows; row++) {
    for (int col = 0; col < Cols; col++) {
      result = std::max(result, std::abs(matrix(row, col)));
    }
  }

  return result;
}

template <typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD Scalar
tarch::la::elementMax(const Matrix<2, 2, Scalar>& matrix) {
  const Scalar* values = matrix.getData();
  return std::max(
    std::max(std::abs(values[0]), std::abs(values[1])),
    std::max(std::abs(values[2]), std::abs(values[3]))
  );
}

template <typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD Scalar
tarch::la::elementMax(const Matrix<3, 3, Scalar>& matrix) {
  const Scalar* values = matrix.getData();
  Scalar        result = 0;
  for (int i = 0; i < 9; i++) {
    result = std::max(result, std::abs(values[i]));
  }
  return result;
}

template <typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD Scalar
tarch::la::elementMax(const Matrix<4, 4, Scalar>& matrix) {
  const Scalar* values = matrix.getData();
  Scalar        result = 0;
  for (int i = 0; i < 16; i++) {
    result = std::max(result, std::abs(values[i]));
  }
  return result;
}

/**
 * Returns the entry-wise reciprocals @f$ A_{ij}^{-1} @f$ of a matrix without zero entries.
 */
template <int Rows, int Cols, typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD tarch::la::Matrix<Rows, Cols, Scalar>
tarch::la::invertEntries(const tarch::la::Matrix<Rows, Cols, Scalar>& matrix) {
  tarch::la::Matrix<Rows, Cols, Scalar> result(0.0);

  for (int i = 0; i < Rows; i++) {
    for (int j = 0; j < Cols; j++) {
      result(i, j) = 1.0 / matrix(i, j);
    }
  }

  return result;
}

template <typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD tarch::la::Matrix<2, 2, Scalar>
tarch::la::invertEntries(const tarch::la::Matrix<2, 2, Scalar>& matrix) {
  const Scalar* values = matrix.getData();
  return tarch::la::Matrix<2, 2, Scalar>{1.0 / values[0], 1.0 / values[1], 1.0 / values[2], 1.0 / values[3]};
}

template <typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD tarch::la::Matrix<3, 3, Scalar>
tarch::la::invertEntries(const tarch::la::Matrix<3, 3, Scalar>& matrix) {
  const Scalar* values = matrix.getData();
  return tarch::la::Matrix<3, 3, Scalar>{
    1.0 / values[0],
    1.0 / values[1],
    1.0 / values[2],
    1.0 / values[3],
    1.0 / values[4],
    1.0 / values[5],
    1.0 / values[6],
    1.0 / values[7],
    1.0 / values[8]
  };
}

template <typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD tarch::la::Matrix<4, 4, Scalar>
tarch::la::invertEntries(const tarch::la::Matrix<4, 4, Scalar>& matrix) {
  const Scalar* values = matrix.getData();
  return tarch::la::Matrix<4, 4, Scalar>{
    1.0 / values[0],
    1.0 / values[1],
    1.0 / values[2],
    1.0 / values[3],
    1.0 / values[4],
    1.0 / values[5],
    1.0 / values[6],
    1.0 / values[7],
    1.0 / values[8],
    1.0 / values[9],
    1.0 / values[10],
    1.0 / values[11],
    1.0 / values[12],
    1.0 / values[13],
    1.0 / values[14],
    1.0 / values[15]
  };
}

template <int Rows, int Cols, typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD tarch::la::Vector<Cols, Scalar>
tarch::la::getRow(const Matrix<Rows, Cols, Scalar>& matrix, int whichRow) {
  tarch::la::Vector<Cols, Scalar> result;

  for (int i = 0; i < Cols; i++) {
    result(i) = matrix(whichRow, i);
  }

  return result;
}

template <typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD tarch::la::Vector<2, Scalar>
tarch::la::getRow(const Matrix<2, 2, Scalar>& matrix, int whichRow) {
  const Scalar* values = matrix.getData();
  return whichRow == 0 ? tarch::la::Vector<2, Scalar>{values[0], values[1]}
                       : tarch::la::Vector<2, Scalar>{values[2], values[3]};
}

template <typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD tarch::la::Vector<3, Scalar>
tarch::la::getRow(const Matrix<3, 3, Scalar>& matrix, int whichRow) {
  const Scalar* values = matrix.getData() + whichRow * 3;
  return tarch::la::Vector<3, Scalar>{values[0], values[1], values[2]};
}

template <typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD tarch::la::Vector<4, Scalar>
tarch::la::getRow(const Matrix<4, 4, Scalar>& matrix, int whichRow) {
  const Scalar* values = matrix.getData() + whichRow * 4;
  return tarch::la::Vector<4, Scalar>{values[0], values[1], values[2], values[3]};
}

template <int Rows, int Cols, typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD tarch::la::Vector<Rows, Scalar>
tarch::la::getColumn(const Matrix<Rows, Cols, Scalar>& matrix, int whichColumn) {
  tarch::la::Vector<Rows, Scalar> result;

  for (int i = 0; i < Rows; i++) {
    result(i) = matrix(i, whichColumn);
  }

  return result;
}

template <typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD tarch::la::Vector<2, Scalar>
tarch::la::getColumn(const Matrix<2, 2, Scalar>& matrix, int whichColumn) {
  const Scalar* values = matrix.getData();
  return tarch::la::Vector<2, Scalar>{values[whichColumn], values[2 + whichColumn]};
}

template <typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD tarch::la::Vector<3, Scalar>
tarch::la::getColumn(const Matrix<3, 3, Scalar>& matrix, int whichColumn) {
  const Scalar* values = matrix.getData();
  return tarch::la::Vector<3, Scalar>{values[whichColumn], values[3 + whichColumn], values[6 + whichColumn]};
}

template <typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD tarch::la::Vector<4, Scalar>
tarch::la::getColumn(const Matrix<4, 4, Scalar>& matrix, int whichColumn) {
  const Scalar* values = matrix.getData();
  return tarch::la::Vector<4, Scalar>{
    values[whichColumn],
    values[4 + whichColumn],
    values[8 + whichColumn],
    values[12 + whichColumn]
  };
}

template <int Rows, int Cols, typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD tarch::la::Matrix<Cols, Rows, Scalar>
tarch::la::transpose(const tarch::la::Matrix<Rows, Cols, Scalar>& matrix) {
  tarch::la::Matrix<Cols, Rows, Scalar> result;
  for (int i = 0; i < Rows; i++) {
    for (int j = 0; j < Cols; j++) {
      result(j, i) = matrix(i, j);
    }
  }
  return result;
}

template <typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD tarch::la::Matrix<2, 2, Scalar>
tarch::la::transpose(const tarch::la::Matrix<2, 2, Scalar>& matrix) {
  const Scalar* values = matrix.getData();
  return tarch::la::Matrix<2, 2, Scalar>{values[0], values[2], values[1], values[3]};
}

template <typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD tarch::la::Matrix<3, 3, Scalar>
tarch::la::transpose(const tarch::la::Matrix<3, 3, Scalar>& matrix) {
  const Scalar* values = matrix.getData();
  return tarch::la::Matrix<3, 3, Scalar>{
    values[0],
    values[3],
    values[6],
    values[1],
    values[4],
    values[7],
    values[2],
    values[5],
    values[8]
  };
}

template <typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD tarch::la::Matrix<4, 4, Scalar>
tarch::la::transpose(const tarch::la::Matrix<4, 4, Scalar>& matrix) {
  const Scalar* values = matrix.getData();
  return tarch::la::Matrix<4, 4, Scalar>{
    values[0],
    values[4],
    values[8],
    values[12],
    values[1],
    values[5],
    values[9],
    values[13],
    values[2],
    values[6],
    values[10],
    values[14],
    values[3],
    values[7],
    values[11],
    values[15]
  };
}

template <int Rows, int Cols, typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD Scalar
tarch::la::sum(const tarch::la::Matrix<Rows, Cols, Scalar>& matrix) {
  Scalar result = 0;
  for (int i = 0; i < Rows; i++) {
    for (int j = 0; j < Cols; j++) {
      result += matrix(i, j);
    }
  }
  return result;
}

template <typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD Scalar
tarch::la::sum(const tarch::la::Matrix<2, 2, Scalar>& matrix) {
  const Scalar* values = matrix.getData();
  return values[0] + values[1] + values[2] + values[3];
}

template <typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD Scalar
tarch::la::sum(const tarch::la::Matrix<3, 3, Scalar>& matrix) {
  const Scalar* values = matrix.getData();
  Scalar        result = 0;
  for (int i = 0; i < 9; i++) {
    result += values[i];
  }
  return result;
}

template <typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD Scalar
tarch::la::sum(const tarch::la::Matrix<4, 4, Scalar>& matrix) {
  const Scalar* values = matrix.getData();
  Scalar        result = 0;
  for (int i = 0; i < 16; i++) {
    result += values[i];
  }
  return result;
}

template <int Rows, int Cols, typename Scalar>
INLINE_METHOD std::ostream&
operator<<(std::ostream& os, const tarch::la::Matrix<Rows, Cols, Scalar>& matrix) {
  os << matrix.toString();
  return os;
}

template <int Rows, typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD tarch::la::Vector<Rows, Scalar>
tarch::la::getDiagonal(const Matrix<Rows, Rows, Scalar>& matrix) {
  tarch::la::Vector<Rows, Scalar> result;
  for (int i = 0; i < Rows; i++) {
    result(i) = matrix(i, i);
  }
  return result;
}

template <typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD tarch::la::Vector<2, Scalar>
tarch::la::getDiagonal(const Matrix<2, 2, Scalar>& matrix) {
  const Scalar* values = matrix.getData();
  return tarch::la::Vector<2, Scalar>{values[0], values[3]};
}

template <typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD tarch::la::Vector<3, Scalar>
tarch::la::getDiagonal(const Matrix<3, 3, Scalar>& matrix) {
  const Scalar* values = matrix.getData();
  return tarch::la::Vector<3, Scalar>{values[0], values[4], values[8]};
}

template <typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD tarch::la::Vector<4, Scalar>
tarch::la::getDiagonal(const Matrix<4, 4, Scalar>& matrix) {
  const Scalar* values = matrix.getData();
  return tarch::la::Vector<4, Scalar>{values[0], values[5], values[10], values[15]};
}
TARGET_DECLARE_END
