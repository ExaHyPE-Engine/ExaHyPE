template <typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD tarch::la::Vector<2, Scalar>::Vector() :
  _values{} {}

template <typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD tarch::la::Vector<2, Scalar>::Vector(const Scalar* values) :
  _values{values[0], values[1]} {}

template <typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD tarch::la::Vector<2, Scalar>::Vector(std::initializer_list<Scalar> values) :
  _values{} {
  auto p = values.begin();
  if (p != values.end()) {
    _values[0] = *p;
    p++;
  }
  if (p != values.end()) {
    _values[1] = *p;
  }
}

template <typename Scalar>
INLINE_METHOD tarch::la::Vector<2, Scalar>::Vector(const std::bitset<2>& values) :
  _values{values[0] ? Scalar(1) : Scalar(0), values[1] ? Scalar(1) : Scalar(0)} {}

template <typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD tarch::la::Vector<2, Scalar>::Vector(const Scalar& initialValue) :
  _values{initialValue, initialValue} {}

template <typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD int tarch::la::Vector<2, Scalar>::size() const {
  return 2;
}

template <typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD const Scalar& tarch::la::Vector<2, Scalar>::operator[](int index) const {
  assertion(index >= 0, index, 2, ::toString(*this));
  assertion(index < 2, index, 2, ::toString(*this));
  return _values[index];
}

template <typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD Scalar& tarch::la::Vector<2, Scalar>::operator[](int index) {
  assertion(index >= 0, index, 2, ::toString(*this));
  assertion(index < 2, index, 2, ::toString(*this));
  return _values[index];
}

template <typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD const Scalar& tarch::la::Vector<2, Scalar>::operator()(int index) const {
  return (*this)[index];
}

template <typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD Scalar& tarch::la::Vector<2, Scalar>::operator()(int index) {
  return (*this)[index];
}

template <typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD Scalar* tarch::la::Vector<2, Scalar>::data() {
  return _values;
}

template <typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD const Scalar* tarch::la::Vector<2, Scalar>::data() const {
  return _values;
}
