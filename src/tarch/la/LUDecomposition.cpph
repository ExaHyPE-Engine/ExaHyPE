template <int Size, typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD void tarch::la::
  backSubstitution(const Matrix<Size, Size, Scalar>& R, const Vector<Size, Scalar>& f, Vector<Size, Scalar>& x) {
  for (int k = Size - 1; k >= 0; k--) {
    x[k] = f[k];
    for (int i = k + 1; i < Size; i++) {
      x[k] -= R(k, i) * x[i];
    }
    if (tarch::la::smaller(R(k, k), Scalar(0.0)) or tarch::la::greater(R(k, k), Scalar(0.0))) {
      x[k] = x[k] / R(k, k);
    }
  }
}

template <int Size, typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD tarch::la::Matrix<Size, Size, Scalar> tarch::la::invertUpperTriangular(
  const Matrix<Size, Size, Scalar>& R
) {
  Matrix<Size, Size, Scalar> inverseR(Scalar(0.0));
  for (int i = 0; i < Size; i++) {
    Vector<Size, Scalar> e(Scalar(0.0));
    Vector<Size, Scalar> col(Scalar(0.0));
    e[i] = Scalar(1.0);

    backSubstitution(R, e, col);
    for (int j = 0; j <= i; j++) {
      inverseR(j, i) = col[j];
    }
  }
  return inverseR;
}
