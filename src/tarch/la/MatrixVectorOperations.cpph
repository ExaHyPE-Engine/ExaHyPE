TARGET_DECLARE
template <int Rows, int Cols, typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD tarch::la::Vector<Rows, Scalar>
tarch::la::multiply(const Matrix<Rows, Cols, Scalar>& matrix, const Vector<Cols, Scalar>& vector) {
  tarch::la::Vector<Rows, Scalar> result(Scalar(0));
  for (int i = 0; i < Rows; i++) {
    for (int j = 0; j < Cols; j++) {
      result(i) += matrix(i, j) * vector(j);
    }
  }
  return result;
}

template <typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD tarch::la::Vector<2, Scalar>
tarch::la::multiply(const Matrix<2, 2, Scalar>& matrix, const Vector<2, Scalar>& vector) {
  return Vector<2, Scalar>{
    matrix(0, 0) * vector._values[0] + matrix(0, 1) * vector._values[1],
    matrix(1, 0) * vector._values[0] + matrix(1, 1) * vector._values[1]
  };
}

template <typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD tarch::la::Vector<3, Scalar>
tarch::la::multiply(const Matrix<3, 3, Scalar>& matrix, const Vector<3, Scalar>& vector) {
  return Vector<3, Scalar>{
    matrix(0, 0) * vector._values[0] + matrix(0, 1) * vector._values[1] + matrix(0, 2) * vector._values[2],
    matrix(1, 0) * vector._values[0] + matrix(1, 1) * vector._values[1] + matrix(1, 2) * vector._values[2],
    matrix(2, 0) * vector._values[0] + matrix(2, 1) * vector._values[1] + matrix(2, 2) * vector._values[2]
  };
}

template <typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD tarch::la::Vector<4, Scalar>
tarch::la::multiply(const Matrix<4, 4, Scalar>& matrix, const Vector<4, Scalar>& vector) {
  return Vector<4, Scalar>{
    matrix(0, 0) * vector._values[0] + matrix(0, 1) * vector._values[1] + matrix(0, 2) * vector._values[2]
      + matrix(0, 3) * vector._values[3],
    matrix(1, 0) * vector._values[0] + matrix(1, 1) * vector._values[1] + matrix(1, 2) * vector._values[2]
      + matrix(1, 3) * vector._values[3],
    matrix(2, 0) * vector._values[0] + matrix(2, 1) * vector._values[1] + matrix(2, 2) * vector._values[2]
      + matrix(2, 3) * vector._values[3],
    matrix(3, 0) * vector._values[0] + matrix(3, 1) * vector._values[1] + matrix(3, 2) * vector._values[2]
      + matrix(3, 3) * vector._values[3]
  };
}

/**
 * Adds alpha times the product of the matrix and v to r.
 */
template <int Rows, int Cols, typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD void
tarch::la::matVec(
  const Matrix<Rows, Cols, Scalar>& matrix,
  Scalar                            alpha,
  const Vector<Cols, Scalar>&       v,
  Vector<Rows, Scalar>&             r
) {
  for (int i = 0; i < Rows; i++) {
    for (int j = 0; j < Cols; j++) {
      r(i) += alpha * matrix(i, j) * v(j);
    }
  }
}

template <typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD void
tarch::la::matVec(const Matrix<2, 2, Scalar>& matrix, Scalar alpha, const Vector<2, Scalar>& v, Vector<2, Scalar>& r) {
  r._values[0] += alpha * (matrix(0, 0) * v._values[0] + matrix(0, 1) * v._values[1]);
  r._values[1] += alpha * (matrix(1, 0) * v._values[0] + matrix(1, 1) * v._values[1]);
}

template <typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD void
tarch::la::matVec(const Matrix<3, 3, Scalar>& matrix, Scalar alpha, const Vector<3, Scalar>& v, Vector<3, Scalar>& r) {
  r._values[0] += alpha * (matrix(0, 0) * v._values[0] + matrix(0, 1) * v._values[1] + matrix(0, 2) * v._values[2]);
  r._values[1] += alpha * (matrix(1, 0) * v._values[0] + matrix(1, 1) * v._values[1] + matrix(1, 2) * v._values[2]);
  r._values[2] += alpha * (matrix(2, 0) * v._values[0] + matrix(2, 1) * v._values[1] + matrix(2, 2) * v._values[2]);
}

template <typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD void
tarch::la::matVec(const Matrix<4, 4, Scalar>& matrix, Scalar alpha, const Vector<4, Scalar>& v, Vector<4, Scalar>& r) {
  r._values[0] += alpha
    * (matrix(0, 0) * v._values[0] + matrix(0, 1) * v._values[1] + matrix(0, 2) * v._values[2]
       + matrix(0, 3) * v._values[3]);
  r._values[1] += alpha
    * (matrix(1, 0) * v._values[0] + matrix(1, 1) * v._values[1] + matrix(1, 2) * v._values[2]
       + matrix(1, 3) * v._values[3]);
  r._values[2] += alpha
    * (matrix(2, 0) * v._values[0] + matrix(2, 1) * v._values[1] + matrix(2, 2) * v._values[2]
       + matrix(2, 3) * v._values[3]);
  r._values[3] += alpha
    * (matrix(3, 0) * v._values[0] + matrix(3, 1) * v._values[1] + matrix(3, 2) * v._values[2]
       + matrix(3, 3) * v._values[3]);
}

template <int Rows, int Cols, typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD tarch::la::Vector<Rows, Scalar>
tarch::la::operator*(const Matrix<Rows, Cols, Scalar>& matrix, const Vector<Cols, Scalar>& vector) {
  return multiply(matrix, vector);
}

template <typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD tarch::la::Vector<2, Scalar>
tarch::la::operator*(const Matrix<2, 2, Scalar>& matrix, const Vector<2, Scalar>& vector) {
  return multiply(matrix, vector);
}

template <typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD tarch::la::Vector<3, Scalar>
tarch::la::operator*(const Matrix<3, 3, Scalar>& matrix, const Vector<3, Scalar>& vector) {
  return multiply(matrix, vector);
}

template <typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD tarch::la::Vector<4, Scalar>
tarch::la::operator*(const Matrix<4, 4, Scalar>& matrix, const Vector<4, Scalar>& vector) {
  return multiply(matrix, vector);
}
TARGET_DECLARE_END
