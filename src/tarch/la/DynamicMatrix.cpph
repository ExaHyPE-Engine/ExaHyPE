INLINE_METHOD
int tarch::la::DynamicMatrix::serialise(int row, int col, [[maybe_unused]] int Rows, int Cols) {
  return col + row * Cols;
}

INLINE_METHOD
int tarch::la::DynamicMatrix::serialise(int row, int col) const { return serialise(row, col, _rows, _cols); }

INLINE_METHOD
double* tarch::la::DynamicMatrix::data() { return _m; }

INLINE_METHOD
const double* tarch::la::DynamicMatrix::data() const { return _m; }

template <typename T>
INLINE_METHOD void tarch::la::DynamicMatrix::
  batchedMultiplyAoS(T* NOALIAS result, const T* NOALIAS x, int batchSize, int resultSize, int firstRow) {
  assertion(batchSize > 0, batchSize, resultSize, firstRow);
  assertion(resultSize > 0, batchSize, resultSize, firstRow);
  assertion(firstRow >= 0, batchSize, resultSize, firstRow);

  std::fill_n(result, resultSize * batchSize, 0.0);

  for (int col = 0; col < _cols; col++) {
    for (int rowInResult = 0; rowInResult < resultSize; rowInResult++)
      for (int i = 0; i < batchSize; i++) {
        assertion(rowInResult + firstRow < _rows, batchSize, resultSize, firstRow);
        result[rowInResult * batchSize + i] += _m[serialise(rowInResult + firstRow, col)] * x[col * batchSize + i];
      }
  }
}

template <typename T>
INLINE_METHOD void tarch::la::DynamicMatrix::batchedMultiplyAoS(T* NOALIAS result, const T* NOALIAS x, int batchCount) {
  batchedMultiplyAoS(result, x, batchCount, _rows, 0);
}
