#include "tarch/Assertions.h"
#include "tarch/la/ScalarOperations.h"

TARGET_DECLARE
template <int Size, typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD tarch::la::Vector<Size, Scalar>&
tarch::la::operator+=(tarch::la::Vector<Size, Scalar>& lhs, const tarch::la::Vector<Size, Scalar>& rhs) {
  for (int i = 0; i < Size; i++) {
    lhs(i) += rhs(i);
  }
  return lhs;
}

template <typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD tarch::la::Vector<2, Scalar>&
tarch::la::operator+=(tarch::la::Vector<2, Scalar>& lhs, const tarch::la::Vector<2, Scalar>& rhs) {
  lhs._values[0] += rhs._values[0];
  lhs._values[1] += rhs._values[1];
  return lhs;
}

template <typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD tarch::la::Vector<3, Scalar>&
tarch::la::operator+=(tarch::la::Vector<3, Scalar>& lhs, const tarch::la::Vector<3, Scalar>& rhs) {
  lhs._values[0] += rhs._values[0];
  lhs._values[1] += rhs._values[1];
  lhs._values[2] += rhs._values[2];
  return lhs;
}

template <typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD tarch::la::Vector<4, Scalar>&
tarch::la::operator+=(tarch::la::Vector<4, Scalar>& lhs, const tarch::la::Vector<4, Scalar>& rhs) {
  lhs._values[0] += rhs._values[0];
  lhs._values[1] += rhs._values[1];
  lhs._values[2] += rhs._values[2];
  lhs._values[3] += rhs._values[3];
  return lhs;
}

template <int Size, typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD tarch::la::Vector<Size, Scalar>&
tarch::la::operator-=(tarch::la::Vector<Size, Scalar>& lhs, const tarch::la::Vector<Size, Scalar>& rhs) {
  for (int i = 0; i < Size; i++) {
    lhs(i) -= rhs(i);
  }
  return lhs;
}

template <typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD tarch::la::Vector<2, Scalar>&
tarch::la::operator-=(tarch::la::Vector<2, Scalar>& lhs, const tarch::la::Vector<2, Scalar>& rhs) {
  lhs._values[0] -= rhs._values[0];
  lhs._values[1] -= rhs._values[1];
  return lhs;
}

template <typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD tarch::la::Vector<3, Scalar>&
tarch::la::operator-=(tarch::la::Vector<3, Scalar>& lhs, const tarch::la::Vector<3, Scalar>& rhs) {
  lhs._values[0] -= rhs._values[0];
  lhs._values[1] -= rhs._values[1];
  lhs._values[2] -= rhs._values[2];
  return lhs;
}

template <typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD tarch::la::Vector<4, Scalar>&
tarch::la::operator-=(tarch::la::Vector<4, Scalar>& lhs, const tarch::la::Vector<4, Scalar>& rhs) {
  lhs._values[0] -= rhs._values[0];
  lhs._values[1] -= rhs._values[1];
  lhs._values[2] -= rhs._values[2];
  lhs._values[3] -= rhs._values[3];
  return lhs;
}

template <int Size, typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD tarch::la::Vector<Size, Scalar>
tarch::la::operator+(const tarch::la::Vector<Size, Scalar>& lhs, const tarch::la::Vector<Size, Scalar>& rhs) {
  tarch::la::Vector<Size, Scalar> result;
  for (int i = 0; i < Size; i++) {
    result(i) = rhs(i) + lhs(i);
  }
  return result;
}

template <typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD tarch::la::Vector<2, Scalar>
tarch::la::operator+(const tarch::la::Vector<2, Scalar>& lhs, const tarch::la::Vector<2, Scalar>& rhs) {
  return tarch::la::makeVector<Scalar>(lhs._values[0] + rhs._values[0], lhs._values[1] + rhs._values[1]);
}

template <typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD tarch::la::Vector<3, Scalar>
tarch::la::operator+(const tarch::la::Vector<3, Scalar>& lhs, const tarch::la::Vector<3, Scalar>& rhs) {
  return tarch::la::makeVector<Scalar>(
    lhs._values[0] + rhs._values[0],
    lhs._values[1] + rhs._values[1],
    lhs._values[2] + rhs._values[2]
  );
}

template <typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD tarch::la::Vector<4, Scalar>
tarch::la::operator+(const tarch::la::Vector<4, Scalar>& lhs, const tarch::la::Vector<4, Scalar>& rhs) {
  return tarch::la::makeVector<Scalar>(
    lhs._values[0] + rhs._values[0],
    lhs._values[1] + rhs._values[1],
    lhs._values[2] + rhs._values[2],
    lhs._values[3] + rhs._values[3]
  );
}

template <int Size, typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD tarch::la::Vector<Size, Scalar>
tarch::la::operator-(const tarch::la::Vector<Size, Scalar>& lhs, const tarch::la::Vector<Size, Scalar>& rhs) {
  tarch::la::Vector<Size, Scalar> result;
  for (int i = 0; i < Size; i++) {
    result(i) = lhs(i) - rhs(i);
  }
  return result;
}

template <typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD tarch::la::Vector<2, Scalar>
tarch::la::operator-(const tarch::la::Vector<2, Scalar>& lhs, const tarch::la::Vector<2, Scalar>& rhs) {
  return tarch::la::makeVector<Scalar>(lhs._values[0] - rhs._values[0], lhs._values[1] - rhs._values[1]);
}

template <typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD tarch::la::Vector<3, Scalar>
tarch::la::operator-(const tarch::la::Vector<3, Scalar>& lhs, const tarch::la::Vector<3, Scalar>& rhs) {
  return tarch::la::makeVector<Scalar>(
    lhs._values[0] - rhs._values[0],
    lhs._values[1] - rhs._values[1],
    lhs._values[2] - rhs._values[2]
  );
}

template <typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD tarch::la::Vector<4, Scalar>
tarch::la::operator-(const tarch::la::Vector<4, Scalar>& lhs, const tarch::la::Vector<4, Scalar>& rhs) {
  return tarch::la::makeVector<Scalar>(
    lhs._values[0] - rhs._values[0],
    lhs._values[1] - rhs._values[1],
    lhs._values[2] - rhs._values[2],
    lhs._values[3] - rhs._values[3]
  );
}

template <int Size, typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD tarch::la::Vector<Size, Scalar>
tarch::la::multiplyComponents(const tarch::la::Vector<Size, Scalar>& lhs, const tarch::la::Vector<Size, Scalar>& rhs) {
  tarch::la::Vector<Size, Scalar> result;
  for (int i = 0; i < Size; i++) {
    result(i) = lhs(i) * rhs(i);
  }
  return result;
}

template <typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD tarch::la::Vector<2, Scalar>
tarch::la::multiplyComponents(const tarch::la::Vector<2, Scalar>& lhs, const tarch::la::Vector<2, Scalar>& rhs) {
  return tarch::la::makeVector<Scalar>(lhs._values[0] * rhs._values[0], lhs._values[1] * rhs._values[1]);
}

template <typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD tarch::la::Vector<3, Scalar>
tarch::la::multiplyComponents(const tarch::la::Vector<3, Scalar>& lhs, const tarch::la::Vector<3, Scalar>& rhs) {
  return tarch::la::makeVector<Scalar>(
    lhs._values[0] * rhs._values[0],
    lhs._values[1] * rhs._values[1],
    lhs._values[2] * rhs._values[2]
  );
}

template <typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD tarch::la::Vector<4, Scalar>
tarch::la::multiplyComponents(const tarch::la::Vector<4, Scalar>& lhs, const tarch::la::Vector<4, Scalar>& rhs) {
  return tarch::la::makeVector<Scalar>(
    lhs._values[0] * rhs._values[0],
    lhs._values[1] * rhs._values[1],
    lhs._values[2] * rhs._values[2],
    lhs._values[3] * rhs._values[3]
  );
}

template <int Size, typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD tarch::la::Vector<Size, Scalar>
tarch::la::divideComponents(const tarch::la::Vector<Size, Scalar>& lhs, const tarch::la::Vector<Size, Scalar>& rhs) {
  tarch::la::Vector<Size, Scalar> result;
  for (int i = 0; i < Size; i++) {
    assertion(rhs(i) != Scalar{0}, i);
    result(i) = lhs(i) / rhs(i);
  }
  return result;
}

template <typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD tarch::la::Vector<2, Scalar>
tarch::la::divideComponents(const tarch::la::Vector<2, Scalar>& lhs, const tarch::la::Vector<2, Scalar>& rhs) {
  assertion(rhs._values[0] != Scalar{0} and rhs._values[1] != Scalar{0});
  return tarch::la::makeVector<Scalar>(lhs._values[0] / rhs._values[0], lhs._values[1] / rhs._values[1]);
}

template <typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD tarch::la::Vector<3, Scalar>
tarch::la::divideComponents(const tarch::la::Vector<3, Scalar>& lhs, const tarch::la::Vector<3, Scalar>& rhs) {
  assertion(rhs._values[0] != Scalar{0} and rhs._values[1] != Scalar{0} and rhs._values[2] != Scalar{0});
  return tarch::la::makeVector<Scalar>(
    lhs._values[0] / rhs._values[0],
    lhs._values[1] / rhs._values[1],
    lhs._values[2] / rhs._values[2]
  );
}

template <typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD tarch::la::Vector<4, Scalar>
tarch::la::divideComponents(const tarch::la::Vector<4, Scalar>& lhs, const tarch::la::Vector<4, Scalar>& rhs) {
  assertion(
    rhs._values[0] != Scalar{0} and rhs._values[1] != Scalar{0} and rhs._values[2] != Scalar{0}
    and rhs._values[3] != Scalar{0}
  );
  return tarch::la::makeVector<Scalar>(
    lhs._values[0] / rhs._values[0],
    lhs._values[1] / rhs._values[1],
    lhs._values[2] / rhs._values[2],
    lhs._values[3] / rhs._values[3]
  );
}

template <int Size, typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD tarch::la::Vector<Size, Scalar>
tarch::la::max(const tarch::la::Vector<Size, Scalar>& lhs, const tarch::la::Vector<Size, Scalar>& rhs) {
  tarch::la::Vector<Size, Scalar> result;
  for (int i = 0; i < Size; i++) {
    result(i) = std::max(lhs(i), rhs(i));
  }
  return result;
}

template <int Size, typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD tarch::la::Vector<Size, Scalar>
tarch::la::min(const tarch::la::Vector<Size, Scalar>& lhs, const tarch::la::Vector<Size, Scalar>& rhs) {
  tarch::la::Vector<Size, Scalar> result;
  for (int i = 0; i < Size; i++) {
    result(i) = std::min(lhs(i), rhs(i));
  }
  return result;
}

/** Returns the inner product of lhs and rhs. */
template <int Size, typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD Scalar
tarch::la::operator*(const tarch::la::Vector<Size, Scalar>& lhs, const tarch::la::Vector<Size, Scalar>& rhs) {
  return tarch::la::innerDot(lhs, rhs);
}

template <typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD Scalar
tarch::la::operator*(const tarch::la::Vector<2, Scalar>& lhs, const tarch::la::Vector<2, Scalar>& rhs) {
  return lhs._values[0] * rhs._values[0] + lhs._values[1] * rhs._values[1];
}

template <typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD Scalar
tarch::la::operator*(const tarch::la::Vector<3, Scalar>& lhs, const tarch::la::Vector<3, Scalar>& rhs) {
  return lhs._values[0] * rhs._values[0] + lhs._values[1] * rhs._values[1] + lhs._values[2] * rhs._values[2];
}

template <typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD Scalar
tarch::la::operator*(const tarch::la::Vector<4, Scalar>& lhs, const tarch::la::Vector<4, Scalar>& rhs) {
  return lhs._values[0] * rhs._values[0] + lhs._values[1] * rhs._values[1] + lhs._values[2] * rhs._values[2]
    + lhs._values[3] * rhs._values[3];
}

template <int Size, typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD Scalar
tarch::la::innerDot(const tarch::la::Vector<Size, Scalar>& lhs, const tarch::la::Vector<Size, Scalar>& rhs) {
  Scalar result = lhs(0) * rhs(0);
  for (int i = 1; i < Size; i++) {
    result += lhs(i) * rhs(i);
  }
  return result;
}

template <typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD Scalar
tarch::la::innerDot(const tarch::la::Vector<2, Scalar>& lhs, const tarch::la::Vector<2, Scalar>& rhs) {
  return lhs._values[0] * rhs._values[0] + lhs._values[1] * rhs._values[1];
}

template <typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD Scalar
tarch::la::innerDot(const tarch::la::Vector<3, Scalar>& lhs, const tarch::la::Vector<3, Scalar>& rhs) {
  return lhs._values[0] * rhs._values[0] + lhs._values[1] * rhs._values[1] + lhs._values[2] * rhs._values[2];
}

template <typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD Scalar
tarch::la::innerDot(const tarch::la::Vector<4, Scalar>& lhs, const tarch::la::Vector<4, Scalar>& rhs) {
  return lhs._values[0] * rhs._values[0] + lhs._values[1] * rhs._values[1] + lhs._values[2] * rhs._values[2]
    + lhs._values[3] * rhs._values[3];
}

template <int Size, typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD Scalar
tarch::la::dot(const tarch::la::Vector<Size, Scalar>& lhs, const tarch::la::Vector<Size, Scalar>& rhs) {
  return tarch::la::innerDot(lhs, rhs);
}

template <typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD Scalar
tarch::la::dot(const tarch::la::Vector<2, Scalar>& lhs, const tarch::la::Vector<2, Scalar>& rhs) {
  return tarch::la::innerDot(lhs, rhs);
}

template <typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD Scalar
tarch::la::dot(const tarch::la::Vector<3, Scalar>& lhs, const tarch::la::Vector<3, Scalar>& rhs) {
  return tarch::la::innerDot(lhs, rhs);
}

template <typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD Scalar
tarch::la::dot(const tarch::la::Vector<4, Scalar>& lhs, const tarch::la::Vector<4, Scalar>& rhs) {
  return tarch::la::innerDot(lhs, rhs);
}

template <typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD tarch::la::Vector<3, Scalar>
tarch::la::cross(const tarch::la::Vector<3, Scalar>& lhs, const tarch::la::Vector<3, Scalar>& rhs) {
  tarch::la::Vector<3, Scalar> result;

  result(0) = lhs(1) * rhs(2) - lhs(2) * rhs(1);
  result(1) = lhs(2) * rhs(0) - lhs(0) * rhs(2);
  result(2) = lhs(0) * rhs(1) - lhs(1) * rhs(0);

  return result;
}

/**
 * Returns whether every component of lhs lies within the absolute tolerance of its component of rhs.
 * A NaN component never does.
 */
template <int Size, typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD bool
tarch::la::equals(
  const tarch::la::Vector<Size, Scalar>& lhs,
  const tarch::la::Vector<Size, Scalar>& rhs,
  const Scalar                           tolerance
) {
  for (int i = 0; i < Size; i++) {
    const bool withinTolerance = tarch::la::abs(lhs(i) - rhs(i)) <= tolerance;
    if (not withinTolerance) {
      return false;
    }
  }
  return true;
}

/** Returns whether lhs is greater than rhs in the first component pair that differs by more than tolerance. */
template <int Size, typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD bool
tarch::la::firstGreater(
  const tarch::la::Vector<Size, Scalar>& lhs,
  const tarch::la::Vector<Size, Scalar>& rhs,
  const Scalar                           tolerance
) {
  for (int i = 0; i < Size; i++) {
    if (lhs(i) - rhs(i) > tolerance) {
      return true;
    } else if (rhs(i) - lhs(i) > tolerance) {
      return false;
    }
  }
  return false;
}

template <int Size, typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD bool
tarch::la::oneGreater(
  const tarch::la::Vector<Size, Scalar>& lhs,
  const tarch::la::Vector<Size, Scalar>& rhs,
  const Scalar                           tolerance
) {
  for (int i = 0; i < Size; i++) {
    if (lhs(i) - rhs(i) > tolerance) {
      return true;
    }
  }
  return false;
}

template <int Size, typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD bool
tarch::la::oneGreaterEquals(
  const tarch::la::Vector<Size, Scalar>& lhs,
  const tarch::la::Vector<Size, Scalar>& rhs,
  const Scalar                           tolerance
) {
  for (int i = 0; i < Size; i++) {
    if (lhs(i) - rhs(i) >= -tolerance) {
      return true;
    }
  }
  return false;
}

template <int Size, typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD bool
tarch::la::allGreater(
  const tarch::la::Vector<Size, Scalar>& lhs,
  const tarch::la::Vector<Size, Scalar>& rhs,
  const Scalar                           tolerance
) {
  bool result = true;
  for (int i = 0; i < Size; i++) {
    result = result and tarch::la::greater(lhs(i), rhs(i), tolerance);
  }
  return result;
}

template <int Size, typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD bool
tarch::la::allGreaterEquals(
  const tarch::la::Vector<Size, Scalar>& lhs,
  const tarch::la::Vector<Size, Scalar>& rhs,
  const Scalar                           tolerance
) {
  bool result = true;
  for (int i = 0; i < Size; i++) {
    result = result and tarch::la::greaterEquals(lhs(i), rhs(i), tolerance);
  }
  return result;
}

template <int Size, typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD bool
tarch::la::allSmaller(
  const tarch::la::Vector<Size, Scalar>& lhs,
  const tarch::la::Vector<Size, Scalar>& rhs,
  const Scalar                           tolerance
) {
  bool result = true;
  for (int i = 0; i < Size; i++) {
    result = result and tarch::la::smaller(lhs(i), rhs(i), tolerance);
  }
  return result;
}

template <int Size, typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD bool
tarch::la::allSmallerEquals(
  const tarch::la::Vector<Size, Scalar>& lhs,
  const tarch::la::Vector<Size, Scalar>& rhs,
  const Scalar                           tolerance
) {
  bool result = true;
  for (int i = 0; i < Size; i++) {
    result = result and tarch::la::smallerEquals(lhs(i), rhs(i), tolerance);
  }
  return result;
}

template <int Size, typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD bool
tarch::la::oneSmaller(
  const tarch::la::Vector<Size, Scalar>& lhs,
  const tarch::la::Vector<Size, Scalar>& rhs,
  const Scalar                           tolerance
) {
  for (int i = 0; i < Size; i++) {
    if (tarch::la::smaller(lhs(i), rhs(i), tolerance)) {
      return true;
    }
  }
  return false;
}

template <int Size, typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD bool
tarch::la::oneSmallerEquals(
  const tarch::la::Vector<Size, Scalar>& lhs,
  const tarch::la::Vector<Size, Scalar>& rhs,
  const Scalar                           tolerance
) {
  for (int i = 0; i < Size; i++) {
    if (tarch::la::smallerEquals(lhs(i), rhs(i), tolerance)) {
      return true;
    }
  }
  return false;
}

/** Compares the components exactly. A floating-point vector compares within a tolerance through equals(). */
template <int Size, typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD bool
tarch::la::operator==(const tarch::la::Vector<Size, Scalar>& lhs, const tarch::la::Vector<Size, Scalar>& rhs) {
  for (int i = 0; i < Size; i++) {
    if (lhs(i) != rhs(i)) {
      return false;
    }
  }
  return true;
}

template <int Size, typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD bool
tarch::la::operator!=(const tarch::la::Vector<Size, Scalar>& lhs, const tarch::la::Vector<Size, Scalar>& rhs) {
  return not(lhs == rhs);
}

/**
 * Returns the index of the first component pair that differs by more than tolerance, or -1. A NaN
 * component always differs.
 */
template <int Size, typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD int
tarch::la::equalsReturnIndex(
  const tarch::la::Vector<Size, Scalar>& lhs,
  const tarch::la::Vector<Size, Scalar>& rhs,
  const Scalar                           tolerance
) {
  for (int i = 0; i < Size; i++) {
    const bool withinTolerance = std::abs(lhs(i) - rhs(i)) <= tolerance;
    if (not withinTolerance) {
      return i;
    }
  }
  return -1;
}

template <int Size>
INLINE_METHOD GPU_CALLABLE_METHOD int
tarch::la::equalsReturnIndex(const tarch::la::Vector<Size, int>& lhs, const tarch::la::Vector<Size, int>& rhs) {
  for (int i = 0; i < Size; i++) {
    if (lhs(i) != rhs(i)) {
      return i;
    }
  }
  return -1;
}
TARGET_DECLARE_END
