TARGET_DECLARE
template <typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD tarch::la::Vector<4, Scalar>::Vector(const Scalar* const values) :
  _values{values[0], values[1], values[2], values[3]} {}

template <typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD constexpr tarch::la::Vector<4, Scalar>::Vector(
  const std::initializer_list<Scalar> values
) {
  auto p = values.begin();
  if (p != values.end()) {
    _values[0] = *p;
    p++;
  }
  if (p != values.end()) {
    _values[1] = *p;
    p++;
  }
  if (p != values.end()) {
    _values[2] = *p;
    p++;
  }
  if (p != values.end()) {
    _values[3] = *p;
  }
}

template <typename Scalar>
INLINE_METHOD tarch::la::Vector<4, Scalar>::Vector(const std::bitset<4>& values) :
  _values{
    values[0] ? Scalar(1) : Scalar(0),
    values[1] ? Scalar(1) : Scalar(0),
    values[2] ? Scalar(1) : Scalar(0),
    values[3] ? Scalar(1) : Scalar(0)
  } {}

template <typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD tarch::la::Vector<4, Scalar>::Vector(const Scalar& initialValue) :
  _values{initialValue, initialValue, initialValue, initialValue} {}

template <typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD int
tarch::la::Vector<4, Scalar>::getSize() const {
  return 4;
}

template <typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD const Scalar&
tarch::la::Vector<4, Scalar>::operator[](const int index) const {
  assertion(index >= 0, index, 4, ::toString(*this));
  assertion(index < 4, index, 4, ::toString(*this));
  return _values[index];
}

template <typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD Scalar&
tarch::la::Vector<4, Scalar>::operator[](const int index) {
  assertion(index >= 0, index, 4, ::toString(*this));
  assertion(index < 4, index, 4, ::toString(*this));
  return _values[index];
}

template <typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD const Scalar&
tarch::la::Vector<4, Scalar>::operator()(const int index) const {
  return (*this)[index];
}

template <typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD Scalar&
tarch::la::Vector<4, Scalar>::operator()(const int index) {
  return (*this)[index];
}

template <typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD Scalar*
tarch::la::Vector<4, Scalar>::getData() {
  return _values;
}

template <typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD const Scalar*
tarch::la::Vector<4, Scalar>::getData() const {
  return _values;
}
TARGET_DECLARE_END
