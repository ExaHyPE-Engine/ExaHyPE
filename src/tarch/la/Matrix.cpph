TARGET_DECLARE
template <int Rows, int Cols, typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD tarch::la::Matrix<Rows, Cols, Scalar>
tarch::la::buildMatrix(const Scalar* values) {
  tarch::la::Matrix<Rows, Cols, Scalar> result;
  std::memcpy(result.getData(), values, sizeof(Scalar) * Rows * Cols);
  return result;
}

template <int Rows, int Cols, typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD tarch::la::Matrix<Rows, Cols, Scalar>::Matrix() :
  _values() {}

template <int Rows, int Cols, typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD tarch::la::Matrix<Rows, Cols, Scalar>::Matrix(const Scalar& initialValue) {
  for (int i = 0; i < Rows * Cols; i++) {
    _values[i] = initialValue;
  }
}

template <int Rows, int Cols, typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD tarch::la::Matrix<Rows, Cols, Scalar>::Matrix(std::initializer_list<Scalar> values) {
  int index = 0;
  for (typename std::initializer_list<Scalar>::const_iterator p = values.begin(); p != values.end(); p++) {
    _values[index] = *p;
    index++;
  }
}

template <int Rows, int Cols, typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD int
tarch::la::Matrix<Rows, Cols, Scalar>::getNumberOfRows() const {
  return Rows;
}

template <int Rows, int Cols, typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD int
tarch::la::Matrix<Rows, Cols, Scalar>::getNumberOfColumns() const {
  return Cols;
}

template <int Rows, int Cols, typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD int
tarch::la::Matrix<Rows, Cols, Scalar>::getSize() const {
  return Rows * Cols;
}

template <int Rows, int Cols, typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD Scalar&
tarch::la::Matrix<Rows, Cols, Scalar>::operator()(int rowIndex, int colIndex) {
  assertion(rowIndex >= 0, Rows, Cols, rowIndex, colIndex, toString());
  assertion(colIndex >= 0, Rows, Cols, rowIndex, colIndex, toString());
  assertion(rowIndex < Rows, Rows, Cols, rowIndex, colIndex, toString());
  assertion(colIndex < Cols, Rows, Cols, rowIndex, colIndex, toString());
  return _values[rowIndex * Cols + colIndex];
}

template <int Rows, int Cols, typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD const Scalar&
tarch::la::Matrix<Rows, Cols, Scalar>::operator()(int rowIndex, int colIndex) const {
  assertion(rowIndex >= 0, Rows, Cols, rowIndex, colIndex, toString());
  assertion(colIndex >= 0, Rows, Cols, rowIndex, colIndex, toString());
  assertion(rowIndex < Rows, Rows, Cols, rowIndex, colIndex, toString());
  assertion(colIndex < Cols, Rows, Cols, rowIndex, colIndex, toString());
  return _values[rowIndex * Cols + colIndex];
}

template <int Rows, int Cols, typename Scalar>
std::string
tarch::la::Matrix<Rows, Cols, Scalar>::toString() const {
  std::ostringstream os;
  os << "[";
  for (int i = 0; i < Rows; i++) {
    os << "[";
    for (int j = 0; j < Cols; j++) {
      os << getData()[i * Cols + j];
      if (j + 1 < Cols) {
        os << ",";
      }
    }
    os << "]";
    if (i + 1 < Rows) {
      os << ",";
    }
  }
  os << "]";
  return os.str();
}

template <int Rows, int Cols, typename Scalar>
std::string
tarch::la::Matrix<Rows, Cols, Scalar>::toPrettyString(int numberOfDigits) const {
  std::ostringstream os;
  os << "[";
  os << std::setiosflags(std::ios::fixed) << std::setprecision(numberOfDigits);
  for (int i = 0; i < Rows; i++) {
    os << std::endl;
    for (int j = 0; j < Cols; j++) {
      if (tarch::la::abs(getData()[i * Cols + j]) >= 0.0) {
        os << " ";
      }
      os << getData()[i * Cols + j];
      if (j + 1 < Cols) {
        os << ", ";
      }
    }
    if (i + 1 < Rows) {
      os << ",";
    }
  }
  os << std::endl;
  os << "]";
  return os.str();
}

template <int Rows, int Cols, typename Scalar>
template <typename NewScalarType>
INLINE_METHOD GPU_CALLABLE_METHOD tarch::la::Matrix<Rows, Cols, NewScalarType>
tarch::la::Matrix<Rows, Cols, Scalar>::convertScalar() const {
  tarch::la::Matrix<Rows, Cols, NewScalarType> result;
  for (int i = 0; i < Rows; i++) {
    for (int j = 0; j < Cols; j++) {
      result(i, j) = operator()(i, j);
    }
  }
  return result;
}

template <int Rows, int Cols, typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD Scalar*
tarch::la::Matrix<Rows, Cols, Scalar>::getData() {
  return _values;
}

template <int Rows, int Cols, typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD const Scalar*
tarch::la::Matrix<Rows, Cols, Scalar>::getData() const {
  return _values;
}
TARGET_DECLARE_END
