template <int Size, typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD tarch::la::Vector<Size, Scalar>::Vector():
  _values{} {}

template <int Size, typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD tarch::la::Vector<Size, Scalar>::Vector(const Scalar* values) {
  for (int i = 0; i < Size; i++) {
    _values[i] = *(values + i);
  }
}

template <int Size, typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD tarch::la::Vector<Size, Scalar>::Vector(std::initializer_list<Scalar> values) {
  int index = 0;
  for (typename std::initializer_list<Scalar>::const_iterator p = values.begin(); p != values.end(); p++) {
    if (index < Size) {
      _values[index] = *p;
      index++;
    }
  }
}

template <int Size, typename Scalar>
INLINE_METHOD tarch::la::Vector<Size, Scalar>::Vector(const std::bitset<Size>& value) {
  for (int i = 0; i < Size; i++) {
    _values[i] = value[i] ? Scalar(1) : Scalar(0);
  }
}

template <int Size, typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD tarch::la::Vector<Size, Scalar>::Vector(const Scalar& initialValue):
  _values() {
  for (int i = 0; i < Size; i++) {
    _values[i] = initialValue;
  }
}

template <int Size, typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD int tarch::la::Vector<Size, Scalar>::size() const {
  return Size;
}

template <int Size, typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD const Scalar& tarch::la::Vector<Size, Scalar>::operator[](int index) const {
  assertion(index >= 0, index, Size, ::toString(*this));
  assertion(index < Size, index, Size, ::toString(*this));
  return _values[index];
}

template <int Size, typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD Scalar& tarch::la::Vector<Size, Scalar>::operator[](int index) {
  assertion(index >= 0, index, Size, ::toString(*this));
  assertion(index < Size, index, Size, ::toString(*this));
  return _values[index];
}

template <int Size, typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD const Scalar& tarch::la::Vector<Size, Scalar>::operator()(int index) const {
  assertion(index >= 0, index, Size, ::toString(*this));
  assertion(index < Size, index, Size, ::toString(*this));
  return _values[index];
}

template <int Size, typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD Scalar& tarch::la::Vector<Size, Scalar>::operator()(int index) {
  assertion(index >= 0, index, Size, ::toString(*this));
  assertion(index < Size, index, Size, ::toString(*this));
  return _values[index];
}

template <int Size, typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD Scalar* tarch::la::Vector<Size, Scalar>::data() {
  return _values;
}

template <int Size, typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD const Scalar* tarch::la::Vector<Size, Scalar>::data() const {
  return _values;
}

template <int Size, typename Scalar>
std::string toString(const tarch::la::Vector<Size, Scalar>& vector) {
  std::ostringstream os;
  os << "[";
  for (int i = 0; i < Size; i++) {
    os << vector(i);
    if (i + 1 < Size) {
      os << ",";
    }
  }
  os << "]";
  return os.str();
}

template <typename NewScalarType, int Size, typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD tarch::la::Vector<Size, NewScalarType> tarch::la::convertScalar(
  const tarch::la::Vector<Size, Scalar>& vector
) {
  tarch::la::Vector<Size, NewScalarType> result;
  for (int i = 0; i < Size; i++) {
    result(i) = static_cast<NewScalarType>(vector(i));
  }
  return result;
}
