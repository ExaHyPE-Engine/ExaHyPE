template <int Size, typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD tarch::la::Vector<Size, Scalar>& tarch::la::operator*=(
  Vector<Size, Scalar>& vector,
  const Scalar&         scalar
) {
  for (int i = 0; i < Size; i++) {
    vector(i) *= scalar;
  }
  return vector;
}

template <typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD tarch::la::Vector<2, Scalar>& tarch::la::operator*=(
  Vector<2, Scalar>& vector,
  const Scalar&      scalar
) {
  vector._values[0] *= scalar;
  vector._values[1] *= scalar;
  return vector;
}

template <typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD tarch::la::Vector<3, Scalar>& tarch::la::operator*=(
  Vector<3, Scalar>& vector,
  const Scalar&      scalar
) {
  vector._values[0] *= scalar;
  vector._values[1] *= scalar;
  vector._values[2] *= scalar;
  return vector;
}

template <typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD tarch::la::Vector<4, Scalar>& tarch::la::operator*=(
  Vector<4, Scalar>& vector,
  const Scalar&      scalar
) {
  vector._values[0] *= scalar;
  vector._values[1] *= scalar;
  vector._values[2] *= scalar;
  vector._values[3] *= scalar;
  return vector;
}

template <int Size, typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD tarch::la::Vector<Size, Scalar> tarch::la::remainder(
  const Vector<Size, Scalar>& vector,
  double                      h
) {
  Vector<Size, Scalar> result = vector;
  for (int i = 0; i < Size; i++) {
    result(i) *= vector(i) - std::floor(vector(i) / h) * h;
  }
  return result;
}

template <int Size, typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD tarch::la::Vector<Size, Scalar>& tarch::la::operator/=(
  Vector<Size, Scalar>& vector,
  const Scalar&         scalar
) {
  for (int i = 0; i < Size; i++) {
    vector(i) /= scalar;
  }
  return vector;
}

template <typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD tarch::la::Vector<2, Scalar>& tarch::la::operator/=(
