  return lhs._values[0] - cmp <= -tolerance || lhs._values[1] - cmp <= -tolerance || lhs._values[2] - cmp <= -tolerance
         || lhs._values[3] - cmp <= -tolerance;
}

template <int Size, typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD bool tarch::la::
  allGreater(const Vector<Size, Scalar>& lhs, const Scalar& cmp, const Scalar tolerance) {
  bool result = true;
  for (int i = 0; i < Size; i++) {
    result = result && greater(lhs(i), cmp, tolerance);
  }
  return result;
}

template <typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD bool tarch::la::
  allGreater(const Vector<2, Scalar>& lhs, const Scalar& cmp, const Scalar tolerance) {
  return greater(lhs._values[0], cmp, tolerance) && greater(lhs._values[1], cmp, tolerance);
}

template <typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD bool tarch::la::
  allGreater(const Vector<3, Scalar>& lhs, const Scalar& cmp, const Scalar tolerance) {
  return greater(lhs._values[0], cmp, tolerance) && greater(lhs._values[1], cmp, tolerance)
         && greater(lhs._values[2], cmp, tolerance);
}

template <typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD bool tarch::la::
  allGreater(const Vector<4, Scalar>& lhs, const Scalar& cmp, const Scalar tolerance) {
  return greater(lhs._values[0], cmp, tolerance) && greater(lhs._values[1], cmp, tolerance)
         && greater(lhs._values[2], cmp, tolerance) && greater(lhs._values[3], cmp, tolerance);
}

template <int Size, typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD bool tarch::la::
  allGreaterEquals(const Vector<Size, Scalar>& lhs, const Scalar& cmp, const Scalar tolerance) {
  bool result = true;
  for (int i = 0; i < Size; i++) {
    result = result && greaterEquals(lhs(i), cmp, tolerance);
  }
  return result;
}

template <typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD bool tarch::la::
  allGreaterEquals(const Vector<2, Scalar>& lhs, const Scalar& cmp, const Scalar tolerance) {
  return greaterEquals(lhs._values[0], cmp, tolerance) && greaterEquals(lhs._values[1], cmp, tolerance);
}

