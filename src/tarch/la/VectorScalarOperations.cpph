#include "tarch/Assertions.h"
#include "tarch/la/ScalarOperations.h"

TARGET_DECLARE
template <int Size, typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD tarch::la::Vector<Size, Scalar>&
tarch::la::operator*=(tarch::la::Vector<Size, Scalar>& vector, const Scalar& scalar) {
  for (int i = 0; i < Size; i++) {
    vector(i) *= scalar;
  }
  return vector;
}

template <typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD tarch::la::Vector<2, Scalar>&
tarch::la::operator*=(tarch::la::Vector<2, Scalar>& vector, const Scalar& scalar) {
  vector._values[0] *= scalar;
  vector._values[1] *= scalar;
  return vector;
}

template <typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD tarch::la::Vector<3, Scalar>&
tarch::la::operator*=(tarch::la::Vector<3, Scalar>& vector, const Scalar& scalar) {
  vector._values[0] *= scalar;
  vector._values[1] *= scalar;
  vector._values[2] *= scalar;
  return vector;
}

template <typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD tarch::la::Vector<4, Scalar>&
tarch::la::operator*=(tarch::la::Vector<4, Scalar>& vector, const Scalar& scalar) {
  vector._values[0] *= scalar;
  vector._values[1] *= scalar;
  vector._values[2] *= scalar;
  vector._values[3] *= scalar;
  return vector;
}

/**
 * Returns every component of vector minus the largest multiple of h that does not exceed it.
 */
template <int Size, typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD tarch::la::Vector<Size, Scalar>
tarch::la::remainder(const tarch::la::Vector<Size, Scalar>& vector, const double h) {
  ASSERTION(h > 0.0, h);
  tarch::la::Vector<Size, Scalar> result;
  for (int i = 0; i < Size; i++) {
    result(i) = vector(i) - std::floor(vector(i) / h) * h;
  }
  return result;
}

template <int Size, typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD tarch::la::Vector<Size, Scalar>&
tarch::la::operator/=(tarch::la::Vector<Size, Scalar>& vector, const Scalar& scalar) {
  ASSERTION(scalar != Scalar{0});
  for (int i = 0; i < Size; i++) {
    vector(i) /= scalar;
  }
  return vector;
}

template <typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD tarch::la::Vector<2, Scalar>&
tarch::la::operator/=(tarch::la::Vector<2, Scalar>& vector, const Scalar& scalar) {
  ASSERTION(scalar != Scalar{0});
  vector._values[0] /= scalar;
  vector._values[1] /= scalar;
  return vector;
}

template <typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD tarch::la::Vector<3, Scalar>&
tarch::la::operator/=(tarch::la::Vector<3, Scalar>& vector, const Scalar& scalar) {
  ASSERTION(scalar != Scalar{0});
  vector._values[0] /= scalar;
  vector._values[1] /= scalar;
  vector._values[2] /= scalar;
