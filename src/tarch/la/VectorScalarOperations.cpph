template <int Size, typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD bool tarch::la::
  oneSmallerEquals(const Vector<Size, Scalar>& lhs, const Scalar& cmp, const Scalar tolerance) {
#ifdef CompilerICC
  bool result = false;
  for (int i = 0; i < Size; i++) {
    if (lhs(i) - cmp <= -tolerance) {
      result = true;
    }
  }
  return result;
#else
  for (int i = 0; i < Size; i++) {
    if (lhs(i) - cmp <= -tolerance) {
