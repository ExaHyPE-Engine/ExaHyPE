template <int Size, typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD bool tarch::la::
  equals(const Vector<Size, Scalar>& lhs, const Scalar& cmp, const Scalar tolerance) {
#ifdef CompilerICC
  bool result = true;
  for (int i = 0; i < Size; i++) {
    if (la::abs(lhs(i) - cmp) > tolerance) {
      result = false;
    }
  }
  return result;
#else
  for (int i = 0; i < Size; i++) {
    if (la::abs(lhs(i) - cmp) > tolerance) {
      return false;
    }
  }
  return true;
#endif
}

template <typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD bool tarch::la::
  equals(const Vector<2, Scalar>& lhs, const Scalar& cmp, const Scalar tolerance) {
  return la::abs(lhs._values[0] - cmp) <= tolerance && la::abs(lhs._values[1] - cmp) <= tolerance;
}

template <typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD bool tarch::la::
  equals(const Vector<3, Scalar>& lhs, const Scalar& cmp, const Scalar tolerance) {
  return la::abs(lhs._values[0] - cmp) <= tolerance && la::abs(lhs._values[1] - cmp) <= tolerance
         && la::abs(lhs._values[2] - cmp) <= tolerance;
}

template <typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD bool tarch::la::
  equals(const Vector<4, Scalar>& lhs, const Scalar& cmp, const Scalar tolerance) {
  return la::abs(lhs._values[0] - cmp) <= tolerance && la::abs(lhs._values[1] - cmp) <= tolerance
         && la::abs(lhs._values[2] - cmp) <= tolerance && la::abs(lhs._values[3] - cmp) <= tolerance;
}

template <int Size, typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD bool tarch::la::
  oneEquals(const Vector<Size, Scalar>& lhs, const Scalar& cmp, const Scalar tolerance) {
#ifdef CompilerICC
  bool result = false;
  for (int i = 0; i < Size; i++) {
    if (la::abs(lhs(i) - cmp) <= tolerance) {
      result = true;
    }
  }
  return result;
#else
  for (int i = 0; i < Size; i++) {
    if (la::abs(lhs(i) - cmp) <= tolerance) {
      return true;
    }
  }
  return false;
#endif
}

template <typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD bool tarch::la::
  oneEquals(const Vector<2, Scalar>& lhs, const Scalar& cmp, const Scalar tolerance) {
  return la::abs(lhs._values[0] - cmp) <= tolerance || la::abs(lhs._values[1] - cmp) <= tolerance;
}

template <typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD bool tarch::la::
  oneEquals(const Vector<3, Scalar>& lhs, const Scalar& cmp, const Scalar tolerance) {
  return la::abs(lhs._values[0] - cmp) <= tolerance || la::abs(lhs._values[1] - cmp) <= tolerance
         || la::abs(lhs._values[2] - cmp) <= tolerance;
}

template <typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD bool tarch::la::
  oneEquals(const Vector<4, Scalar>& lhs, const Scalar& cmp, const Scalar tolerance) {
  return la::abs(lhs._values[0] - cmp) <= tolerance || la::abs(lhs._values[1] - cmp) <= tolerance
         || la::abs(lhs._values[2] - cmp) <= tolerance || la::abs(lhs._values[3] - cmp) <= tolerance;
}

template <int Size, typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD bool tarch::la::
  oneGreater(const Vector<Size, Scalar>& lhs, const Scalar& cmp, const Scalar tolerance) {
#ifdef CompilerICC
  bool result = false;
  for (int i = 0; i < Size; i++) {
    if (lhs(i) - cmp > tolerance) {
      result = true;
    }
  }
  return result;
#else
  for (int i = 0; i < Size; i++) {
    if (lhs(i) - cmp > tolerance) {
      return true;
    }
  }
  return false;
#endif
}

template <typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD bool tarch::la::
  oneGreater(const Vector<2, Scalar>& lhs, const Scalar& cmp, const Scalar tolerance) {
  return lhs._values[0] - cmp > tolerance || lhs._values[1] - cmp > tolerance;
}

template <typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD bool tarch::la::
  oneGreater(const Vector<3, Scalar>& lhs, const Scalar& cmp, const Scalar tolerance) {
  return lhs._values[0] - cmp > tolerance || lhs._values[1] - cmp > tolerance || lhs._values[2] - cmp > tolerance;
}

template <typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD bool tarch::la::
  oneGreater(const Vector<4, Scalar>& lhs, const Scalar& cmp, const Scalar tolerance) {
  return lhs._values[0] - cmp > tolerance || lhs._values[1] - cmp > tolerance || lhs._values[2] - cmp > tolerance
         || lhs._values[3] - cmp > tolerance;
}

template <int Size, typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD bool tarch::la::
  oneGreaterEquals(const Vector<Size, Scalar>& lhs, const Scalar& cmp, const Scalar tolerance) {
#ifdef CompilerICC
  bool result = false;
  for (int i = 0; i < Size; i++) {
    if (lhs(i) - cmp >= -tolerance) {
      result = true;
    }
  }
  return result;
#else
  for (int i = 0; i < Size; i++) {
    if (lhs(i) - cmp >= -tolerance) {
      return true;
    }
  }
  return false;
#endif
}

template <typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD bool tarch::la::
  oneGreaterEquals(const Vector<2, Scalar>& lhs, const Scalar& cmp, const Scalar tolerance) {
  return lhs._values[0] - cmp >= -tolerance || lhs._values[1] - cmp >= -tolerance;
}

template <typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD bool tarch::la::
  oneGreaterEquals(const Vector<3, Scalar>& lhs, const Scalar& cmp, const Scalar tolerance) {
  return lhs._values[0] - cmp >= -tolerance || lhs._values[1] - cmp >= -tolerance || lhs._values[2] - cmp >= -tolerance;
}

template <typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD bool tarch::la::
  oneGreaterEquals(const Vector<4, Scalar>& lhs, const Scalar& cmp, const Scalar tolerance) {
  return lhs._values[0] - cmp >= -tolerance || lhs._values[1] - cmp >= -tolerance || lhs._values[2] - cmp >= -tolerance
         || lhs._values[3] - cmp >= -tolerance;
}

template <int Size, typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD bool tarch::la::
  oneSmaller(const Vector<Size, Scalar>& lhs, const Scalar& cmp, const Scalar tolerance) {
#ifdef CompilerICC
  bool result = false;
  for (int i = 0; i < Size; i++) {
    if (lhs(i) - cmp < tolerance) {
      result = true;
    }
  }
  return result;
#else
  for (int i = 0; i < Size; i++) {
    if (lhs(i) - cmp < tolerance) {
      return true;
    }
