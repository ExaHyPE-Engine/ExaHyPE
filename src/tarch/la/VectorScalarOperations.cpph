template <int Size, typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD tarch::la::Vector<Size, Scalar>
tarch::la::operator/(const tarch::la::Vector<Size, Scalar>& vector, const Scalar& scalar) {
  ASSERTION(scalar != Scalar{0});
  tarch::la::Vector<Size, Scalar> result;
  for (int i = 0; i < Size; i++) {
    result(i) = vector(i) / scalar;
  }
  return result;
}

template <typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD tarch::la::Vector<2, Scalar>
tarch::la::operator/(const tarch::la::Vector<2, Scalar>& vector, const Scalar& scalar) {
  ASSERTION(scalar != Scalar{0});
  return tarch::la::makeVector<Scalar>(vector._values[0] / scalar, vector._values[1] / scalar);
}

