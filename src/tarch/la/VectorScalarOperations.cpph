/**
 * Returns whether every component of lhs lies within tolerance of cmp. A NaN component never does.
 */
template <int Size, typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD bool
tarch::la::equals(const tarch::la::Vector<Size, Scalar>& lhs, const Scalar& cmp, const Scalar tolerance) {
  for (int i = 0; i < Size; i++) {
    const bool withinTolerance = tarch::la::abs(lhs(i) - cmp) <= tolerance;
    if (not withinTolerance) {
      return false;
    }
  }
  return true;
}

template <typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD bool
tarch::la::equals(const tarch::la::Vector<2, Scalar>& lhs, const Scalar& cmp, const Scalar tolerance) {
  return tarch::la::abs(lhs._values[0] - cmp) <= tolerance and tarch::la::abs(lhs._values[1] - cmp) <= tolerance;
}

template <typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD bool
tarch::la::equals(const tarch::la::Vector<3, Scalar>& lhs, const Scalar& cmp, const Scalar tolerance) {
  return tarch::la::abs(lhs._values[0] - cmp) <= tolerance and tarch::la::abs(lhs._values[1] - cmp) <= tolerance
    and tarch::la::abs(lhs._values[2] - cmp) <= tolerance;
}

template <typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD bool
tarch::la::equals(const tarch::la::Vector<4, Scalar>& lhs, const Scalar& cmp, const Scalar tolerance) {
  return tarch::la::abs(lhs._values[0] - cmp) <= tolerance and tarch::la::abs(lhs._values[1] - cmp) <= tolerance
    and tarch::la::abs(lhs._values[2] - cmp) <= tolerance and tarch::la::abs(lhs._values[3] - cmp) <= tolerance;
}

template <int Size, typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD bool
tarch::la::oneEquals(const tarch::la::Vector<Size, Scalar>& lhs, const Scalar& cmp, const Scalar tolerance) {
  for (int i = 0; i < Size; i++) {
    if (tarch::la::abs(lhs(i) - cmp) <= tolerance) {
      return true;
    }
  }
  return false;
}

template <typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD bool
tarch::la::oneEquals(const tarch::la::Vector<2, Scalar>& lhs, const Scalar& cmp, const Scalar tolerance) {
  return tarch::la::abs(lhs._values[0] - cmp) <= tolerance or tarch::la::abs(lhs._values[1] - cmp) <= tolerance;
}

template <typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD bool
tarch::la::oneEquals(const tarch::la::Vector<3, Scalar>& lhs, const Scalar& cmp, const Scalar tolerance) {
  return tarch::la::abs(lhs._values[0] - cmp) <= tolerance or tarch::la::abs(lhs._values[1] - cmp) <= tolerance
    or tarch::la::abs(lhs._values[2] - cmp) <= tolerance;
}

template <typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD bool
tarch::la::oneEquals(const tarch::la::Vector<4, Scalar>& lhs, const Scalar& cmp, const Scalar tolerance) {
  return tarch::la::abs(lhs._values[0] - cmp) <= tolerance or tarch::la::abs(lhs._values[1] - cmp) <= tolerance
    or tarch::la::abs(lhs._values[2] - cmp) <= tolerance or tarch::la::abs(lhs._values[3] - cmp) <= tolerance;
}

template <int Size, typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD bool
tarch::la::oneGreater(const tarch::la::Vector<Size, Scalar>& lhs, const Scalar& cmp, const Scalar tolerance) {
  for (int i = 0; i < Size; i++) {
    if (lhs(i) - cmp > tolerance) {
      return true;
    }
  }
  return false;
}

template <typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD bool
tarch::la::oneGreater(const tarch::la::Vector<2, Scalar>& lhs, const Scalar& cmp, const Scalar tolerance) {
  return lhs._values[0] - cmp > tolerance or lhs._values[1] - cmp > tolerance;
}

