template <int Size, typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD tarch::la::Vector<Size, Scalar> tarch::la::operator-(
  const Vector<Size, Scalar>& vector,
  const Scalar&               scalar
) {
  Vector<Size, Scalar> result;
  for (int i = 0; i < Size; i++) {
    result(i) = vector(i) - scalar;
  }
  return result;
}

template <typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD tarch::la::Vector<2, Scalar> tarch::la::operator-(
  const Vector<2, Scalar>& vector,
  const Scalar&            scalar
) {
