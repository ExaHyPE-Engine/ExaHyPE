template <int Size, typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD bool tarch::la::
  allSmaller(const Vector<Size, Scalar>& lhs, const Scalar& cmp, const Scalar tolerance) {
  bool result = true;
  for (int i = 0; i < Size; i++) {
    result = result && smaller(lhs(i), cmp, tolerance);
  }
  return result;
}

template <typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD bool tarch::la::
  allSmaller(const Vector<2, Scalar>& lhs, const Scalar& cmp, const Scalar tolerance) {
  return smaller(lhs._values[0], cmp, tolerance) && smaller(lhs._values[1], cmp, tolerance);
}

template <typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD bool tarch::la::
  allSmaller(const Vector<3, Scalar>& lhs, const Scalar& cmp, const Scalar tolerance) {
  return smaller(lhs._values[0], cmp, tolerance) && smaller(lhs._values[1], cmp, tolerance)
         && smaller(lhs._values[2], cmp, tolerance);
}

template <typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD bool tarch::la::
  allSmaller(const Vector<4, Scalar>& lhs, const Scalar& cmp, const Scalar tolerance) {
  return smaller(lhs._values[0], cmp, tolerance) && smaller(lhs._values[1], cmp, tolerance)
         && smaller(lhs._values[2], cmp, tolerance) && smaller(lhs._values[3], cmp, tolerance);
}

template <int Size, typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD bool tarch::la::
  allSmallerEquals(const Vector<Size, Scalar>& lhs, const Scalar& cmp, const Scalar tolerance) {
  bool result = true;
  for (int i = 0; i < Size; i++) {
    result = result && smallerEquals(lhs(i), cmp, tolerance);
  }
  return result;
}

template <typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD bool tarch::la::
  allSmallerEquals(const Vector<2, Scalar>& lhs, const Scalar& cmp, const Scalar tolerance) {
  return smallerEquals(lhs._values[0], cmp, tolerance) && smallerEquals(lhs._values[1], cmp, tolerance);
}

template <typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD bool tarch::la::
  allSmallerEquals(const Vector<3, Scalar>& lhs, const Scalar& cmp, const Scalar tolerance) {
  return smallerEquals(lhs._values[0], cmp, tolerance) && smallerEquals(lhs._values[1], cmp, tolerance)
         && smallerEquals(lhs._values[2], cmp, tolerance);
}

template <typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD bool tarch::la::
  allSmallerEquals(const Vector<4, Scalar>& lhs, const Scalar& cmp, const Scalar tolerance) {
  return smallerEquals(lhs._values[0], cmp, tolerance) && smallerEquals(lhs._values[1], cmp, tolerance)
         && smallerEquals(lhs._values[2], cmp, tolerance) && smallerEquals(lhs._values[3], cmp, tolerance);
}
