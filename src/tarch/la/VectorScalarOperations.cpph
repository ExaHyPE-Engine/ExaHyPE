template <int Size, typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD bool
tarch::la::allGreater(const tarch::la::Vector<Size, Scalar>& lhs, const Scalar& cmp, const Scalar tolerance) {
  bool result = true;
  for (int i = 0; i < Size; i++) {
    result = result and tarch::la::greater(lhs(i), cmp, tolerance);
  }
  return result;
}

template <typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD bool
tarch::la::allGreater(const tarch::la::Vector<2, Scalar>& lhs, const Scalar& cmp, const Scalar tolerance) {
  return tarch::la::greater(lhs._values[0], cmp, tolerance) and tarch::la::greater(lhs._values[1], cmp, tolerance);
}

template <typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD bool
tarch::la::allGreater(const tarch::la::Vector<3, Scalar>& lhs, const Scalar& cmp, const Scalar tolerance) {
  return tarch::la::greater(lhs._values[0], cmp, tolerance) and tarch::la::greater(lhs._values[1], cmp, tolerance)
    and tarch::la::greater(lhs._values[2], cmp, tolerance);
}

template <typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD bool
tarch::la::allGreater(const tarch::la::Vector<4, Scalar>& lhs, const Scalar& cmp, const Scalar tolerance) {
  return tarch::la::greater(lhs._values[0], cmp, tolerance) and tarch::la::greater(lhs._values[1], cmp, tolerance)
    and tarch::la::greater(lhs._values[2], cmp, tolerance) and tarch::la::greater(lhs._values[3], cmp, tolerance);
}

template <int Size, typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD bool
tarch::la::allGreaterEquals(const tarch::la::Vector<Size, Scalar>& lhs, const Scalar& cmp, const Scalar tolerance) {
  bool result = true;
  for (int i = 0; i < Size; i++) {
    result = result and tarch::la::greaterEquals(lhs(i), cmp, tolerance);
  }
  return result;
}

template <typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD bool
tarch::la::allGreaterEquals(const tarch::la::Vector<2, Scalar>& lhs, const Scalar& cmp, const Scalar tolerance) {
  return tarch::la::greaterEquals(lhs._values[0], cmp, tolerance)
    and tarch::la::greaterEquals(lhs._values[1], cmp, tolerance);
}

template <typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD bool
tarch::la::allGreaterEquals(const tarch::la::Vector<3, Scalar>& lhs, const Scalar& cmp, const Scalar tolerance) {
  return tarch::la::greaterEquals(lhs._values[0], cmp, tolerance)
    and tarch::la::greaterEquals(lhs._values[1], cmp, tolerance)
    and tarch::la::greaterEquals(lhs._values[2], cmp, tolerance);
}

template <typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD bool
tarch::la::allGreaterEquals(const tarch::la::Vector<4, Scalar>& lhs, const Scalar& cmp, const Scalar tolerance) {
  return tarch::la::greaterEquals(lhs._values[0], cmp, tolerance)
    and tarch::la::greaterEquals(lhs._values[1], cmp, tolerance)
    and tarch::la::greaterEquals(lhs._values[2], cmp, tolerance)
    and tarch::la::greaterEquals(lhs._values[3], cmp, tolerance);
}

template <int Size, typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD bool
tarch::la::allSmaller(const tarch::la::Vector<Size, Scalar>& lhs, const Scalar& cmp, const Scalar tolerance) {
  bool result = true;
  for (int i = 0; i < Size; i++) {
    result = result and tarch::la::smaller(lhs(i), cmp, tolerance);
  }
  return result;
}

template <typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD bool
tarch::la::allSmaller(const tarch::la::Vector<2, Scalar>& lhs, const Scalar& cmp, const Scalar tolerance) {
  return tarch::la::smaller(lhs._values[0], cmp, tolerance) and tarch::la::smaller(lhs._values[1], cmp, tolerance);
}

template <typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD bool
tarch::la::allSmaller(const tarch::la::Vector<3, Scalar>& lhs, const Scalar& cmp, const Scalar tolerance) {
  return tarch::la::smaller(lhs._values[0], cmp, tolerance) and tarch::la::smaller(lhs._values[1], cmp, tolerance)
    and tarch::la::smaller(lhs._values[2], cmp, tolerance);
}

template <typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD bool
tarch::la::allSmaller(const tarch::la::Vector<4, Scalar>& lhs, const Scalar& cmp, const Scalar tolerance) {
  return tarch::la::smaller(lhs._values[0], cmp, tolerance) and tarch::la::smaller(lhs._values[1], cmp, tolerance)
    and tarch::la::smaller(lhs._values[2], cmp, tolerance) and tarch::la::smaller(lhs._values[3], cmp, tolerance);
}

template <int Size, typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD bool
tarch::la::allSmallerEquals(const tarch::la::Vector<Size, Scalar>& lhs, const Scalar& cmp, const Scalar tolerance) {
  bool result = true;
  for (int i = 0; i < Size; i++) {
    result = result and tarch::la::smallerEquals(lhs(i), cmp, tolerance);
  }
  return result;
}

template <typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD bool
tarch::la::allSmallerEquals(const tarch::la::Vector<2, Scalar>& lhs, const Scalar& cmp, const Scalar tolerance) {
  return tarch::la::smallerEquals(lhs._values[0], cmp, tolerance)
    and tarch::la::smallerEquals(lhs._values[1], cmp, tolerance);
}

template <typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD bool
tarch::la::allSmallerEquals(const tarch::la::Vector<3, Scalar>& lhs, const Scalar& cmp, const Scalar tolerance) {
  return tarch::la::smallerEquals(lhs._values[0], cmp, tolerance)
    and tarch::la::smallerEquals(lhs._values[1], cmp, tolerance)
    and tarch::la::smallerEquals(lhs._values[2], cmp, tolerance);
}

template <typename Scalar>
INLINE_METHOD GPU_CALLABLE_METHOD bool
tarch::la::allSmallerEquals(const tarch::la::Vector<4, Scalar>& lhs, const Scalar& cmp, const Scalar tolerance) {
  return tarch::la::smallerEquals(lhs._values[0], cmp, tolerance)
    and tarch::la::smallerEquals(lhs._values[1], cmp, tolerance)
    and tarch::la::smallerEquals(lhs._values[2], cmp, tolerance)
    and tarch::la::smallerEquals(lhs._values[3], cmp, tolerance);
