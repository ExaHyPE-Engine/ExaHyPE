template <int Rows, int Cols, typename Scalar>
INLINE_METHOD void tarch::la::
  modifiedGramSchmidt(Matrix<Rows, Cols, Scalar> A, Matrix<Rows, Cols, Scalar>& Q, Matrix<Cols, Cols, Scalar>& R) {
  for (int i = 0; i < Rows; i++) {
    Q(i, 0) = A(i, 0);
  }

  for (int k = 0; k < Cols; k++) {
    R(k, k) = 0.0;
    for (int i = 0; i < Rows; i++) {
      R(k, k) += std::pow(A(i, k), 2);
    }
    if (tarch::la::greater(R(k, k), Scalar(0.0))) {
      R(k, k) = std::sqrt(R(k, k));

      for (int i = 0; i < Rows; i++) {
        Q(i, k) = A(i, k) / R(k, k);
      }
    }

    for (int j = k + 1; j < Cols; j++) {
      for (int i = 0; i < Rows; i++) {
        R(k, j) += Q(i, k) * A(i, j);
      }
      for (int i = 0; i < Rows; i++) {
        A(i, j) -= Q(i, k) * R(k, j);
      }
    }
  }
}
