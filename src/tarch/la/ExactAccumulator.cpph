/**
 * Adds one finite double to the running sum without any rounding.
 *
 * The accumulator holds the exact sum as a fixed-point number spanning the whole
 * double range, so additions commute and associate like real numbers and the
 * rounded result cannot depend on the order in which values arrive. Each limb
 * keeps 32 value bits inside a signed 64-bit integer, which leaves headroom for
 * more than two billion additions between two clear() calls before a carry could
 * be lost. The mantissa of the incoming value touches at most three limbs.
 */
INLINE_METHOD void tarch::la::ExactAccumulator::add(double value) {
  assertion(std::isfinite(value));
  const auto bits           = std::bit_cast<std::uint64_t>(value);
  const auto biasedExponent = static_cast<int>((bits >> 52) & 0x7ff);
  auto       mantissa       = bits & 0x000fffffffffffffULL;
  if (biasedExponent != 0) {
    mantissa |= 0x0010000000000000ULL;
  }
  if (mantissa == 0) {
    return;
  }
  const auto position = (biasedExponent == 0 ? 1 : biasedExponent) - 1;
  const auto limb     = position / BitsPerLimb;
  const auto offset   = position % BitsPerLimb;
  const auto sign     = (bits >> 63) != 0 ? std::int64_t{-1} : std::int64_t{1};

  const auto low    = static_cast<std::int64_t>((mantissa << offset) & LimbMask);
  const auto middle = static_cast<std::int64_t>((mantissa >> (BitsPerLimb - offset)) & LimbMask);
  const auto high   = offset == 0 ? std::int64_t{0} : static_cast<std::int64_t>(mantissa >> (2 * BitsPerLimb - offset));

  _limbs[limb] += sign * low;
  _limbs[limb + 1] += sign * middle;
  _limbs[limb + 2] += sign * high;
}

INLINE_METHOD void tarch::la::ExactAccumulator::clear() { std::fill_n(_limbs, NumberOfLimbs, std::int64_t{0}); }
