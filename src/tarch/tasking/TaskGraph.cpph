INLINE_METHOD void tarch::tasking::spawnTask(
  tarch::tasking::Task* const        task,
  const std::initializer_list<void*> inDependencies,
  const std::initializer_list<void*> outDependencies,
  const tarch::tasking::RunSerial    runSerial
) {
  tarch::tasking::spawnTask(
    task,
    std::span<void* const>(inDependencies.begin(), inDependencies.size()),
    std::span<void* const>(outDependencies.begin(), outDependencies.size()),
    runSerial
  );
}
