/**
 * Counts one check of the running unit test and returns an empty description when actual
 * differs from expected. Two integers compare by value. A negative integer never equals an
 * unsigned one.
 */
template <typename Actual, typename Expected>
std::optional<std::string>
tarch::testing::checkEquals(const Actual& actual, const Expected& expected) {
  if constexpr (StandardInteger<Actual> and StandardInteger<Expected>) {
    return checkCondition(std::cmp_equal(actual, expected));
  } else {
    return checkCondition(static_cast<bool>(actual == expected));
  }
}

/**
 * Counts one check of the running unit test and describes the difference of actual and
 * expected when it exceeds NumericalTolerance. A NaN on either side fails the check.
 */
template <typename Actual, typename Expected>
std::optional<std::string>
tarch::testing::checkNumericalEquals(const Actual& actual, const Expected& expected) {
  const auto difference = std::abs(expected - actual);
  if (not checkCondition(difference <= NumericalTolerance).has_value()) {
    return std::nullopt;
  }
  std::ostringstream description;
  description << "The difference " << std::setprecision(std::numeric_limits<double>::max_digits10) << difference
              << " exceeds the tolerance " << std::setprecision(1) << NumericalTolerance;
  return description.str();
}
