#include "tarch/Assertions.h"

/**
 * Sorts the first size entries of values in ascending order with a heap sort. The heap sort needs
 * neither recursion nor extra memory. A device thread may call it.
 */
template <typename Value>
INLINE_METHOD GPU_CALLABLE_METHOD void
tarch::sortAscending(Value* const values, const int size) {
  assertion(size >= 0, size);
  assertion(size == 0 or values != nullptr, size);

  // Moves the entry at root down the heap of the first end entries until no child is larger.
  const auto siftDown = [values](std::size_t root, const std::size_t end) {
    while (2 * root + 1 < end) {
      std::size_t child = 2 * root + 1;
      if (child + 1 < end and values[child] < values[child + 1]) {
        child++;
      }
      if (not(values[root] < values[child])) {
        return;
      }
      const Value rootValue = values[root];
      values[root]          = values[child];
      values[child]         = rootValue;
      root                  = child;
    }
  };

  const auto count = static_cast<std::size_t>(size);
  for (std::size_t root = count / 2; root > 0; root--) {
    siftDown(root - 1, count);
  }
  for (std::size_t end = count; end > 1; end--) {
    const Value largestValue = values[0];
    values[0]                = values[end - 1];
    values[end - 1]          = largestValue;
    siftDown(0, end - 1);
  }
}
