/**
 * Returns the heap bytes a vector allocates, its unused capacity included.
 */
template <typename Element>
INLINE_METHOD std::size_t
tarch::getAllocatedBytesOf(const std::vector<Element>& elements) {
  // Open MPI defines an MPI handle as a pointer, so Element may be a pointer type.
  return elements.capacity() * sizeof(Element); // NOLINT(bugprone-sizeof-expression)
}

INLINE_METHOD constexpr tarch::MemoryUsageFormat
tarch::chooseMemoryUsageFormat(const unsigned long long bytes) noexcept {
  if (bytes < MiB) {
    return MemoryUsageFormat::KiB;
  } else if (bytes < GiB) {
    return MemoryUsageFormat::MiB;
  } else {
    return MemoryUsageFormat::GiB;
  }
}
