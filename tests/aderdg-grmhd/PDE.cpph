#include "tarch/la/ScalarOperations.h"

TARGET_DECLARE
/**
 * Returns the sum of the three products of the components of left and right. Every order of the
 * axes returns the same bits.
 */
INLINE_METHOD GPU_CALLABLE_METHOD double
tests::exahype2::aderdg::grmhd::getScalarProductOf(const Vector3& left, const Vector3& right) {
  return tarch::la::sumInOrderOfMagnitude(
    tarch::la::productRoundedOnce(left(0), right(0)),
    tarch::la::productRoundedOnce(left(1), right(1)),
    tarch::la::productRoundedOnce(left(2), right(2))
  );
}

/**
 * Returns scale times the cross product of first and second. Every product rounds on its own before
 * the difference. A permutation of the axes returns the permuted result bitwise, negated for an odd
 * permutation.
 */
INLINE_METHOD GPU_CALLABLE_METHOD tests::exahype2::aderdg::grmhd::Vector3
tests::exahype2::aderdg::grmhd::getScaledCrossProductOf(
  const Vector3& first,
  const Vector3& second,
  const double   scale
) {
  Vector3 result;
  for (int axis = 0; axis < 3; axis++) {
    const int    nextAxis   = (axis + 1) % 3;
    const int    otherAxis  = (axis + 2) % 3;
    const double difference = tarch::la::productRoundedOnce(first(nextAxis), second(otherAxis))
      - tarch::la::productRoundedOnce(first(otherAxis), second(nextAxis));
    result(axis) = scale * difference;
  }
  return result;
}

/**
 * Returns the product of matrix and vector. A permutation of the axes returns the permuted product
 * bitwise.
 */
INLINE_METHOD GPU_CALLABLE_METHOD tests::exahype2::aderdg::grmhd::Vector3
tests::exahype2::aderdg::grmhd::multiplyMatrixVector(const Matrix3x3& matrix, const Vector3& vector) {
  Vector3 result;
  for (int row = 0; row < 3; row++) {
    result(row) = getScalarProductOf({matrix(row, 0), matrix(row, 1), matrix(row, 2)}, vector);
  }
  return result;
}

/**
 * Writes the inverse of the symmetric matrix into inverse and returns the determinant of matrix. The
 * determinant is the product of the diagonal entries plus twice the product of the off-diagonal
 * entries minus the sum of every diagonal entry times the square of the off-diagonal entry outside
 * its row and column. A permutation of the axes returns the same determinant and the permuted
 * inverse bitwise.
 */
INLINE_METHOD GPU_CALLABLE_METHOD double
tests::exahype2::aderdg::grmhd::invertMatrix3x3(const Matrix3x3& matrix, Matrix3x3& inverse) {
  ASSERTION(matrix(0, 1) == matrix(1, 0) and matrix(0, 2) == matrix(2, 0) and matrix(1, 2) == matrix(2, 1));
  const double diagonal[3]    = {matrix(0, 0), matrix(1, 1), matrix(2, 2)};
  const double offDiagonal[3] = {matrix(1, 2), matrix(0, 2), matrix(0, 1)};
  double       diagonalTimesSquares[3];
  for (int axis = 0; axis < 3; axis++) {
    diagonalTimesSquares[axis] = tarch::la::productRoundedOnce(
      diagonal[axis],
      tarch::la::productRoundedOnce(offDiagonal[axis], offDiagonal[axis])
    );
  }
  const double determinant =
    (tarch::la::productInOrderOfMagnitude(diagonal[0], diagonal[1], diagonal[2])
     + 2.0 * tarch::la::productInOrderOfMagnitude(offDiagonal[0], offDiagonal[1], offDiagonal[2]))
    - tarch::la::sumInOrderOfMagnitude(diagonalTimesSquares[0], diagonalTimesSquares[1], diagonalTimesSquares[2]);
  ASSERTION(determinant != 0.0, determinant);

  const auto differenceOfProducts =
    [](const double first, const double second, const double third, const double fourth) {
      return tarch::la::productRoundedOnce(first, second) - tarch::la::productRoundedOnce(third, fourth);
    };
  inverse(0, 0) = differenceOfProducts(matrix(1, 1), matrix(2, 2), matrix(1, 2), matrix(1, 2)) / determinant;
  inverse(1, 1) = differenceOfProducts(matrix(0, 0), matrix(2, 2), matrix(0, 2), matrix(0, 2)) / determinant;
  inverse(2, 2) = differenceOfProducts(matrix(0, 0), matrix(1, 1), matrix(0, 1), matrix(0, 1)) / determinant;
  inverse(0, 1) = differenceOfProducts(matrix(0, 2), matrix(1, 2), matrix(0, 1), matrix(2, 2)) / determinant;
  inverse(0, 2) = differenceOfProducts(matrix(0, 1), matrix(1, 2), matrix(0, 2), matrix(1, 1)) / determinant;
  inverse(1, 2) = differenceOfProducts(matrix(0, 1), matrix(0, 2), matrix(0, 0), matrix(1, 2)) / determinant;
  inverse(1, 0) = inverse(0, 1);
  inverse(2, 0) = inverse(0, 2);
  inverse(2, 1) = inverse(1, 2);

  return determinant;
}

INLINE_METHOD GPU_CALLABLE_METHOD tests::exahype2::aderdg::grmhd::Matrix3x3
tests::exahype2::aderdg::grmhd::getSpatialMetricOf(const tarch::la::SymmetricMatrix<3, double>& gij) {
  return {gij(0, 0), gij(0, 1), gij(0, 2), gij(1, 0), gij(1, 1), gij(1, 2), gij(2, 0), gij(2, 1), gij(2, 2)};
}

/**
 * Writes the enthalpy w, the residual of the recovery equation and its derivative at the squared
 * velocity squaredVelocity. The equation follows choice 3 of section 3.2 in Del Zanna et al. (2007),
 * A&A 473, 11-30.
 */
INLINE_METHOD GPU_CALLABLE_METHOD void
tests::exahype2::aderdg::grmhd::evaluateRecoveryFunction(
  const double squaredVelocity,
  double&      residual,
  double&      residualDerivative,
  const double gam,
  const double d,
  const double e,
  const double s2,
  const double b2,
  const double sb2,
  double&      w
) {
  ASSERTION(squaredVelocity >= 0.0 and squaredVelocity < 1.0, squaredVelocity);

  constexpr double Third       = 1. / 3.;
  constexpr double InverseOf27 = 1. / 27.;

  const double v2  = squaredVelocity;
  const double rho = d * std::sqrt(1. - v2);
  const double c3  = 1. - gam * (1. - v2);
  const double c2  = gam * rho + .5 * b2 * (1 + v2) - e;
  const double c0  = -0.5 * sb2;

  const double c2ic3 = c2 / c3;
  if (std::abs(c0) < 1.0e-20) {
    w = -c2ic3;
  } else {
    const double c2ic33  = c2ic3 * c2ic3 * c2ic3;
    const double q       = c0 / c3 + 2.0 * InverseOf27 * c2ic33;
    const double p       = -Third * c2ic3 * c2ic3;
    const double sqrtdet = std::sqrt(0.25 * q * q + InverseOf27 * p * p * p);
    w                    = -Third * c2ic3 + std::pow(-0.5 * q + sqrtdet, Third) + std::pow(-0.5 * q - sqrtdet, Third);
  }

  const double dc3 = gam;
  const double dc2 = 0.5 * (b2 - gam * rho / (1.0 - v2));

  const double dlogw = (dc3 * w + dc2) / (3.0 * c3 * w + 2.0 * c2);
  const double wb    = w + b2;
  const double vb2   = sb2 / (w * w);
  residual           = wb * wb * v2 - (2.0 * w + b2) * vb2 - s2;
  residualDerivative = wb * (wb + 2.0 * dlogw * (w * v2 + vb2));
}

/**
 * Returns the squared velocity between lowerStart and upperStart, found with a safeguarded Newton
 * method. The method sets failed when both start residuals agree in sign or when it exceeds its
 * iterations.
 */
INLINE_METHOD GPU_CALLABLE_METHOD double
tests::exahype2::aderdg::grmhd::findSquaredVelocity(
  const double lowerStart,
  const double upperStart,
  const double tolerance,
  double&      w,
  const double gam,
  const double d,
  const double e,
  const double s2,
  const double b2,
  const double sb2,
  bool&        failed
) {
  ASSERTION(lowerStart < upperStart, lowerStart, upperStart);
  ASSERTION(tolerance > 0.0, tolerance);

  constexpr double ResidualTolerance = 1e-60;
  failed                             = false;

  double lowerResidual      = 0.0;
  double upperResidual      = 0.0;
  double residualDerivative = 0.0;

  evaluateRecoveryFunction(lowerStart, lowerResidual, residualDerivative, gam, d, e, s2, b2, sb2, w);

  if (std::abs(lowerResidual) < ResidualTolerance) {
    return lowerStart;
  }

  evaluateRecoveryFunction(upperStart, upperResidual, residualDerivative, gam, d, e, s2, b2, sb2, w);

  if (std::abs(upperResidual) < ResidualTolerance) {
    return upperStart;
  }

  if (lowerResidual * upperResidual > 0.) {
    failed = true;
    return 0.;
  }

  double lowerBound = 0.0;
  double upperBound = 0.0;

  if (lowerResidual < 0.) {
    lowerBound = lowerStart;
    upperBound = upperStart;
  } else {
    upperBound = lowerStart;
    lowerBound = upperStart;
    std::swap(lowerResidual, upperResidual);
  }

  double v2           = .5 * (lowerStart + upperStart);
  double previousStep = std::abs(upperStart - lowerStart);
  double step         = previousStep;

  double residual = 0.0;
  evaluateRecoveryFunction(v2, residual, residualDerivative, gam, d, e, s2, b2, sb2, w);

  constexpr int MaximumIterations = 400;
  for (int iteration = 0; iteration < MaximumIterations; iteration++) {
    if (
      (((v2 - upperBound) * residualDerivative - residual) * ((v2 - lowerBound) * residualDerivative - residual) > 0.)
      or (std::abs(2 * residual) > std::abs(previousStep * residualDerivative))
    ) {
      previousStep = step;
      step         = 0.5 * (upperBound - lowerBound);
      v2           = lowerBound + step;
      // The midpoint of a bracket that spans two adjacent doubles rounds onto one of its ends.
      if (lowerBound == v2 or upperBound == v2) {
        return v2;
      }
    } else {
      previousStep                  = step;
      step                          = residual / residualDerivative;
      const double previousEstimate = v2;
      v2                            = v2 - step;
      if (previousEstimate == v2) {
        return v2;
      }
    }

    if (std::abs(step) < tolerance) {
      return v2;
    }

    evaluateRecoveryFunction(v2, residual, residualDerivative, gam, d, e, s2, b2, sb2, w);

    if (residual < 0) {
      lowerBound    = v2;
      lowerResidual = residual;
    } else {
      upperBound    = v2;
      upperResidual = residual;
    }

    if (std::abs(residual) < ResidualTolerance) {
      return v2;
    }
  }

  failed = true;
  return 0.;
}

/**
 * Returns the conserved variables of the primitive variables V. V stores the pressure in the slot of
 * E. The suffixes Cov and Contr mark the covariant and the contravariant components.
 */
INLINE_METHOD GPU_CALLABLE_METHOD tests::exahype2::aderdg::grmhd::Unknowns
tests::exahype2::aderdg::grmhd::getConservedVariablesOf(const Unknowns& V) {
  constexpr double AdiabaticIndex = 4.0 / 3.0;

  const double    rho    = V.rho;
  const Vector3&  vCov   = V.vel;
  const double    p      = V.E;
  const Vector3&  bContr = V.B;
  const Matrix3x3 gCov   = getSpatialMetricOf(V.gij);

  Matrix3x3    gContr;
  const double determinant = invertMatrix3x3(gCov, gContr);
  ASSERTION(determinant > 0.0, determinant);

  const double rootDeterminant        = std::sqrt(determinant);
  const double inverseRootDeterminant = 1. / rootDeterminant;

  const Vector3 vContr = multiplyMatrixVector(gContr, vCov);
  const Vector3 bCov   = multiplyMatrixVector(gCov, bContr);

  const Vector3 vCrossBCov   = getScaledCrossProductOf(vContr, bContr, rootDeterminant);
  const Vector3 vCrossBContr = getScaledCrossProductOf(vCov, bCov, inverseRootDeterminant);

  const double vDotB = getScalarProductOf(vCov, bContr);
  const double v2    = getScalarProductOf(vContr, vCov);
  const double e2    = getScalarProductOf(vCrossBContr, vCrossBCov);
  const double b2    = getScalarProductOf(bContr, bCov);
  ASSERTION(v2 < 1.0, v2);

  const double electromagneticEnergy = 0.5 * (b2 + e2);

  const double lorentzFactor  = 1.0 / std::sqrt(1.0 - v2);
  const double enthalpyFactor = AdiabaticIndex / (AdiabaticIndex - 1.0);
  const double enthalpy       = rho + enthalpyFactor * p;
  const double scaledEnthalpy = enthalpy * lorentzFactor * lorentzFactor;

  Unknowns Q;
  Q.rho = rootDeterminant * rho * lorentzFactor;
  for (int axis = 0; axis < 3; axis++) {
    Q.vel(axis) = rootDeterminant * scaledEnthalpy * vCov(axis) + b2 * vCov(axis) - vDotB * bCov(axis);
  }
  Q.E     = rootDeterminant * scaledEnthalpy - p + electromagneticEnergy - Q.rho;
  Q.B     = rootDeterminant * V.B;
  Q.psi   = V.psi;
  Q.lapse = V.lapse;
  Q.shift = V.shift;
  Q.gij   = V.gij;
  return Q;
}

/**
 * Returns the primitive variables of the conserved variables Q and writes the inverse of the spatial
 * metric into gContr and the determinant of the spatial metric into determinant. The primitive
 * variables store the pressure in the slot of E. A failed recovery and a density or pressure below
 * the atmosphere values set the velocity to zero and raise the state to the atmosphere.
 */
INLINE_METHOD GPU_CALLABLE_METHOD tests::exahype2::aderdg::grmhd::Unknowns
tests::exahype2::aderdg::grmhd::getPrimitiveVariablesOf(const Unknowns& Q, Matrix3x3& gContr, double& determinant) {
  constexpr double AdiabaticIndex     = 4.0 / 3.0;
  constexpr double AtmospherePressure = 1e-12;
  constexpr double AtmosphereDensity  = 1e-11;

  const Matrix3x3 gCov = getSpatialMetricOf(Q.gij);

  determinant = invertMatrix3x3(gCov, gContr);
  ASSERTION(determinant > 0.0, determinant);

  const double rootDeterminant        = std::sqrt(determinant);
  const double inverseRootDeterminant = 1. / rootDeterminant;

  // Q stores the fluid values multiplied by the root of the metric determinant.
  const double  density     = inverseRootDeterminant * Q.rho;
  const Vector3 sCov        = inverseRootDeterminant * Q.vel;
  const double  fluidEnergy = inverseRootDeterminant * Q.E;
  const Vector3 bContr      = inverseRootDeterminant * Q.B;

  const double enthalpyFactor        = AdiabaticIndex / (AdiabaticIndex - 1.0);
  const double inverseEnthalpyFactor = 1.0 / enthalpyFactor;

  const Vector3 sContr = multiplyMatrixVector(gContr, sCov);
  const Vector3 bCov   = multiplyMatrixVector(gCov, bContr);

  const double s2  = getScalarProductOf(sCov, sContr);
  const double b2  = getScalarProductOf(bContr, bCov);
  const double sb  = getScalarProductOf(sCov, bContr);
  const double sb2 = sb * sb;

  // The root finder follows method 3 of Del Zanna et al. (2007), A&A 473, 11-30.
  const double e = fluidEnergy + density;

  // The tolerance lies above the spacing of doubles near v2. The root finder then stops before its
  // last iteration.
  bool   failed = false;
  double w      = 0;
  double v2 = findSquaredVelocity(0., 1.0 - 1e-10, 1.0e-15, w, inverseEnthalpyFactor, density, e, s2, b2, sb2, failed);

  double  p   = 0;
  double  rho = 0;
  Vector3 vCov(0.0);
  if (failed) {
    p   = AtmospherePressure;
    rho = AtmosphereDensity;
  } else {
    const double inverseTotalEnthalpy = 1.0 / (w + b2);
    const double vDotB                = sb / w;
    rho                               = density * std::sqrt(1. - v2);
    for (int axis = 0; axis < 3; axis++) {
      vCov(axis) = (sCov(axis) + vDotB * bCov(axis)) * inverseTotalEnthalpy;
    }
    p = inverseEnthalpyFactor * (w * (1. - v2) - rho);
  }

  if (rho < AtmosphereDensity * 1.01) {
    vCov = 0.0;
    v2   = 0.;
    rho  = AtmosphereDensity;
    p    = inverseEnthalpyFactor * (w * (1. - v2) - rho);
  }
  if (p < AtmospherePressure * 1.01) {
    vCov = 0.0;
    p    = AtmospherePressure;
  }
  p = std::max(p, AtmospherePressure);

  Unknowns V;
  V.rho   = rho;
  V.vel   = vCov;
  V.E     = p;
  V.B     = bContr;
  V.psi   = Q.psi;
  V.lapse = Q.lapse;
  V.shift = Q.shift;
  V.gij   = Q.gij;
  return V;
}
TARGET_DECLARE_END
