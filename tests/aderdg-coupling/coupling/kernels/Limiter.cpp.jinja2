    peano4::dForEachExclusive(FromPoints, DIMENSIONS-1, 0, [&](const tarch::la::Vector<DIMENSIONS, int>& dofFrom) {
      const int dofFromSerialised = dofFrom[0]
  #if DIMENSIONS==3
