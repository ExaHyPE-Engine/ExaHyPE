    {{PROJ_LIMITER_TO_REGULAR}}
  };

  std::fill_n(Qto, toSize, 0.0);

  peano4::dForEachExclusive(ToPoints, DIMENSIONS-1, 0, [&](const tarch::la::Vector<DIMENSIONS, int>& dofTo) {
    const int dofToSerialised = dofTo[0]
