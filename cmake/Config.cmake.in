@PACKAGE_INIT@

if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/cmake")
  list(APPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}/cmake")
else()
  list(APPEND CMAKE_MODULE_PATH "@CMAKE_SOURCE_DIR@/cmake")
endif()

include(CMakeFindDependencyMacro)
include(CheckIPOSupported)
include(PeanoEnableGPULanguage)
include(PeanoTarget)
include(PeanoHostDependencies)

# Determine IPO support once because peano_add_target() reads the result.
check_ipo_supported(RESULT IPO_SUPPORTED)

set(PEANO_WITH_FPE "@PEANO_WITH_FPE@")
set(PEANO_WITH_HDF5 "@PEANO_WITH_HDF5@")
set(PEANO_WITH_NETCDF "@PEANO_WITH_NETCDF@")
set(PEANO_WITH_ZLIB "@PEANO_WITH_ZLIB@")

peano_find_host_dependencies()

include("${CMAKE_CURRENT_LIST_DIR}/@PROJECT_NAME@Targets.cmake")

set(PEANO_WITH_GPU_BACKEND "@_peano_gpu_backend@")
set(PEANO_WITH_GPU_ARCH "@PEANO_WITH_GPU_ARCH@")
set(PEANO_WITH_SIMDLEN "@PEANO_WITH_SIMDLEN@")
set(PEANO_CMAKE_GENERATOR "@CMAKE_GENERATOR@")
set(PEANO_CMAKE_GENERATOR_PLATFORM "@CMAKE_GENERATOR_PLATFORM@")
set(PEANO_CMAKE_GENERATOR_TOOLSET "@CMAKE_GENERATOR_TOOLSET@")
set(PEANO_CMAKE_C_COMPILER "@CMAKE_C_COMPILER@")
set(PEANO_CMAKE_CXX_COMPILER "@CMAKE_CXX_COMPILER@")
set(PEANO_CMAKE_FORTRAN_COMPILER "@CMAKE_Fortran_COMPILER@")
set(PEANO_ACPP_TARGETS "@ACPP_TARGETS@")
set(PEANO_ACPP_DEBUG_LEVEL "@ACPP_DEBUG_LEVEL@")
set(PEANO_ACPP_COMPILER_FEATURE_PROFILE "@ACPP_COMPILER_FEATURE_PROFILE@")
set(PEANO_ADAPTIVECPP_DIR "@AdaptiveCpp_DIR@")
set(PEANO_KOKKOS_DIR "@Kokkos_DIR@")

if(NOT PEANO_WITH_GPU_BACKEND STREQUAL "no")
  peano_find_gpu_backend()
endif()

check_required_components(@PROJECT_NAME@)
