#include "applications/exagrype/EnforceCCZ4Constraints.h"
#include "applications/exagrype/MaxEigenvalue.h"
#include "applications/exagrype/NonconservativeProduct.h"
#include "applications/exagrype/SourceTerm.h"
#include "tarch/Assertions.h"
#include "tarch/la/Scalar.h"

TARGET_DECLARE
/**
 * Writes the exact gauge wave for the line element -H dt^2 + H dx^2 + dy^2 + dz^2 at x and t into
 * solution. The metric derivative D_kij stores half the derivative of the conformal metric.
 */
INLINE_METHOD GPU_CALLABLE_METHOD void
applications::exahype2::exagrype::CCZ4Solver::analyticalSolution(
  const Coordinates&                        x,
  const double                              t,
  [[maybe_unused]] const double             dt,
  [[maybe_unused]] const State&             Q,
  Solution&                                 solution,
  [[maybe_unused]] const RuntimeParameters& parameters
) {
  ASSERTION(std::isfinite(t) and std::isfinite(x[0]), t, x);

  constexpr double NumberOfPeaks = 2.0;
  constexpr double Amplitude     = 0.1;

  const double phase      = NumberOfPeaks * tarch::la::PI * (x[0] - t);
  const double h          = 1.0 - Amplitude * std::sin(phase);
  const double dxH        = -NumberOfPeaks * tarch::la::PI * Amplitude * std::cos(phase);
  const double phi        = std::pow(1.0 / h, 1.0 / 6.0);
  const double phiSquared = phi * phi;
  const double lapse      = std::sqrt(h);
  const double dxPhi      = -phi * dxH / (6.0 * h);
  const double curvatureX = 0.5 * dxH / lapse;
  const double traceK     = curvatureX / h;

  solution                           = {};
  solution.gamma_tilde(0, 0)         = phiSquared * h;
  solution.gamma_tilde(1, 1)         = phiSquared;
  solution.gamma_tilde(2, 2)         = phiSquared;
  solution.A_tilde(0, 0)             = phiSquared * (curvatureX - 1.0 / 3.0 * traceK * h);
  solution.A_tilde(1, 1)             = phiSquared * (-1.0 / 3.0 * traceK);
  solution.A_tilde(2, 2)             = phiSquared * (-1.0 / 3.0 * traceK);
  solution.gamma_hat(0)              = 2.0 * dxH / (3.0 * phiSquared * h * h);
  solution.alpha                     = lapse;
  solution.grad_alpha(0)             = 0.5 * dxH / lapse;
  solution.grad_gamma_tilde(0)(0, 0) = phiSquared * dxH / 3.0;
  solution.grad_gamma_tilde(0)(1, 1) = phi * dxPhi;
  solution.grad_gamma_tilde(0)(2, 2) = phi * dxPhi;
  solution.K                         = traceK;
  solution.phi                       = phi;
  solution.grad_phi(0)               = dxPhi;

  ASSERTION(allOf(solution, [](const double value) { return std::isfinite(value); }), x, t);
}

INLINE_METHOD void
applications::exahype2::exagrype::CCZ4Solver::initialCondition(
  State&                              Q,
  const Coordinates&                  x,
  [[maybe_unused]] const Coordinates& h,
  const RuntimeParameters&            parameters
) {
  static_assert(NumberOfAuxiliaryVariables == 0, "The gauge wave expects zero auxiliary variables.");
  analyticalSolution(x, 0.0, 0.0, Q, Q, parameters);
}

INLINE_METHOD GPU_CALLABLE_METHOD ::exahype2::RefinementCommand
applications::exahype2::exagrype::CCZ4Solver::refinementCriterion(
  [[maybe_unused]] const CellStates*        Q,
  [[maybe_unused]] const Coordinates&       x,
  [[maybe_unused]] const Coordinates&       h,
  [[maybe_unused]] const double             t,
  [[maybe_unused]] const RuntimeParameters& parameters
) {
  return ::exahype2::RefinementCommand::Keep;
}

INLINE_METHOD GPU_CALLABLE_METHOD double
applications::exahype2::exagrype::CCZ4Solver::maxEigenvalue(
  const State&                              Q,
  [[maybe_unused]] const Coordinates&       x,
  [[maybe_unused]] const Coordinates&       h,
  [[maybe_unused]] const double             t,
  [[maybe_unused]] const double             dt,
  const int                                 normal,
  [[maybe_unused]] const RuntimeParameters& parameters
) {
  return applications::exahype2::exagrype::maxEigenvalue(Q, normal);
}

INLINE_METHOD GPU_CALLABLE_METHOD void
applications::exahype2::exagrype::CCZ4Solver::nonconservativeProduct(
  const State&                              Q,
  const Difference&                         deltaQ,
  [[maybe_unused]] const Coordinates&       x,
  [[maybe_unused]] const Coordinates&       h,
  [[maybe_unused]] const double             t,
  [[maybe_unused]] const double             dt,
  const int                                 normal,
  NonconservativeProduct&                   BTimesDeltaQ,
  [[maybe_unused]] const RuntimeParameters& parameters
) {
  applications::exahype2::exagrype::nonconservativeProduct(Q, deltaQ, normal, BTimesDeltaQ);
}

INLINE_METHOD GPU_CALLABLE_METHOD void
applications::exahype2::exagrype::CCZ4Solver::sourceTerm(
  const State&                              Q,
  [[maybe_unused]] const Coordinates&       x,
  [[maybe_unused]] const Coordinates&       h,
  [[maybe_unused]] const double             t,
  [[maybe_unused]] const double             dt,
  Source&                                   S,
  [[maybe_unused]] const RuntimeParameters& parameters
) {
  applications::exahype2::exagrype::sourceTerm(Q, S);
}

/**
 * Projects every point of the updated patch Q back onto the CCZ4 constraints.
 */
INLINE_METHOD GPU_CALLABLE_METHOD void
applications::exahype2::exagrype::CCZ4Solver::postprocessUpdatedPatch(
  CellStates&                               Q,
  [[maybe_unused]] const Coordinates&       x,
  [[maybe_unused]] const Coordinates&       h,
  [[maybe_unused]] const double             t,
  [[maybe_unused]] const double             dt,
  [[maybe_unused]] const RuntimeParameters& parameters
) {
  for (State& point : Q) {
    applications::exahype2::exagrype::enforceCCZ4Constraints(point);
  }
}
TARGET_DECLARE_END
