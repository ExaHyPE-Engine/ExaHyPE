/**
 * Writes the algebraic right-hand side of the first-order CCZ4 system.
 * The conformal metric must be positive definite.
 */
template <class Shortcuts>
INLINE_METHOD GPU_CALLABLE_METHOD void applications::exahype2::exagrype::sourceTerm(
  const double* const NOALIAS Q,
  double* const NOALIAS       S
) {
  assertion(Q != nullptr and S != nullptr);
  const double alpha = std::fmax(1e-4, Q[Shortcuts::alpha]);

  double fa  = 1.0;
  double faa = 0.0;
  if constexpr (CCZ4LapseType == 1) {
    fa  = 2. / alpha;
    faa = -fa / alpha;
  }

  const double g_cov[3][3] = {
    {Q[Shortcuts::gamma_tilde + 0], Q[Shortcuts::gamma_tilde + 1], Q[Shortcuts::gamma_tilde + 2]},
    {Q[Shortcuts::gamma_tilde + 1], Q[Shortcuts::gamma_tilde + 3], Q[Shortcuts::gamma_tilde + 4]},
    {Q[Shortcuts::gamma_tilde + 2], Q[Shortcuts::gamma_tilde + 4], Q[Shortcuts::gamma_tilde + 5]}
  };
  const double det = Q[Shortcuts::gamma_tilde + 0] * Q[Shortcuts::gamma_tilde + 3] * Q[Shortcuts::gamma_tilde + 5]
    - Q[Shortcuts::gamma_tilde + 0] * Q[Shortcuts::gamma_tilde + 4] * Q[Shortcuts::gamma_tilde + 4]
    - Q[Shortcuts::gamma_tilde + 1] * Q[Shortcuts::gamma_tilde + 1] * Q[Shortcuts::gamma_tilde + 5]
    + 2 * Q[Shortcuts::gamma_tilde + 1] * Q[Shortcuts::gamma_tilde + 2] * Q[Shortcuts::gamma_tilde + 4]
    - Q[Shortcuts::gamma_tilde + 2] * Q[Shortcuts::gamma_tilde + 2] * Q[Shortcuts::gamma_tilde + 3];
  assertion(std::isfinite(det) and det > 0.0, det);
  const double invdet = 1. / det;

  const double g_contr[3][3] = {
    {(Q[Shortcuts::gamma_tilde + 3] * Q[Shortcuts::gamma_tilde + 5]
      - Q[Shortcuts::gamma_tilde + 4] * Q[Shortcuts::gamma_tilde + 4])
       * invdet,
     -(Q[Shortcuts::gamma_tilde + 1] * Q[Shortcuts::gamma_tilde + 5]
       - Q[Shortcuts::gamma_tilde + 2] * Q[Shortcuts::gamma_tilde + 4])
       * invdet,
     -(-Q[Shortcuts::gamma_tilde + 1] * Q[Shortcuts::gamma_tilde + 4]
       + Q[Shortcuts::gamma_tilde + 2] * Q[Shortcuts::gamma_tilde + 3])
       * invdet},
    {-(Q[Shortcuts::gamma_tilde + 1] * Q[Shortcuts::gamma_tilde + 5]
       - Q[Shortcuts::gamma_tilde + 4] * Q[Shortcuts::gamma_tilde + 2])
       * invdet,
     (Q[Shortcuts::gamma_tilde + 0] * Q[Shortcuts::gamma_tilde + 5]
      - Q[Shortcuts::gamma_tilde + 2] * Q[Shortcuts::gamma_tilde + 2])
       * invdet,
     -(Q[Shortcuts::gamma_tilde + 0] * Q[Shortcuts::gamma_tilde + 4]
       - Q[Shortcuts::gamma_tilde + 2] * Q[Shortcuts::gamma_tilde + 1])
       * invdet},
    {-(-Q[Shortcuts::gamma_tilde + 1] * Q[Shortcuts::gamma_tilde + 4]
       + Q[Shortcuts::gamma_tilde + 3] * Q[Shortcuts::gamma_tilde + 2])
       * invdet,
     -(Q[Shortcuts::gamma_tilde + 0] * Q[Shortcuts::gamma_tilde + 4]
       - Q[Shortcuts::gamma_tilde + 1] * Q[Shortcuts::gamma_tilde + 2])
       * invdet,
     (Q[Shortcuts::gamma_tilde + 0] * Q[Shortcuts::gamma_tilde + 3]
      - Q[Shortcuts::gamma_tilde + 1] * Q[Shortcuts::gamma_tilde + 1])
       * invdet}
  };

  double aEx[3][3] = {
    {Q[Shortcuts::A_tilde + 0], Q[Shortcuts::A_tilde + 1], Q[Shortcuts::A_tilde + 2]},
    {Q[Shortcuts::A_tilde + 1], Q[Shortcuts::A_tilde + 3], Q[Shortcuts::A_tilde + 4]},
    {Q[Shortcuts::A_tilde + 2], Q[Shortcuts::A_tilde + 4], Q[Shortcuts::A_tilde + 5]}
  };

  double traceA = 0;
  for (int i = 0; i < 3; i++) {
    for (int j = 0; j < 3; j++) {
      traceA += g_contr[i][j] * aEx[i][j];
    }
  }

  for (int i = 0; i < 3; i++) {
    for (int j = 0; j < 3; j++) {
      aEx[i][j] -= 1. / 3. * traceA * g_cov[i][j];
    }
  }

  double aMix[3][3] = {};
  for (int i = 0; i < 3; i++) {
    for (int j = 0; j < 3; j++) {
      for (int u = 0; u < 3; u++) {
        aMix[i][j] += g_contr[i][u] * aEx[u][j];
      }
    }
  }
  double aUp[3][3] = {};
  for (int i = 0; i < 3; i++) {
    for (int j = 0; j < 3; j++) {
      for (int u = 0; u < 3; u++) {
        aUp[i][j] += g_contr[i][u] * aMix[j][u];
      }
    }
  }

  const double theta = Q[Shortcuts::theta];

  const double dd[3][3][3] = {
    {{Q[Shortcuts::grad_gamma_tilde + 0], Q[Shortcuts::grad_gamma_tilde + 1], Q[Shortcuts::grad_gamma_tilde + 2]},
     {Q[Shortcuts::grad_gamma_tilde + 1], Q[Shortcuts::grad_gamma_tilde + 3], Q[Shortcuts::grad_gamma_tilde + 4]},
     {Q[Shortcuts::grad_gamma_tilde + 2], Q[Shortcuts::grad_gamma_tilde + 4], Q[Shortcuts::grad_gamma_tilde + 5]}},
    {{Q[Shortcuts::grad_gamma_tilde + 6], Q[Shortcuts::grad_gamma_tilde + 7], Q[Shortcuts::grad_gamma_tilde + 8]},
     {Q[Shortcuts::grad_gamma_tilde + 7], Q[Shortcuts::grad_gamma_tilde + 9], Q[Shortcuts::grad_gamma_tilde + 10]},
     {Q[Shortcuts::grad_gamma_tilde + 8], Q[Shortcuts::grad_gamma_tilde + 10], Q[Shortcuts::grad_gamma_tilde + 11]}},
    {{Q[Shortcuts::grad_gamma_tilde + 12], Q[Shortcuts::grad_gamma_tilde + 13], Q[Shortcuts::grad_gamma_tilde + 14]},
     {Q[Shortcuts::grad_gamma_tilde + 13], Q[Shortcuts::grad_gamma_tilde + 15], Q[Shortcuts::grad_gamma_tilde + 16]},
     {Q[Shortcuts::grad_gamma_tilde + 14], Q[Shortcuts::grad_gamma_tilde + 16], Q[Shortcuts::grad_gamma_tilde + 17]}}
  };

  // Derivative of the inverse conformal metric, from d_k(g^ml g_lj) = 0.
  double dgup[3][3][3] = {};
  for (int k = 0; k < 3; k++) {
    for (int m = 0; m < 3; m++) {
      for (int l = 0; l < 3; l++) {
        for (int n = 0; n < 3; n++) {
          for (int j = 0; j < 3; j++) {
            dgup[k][m][l] -= 2.0 * g_contr[m][n] * g_contr[j][l] * dd[k][n][j];
          }
        }
      }
    }
  }

  const double phi  = std::fmax(1e-2, Q[Shortcuts::phi]);
  const double phi2 = phi * phi;

  const double pp[3] = {Q[Shortcuts::grad_phi + 0], Q[Shortcuts::grad_phi + 1], Q[Shortcuts::grad_phi + 2]};

  double christoffelTilde[3][3][3] = {};
  for (int j = 0; j < 3; j++) {
    for (int i = 0; i < 3; i++) {
      for (int k = 0; k < 3; k++) {
        for (int l = 0; l < 3; l++) {
          christoffelTilde[i][j][k] += g_contr[k][l] * (dd[i][j][l] + dd[j][i][l] - dd[l][i][j]);
        }
      }
    }
  }

  double christoffelTildeDown[3][3][3];
  for (int i = 0; i < 3; i++) {
    for (int j = 0; j < 3; j++) {
      for (int k = 0; k < 3; k++) {
        christoffelTildeDown[i][j][k] = dd[j][k][i] + dd[k][j][i] - dd[i][j][k];
      }
    }
  }

  double gTilde[3] = {};
  for (int l = 0; l < 3; l++) {
    for (int j = 0; j < 3; j++) {
      for (int i = 0; i < 3; i++) {
        gTilde[i] += g_contr[j][l] * christoffelTilde[j][l][i];
      }
    }
  }

  const double gHat[3] = {Q[Shortcuts::gamma_hat + 0], Q[Shortcuts::gamma_hat + 1], Q[Shortcuts::gamma_hat + 2]};

  double z[3] = {};
  for (int i = 0; i < 3; i++) {
    for (int j = 0; j < 3; j++) {
      z[i] += 0.5 * CCZ4Ds * (g_cov[i][j] * (gHat[j] - gTilde[j]));
    }
  }
  double zUp[3] = {};
  for (int i = 0; i < 3; i++) {
    for (int j = 0; j < 3; j++) {
      zUp[i] += phi2 * g_contr[i][j] * z[j];
    }
  }

  // The Ricci tensor includes the symmetrised derivative of the Z4 vector.
  double ricciPlusNablaZSrc[3][3] = {};
  for (int i = 0; i < 3; i++) {
    for (int j = 0; j < 3; j++) {
      for (int k = 0; k < 3; k++) {
        ricciPlusNablaZSrc[i][j] += gHat[k] * dd[k][i][j];
        ricciPlusNablaZSrc[i][j] -= pp[k] * christoffelTilde[i][j][k] / phi;
        ricciPlusNablaZSrc[i][j] +=
          2.0 * zUp[k] / (phi * phi2) * (g_cov[i][k] * pp[j] + g_cov[j][k] * pp[i] - g_cov[i][j] * pp[k]);
        for (int l = 0; l < 3; l++) {
          ricciPlusNablaZSrc[i][j] -= 2.0 * g_cov[i][j] * g_contr[k][l] * pp[k] * pp[l] / phi2;
          for (int m = 0; m < 3; m++) {
            ricciPlusNablaZSrc[i][j] += g_contr[l][m]
              * (christoffelTilde[l][i][k] * christoffelTildeDown[j][k][m]
                 + christoffelTilde[l][j][k] * christoffelTildeDown[i][k][m]
                 + christoffelTilde[i][m][k] * christoffelTildeDown[k][l][j]);
            ricciPlusNablaZSrc[i][j] -= g_cov[i][j] * g_contr[l][m] * christoffelTilde[l][m][k] * pp[k] / phi;
          }
        }
      }
    }
  }

  double rPlusTwoNablaZSrc = 0;
  for (int i = 0; i < 3; i++) {
    for (int j = 0; j < 3; j++) {
      rPlusTwoNablaZSrc += g_contr[i][j] * ricciPlusNablaZSrc[i][j];
    }
  }
  rPlusTwoNablaZSrc *= phi2;

  const double aa[3] = {Q[Shortcuts::grad_alpha + 0], Q[Shortcuts::grad_alpha + 1], Q[Shortcuts::grad_alpha + 2]};

  double nablaijalphaSrc[3][3] = {};
  for (int j = 0; j < 3; j++) {
    for (int i = 0; i < 3; i++) {
      nablaijalphaSrc[i][j] += (pp[i] * aa[j] + pp[j] * aa[i]) / phi;
      for (int k = 0; k < 3; k++) {
        nablaijalphaSrc[i][j] -= christoffelTilde[i][j][k] * aa[k];
        for (int l = 0; l < 3; l++) {
          nablaijalphaSrc[i][j] -= g_cov[i][j] * g_contr[k][l] * pp[k] * aa[l] / phi;
        }
      }
    }
  }

  double nablanablaalphaSrc = 0;
  for (int i = 0; i < 3; i++) {
    for (int j = 0; j < 3; j++) {
      nablanablaalphaSrc += g_contr[i][j] * nablaijalphaSrc[i][j];
    }
  }
  nablanablaalphaSrc *= phi2;

  double secondOrderTermsSrc[3][3];
  for (int i = 0; i < 3; i++) {
    for (int j = 0; j < 3; j++) {
      secondOrderTermsSrc[i][j] = -nablaijalphaSrc[i][j] + alpha * ricciPlusNablaZSrc[i][j];
    }
  }

  double traceSrc = 0;
  for (int i = 0; i < 3; i++) {
    for (int j = 0; j < 3; j++) {
      traceSrc += g_contr[i][j] * secondOrderTermsSrc[i][j];
    }
  }

  for (int i = 0; i < 3; i++) {
    for (int j = 0; j < 3; j++) {
      secondOrderTermsSrc[i][j] -= 1. / 3 * traceSrc * g_cov[i][j];
    }
  }

  double dtgamma[3][3];
  for (int i = 0; i < 3; i++) {
    for (int j = 0; j < 3; j++) {
      dtgamma[i][j] = -2.0 * alpha * aEx[i][j] - CCZ4Itau * (det - 1.0) * g_cov[i][j];
    }
  }

  const double bb[3][3] = {
    {Q[Shortcuts::grad_beta + 0], Q[Shortcuts::grad_beta + 1], Q[Shortcuts::grad_beta + 2]},
    {Q[Shortcuts::grad_beta + 3], Q[Shortcuts::grad_beta + 4], Q[Shortcuts::grad_beta + 5]},
    {Q[Shortcuts::grad_beta + 6], Q[Shortcuts::grad_beta + 7], Q[Shortcuts::grad_beta + 8]}
  };

  const double traceB  = bb[0][0] + bb[1][1] + bb[2][2];
  const double beta[3] = {Q[Shortcuts::beta + 0], Q[Shortcuts::beta + 1], Q[Shortcuts::beta + 2]};

  for (int k = 0; k < 3; k++) {
    for (int j = 0; j < 3; j++) {
      for (int i = 0; i < 3; i++) {
        dtgamma[i][j] += g_cov[k][i] * bb[j][k] + g_cov[k][j] * bb[i][k] - 2. / 3. * g_cov[i][j] * bb[k][k]
          + 2. * beta[k] * dd[k][i][j];
      }
    }
  }

  double aTemp[3][3] = {};
  for (int i = 0; i < 3; i++) {
    for (int j = 0; j < 3; j++) {
      for (int u = 0; u < 3; u++) {
        aTemp[i][j] += aEx[i][u] * aMix[u][j];
      }
    }
  }

  const double traceK = Q[Shortcuts::K];

  double dtK[3][3];
  for (int i = 0; i < 3; i++) {
    for (int j = 0; j < 3; j++) {
      dtK[i][j] =
        phi2 * secondOrderTermsSrc[i][j] + alpha * aEx[i][j] * (traceK - 2. * theta * CCZ4C) - 2. * alpha * aTemp[i][j];
    }
  }

  for (int j = 0; j < 3; j++) {
    for (int i = 0; i < 3; i++) {
      for (int k = 0; k < 3; k++) {
        dtK[i][j] += aEx[k][i] * bb[j][k] + aEx[k][j] * bb[i][k] - 2. / 3. * aEx[i][j] * bb[k][k];
      }
    }
  }

  // K1 enters as K1/alpha, so the damping stays finite where the lapse collapses.
  double dtTraceK = -nablanablaalphaSrc + alpha * (rPlusTwoNablaZSrc + traceK * traceK - 2.0 * CCZ4C * theta * traceK)
    - 3.0 * alpha * CCZ4K1 * (1. + CCZ4K2) * theta / alpha;

  double dtchi = (beta[0] * pp[0] + beta[1] * pp[1] + beta[2] * pp[2]) + 1. / 3. * (alpha * traceK - traceB) * phi;

  double dtalpha = -alpha * alpha * fa * (traceK - CCZ4K0 - 2. * CCZ4C * theta)
    + (beta[0] * aa[0] + beta[1] * aa[1] + beta[2] * aa[2]);

  double aUpDown = 0;
  for (int i = 0; i < 3; i++) {
    for (int j = 0; j < 3; j++) {
      aUpDown += aEx[i][j] * aUp[i][j];
    }
  }

  double sumzupaa = 0.0;
  for (int i = 0; i < 3; i++) {
    sumzupaa += zUp[i] * aa[i];
  }
  double dtTheta = 0.5 * alpha * CCZ4E * CCZ4E * (rPlusTwoNablaZSrc - aUpDown + 2. / 3. * traceK * traceK)
    - alpha * (CCZ4C * theta * traceK + sumzupaa / alpha + CCZ4K1 * (2. + CCZ4K2) * theta / alpha);

  double dtGhat[3] = {};
  for (int i = 0; i < 3; i++) {
    double temp1 = 0, temp2 = 0, temp3 = 0, temp4 = 0, temp5 = 0, temp6 = 0;
    for (int m = 0; m < 3; m++) {
      temp1 += aUp[i][m] * pp[m] / phi;
      temp3 += aUp[i][m] * aa[m] / alpha;
      temp2 += g_contr[m][i] * (-theta * aa[m] / alpha - 2. / 3. * traceK * z[m]);
      temp4 += g_contr[i][m] * z[m];
      temp5 += gTilde[m] * bb[m][i];
      for (int n = 0; n < 3; n++) {
        temp6 += christoffelTilde[m][n][i] * aUp[m][n];
      }
    }
    dtGhat[i] +=
      2. * alpha * (temp6 - 3. * temp1 + temp2 - temp3 - CCZ4K1 * temp4 / alpha) - temp5 + 2. / 3. * gTilde[i] * traceB;

    for (int l = 0; l < 3; l++) {
      for (int k = 0; k < 3; k++) {
        dtGhat[i] += 2. * CCZ4K3 * (2. / 3. * g_contr[i][l] * z[l] * bb[k][k] - g_contr[l][k] * z[l] * bb[k][i]);
      }
    }
  }

  double metricDerivativeTrace[3]{};
  double ov[3];
  for (int k = 0; k < 3; k++) {
    for (int i = 0; i < 3; i++) {
      for (int j = 0; j < 3; j++) {
        metricDerivativeTrace[k] += dgup[k][i][j] * aEx[i][j];
      }
    }
    ov[k] = 2 * alpha * metricDerivativeTrace[k];
  }

  for (int i = 0; i < 3; i++) {
    for (int j = 0; j < 3; j++) {
      dtGhat[i] += CCZ4Sk * g_contr[i][j] * ov[j];
    }
  }

  const double myb[3] = {Q[Shortcuts::b + 0], Q[Shortcuts::b + 1], Q[Shortcuts::b + 2]};

  double dtbb[3];
  for (int i = 0; i < 3; i++) {
    dtbb[i] = CCZ4Sk * (CCZ4Xi * dtGhat[i] - CCZ4Eta * myb[i]);
  }

  double dtbeta[3];
  for (int i = 0; i < 3; i++) {
    dtbeta[i] = CCZ4F * myb[i];
  }
  for (int i = 0; i < 3; i++) {
    dtbeta[i] += CCZ4Bs * (beta[0] * bb[0][i] + beta[1] * bb[1][i] + beta[2] * bb[2][i]);
  }
  for (int i = 0; i < 3; i++) {
    dtbeta[i] *= CCZ4Sk;
  }

  double dtA[3];
  for (int i = 0; i < 3; i++) {
    dtA[i] = -alpha * aa[i] * (2. * fa + alpha * faa) * (traceK - CCZ4K0 - 2. * CCZ4C * theta);
    for (int j = 0; j < 3; j++) {
      dtA[i] += bb[i][j] * aa[j];
    }
  }

  for (int k = 0; k < 3; k++) {
    dtA[k] += -CCZ4Sk * alpha * alpha * fa * metricDerivativeTrace[k];
  }

  double dtB[3][3] = {};
  for (int i = 0; i < 3; i++) {
    for (int j = 0; j < 3; j++) {
      for (int u = 0; u < 3; u++) {
        dtB[i][j] += CCZ4Sk * (bb[i][u] * bb[u][j]);
      }
    }
  }

  double dtD[3][3][3] = {};
  for (int m = 0; m < 3; m++) {
    for (int j = 0; j < 3; j++) {
      for (int i = 0; i < 3; i++) {
        for (int k = 0; k < 3; k++) {
          for (int n = 0; n < 3; n++) {
            dtD[k][i][j] += 1. / 3 * alpha * g_cov[i][j] * dgup[k][n][m] * aEx[n][m];
          }
        }
      }
    }
  }

  for (int j = 0; j < 3; j++) {
    for (int i = 0; i < 3; i++) {
      for (int k = 0; k < 3; k++) {
        dtD[k][i][j] -= aa[k] * aEx[i][j];
        for (int l = 0; l < 3; l++) {
          dtD[k][i][j] +=
            bb[k][l] * dd[l][i][j] + bb[j][l] * dd[k][l][i] + bb[i][l] * dd[k][l][j] - 2. / 3. * bb[l][l] * dd[k][i][j];
        }
      }
    }
  }

  double dtP[3] = {};
  for (int i = 0; i < 3; i++) {
    for (int j = 0; j < 3; j++) {
      dtP[i] += bb[i][j] * pp[j];
    }
  }

  for (int k = 0; k < 3; k++) {
    dtP[k] += 1. / 3. * aa[k] * traceK * phi;
    dtP[k] += 1. / 3. * (alpha * traceK - traceB) * pp[k];
    dtP[k] += 1. / 3. * alpha * CCZ4Sk * metricDerivativeTrace[k] * phi;
  }

  S[Shortcuts::gamma_tilde + 0] = dtgamma[0][0];
  S[Shortcuts::gamma_tilde + 1] = dtgamma[0][1];
  S[Shortcuts::gamma_tilde + 2] = dtgamma[0][2];
  S[Shortcuts::gamma_tilde + 3] = dtgamma[1][1];
  S[Shortcuts::gamma_tilde + 4] = dtgamma[1][2];
  S[Shortcuts::gamma_tilde + 5] = dtgamma[2][2];
  S[Shortcuts::A_tilde + 0]     = dtK[0][0];
  S[Shortcuts::A_tilde + 1]     = dtK[0][1];
  S[Shortcuts::A_tilde + 2]     = dtK[0][2];
  S[Shortcuts::A_tilde + 3]     = dtK[1][1];
  S[Shortcuts::A_tilde + 4]     = dtK[1][2];
  S[Shortcuts::A_tilde + 5]     = dtK[2][2];
  S[Shortcuts::theta]           = dtTheta;
  for (int i = 0; i < 3; i++) {
    S[Shortcuts::gamma_hat + i] = dtGhat[i];
  }
  S[Shortcuts::alpha] = dtalpha;
  for (int i = 0; i < 3; i++) {
    S[Shortcuts::beta + i] = dtbeta[i];
  }
  for (int i = 0; i < 3; i++) {
    S[Shortcuts::b + i] = dtbb[i];
  }
  for (int i = 0; i < 3; i++) {
    S[Shortcuts::grad_alpha + i] = dtA[i];
  }
  S[Shortcuts::grad_beta + 0]         = dtB[0][0];
  S[Shortcuts::grad_beta + 1]         = dtB[0][1];
  S[Shortcuts::grad_beta + 2]         = dtB[0][2];
  S[Shortcuts::grad_beta + 3]         = dtB[1][0];
  S[Shortcuts::grad_beta + 4]         = dtB[1][1];
  S[Shortcuts::grad_beta + 5]         = dtB[1][2];
  S[Shortcuts::grad_beta + 6]         = dtB[2][0];
  S[Shortcuts::grad_beta + 7]         = dtB[2][1];
  S[Shortcuts::grad_beta + 8]         = dtB[2][2];
  S[Shortcuts::grad_gamma_tilde + 0]  = dtD[0][0][0];
  S[Shortcuts::grad_gamma_tilde + 1]  = dtD[0][0][1];
  S[Shortcuts::grad_gamma_tilde + 2]  = dtD[0][0][2];
  S[Shortcuts::grad_gamma_tilde + 3]  = dtD[0][1][1];
  S[Shortcuts::grad_gamma_tilde + 4]  = dtD[0][1][2];
  S[Shortcuts::grad_gamma_tilde + 5]  = dtD[0][2][2];
  S[Shortcuts::grad_gamma_tilde + 6]  = dtD[1][0][0];
  S[Shortcuts::grad_gamma_tilde + 7]  = dtD[1][0][1];
  S[Shortcuts::grad_gamma_tilde + 8]  = dtD[1][0][2];
  S[Shortcuts::grad_gamma_tilde + 9]  = dtD[1][1][1];
  S[Shortcuts::grad_gamma_tilde + 10] = dtD[1][1][2];
  S[Shortcuts::grad_gamma_tilde + 11] = dtD[1][2][2];
  S[Shortcuts::grad_gamma_tilde + 12] = dtD[2][0][0];
  S[Shortcuts::grad_gamma_tilde + 13] = dtD[2][0][1];
  S[Shortcuts::grad_gamma_tilde + 14] = dtD[2][0][2];
  S[Shortcuts::grad_gamma_tilde + 15] = dtD[2][1][1];
  S[Shortcuts::grad_gamma_tilde + 16] = dtD[2][1][2];
  S[Shortcuts::grad_gamma_tilde + 17] = dtD[2][2][2];
  S[Shortcuts::K]                     = dtTraceK;
  S[Shortcuts::phi]                   = dtchi;
  for (int i = 0; i < 3; i++) {
    S[Shortcuts::grad_phi + i] = dtP[i];
  }
}
