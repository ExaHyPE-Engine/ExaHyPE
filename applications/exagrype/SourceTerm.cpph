#include "Constants.h"

#include "tarch/Assertions.h"

/**
 * Writes the algebraic right-hand side of the first-order CCZ4 system.
 * The conformal metric must be positive definite.
 */
template <typename State, typename Source>
INLINE_METHOD GPU_CALLABLE_METHOD void
applications::exahype2::exagrype::sourceTerm(const State& Q, Source& S) {
  const double alpha = std::fmax(1e-4, Q.alpha);

  double fa  = 1.0;
  double faa = 0.0;
  if constexpr (CCZ4LapseType == 1) {
    fa  = 2. / alpha;
    faa = -fa / alpha;
  }

  const auto&  metric     = Q.gamma_tilde;
  const double gCov[3][3] = {
    {metric(0, 0), metric(0, 1), metric(0, 2)},
    {metric(1, 0), metric(1, 1), metric(1, 2)},
    {metric(2, 0), metric(2, 1), metric(2, 2)}
  };
  const double det = gCov[0][0] * gCov[1][1] * gCov[2][2] - gCov[0][0] * gCov[1][2] * gCov[1][2]
    - gCov[0][1] * gCov[0][1] * gCov[2][2] + 2 * gCov[0][1] * gCov[0][2] * gCov[1][2]
    - gCov[0][2] * gCov[0][2] * gCov[1][1];
  ASSERTION(std::isfinite(det) and det > 0.0, det);
  const double invdet = 1. / det;

  const double gContr[3][3] = {
    {(gCov[1][1] * gCov[2][2] - gCov[1][2] * gCov[1][2]) * invdet,
     -(gCov[0][1] * gCov[2][2] - gCov[0][2] * gCov[1][2]) * invdet,
     -(-gCov[0][1] * gCov[1][2] + gCov[0][2] * gCov[1][1]) * invdet},
    {-(gCov[0][1] * gCov[2][2] - gCov[1][2] * gCov[0][2]) * invdet,
     (gCov[0][0] * gCov[2][2] - gCov[0][2] * gCov[0][2]) * invdet,
     -(gCov[0][0] * gCov[1][2] - gCov[0][2] * gCov[0][1]) * invdet},
    {-(-gCov[0][1] * gCov[1][2] + gCov[1][1] * gCov[0][2]) * invdet,
     -(gCov[0][0] * gCov[1][2] - gCov[0][1] * gCov[0][2]) * invdet,
     (gCov[0][0] * gCov[1][1] - gCov[0][1] * gCov[0][1]) * invdet}
  };

  double aEx[3][3] = {
    {Q.A_tilde(0, 0), Q.A_tilde(0, 1), Q.A_tilde(0, 2)},
    {Q.A_tilde(1, 0), Q.A_tilde(1, 1), Q.A_tilde(1, 2)},
    {Q.A_tilde(2, 0), Q.A_tilde(2, 1), Q.A_tilde(2, 2)}
  };

  double traceA = 0;
  for (int i = 0; i < 3; i++) {
    for (int j = 0; j < 3; j++) {
      traceA += gContr[i][j] * aEx[i][j];
    }
  }

  for (int i = 0; i < 3; i++) {
    for (int j = 0; j < 3; j++) {
      aEx[i][j] -= 1. / 3. * traceA * gCov[i][j];
    }
  }

  double aMix[3][3] = {};
  for (int i = 0; i < 3; i++) {
    for (int j = 0; j < 3; j++) {
      for (int u = 0; u < 3; u++) {
        aMix[i][j] += gContr[i][u] * aEx[u][j];
      }
    }
  }
  double aUp[3][3] = {};
  for (int i = 0; i < 3; i++) {
    for (int j = 0; j < 3; j++) {
      for (int u = 0; u < 3; u++) {
        aUp[i][j] += gContr[i][u] * aMix[j][u];
      }
    }
  }

  const double theta = Q.theta;

  double dd[3][3][3];
  for (int k = 0; k < 3; k++) {
    for (int i = 0; i < 3; i++) {
      for (int j = 0; j < 3; j++) {
        dd[k][i][j] = Q.grad_gamma_tilde(k)(i, j);
      }
    }
  }

  // The derivative of the inverse conformal metric follows from d_k(g^ml g_lj) = 0.
  double dgup[3][3][3] = {};
  for (int k = 0; k < 3; k++) {
    for (int m = 0; m < 3; m++) {
      for (int l = 0; l < 3; l++) {
        for (int n = 0; n < 3; n++) {
          for (int j = 0; j < 3; j++) {
            dgup[k][m][l] -= 2.0 * gContr[m][n] * gContr[j][l] * dd[k][n][j];
          }
        }
      }
    }
  }

  const double phi  = std::fmax(1e-2, Q.phi);
  const double phi2 = phi * phi;

  const double pp[3] = {Q.grad_phi(0), Q.grad_phi(1), Q.grad_phi(2)};

  double christoffelTilde[3][3][3] = {};
  for (int j = 0; j < 3; j++) {
    for (int i = 0; i < 3; i++) {
      for (int k = 0; k < 3; k++) {
        for (int l = 0; l < 3; l++) {
          christoffelTilde[i][j][k] += gContr[k][l] * (dd[i][j][l] + dd[j][i][l] - dd[l][i][j]);
        }
      }
    }
  }

  double christoffelTildeDown[3][3][3];
  for (int i = 0; i < 3; i++) {
    for (int j = 0; j < 3; j++) {
      for (int k = 0; k < 3; k++) {
        christoffelTildeDown[i][j][k] = dd[j][k][i] + dd[k][j][i] - dd[i][j][k];
      }
    }
  }

  double gTilde[3] = {};
  for (int l = 0; l < 3; l++) {
    for (int j = 0; j < 3; j++) {
      for (int i = 0; i < 3; i++) {
        gTilde[i] += gContr[j][l] * christoffelTilde[j][l][i];
      }
    }
  }

  const double gHat[3] = {Q.gamma_hat(0), Q.gamma_hat(1), Q.gamma_hat(2)};

  double z[3] = {};
  for (int i = 0; i < 3; i++) {
    for (int j = 0; j < 3; j++) {
      z[i] += 0.5 * CCZ4Ds * (gCov[i][j] * (gHat[j] - gTilde[j]));
    }
  }
  double zUp[3] = {};
  for (int i = 0; i < 3; i++) {
    for (int j = 0; j < 3; j++) {
      zUp[i] += phi2 * gContr[i][j] * z[j];
    }
  }

  // The Ricci tensor includes the symmetrised derivative of the Z4 vector.
  double ricciPlusNablaZSrc[3][3] = {};
  for (int i = 0; i < 3; i++) {
    for (int j = 0; j < 3; j++) {
      for (int k = 0; k < 3; k++) {
        ricciPlusNablaZSrc[i][j] += gHat[k] * dd[k][i][j];
        ricciPlusNablaZSrc[i][j] -= pp[k] * christoffelTilde[i][j][k] / phi;
        ricciPlusNablaZSrc[i][j] +=
          2.0 * zUp[k] / (phi * phi2) * (gCov[i][k] * pp[j] + gCov[j][k] * pp[i] - gCov[i][j] * pp[k]);
        for (int l = 0; l < 3; l++) {
          ricciPlusNablaZSrc[i][j] -= 2.0 * gCov[i][j] * gContr[k][l] * pp[k] * pp[l] / phi2;
          for (int m = 0; m < 3; m++) {
            ricciPlusNablaZSrc[i][j] += gContr[l][m]
              * (christoffelTilde[l][i][k] * christoffelTildeDown[j][k][m]
                 + christoffelTilde[l][j][k] * christoffelTildeDown[i][k][m]
                 + christoffelTilde[i][m][k] * christoffelTildeDown[k][l][j]);
            ricciPlusNablaZSrc[i][j] -= gCov[i][j] * gContr[l][m] * christoffelTilde[l][m][k] * pp[k] / phi;
          }
        }
      }
    }
  }

  double rPlusTwoNablaZSrc = 0;
  for (int i = 0; i < 3; i++) {
    for (int j = 0; j < 3; j++) {
      rPlusTwoNablaZSrc += gContr[i][j] * ricciPlusNablaZSrc[i][j];
    }
  }
  rPlusTwoNablaZSrc *= phi2;

  const double aa[3] = {Q.grad_alpha(0), Q.grad_alpha(1), Q.grad_alpha(2)};

  double nablaijalphaSrc[3][3] = {};
  for (int j = 0; j < 3; j++) {
    for (int i = 0; i < 3; i++) {
      nablaijalphaSrc[i][j] += (pp[i] * aa[j] + pp[j] * aa[i]) / phi;
      for (int k = 0; k < 3; k++) {
        nablaijalphaSrc[i][j] -= christoffelTilde[i][j][k] * aa[k];
        for (int l = 0; l < 3; l++) {
          nablaijalphaSrc[i][j] -= gCov[i][j] * gContr[k][l] * pp[k] * aa[l] / phi;
        }
      }
    }
  }

  double nablanablaalphaSrc = 0;
  for (int i = 0; i < 3; i++) {
    for (int j = 0; j < 3; j++) {
      nablanablaalphaSrc += gContr[i][j] * nablaijalphaSrc[i][j];
    }
  }
  nablanablaalphaSrc *= phi2;

  double secondOrderTermsSrc[3][3];
  for (int i = 0; i < 3; i++) {
    for (int j = 0; j < 3; j++) {
      secondOrderTermsSrc[i][j] = -nablaijalphaSrc[i][j] + alpha * ricciPlusNablaZSrc[i][j];
    }
  }

  double traceSrc = 0;
  for (int i = 0; i < 3; i++) {
    for (int j = 0; j < 3; j++) {
      traceSrc += gContr[i][j] * secondOrderTermsSrc[i][j];
    }
  }

  for (int i = 0; i < 3; i++) {
    for (int j = 0; j < 3; j++) {
      secondOrderTermsSrc[i][j] -= 1. / 3 * traceSrc * gCov[i][j];
    }
  }

  double dtgamma[3][3];
  for (int i = 0; i < 3; i++) {
    for (int j = 0; j < 3; j++) {
      dtgamma[i][j] = -2.0 * alpha * aEx[i][j] - CCZ4Itau * (det - 1.0) * gCov[i][j];
    }
  }

  const double bb[3][3] = {
    {Q.grad_beta(0, 0), Q.grad_beta(0, 1), Q.grad_beta(0, 2)},
    {Q.grad_beta(1, 0), Q.grad_beta(1, 1), Q.grad_beta(1, 2)},
    {Q.grad_beta(2, 0), Q.grad_beta(2, 1), Q.grad_beta(2, 2)}
  };

  const double traceB  = bb[0][0] + bb[1][1] + bb[2][2];
  const double beta[3] = {Q.beta(0), Q.beta(1), Q.beta(2)};

  for (int k = 0; k < 3; k++) {
    for (int j = 0; j < 3; j++) {
      for (int i = 0; i < 3; i++) {
        dtgamma[i][j] +=
          gCov[k][i] * bb[j][k] + gCov[k][j] * bb[i][k] - 2. / 3. * gCov[i][j] * bb[k][k] + 2. * beta[k] * dd[k][i][j];
      }
    }
  }

  double aTemp[3][3] = {};
  for (int i = 0; i < 3; i++) {
    for (int j = 0; j < 3; j++) {
      for (int u = 0; u < 3; u++) {
        aTemp[i][j] += aEx[i][u] * aMix[u][j];
      }
    }
  }

  const double traceK = Q.K;

  double dtK[3][3];
  for (int i = 0; i < 3; i++) {
    for (int j = 0; j < 3; j++) {
      dtK[i][j] =
        phi2 * secondOrderTermsSrc[i][j] + alpha * aEx[i][j] * (traceK - 2. * theta * CCZ4C) - 2. * alpha * aTemp[i][j];
    }
  }

  for (int j = 0; j < 3; j++) {
    for (int i = 0; i < 3; i++) {
      for (int k = 0; k < 3; k++) {
        dtK[i][j] += aEx[k][i] * bb[j][k] + aEx[k][j] * bb[i][k] - 2. / 3. * aEx[i][j] * bb[k][k];
      }
    }
  }

  // K1 enters as K1/alpha. The damping then stays finite where the lapse collapses.
  double dtTraceK = -nablanablaalphaSrc + alpha * (rPlusTwoNablaZSrc + traceK * traceK - 2.0 * CCZ4C * theta * traceK)
    - 3.0 * alpha * CCZ4K1 * (1. + CCZ4K2) * theta / alpha;

  double dtchi = (beta[0] * pp[0] + beta[1] * pp[1] + beta[2] * pp[2]) + 1. / 3. * (alpha * traceK - traceB) * phi;

  double dtalpha = -alpha * alpha * fa * (traceK - CCZ4K0 - 2. * CCZ4C * theta)
    + (beta[0] * aa[0] + beta[1] * aa[1] + beta[2] * aa[2]);

  double aUpDown = 0;
  for (int i = 0; i < 3; i++) {
    for (int j = 0; j < 3; j++) {
      aUpDown += aEx[i][j] * aUp[i][j];
    }
  }

  double sumzupaa = 0.0;
  for (int i = 0; i < 3; i++) {
    sumzupaa += zUp[i] * aa[i];
  }
  double dtTheta = 0.5 * alpha * CCZ4E * CCZ4E * (rPlusTwoNablaZSrc - aUpDown + 2. / 3. * traceK * traceK)
    - alpha * (CCZ4C * theta * traceK + sumzupaa / alpha + CCZ4K1 * (2. + CCZ4K2) * theta / alpha);

  double dtGhat[3] = {};
  for (int i = 0; i < 3; i++) {
    double temp1 = 0, temp2 = 0, temp3 = 0, temp4 = 0, temp5 = 0, temp6 = 0;
    for (int m = 0; m < 3; m++) {
      temp1 += aUp[i][m] * pp[m] / phi;
      temp3 += aUp[i][m] * aa[m] / alpha;
      temp2 += gContr[m][i] * (-theta * aa[m] / alpha - 2. / 3. * traceK * z[m]);
      temp4 += gContr[i][m] * z[m];
      temp5 += gTilde[m] * bb[m][i];
      for (int n = 0; n < 3; n++) {
        temp6 += christoffelTilde[m][n][i] * aUp[m][n];
      }
    }
    dtGhat[i] +=
      2. * alpha * (temp6 - 3. * temp1 + temp2 - temp3 - CCZ4K1 * temp4 / alpha) - temp5 + 2. / 3. * gTilde[i] * traceB;

    for (int l = 0; l < 3; l++) {
      for (int k = 0; k < 3; k++) {
        dtGhat[i] += 2. * CCZ4K3 * (2. / 3. * gContr[i][l] * z[l] * bb[k][k] - gContr[l][k] * z[l] * bb[k][i]);
      }
    }
  }

  double metricDerivativeTrace[3]{};
  double ov[3];
  for (int k = 0; k < 3; k++) {
    for (int i = 0; i < 3; i++) {
      for (int j = 0; j < 3; j++) {
        metricDerivativeTrace[k] += dgup[k][i][j] * aEx[i][j];
      }
    }
    ov[k] = 2 * alpha * metricDerivativeTrace[k];
  }

  for (int i = 0; i < 3; i++) {
    for (int j = 0; j < 3; j++) {
      dtGhat[i] += CCZ4Sk * gContr[i][j] * ov[j];
    }
  }

  const double myb[3] = {Q.b(0), Q.b(1), Q.b(2)};

  double dtbb[3];
  for (int i = 0; i < 3; i++) {
    dtbb[i] = CCZ4Sk * (CCZ4Xi * dtGhat[i] - CCZ4Eta * myb[i]);
  }

  double dtbeta[3];
  for (int i = 0; i < 3; i++) {
    dtbeta[i] = CCZ4F * myb[i];
  }
  for (int i = 0; i < 3; i++) {
    dtbeta[i] += CCZ4Bs * (beta[0] * bb[0][i] + beta[1] * bb[1][i] + beta[2] * bb[2][i]);
  }
  for (int i = 0; i < 3; i++) {
    dtbeta[i] *= CCZ4Sk;
  }

  double dtA[3];
  for (int i = 0; i < 3; i++) {
    dtA[i] = -alpha * aa[i] * (2. * fa + alpha * faa) * (traceK - CCZ4K0 - 2. * CCZ4C * theta);
    for (int j = 0; j < 3; j++) {
      dtA[i] += bb[i][j] * aa[j];
    }
  }

  for (int k = 0; k < 3; k++) {
    dtA[k] += -CCZ4Sk * alpha * alpha * fa * metricDerivativeTrace[k];
  }

  double dtB[3][3] = {};
  for (int i = 0; i < 3; i++) {
    for (int j = 0; j < 3; j++) {
      for (int u = 0; u < 3; u++) {
        dtB[i][j] += CCZ4Sk * (bb[i][u] * bb[u][j]);
      }
    }
  }

  double dtD[3][3][3] = {};
  for (int m = 0; m < 3; m++) {
    for (int j = 0; j < 3; j++) {
      for (int i = 0; i < 3; i++) {
        for (int k = 0; k < 3; k++) {
          for (int n = 0; n < 3; n++) {
            dtD[k][i][j] += 1. / 3 * alpha * gCov[i][j] * dgup[k][n][m] * aEx[n][m];
          }
        }
      }
    }
  }

  for (int j = 0; j < 3; j++) {
    for (int i = 0; i < 3; i++) {
      for (int k = 0; k < 3; k++) {
        dtD[k][i][j] -= aa[k] * aEx[i][j];
        for (int l = 0; l < 3; l++) {
          dtD[k][i][j] +=
            bb[k][l] * dd[l][i][j] + bb[j][l] * dd[k][l][i] + bb[i][l] * dd[k][l][j] - 2. / 3. * bb[l][l] * dd[k][i][j];
        }
      }
    }
  }

  double dtP[3] = {};
  for (int i = 0; i < 3; i++) {
    for (int j = 0; j < 3; j++) {
      dtP[i] += bb[i][j] * pp[j];
    }
  }

  for (int k = 0; k < 3; k++) {
    dtP[k] += 1. / 3. * aa[k] * traceK * phi;
    dtP[k] += 1. / 3. * (alpha * traceK - traceB) * pp[k];
    dtP[k] += 1. / 3. * alpha * CCZ4Sk * metricDerivativeTrace[k] * phi;
  }

  S.theta = dtTheta;
  S.alpha = dtalpha;
  S.K     = dtTraceK;
  S.phi   = dtchi;
  for (int i = 0; i < 3; i++) {
    S.gamma_hat(i)  = dtGhat[i];
    S.beta(i)       = dtbeta[i];
    S.b(i)          = dtbb[i];
    S.grad_alpha(i) = dtA[i];
    S.grad_phi(i)   = dtP[i];
    for (int j = 0; j < 3; j++) {
      S.grad_beta(i, j) = dtB[i][j];
    }
    for (int j = i; j < 3; j++) {
      S.gamma_tilde(i, j) = dtgamma[i][j];
      S.A_tilde(i, j)     = dtK[i][j];
      for (int k = 0; k < 3; k++) {
        S.grad_gamma_tilde(k)(i, j) = dtD[k][i][j];
      }
    }
  }
}
