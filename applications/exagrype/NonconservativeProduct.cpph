/**
 * Writes B(Q) deltaQ for the first-order CCZ4 system, with deltaQ along the axis normal.
 * The conformal metric must be positive definite.
 */
template <class Shortcuts>
INLINE_METHOD GPU_CALLABLE_METHOD void
applications::exahype2::exagrype::nonconservativeProduct(
  const double* const NOALIAS Q,
  const double* const NOALIAS deltaQ,
  const int                   normal,
  double* const NOALIAS       BTimesDeltaQ
) {
  assertion(Q != nullptr and deltaQ != nullptr and BTimesDeltaQ != nullptr);
  assertion(normal >= 0 and normal < 3, normal);
  constexpr double Advection          = 1.0;
  constexpr double AuxiliaryAdvection = 1.0;

  const double alpha  = std::fmax(1e-4, Q[Shortcuts::alpha]);
  const double alpha2 = alpha * alpha;

  double fa = 1.0;
  if constexpr (CCZ4LapseType == 1) {
    fa = 2. / alpha;
  }

  const double g_cov[3][3] = {
    {Q[Shortcuts::gamma_tilde + 0], Q[Shortcuts::gamma_tilde + 1], Q[Shortcuts::gamma_tilde + 2]},
    {Q[Shortcuts::gamma_tilde + 1], Q[Shortcuts::gamma_tilde + 3], Q[Shortcuts::gamma_tilde + 4]},
    {Q[Shortcuts::gamma_tilde + 2], Q[Shortcuts::gamma_tilde + 4], Q[Shortcuts::gamma_tilde + 5]}
  };
  const double invdet = 1.
    / (Q[Shortcuts::gamma_tilde + 0] * Q[Shortcuts::gamma_tilde + 3] * Q[Shortcuts::gamma_tilde + 5]
       - Q[Shortcuts::gamma_tilde + 0] * Q[Shortcuts::gamma_tilde + 4] * Q[Shortcuts::gamma_tilde + 4]
       - Q[Shortcuts::gamma_tilde + 1] * Q[Shortcuts::gamma_tilde + 1] * Q[Shortcuts::gamma_tilde + 5]
       + 2 * Q[Shortcuts::gamma_tilde + 1] * Q[Shortcuts::gamma_tilde + 2] * Q[Shortcuts::gamma_tilde + 4]
       - Q[Shortcuts::gamma_tilde + 2] * Q[Shortcuts::gamma_tilde + 2] * Q[Shortcuts::gamma_tilde + 3]);

  const double g_contr[3][3] = {
    {(Q[Shortcuts::gamma_tilde + 3] * Q[Shortcuts::gamma_tilde + 5]
      - Q[Shortcuts::gamma_tilde + 4] * Q[Shortcuts::gamma_tilde + 4])
       * invdet,
     -(Q[Shortcuts::gamma_tilde + 1] * Q[Shortcuts::gamma_tilde + 5]
       - Q[Shortcuts::gamma_tilde + 2] * Q[Shortcuts::gamma_tilde + 4])
       * invdet,
     -(-Q[Shortcuts::gamma_tilde + 1] * Q[Shortcuts::gamma_tilde + 4]
       + Q[Shortcuts::gamma_tilde + 2] * Q[Shortcuts::gamma_tilde + 3])
       * invdet},
    {-(Q[Shortcuts::gamma_tilde + 1] * Q[Shortcuts::gamma_tilde + 5]
       - Q[Shortcuts::gamma_tilde + 4] * Q[Shortcuts::gamma_tilde + 2])
       * invdet,
     (Q[Shortcuts::gamma_tilde + 0] * Q[Shortcuts::gamma_tilde + 5]
      - Q[Shortcuts::gamma_tilde + 2] * Q[Shortcuts::gamma_tilde + 2])
       * invdet,
     -(Q[Shortcuts::gamma_tilde + 0] * Q[Shortcuts::gamma_tilde + 4]
       - Q[Shortcuts::gamma_tilde + 2] * Q[Shortcuts::gamma_tilde + 1])
       * invdet},
    {-(-Q[Shortcuts::gamma_tilde + 1] * Q[Shortcuts::gamma_tilde + 4]
       + Q[Shortcuts::gamma_tilde + 3] * Q[Shortcuts::gamma_tilde + 2])
       * invdet,
     -(Q[Shortcuts::gamma_tilde + 0] * Q[Shortcuts::gamma_tilde + 4]
       - Q[Shortcuts::gamma_tilde + 1] * Q[Shortcuts::gamma_tilde + 2])
       * invdet,
     (Q[Shortcuts::gamma_tilde + 0] * Q[Shortcuts::gamma_tilde + 3]
      - Q[Shortcuts::gamma_tilde + 1] * Q[Shortcuts::gamma_tilde + 1])
       * invdet}
  };

  assertion(std::isfinite(invdet) and invdet > 0.0, invdet);
  const double phi  = std::fmax(1e-2, Q[Shortcuts::phi]);
  const double phi2 = phi * phi;

  const double beta[3] = {Q[Shortcuts::beta + 0], Q[Shortcuts::beta + 1], Q[Shortcuts::beta + 2]};

  double dPP[3][3]       = {};
  double dAA[3][3]       = {};
  double dGhat[3][3]     = {};
  double dBeta[3][3]     = {};
  double dTraceK[3]      = {};
  double dTheta[3]       = {};
  double dAex[3][3][3]   = {};
  double dBB[3][3][3]    = {};
  double dDD[3][3][3][3] = {};

  for (int i = 0; i < 3; i++) {
    dPP[normal][i]   = deltaQ[Shortcuts::grad_phi + i];
    dAA[normal][i]   = deltaQ[Shortcuts::grad_alpha + i];
    dGhat[normal][i] = deltaQ[Shortcuts::gamma_hat + i];
    dBeta[normal][i] = deltaQ[Shortcuts::b + i];
  }
  dTraceK[normal] = deltaQ[Shortcuts::K];
  dTheta[normal]  = deltaQ[Shortcuts::theta];

  constexpr int SymmetricEntry[3][3] = {{0, 1, 2}, {1, 3, 4}, {2, 4, 5}};
  for (int i = 0; i < 3; i++) {
    for (int j = 0; j < 3; j++) {
      const int entry      = SymmetricEntry[i][j];
      dAex[normal][i][j]   = deltaQ[Shortcuts::A_tilde + entry];
      dBB[normal][i][j]    = CCZ4Sk * deltaQ[Shortcuts::grad_beta + 3 * i + j];
      dDD[normal][0][i][j] = deltaQ[Shortcuts::grad_gamma_tilde + 0 + entry];
      dDD[normal][1][i][j] = deltaQ[Shortcuts::grad_gamma_tilde + 6 + entry];
      dDD[normal][2][i][j] = deltaQ[Shortcuts::grad_gamma_tilde + 12 + entry];
    }
  }

  double ricciPlusNablaZNcp[3][3] = {};
  for (int i = 0; i < 3; i++) {
    for (int j = 0; j < 3; j++) {
      ricciPlusNablaZNcp[i][j] += 0.5 * (dPP[i][j] + dPP[j][i]) / phi;
      for (int k = 0; k < 3; k++) {
        ricciPlusNablaZNcp[i][j] += 0.5 * (g_cov[k][i] * dGhat[j][k] + g_cov[k][j] * dGhat[i][k]);
        for (int l = 0; l < 3; l++) {
          ricciPlusNablaZNcp[i][j] -= 0.5 * g_contr[k][l] * (dDD[k][l][i][j] + dDD[l][k][i][j]);
          ricciPlusNablaZNcp[i][j] += 0.5 * g_cov[i][j] * g_contr[k][l] * (dPP[k][l] + dPP[l][k]) / phi;
        }
      }
    }
  }

  double rPlusTwoNablaZNcp = 0;
  for (int i = 0; i < 3; i++) {
    for (int j = 0; j < 3; j++) {
      rPlusTwoNablaZNcp += g_contr[i][j] * ricciPlusNablaZNcp[i][j];
    }
  }
  rPlusTwoNablaZNcp *= phi2;

  double nablaijalphaNCP[3][3];
  for (int i = 0; i < 3; i++) {
    for (int j = 0; j < 3; j++) {
      nablaijalphaNCP[i][j] = 0.5 * (dAA[i][j] + dAA[j][i]);
    }
  }

  double nablanablaalphaNCP = 0;
  for (int i = 0; i < 3; i++) {
    for (int j = 0; j < 3; j++) {
      nablanablaalphaNCP += g_contr[i][j] * nablaijalphaNCP[i][j];
    }
  }
  nablanablaalphaNCP *= phi2;

  double secondOrderTermsNcp[3][3];
  for (int i = 0; i < 3; i++) {
    for (int j = 0; j < 3; j++) {
      secondOrderTermsNcp[i][j] = -nablaijalphaNCP[i][j] + alpha * ricciPlusNablaZNcp[i][j];
    }
  }

  double traceNCP = 0;
  for (int i = 0; i < 3; i++) {
    for (int j = 0; j < 3; j++) {
      traceNCP += g_contr[i][j] * secondOrderTermsNcp[i][j];
    }
  }

  for (int i = 0; i < 3; i++) {
    for (int j = 0; j < 3; j++) {
      secondOrderTermsNcp[i][j] -= 1. / 3 * traceNCP * g_cov[i][j];
    }
  }

  double dtK[3][3];
  for (int i = 0; i < 3; i++) {
    for (int j = 0; j < 3; j++) {
      dtK[i][j] = phi2 * secondOrderTermsNcp[i][j]
        + Advection * (beta[0] * dAex[0][i][j] + beta[1] * dAex[1][i][j] + beta[2] * dAex[2][i][j]);
    }
  }

  const double dtTraceK = -nablanablaalphaNCP + alpha * rPlusTwoNablaZNcp
    + Advection * (beta[0] * dTraceK[0] + beta[1] * dTraceK[1] + beta[2] * dTraceK[2]);

  const double dtTheta = 0.5 * alpha * CCZ4E * CCZ4E * rPlusTwoNablaZNcp
    + Advection * (beta[0] * dTheta[0] + beta[1] * dTheta[1] + beta[2] * dTheta[2]);

  double dtGhat[3];
  for (int i = 0; i < 3; i++) {
    double temp = 0, temp2 = 0;
    for (int j = 0; j < 3; j++) {
      temp += g_contr[i][j] * dTraceK[j];
      temp2 += g_contr[j][i] * dTheta[j];
    }
    dtGhat[i] = -4. / 3. * alpha * temp + 2 * alpha * temp2
      + Advection * (beta[0] * dGhat[0][i] + beta[1] * dGhat[1][i] + beta[2] * dGhat[2][i]);
    for (int l = 0; l < 3; l++) {
      for (int k = 0; k < 3; k++) {
        dtGhat[i] += g_contr[k][l] * 0.5 * (dBB[k][l][i] + dBB[l][k][i])
          + 1. / 3. * g_contr[i][k] * 0.5 * (dBB[k][l][l] + dBB[l][k][l]);
      }
    }
  }

  double curvatureDerivativeTrace[3]{};
  double ov[3];
  for (int k = 0; k < 3; k++) {
    for (int i = 0; i < 3; i++) {
      for (int j = 0; j < 3; j++) {
        curvatureDerivativeTrace[k] += g_contr[i][j] * dAex[k][i][j];
      }
    }
    ov[k] = 2 * alpha * curvatureDerivativeTrace[k];
  }
  for (int i = 0; i < 3; i++) {
    for (int j = 0; j < 3; j++) {
      dtGhat[i] += CCZ4Sk * g_contr[i][j] * ov[j];
    }
  }

  double dtbb[3];
  for (int i = 0; i < 3; i++) {
    dtbb[i] = CCZ4Xi * dtGhat[i]
      + CCZ4Bs * Advection
        * (beta[0] * dBeta[0][i] + beta[1] * dBeta[1][i] + beta[2] * dBeta[2][i] - beta[0] * dGhat[0][i] - beta[1] * dGhat[1][i] - beta[2] * dGhat[2][i]);
    dtbb[i] *= CCZ4Sk;
  }

  double dtA[3];
  for (int i = 0; i < 3; i++) {
    dtA[i] = -alpha2 * fa * (dTraceK[i] - 2 * CCZ4C * dTheta[i])
      + AuxiliaryAdvection * (beta[0] * dAA[0][i] + beta[1] * dAA[1][i] + beta[2] * dAA[2][i]);
  }
  for (int k = 0; k < 3; k++) {
    dtA[k] -= CCZ4Sk * alpha * alpha * fa * curvatureDerivativeTrace[k];
  }

  double dtB[3][3];
  for (int k = 0; k < 3; k++) {
    for (int i = 0; i < 3; i++) {
      dtB[k][i] = CCZ4F * dBeta[k][i];
    }
  }
  for (int i = 0; i < 3; i++) {
    for (int k = 0; k < 3; k++) {
      for (int j = 0; j < 3; j++) {
        dtB[k][i] += CCZ4Mu * alpha2 * g_contr[i][j] * (dPP[k][j] - dPP[j][k]) / phi;
        for (int n = 0; n < 3; n++) {
          for (int l = 0; l < 3; l++) {
            dtB[k][i] -= CCZ4Mu * alpha2 * g_contr[i][j] * g_contr[n][l] * (dDD[k][l][j][n] - dDD[l][k][j][n]);
          }
        }
      }
    }
  }
  for (int i = 0; i < 3; i++) {
    for (int j = 0; j < 3; j++) {
      dtB[i][j] +=
        CCZ4Bs * AuxiliaryAdvection * (beta[0] * dBB[0][i][j] + beta[1] * dBB[1][i][j] + beta[2] * dBB[2][i][j]);
      dtB[i][j] *= CCZ4Sk;
    }
  }

  double dtD[3][3][3];
  for (int i = 0; i < 3; i++) {
    for (int j = 0; j < 3; j++) {
      for (int k = 0; k < 3; k++) {
        dtD[i][j][k] = -alpha * dAex[i][j][k];
      }
    }
  }
  for (int i = 0; i < 3; i++) {
    for (int j = 0; j < 3; j++) {
      for (int k = 0; k < 3; k++) {
        for (int m = 0; m < 3; m++) {
          dtD[k][i][j] +=
            0.25 * (g_cov[m][i] * (dBB[k][j][m] + dBB[j][k][m]) + g_cov[m][j] * (dBB[k][i][m] + dBB[i][k][m]))
            - 1. / 6. * g_cov[i][j] * (dBB[k][m][m] + dBB[m][k][m]);
          for (int n = 0; n < 3; n++) {
            dtD[k][i][j] += 1. / 3 * alpha * g_cov[i][j] * g_contr[n][m] * dAex[k][n][m];
          }
        }
      }
    }
  }
  for (int i = 0; i < 3; i++) {
    for (int j = 0; j < 3; j++) {
      for (int k = 0; k < 3; k++) {
        dtD[i][j][k] +=
          AuxiliaryAdvection * (beta[0] * dDD[0][i][j][k] + beta[1] * dDD[1][i][j][k] + beta[2] * dDD[2][i][j][k]);
      }
    }
  }

  double dtP[3];
  for (int i = 0; i < 3; i++) {
    dtP[i] = AuxiliaryAdvection * (beta[0] * dPP[0][i] + beta[1] * dPP[1][i] + beta[2] * dPP[2][i]);
  }
  for (int k = 0; k < 3; k++) {
    dtP[k] += 1. / 3. * phi * alpha * dTraceK[k];
    dtP[k] += 1. / 3. * phi * alpha * CCZ4Sk * curvatureDerivativeTrace[k];
    for (int i = 0; i < 3; i++) {
      dtP[k] -= 1. / 6. * phi * (dBB[k][i][i] + dBB[i][k][i]);
    }
  }

  // The source term computes advection of the metric, lapse, shift and conformal factor.
  BTimesDeltaQ[Shortcuts::gamma_tilde + 0] = 0.0;
  BTimesDeltaQ[Shortcuts::gamma_tilde + 1] = 0.0;
  BTimesDeltaQ[Shortcuts::gamma_tilde + 2] = 0.0;
  BTimesDeltaQ[Shortcuts::gamma_tilde + 3] = 0.0;
  BTimesDeltaQ[Shortcuts::gamma_tilde + 4] = 0.0;
  BTimesDeltaQ[Shortcuts::gamma_tilde + 5] = 0.0;
  BTimesDeltaQ[Shortcuts::A_tilde + 0]     = -dtK[0][0];
  BTimesDeltaQ[Shortcuts::A_tilde + 1]     = -dtK[0][1];
  BTimesDeltaQ[Shortcuts::A_tilde + 2]     = -dtK[0][2];
  BTimesDeltaQ[Shortcuts::A_tilde + 3]     = -dtK[1][1];
  BTimesDeltaQ[Shortcuts::A_tilde + 4]     = -dtK[1][2];
  BTimesDeltaQ[Shortcuts::A_tilde + 5]     = -dtK[2][2];
  BTimesDeltaQ[Shortcuts::theta]           = -dtTheta;
  for (int i = 0; i < 3; i++) {
    BTimesDeltaQ[Shortcuts::gamma_hat + i] = -dtGhat[i];
  }
  BTimesDeltaQ[Shortcuts::alpha] = 0.0;
  for (int i = 0; i < 3; i++) {
    BTimesDeltaQ[Shortcuts::beta + i] = 0.0;
  }
  for (int i = 0; i < 3; i++) {
    BTimesDeltaQ[Shortcuts::b + i] = -dtbb[i];
  }
  for (int i = 0; i < 3; i++) {
    BTimesDeltaQ[Shortcuts::grad_alpha + i] = -dtA[i];
  }
  BTimesDeltaQ[Shortcuts::grad_beta + 0] = -dtB[0][0];
  BTimesDeltaQ[Shortcuts::grad_beta + 1] = -dtB[0][1];
  BTimesDeltaQ[Shortcuts::grad_beta + 2] = -dtB[0][2];
  BTimesDeltaQ[Shortcuts::grad_beta + 3] = -dtB[1][0];
  BTimesDeltaQ[Shortcuts::grad_beta + 4] = -dtB[1][1];
  BTimesDeltaQ[Shortcuts::grad_beta + 5] = -dtB[1][2];
  BTimesDeltaQ[Shortcuts::grad_beta + 6] = -dtB[2][0];
  BTimesDeltaQ[Shortcuts::grad_beta + 7] = -dtB[2][1];
  BTimesDeltaQ[Shortcuts::grad_beta + 8] = -dtB[2][2];

  BTimesDeltaQ[Shortcuts::grad_gamma_tilde + 0] = -dtD[0][0][0];
  BTimesDeltaQ[Shortcuts::grad_gamma_tilde + 1] = -dtD[0][0][1];
  BTimesDeltaQ[Shortcuts::grad_gamma_tilde + 2] = -dtD[0][0][2];
  BTimesDeltaQ[Shortcuts::grad_gamma_tilde + 3] = -dtD[0][1][1];
  BTimesDeltaQ[Shortcuts::grad_gamma_tilde + 4] = -dtD[0][1][2];
  BTimesDeltaQ[Shortcuts::grad_gamma_tilde + 5] = -dtD[0][2][2];

  BTimesDeltaQ[Shortcuts::grad_gamma_tilde + 6]  = -dtD[1][0][0];
  BTimesDeltaQ[Shortcuts::grad_gamma_tilde + 7]  = -dtD[1][0][1];
  BTimesDeltaQ[Shortcuts::grad_gamma_tilde + 8]  = -dtD[1][0][2];
  BTimesDeltaQ[Shortcuts::grad_gamma_tilde + 9]  = -dtD[1][1][1];
  BTimesDeltaQ[Shortcuts::grad_gamma_tilde + 10] = -dtD[1][1][2];
  BTimesDeltaQ[Shortcuts::grad_gamma_tilde + 11] = -dtD[1][2][2];

  BTimesDeltaQ[Shortcuts::grad_gamma_tilde + 12] = -dtD[2][0][0];
  BTimesDeltaQ[Shortcuts::grad_gamma_tilde + 13] = -dtD[2][0][1];
  BTimesDeltaQ[Shortcuts::grad_gamma_tilde + 14] = -dtD[2][0][2];
  BTimesDeltaQ[Shortcuts::grad_gamma_tilde + 15] = -dtD[2][1][1];
  BTimesDeltaQ[Shortcuts::grad_gamma_tilde + 16] = -dtD[2][1][2];
  BTimesDeltaQ[Shortcuts::grad_gamma_tilde + 17] = -dtD[2][2][2];
  BTimesDeltaQ[Shortcuts::K]                     = -dtTraceK;
  BTimesDeltaQ[Shortcuts::phi]                   = 0.0;
  for (int i = 0; i < 3; i++) {
    BTimesDeltaQ[Shortcuts::grad_phi + i] = -dtP[i];
  }
}
