#include "Constants.h"

#include "tarch/Assertions.h"

/**
 * Writes B(Q) deltaQ for the first-order CCZ4 system. deltaQ is the difference along the axis normal.
 * The conformal metric must be positive definite.
 */
template <typename State, typename Difference, typename NonconservativeProduct>
INLINE_METHOD GPU_CALLABLE_METHOD void
applications::exahype2::exagrype::nonconservativeProduct(
  const State&            Q,
  const Difference&       deltaQ,
  const int               normal,
  NonconservativeProduct& BTimesDeltaQ
) {
  ASSERTION(normal >= 0 and normal < 3, normal);
  constexpr double Advection          = 1.0;
  constexpr double AuxiliaryAdvection = 1.0;

  const double alpha  = std::fmax(1e-4, Q.alpha);
  const double alpha2 = alpha * alpha;

  double fa = 1.0;
  if constexpr (CCZ4LapseType == 1) {
    fa = 2. / alpha;
  }

  const auto&  metric     = Q.gamma_tilde;
  const double gCov[3][3] = {
    {metric(0, 0), metric(0, 1), metric(0, 2)},
    {metric(1, 0), metric(1, 1), metric(1, 2)},
    {metric(2, 0), metric(2, 1), metric(2, 2)}
  };
  const double invdet = 1.
    / (gCov[0][0] * gCov[1][1] * gCov[2][2] - gCov[0][0] * gCov[1][2] * gCov[1][2]
       - gCov[0][1] * gCov[0][1] * gCov[2][2] + 2 * gCov[0][1] * gCov[0][2] * gCov[1][2]
       - gCov[0][2] * gCov[0][2] * gCov[1][1]);

  const double gContr[3][3] = {
    {(gCov[1][1] * gCov[2][2] - gCov[1][2] * gCov[1][2]) * invdet,
     -(gCov[0][1] * gCov[2][2] - gCov[0][2] * gCov[1][2]) * invdet,
     -(-gCov[0][1] * gCov[1][2] + gCov[0][2] * gCov[1][1]) * invdet},
    {-(gCov[0][1] * gCov[2][2] - gCov[1][2] * gCov[0][2]) * invdet,
     (gCov[0][0] * gCov[2][2] - gCov[0][2] * gCov[0][2]) * invdet,
     -(gCov[0][0] * gCov[1][2] - gCov[0][2] * gCov[0][1]) * invdet},
    {-(-gCov[0][1] * gCov[1][2] + gCov[1][1] * gCov[0][2]) * invdet,
     -(gCov[0][0] * gCov[1][2] - gCov[0][1] * gCov[0][2]) * invdet,
     (gCov[0][0] * gCov[1][1] - gCov[0][1] * gCov[0][1]) * invdet}
  };

  ASSERTION(std::isfinite(invdet) and invdet > 0.0, invdet);
  const double phi  = std::fmax(1e-2, Q.phi);
  const double phi2 = phi * phi;

  const double beta[3] = {Q.beta(0), Q.beta(1), Q.beta(2)};

  double dPP[3][3]       = {};
  double dAA[3][3]       = {};
  double dGhat[3][3]     = {};
  double dBeta[3][3]     = {};
  double dTraceK[3]      = {};
  double dTheta[3]       = {};
  double dAex[3][3][3]   = {};
  double dBB[3][3][3]    = {};
  double dDD[3][3][3][3] = {};

  for (int i = 0; i < 3; i++) {
    dPP[normal][i]   = deltaQ.grad_phi(i);
    dAA[normal][i]   = deltaQ.grad_alpha(i);
    dGhat[normal][i] = deltaQ.gamma_hat(i);
    dBeta[normal][i] = deltaQ.b(i);
  }
  dTraceK[normal] = deltaQ.K;
  dTheta[normal]  = deltaQ.theta;

  for (int i = 0; i < 3; i++) {
    for (int j = 0; j < 3; j++) {
      dAex[normal][i][j]   = deltaQ.A_tilde(i, j);
      dBB[normal][i][j]    = CCZ4Sk * deltaQ.grad_beta(i, j);
      dDD[normal][0][i][j] = deltaQ.grad_gamma_tilde(0)(i, j);
      dDD[normal][1][i][j] = deltaQ.grad_gamma_tilde(1)(i, j);
      dDD[normal][2][i][j] = deltaQ.grad_gamma_tilde(2)(i, j);
    }
  }

  double ricciPlusNablaZNcp[3][3] = {};
  for (int i = 0; i < 3; i++) {
    for (int j = 0; j < 3; j++) {
      ricciPlusNablaZNcp[i][j] += 0.5 * (dPP[i][j] + dPP[j][i]) / phi;
      for (int k = 0; k < 3; k++) {
        ricciPlusNablaZNcp[i][j] += 0.5 * (gCov[k][i] * dGhat[j][k] + gCov[k][j] * dGhat[i][k]);
        for (int l = 0; l < 3; l++) {
          ricciPlusNablaZNcp[i][j] -= 0.5 * gContr[k][l] * (dDD[k][l][i][j] + dDD[l][k][i][j]);
          ricciPlusNablaZNcp[i][j] += 0.5 * gCov[i][j] * gContr[k][l] * (dPP[k][l] + dPP[l][k]) / phi;
        }
      }
    }
  }

  double rPlusTwoNablaZNcp = 0;
  for (int i = 0; i < 3; i++) {
    for (int j = 0; j < 3; j++) {
      rPlusTwoNablaZNcp += gContr[i][j] * ricciPlusNablaZNcp[i][j];
    }
  }
  rPlusTwoNablaZNcp *= phi2;

  double nablaijalphaNCP[3][3];
  for (int i = 0; i < 3; i++) {
    for (int j = 0; j < 3; j++) {
      nablaijalphaNCP[i][j] = 0.5 * (dAA[i][j] + dAA[j][i]);
    }
  }

  double nablanablaalphaNCP = 0;
  for (int i = 0; i < 3; i++) {
    for (int j = 0; j < 3; j++) {
      nablanablaalphaNCP += gContr[i][j] * nablaijalphaNCP[i][j];
    }
  }
  nablanablaalphaNCP *= phi2;

  double secondOrderTermsNcp[3][3];
  for (int i = 0; i < 3; i++) {
    for (int j = 0; j < 3; j++) {
      secondOrderTermsNcp[i][j] = -nablaijalphaNCP[i][j] + alpha * ricciPlusNablaZNcp[i][j];
    }
  }

  double traceNCP = 0;
  for (int i = 0; i < 3; i++) {
    for (int j = 0; j < 3; j++) {
      traceNCP += gContr[i][j] * secondOrderTermsNcp[i][j];
    }
  }

  for (int i = 0; i < 3; i++) {
    for (int j = 0; j < 3; j++) {
      secondOrderTermsNcp[i][j] -= 1. / 3 * traceNCP * gCov[i][j];
    }
  }

  double dtK[3][3];
  for (int i = 0; i < 3; i++) {
    for (int j = 0; j < 3; j++) {
      dtK[i][j] = phi2 * secondOrderTermsNcp[i][j]
        + Advection * (beta[0] * dAex[0][i][j] + beta[1] * dAex[1][i][j] + beta[2] * dAex[2][i][j]);
    }
  }

  const double dtTraceK = -nablanablaalphaNCP + alpha * rPlusTwoNablaZNcp
    + Advection * (beta[0] * dTraceK[0] + beta[1] * dTraceK[1] + beta[2] * dTraceK[2]);

  const double dtTheta = 0.5 * alpha * CCZ4E * CCZ4E * rPlusTwoNablaZNcp
    + Advection * (beta[0] * dTheta[0] + beta[1] * dTheta[1] + beta[2] * dTheta[2]);

  double dtGhat[3];
  for (int i = 0; i < 3; i++) {
    double temp = 0, temp2 = 0;
    for (int j = 0; j < 3; j++) {
      temp += gContr[i][j] * dTraceK[j];
      temp2 += gContr[j][i] * dTheta[j];
    }
    dtGhat[i] = -4. / 3. * alpha * temp + 2 * alpha * temp2
      + Advection * (beta[0] * dGhat[0][i] + beta[1] * dGhat[1][i] + beta[2] * dGhat[2][i]);
    for (int l = 0; l < 3; l++) {
      for (int k = 0; k < 3; k++) {
        dtGhat[i] += gContr[k][l] * 0.5 * (dBB[k][l][i] + dBB[l][k][i])
          + 1. / 3. * gContr[i][k] * 0.5 * (dBB[k][l][l] + dBB[l][k][l]);
      }
    }
  }

  double curvatureDerivativeTrace[3]{};
  double ov[3];
  for (int k = 0; k < 3; k++) {
    for (int i = 0; i < 3; i++) {
      for (int j = 0; j < 3; j++) {
        curvatureDerivativeTrace[k] += gContr[i][j] * dAex[k][i][j];
      }
    }
    ov[k] = 2 * alpha * curvatureDerivativeTrace[k];
  }
  for (int i = 0; i < 3; i++) {
    for (int j = 0; j < 3; j++) {
      dtGhat[i] += CCZ4Sk * gContr[i][j] * ov[j];
    }
  }

  double dtbb[3];
  for (int i = 0; i < 3; i++) {
    dtbb[i] = CCZ4Xi * dtGhat[i]
      + CCZ4Bs * Advection
        * (beta[0] * dBeta[0][i] + beta[1] * dBeta[1][i] + beta[2] * dBeta[2][i] - beta[0] * dGhat[0][i] - beta[1] * dGhat[1][i] - beta[2] * dGhat[2][i]);
    dtbb[i] *= CCZ4Sk;
  }

  double dtA[3];
  for (int i = 0; i < 3; i++) {
    dtA[i] = -alpha2 * fa * (dTraceK[i] - 2 * CCZ4C * dTheta[i])
      + AuxiliaryAdvection * (beta[0] * dAA[0][i] + beta[1] * dAA[1][i] + beta[2] * dAA[2][i]);
  }
  for (int k = 0; k < 3; k++) {
    dtA[k] -= CCZ4Sk * alpha * alpha * fa * curvatureDerivativeTrace[k];
  }

  double dtB[3][3];
  for (int k = 0; k < 3; k++) {
    for (int i = 0; i < 3; i++) {
      dtB[k][i] = CCZ4F * dBeta[k][i];
    }
  }
  for (int i = 0; i < 3; i++) {
    for (int k = 0; k < 3; k++) {
      for (int j = 0; j < 3; j++) {
        dtB[k][i] += CCZ4Mu * alpha2 * gContr[i][j] * (dPP[k][j] - dPP[j][k]) / phi;
        for (int n = 0; n < 3; n++) {
          for (int l = 0; l < 3; l++) {
            dtB[k][i] -= CCZ4Mu * alpha2 * gContr[i][j] * gContr[n][l] * (dDD[k][l][j][n] - dDD[l][k][j][n]);
          }
        }
      }
    }
  }
  for (int i = 0; i < 3; i++) {
    for (int j = 0; j < 3; j++) {
      dtB[i][j] +=
        CCZ4Bs * AuxiliaryAdvection * (beta[0] * dBB[0][i][j] + beta[1] * dBB[1][i][j] + beta[2] * dBB[2][i][j]);
      dtB[i][j] *= CCZ4Sk;
    }
  }

  double dtD[3][3][3];
  for (int i = 0; i < 3; i++) {
    for (int j = 0; j < 3; j++) {
      for (int k = 0; k < 3; k++) {
        dtD[i][j][k] = -alpha * dAex[i][j][k];
      }
    }
  }
  for (int i = 0; i < 3; i++) {
    for (int j = 0; j < 3; j++) {
      for (int k = 0; k < 3; k++) {
        for (int m = 0; m < 3; m++) {
          dtD[k][i][j] +=
            0.25 * (gCov[m][i] * (dBB[k][j][m] + dBB[j][k][m]) + gCov[m][j] * (dBB[k][i][m] + dBB[i][k][m]))
            - 1. / 6. * gCov[i][j] * (dBB[k][m][m] + dBB[m][k][m]);
          for (int n = 0; n < 3; n++) {
            dtD[k][i][j] += 1. / 3 * alpha * gCov[i][j] * gContr[n][m] * dAex[k][n][m];
          }
        }
      }
    }
  }
  for (int i = 0; i < 3; i++) {
    for (int j = 0; j < 3; j++) {
      for (int k = 0; k < 3; k++) {
        dtD[i][j][k] +=
          AuxiliaryAdvection * (beta[0] * dDD[0][i][j][k] + beta[1] * dDD[1][i][j][k] + beta[2] * dDD[2][i][j][k]);
      }
    }
  }

  double dtP[3];
  for (int i = 0; i < 3; i++) {
    dtP[i] = AuxiliaryAdvection * (beta[0] * dPP[0][i] + beta[1] * dPP[1][i] + beta[2] * dPP[2][i]);
  }
  for (int k = 0; k < 3; k++) {
    dtP[k] += 1. / 3. * phi * alpha * dTraceK[k];
    dtP[k] += 1. / 3. * phi * alpha * CCZ4Sk * curvatureDerivativeTrace[k];
    for (int i = 0; i < 3; i++) {
      dtP[k] -= 1. / 6. * phi * (dBB[k][i][i] + dBB[i][k][i]);
    }
  }

  // The source term computes advection of the metric, lapse, shift and conformal factor.
  BTimesDeltaQ       = {};
  BTimesDeltaQ.theta = -dtTheta;
  BTimesDeltaQ.K     = -dtTraceK;
  for (int i = 0; i < 3; i++) {
    BTimesDeltaQ.gamma_hat(i)  = -dtGhat[i];
    BTimesDeltaQ.b(i)          = -dtbb[i];
    BTimesDeltaQ.grad_alpha(i) = -dtA[i];
    BTimesDeltaQ.grad_phi(i)   = -dtP[i];
    for (int j = 0; j < 3; j++) {
      BTimesDeltaQ.grad_beta(i, j) = -dtB[i][j];
    }
    for (int j = i; j < 3; j++) {
      BTimesDeltaQ.A_tilde(i, j) = -dtK[i][j];
      for (int k = 0; k < 3; k++) {
        BTimesDeltaQ.grad_gamma_tilde(k)(i, j) = -dtD[k][i][j];
      }
    }
  }
}
