#include "Constants.h"

#include "tarch/Assertions.h"

/**
 * Returns an upper bound on the coordinate signal speed along the axis normal.
 * The conformal metric must be positive definite.
 */
template <typename State>
INLINE_METHOD GPU_CALLABLE_METHOD double
applications::exahype2::exagrype::maxEigenvalue(const State& Q, const int normal) {
  ASSERTION(normal >= 0 and normal < 3, normal);
  const auto&  metric       = Q.gamma_tilde;
  const double cofactors[3] = {
    metric(1, 1) * metric(2, 2) - metric(1, 2) * metric(1, 2),
    metric(0, 0) * metric(2, 2) - metric(0, 2) * metric(0, 2),
    metric(0, 0) * metric(1, 1) - metric(0, 1) * metric(0, 1)
  };
  const double determinant = metric(0, 0) * cofactors[0]
    - metric(0, 1) * (metric(0, 1) * metric(2, 2) - metric(0, 2) * metric(1, 2))
    + metric(0, 2) * (metric(0, 1) * metric(1, 2) - metric(0, 2) * metric(1, 1));
  ASSERTION(std::isfinite(determinant) and determinant > 0.0, determinant);
  ASSERTION(metric(0, 0) > 0.0 and cofactors[2] > 0.0, metric(0, 0), cofactors[2]);
  ASSERTION(std::isfinite(Q.alpha) and Q.alpha > 0.0);
  ASSERTION(std::isfinite(Q.phi) and Q.phi > 0.0);
  ASSERTION(std::isfinite(Q.beta(normal)));

  const double alpha = std::fmax(1.0, Q.alpha) * std::fmax(1.0, Q.phi) * std::sqrt(cofactors[normal] / determinant);

  constexpr double SquareRootOfTwo = 1.4142135623730951;
  const double     gaugeSpeed = alpha * std::fmax(std::fmax(SquareRootOfTwo, CCZ4E), std::fmax(CCZ4Ds, 2.0 / alpha));
  const double     shiftSpeed = Q.beta(normal);
  return std::fmax(std::abs(gaugeSpeed + shiftSpeed), std::abs(gaugeSpeed - shiftSpeed));
}
