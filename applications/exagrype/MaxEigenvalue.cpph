/**
 * Returns a bound on the coordinate signal speed along normal.
 * The conformal metric must be positive definite.
 */
template <class Shortcuts>
INLINE_METHOD GPU_CALLABLE_METHOD double applications::exahype2::exagrype::maxEigenvalue(
  const double* const NOALIAS Q,
  const int                   normal
) {
  assertion(Q != nullptr);
  assertion(normal >= 0 and normal < 3, normal);
  const auto* const metric       = Q + Shortcuts::gamma_tilde;
  const double      cofactors[3] = {
    metric[3] * metric[5] - metric[4] * metric[4],
    metric[0] * metric[5] - metric[2] * metric[2],
    metric[0] * metric[3] - metric[1] * metric[1]
  };
  const double determinant = metric[0] * cofactors[0] - metric[1] * (metric[1] * metric[5] - metric[2] * metric[4])
    + metric[2] * (metric[1] * metric[4] - metric[2] * metric[3]);
  assertion(std::isfinite(determinant) and determinant > 0.0, determinant);
  assertion(metric[0] > 0.0 and cofactors[2] > 0.0, metric[0], cofactors[2]);
  assertion(std::isfinite(Q[Shortcuts::alpha]) and Q[Shortcuts::alpha] > 0.0);
  assertion(std::isfinite(Q[Shortcuts::phi]) and Q[Shortcuts::phi] > 0.0);
  assertion(std::isfinite(Q[Shortcuts::beta + normal]));

  const double alpha = std::fmax(1.0, Q[Shortcuts::alpha]) * std::fmax(1.0, Q[Shortcuts::phi])
    * std::sqrt(cofactors[normal] / determinant);

  constexpr double SquareRootOfTwo = 1.4142135623730951;
  const double     gaugeSpeed = alpha * std::fmax(std::fmax(SquareRootOfTwo, CCZ4E), std::fmax(CCZ4Ds, 2.0 / alpha));
  const double     shiftSpeed = Q[Shortcuts::beta + normal];
  return std::fmax(std::abs(gaugeSpeed + shiftSpeed), std::abs(gaugeSpeed - shiftSpeed));
}
