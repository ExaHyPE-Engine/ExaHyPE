#include "tarch/Assertions.h"

/**
 * Normalises the conformal metric of Q and removes the traces of A_tilde and D_kij.
 * Clamps the lapse and the conformal factor to positive values.
 * The conformal metric must be positive definite.
 */
template <typename State>
INLINE_METHOD GPU_CALLABLE_METHOD void
applications::exahype2::exagrype::enforceCCZ4Constraints(State& Q) {
  double gCov[3][3] = {
    {Q.gamma_tilde(0, 0), Q.gamma_tilde(0, 1), Q.gamma_tilde(0, 2)},
    {Q.gamma_tilde(1, 0), Q.gamma_tilde(1, 1), Q.gamma_tilde(1, 2)},
    {Q.gamma_tilde(2, 0), Q.gamma_tilde(2, 1), Q.gamma_tilde(2, 2)}
  };
  const double det = gCov[0][0] * gCov[1][1] * gCov[2][2] - gCov[0][0] * gCov[1][2] * gCov[1][2]
    - gCov[0][1] * gCov[0][1] * gCov[2][2] + 2 * gCov[0][1] * gCov[0][2] * gCov[1][2]
    - gCov[0][2] * gCov[0][2] * gCov[1][1];

  ASSERTION(std::isfinite(det) and det > 0.0, det);
  const double phisq = 1. / std::cbrt(det);
  for (int i = 0; i < 3; i++) {
    for (int j = 0; j < 3; j++) {
      gCov[i][j] *= phisq;
    }
  }

  const double det2 = gCov[0][0] * gCov[1][1] * gCov[2][2] - gCov[0][0] * gCov[1][2] * gCov[2][1]
    - gCov[1][0] * gCov[0][1] * gCov[2][2] + gCov[1][0] * gCov[0][2] * gCov[2][1] + gCov[2][0] * gCov[0][1] * gCov[1][2]
    - gCov[2][0] * gCov[0][2] * gCov[1][1];

  ASSERTION(std::isfinite(det2) and det2 > 0.0, det2);
  const double invdet       = 1. / det2;
  const double gContr[3][3] = {
    {(gCov[1][1] * gCov[2][2] - gCov[1][2] * gCov[2][1]) * invdet,
     -(gCov[0][1] * gCov[2][2] - gCov[0][2] * gCov[2][1]) * invdet,
     -(-gCov[0][1] * gCov[1][2] + gCov[0][2] * gCov[1][1]) * invdet},
    {-(gCov[1][0] * gCov[2][2] - gCov[1][2] * gCov[2][0]) * invdet,
     (gCov[0][0] * gCov[2][2] - gCov[0][2] * gCov[2][0]) * invdet,
     -(gCov[0][0] * gCov[1][2] - gCov[0][2] * gCov[1][0]) * invdet},
    {-(-gCov[1][0] * gCov[2][1] + gCov[1][1] * gCov[2][0]) * invdet,
     -(gCov[0][0] * gCov[2][1] - gCov[0][1] * gCov[2][0]) * invdet,
     (gCov[0][0] * gCov[1][1] - gCov[0][1] * gCov[1][0]) * invdet}
  };

  double aEx[3][3] = {
    {Q.A_tilde(0, 0), Q.A_tilde(0, 1), Q.A_tilde(0, 2)},
    {Q.A_tilde(1, 0), Q.A_tilde(1, 1), Q.A_tilde(1, 2)},
    {Q.A_tilde(2, 0), Q.A_tilde(2, 1), Q.A_tilde(2, 2)}
  };

  double traceA = 0;
  for (int i = 0; i < 3; i++) {
    for (int j = 0; j < 3; j++) {
      traceA += gContr[i][j] * aEx[i][j];
    }
  }

  for (int i = 0; i < 3; i++) {
    for (int j = 0; j < 3; j++) {
      aEx[i][j] -= 1. / 3. * traceA * gCov[i][j];
    }
  }

  for (int i = 0; i < 3; i++) {
    for (int j = i; j < 3; j++) {
      Q.gamma_tilde(i, j) = gCov[i][j];
      Q.A_tilde(i, j)     = aEx[i][j];
    }
  }

  Q.alpha = std::fmax(1e-16, Q.alpha);
  Q.phi   = std::fmax(1e-16, Q.phi);

  double dd[3][3][3];
  for (int k = 0; k < 3; k++) {
    for (int i = 0; i < 3; i++) {
      for (int j = 0; j < 3; j++) {
        dd[k][i][j] = Q.grad_gamma_tilde(k)(i, j);
      }
    }
  }

  for (int l = 0; l < 3; l++) {
    double traceDk = 0;
    for (int i = 0; i < 3; i++) {
      for (int j = 0; j < 3; j++) {
        traceDk += gContr[i][j] * dd[l][i][j];
      }
    }

    for (int i = 0; i < 3; i++) {
      for (int j = 0; j < 3; j++) {
        dd[l][i][j] -= 1. / 3 * gCov[i][j] * traceDk;
      }
    }
  }

  for (int k = 0; k < 3; k++) {
    for (int i = 0; i < 3; i++) {
      for (int j = i; j < 3; j++) {
        Q.grad_gamma_tilde(k)(i, j) = dd[k][i][j];
      }
    }
  }
}
