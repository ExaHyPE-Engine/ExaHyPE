template <typename State>
INLINE_METHOD GPU_CALLABLE_METHOD applications::exahype2::exaskred::limiting::CellStatistics<decltype(State::h)>
applications::exahype2::exaskred::limiting::collectCellStatistics(const std::span<const State> Q) {
  applications::exahype2::exaskred::limiting::CellStatistics<decltype(State::h)> result;
  for (const State& state : Q) {
    if (not allOf(state, [](const auto value) { return std::isfinite(value); })) {
      result.finite = false;
      return result;
    }

    const auto waterHeight = state.h;
    const auto bathymetry  = state.b;
    const auto freeSurface = waterHeight + bathymetry;
    result.minHeight       = std::min(result.minHeight, waterHeight);
    result.maxHeight       = std::max(result.maxHeight, waterHeight);
    result.minBathymetry   = std::min(result.minBathymetry, bathymetry);
    result.maxBathymetry   = std::max(result.maxBathymetry, bathymetry);
    result.minFreeSurface  = std::min(result.minFreeSurface, freeSurface);
    result.maxFreeSurface  = std::max(result.maxFreeSurface, freeSurface);
    for (int dimension = 0; dimension < DIMENSIONS; dimension++) {
      result.maxMomentum = std::max(result.maxMomentum, std::abs(state.hu(dimension)));
    }
  }
  return result;
}

template <typename State>
INLINE_METHOD GPU_CALLABLE_METHOD bool
applications::exahype2::exaskred::limiting::isWetCell(const std::span<const State> Q, const double minimumWaterHeight) {
  using Value           = decltype(State::h);
  const auto statistics = applications::exahype2::exaskred::limiting::collectCellStatistics(Q);
  return statistics.finite and statistics.minHeight > static_cast<Value>(minimumWaterHeight);
}

template <typename State>
INLINE_METHOD GPU_CALLABLE_METHOD bool
applications::exahype2::exaskred::limiting::hasBoundedDepthVariation(
  const std::span<const State> Q,
  const double                 minimumWaterHeight,
  const double                 maximumRelativeDepthVariation
) {
  using Value           = decltype(State::h);
  const auto statistics = applications::exahype2::exaskred::limiting::collectCellStatistics(Q);
  return statistics.finite and statistics.minHeight > static_cast<Value>(minimumWaterHeight)
    and statistics.maxHeight > Value{}
  and statistics.maxHeight - statistics.minHeight
    <= static_cast<Value>(maximumRelativeDepthVariation) * statistics.maxHeight;
}

template <typename State>
INLINE_METHOD GPU_CALLABLE_METHOD bool
applications::exahype2::exaskred::limiting::isAdmissibleState(const State& Q, const double minimumWaterHeight) {
  using Value = decltype(State::h);
  if (not allOf(Q, [](const auto value) { return std::isfinite(value); })) {
    return false;
  }
  return Q.h >= static_cast<Value>(minimumWaterHeight);
}
