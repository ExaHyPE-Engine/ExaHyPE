applications::exahype2::exaskred::ADERDGSolver::solveRiemannProblem(
  const FaceStates&                         QL,
  const FaceStates&                         QR,
  const Coordinates&                        x,
  const Coordinates&                        h,
  const double                              t,
  const double                              dt,
  const int                                 normal,
