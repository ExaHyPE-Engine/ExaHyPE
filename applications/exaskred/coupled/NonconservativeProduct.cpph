#include <cmath>

template <class Shortcuts, int NumberOfUnknowns, bool IncludeTurbulentDrag, class T>
static inline GPU_CALLABLE_METHOD void applications::exahype2::exaskred::coupled::nonconservativeProduct(
  const T* const NOALIAS                       Q,
  const T* const NOALIAS                       deltaQ,
  const tarch::la::Vector<DIMENSIONS, double>& x,
  const tarch::la::Vector<DIMENSIONS, double>& h,
  const double                                 t,
  const double                                 dt,
  const int                                    normal,
  T* const NOALIAS                             BTimesDeltaQ
) {
  (void)x;
  (void)t;
  (void)dt;

  for (int i = 0; i < NumberOfUnknowns; ++i) {
    BTimesDeltaQ[i] = 0.0;
  }

  if (Q[Shortcuts::h] > hThreshold) {
    BTimesDeltaQ[Shortcuts::hu + normal] = g * Q[Shortcuts::h] * (deltaQ[Shortcuts::h] + deltaQ[Shortcuts::z]);
  }

  if (Q[Shortcuts::lsh] <= hThreshold) {
    return;
  }

  BTimesDeltaQ[Shortcuts::lshu + normal] = g * Q[Shortcuts::lsh] * (deltaQ[Shortcuts::lsh] + deltaQ[Shortcuts::z]);

  if constexpr (IncludeTurbulentDrag) {
    const T momentumSquared = Q[Shortcuts::lshu] * Q[Shortcuts::lshu] + Q[Shortcuts::lshv] * Q[Shortcuts::lshv];
    const T momentum        = std::sqrt(momentumSquared);
    if (tarch::la::greater(momentum / Q[Shortcuts::lsh], 0.0)) {
      const T turbulentDrag = g * momentumSquared * invXi / (Q[Shortcuts::lsh] * Q[Shortcuts::lsh]);
      const T direction     = Q[Shortcuts::lshu + normal] / momentum;
      BTimesDeltaQ[Shortcuts::lshu + normal] += h[normal] * turbulentDrag * direction;
    }
  }

  BTimesDeltaQ[Shortcuts::hu + normal] += g * Q[Shortcuts::h] * deltaQ[Shortcuts::lsh];
}
