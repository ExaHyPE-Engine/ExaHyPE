TARGET_DECLARE
namespace applications::exahype2::exaskred {
  INLINE_METHOD GPU_CALLABLE_METHOD constexpr applications::exahype2::exaskred::landslide::Physics getSlidePhysics();
  INLINE_METHOD GPU_CALLABLE_METHOD constexpr applications::exahype2::exaskred::landslide::Physics
  getWaterAdmissibilityPhysics();
} // namespace applications::exahype2::exaskred

INLINE_METHOD GPU_CALLABLE_METHOD constexpr applications::exahype2::exaskred::landslide::Physics
applications::exahype2::exaskred::getSlidePhysics() {
  return {
    g,
    hThresholdSlide,
    mu,
    invXi,
    rhoSlide,
    rhoWater,
    0.0,
    waterFrictionDragCoefficient,
    waterPressureDragCoefficient
  };
}

/**
 * Returns the physical parameters under which the admissibility check of the granular layer tests
 * the water layer. These parameters combine the dry threshold of the water with zero friction.
 */
INLINE_METHOD GPU_CALLABLE_METHOD constexpr applications::exahype2::exaskred::landslide::Physics
applications::exahype2::exaskred::getWaterAdmissibilityPhysics() {
  return {g, hThresholdWater, 0.0, 0.0, rhoWater, rhoWater, 0.0, 0.0, 0.0};
}

INLINE_METHOD void
applications::exahype2::exaskred::ADERDGSolver::initialCondition(
  State&                              Q,
  const Coordinates&                  x,
  [[maybe_unused]] const Coordinates& h,
  const RuntimeParameters&            parameters
) {
  Q = {};

  const auto&                                       bathymetrySize   = parameters.bathymetrySize;
  const auto&                                       bathymetryOffset = parameters.bathymetryOffset;
  static const tarch::reader::NetCDFFieldSampler<2> bathymetrySampler(
    {{"bathymetry", std::string(parameters.bathymetryFile), "Band1", {"x", "y"}}},
    {bathymetrySize(0), bathymetrySize(1)},
    {bathymetryOffset(0), bathymetryOffset(1)}
  );

  const auto&                                       displacementSize     = parameters.displacementSize;
  const auto&                                       displacementOffset   = parameters.displacementOffset;
  const auto&                                       displacementPosition = parameters.displacementPosition;
  static const tarch::reader::NetCDFFieldSampler<2> displacementSampler(
    {{"displacement", std::string(parameters.displacementFile), "Band1", {"x", "y"}}},
    {displacementSize(0), displacementSize(1)},
    {displacementOffset(0), displacementOffset(1)}
  );

  const double displacement = displacementSampler.sampleBilinear(
    "displacement",
    {x(0) - displacementPosition(0), x(1) - displacementPosition(1)}
  );

  if (not bathymetrySampler.covers("bathymetry", {x(0), x(1)})) {
    tarch::terminateWithError(
      "The bathymetry file '" + std::string(parameters.bathymetryFile) + "' has to cover the point ("
      + std::to_string(x(0)) + ", " + std::to_string(x(1)) + ") of the domain."
    );
  }

  Q.z   = bathymetrySampler.sampleBilinear("bathymetry", {x(0), x(1)});
  Q.lsh = displacement > 0.0 ? displacement : 0.0;
  Q.h   = std::max(-Q.z - Q.lsh, 0.0);
}

/**
 * Writes the outer state of a boundary face. The outer water state keeps the outgoing Riemann
 * invariant of the inner state and takes the incoming invariant from water at rest. Qoutside copies
 * the inner state for thin water and for the granular layer.
 */
INLINE_METHOD GPU_CALLABLE_METHOD void
applications::exahype2::exaskred::ADERDGSolver::boundaryConditions(
  const State&                              Qinside,
  State&                                    Qoutside,
  const Coordinates&                        x,
  [[maybe_unused]] const Coordinates&       h,
  [[maybe_unused]] const double             t,
  const int                                 normal,
  [[maybe_unused]] const RuntimeParameters& parameters
) {
  ASSERTION(normal >= 0 and normal < DIMENSIONS, normal);
  Qoutside = Qinside;

  const double waterDepth        = Qinside.h;
  const double restingWaterDepth = -Qinside.z - Qinside.lsh;
  if (waterDepth <= hThresholdWater or restingWaterDepth <= hThresholdWater) {
    return;
  }
  const double outwardSign       = x(normal) > DomainOffset(normal) + 0.5 * DomainSize(normal) ? 1.0 : -1.0;
  const double insideWaveSpeed   = std::sqrt(g * waterDepth);
  const double outgoingInvariant = outwardSign * Qinside.hu(normal) / waterDepth + 2.0 * insideWaveSpeed;
  const double incomingInvariant = -2.0 * std::sqrt(g * restingWaterDepth);
  const double outerWaveSpeed    = std::max(0.25 * (outgoingInvariant - incomingInvariant), 0.0);
  const double outerDepth        = waterDepth * (outerWaveSpeed / insideWaveSpeed) * (outerWaveSpeed / insideWaveSpeed);
  const double outerVelocity     = 0.5 * (outgoingInvariant + incomingInvariant);
  Qoutside.h                     = outerDepth;
  for (int axis = 0; axis < DIMENSIONS; axis++) {
    Qoutside.hu(axis) =
      axis == normal ? outwardSign * outerVelocity * outerDepth : outerDepth * Qinside.hu(axis) / waterDepth;
  }
}

/**
 * Refines a cell that overlaps the region of the displacement file or reaches below shoreHeight.
 * Every other cell keeps its level. The initial condition writes the bathymetry and the water of
 * every cell.
 */
INLINE_METHOD GPU_CALLABLE_METHOD ::exahype2::RefinementCommand
applications::exahype2::exaskred::ADERDGSolver::refinementCriterion(
  const CellStates*             Q,
  const Coordinates&            x,
  const Coordinates&            h,
  [[maybe_unused]] const double t,
  const RuntimeParameters&      parameters
) {
  ASSERTION(h(0) > 0.0 and h(1) > 0.0, h);
  if (Q == nullptr) {
    return ::exahype2::RefinementCommand::Keep;
  }

  const auto& displacementSize     = parameters.displacementSize;
  const auto& displacementOffset   = parameters.displacementOffset;
  const auto& displacementPosition = parameters.displacementPosition;
  bool        overlapsDisplacement = true;
  for (int axis = 0; axis < DIMENSIONS; axis++) {
    ASSERTION(displacementSize(axis) >= 0.0, axis, displacementSize(axis));
    const double lower   = displacementOffset(axis) + displacementPosition(axis);
    const double upper   = lower + displacementSize(axis);
    overlapsDisplacement = overlapsDisplacement and x(axis) + 0.5 * h(axis) > lower and x(axis) - 0.5 * h(axis) < upper;
  }
  if (overlapsDisplacement) {
    return ::exahype2::RefinementCommand::Refine;
  }

  for (const State& node : *Q) {
    if (node.z < shoreHeight) {
      return ::exahype2::RefinementCommand::Refine;
    }
  }
  return ::exahype2::RefinementCommand::Keep;
}

INLINE_METHOD GPU_CALLABLE_METHOD void
applications::exahype2::exaskred::ADERDGSolver::flux(
  const State&                              Q,
  const Coordinates&                        x,
  const Coordinates&                        h,
  const double                              t,
  const double                              dt,
  const int                                 normal,
  Flux&                                     F,
  [[maybe_unused]] const RuntimeParameters& parameters
) {
  applications::exahype2::exaskred::coupled::flux(Q, x, h, t, dt, normal, getSlidePhysics(), hThresholdWater, F);
}

INLINE_METHOD GPU_CALLABLE_METHOD double
applications::exahype2::exaskred::ADERDGSolver::maxEigenvalue(
  const State&                              Q,
  const Coordinates&                        x,
  const Coordinates&                        h,
  const double                              t,
  const double                              dt,
  const int                                 normal,
  [[maybe_unused]] const RuntimeParameters& parameters
) {
  return applications::exahype2::exaskred::coupled::maxEigenvalue(
    Q,
    x,
    h,
    t,
    dt,
    normal,
    getSlidePhysics(),
    hThresholdWater,
    PNPM / static_cast<double>(DIMENSIONS)
  );
}

INLINE_METHOD GPU_CALLABLE_METHOD void
applications::exahype2::exaskred::ADERDGSolver::nonconservativeProduct(
  const State&                              Q,
  const Difference&                         deltaQ,
  const Coordinates&                        x,
  const Coordinates&                        h,
  const double                              t,
  const double                              dt,
  const int                                 normal,
  NonconservativeProduct&                   BTimesDeltaQ,
  [[maybe_unused]] const RuntimeParameters& parameters
) {
  applications::exahype2::exaskred::coupled::nonconservativeProduct(
    Q,
    deltaQ,
    x,
    h,
    t,
    dt,
    normal,
    getSlidePhysics(),
    hThresholdWater,
    BTimesDeltaQ
  );
}

INLINE_METHOD GPU_CALLABLE_METHOD void
applications::exahype2::exaskred::ADERDGSolver::diffusiveSourceTerm(
  const State&                              Q,
  const Gradient&                           deltaQ,
  const Coordinates&                        x,
  const Coordinates&                        h,
