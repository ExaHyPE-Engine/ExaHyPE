INLINE_METHOD GPU_CALLABLE_METHOD double
applications::exahype2::exaskred::ADERDGSolver::solveRiemannProblem(
  const FaceStates&                         QL,
  const FaceStates&                         QR,
  const Coordinates&                        x,
  const Coordinates&                        h,
  const double                              t,
  const double                              dt,
  const int                                 normal,
  [[maybe_unused]] const bool               isBoundaryFace,
  [[maybe_unused]] const int                faceIndex,
  FaceFluxes&                               FL,
  FaceFluxes&                               FR,
  [[maybe_unused]] const RuntimeParameters& parameters
) {
  return applications::exahype2::exaskred::coupled::solveRiemannProblem(
    QL,
    QR,
    x,
    h,
    t,
    dt,
    normal,
    getSlidePhysics(),
    hThresholdWater,
    FL,
    FR
  );
}

INLINE_METHOD GPU_CALLABLE_METHOD double
applications::exahype2::exaskred::ADERDGSolver::solveSubcellRiemannProblem(
  const State&                              QL,
  const State&                              QR,
  const Coordinates&                        x,
  const Coordinates&                        h,
