#include <cmath>

template <class Shortcuts, int NumberOfUnknowns, class T>
static inline GPU_CALLABLE_METHOD void applications::exahype2::exaskred::coupled::flux(
  const T* const NOALIAS                       Q,
  const tarch::la::Vector<DIMENSIONS, double>& x,
  const tarch::la::Vector<DIMENSIONS, double>& h,
  const double                                 t,
  const double                                 dt,
  const int                                    normal,
  T* const NOALIAS                             F
) {
  (void)x;
  (void)h;
  (void)t;
  (void)dt;

  for (int i = 0; i < NumberOfUnknowns; ++i) {
    F[i] = 0.0;
  }

  if (Q[Shortcuts::h] > hThreshold) {
    const T inverseHeight  = 1.0 / Q[Shortcuts::h];
    const T normalMomentum = Q[Shortcuts::hu + normal];
    F[Shortcuts::h]        = normalMomentum;
    F[Shortcuts::hu]       = normalMomentum * Q[Shortcuts::hu] * inverseHeight;
    F[Shortcuts::hv]       = normalMomentum * Q[Shortcuts::hv] * inverseHeight;
  }

  if (Q[Shortcuts::lsh] > hThreshold) {
    const T inverseHeight  = 1.0 / Q[Shortcuts::lsh];
    const T normalMomentum = Q[Shortcuts::lshu + normal];
    F[Shortcuts::lsh]      = normalMomentum;
    F[Shortcuts::lshu]     = normalMomentum * Q[Shortcuts::lshu] * inverseHeight;
    F[Shortcuts::lshv]     = normalMomentum * Q[Shortcuts::lshv] * inverseHeight;
  }
}

template <class Shortcuts, class T>
static inline GPU_CALLABLE_METHOD double applications::exahype2::exaskred::coupled::maxEigenvalue(
  const T* const NOALIAS                       Q,
  const tarch::la::Vector<DIMENSIONS, double>& x,
  const tarch::la::Vector<DIMENSIONS, double>& h,
  const double                                 t,
  const double                                 dt,
  const int                                    normal
) {
  (void)x;
  (void)h;
  (void)t;
  (void)dt;

  T waterWaveSpeed = 0.0;
  if (Q[Shortcuts::h] > hThreshold) {
    const T normalVelocity = Q[Shortcuts::hu + normal] / Q[Shortcuts::h];
    const T waveSpeed      = std::sqrt(g * Q[Shortcuts::h]);
    waterWaveSpeed         = std::fmax(std::fabs(normalVelocity + waveSpeed), std::fabs(normalVelocity - waveSpeed));
  }

  T granularWaveSpeed = 0.0;
  if (Q[Shortcuts::lsh] > hThreshold) {
    const T normalVelocity = Q[Shortcuts::lshu + normal] / Q[Shortcuts::lsh];
    const T waveSpeed      = std::sqrt(g * Q[Shortcuts::lsh]);
    granularWaveSpeed      = std::fmax(std::fabs(normalVelocity + waveSpeed), std::fabs(normalVelocity - waveSpeed));
  }

  return std::fmax(waterWaveSpeed, granularWaveSpeed);
}
