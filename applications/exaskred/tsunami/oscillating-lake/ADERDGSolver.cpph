#include "applications/exaskred/AugmentedState.h"
#include "applications/exaskred/Limiting.h"
#include "applications/exaskred/ShallowWater.h"
#include "applications/exaskred/WellBalancedRusanov.h"

TARGET_DECLARE
INLINE_METHOD void
applications::exahype2::exaskred::ADERDGSolver::initialCondition(
  State&                              Q,
  const Coordinates&                  x,
  [[maybe_unused]] const Coordinates& h,
  const RuntimeParameters&            parameters
) {
  static_assert(NumberOfAuxiliaryVariables == 0, "The oscillating lake expects zero auxiliary variables.");
  const auto radiusSquared = x[0] * x[0] + x[1] * x[1];
  Q.b                      = -ReferenceDepth * (1.0 - radiusSquared / (LakeRadius * LakeRadius));
  analyticalSolution(x, 0.0, 0.0, Q, Q, parameters);
}

/**
 * Writes the orbiting lake surface at time t over the bathymetry of Q into solution.
 */
INLINE_METHOD GPU_CALLABLE_METHOD void
applications::exahype2::exaskred::ADERDGSolver::analyticalSolution(
  const Coordinates&                        x,
  const double                              t,
  [[maybe_unused]] const double             dt,
  const State&                              Q,
  Solution&                                 solution,
  [[maybe_unused]] const RuntimeParameters& parameters
) {
  const double bathymetry = Q.b;
  solution                = {};

  const auto angularFrequency = std::sqrt(2.0 * g * ReferenceDepth) / LakeRadius;
  const auto exactHeight      = ((OrbitDisplacement * ReferenceDepth) / (LakeRadius * LakeRadius))
      * (2.0 * x[0] * std::cos(angularFrequency * t) + 2.0 * x[1] * std::sin(angularFrequency * t) - OrbitDisplacement)
    - bathymetry;

  solution.b = bathymetry;
  if (exactHeight > 0.0) {
    solution.h     = exactHeight;
    solution.hu(0) = -OrbitDisplacement * angularFrequency * std::sin(angularFrequency * t) * exactHeight;
    solution.hu(1) = OrbitDisplacement * angularFrequency * std::cos(angularFrequency * t) * exactHeight;
  }
}

INLINE_METHOD GPU_CALLABLE_METHOD void
applications::exahype2::exaskred::ADERDGSolver::boundaryConditions(
  const State&                              Qinside,
  State&                                    Qoutside,
  [[maybe_unused]] const Coordinates&       x,
  [[maybe_unused]] const Coordinates&       h,
  [[maybe_unused]] const double             t,
  [[maybe_unused]] const int                normal,
  [[maybe_unused]] const RuntimeParameters& parameters
) {
  Qoutside = Qinside;
  for (int axis = 0; axis < DIMENSIONS; axis++) {
    Qoutside.hu(axis) = -Qinside.hu(axis);
  }
}

INLINE_METHOD GPU_CALLABLE_METHOD ::exahype2::RefinementCommand
applications::exahype2::exaskred::ADERDGSolver::refinementCriterion(
  [[maybe_unused]] const CellStates*        Q,
  const Coordinates&                        x,
  [[maybe_unused]] const Coordinates&       h,
  [[maybe_unused]] const double             t,
  [[maybe_unused]] const RuntimeParameters& parameters
) {
  const auto radiusSquared = x[0] * x[0] + x[1] * x[1];
  return radiusSquared <= LakeRadius * LakeRadius ? ::exahype2::RefinementCommand::Refine
                                                  : ::exahype2::RefinementCommand::Keep;
}

INLINE_METHOD GPU_CALLABLE_METHOD void
applications::exahype2::exaskred::ADERDGSolver::flux(
  const State&                              Q,
  const Coordinates&                        x,
  const Coordinates&                        h,
  const double                              t,
  const double                              dt,
  const int                                 normal,
  Flux&                                     F,
  [[maybe_unused]] const RuntimeParameters& parameters
) {
  applications::exahype2::exaskred::shallowwater::flux(Q, x, h, t, dt, normal, hThreshold, F);
}

INLINE_METHOD GPU_CALLABLE_METHOD double
applications::exahype2::exaskred::ADERDGSolver::maxEigenvalue(
  const State&                              Q,
  const Coordinates&                        x,
  const Coordinates&                        h,
  const double                              t,
  const double                              dt,
  const int                                 normal,
  [[maybe_unused]] const RuntimeParameters& parameters
) {
  return applications::exahype2::exaskred::shallowwater::maxEigenvalue(Q, x, h, t, dt, normal, g, hThreshold);
}

INLINE_METHOD GPU_CALLABLE_METHOD void
applications::exahype2::exaskred::ADERDGSolver::nonconservativeProduct(
  const State&                              Q,
  const Difference&                         deltaQ,
  const Coordinates&                        x,
  const Coordinates&                        h,
  const double                              t,
  const double                              dt,
  const int                                 normal,
  NonconservativeProduct&                   BTimesDeltaQ,
  [[maybe_unused]] const RuntimeParameters& parameters
) {
  applications::exahype2::exaskred::shallowwater::nonconservativeProduct(
    Q,
    deltaQ,
    x,
    h,
    t,
    dt,
    normal,
    g,
    hThreshold,
    BTimesDeltaQ
  );
}

INLINE_METHOD GPU_CALLABLE_METHOD double
applications::exahype2::exaskred::ADERDGSolver::solveSubcellRiemannProblem(
  const State&                              QL,
  const State&                              QR,
  const Coordinates&                        x,
  const Coordinates&                        h,
  const double                              t,
  const double                              dt,
  const int                                 normal,
  [[maybe_unused]] const bool               isBoundaryFace,
  [[maybe_unused]] const int                faceIndex,
  Flux&                                     FL,
  Flux&                                     FR,
  [[maybe_unused]] const RuntimeParameters& parameters
) {
  return applications::exahype2::exaskred::riemann::augmentedState<&State::b>(
    QL,
    QR,
    x,
    h,
    t,
    dt,
    normal,
    g,
    hThreshold,
    FL,
    FR
  );
}

INLINE_METHOD GPU_CALLABLE_METHOD bool
applications::exahype2::exaskred::ADERDGSolver::isPhysicallyAdmissible(
  const States                              Q,
  [[maybe_unused]] const Coordinates&       x,
  [[maybe_unused]] const Coordinates&       h,
  [[maybe_unused]] const RuntimeParameters& parameters
) {
  if (Q.size() == 1) {
    return applications::exahype2::exaskred::limiting::isAdmissibleState(Q[0], 0.0);
  }
  const auto statistics           = applications::exahype2::exaskred::limiting::collectCellStatistics(Q);
  const auto minimumDGWaterHeight = 100.0 * hThreshold;
  const auto fullyWet             = statistics.minHeight > minimumDGWaterHeight;
  const auto dryAtRest = statistics.minHeight >= 0.0 and statistics.maxHeight <= 0.0 and statistics.maxMomentum <= 0.0;
  return statistics.finite and (fullyWet or dryAtRest);
}

INLINE_METHOD GPU_CALLABLE_METHOD double
applications::exahype2::exaskred::ADERDGSolver::solveRiemannProblem(
  const FaceStates&                         QL,
  const FaceStates&                         QR,
  const Coordinates&                        x,
  const Coordinates&                        h,
  const double                              t,
  const double                              dt,
  const int                                 normal,
  [[maybe_unused]] const bool               isBoundaryFace,
  [[maybe_unused]] const int                faceIndex,
  FaceFluxes&                               FL,
  FaceFluxes&                               FR,
  [[maybe_unused]] const RuntimeParameters& parameters
) {
  const auto waterEigenvalue = [](
                                 const State&       Q,
                                 const Coordinates& facePosition,
                                 const Coordinates& faceSize,
                                 const double       time,
                                 const double       timeStepSize,
                                 const int          direction
                               ) {
    return applications::exahype2::exaskred::shallowwater::maxEigenvalue(
      Q,
      facePosition,
      faceSize,
      time,
      timeStepSize,
      direction,
      g,
      hThreshold
    );
  };
  const auto interfaceGravity = []([[maybe_unused]] const State& QLeft, [[maybe_unused]] const State& QRight) {
    return g;
  };
  return applications::exahype2::exaskred::riemann::wellBalancedRusanov<&State::b>(
    QL,
    QR,
    x,
    h,
    t,
    dt,
    normal,
    waterEigenvalue,
    interfaceGravity,
    FL,
    FR
  );
}
TARGET_DECLARE_END
