#include "applications/exaskred/AugmentedState.h"
#include "applications/exaskred/Limiting.h"
#include "applications/exaskred/ShallowWater.h"
#include "applications/exaskred/WellBalancedRusanov.h"
#include "tarch/reader/NetCDFFieldSampler.h"

TARGET_DECLARE
INLINE_METHOD void
applications::exahype2::exaskred::ADERDGSolver::initialCondition(
  State&                              Q,
  const Coordinates&                  x,
  [[maybe_unused]] const Coordinates& h,
  const RuntimeParameters&            parameters
) {
  const auto&                                       bathymetrySize   = parameters.bathymetrySize;
  const auto&                                       bathymetryOffset = parameters.bathymetryOffset;
  static const tarch::reader::NetCDFFieldSampler<2> bathymetrySampler(
    {{"bathymetry", std::string(parameters.bathymetryFile)}},
    {bathymetrySize(0), bathymetrySize(1)},
    {bathymetryOffset(0), bathymetryOffset(1)}
  );

  const auto&                                       displacementSize   = parameters.displacementSize;
  const auto&                                       displacementOffset = parameters.displacementOffset;
  static const tarch::reader::NetCDFFieldSampler<2> displacementSampler(
    {{"displacement", std::string(parameters.displacementFile)}},
    {displacementSize(0), displacementSize(1)},
    {displacementOffset(0), displacementOffset(1)}
  );

  const auto& displacementPosition = parameters.displacementPosition;
  const auto  sampleDisplacement   = [&](const double sampleX, const double sampleY) {
    const double fileX      = sampleX - displacementPosition(0);
    const double fileY      = sampleY - displacementPosition(1);
    const bool   insideFile = fileX >= displacementOffset(0) and fileX <= displacementOffset(0) + displacementSize(0)
      and fileY >= displacementOffset(1) and fileY <= displacementOffset(1) + displacementSize(1);
    return insideFile ? displacementSampler.sampleBilinear("displacement", {fileX, fileY}) : 0.0;
  };

  // Pointwise samples of the fine displacement raster alias into the polynomial basis. A nine-point
  // low-pass over the source radius minus the cell footprint gives every resolution the same
  // integrated source.
  const double filterCellH0               = std::max(h(0), sourceFilterMinimumCellH);
  const double filterCellH1               = std::max(h(1), sourceFilterMinimumCellH);
  const double cellFootprintRadiusSquared = filterCellH0 * filterCellH0 + filterCellH1 * filterCellH1;
  const double sourceRadius =
    std::sqrt(std::max(sourceLowPassEffectiveRadius * sourceLowPassEffectiveRadius - cellFootprintRadiusSquared, 0.0));
  const double displacement =
    (4.0 * sampleDisplacement(x(0), x(1)) + 2.0 * sampleDisplacement(x(0) - sourceRadius, x(1))
     + 2.0 * sampleDisplacement(x(0) + sourceRadius, x(1)) + 2.0 * sampleDisplacement(x(0), x(1) - sourceRadius)
     + 2.0 * sampleDisplacement(x(0), x(1) + sourceRadius)
     + sampleDisplacement(x(0) - sourceRadius, x(1) - sourceRadius)
     + sampleDisplacement(x(0) + sourceRadius, x(1) - sourceRadius)
     + sampleDisplacement(x(0) - sourceRadius, x(1) + sourceRadius)
     + sampleDisplacement(x(0) + sourceRadius, x(1) + sourceRadius))
    / 16.0;

  const auto bathymetryBeforeEarthquake = bathymetrySampler.sampleBilinear("bathymetry", {x(0), x(1)});
  const auto bathymetryAfterEarthquake  = bathymetryBeforeEarthquake + displacement;

  Q.h  = -std::min(bathymetryBeforeEarthquake, 0.0);
  Q.hu = 0.0;
  Q.b  = bathymetryAfterEarthquake;
}

INLINE_METHOD GPU_CALLABLE_METHOD void
applications::exahype2::exaskred::ADERDGSolver::boundaryConditions(
  const State&                              Qinside,
  State&                                    Qoutside,
  [[maybe_unused]] const Coordinates&       x,
  [[maybe_unused]] const Coordinates&       h,
  [[maybe_unused]] const double             t,
  [[maybe_unused]] const int                normal,
  [[maybe_unused]] const RuntimeParameters& parameters
) {
  Qoutside = Qinside;
}

INLINE_METHOD GPU_CALLABLE_METHOD ::exahype2::RefinementCommand
applications::exahype2::exaskred::ADERDGSolver::refinementCriterion(
  [[maybe_unused]] const CellStates*        Q,
  [[maybe_unused]] const Coordinates&       x,
  [[maybe_unused]] const Coordinates&       h,
  [[maybe_unused]] const double             t,
  [[maybe_unused]] const RuntimeParameters& parameters
) {
  return ::exahype2::RefinementCommand::Keep;
}

INLINE_METHOD GPU_CALLABLE_METHOD void
applications::exahype2::exaskred::ADERDGSolver::flux(
  const State&                              Q,
  const Coordinates&                        x,
  const Coordinates&                        h,
  const double                              t,
  const double                              dt,
  const int                                 normal,
  Flux&                                     F,
  [[maybe_unused]] const RuntimeParameters& parameters
) {
  applications::exahype2::exaskred::shallowwater::flux(Q, x, h, t, dt, normal, hThreshold, F);
}

INLINE_METHOD GPU_CALLABLE_METHOD double
applications::exahype2::exaskred::ADERDGSolver::maxEigenvalue(
  const State&                              Q,
  const Coordinates&                        x,
  const Coordinates&                        h,
  const double                              t,
  const double                              dt,
  const int                                 normal,
  [[maybe_unused]] const RuntimeParameters& parameters
) {
  return applications::exahype2::exaskred::shallowwater::maxEigenvalue(Q, x, h, t, dt, normal, g, hThreshold);
}

INLINE_METHOD GPU_CALLABLE_METHOD void
applications::exahype2::exaskred::ADERDGSolver::nonconservativeProduct(
  const State&                              Q,
  const Difference&                         deltaQ,
  const Coordinates&                        x,
  const Coordinates&                        h,
  const double                              t,
  const double                              dt,
  const int                                 normal,
  NonconservativeProduct&                   BTimesDeltaQ,
  [[maybe_unused]] const RuntimeParameters& parameters
) {
  applications::exahype2::exaskred::shallowwater::nonconservativeProduct(
    Q,
    deltaQ,
    x,
    h,
    t,
    dt,
    normal,
    g,
    hThreshold,
    BTimesDeltaQ
  );
}

INLINE_METHOD GPU_CALLABLE_METHOD double
applications::exahype2::exaskred::ADERDGSolver::solveSubcellRiemannProblem(
  const State&                              QL,
  const State&                              QR,
  const Coordinates&                        x,
  const Coordinates&                        h,
  const double                              t,
  const double                              dt,
  const int                                 normal,
  [[maybe_unused]] const bool               isBoundaryFace,
  [[maybe_unused]] const int                faceIndex,
  Flux&                                     FL,
  Flux&                                     FR,
  [[maybe_unused]] const RuntimeParameters& parameters
) {
  return applications::exahype2::exaskred::riemann::augmentedState<&State::b>(
    QL,
    QR,
    x,
    h,
    t,
    dt,
    normal,
    g,
    hThreshold,
    FL,
    FR
  );
}

/**
 * Returns false for a cell at the physical boundary, in dry or coastal water, or with a free
 * surface that varies more than the scale-aware thresholds allow. Inside the displacement region a
 * bound on the absolute surface amplitude applies as well. The earthquake source thus starts on the
 * subcell scheme.
 */
INLINE_METHOD GPU_CALLABLE_METHOD bool
applications::exahype2::exaskred::ADERDGSolver::isPhysicallyAdmissible(
  const States             Q,
  const Coordinates&       x,
  const Coordinates&       h,
  const RuntimeParameters& parameters
) {
  if (Q.size() == 1) {
    return applications::exahype2::exaskred::limiting::isAdmissibleState(Q[0], 0.0);
  }
  const bool touchesPhysicalBoundary = x(0) - 0.5 * h(0) <= DomainOffset[0]
    or x(0) + 0.5 * h(0) >= DomainOffset[0] + DomainSize[0] or x(1) - 0.5 * h(1) <= DomainOffset[1]
    or x(1) + 0.5 * h(1) >= DomainOffset[1] + DomainSize[1];
  if (touchesPhysicalBoundary) {
    return false;
  }
  const auto statistics = applications::exahype2::exaskred::limiting::collectCellStatistics(Q);
  if (
    not statistics.finite or statistics.minHeight <= hThreshold
    or statistics.maxBathymetry > -limiterBathymetryThreshold
  ) {
    return false;
  }
  const double freeSurfaceSpan = statistics.maxFreeSurface - statistics.minFreeSurface;
  const double localDepthScale = std::max(statistics.maxHeight, hThreshold);
  const double referencePatchH = std::min(DomainSize[0], DomainSize[1]) / 81.0;
  const double patchSizeScale  = std::max(h(0), h(1)) / referencePatchH;
  if (freeSurfaceSpan > limiterRelativeFreeSurfaceVariation * localDepthScale * patchSizeScale) {
    return false;
  }
  if (statistics.minFreeSurface < -limiterRelativeNegativeFreeSurfaceVariation * localDepthScale) {
    return false;
  }
  const auto& displacementSize     = parameters.displacementSize;
  const auto& displacementOffset   = parameters.displacementOffset;
  const auto& displacementPosition = parameters.displacementPosition;
  const bool  overlapsDisplacement = x(0) + 0.5 * h(0) >= displacementPosition(0) + displacementOffset(0)
    and x(0) - 0.5 * h(0) <= displacementPosition(0) + displacementOffset(0) + displacementSize(0)
    and x(1) + 0.5 * h(1) >= displacementPosition(1) + displacementOffset(1)
    and x(1) - 0.5 * h(1) <= displacementPosition(1) + displacementOffset(1) + displacementSize(1);
  if (
    overlapsDisplacement
    and std::max(std::abs(statistics.minFreeSurface), std::abs(statistics.maxFreeSurface))
      > limiterRelativeSourceFreeSurfaceAmplitude * localDepthScale
  ) {
    return false;
  }
  return true;
}

INLINE_METHOD GPU_CALLABLE_METHOD void
applications::exahype2::exaskred::ADERDGSolver::mapDmpObservables(
  Observables&                              observables,
  const State&                              Q,
  [[maybe_unused]] const RuntimeParameters& parameters
) {
  static_assert(NumberOfObservables == 4, "The Tohoku scenario expects number_of_dmp_observables = 4.");
  observables(0) = Q.h;
  observables(1) = Q.hu(0);
  observables(2) = Q.hu(1);
  observables(3) = Q.b;
}

INLINE_METHOD GPU_CALLABLE_METHOD double
applications::exahype2::exaskred::ADERDGSolver::solveRiemannProblem(
  const FaceStates&                         QL,
  const FaceStates&                         QR,
  const Coordinates&                        x,
  const Coordinates&                        h,
  const double                              t,
  const double                              dt,
  const int                                 normal,
  [[maybe_unused]] const bool               isBoundaryFace,
  [[maybe_unused]] const int                faceIndex,
  FaceFluxes&                               FL,
  FaceFluxes&                               FR,
  [[maybe_unused]] const RuntimeParameters& parameters
) {
  const auto waterEigenvalue = [](
                                 const State&       Q,
                                 const Coordinates& facePosition,
                                 const Coordinates& faceSize,
                                 const double       time,
                                 const double       timeStepSize,
                                 const int          direction
                               ) {
    return applications::exahype2::exaskred::shallowwater::maxEigenvalue(
      Q,
      facePosition,
      faceSize,
      time,
      timeStepSize,
      direction,
      g,
      hThreshold
    );
  };
  const auto interfaceGravity = []([[maybe_unused]] const State& QLeft, [[maybe_unused]] const State& QRight) {
    return g;
  };
  return applications::exahype2::exaskred::riemann::wellBalancedRusanov<&State::b>(
    QL,
    QR,
    x,
    h,
    t,
    dt,
    normal,
    waterEigenvalue,
    interfaceGravity,
    FL,
    FR
  );
}
TARGET_DECLARE_END
