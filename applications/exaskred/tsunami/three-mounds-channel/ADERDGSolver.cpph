#include "applications/exaskred/AugmentedState.h"
#include "applications/exaskred/Limiting.h"
#include "applications/exaskred/ShallowWater.h"
#include "applications/exaskred/WellBalancedRusanov.h"

TARGET_DECLARE
namespace applications::exahype2::exaskred {
  INLINE_METHOD GPU_CALLABLE_METHOD double getBathymetryOfChannel(const tarch::la::Vector<DIMENSIONS, double>& x);
} // namespace applications::exahype2::exaskred

/**
 * Returns the bed height at x. Three conical mounds rise from the flat channel bed at height zero.
 */
INLINE_METHOD GPU_CALLABLE_METHOD double
applications::exahype2::exaskred::getBathymetryOfChannel(const tarch::la::Vector<DIMENSIONS, double>& x) {
  const double moundOne   = 1.0 - 0.10 * std::sqrt((x[0] - 15.0) * (x[0] - 15.0) + (x[1] - 22.5) * (x[1] - 22.5));
  const double moundTwo   = 1.0 - 0.10 * std::sqrt((x[0] - 15.0) * (x[0] - 15.0) + (x[1] - 7.5) * (x[1] - 7.5));
  const double moundThree = 1.0 - 0.28 * std::sqrt((x[0] - 28.0) * (x[0] - 28.0) + (x[1] - 15.0) * (x[1] - 15.0));
  return std::max(std::max(0.0, moundOne), std::max(moundTwo, moundThree));
}

/**
 * Fills the dam at the left end of the channel with water.
 */
INLINE_METHOD void
applications::exahype2::exaskred::ADERDGSolver::initialCondition(
  State&                                    Q,
  const Coordinates&                        x,
  [[maybe_unused]] const Coordinates&       h,
  [[maybe_unused]] const RuntimeParameters& parameters
) {
  Q = {};

  constexpr double EdgeTolerance    = 1e-8;
  constexpr double WaterHeightOfDam = 0.9;
  Q.h                               = x[0] <= 5.0 + EdgeTolerance ? WaterHeightOfDam : 0.0;
  Q.b                               = applications::exahype2::exaskred::getBathymetryOfChannel(x);
}

INLINE_METHOD GPU_CALLABLE_METHOD void
applications::exahype2::exaskred::ADERDGSolver::boundaryConditions(
  const State&                              Qinside,
  State&                                    Qoutside,
  [[maybe_unused]] const Coordinates&       x,
  [[maybe_unused]] const Coordinates&       h,
  [[maybe_unused]] const double             t,
  [[maybe_unused]] const int                normal,
  [[maybe_unused]] const RuntimeParameters& parameters
) {
  Qoutside.h  = Qinside.h;
  Qoutside.hu = 0.0;
  Qoutside.b  = Qinside.b;
}

INLINE_METHOD GPU_CALLABLE_METHOD ::exahype2::RefinementCommand
applications::exahype2::exaskred::ADERDGSolver::refinementCriterion(
  [[maybe_unused]] const CellStates*        Q,
  const Coordinates&                        x,
  [[maybe_unused]] const Coordinates&       h,
  [[maybe_unused]] const double             t,
  [[maybe_unused]] const RuntimeParameters& parameters
) {
  return applications::exahype2::exaskred::getBathymetryOfChannel(x) > 0.0 ? ::exahype2::RefinementCommand::Refine
                                                                           : ::exahype2::RefinementCommand::Keep;
}

INLINE_METHOD GPU_CALLABLE_METHOD void
applications::exahype2::exaskred::ADERDGSolver::flux(
  const State&                              Q,
  const Coordinates&                        x,
  const Coordinates&                        h,
  const double                              t,
  const double                              dt,
  const int                                 normal,
  Flux&                                     F,
  [[maybe_unused]] const RuntimeParameters& parameters
) {
  applications::exahype2::exaskred::shallowwater::flux(Q, x, h, t, dt, normal, hThreshold, F);
}

INLINE_METHOD GPU_CALLABLE_METHOD double
applications::exahype2::exaskred::ADERDGSolver::maxEigenvalue(
  const State&                              Q,
  const Coordinates&                        x,
  const Coordinates&                        h,
  const double                              t,
  const double                              dt,
  const int                                 normal,
  [[maybe_unused]] const RuntimeParameters& parameters
) {
  return applications::exahype2::exaskred::shallowwater::maxEigenvalue(Q, x, h, t, dt, normal, g, hThreshold);
}

INLINE_METHOD GPU_CALLABLE_METHOD void
applications::exahype2::exaskred::ADERDGSolver::nonconservativeProduct(
  const State&                              Q,
  const Difference&                         deltaQ,
  const Coordinates&                        x,
  const Coordinates&                        h,
  const double                              t,
  const double                              dt,
  const int                                 normal,
  NonconservativeProduct&                   BTimesDeltaQ,
  [[maybe_unused]] const RuntimeParameters& parameters
) {
  applications::exahype2::exaskred::shallowwater::nonconservativeProduct(
    Q,
    deltaQ,
    x,
    h,
    t,
    dt,
    normal,
    g,
    hThreshold,
    BTimesDeltaQ
  );
}

INLINE_METHOD GPU_CALLABLE_METHOD double
applications::exahype2::exaskred::ADERDGSolver::solveSubcellRiemannProblem(
  const State&                              QL,
  const State&                              QR,
  const Coordinates&                        x,
  const Coordinates&                        h,
  const double                              t,
  const double                              dt,
  const int                                 normal,
  [[maybe_unused]] const bool               isBoundaryFace,
  [[maybe_unused]] const int                faceIndex,
  Flux&                                     FL,
  Flux&                                     FR,
  [[maybe_unused]] const RuntimeParameters& parameters
) {
  return applications::exahype2::exaskred::riemann::augmentedState<&State::b>(
    QL,
    QR,
    x,
    h,
    t,
    dt,
    normal,
    g,
    hThreshold,
    FL,
    FR
  );
}

INLINE_METHOD GPU_CALLABLE_METHOD bool
applications::exahype2::exaskred::ADERDGSolver::isPhysicallyAdmissible(
  const States                              Q,
  [[maybe_unused]] const Coordinates&       x,
  [[maybe_unused]] const Coordinates&       h,
  [[maybe_unused]] const RuntimeParameters& parameters
) {
  if (Q.size() == 1) {
    return applications::exahype2::exaskred::limiting::isAdmissibleState(Q[0], 0.0);
  }
  return applications::exahype2::exaskred::limiting::hasBoundedDepthVariation(
    Q,
    std::max(100.0 * hThreshold, 0.045),
    0.35
  );
}

INLINE_METHOD GPU_CALLABLE_METHOD double
applications::exahype2::exaskred::ADERDGSolver::solveRiemannProblem(
  const FaceStates&                         QL,
  const FaceStates&                         QR,
  const Coordinates&                        x,
  const Coordinates&                        h,
  const double                              t,
  const double                              dt,
  const int                                 normal,
  [[maybe_unused]] const bool               isBoundaryFace,
  [[maybe_unused]] const int                faceIndex,
  FaceFluxes&                               FL,
  FaceFluxes&                               FR,
  [[maybe_unused]] const RuntimeParameters& parameters
) {
  const auto waterEigenvalue = [](
                                 const State&       Q,
                                 const Coordinates& facePosition,
                                 const Coordinates& faceSize,
                                 const double       time,
                                 const double       timeStepSize,
                                 const int          direction
                               ) {
    return applications::exahype2::exaskred::shallowwater::maxEigenvalue(
      Q,
      facePosition,
      faceSize,
      time,
      timeStepSize,
      direction,
      g,
      hThreshold
    );
  };
  const auto interfaceGravity = []([[maybe_unused]] const State& QLeft, [[maybe_unused]] const State& QRight) {
    return g;
  };
  return applications::exahype2::exaskred::riemann::wellBalancedRusanov<&State::b>(
    QL,
    QR,
    x,
    h,
    t,
    dt,
    normal,
    waterEigenvalue,
    interfaceGravity,
    FL,
    FR
  );
}
TARGET_DECLARE_END
