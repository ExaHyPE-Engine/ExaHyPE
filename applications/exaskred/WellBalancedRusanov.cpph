#include "tarch/Assertions.h"

/**
 * Replaces the physical fluxes FL and FR of the nodes of one Galerkin face by a well-balanced
 * Rusanov flux and returns the largest wave speed of the nodes. The dissipation acts on the
 * free-surface jump. A resting layer with a flat free surface then stays at rest over any terrain. The
 * callable maxEigenvalue(Q, x, h, t, dt, normal) returns the wave speed of one state and
 * interfaceGravity(QL, QR) the gravity between two states.
 */
template <auto Bathymetry, typename FaceStates, typename FaceFluxes, typename MaxEigenvalue, typename InterfaceGravity>
INLINE_METHOD GPU_CALLABLE_METHOD double
applications::exahype2::exaskred::riemann::wellBalancedRusanov(
  const FaceStates&                            QL,
  const FaceStates&                            QR,
  const tarch::la::Vector<DIMENSIONS, double>& x,
  const tarch::la::Vector<DIMENSIONS, double>& h,
  const double                                 t,
  const double                                 dt,
  const int                                    normal,
  MaxEigenvalue&&                              maxEigenvalue,
  InterfaceGravity&&                           interfaceGravity,
  FaceFluxes&                                  FL,
  FaceFluxes&                                  FR
) {
  constexpr int NumberOfFaceNodes = std::extent_v<FaceStates>;
  static_assert(
    std::extent_v<FaceFluxes> == NumberOfFaceNodes,
    "The well-balanced Rusanov solver reads one flux per state of the face."
  );
  using Value = decltype(QL[0].h);
  ASSERTION(normal >= 0 and normal < DIMENSIONS, normal);

  double maximumEigenvalue = 0.0;
  for (int node = 0; node < NumberOfFaceNodes; node++) {
    maximumEigenvalue = std::max(maximumEigenvalue, static_cast<double>(maxEigenvalue(QL[node], x, h, t, dt, normal)));
    maximumEigenvalue = std::max(maximumEigenvalue, static_cast<double>(maxEigenvalue(QR[node], x, h, t, dt, normal)));
  }
  const auto dissipation = static_cast<Value>(maximumEigenvalue);

  for (int node = 0; node < NumberOfFaceNodes; node++) {
    const auto& leftState  = QL[node];
    const auto& rightState = QR[node];
    auto&       leftFlux   = FL[node];
    auto&       rightFlux  = FR[node];

    leftFlux.h = static_cast<Value>(0.5)
      * (leftFlux.h + rightFlux.h
         + dissipation * (leftState.h + leftState.*Bathymetry - rightState.h - rightState.*Bathymetry));
    for (int dimension = 0; dimension < DIMENSIONS; dimension++) {
      leftFlux.hu(dimension) = static_cast<Value>(0.5)
        * (leftFlux.hu(dimension) + rightFlux.hu(dimension)
           + dissipation * (leftState.hu(dimension) - rightState.hu(dimension)));
    }

    rightFlux.h  = leftFlux.h;
    rightFlux.hu = leftFlux.hu;
    if constexpr (requires { leftFlux.*Bathymetry = Value{}; }) {
      leftFlux.*Bathymetry  = Value{};
      rightFlux.*Bathymetry = Value{};
    }

    const auto gravity         = static_cast<Value>(interfaceGravity(leftState, rightState));
    const auto hydrostaticJump = rightState.*Bathymetry + rightState.h - leftState.*Bathymetry - leftState.h;
    const auto averageHeight   = static_cast<Value>(0.5) * (leftState.h + rightState.h);
    leftFlux.hu(normal) += static_cast<Value>(0.5) * gravity * averageHeight * hydrostaticJump;
    rightFlux.hu(normal) -= static_cast<Value>(0.5) * gravity * averageHeight * hydrostaticJump;
  }
  return maximumEigenvalue;
}
