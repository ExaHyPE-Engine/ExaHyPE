#include "tarch/Assertions.h"

/**
 * Returns whether every value of a state is finite and the layer of Height and Momentum has a
 * non-negative height and rests where dry. A dry layer may keep a momentum up to a rounding tolerance
 * of the momentum scale of the dry height.
 */
template <auto Height, auto Momentum, typename State>
INLINE_METHOD GPU_CALLABLE_METHOD bool
applications::exahype2::exaskred::landslide::isAdmissibleGranularLayerState(
  const State&                                                Q,
  const applications::exahype2::exaskred::landslide::Physics& physics
) {
  if (not allOf(Q, [](const auto value) { return std::isfinite(static_cast<double>(value)); })) {
    return false;
  }

  const double height = static_cast<double>(Q.*Height);
  if (height < 0.0) {
    return false;
  }

  const auto&  momentum        = Q.*Momentum;
  const double momentumSquared = static_cast<double>(momentum(0) * momentum(0) + momentum(1) * momentum(1));

  const double dryHeight = std::max(physics.dryHeightThreshold, 0.0);
  if (height <= dryHeight) {
    const double dryVelocityScale     = std::sqrt(std::max(physics.gravity, 0.0) * dryHeight);
    const double dryMomentumScale     = dryHeight * dryVelocityScale;
    const double dryMomentumTolerance = std::sqrt(std::numeric_limits<double>::epsilon()) * dryMomentumScale;

    if (std::sqrt(momentumSquared) > dryMomentumTolerance) {
      return false;
    }
  }

  return true;
}

/**
 * Returns whether every state of a cell is admissible and the friction of the layer of Height and
 * Momentum stays integrable. The turbulent-friction stiffness of a wet, moving state times the cell
 * size stays below maxFrictionToWaveSpeedRatio times the wave speed.
 */
template <auto Height, auto Momentum, typename State>
INLINE_METHOD GPU_CALLABLE_METHOD bool
applications::exahype2::exaskred::landslide::isAdmissibleGranularLayerCell(
  const std::span<const State>                                Q,
  const tarch::la::Vector<DIMENSIONS, double>&                cellSize,
  const applications::exahype2::exaskred::landslide::Physics& physics,
  const double                                                maxFrictionToWaveSpeedRatio
) {
  for (const State& state : Q) {
    if (not isAdmissibleGranularLayerState<Height, Momentum>(state, physics)) {
      return false;
    }

    const double dryHeight = std::max(physics.dryHeightThreshold, 0.0);
    const double height    = static_cast<double>(state.*Height);
    if (height <= dryHeight or physics.inverseTurbulentFrictionLength <= 0.0 or maxFrictionToWaveSpeedRatio <= 0.0) {
      continue;
    }

    const auto&  stateMomentum = state.*Momentum;
    const double momentum =
      std::sqrt(static_cast<double>(stateMomentum(0) * stateMomentum(0) + stateMomentum(1) * stateMomentum(1)));
    if (momentum <= 0.0) {
      continue;
    }

    double maxCellSize = 0.0;
    for (int dimension = 0; dimension < DIMENSIONS; dimension++) {
      maxCellSize = std::max(maxCellSize, cellSize(dimension));
    }

    const double velocityScale = momentum / height;
    const double waveScale     = std::max(
      velocityScale + std::sqrt(std::max(physics.gravity, 0.0) * height),
      std::sqrt(std::max(physics.gravity, 0.0) * dryHeight)
    );
    const double frictionRate =
      2.0 * physics.gravity * momentum * physics.inverseTurbulentFrictionLength / (height * height);
    const double frictionSpeed = maxCellSize * frictionRate;

    if (frictionSpeed > maxFrictionToWaveSpeedRatio * waveScale) {
      return false;
    }
  }

  return true;
}

/**
 * Returns whether the largest second difference of the nodal heights Height stays below
 * maxCurvatureRatio times the height span of the cell. A cell that is dry at every node passes.
 */
template <auto Height, typename State>
INLINE_METHOD GPU_CALLABLE_METHOD bool
applications::exahype2::exaskred::landslide::hasAdmissibleGranularLayerHeightCurvature2D(
  const std::span<const State>                                Q,
  const int                                                   nodesPerAxis,
  const applications::exahype2::exaskred::landslide::Physics& physics,
  const double                                                maxCurvatureRatio
) {
  ASSERTION(static_cast<int>(Q.size()) == nodesPerAxis * nodesPerAxis, static_cast<int>(Q.size()), nodesPerAxis);
  if (maxCurvatureRatio <= 0.0 or nodesPerAxis < 3) {
    return true;
  }

  double minHeight = std::numeric_limits<double>::max();
  double maxHeight = std::numeric_limits<double>::lowest();
  for (const State& state : Q) {
    const double height = static_cast<double>(state.*Height);
    if (not std::isfinite(height)) {
      return false;
    }
    minHeight = std::min(minHeight, height);
    maxHeight = std::max(maxHeight, height);
  }

  const double dryHeight = std::max(physics.dryHeightThreshold, 0.0);
  if (maxHeight <= dryHeight) {
    return true;
  }

  const auto heightAt = [Q, nodesPerAxis](const int nodeX, const int nodeY) {
    return static_cast<double>(Q[nodeY * nodesPerAxis + nodeX].*Height);
  };

  double maxCurvature = 0.0;
  for (int nodeY = 0; nodeY < nodesPerAxis; nodeY++) {
    for (int nodeX = 1; nodeX < nodesPerAxis - 1; nodeX++) {
      maxCurvature = std::max(
        maxCurvature,
        std::abs(heightAt(nodeX + 1, nodeY) - 2.0 * heightAt(nodeX, nodeY) + heightAt(nodeX - 1, nodeY))
      );
    }
  }
  for (int nodeY = 1; nodeY < nodesPerAxis - 1; nodeY++) {
    for (int nodeX = 0; nodeX < nodesPerAxis; nodeX++) {
      maxCurvature = std::max(
        maxCurvature,
        std::abs(heightAt(nodeX, nodeY + 1) - 2.0 * heightAt(nodeX, nodeY) + heightAt(nodeX, nodeY - 1))
      );
    }
  }

  const double localHeightScale = std::max(maxHeight - minHeight, dryHeight);
  return maxCurvature <= maxCurvatureRatio * localHeightScale;
}

/**
 * Maps one state to the height and momentum observables the DMP tracks.
 */
template <typename State, typename Observables>
INLINE_METHOD GPU_CALLABLE_METHOD void
applications::exahype2::exaskred::landslide::mapGranularLayerDmpObservables(Observables& observables, const State& Q) {
  observables(0) = Q.h;
  observables(1) = Q.hu(0);
  observables(2) = Q.hu(1);
}

/**
 * Returns the DMP relaxation of an observable. The relaxation of the height is at least the dry
 * height. The relaxation of a momentum is at least the dry momentum scale.
 */
INLINE_METHOD GPU_CALLABLE_METHOD double
applications::exahype2::exaskred::landslide::getGranularLayerDMPRelaxationParameter(
  const int                                                   observable,
  const double                                                specifiedRelaxationParameter,
  const applications::exahype2::exaskred::landslide::Physics& physics
) {
  const double dryHeight = std::max(physics.dryHeightThreshold, 0.0);
  if (observable == 0) {
    return std::max(specifiedRelaxationParameter, dryHeight);
  }

  const double dryVelocityScale = std::sqrt(std::max(physics.gravity, 0.0) * dryHeight);
  return std::max(specifiedRelaxationParameter, dryHeight * dryVelocityScale);
}
