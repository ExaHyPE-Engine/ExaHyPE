template <class Shortcuts, int NumberOfUnknowns, class T>
static inline GPU_CALLABLE_METHOD void applications::exahype2::exaskred::landslide::flux(
  const T* const NOALIAS                       Q,
  const tarch::la::Vector<DIMENSIONS, double>& x,
  const tarch::la::Vector<DIMENSIONS, double>& h,
  const double                                 t,
  const double                                 dt,
  const int                                    normal,
  T* const NOALIAS                             F
) {
  (void)x;
  (void)h;
  (void)t;
  (void)dt;

  for (int i = 0; i < NumberOfUnknowns; ++i) {
    F[i] = 0.0;
  }

  if (Q[Shortcuts::h] <= hThreshold) {
    return;
  }

  const T inverseHeight  = 1.0 / Q[Shortcuts::h];
  const T normalMomentum = Q[Shortcuts::hu + normal];
  F[Shortcuts::h]        = normalMomentum;
  F[Shortcuts::hu]       = normalMomentum * Q[Shortcuts::hu] * inverseHeight;
  F[Shortcuts::hv]       = normalMomentum * Q[Shortcuts::hv] * inverseHeight;
}

template <class Shortcuts, class T>
static inline GPU_CALLABLE_METHOD double applications::exahype2::exaskred::landslide::maxEigenvalue(
  const T* const NOALIAS                       Q,
  const tarch::la::Vector<DIMENSIONS, double>& x,
  const tarch::la::Vector<DIMENSIONS, double>& h,
  const double                                 t,
  const double                                 dt,
  const int                                    normal
) {
  (void)x;
  (void)t;
  (void)dt;

  if (Q[Shortcuts::h] <= hThreshold) {
    return 0.0;
  }

  const T normalVelocity = Q[Shortcuts::hu + normal] / Q[Shortcuts::h];
  const T waveSpeed      = std::sqrt(g * Q[Shortcuts::h]);
  const T momentum       = std::sqrt(Q[Shortcuts::hu] * Q[Shortcuts::hu] + Q[Shortcuts::hv] * Q[Shortcuts::hv]);
  const T sourceSpeed    = 2.0 * g * momentum * invXi / (Q[Shortcuts::h] * Q[Shortcuts::h]);

  return std::fmax(
    std::fmax(std::fabs(normalVelocity + waveSpeed), std::fabs(normalVelocity - waveSpeed)),
    h[normal] * sourceSpeed
  );
}
