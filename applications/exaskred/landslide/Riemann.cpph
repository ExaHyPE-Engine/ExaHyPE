template <class Shortcuts, int NumberOfUnknowns, int NumberOfAuxiliaryVariables, class T>
static inline GPU_CALLABLE_METHOD double applications::exahype2::exaskred::landslide::solveRiemannProblem(
  const T* const NOALIAS                       QL,
  const T* const NOALIAS                       QR,
  const tarch::la::Vector<DIMENSIONS, double>& x,
  const tarch::la::Vector<DIMENSIONS, double>& h,
  const double                                 t,
  const double                                 dt,
  const int                                    normal,
  T* const NOALIAS                             FL,
  T* const NOALIAS                             FR
) {
  flux<Shortcuts, NumberOfUnknowns>(QL, x, h, t, dt, normal, FL);
  flux<Shortcuts, NumberOfUnknowns>(QR, x, h, t, dt, normal, FR);

  T smax = 0.0;
  if (QL[Shortcuts::h] > hThreshold) {
    const T normalVelocity = QL[Shortcuts::hu + normal] / QL[Shortcuts::h];
    const T waveSpeed      = std::sqrt(g * QL[Shortcuts::h]);
    smax = std::fmax(smax, std::fmax(std::fabs(normalVelocity + waveSpeed), std::fabs(normalVelocity - waveSpeed)));
  }
  if (QR[Shortcuts::h] > hThreshold) {
    const T normalVelocity = QR[Shortcuts::hu + normal] / QR[Shortcuts::h];
    const T waveSpeed      = std::sqrt(g * QR[Shortcuts::h]);
    smax = std::fmax(smax, std::fmax(std::fabs(normalVelocity + waveSpeed), std::fabs(normalVelocity - waveSpeed)));
  }

  constexpr int StateSize         = NumberOfUnknowns + NumberOfAuxiliaryVariables;
  T             Qavg[StateSize]   = {};
  T             deltaQ[StateSize] = {};
  for (int i = 0; i < NumberOfUnknowns; ++i) {
    Qavg[i]   = 0.5 * (QL[i] + QR[i]);
    deltaQ[i] = QR[i] - QL[i];
    FL[i]     = 0.5 * (FL[i] + FR[i] - smax * deltaQ[i]);
    FR[i]     = FL[i];
  }
  for (int i = NumberOfUnknowns; i < StateSize; ++i) {
    Qavg[i]   = 0.5 * (QL[i] + QR[i]);
    deltaQ[i] = QR[i] - QL[i];
  }

  T ncp[NumberOfUnknowns] = {};
  nonconservativeProduct<Shortcuts, NumberOfUnknowns, true>(Qavg, deltaQ, x, h, t, dt, normal, ncp);
  for (int i = 0; i < NumberOfUnknowns; ++i) {
    FL[i] += 0.5 * ncp[i];
    FR[i] -= 0.5 * ncp[i];
  }

  T sourceSpeedLeft = 0.0;
  if (QL[Shortcuts::h] > hThreshold) {
    const T leftHeight = QL[Shortcuts::h] > hThreshold ? QL[Shortcuts::h] : hThreshold;
    const T momentum   = std::sqrt(QL[Shortcuts::hu] * QL[Shortcuts::hu] + QL[Shortcuts::hv] * QL[Shortcuts::hv]);
    sourceSpeedLeft    = 2.0 * g * momentum * invXi / (leftHeight * leftHeight);
  }

  T sourceSpeedRight = 0.0;
  if (QL[Shortcuts::h] > hThreshold) {
    const T rightHeight = QR[Shortcuts::h] > hThreshold ? QR[Shortcuts::h] : hThreshold;
    const T momentum    = std::sqrt(QR[Shortcuts::hu] * QR[Shortcuts::hu] + QR[Shortcuts::hv] * QR[Shortcuts::hv]);
    sourceSpeedRight    = 2.0 * g * momentum * invXi / (rightHeight * rightHeight);
  }

  return std::fmax(smax, h[normal] * std::fmax(sourceSpeedLeft, sourceSpeedRight));
}

template <class Shortcuts, int NumberOfUnknowns, int Order, class T>
static inline GPU_CALLABLE_METHOD void applications::exahype2::exaskred::landslide::aderdgRiemannSolver(
  T* const NOALIAS                             FL,
  T* const NOALIAS                             FR,
  const T* const NOALIAS                       QL,
  const T* const NOALIAS                       QR,
  const double                                 t,
  const double                                 dt,
  const tarch::la::Vector<DIMENSIONS, double>& x,
  const tarch::la::Vector<DIMENSIONS, double>& h,
  const int                                    direction,
  const bool                                   isBoundaryFace,
  const int                                    faceIndex,
  const double* const NOALIAS                  quadratureWeights
) {
  (void)x;
  (void)t;
  (void)dt;
  (void)isBoundaryFace;
  (void)faceIndex;

  T QavgL[NumberOfUnknowns] = {};
  T QavgR[NumberOfUnknowns] = {};
  for (int xy = 0; xy < Order + 1; ++xy) {
    for (int i = 0; i < NumberOfUnknowns; ++i) {
      QavgL[i] += quadratureWeights[xy] * QL[xy * NumberOfUnknowns + i];
      QavgR[i] += quadratureWeights[xy] * QR[xy * NumberOfUnknowns + i];
    }
  }

  T smax = 0.0;
  if (QavgL[Shortcuts::h] > hThreshold) {
    const T normalVelocity = QavgL[Shortcuts::hu + direction] / QavgL[Shortcuts::h];
    const T waveSpeed      = std::sqrt(g * QavgL[Shortcuts::h]);
    smax = std::fmax(smax, std::fmax(std::fabs(normalVelocity + waveSpeed), std::fabs(normalVelocity - waveSpeed)));
  }
  if (QavgR[Shortcuts::h] > hThreshold) {
    const T normalVelocity = QavgR[Shortcuts::hu + direction] / QavgR[Shortcuts::h];
    const T waveSpeed      = std::sqrt(g * QavgR[Shortcuts::h]);
    smax = std::fmax(smax, std::fmax(std::fabs(normalVelocity + waveSpeed), std::fabs(normalVelocity - waveSpeed)));
  }

  for (int xy = 0; xy < Order + 1; ++xy) {
    for (int i = 0; i < NumberOfUnknowns; ++i) {
      const int j           = xy * NumberOfUnknowns + i;
      const T   rusanovFlux = 0.5 * (FL[j] + FR[j] + smax * (QL[j] - QR[j]));
      FL[j]                 = rusanovFlux;
      FR[j]                 = rusanovFlux;
    }

    const int topographyIndex = xy * NumberOfUnknowns + Shortcuts::z;
    FL[topographyIndex]       = 0.0;
    FR[topographyIndex]       = 0.0;
  }
}
