}

/**
 * Returns the wave speed of the well-balanced Rusanov flux between the sanitised face states. The
 * sanitisation keeps the momenta of dry nodes out of the dissipation and the jump terms.
 */
INLINE_METHOD GPU_CALLABLE_METHOD double
applications::exahype2::exaskred::ADERDGSolver::solveRiemannProblem(
  const FaceStates&                         QL,
  const FaceStates&                         QR,
  const Coordinates&                        x,
  const Coordinates&                        h,
  const double                              t,
  const double                              dt,
  const int                                 normal,
  [[maybe_unused]] const bool               isBoundaryFace,
  [[maybe_unused]] const int                faceIndex,
  FaceFluxes&                               FL,
  FaceFluxes&                               FR,
  [[maybe_unused]] const RuntimeParameters& parameters
) {
  constexpr int NumberOfFaceNodes = DGOrder + 1;
  FaceStates    sanitisedQL;
  FaceStates    sanitisedQR;
  for (int node = 0; node < NumberOfFaceNodes; node++) {
    applications::exahype2::exaskred::landslide::sanitiseDryState(QL[node], sanitisedQL[node], getLandslidePhysics());
    applications::exahype2::exaskred::landslide::sanitiseDryState(QR[node], sanitisedQR[node], getLandslidePhysics());
  }
  const auto slideEigenvalue = [](
                                 const State&       Q,
                                 const Coordinates& facePosition,
                                 const Coordinates& faceSize,
                                 const double       time,
                                 const double       timeStepSize,
                                 const int          direction
                               ) {
    return applications::exahype2::exaskred::landslide::getFluxEigenvalue(
      Q,
      facePosition,
      faceSize,
      time,
      timeStepSize,
      direction,
      getLandslidePhysics()
    );
  };
  const auto interfaceGravity = [](const State& QLeft, const State& QRight) {
    return applications::exahype2::exaskred::landslide::getInterfaceEffectiveGravity(
      QLeft,
      QRight,
      getLandslidePhysics()
    );
  };
  return applications::exahype2::exaskred::riemann::wellBalancedRusanov<&State::z>(
    sanitisedQL,
    sanitisedQR,
    x,
    h,
    t,
    dt,
    normal,
    slideEigenvalue,
    interfaceGravity,
    FL,
    FR
  );
}

/**
 * Returns the wave speed of the augmented Riemann solver between the sanitised subcell states.
 */
INLINE_METHOD GPU_CALLABLE_METHOD double
applications::exahype2::exaskred::ADERDGSolver::solveSubcellRiemannProblem(
  const State&                              QL,
  const State&                              QR,
  const Coordinates&                        x,
  const Coordinates&                        h,
  const double                              t,
  const double                              dt,
  const int                                 normal,
  [[maybe_unused]] const bool               isBoundaryFace,
  [[maybe_unused]] const int                faceIndex,
  Flux&                                     FL,
  Flux&                                     FR,
  [[maybe_unused]] const RuntimeParameters& parameters
) {
  State sanitisedQL;
  State sanitisedQR;
  applications::exahype2::exaskred::landslide::sanitiseDryState(QL, sanitisedQL, getLandslidePhysics());
  applications::exahype2::exaskred::landslide::sanitiseDryState(QR, sanitisedQR, getLandslidePhysics());
  return applications::exahype2::exaskred::riemann::augmentedState<&State::z>(
    sanitisedQL,
    sanitisedQR,
    x,
    h,
    t,
    dt,
    normal,
    applications::exahype2::exaskred::landslide::getInterfaceEffectiveGravity(
      sanitisedQL,
      sanitisedQR,
      getLandslidePhysics()
    ),
    getLandslidePhysics().dryHeightThreshold,
    FL,
    FR
  );
}

/**
 * Returns whether every state of the granular layer is finite, non-negative, at rest where dry and
 * of integrable friction stiffness. A nodal candidate also needs a bounded height curvature.
 */
INLINE_METHOD GPU_CALLABLE_METHOD bool
applications::exahype2::exaskred::ADERDGSolver::isPhysicallyAdmissible(
  const States                              Q,
  [[maybe_unused]] const Coordinates&       x,
  const Coordinates&                        h,
  [[maybe_unused]] const RuntimeParameters& parameters
) {
  if (not applications::exahype2::exaskred::landslide::isAdmissibleGranularLayerCell<&State::h, &State::hu>(
        Q,
        h,
        getLandslidePhysics(),
        maxFrictionStiffnessRatio
      )) {
    return false;
  }
  const int numberOfStates = static_cast<int>(Q.size());
  const int nodesPerAxis   = static_cast<int>(std::sqrt(static_cast<double>(numberOfStates)) + 0.5);
  if (numberOfStates > 1 and nodesPerAxis * nodesPerAxis == numberOfStates) {
    return applications::exahype2::exaskred::landslide::hasAdmissibleGranularLayerHeightCurvature2D<&State::h>(
      Q,
      nodesPerAxis,
      getLandslidePhysics(),
      maxHeightCurvatureRatio
    );
  }
  return true;
}

INLINE_METHOD GPU_CALLABLE_METHOD void
applications::exahype2::exaskred::ADERDGSolver::mapDmpObservables(
  Observables&                              observables,
  const State&                              Q,
  [[maybe_unused]] const RuntimeParameters& parameters
) {
  applications::exahype2::exaskred::landslide::mapGranularLayerDmpObservables(observables, Q);
}

INLINE_METHOD GPU_CALLABLE_METHOD double
applications::exahype2::exaskred::ADERDGSolver::dmpRelaxationParameter(
  const int                                 observable,
  const double                              specifiedRelaxationParameter,
  [[maybe_unused]] const RuntimeParameters& parameters
) {
  return applications::exahype2::exaskred::landslide::getGranularLayerDMPRelaxationParameter(
    observable,
    specifiedRelaxationParameter,
    getLandslidePhysics()
  );
}
