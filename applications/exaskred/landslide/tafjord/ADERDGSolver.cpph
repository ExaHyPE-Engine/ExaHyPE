TARGET_DECLARE
namespace applications::exahype2::exaskred {
  INLINE_METHOD GPU_CALLABLE_METHOD constexpr applications::exahype2::exaskred::landslide::Physics
  getLandslidePhysics();
} // namespace applications::exahype2::exaskred

INLINE_METHOD GPU_CALLABLE_METHOD constexpr applications::exahype2::exaskred::landslide::Physics
applications::exahype2::exaskred::getLandslidePhysics() {
  return {
    g,
    hThreshold,
    mu,
    invXi,
    rhoSlide,
    rhoWater,
    waterLevel,
    waterFrictionDragCoefficient,
    waterPressureDragCoefficient
  };
}

INLINE_METHOD void
applications::exahype2::exaskred::ADERDGSolver::initialCondition(
  State&                              Q,
  const Coordinates&                  x,
  [[maybe_unused]] const Coordinates& h,
  const RuntimeParameters&            parameters
) {
  Q = {};

  const auto&                                       bathymetrySize   = parameters.bathymetrySize;
  const auto&                                       bathymetryOffset = parameters.bathymetryOffset;
  static const tarch::reader::NetCDFFieldSampler<2> bathymetrySampler(
    {{"bathymetry", std::string(parameters.bathymetryFile), "Band1", {"x", "y"}}},
    {bathymetrySize(0), bathymetrySize(1)},
    {bathymetryOffset(0), bathymetryOffset(1)}
  );

  const auto&                                       displacementSize     = parameters.displacementSize;
  const auto&                                       displacementOffset   = parameters.displacementOffset;
  const auto&                                       displacementPosition = parameters.displacementPosition;
  static const tarch::reader::NetCDFFieldSampler<2> displacementSampler(
    {{"displacement", std::string(parameters.displacementFile), "Band1", {"x", "y"}}},
    {displacementSize(0), displacementSize(1)},
    {displacementOffset(0), displacementOffset(1)}
  );

  const double displacement = displacementSampler.sampleBilinear(
    "displacement",
    {x(0) - displacementPosition(0), x(1) - displacementPosition(1)}
  );

  if (not bathymetrySampler.covers("bathymetry", {x(0), x(1)})) {
    tarch::terminateWithError(
      "The bathymetry file '" + std::string(parameters.bathymetryFile) + "' has to cover the point ("
      + std::to_string(x(0)) + ", " + std::to_string(x(1)) + ") of the domain."
    );
  }

  Q.h = displacement > 0.0 ? displacement : 0.0;
  Q.z = bathymetrySampler.sampleBilinear("bathymetry", {x(0), x(1)});
}

INLINE_METHOD GPU_CALLABLE_METHOD void
applications::exahype2::exaskred::ADERDGSolver::boundaryConditions(
  const State&                              Qinside,
  State&                                    Qoutside,
  [[maybe_unused]] const Coordinates&       x,
  [[maybe_unused]] const Coordinates&       h,
  [[maybe_unused]] const double             t,
  [[maybe_unused]] const int                normal,
  [[maybe_unused]] const RuntimeParameters& parameters
) {
  Qoutside = Qinside;
}

/**
 * Refines a cell that overlaps the region of the displacement file. Every other cell keeps its
 * level. The initial condition writes the bathymetry and the slide material of every cell.
 */
INLINE_METHOD GPU_CALLABLE_METHOD ::exahype2::RefinementCommand
applications::exahype2::exaskred::ADERDGSolver::refinementCriterion(
  [[maybe_unused]] const CellStates* Q,
  const Coordinates&                 x,
  const Coordinates&                 h,
  [[maybe_unused]] const double      t,
  const RuntimeParameters&           parameters
) {
  ASSERTION(h(0) > 0.0 and h(1) > 0.0, h);
  const auto& displacementSize     = parameters.displacementSize;
  const auto& displacementOffset   = parameters.displacementOffset;
  const auto& displacementPosition = parameters.displacementPosition;
  bool        overlapsDisplacement = true;
  for (int axis = 0; axis < DIMENSIONS; axis++) {
    ASSERTION(displacementSize(axis) >= 0.0, axis, displacementSize(axis));
    const double lower   = displacementOffset(axis) + displacementPosition(axis);
    const double upper   = lower + displacementSize(axis);
    overlapsDisplacement = overlapsDisplacement and x(axis) + 0.5 * h(axis) > lower and x(axis) - 0.5 * h(axis) < upper;
  }
  return overlapsDisplacement ? ::exahype2::RefinementCommand::Refine : ::exahype2::RefinementCommand::Keep;
}

INLINE_METHOD GPU_CALLABLE_METHOD void
applications::exahype2::exaskred::ADERDGSolver::flux(
  const State&                              Q,
  const Coordinates&                        x,
  const Coordinates&                        h,
  const double                              t,
  const double                              dt,
  const int                                 normal,
  Flux&                                     F,
  [[maybe_unused]] const RuntimeParameters& parameters
) {
  applications::exahype2::exaskred::landslide::flux(Q, x, h, t, dt, normal, getLandslidePhysics(), F);
}

INLINE_METHOD GPU_CALLABLE_METHOD double
applications::exahype2::exaskred::ADERDGSolver::maxEigenvalue(
  const State&                              Q,
  const Coordinates&                        x,
  const Coordinates&                        h,
  const double                              t,
  const double                              dt,
  const int                                 normal,
  [[maybe_unused]] const RuntimeParameters& parameters
) {
  return applications::exahype2::exaskred::landslide::getEffectiveMaxEigenvalue(
    Q,
    x,
    h,
    t,
    dt,
    normal,
    getLandslidePhysics(),
    PNPM / static_cast<double>(DIMENSIONS)
  );
}

