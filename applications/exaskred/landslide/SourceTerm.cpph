template <class Shortcuts, int NumberOfUnknowns, int NumberOfAuxiliaryVariables, bool IncludeTurbulentDrag, class T>
static inline GPU_CALLABLE_METHOD void applications::exahype2::exaskred::landslide::diffusiveSourceTerm(
  const T* const NOALIAS                       Q,
  const T* const NOALIAS                       deltaQ,
  const tarch::la::Vector<DIMENSIONS, double>& x,
  const tarch::la::Vector<DIMENSIONS, double>& h,
  const double                                 t,
  const double                                 dt,
  T* const NOALIAS                             S
) {
  (void)x;
  (void)h;
  (void)t;
  (void)dt;

  for (int i = 0; i < NumberOfUnknowns; ++i) {
    S[i] = 0.0;
  }

  if (Q[Shortcuts::h] <= hThreshold) {
    return;
  }

  const T dzx = deltaQ[Shortcuts::z];
  const T dzy = deltaQ[Shortcuts::z + NumberOfUnknowns + NumberOfAuxiliaryVariables];
  const T cF  = 1.0 / std::sqrt(1.0 + dzx * dzx + dzy * dzy);

  const T momentumSquared = Q[Shortcuts::hu] * Q[Shortcuts::hu] + Q[Shortcuts::hv] * Q[Shortcuts::hv];
  const T momentum        = std::sqrt(momentumSquared);
  if (tarch::la::greater(momentum / Q[Shortcuts::h], 0.0)) {
    T friction = mu * cF * Q[Shortcuts::h];
    if constexpr (IncludeTurbulentDrag) {
      friction += momentumSquared * invXi / (Q[Shortcuts::h] * Q[Shortcuts::h]);
    }

    const T frictionTerm = -g * friction / momentum;
    S[Shortcuts::hu]     = Q[Shortcuts::hu] * frictionTerm;
    S[Shortcuts::hv]     = Q[Shortcuts::hv] * frictionTerm;
  }
}
