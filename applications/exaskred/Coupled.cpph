#include "tarch/Assertions.h"

/**
 * Returns whether a water column above minimumWaterHeight covers the granular layer.
 */
template <typename State>
INLINE_METHOD GPU_CALLABLE_METHOD bool
applications::exahype2::exaskred::coupled::isSlideSubmerged(const State& Q, const double minimumWaterHeight) {
  using Value = decltype(State::h);
  return std::isfinite(static_cast<double>(Q.h)) and Q.h > static_cast<Value>(minimumWaterHeight);
}

template <typename State>
INLINE_METHOD GPU_CALLABLE_METHOD double
applications::exahype2::exaskred::coupled::getSlideGravity(
  const State&                                                Q,
  const applications::exahype2::exaskred::landslide::Physics& physics,
  const double                                                minimumWaterHeight
) {
  return isSlideSubmerged(Q, minimumWaterHeight)
    ? applications::exahype2::exaskred::landslide::getSubmergedGravity(physics)
    : physics.gravity;
}

/**
 * Copies a state and zeroes each layer that is dry or not finite. The two layers dry independently
 * of each other.
 */
template <typename State>
INLINE_METHOD GPU_CALLABLE_METHOD void
applications::exahype2::exaskred::coupled::sanitiseDryLayers(
  const State&                                                QIn,
  State&                                                      QOut,
  const applications::exahype2::exaskred::landslide::Physics& physics,
  const double                                                minimumWaterHeight
) {
  using Value = decltype(State::h);
  QOut        = QIn;
  if (not std::isfinite(static_cast<double>(QIn.h)) or QIn.h <= static_cast<Value>(minimumWaterHeight)) {
    QOut.h  = Value{};
    QOut.hu = Value{};
  }
  if (not std::isfinite(static_cast<double>(QIn.lsh)) or QIn.lsh <= static_cast<Value>(physics.dryHeightThreshold)) {
    QOut.lsh  = Value{};
    QOut.lshu = Value{};
  }
}

/**
 * Adds the water and the granular material that sanitiseDryLayers() removes from Q to the bed of
 * waterLayer. A thin layer at rest then keeps the free surface of its wet neighbours.
 */
template <typename State>
INLINE_METHOD GPU_CALLABLE_METHOD void
applications::exahype2::exaskred::coupled::addRemovedLayersToBed(
  const State&                    Q,
  const State&                    sanitisedQ,
  WaterLayer<decltype(State::h)>& waterLayer
) {
  if (std::isfinite(static_cast<double>(Q.h)) and Q.h > sanitisedQ.h) {
    waterLayer.b += Q.h - sanitisedQ.h;
  }
  if (std::isfinite(static_cast<double>(Q.lsh)) and Q.lsh > sanitisedQ.lsh) {
    waterLayer.b += Q.lsh - sanitisedQ.lsh;
  }
}

template <typename State>
INLINE_METHOD GPU_CALLABLE_METHOD applications::exahype2::exaskred::coupled::WaterLayer<decltype(State::h)>
applications::exahype2::exaskred::coupled::getWaterLayerOf(const State& Q) {
  return {Q.h, Q.hu, Q.z + Q.lsh};
}

template <typename State>
INLINE_METHOD GPU_CALLABLE_METHOD applications::exahype2::exaskred::coupled::SlideLayer<decltype(State::h)>
applications::exahype2::exaskred::coupled::getSlideLayerOf(const State& Q) {
  return {Q.lsh, Q.lshu, Q.z, Q.h};
}

/**
 * Writes the fluxes of both layers. The water pressure enters the nonconservative product. The
 * granular pressure enters the flux.
 */
template <typename State, typename Flux>
INLINE_METHOD GPU_CALLABLE_METHOD void
applications::exahype2::exaskred::coupled::flux(
  const State&                                                Q,
  const tarch::la::Vector<DIMENSIONS, double>&                x,
  const tarch::la::Vector<DIMENSIONS, double>&                h,
  const double                                                t,
  const double                                                dt,
  const int                                                   normal,
  const applications::exahype2::exaskred::landslide::Physics& physics,
  const double                                                minimumWaterHeight,
  Flux&                                                       F
) {
  applications::exahype2::exaskred::shallowwater::flux(Q, x, h, t, dt, normal, minimumWaterHeight, F);

  SlideLayer<decltype(State::h)> slideFlux;
  applications::exahype2::exaskred::landslide::flux(
    getSlideLayerOf(Q),
    x,
    h,
    t,
    dt,
    normal,
    physics,
    getSlideGravity(Q, physics, minimumWaterHeight),
    slideFlux
  );
  F.lsh  = slideFlux.h;
  F.lshu = slideFlux.hu;
}

template <typename State>
INLINE_METHOD GPU_CALLABLE_METHOD double
applications::exahype2::exaskred::coupled::maxEigenvalue(
  const State&                                                Q,
  const tarch::la::Vector<DIMENSIONS, double>&                x,
  const tarch::la::Vector<DIMENSIONS, double>&                h,
  const double                                                t,
  const double                                                dt,
  const int                                                   normal,
  const applications::exahype2::exaskred::landslide::Physics& physics,
  const double                                                minimumWaterHeight,
  const double                                                sourceEigenvalueScaling
) {
  const double waterSpeed = applications::exahype2::exaskred::shallowwater::maxEigenvalue(
    Q,
    x,
    h,
    t,
    dt,
    normal,
    physics.gravity,
    minimumWaterHeight
  );
  const double slideSpeed = applications::exahype2::exaskred::landslide::getEffectiveMaxEigenvalue(
    getSlideLayerOf(Q),
    x,
    h,
    t,
    dt,
    normal,
    physics,
    getSlideGravity(Q, physics, minimumWaterHeight),
    isSlideSubmerged(Q, minimumWaterHeight),
    sourceEigenvalueScaling
  );
  return std::fmax(waterSpeed, slideSpeed);
}

/**
 * Writes the hydrostatic products of both layers. The water layer reads the gradient of the terrain
 * plus the granular layer. Buoyancy reduces the gravity of a submerged granular layer.
 */
template <typename State, typename Difference, typename NonconservativeProduct>
INLINE_METHOD GPU_CALLABLE_METHOD void
applications::exahype2::exaskred::coupled::nonconservativeProduct(
  const State&                                                Q,
  const Difference&                                           deltaQ,
  const tarch::la::Vector<DIMENSIONS, double>&                x,
  const tarch::la::Vector<DIMENSIONS, double>&                h,
  const double                                                t,
  const double                                                dt,
  const int                                                   normal,
  const applications::exahype2::exaskred::landslide::Physics& physics,
  const double                                                minimumWaterHeight,
  NonconservativeProduct&                                     BTimesDeltaQ
) {
  using Value = decltype(State::h);
  ASSERTION(normal >= 0 and normal < DIMENSIONS, normal);

  BTimesDeltaQ = {};
  if (
    std::isfinite(static_cast<double>(Q.h)) and std::isfinite(static_cast<double>(deltaQ.h))
    and std::isfinite(static_cast<double>(deltaQ.z)) and std::isfinite(static_cast<double>(deltaQ.lsh))
    and Q.h > static_cast<Value>(minimumWaterHeight)
  ) {
    BTimesDeltaQ.hu(normal) = static_cast<Value>(physics.gravity) * Q.h * (deltaQ.h + deltaQ.z + deltaQ.lsh);
  }

  SlideLayer<Value> slideProduct;
  applications::exahype2::exaskred::landslide::nonconservativeProduct(
    getSlideLayerOf(Q),
    getSlideLayerOf(deltaQ),
    x,
    h,
    t,
    dt,
    normal,
    physics,
    getSlideGravity(Q, physics, minimumWaterHeight),
    slideProduct
  );
  BTimesDeltaQ.lshu(normal) = slideProduct.hu(normal);
}

template <typename State, typename Gradient, typename Source>
INLINE_METHOD GPU_CALLABLE_METHOD void
applications::exahype2::exaskred::coupled::diffusiveSourceTerm(
  const State&                                                Q,
  const Gradient&                                             deltaQ,
  const tarch::la::Vector<DIMENSIONS, double>&                x,
  const tarch::la::Vector<DIMENSIONS, double>&                h,
  const double                                                t,
  const double                                                dt,
  const applications::exahype2::exaskred::landslide::Physics& physics,
  const double                                                minimumWaterHeight,
  Source&                                                     S
) {
  using Value = decltype(State::h);
  SlideLayer<Value> slideGradient[DIMENSIONS];
  for (int axis = 0; axis < DIMENSIONS; axis++) {
    slideGradient[axis] = getSlideLayerOf(deltaQ[axis]);
  }

  SlideLayer<Value> slideSource;
  applications::exahype2::exaskred::landslide::diffusiveSourceTerm(
    getSlideLayerOf(Q),
    slideGradient,
    x,
    h,
    t,
    dt,
    physics,
    getSlideGravity(Q, physics, minimumWaterHeight),
    isSlideSubmerged(Q, minimumWaterHeight),
    slideSource
  );
  S      = {};
  S.lshu = slideSource.hu;
}

/**
 * Solves the nodal Riemann problems of one Galerkin face with the well-balanced Rusanov solver for
 * each layer. The granular layer takes the submerged gravity where both sides are under water.
 * Returns the larger maximum wave speed of the two layers.
 */
template <typename FaceStates, typename FaceFluxes>
INLINE_METHOD GPU_CALLABLE_METHOD double
applications::exahype2::exaskred::coupled::solveRiemannProblem(
  const FaceStates&                                           QL,
  const FaceStates&                                           QR,
  const tarch::la::Vector<DIMENSIONS, double>&                x,
  const tarch::la::Vector<DIMENSIONS, double>&                h,
  const double                                                t,
  const double                                                dt,
  const int                                                   normal,
  const applications::exahype2::exaskred::landslide::Physics& physics,
  const double                                                minimumWaterHeight,
  FaceFluxes&                                                 FL,
  FaceFluxes&                                                 FR
) {
  using State                     = std::remove_cvref_t<decltype(QL[0])>;
  using Value                     = decltype(State::h);
  constexpr int NumberOfFaceNodes = std::extent_v<FaceStates>;

  WaterLayer<Value> waterLayerL[NumberOfFaceNodes];
  WaterLayer<Value> waterLayerR[NumberOfFaceNodes];
  SlideLayer<Value> slideLayerL[NumberOfFaceNodes];
  SlideLayer<Value> slideLayerR[NumberOfFaceNodes];
  WaterLayer<Value> waterFluxL[NumberOfFaceNodes];
  WaterLayer<Value> waterFluxR[NumberOfFaceNodes];
  SlideLayer<Value> slideFluxL[NumberOfFaceNodes];
  SlideLayer<Value> slideFluxR[NumberOfFaceNodes];

  for (int node = 0; node < NumberOfFaceNodes; node++) {
    State sanitisedL;
    State sanitisedR;
    sanitiseDryLayers(QL[node], sanitisedL, physics, minimumWaterHeight);
    sanitiseDryLayers(QR[node], sanitisedR, physics, minimumWaterHeight);
    waterLayerL[node] = getWaterLayerOf(sanitisedL);
    waterLayerR[node] = getWaterLayerOf(sanitisedR);
    addRemovedLayersToBed(QL[node], sanitisedL, waterLayerL[node]);
    addRemovedLayersToBed(QR[node], sanitisedR, waterLayerR[node]);
    slideLayerL[node] = getSlideLayerOf(sanitisedL);
    slideLayerR[node] = getSlideLayerOf(sanitisedR);

    waterFluxL[node].h  = FL[node].h;
    waterFluxL[node].hu = FL[node].hu;
    waterFluxR[node].h  = FR[node].h;
    waterFluxR[node].hu = FR[node].hu;
    slideFluxL[node].h  = FL[node].lsh;
    slideFluxL[node].hu = FL[node].lshu;
    slideFluxR[node].h  = FR[node].lsh;
    slideFluxR[node].hu = FR[node].lshu;
  }

  const auto waterEigenvalue = [minimumWaterHeight, &physics](
                                 const WaterLayer<Value>&                     layer,
                                 const tarch::la::Vector<DIMENSIONS, double>& facePosition,
                                 const tarch::la::Vector<DIMENSIONS, double>& faceSize,
                                 const double                                 time,
                                 const double                                 timeStepSize,
                                 const int                                    direction
                               ) {
    return applications::exahype2::exaskred::shallowwater::maxEigenvalue(
      layer,
      facePosition,
      faceSize,
      time,
      timeStepSize,
      direction,
      physics.gravity,
      minimumWaterHeight
    );
  };
  const auto   waterGravity   = [&physics](
                                  [[maybe_unused]] const WaterLayer<Value>& leftLayer,
                                  [[maybe_unused]] const WaterLayer<Value>& rightLayer
                                ) { return physics.gravity; };
  const double waterWaveSpeed = applications::exahype2::exaskred::riemann::wellBalancedRusanov<&WaterLayer<Value>::b>(
    waterLayerL,
    waterLayerR,
    x,
    h,
    t,
    dt,
    normal,
    waterEigenvalue,
    waterGravity,
    waterFluxL,
    waterFluxR
  );

  const auto slideEigenvalue = [minimumWaterHeight, &physics](
                                 const SlideLayer<Value>&                     layer,
                                 const tarch::la::Vector<DIMENSIONS, double>& facePosition,
                                 const tarch::la::Vector<DIMENSIONS, double>& faceSize,
                                 const double                                 time,
                                 const double                                 timeStepSize,
                                 const int                                    direction
                               ) {
    const double gravity = layer.waterDepth > static_cast<Value>(minimumWaterHeight)
      ? applications::exahype2::exaskred::landslide::getSubmergedGravity(physics)
      : physics.gravity;
    return applications::exahype2::exaskred::landslide::getFluxEigenvalue(
      layer,
      facePosition,
      faceSize,
      time,
      timeStepSize,
      direction,
      physics,
      gravity
    );
  };
  const auto slideGravityAtFace = [minimumWaterHeight,
                                   &physics](const SlideLayer<Value>& leftLayer, const SlideLayer<Value>& rightLayer) {
    const bool bothSubmerged = leftLayer.waterDepth > static_cast<Value>(minimumWaterHeight)
      and rightLayer.waterDepth > static_cast<Value>(minimumWaterHeight);
    return bothSubmerged ? applications::exahype2::exaskred::landslide::getSubmergedGravity(physics) : physics.gravity;
  };
  const double slideWaveSpeed = applications::exahype2::exaskred::riemann::wellBalancedRusanov<&SlideLayer<Value>::z>(
    slideLayerL,
    slideLayerR,
    x,
    h,
    t,
    dt,
    normal,
    slideEigenvalue,
    slideGravityAtFace,
    slideFluxL,
    slideFluxR
  );

  for (int node = 0; node < NumberOfFaceNodes; node++) {
    FL[node].h    = waterFluxL[node].h;
    FL[node].hu   = waterFluxL[node].hu;
    FR[node].h    = waterFluxR[node].h;
    FR[node].hu   = waterFluxR[node].hu;
    FL[node].lsh  = slideFluxL[node].h;
    FL[node].lshu = slideFluxL[node].hu;
    FR[node].lsh  = slideFluxR[node].h;
    FR[node].lshu = slideFluxR[node].hu;
    FL[node].z    = Value{};
    FR[node].z    = Value{};
  }
  return std::fmax(waterWaveSpeed, slideWaveSpeed);
}

/**
 * Solves one subcell face with the augmented-state solver for each layer.
 */
template <typename State, typename Flux>
INLINE_METHOD GPU_CALLABLE_METHOD double
applications::exahype2::exaskred::coupled::solveSubcellRiemannProblem(
  const State&                                                QL,
  const State&                                                QR,
  const tarch::la::Vector<DIMENSIONS, double>&                x,
  const tarch::la::Vector<DIMENSIONS, double>&                h,
  const double                                                t,
  const double                                                dt,
  const int                                                   normal,
  const applications::exahype2::exaskred::landslide::Physics& physics,
  const double                                                minimumWaterHeight,
  Flux&                                                       FL,
  Flux&                                                       FR
) {
  using Value = decltype(State::h);

  State sanitisedL;
  State sanitisedR;
  sanitiseDryLayers(QL, sanitisedL, physics, minimumWaterHeight);
  sanitiseDryLayers(QR, sanitisedR, physics, minimumWaterHeight);

  WaterLayer<Value> waterLayerL = getWaterLayerOf(sanitisedL);
  WaterLayer<Value> waterLayerR = getWaterLayerOf(sanitisedR);
  addRemovedLayersToBed(QL, sanitisedL, waterLayerL);
  addRemovedLayersToBed(QR, sanitisedR, waterLayerR);
  const SlideLayer<Value> slideLayerL = getSlideLayerOf(sanitisedL);
  const SlideLayer<Value> slideLayerR = getSlideLayerOf(sanitisedR);

  WaterLayer<Value> waterFluxL;
  WaterLayer<Value> waterFluxR;
  SlideLayer<Value> slideFluxL;
  SlideLayer<Value> slideFluxR;

  const double waterWaveSpeed = applications::exahype2::exaskred::riemann::augmentedState<&WaterLayer<Value>::b>(
    waterLayerL,
    waterLayerR,
    x,
    h,
    t,
    dt,
    normal,
    physics.gravity,
    minimumWaterHeight,
    waterFluxL,
    waterFluxR
  );

  const bool bothSubmerged = slideLayerL.waterDepth > static_cast<Value>(minimumWaterHeight)
    and slideLayerR.waterDepth > static_cast<Value>(minimumWaterHeight);
  const double faceSlideGravity =
    bothSubmerged ? applications::exahype2::exaskred::landslide::getSubmergedGravity(physics) : physics.gravity;
  const double slideWaveSpeed = applications::exahype2::exaskred::riemann::augmentedState<&SlideLayer<Value>::z>(
    slideLayerL,
    slideLayerR,
    x,
    h,
    t,
    dt,
    normal,
    faceSlideGravity,
    physics.dryHeightThreshold,
    slideFluxL,
    slideFluxR
  );

  FL.h    = waterFluxL.h;
  FL.hu   = waterFluxL.hu;
  FR.h    = waterFluxR.h;
  FR.hu   = waterFluxR.hu;
  FL.lsh  = slideFluxL.h;
  FL.lshu = slideFluxL.hu;
  FR.lsh  = slideFluxR.h;
  FR.lshu = slideFluxR.hu;
  FL.z    = Value{};
  FR.z    = Value{};

  return std::fmax(waterWaveSpeed, slideWaveSpeed);
}
