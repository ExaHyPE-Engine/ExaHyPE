/**
 * Returns whether a water column above minimumWaterHeight covers the granular layer.
 */
template <class Shortcuts, typename T>
INLINE_METHOD GPU_CALLABLE_METHOD bool
applications::exahype2::exaskred::coupled::isSlideSubmerged(const T* const NOALIAS Q, const double minimumWaterHeight) {
  return std::isfinite(static_cast<double>(Q[Shortcuts::h])) and Q[Shortcuts::h] > static_cast<T>(minimumWaterHeight);
}

template <class Shortcuts, typename T>
INLINE_METHOD GPU_CALLABLE_METHOD double
applications::exahype2::exaskred::coupled::getSlideGravity(
  const T* const NOALIAS                                      Q,
  const applications::exahype2::exaskred::landslide::Physics& physics,
  const double                                                minimumWaterHeight
) {
  return isSlideSubmerged<Shortcuts>(Q, minimumWaterHeight)
    ? applications::exahype2::exaskred::landslide::getSubmergedGravity(physics)
    : physics.gravity;
}

/**
 * Copies a state and zeroes each layer that is dry or not finite. The two layers dry independently
 * of each other.
 */
template <class Shortcuts, int NumberOfUnknowns, int NumberOfAuxiliaryVariables, typename T>
INLINE_METHOD GPU_CALLABLE_METHOD void
applications::exahype2::exaskred::coupled::sanitiseDryLayers(
  const T* const NOALIAS                                      QIn,
  T* const NOALIAS                                            QOut,
  const applications::exahype2::exaskred::landslide::Physics& physics,
  const double                                                minimumWaterHeight
) {
  for (int i = 0; i < NumberOfUnknowns + NumberOfAuxiliaryVariables; i++) {
    QOut[i] = QIn[i];
  }

  if (
    not std::isfinite(static_cast<double>(QIn[Shortcuts::h])) or QIn[Shortcuts::h] <= static_cast<T>(minimumWaterHeight)
  ) {
    QOut[Shortcuts::h]      = T{};
    QOut[Shortcuts::hu]     = T{};
    QOut[Shortcuts::hu + 1] = T{};
  }
  if (
    not std::isfinite(static_cast<double>(QIn[Shortcuts::lsh]))
    or QIn[Shortcuts::lsh] <= static_cast<T>(physics.dryHeightThreshold)
  ) {
    QOut[Shortcuts::lsh]      = T{};
    QOut[Shortcuts::lshu]     = T{};
    QOut[Shortcuts::lshu + 1] = T{};
  }
}

template <class Shortcuts, typename T>
INLINE_METHOD GPU_CALLABLE_METHOD void
applications::exahype2::exaskred::coupled::gatherWaterView(const T* const NOALIAS Q, T* const NOALIAS view) {
  view[WaterView::h]  = Q[Shortcuts::h];
  view[WaterView::hu] = Q[Shortcuts::hu];
  view[WaterView::hv] = Q[Shortcuts::hu + 1];
  view[WaterView::b]  = Q[Shortcuts::z] + Q[Shortcuts::lsh];
}

template <class Shortcuts, typename T>
INLINE_METHOD GPU_CALLABLE_METHOD void
applications::exahype2::exaskred::coupled::gatherSlideView(const T* const NOALIAS Q, T* const NOALIAS view) {
  view[SlideView::h]          = Q[Shortcuts::lsh];
  view[SlideView::hu]         = Q[Shortcuts::lshu];
  view[SlideView::hv]         = Q[Shortcuts::lshu + 1];
  view[SlideView::z]          = Q[Shortcuts::z];
  view[SlideView::WaterDepth] = Q[Shortcuts::h];
}

/**
 * Writes the fluxes of both layers. The water pressure enters the nonconservative product and the
 * granular pressure the flux, as in the standalone scenarios of each layer.
 */
template <class Shortcuts, int NumberOfUnknowns, typename T>
INLINE_METHOD GPU_CALLABLE_METHOD void
applications::exahype2::exaskred::coupled::flux(
  const T* const NOALIAS                                      Q,
  const tarch::la::Vector<DIMENSIONS, double>&                x,
  const tarch::la::Vector<DIMENSIONS, double>&                h,
  const double                                                t,
  const double                                                dt,
  const int                                                   normal,
  const applications::exahype2::exaskred::landslide::Physics& physics,
  const double                                                minimumWaterHeight,
  T* const NOALIAS                                            F
) {
  applications::exahype2::exaskred::shallowwater::flux<Shortcuts, NumberOfUnknowns>(
    Q,
    x,
    h,
    t,
    dt,
    normal,
    minimumWaterHeight,
    F
  );

  T slideFlux[NumberOfUnknowns];
  applications::exahype2::exaskred::landslide::flux<SlideLayer<Shortcuts>, NumberOfUnknowns>(
    Q,
    x,
    h,
    t,
    dt,
    normal,
    physics,
    getSlideGravity<Shortcuts>(Q, physics, minimumWaterHeight),
    slideFlux
  );
  F[Shortcuts::lsh]      = slideFlux[Shortcuts::lsh];
  F[Shortcuts::lshu]     = slideFlux[Shortcuts::lshu];
  F[Shortcuts::lshu + 1] = slideFlux[Shortcuts::lshu + 1];
}

template <class Shortcuts, typename T>
INLINE_METHOD GPU_CALLABLE_METHOD double
applications::exahype2::exaskred::coupled::maxEigenvalue(
  const T* const NOALIAS                                      Q,
  const tarch::la::Vector<DIMENSIONS, double>&                x,
  const tarch::la::Vector<DIMENSIONS, double>&                h,
  const double                                                t,
  const double                                                dt,
  const int                                                   normal,
  const applications::exahype2::exaskred::landslide::Physics& physics,
  const double                                                minimumWaterHeight,
  const double                                                sourceEigenvalueScaling
) {
  const double waterSpeed =
    static_cast<double>(applications::exahype2::exaskred::shallowwater::maxEigenvalue<Shortcuts>(
      Q,
      x,
      h,
      t,
      dt,
      normal,
      physics.gravity,
      minimumWaterHeight
    ));
  const double slideSpeed =
    applications::exahype2::exaskred::landslide::getEffectiveMaxEigenvalue<SlideLayer<Shortcuts>>(
      Q,
      x,
      h,
      t,
      dt,
      normal,
      physics,
      getSlideGravity<Shortcuts>(Q, physics, minimumWaterHeight),
      isSlideSubmerged<Shortcuts>(Q, minimumWaterHeight),
      sourceEigenvalueScaling
    );
  return std::fmax(waterSpeed, slideSpeed);
}

/**
 * Writes the hydrostatic products of both layers. The water layer reads the gradient of the terrain
 * plus the granular layer, so a moving slide lifts the water column. Under water, buoyancy reduces
 * the gravity of the granular layer.
 */
template <class Shortcuts, int NumberOfUnknowns, typename T>
INLINE_METHOD GPU_CALLABLE_METHOD void
applications::exahype2::exaskred::coupled::nonconservativeProduct(
  const T* const NOALIAS                                      Q,
  const T* const NOALIAS                                      deltaQ,
  const tarch::la::Vector<DIMENSIONS, double>&                x,
  const tarch::la::Vector<DIMENSIONS, double>&                h,
  const double                                                t,
  const double                                                dt,
  const int                                                   normal,
  const applications::exahype2::exaskred::landslide::Physics& physics,
  const double                                                minimumWaterHeight,
  T* const NOALIAS                                            BTimesDeltaQ
) {
  for (int i = 0; i < NumberOfUnknowns; i++) {
    BTimesDeltaQ[i] = T{};
  }

  if (
    std::isfinite(static_cast<double>(Q[Shortcuts::h])) and std::isfinite(static_cast<double>(deltaQ[Shortcuts::h]))
    and std::isfinite(static_cast<double>(deltaQ[Shortcuts::z]))
    and std::isfinite(static_cast<double>(deltaQ[Shortcuts::lsh]))
    and Q[Shortcuts::h] > static_cast<T>(minimumWaterHeight)
  ) {
    BTimesDeltaQ[Shortcuts::hu + normal] = static_cast<T>(physics.gravity) * Q[Shortcuts::h]
      * (deltaQ[Shortcuts::h] + deltaQ[Shortcuts::z] + deltaQ[Shortcuts::lsh]);
  }

  T slideProduct[NumberOfUnknowns];
  applications::exahype2::exaskred::landslide::nonconservativeProduct<SlideLayer<Shortcuts>, NumberOfUnknowns>(
    Q,
    deltaQ,
    x,
    h,
    t,
    dt,
    normal,
    physics,
    getSlideGravity<Shortcuts>(Q, physics, minimumWaterHeight),
    slideProduct
  );
  BTimesDeltaQ[Shortcuts::lshu + normal] = slideProduct[Shortcuts::lshu + normal];
}

template <class Shortcuts, int NumberOfUnknowns, int NumberOfAuxiliaryVariables, typename T>
INLINE_METHOD GPU_CALLABLE_METHOD void
applications::exahype2::exaskred::coupled::diffusiveSourceTerm(
  const T* const NOALIAS                                      Q,
  const T* const NOALIAS                                      deltaQ,
  const tarch::la::Vector<DIMENSIONS, double>&                x,
  const tarch::la::Vector<DIMENSIONS, double>&                h,
  const double                                                t,
  const double                                                dt,
  const applications::exahype2::exaskred::landslide::Physics& physics,
  const double                                                minimumWaterHeight,
  T* const NOALIAS                                            S
) {
  applications::exahype2::exaskred::landslide::diffusiveSourceTerm<
    SlideLayer<Shortcuts>,
    NumberOfUnknowns,
    NumberOfAuxiliaryVariables
  >(Q,
    deltaQ,
    x,
    h,
    t,
    dt,
    physics,
    getSlideGravity<Shortcuts>(Q, physics, minimumWaterHeight),
    isSlideSubmerged<Shortcuts>(Q, minimumWaterHeight),
    S);
}

/**
 * Solves the nodal Riemann problems of one Galerkin face with the well-balanced Rusanov solver, one
 * layer at a time. The granular layer takes the submerged gravity where both sides are under water,
 * and the terrain gets no flux. Returns the larger maximum wave speed of the two layers.
 */
template <class Shortcuts, int NumberOfUnknowns, int NumberOfAuxiliaryVariables, int Order, typename T>
INLINE_METHOD GPU_CALLABLE_METHOD double
applications::exahype2::exaskred::coupled::solveRiemannProblem(
  const T* const NOALIAS                                      QL,
  const T* const NOALIAS                                      QR,
  const tarch::la::Vector<DIMENSIONS, double>&                x,
  const tarch::la::Vector<DIMENSIONS, double>&                h,
  const double                                                t,
  const double                                                dt,
  const int                                                   normal,
  const applications::exahype2::exaskred::landslide::Physics& physics,
  const double                                                minimumWaterHeight,
  T* const NOALIAS                                            FL,
  T* const NOALIAS                                            FR
) {
  constexpr int NumberOfFaceNodes = Order + 1;
  constexpr int NumberOfData      = NumberOfUnknowns + NumberOfAuxiliaryVariables;
  constexpr int LayerUnknowns     = 3;

  T waterViewL[NumberOfFaceNodes * WaterView::Size];
  T waterViewR[NumberOfFaceNodes * WaterView::Size];
  T slideViewL[NumberOfFaceNodes * SlideView::Size];
  T slideViewR[NumberOfFaceNodes * SlideView::Size];
  T waterFluxL[NumberOfFaceNodes * LayerUnknowns];
  T waterFluxR[NumberOfFaceNodes * LayerUnknowns];
  T slideFluxL[NumberOfFaceNodes * LayerUnknowns];
  T slideFluxR[NumberOfFaceNodes * LayerUnknowns];

  for (int node = 0; node < NumberOfFaceNodes; node++) {
    T sanitisedL[NumberOfData];
    T sanitisedR[NumberOfData];
    sanitiseDryLayers<Shortcuts, NumberOfUnknowns, NumberOfAuxiliaryVariables>(
      QL + node * NumberOfData,
      sanitisedL,
      physics,
      minimumWaterHeight
    );
    sanitiseDryLayers<Shortcuts, NumberOfUnknowns, NumberOfAuxiliaryVariables>(
      QR + node * NumberOfData,
      sanitisedR,
      physics,
      minimumWaterHeight
    );
    gatherWaterView<Shortcuts>(sanitisedL, waterViewL + node * WaterView::Size);
    gatherWaterView<Shortcuts>(sanitisedR, waterViewR + node * WaterView::Size);
    gatherSlideView<Shortcuts>(sanitisedL, slideViewL + node * SlideView::Size);
    gatherSlideView<Shortcuts>(sanitisedR, slideViewR + node * SlideView::Size);

    const T* const nodeFL = FL + node * NumberOfUnknowns;
    const T* const nodeFR = FR + node * NumberOfUnknowns;
    for (int component = 0; component < LayerUnknowns; component++) {
      waterFluxL[node * LayerUnknowns + component] = nodeFL[Shortcuts::h + component];
      waterFluxR[node * LayerUnknowns + component] = nodeFR[Shortcuts::h + component];
      slideFluxL[node * LayerUnknowns + component] = nodeFL[Shortcuts::lsh + component];
      slideFluxR[node * LayerUnknowns + component] = nodeFR[Shortcuts::lsh + component];
    }
  }

  const auto waterEigenvalue = [minimumWaterHeight, &physics](
                                 const T* const NOALIAS                       Q,
                                 const tarch::la::Vector<DIMENSIONS, double>& facePosition,
                                 const tarch::la::Vector<DIMENSIONS, double>& faceSize,
                                 const double                                 time,
                                 const double                                 timeStepSize,
                                 const int                                    direction
                               ) {
    return applications::exahype2::exaskred::shallowwater::maxEigenvalue<WaterView>(
      Q,
      facePosition,
      faceSize,
      time,
      timeStepSize,
      direction,
      physics.gravity,
      minimumWaterHeight
    );
  };
  const auto waterGravity =
    [&physics]([[maybe_unused]] const T* const NOALIAS QLeft, [[maybe_unused]] const T* const NOALIAS QRight) {
      return physics.gravity;
    };
  const double waterWaveSpeed = applications::exahype2::exaskred::riemann::wellBalancedRusanov<
    WaterView,
    WaterView::b,
    LayerUnknowns,
    WaterView::Size - LayerUnknowns,
    Order
  >(waterViewL, waterViewR, x, h, t, dt, normal, waterEigenvalue, waterGravity, waterFluxL, waterFluxR);

  const auto slideEigenvalue = [minimumWaterHeight, &physics](
                                 const T* const NOALIAS                       Q,
                                 const tarch::la::Vector<DIMENSIONS, double>& facePosition,
                                 const tarch::la::Vector<DIMENSIONS, double>& faceSize,
                                 const double                                 time,
                                 const double                                 timeStepSize,
                                 const int                                    direction
                               ) {
    const double gravity = Q[SlideView::WaterDepth] > static_cast<T>(minimumWaterHeight)
      ? applications::exahype2::exaskred::landslide::getSubmergedGravity(physics)
      : physics.gravity;
    return applications::exahype2::exaskred::landslide::getFluxEigenvalue<SlideView>(
      Q,
      facePosition,
      faceSize,
      time,
      timeStepSize,
      direction,
      physics,
      gravity
    );
  };
  const auto slideGravityAtFace = [minimumWaterHeight,
                                   &physics](const T* const NOALIAS QLeft, const T* const NOALIAS QRight) {
    const bool bothSubmerged = QLeft[SlideView::WaterDepth] > static_cast<T>(minimumWaterHeight)
      and QRight[SlideView::WaterDepth] > static_cast<T>(minimumWaterHeight);
    return bothSubmerged ? applications::exahype2::exaskred::landslide::getSubmergedGravity(physics) : physics.gravity;
  };
  const double slideWaveSpeed = applications::exahype2::exaskred::riemann::wellBalancedRusanov<
    SlideView,
    SlideView::z,
    LayerUnknowns,
    SlideView::Size - LayerUnknowns,
    Order
  >(slideViewL, slideViewR, x, h, t, dt, normal, slideEigenvalue, slideGravityAtFace, slideFluxL, slideFluxR);

  for (int node = 0; node < NumberOfFaceNodes; node++) {
    T* const nodeFL = FL + node * NumberOfUnknowns;
    T* const nodeFR = FR + node * NumberOfUnknowns;
    for (int component = 0; component < LayerUnknowns; component++) {
      nodeFL[Shortcuts::h + component]   = waterFluxL[node * LayerUnknowns + component];
      nodeFR[Shortcuts::h + component]   = waterFluxR[node * LayerUnknowns + component];
      nodeFL[Shortcuts::lsh + component] = slideFluxL[node * LayerUnknowns + component];
      nodeFR[Shortcuts::lsh + component] = slideFluxR[node * LayerUnknowns + component];
    }
    nodeFL[Shortcuts::z] = T{};
    nodeFR[Shortcuts::z] = T{};
  }
  return std::fmax(waterWaveSpeed, slideWaveSpeed);
}

/**
 * Solves one subcell face with the augmented-state solver, one layer at a time like
 * solveRiemannProblem().
 */
template <class Shortcuts, int NumberOfUnknowns, int NumberOfAuxiliaryVariables, typename T>
INLINE_METHOD GPU_CALLABLE_METHOD double
applications::exahype2::exaskred::coupled::solveSubcellRiemannProblem(
  const T* const NOALIAS                                      QL,
  const T* const NOALIAS                                      QR,
  const tarch::la::Vector<DIMENSIONS, double>&                x,
  const tarch::la::Vector<DIMENSIONS, double>&                h,
  const double                                                t,
  const double                                                dt,
  const int                                                   normal,
  const applications::exahype2::exaskred::landslide::Physics& physics,
  const double                                                minimumWaterHeight,
  T* const NOALIAS                                            FL,
  T* const NOALIAS                                            FR
) {
  constexpr int NumberOfData  = NumberOfUnknowns + NumberOfAuxiliaryVariables;
  constexpr int LayerUnknowns = 3;

  T sanitisedL[NumberOfData];
  T sanitisedR[NumberOfData];
  sanitiseDryLayers<Shortcuts, NumberOfUnknowns, NumberOfAuxiliaryVariables>(
    QL,
    sanitisedL,
    physics,
    minimumWaterHeight
  );
  sanitiseDryLayers<Shortcuts, NumberOfUnknowns, NumberOfAuxiliaryVariables>(
    QR,
    sanitisedR,
    physics,
    minimumWaterHeight
  );

  T waterViewL[WaterView::Size];
  T waterViewR[WaterView::Size];
  T slideViewL[SlideView::Size];
  T slideViewR[SlideView::Size];
  gatherWaterView<Shortcuts>(sanitisedL, waterViewL);
  gatherWaterView<Shortcuts>(sanitisedR, waterViewR);
  gatherSlideView<Shortcuts>(sanitisedL, slideViewL);
  gatherSlideView<Shortcuts>(sanitisedR, slideViewR);

  T waterFluxL[LayerUnknowns];
  T waterFluxR[LayerUnknowns];
  T slideFluxL[LayerUnknowns];
  T slideFluxR[LayerUnknowns];

  const auto waterWaveSpeed = applications::exahype2::exaskred::riemann::augmentedState<WaterView, WaterView::b, false>(
    waterViewL,
    waterViewR,
    x,
    h,
    t,
    dt,
    normal,
    physics.gravity,
    minimumWaterHeight,
    waterFluxL,
    waterFluxR
  );

  const bool bothSubmerged = slideViewL[SlideView::WaterDepth] > static_cast<T>(minimumWaterHeight)
    and slideViewR[SlideView::WaterDepth] > static_cast<T>(minimumWaterHeight);
  const double faceSlideGravity =
    bothSubmerged ? applications::exahype2::exaskred::landslide::getSubmergedGravity(physics) : physics.gravity;
  const auto slideWaveSpeed = applications::exahype2::exaskred::riemann::augmentedState<SlideView, SlideView::z, false>(
    slideViewL,
    slideViewR,
    x,
    h,
    t,
    dt,
    normal,
    faceSlideGravity,
    physics.dryHeightThreshold,
    slideFluxL,
    slideFluxR
  );

  for (int component = 0; component < LayerUnknowns; component++) {
    FL[Shortcuts::h + component]   = waterFluxL[component];
    FR[Shortcuts::h + component]   = waterFluxR[component];
    FL[Shortcuts::lsh + component] = slideFluxL[component];
    FR[Shortcuts::lsh + component] = slideFluxR[component];
  }
  FL[Shortcuts::z] = T{};
  FR[Shortcuts::z] = T{};

  return std::fmax(static_cast<double>(waterWaveSpeed), static_cast<double>(slideWaveSpeed));
}
