#include "tarch/Assertions.h"

/**
 * Copies a state and zeroes the depth and momenta of a layer that is dry or not finite. The
 * bathymetry keeps its value.
 */
template <typename State>
INLINE_METHOD GPU_CALLABLE_METHOD void
applications::exahype2::exaskred::landslide::sanitiseDryState(
  const State&                                                QIn,
  State&                                                      QOut,
  const applications::exahype2::exaskred::landslide::Physics& physics
) {
  using Value = decltype(State::h);
  QOut        = QIn;
  if (not std::isfinite(static_cast<double>(QIn.h)) or QIn.h <= static_cast<Value>(physics.dryHeightThreshold)) {
    QOut.h  = Value{};
    QOut.hu = Value{};
  }
}

/**
 * Returns the buoyancy-reduced gravity of a fully submerged slide.
 */
INLINE_METHOD GPU_CALLABLE_METHOD double
applications::exahype2::exaskred::landslide::getSubmergedGravity(
  const applications::exahype2::exaskred::landslide::Physics& physics
) {
  const double densityRatio   = physics.waterDensity / physics.slideDensity;
  const double buoyancyFactor = std::fmax(0.0, 1.0 - densityRatio);
  return physics.gravity * buoyancyFactor;
}

template <typename State>
INLINE_METHOD GPU_CALLABLE_METHOD bool
applications::exahype2::exaskred::landslide::isSubmergedByBathymetry(
  const State&                                                Q,
  const applications::exahype2::exaskred::landslide::Physics& physics
) {
  using Value = decltype(State::z);
  return std::isfinite(static_cast<double>(Q.z)) and Q.z < static_cast<Value>(physics.waterLevel);
}

template <typename State>
INLINE_METHOD GPU_CALLABLE_METHOD double
applications::exahype2::exaskred::landslide::getEffectiveGravity(
  const State&                                                Q,
  const applications::exahype2::exaskred::landslide::Physics& physics
) {
  return isSubmergedByBathymetry(Q, physics) ? getSubmergedGravity(physics) : physics.gravity;
}

/**
 * Returns the submerged gravity if the states on both sides of a face are submerged. Returns the full
 * gravity otherwise.
 */
template <typename State>
INLINE_METHOD GPU_CALLABLE_METHOD double
applications::exahype2::exaskred::landslide::getInterfaceEffectiveGravity(
  const State&                                                QL,
  const State&                                                QR,
  const applications::exahype2::exaskred::landslide::Physics& physics
) {
  return isSubmergedByBathymetry(QL, physics) and isSubmergedByBathymetry(QR, physics) ? getSubmergedGravity(physics)
                                                                                       : physics.gravity;
}

/**
 * Returns the stiffness rate of the free-surface friction drag of Kim et al. (2019). The rate
 * bounds the admissible time step of a submerged, moving state.
 */
template <typename State>
INLINE_METHOD GPU_CALLABLE_METHOD double
applications::exahype2::exaskred::landslide::getWaterFrictionDragSourceSpeed(
  const State&                                                Q,
  const applications::exahype2::exaskred::landslide::Physics& physics,
  const bool                                                  submerged
) {
  using Value = decltype(State::h);
  if (
    not submerged or not std::isfinite(static_cast<double>(Q.h)) or not std::isfinite(static_cast<double>(Q.hu(0)))
    or not std::isfinite(static_cast<double>(Q.hu(1))) or Q.h <= static_cast<Value>(physics.dryHeightThreshold)
    or physics.slideDensity <= 0.0 or physics.waterFrictionDragCoefficient <= 0.0
  ) {
    return 0.0;
  }

  const double momentum = std::sqrt(static_cast<double>(Q.hu(0) * Q.hu(0) + Q.hu(1) * Q.hu(1)));
  return physics.waterFrictionDragCoefficient * physics.waterDensity * momentum
    / (physics.slideDensity * static_cast<double>(Q.h * Q.h));
}

template <typename State>
INLINE_METHOD GPU_CALLABLE_METHOD double
applications::exahype2::exaskred::landslide::getWaterFrictionDragSourceSpeed(
  const State&                                                Q,
  const applications::exahype2::exaskred::landslide::Physics& physics
) {
  return getWaterFrictionDragSourceSpeed(Q, physics, isSubmergedByBathymetry(Q, physics));
}

/**
 * Writes the advective and pressure fluxes of the granular layer for the given gravity.
 */
template <typename State, typename Flux>
INLINE_METHOD GPU_CALLABLE_METHOD void
applications::exahype2::exaskred::landslide::flux(
  const State&                                                  Q,
  [[maybe_unused]] const tarch::la::Vector<DIMENSIONS, double>& x,
  [[maybe_unused]] const tarch::la::Vector<DIMENSIONS, double>& h,
  [[maybe_unused]] const double                                 t,
  [[maybe_unused]] const double                                 dt,
  const int                                                     normal,
  const applications::exahype2::exaskred::landslide::Physics&   physics,
  const double                                                  gravity,
  Flux&                                                         F
) {
  using Value = decltype(State::h);
  ASSERTION(normal >= 0 and normal < DIMENSIONS, normal);

  F = {};
  if (
    not std::isfinite(static_cast<double>(Q.h)) or not std::isfinite(static_cast<double>(Q.hu(0)))
    or not std::isfinite(static_cast<double>(Q.hu(1))) or Q.h <= static_cast<Value>(physics.dryHeightThreshold)
  ) {
    return;
  }

  const Value slideHeight    = Q.h;
  const Value normalVelocity = Q.hu(normal) / slideHeight;

  F.h     = Q.hu(normal);
  F.hu(0) = normalVelocity * Q.hu(0);
  F.hu(1) = normalVelocity * Q.hu(1);
  F.hu(normal) += static_cast<Value>(0.5) * static_cast<Value>(gravity) * slideHeight * slideHeight;
}

template <typename State, typename Flux>
INLINE_METHOD GPU_CALLABLE_METHOD void
applications::exahype2::exaskred::landslide::flux(
  const State&                                                Q,
  const tarch::la::Vector<DIMENSIONS, double>&                x,
  const tarch::la::Vector<DIMENSIONS, double>&                h,
  const double                                                t,
  const double                                                dt,
  const int                                                   normal,
  const applications::exahype2::exaskred::landslide::Physics& physics,
  Flux&                                                       F
) {
  flux(Q, x, h, t, dt, normal, physics, getEffectiveGravity(Q, physics), F);
}

template <typename State>
INLINE_METHOD GPU_CALLABLE_METHOD double
applications::exahype2::exaskred::landslide::getFluxEigenvalue(
  const State&                                                  Q,
  [[maybe_unused]] const tarch::la::Vector<DIMENSIONS, double>& x,
  [[maybe_unused]] const tarch::la::Vector<DIMENSIONS, double>& h,
  [[maybe_unused]] const double                                 t,
  [[maybe_unused]] const double                                 dt,
  const int                                                     normal,
  const applications::exahype2::exaskred::landslide::Physics&   physics,
  const double                                                  gravity
) {
  using Value = decltype(State::h);
  ASSERTION(normal >= 0 and normal < DIMENSIONS, normal);

  if (
    not std::isfinite(static_cast<double>(Q.h)) or not std::isfinite(static_cast<double>(Q.hu(0)))
    or not std::isfinite(static_cast<double>(Q.hu(1))) or Q.h <= static_cast<Value>(physics.dryHeightThreshold)
  ) {
    return 0.0;
  }

  const double normalVelocity = static_cast<double>(Q.hu(normal) / Q.h);
  const double waveSpeed      = std::sqrt(gravity * static_cast<double>(Q.h));
  return std::fmax(std::abs(normalVelocity + waveSpeed), std::abs(normalVelocity - waveSpeed));
}

template <typename State>
INLINE_METHOD GPU_CALLABLE_METHOD double
applications::exahype2::exaskred::landslide::getFluxEigenvalue(
  const State&                                                Q,
  const tarch::la::Vector<DIMENSIONS, double>&                x,
  const tarch::la::Vector<DIMENSIONS, double>&                h,
  const double                                                t,
  const double                                                dt,
  const int                                                   normal,
  const applications::exahype2::exaskred::landslide::Physics& physics
) {
  return getFluxEigenvalue(Q, x, h, t, dt, normal, physics, getEffectiveGravity(Q, physics));
}

/**
 * Returns the larger of the flux eigenvalue and the friction stiffness times the cell size. The
 * Voellmy-Salm drag stiffens as the layer thins. The flux eigenvalue alone can then allow an
 * unstable friction update.
 */
template <typename State>
INLINE_METHOD GPU_CALLABLE_METHOD double
applications::exahype2::exaskred::landslide::getEffectiveMaxEigenvalue(
  const State&                                                Q,
  const tarch::la::Vector<DIMENSIONS, double>&                x,
  const tarch::la::Vector<DIMENSIONS, double>&                h,
  const double                                                t,
  const double                                                dt,
  const int                                                   normal,
  const applications::exahype2::exaskred::landslide::Physics& physics,
  const double                                                gravity,
  const bool                                                  submerged,
  const double                                                sourceEigenvalueScaling
) {
  using Value            = decltype(State::h);
  const double fluxSpeed = getFluxEigenvalue(Q, x, h, t, dt, normal, physics, gravity);

  if (
    not std::isfinite(static_cast<double>(Q.h)) or not std::isfinite(static_cast<double>(Q.hu(0)))
    or not std::isfinite(static_cast<double>(Q.hu(1))) or Q.h <= static_cast<Value>(physics.dryHeightThreshold)
  ) {
    return fluxSpeed;
  }

  const double momentum = std::sqrt(static_cast<double>(Q.hu(0) * Q.hu(0) + Q.hu(1) * Q.hu(1)));
  const double sourceSpeed =
    2.0 * gravity * momentum * physics.inverseTurbulentFrictionLength / static_cast<double>(Q.h * Q.h)
    + getWaterFrictionDragSourceSpeed(Q, physics, submerged);

  return std::fmax(fluxSpeed, h[normal] * sourceEigenvalueScaling * sourceSpeed);
}

template <typename State>
INLINE_METHOD GPU_CALLABLE_METHOD double
applications::exahype2::exaskred::landslide::getEffectiveMaxEigenvalue(
  const State&                                                Q,
  const tarch::la::Vector<DIMENSIONS, double>&                x,
  const tarch::la::Vector<DIMENSIONS, double>&                h,
  const double                                                t,
  const double                                                dt,
  const int                                                   normal,
  const applications::exahype2::exaskred::landslide::Physics& physics,
  const double                                                sourceEigenvalueScaling
) {
  return getEffectiveMaxEigenvalue(
    Q,
    x,
    h,
    t,
    dt,
    normal,
    physics,
    getEffectiveGravity(Q, physics),
    isSubmergedByBathymetry(Q, physics),
    sourceEigenvalueScaling
  );
}

/**
 * Writes the bathymetry-slope pressure term of the granular layer.
 */
template <typename State, typename Difference, typename NonconservativeProduct>
INLINE_METHOD GPU_CALLABLE_METHOD void
applications::exahype2::exaskred::landslide::nonconservativeProduct(
  const State&                                                  Q,
  const Difference&                                             deltaQ,
  [[maybe_unused]] const tarch::la::Vector<DIMENSIONS, double>& x,
  [[maybe_unused]] const tarch::la::Vector<DIMENSIONS, double>& h,
  [[maybe_unused]] const double                                 t,
  [[maybe_unused]] const double                                 dt,
  const int                                                     normal,
  const applications::exahype2::exaskred::landslide::Physics&   physics,
  const double                                                  gravity,
  NonconservativeProduct&                                       BTimesDeltaQ
) {
  using Value = decltype(State::h);
  ASSERTION(normal >= 0 and normal < DIMENSIONS, normal);

  BTimesDeltaQ = {};
  if (
    not std::isfinite(static_cast<double>(Q.h)) or not std::isfinite(static_cast<double>(deltaQ.z))
    or Q.h <= static_cast<Value>(physics.dryHeightThreshold)
  ) {
    return;
  }

  BTimesDeltaQ.hu(normal) = static_cast<Value>(gravity) * Q.h * deltaQ.z;
}

template <typename State, typename Difference, typename NonconservativeProduct>
INLINE_METHOD GPU_CALLABLE_METHOD void
applications::exahype2::exaskred::landslide::nonconservativeProduct(
  const State&                                                Q,
  const Difference&                                           deltaQ,
  const tarch::la::Vector<DIMENSIONS, double>&                x,
  const tarch::la::Vector<DIMENSIONS, double>&                h,
  const double                                                t,
  const double                                                dt,
  const int                                                   normal,
  const applications::exahype2::exaskred::landslide::Physics& physics,
  NonconservativeProduct&                                     BTimesDeltaQ
) {
  nonconservativeProduct(Q, deltaQ, x, h, t, dt, normal, physics, getEffectiveGravity(Q, physics), BTimesDeltaQ);
}

/**
 * Writes the Voellmy-Salm friction and, under water, the friction and pressure drag of Kim et al.
 * (2019) as a source. The resistance never exceeds the momentum divided by dt. One time step then
 * cannot reverse the momentum.
 */
template <typename State, typename Gradient, typename Source>
INLINE_METHOD GPU_CALLABLE_METHOD void
applications::exahype2::exaskred::landslide::diffusiveSourceTerm(
  const State&                                                  Q,
  const Gradient&                                               deltaQ,
  [[maybe_unused]] const tarch::la::Vector<DIMENSIONS, double>& x,
  [[maybe_unused]] const tarch::la::Vector<DIMENSIONS, double>& h,
  [[maybe_unused]] const double                                 t,
  const double                                                  dt,
  const applications::exahype2::exaskred::landslide::Physics&   physics,
  const double                                                  gravity,
  const bool                                                    submerged,
  Source&                                                       S
) {
  using Value = decltype(State::h);

  S = {};
  if (
    not std::isfinite(static_cast<double>(Q.h)) or not std::isfinite(static_cast<double>(Q.hu(0)))
    or not std::isfinite(static_cast<double>(Q.hu(1))) or Q.h <= static_cast<Value>(physics.dryHeightThreshold)
  ) {
    return;
  }

  const Value dhx         = deltaQ[0].h;
  const Value dhy         = deltaQ[1].h;
  const Value dzx         = deltaQ[0].z;
  const Value dzy         = deltaQ[1].z;
  const Value slopeFactor = static_cast<Value>(1.0) / std::sqrt(static_cast<Value>(1.0) + dzx * dzx + dzy * dzy);

  const Value momentumSquared = Q.hu(0) * Q.hu(0) + Q.hu(1) * Q.hu(1);
  const Value momentum        = std::sqrt(momentumSquared);
  if (momentum > Value{}) {
    const Value friction = static_cast<Value>(physics.coulombFriction) * slopeFactor * Q.h
      + momentumSquared * static_cast<Value>(physics.inverseTurbulentFrictionLength) / (Q.h * Q.h);

    Value resistanceMagnitude = static_cast<Value>(gravity) * friction;
    if (
      submerged and physics.slideDensity > 0.0
      and (physics.waterFrictionDragCoefficient > 0.0 or physics.waterPressureDragCoefficient > 0.0)
    ) {
      const Value densityRatio      = static_cast<Value>(physics.waterDensity / physics.slideDensity);
      const Value invSlideHeight    = static_cast<Value>(1.0) / Q.h;
      const Value velocity0         = Q.hu(0) * invSlideHeight;
      const Value velocity1         = Q.hu(1) * invSlideHeight;
      const Value velocityMagnitude = momentum * invSlideHeight;

      Value waterDragMagnitude = static_cast<Value>(0.5) * static_cast<Value>(physics.waterFrictionDragCoefficient)
        * densityRatio * velocityMagnitude * velocityMagnitude;

      const Value pressureExposure = -(velocity0 * dhx + velocity1 * dhy);
      if (std::isfinite(static_cast<double>(pressureExposure)) and pressureExposure > Value{}) {
        waterDragMagnitude += static_cast<Value>(0.5) * static_cast<Value>(physics.waterPressureDragCoefficient)
          * densityRatio * pressureExposure * velocityMagnitude;
      }

      resistanceMagnitude += waterDragMagnitude;
    }

    const Value cappedResistanceMagnitude = std::isfinite(dt) and dt > 0.0
      ? std::min(resistanceMagnitude, momentum / static_cast<Value>(dt))
      : resistanceMagnitude;
    const Value frictionTerm              = -cappedResistanceMagnitude / momentum;
    S.hu(0)                               = Q.hu(0) * frictionTerm;
    S.hu(1)                               = Q.hu(1) * frictionTerm;
  }
}

template <typename State, typename Gradient, typename Source>
INLINE_METHOD GPU_CALLABLE_METHOD void
applications::exahype2::exaskred::landslide::diffusiveSourceTerm(
  const State&                                                Q,
  const Gradient&                                             deltaQ,
  const tarch::la::Vector<DIMENSIONS, double>&                x,
  const tarch::la::Vector<DIMENSIONS, double>&                h,
  const double                                                t,
  const double                                                dt,
  const applications::exahype2::exaskred::landslide::Physics& physics,
  Source&                                                     S
) {
  diffusiveSourceTerm(
    Q,
    deltaQ,
    x,
    h,
    t,
    dt,
    physics,
    getEffectiveGravity(Q, physics),
    isSubmergedByBathymetry(Q, physics),
    S
  );
}
