#include "tarch/Assertions.h"

template <typename T>
INLINE_METHOD GPU_CALLABLE_METHOD T
applications::exahype2::exaskred::shallowwater::regularisedVelocity(
  const T      waterHeight,
  const T      momentum,
  const double minimumWaterHeight
) {
  if (not std::isfinite(waterHeight) or not std::isfinite(momentum) or waterHeight <= T{}) {
    return T{};
  }

  const auto regularisedHeight        = std::fmax(waterHeight, static_cast<T>(minimumWaterHeight));
  const auto waterHeightSquared       = waterHeight * waterHeight;
  const auto regularisedHeightSquared = regularisedHeight * regularisedHeight;
  const auto denominator =
    std::sqrt(waterHeightSquared * waterHeightSquared + regularisedHeightSquared * regularisedHeightSquared);
  return std::isfinite(denominator) and denominator > T{}
    ? momentum * waterHeight * std::sqrt(static_cast<T>(2.0)) / denominator
    : T{};
}

template <typename State, typename Flux>
INLINE_METHOD GPU_CALLABLE_METHOD void
applications::exahype2::exaskred::shallowwater::flux(
  const State&                                                  Q,
  [[maybe_unused]] const tarch::la::Vector<DIMENSIONS, double>& x,
  [[maybe_unused]] const tarch::la::Vector<DIMENSIONS, double>& h,
  [[maybe_unused]] const double                                 t,
  [[maybe_unused]] const double                                 dt,
  const int                                                     normal,
  const double                                                  minimumWaterHeight,
  Flux&                                                         F
) {
  using Value = decltype(Q.h);
  ASSERTION(normal >= 0 and normal < DIMENSIONS, normal);

  F = {};
  if (not std::isfinite(Q.h) or Q.h <= static_cast<Value>(minimumWaterHeight)) {
    return;
  }
  for (int dimension = 0; dimension < DIMENSIONS; dimension++) {
    if (not std::isfinite(Q.hu(dimension))) {
      return;
    }
  }

  const auto normalVelocity =
    applications::exahype2::exaskred::shallowwater::regularisedVelocity(Q.h, Q.hu(normal), minimumWaterHeight);
  F.h = Q.hu(normal);
  for (int dimension = 0; dimension < DIMENSIONS; dimension++) {
    F.hu(dimension) = normalVelocity * Q.hu(dimension);
  }
}

template <typename State>
INLINE_METHOD GPU_CALLABLE_METHOD double
applications::exahype2::exaskred::shallowwater::maxEigenvalue(
  const State&                                                  Q,
  [[maybe_unused]] const tarch::la::Vector<DIMENSIONS, double>& x,
  [[maybe_unused]] const tarch::la::Vector<DIMENSIONS, double>& h,
  [[maybe_unused]] const double                                 t,
  [[maybe_unused]] const double                                 dt,
  const int                                                     normal,
  const double                                                  gravity,
  const double                                                  minimumWaterHeight
) {
  using Value = decltype(Q.h);
  ASSERTION(normal >= 0 and normal < DIMENSIONS, normal);

  if (not std::isfinite(Q.h) or not std::isfinite(Q.hu(normal)) or Q.h <= static_cast<Value>(minimumWaterHeight)) {
    return 0.0;
  }

  const auto normalVelocity =
    applications::exahype2::exaskred::shallowwater::regularisedVelocity(Q.h, Q.hu(normal), minimumWaterHeight);
  const auto waveSpeed = std::sqrt(static_cast<Value>(gravity) * Q.h);
  return std::fmax(std::fabs(normalVelocity + waveSpeed), std::fabs(normalVelocity - waveSpeed));
}

template <typename State, typename Difference, typename NonconservativeProduct>
INLINE_METHOD GPU_CALLABLE_METHOD void
applications::exahype2::exaskred::shallowwater::nonconservativeProduct(
  const State&                                                  Q,
  const Difference&                                             deltaQ,
  [[maybe_unused]] const tarch::la::Vector<DIMENSIONS, double>& x,
  [[maybe_unused]] const tarch::la::Vector<DIMENSIONS, double>& h,
  [[maybe_unused]] const double                                 t,
  [[maybe_unused]] const double                                 dt,
  const int                                                     normal,
  const double                                                  gravity,
  const double                                                  minimumWaterHeight,
  NonconservativeProduct&                                       BTimesDeltaQ
) {
  using Value = decltype(Q.h);
  ASSERTION(normal >= 0 and normal < DIMENSIONS, normal);

  BTimesDeltaQ = {};
  if (
    not std::isfinite(Q.h) or not std::isfinite(deltaQ.h) or not std::isfinite(deltaQ.b)
    or Q.h <= static_cast<Value>(minimumWaterHeight)
  ) {
    return;
  }

  BTimesDeltaQ.hu(normal) = static_cast<Value>(gravity) * Q.h * (deltaQ.h + deltaQ.b);
}
