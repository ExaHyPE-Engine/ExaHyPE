template <class Shortcuts, int NumberOfUnknowns, class T>
static inline GPU_CALLABLE_METHOD void applications::exahype2::exaskred::meteotsunami::nonconservativeProduct(
  const T* const NOALIAS                       Q,
  const T* const NOALIAS                       deltaQ,
  const tarch::la::Vector<DIMENSIONS, double>& x,
  const tarch::la::Vector<DIMENSIONS, double>& h,
  const double                                 t,
  const double                                 dt,
  const int                                    normal,
  T* const NOALIAS                             BTimesDeltaQ
) {
  (void)x;
  (void)h;
  (void)t;
  (void)dt;

  for (int i = 0; i < NumberOfUnknowns; ++i) {
    BTimesDeltaQ[i] = 0.0;
  }

  if (Q[Shortcuts::h] <= hThreshold) {
    return;
  }

  BTimesDeltaQ[Shortcuts::hu + normal] = g * Q[Shortcuts::h] * (deltaQ[Shortcuts::h] + deltaQ[Shortcuts::b]);
}
