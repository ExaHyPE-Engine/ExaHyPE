TARGET_DECLARE
INLINE_METHOD void
applications::exahype2::exaskred::ADERDGSolver::initialCondition(
  State&                              Q,
  const Coordinates&                  x,
  [[maybe_unused]] const Coordinates& h,
  const RuntimeParameters&            parameters
) {
  static const tarch::reader::NetCDFFieldSampler<2> bathymetrySampler(
    {{"bathymetry", std::string(parameters.bathymetryFile), "Band1"}}
  );

  const auto& offset = parameters.bathymetryOffset;
  const auto& size   = parameters.bathymetrySize;
  Coordinates rasterPosition;
  for (int dimension = 0; dimension < DIMENSIONS; dimension++) {
    rasterPosition(dimension) = std::clamp(x(dimension), offset(dimension), offset(dimension) + size(dimension));
  }
  const double sampled = bathymetrySampler.sampleBilinear("bathymetry", rasterPosition);

  // The raster marks unsurveyed cells with a fill value below any real sea floor. These cells
  // become open ocean of the reference depth.
  const double referenceDepth = parameters.referenceOceanDepth;
  const bool   surveyed       = std::isfinite(sampled) and sampled >= -parameters.deepestSeaFloor;
  const double bathymetry     = surveyed ? sampled : -referenceDepth;

  Q.h  = -std::min(bathymetry, 0.0);
  Q.hu = 0.0;
  Q.b  = bathymetry;
}

INLINE_METHOD GPU_CALLABLE_METHOD void
applications::exahype2::exaskred::ADERDGSolver::boundaryConditions(
  const State&                              Qinside,
  State&                                    Qoutside,
  [[maybe_unused]] const Coordinates&       x,
  [[maybe_unused]] const Coordinates&       h,
  [[maybe_unused]] const double             t,
  [[maybe_unused]] const int                normal,
  [[maybe_unused]] const RuntimeParameters& parameters
) {
  Qoutside.h  = Qinside.h;
  Qoutside.hu = 0.0;
  Qoutside.b  = Qinside.b;
}

INLINE_METHOD GPU_CALLABLE_METHOD ::exahype2::RefinementCommand
applications::exahype2::exaskred::ADERDGSolver::refinementCriterion(
  [[maybe_unused]] const CellStates*        Q,
  [[maybe_unused]] const Coordinates&       x,
  [[maybe_unused]] const Coordinates&       h,
  [[maybe_unused]] const double             t,
  [[maybe_unused]] const RuntimeParameters& parameters
) {
  return ::exahype2::RefinementCommand::Keep;
}

INLINE_METHOD GPU_CALLABLE_METHOD void
applications::exahype2::exaskred::ADERDGSolver::flux(
  const State&             Q,
  const Coordinates&       x,
  const Coordinates&       h,
  const double             t,
  const double             dt,
  const int                normal,
  Flux&                    F,
  const RuntimeParameters& parameters
) {
  applications::exahype2::exaskred::shallowwater::flux(Q, x, h, t, dt, normal, parameters.minimumWaterHeight, F);
}

INLINE_METHOD GPU_CALLABLE_METHOD double
applications::exahype2::exaskred::ADERDGSolver::maxEigenvalue(
  const State&             Q,
  const Coordinates&       x,
  const Coordinates&       h,
  const double             t,
  const double             dt,
  const int                normal,
  const RuntimeParameters& parameters
) {
  return applications::exahype2::exaskred::shallowwater::maxEigenvalue(
    Q,
    x,
    h,
    t,
    dt,
    normal,
    g,
    parameters.minimumWaterHeight
  );
}

INLINE_METHOD GPU_CALLABLE_METHOD void
applications::exahype2::exaskred::ADERDGSolver::nonconservativeProduct(
  const State&             Q,
  const Difference&        deltaQ,
  const Coordinates&       x,
  const Coordinates&       h,
  const double             t,
  const double             dt,
  const int                normal,
  NonconservativeProduct&  BTimesDeltaQ,
  const RuntimeParameters& parameters
) {
  applications::exahype2::exaskred::shallowwater::nonconservativeProduct(
    Q,
    deltaQ,
    x,
    h,
    t,
    dt,
    normal,
    g,
    parameters.minimumWaterHeight,
    BTimesDeltaQ
  );
}

/**
 * Writes the rotation, the bed drag and the atmospheric pressure gradient into S.
 */
INLINE_METHOD GPU_CALLABLE_METHOD void
applications::exahype2::exaskred::ADERDGSolver::sourceTerm(
  const State&                        Q,
  const Coordinates&                  x,
  [[maybe_unused]] const Coordinates& h,
  const double                        t,
  [[maybe_unused]] const double       dt,
  Source&                             S,
  const RuntimeParameters&            parameters
) {
  S                               = {};
  const double minimumWaterHeight = parameters.minimumWaterHeight;
  if (not std::isfinite(Q.h) or Q.h <= minimumWaterHeight) {
    return;
  }

  // The raster uses this projection. Its inverse maps the mesh coordinates to geographic
  // coordinates.
  const applications::exahype2::exaskred::projection::AlbersEqualArea projection{
    .referenceLongitude     = parameters.projectionCentralMeridian,
    .referenceLatitude      = parameters.projectionOriginLatitude,
    .firstStandardParallel  = parameters.projectionFirstParallel,
    .secondStandardParallel = parameters.projectionSecondParallel,
    .semiMajorAxis          = parameters.projectionSemiMajorAxis,
    .eccentricity           = parameters.projectionEccentricity
  };

  const auto   here     = projection.inverse(x(0), x(1));
  const double coriolis = applications::exahype2::exaskred::forcing::getCoriolisParameterOnSphere(
    here.second,
    parameters.earthAngularVelocity
  );
  const double friction = applications::exahype2::exaskred::forcing::getManningFriction(
    Q.h,
    Q.hu(0),
    Q.hu(1),
    g,
    parameters.manningCoefficient,
    minimumWaterHeight
  );

  // The storm centre moves at a fixed speed along the straight line between the two projected
  // track points. The disturbance moves rigidly with it.
  const auto   trackStart = projection.forward(parameters.trackStartLongitude, parameters.trackStartLatitude);
  const auto   trackEnd   = projection.forward(parameters.trackEndLongitude, parameters.trackEndLatitude);
  const double runX       = trackEnd.first - trackStart.first;
  const double runY       = trackEnd.second - trackStart.second;
  const double length     = std::hypot(runX, runY);
  const double travelled  = length > 0.0 ? parameters.trackSpeed * t / length : 0.0;
  const auto   centre  = projection.inverse(trackStart.first + travelled * runX, trackStart.second + travelled * runY);
  const double bearing = std::atan2(runY, runX);

  // The anomaly is a Gaussian times the along-track offset in a frame that travels with the storm
  // and turns with its track. Both maps are linear in the geographic offsets. Only the inverse
  // Jacobian of the projection reads the shape of the earth.
  const double bearingSine     = std::sin(bearing);
  const double bearingCosine   = std::cos(bearing);
  const double convergence     = std::cos(centre.second * std::numbers::pi_v<double> / 180.0);
  const double longitudeOffset = std::remainder(here.first - centre.first, 360.0) * convergence;
  const double latitudeOffset  = here.second - centre.second;
  const double rotatedAlong    = longitudeOffset * bearingCosine + latitudeOffset * bearingSine;
  const double acrossTrack     = -longitudeOffset * bearingSine + latitudeOffset * bearingCosine;
  const double alongTrack      = std::abs(convergence) > 1e-12 ? rotatedAlong / convergence : 0.0;
  const double crossWidth      = parameters.pressureCrossTrackWidth;
  const double amplitude =
    alongTrack < 0.0 ? parameters.pressureLeadingAmplitude : parameters.pressureTrailingAmplitude;
  const double width            = alongTrack < 0.0 ? parameters.pressureLeadingWidth : parameters.pressureTrailingWidth;
  const double scaledAcross     = acrossTrack / crossWidth;
  const double scaledAlong      = alongTrack / width;
  const double envelope         = std::exp(-scaledAcross * scaledAcross - scaledAlong * scaledAlong);
  const double alongDerivative  = -amplitude * envelope * (1.0 - 2.0 * alongTrack * alongTrack / (width * width));
  const double acrossDerivative = amplitude * alongTrack * envelope * 2.0 * acrossTrack / (crossWidth * crossWidth);

  const double alongTrackByLongitude  = bearingCosine;
  const double alongTrackByLatitude   = std::abs(convergence) > 1e-12 ? bearingSine / convergence : 0.0;
  const double acrossTrackByLongitude = -convergence * bearingSine;
  const double acrossTrackByLatitude  = bearingCosine;
  const double byLongitude = alongDerivative * alongTrackByLongitude + acrossDerivative * acrossTrackByLongitude;
  const double byLatitude  = alongDerivative * alongTrackByLatitude + acrossDerivative * acrossTrackByLatitude;

  const auto        jacobian = projection.inverseJacobian(x(0), x(1));
  const Coordinates pressureGradient{
    byLongitude * jacobian(0, 0) + byLatitude * jacobian(1, 0),
    byLongitude * jacobian(0, 1) + byLatitude * jacobian(1, 1)
  };
  const double waterDensity = parameters.waterDensity;

  S.hu(0) = coriolis * Q.hu(1) + friction * Q.hu(0) - Q.h * pressureGradient(0) / waterDensity;
  S.hu(1) = -coriolis * Q.hu(0) + friction * Q.hu(1) - Q.h * pressureGradient(1) / waterDensity;
}

INLINE_METHOD GPU_CALLABLE_METHOD double
applications::exahype2::exaskred::ADERDGSolver::solveSubcellRiemannProblem(
  const State&                QL,
  const State&                QR,
  const Coordinates&          x,
  const Coordinates&          h,
  const double                t,
  const double                dt,
  const int                   normal,
  [[maybe_unused]] const bool isBoundaryFace,
  [[maybe_unused]] const int  faceIndex,
  Flux&                       FL,
  Flux&                       FR,
  const RuntimeParameters&    parameters
) {
  return applications::exahype2::exaskred::riemann::augmentedState<&State::b>(
    QL,
    QR,
    x,
    h,
    t,
    dt,
    normal,
    g,
    parameters.minimumWaterHeight,
    FL,
    FR
  );
}

/**
 * Returns false at the boundaries and over the shelf and the coast. A cell there switches to the
 * subcell scheme before its water column thins. The augmented Riemann solver of that scheme
 * supports wetting and drying.
 */
INLINE_METHOD GPU_CALLABLE_METHOD bool
applications::exahype2::exaskred::ADERDGSolver::isPhysicallyAdmissible(
  const States             Q,
  const Coordinates&       x,
  const Coordinates&       h,
  const RuntimeParameters& parameters
) {
  const double minimumWaterHeight = parameters.minimumWaterHeight;
  if (Q.size() == 1) {
    return applications::exahype2::exaskred::limiting::isAdmissibleState(Q[0], minimumWaterHeight);
  }

  // A boundary condition is not a solution of the equations. Beyond the survey, the bed continues
  // its rim at a constant depth.
  const auto& rasterOffset = parameters.bathymetryOffset;
  const auto& rasterSize   = parameters.bathymetrySize;
  for (int dimension = 0; dimension < DIMENSIONS; dimension++) {
    if (
      x(dimension) - 0.5 * h(dimension) <= DomainOffset[dimension]
      or x(dimension) + 0.5 * h(dimension) >= DomainOffset[dimension] + DomainSize[dimension]
      or x(dimension) - 0.5 * h(dimension) <= rasterOffset(dimension)
      or x(dimension) + 0.5 * h(dimension) >= rasterOffset(dimension) + rasterSize(dimension)
    ) {
      return false;
    }
  }

  const auto statistics = applications::exahype2::exaskred::limiting::collectCellStatistics(Q);
  return statistics.finite and statistics.minHeight > minimumWaterHeight
    and statistics.maxBathymetry <= -parameters.coastalDepth;
}

INLINE_METHOD GPU_CALLABLE_METHOD void
applications::exahype2::exaskred::ADERDGSolver::mapDmpObservables(
  Observables&                              observables,
  const State&                              Q,
  [[maybe_unused]] const RuntimeParameters& parameters
) {
  static_assert(NumberOfObservables == 4, "The Gulf of Mexico scenario expects number_of_dmp_observables = 4.");
  observables(0) = Q.h;
  observables(1) = Q.hu(0);
  observables(2) = Q.hu(1);
  observables(3) = Q.b;
}

INLINE_METHOD GPU_CALLABLE_METHOD double
applications::exahype2::exaskred::ADERDGSolver::solveRiemannProblem(
  const FaceStates&           QL,
  const FaceStates&           QR,
  const Coordinates&          x,
  const Coordinates&          h,
  const double                t,
  const double                dt,
  const int                   normal,
  [[maybe_unused]] const bool isBoundaryFace,
  [[maybe_unused]] const int  faceIndex,
  FaceFluxes&                 FL,
  FaceFluxes&                 FR,
  const RuntimeParameters&    parameters
) {
  const double minimumWaterHeight = parameters.minimumWaterHeight;
  const auto   waterEigenvalue    = [minimumWaterHeight](
                                      const State&       Q,
                                      const Coordinates& facePosition,
                                      const Coordinates& faceSize,
                                      const double       time,
                                      const double       timeStepSize,
                                      const int          direction
                                    ) {
    return applications::exahype2::exaskred::shallowwater::maxEigenvalue(
      Q,
      facePosition,
      faceSize,
      time,
      timeStepSize,
      direction,
      g,
      minimumWaterHeight
    );
  };
  const auto interfaceGravity = []([[maybe_unused]] const State& QLeft, [[maybe_unused]] const State& QRight) {
    return g;
  };

  return applications::exahype2::exaskred::riemann::wellBalancedRusanov<&State::b>(
    QL,
    QR,
    x,
    h,
    t,
    dt,
    normal,
    waterEigenvalue,
    interfaceGravity,
    FL,
    FR
  );
}
TARGET_DECLARE_END
