#include "applications/exaskred/AugmentedState.h"
#include "applications/exaskred/Forcing.h"
#include "applications/exaskred/Limiting.h"
#include "applications/exaskred/ShallowWater.h"
#include "applications/exaskred/WellBalancedRusanov.h"
#include "tarch/reader/NetCDFFieldSampler.h"

TARGET_DECLARE
INLINE_METHOD void
applications::exahype2::exaskred::ADERDGSolver::initialCondition(
  State&                              Q,
  const Coordinates&                  x,
  [[maybe_unused]] const Coordinates& h,
  const RuntimeParameters&            parameters
) {
  static const tarch::reader::NetCDFFieldSampler<2> bathymetrySampler(
    {{"bathymetry", std::string(parameters.bathymetryFile)}}
  );

  // The raster covers the channel only. The mesh covers the enclosing square. The clamped position
  // continues the depth up to the mesh boundary.
  const auto& offset = parameters.bathymetryOffset;
  const auto& size   = parameters.bathymetrySize;
  Coordinates rasterPosition;
  for (int dimension = 0; dimension < DIMENSIONS; dimension++) {
    rasterPosition(dimension) = std::clamp(x(dimension), offset(dimension), offset(dimension) + size(dimension));
  }
  const double bathymetry = bathymetrySampler.sampleBilinear("bathymetry", rasterPosition);

  Q.h  = -std::min(bathymetry, 0.0);
  Q.hu = 0.0;
  Q.b  = bathymetry;
}

INLINE_METHOD GPU_CALLABLE_METHOD void
applications::exahype2::exaskred::ADERDGSolver::boundaryConditions(
  const State&                              Qinside,
  State&                                    Qoutside,
  [[maybe_unused]] const Coordinates&       x,
  [[maybe_unused]] const Coordinates&       h,
  [[maybe_unused]] const double             t,
  const int                                 normal,
  [[maybe_unused]] const RuntimeParameters& parameters
) {
  Qoutside = Qinside;
  // The channel walls close the domain across its width. The domain stays open along the direction
  // the disturbance travels. Only the transverse momentum reflects.
  if (normal != 0) {
    Qoutside.hu(1) = -Qinside.hu(1);
  }
}

INLINE_METHOD GPU_CALLABLE_METHOD ::exahype2::RefinementCommand
applications::exahype2::exaskred::ADERDGSolver::refinementCriterion(
  [[maybe_unused]] const CellStates*        Q,
  [[maybe_unused]] const Coordinates&       x,
  [[maybe_unused]] const Coordinates&       h,
  [[maybe_unused]] const double             t,
  [[maybe_unused]] const RuntimeParameters& parameters
) {
  return ::exahype2::RefinementCommand::Keep;
}

INLINE_METHOD GPU_CALLABLE_METHOD void
applications::exahype2::exaskred::ADERDGSolver::flux(
  const State&             Q,
  const Coordinates&       x,
  const Coordinates&       h,
  const double             t,
  const double             dt,
  const int                normal,
  Flux&                    F,
  const RuntimeParameters& parameters
) {
  applications::exahype2::exaskred::shallowwater::flux(Q, x, h, t, dt, normal, parameters.minimumWaterHeight, F);
}

INLINE_METHOD GPU_CALLABLE_METHOD double
applications::exahype2::exaskred::ADERDGSolver::maxEigenvalue(
  const State&             Q,
  const Coordinates&       x,
  const Coordinates&       h,
  const double             t,
  const double             dt,
  const int                normal,
  const RuntimeParameters& parameters
) {
  return applications::exahype2::exaskred::shallowwater::maxEigenvalue(
    Q,
    x,
    h,
    t,
    dt,
    normal,
    g,
    parameters.minimumWaterHeight
  );
}

INLINE_METHOD GPU_CALLABLE_METHOD void
applications::exahype2::exaskred::ADERDGSolver::nonconservativeProduct(
  const State&             Q,
  const Difference&        deltaQ,
  const Coordinates&       x,
  const Coordinates&       h,
  const double             t,
  const double             dt,
  const int                normal,
  NonconservativeProduct&  BTimesDeltaQ,
  const RuntimeParameters& parameters
) {
  applications::exahype2::exaskred::shallowwater::nonconservativeProduct(
    Q,
    deltaQ,
    x,
    h,
    t,
    dt,
    normal,
    g,
    parameters.minimumWaterHeight,
    BTimesDeltaQ
  );
}

/**
 * Writes the rotation, the bed drag and the atmospheric pressure gradient into S.
 */
INLINE_METHOD GPU_CALLABLE_METHOD void
applications::exahype2::exaskred::ADERDGSolver::sourceTerm(
  const State&                        Q,
  const Coordinates&                  x,
  [[maybe_unused]] const Coordinates& h,
  const double                        t,
  [[maybe_unused]] const double       dt,
  Source&                             S,
  const RuntimeParameters&            parameters
) {
  S                               = {};
  const double minimumWaterHeight = parameters.minimumWaterHeight;
  if (not std::isfinite(Q.h) or Q.h <= minimumWaterHeight) {
    return;
  }

  const double coriolis = parameters.coriolisParameter;
  const double friction = applications::exahype2::exaskred::forcing::getManningFriction(
    Q.h,
    Q.hu(0),
    Q.hu(1),
    g,
    parameters.manningCoefficient,
    minimumWaterHeight
  );

  // The pressure disturbance is a sine of one period with a two-step damping. It moves along the
  // first axis at a fixed speed. The step envelope is constant between its two levels. It adds
  // nothing to the gradient away from the point where it jumps.
  const double amplitude = parameters.pressureAmplitude;
  const double speed     = parameters.pressureSpeed;
  const double period    = parameters.pressurePeriod;
  const double phase     = (x(0) - 0.75 * speed * period) / speed - t;
  const double envelope  = std::round(2.0 * phase / period);
  Coordinates  pressureGradient(0.0);
  if (envelope >= 0.0 and envelope <= 1.0) {
    const double angularFrequency = 2.0 * std::numbers::pi_v<double> / period;
    pressureGradient(0) =
      -amplitude * std::exp(-5.0 * envelope) * std::cos(angularFrequency * phase) * angularFrequency / speed;
  }
  const double waterDensity = parameters.waterDensity;

  S.hu(0) = coriolis * Q.hu(1) + friction * Q.hu(0) - Q.h * pressureGradient(0) / waterDensity;
  S.hu(1) = -coriolis * Q.hu(0) + friction * Q.hu(1) - Q.h * pressureGradient(1) / waterDensity;
}

INLINE_METHOD GPU_CALLABLE_METHOD double
applications::exahype2::exaskred::ADERDGSolver::solveSubcellRiemannProblem(
  const State&                QL,
  const State&                QR,
  const Coordinates&          x,
  const Coordinates&          h,
  const double                t,
  const double                dt,
  const int                   normal,
  [[maybe_unused]] const bool isBoundaryFace,
  [[maybe_unused]] const int  faceIndex,
  Flux&                       FL,
  Flux&                       FR,
  const RuntimeParameters&    parameters
) {
  return applications::exahype2::exaskred::riemann::augmentedState<&State::b>(
    QL,
    QR,
    x,
    h,
    t,
    dt,
    normal,
    g,
    parameters.minimumWaterHeight,
    FL,
    FR
  );
}

/**
 * Returns false where the water is too shallow for the polynomial. A film below the dry threshold
 * keeps a finite momentum whose velocity grows until the admissible time step underflows. A cell
 * over ground shallower than the coastal depth switches to the subcell scheme before it dries.
 */
INLINE_METHOD GPU_CALLABLE_METHOD bool
applications::exahype2::exaskred::ADERDGSolver::isPhysicallyAdmissible(
  const States                        Q,
  [[maybe_unused]] const Coordinates& x,
  [[maybe_unused]] const Coordinates& h,
  const RuntimeParameters&            parameters
) {
  const double minimumWaterHeight = parameters.minimumWaterHeight;
  if (Q.size() == 1) {
    return applications::exahype2::exaskred::limiting::isAdmissibleState(Q[0], minimumWaterHeight);
  }

  const auto statistics = applications::exahype2::exaskred::limiting::collectCellStatistics(Q);
  return statistics.finite and statistics.minHeight > minimumWaterHeight
    and statistics.maxBathymetry <= -parameters.coastalDepth;
}

INLINE_METHOD GPU_CALLABLE_METHOD void
applications::exahype2::exaskred::ADERDGSolver::mapDmpObservables(
  Observables&                              observables,
  const State&                              Q,
  [[maybe_unused]] const RuntimeParameters& parameters
) {
  static_assert(NumberOfObservables == 4, "The R1 scenario expects number_of_dmp_observables = 4.");
  observables(0) = Q.h;
  observables(1) = Q.hu(0);
  observables(2) = Q.hu(1);
  observables(3) = Q.b;
}

INLINE_METHOD GPU_CALLABLE_METHOD double
applications::exahype2::exaskred::ADERDGSolver::solveRiemannProblem(
  const FaceStates&           QL,
  const FaceStates&           QR,
  const Coordinates&          x,
  const Coordinates&          h,
  const double                t,
  const double                dt,
  const int                   normal,
  [[maybe_unused]] const bool isBoundaryFace,
  [[maybe_unused]] const int  faceIndex,
  FaceFluxes&                 FL,
  FaceFluxes&                 FR,
  const RuntimeParameters&    parameters
) {
  const double minimumWaterHeight = parameters.minimumWaterHeight;
  const auto   waterEigenvalue    = [minimumWaterHeight](
                                      const State&       Q,
                                      const Coordinates& facePosition,
                                      const Coordinates& faceSize,
                                      const double       time,
                                      const double       timeStepSize,
                                      const int          direction
                                    ) {
    return applications::exahype2::exaskred::shallowwater::maxEigenvalue(
      Q,
      facePosition,
      faceSize,
      time,
      timeStepSize,
      direction,
      g,
      minimumWaterHeight
    );
  };
  const auto interfaceGravity = []([[maybe_unused]] const State& QLeft, [[maybe_unused]] const State& QRight) {
    return g;
  };

  return applications::exahype2::exaskred::riemann::wellBalancedRusanov<&State::b>(
    QL,
    QR,
    x,
    h,
    t,
    dt,
    normal,
    waterEigenvalue,
    interfaceGravity,
    FL,
    FR
  );
}
TARGET_DECLARE_END
