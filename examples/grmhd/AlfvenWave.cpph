#include "examples/grmhd/GRMHD.h"

namespace examples::grmhd {
  template <class Shortcuts, typename Precision>
  INLINE_METHOD GPU_CALLABLE_METHOD void writeAlfvenWave(
    const tarch::la::Vector<DIMENSIONS, double>& x,
    double                                       t,
    Precision* NOALIAS                           Q
  );
} // namespace examples::grmhd

/**
 * Writes the state of the circularly polarised Alfven wave at the time t into Q.
 */
template <class Shortcuts, typename Precision>
INLINE_METHOD GPU_CALLABLE_METHOD void
examples::grmhd::writeAlfvenWave(
  const tarch::la::Vector<DIMENSIONS, double>& x,
  const double                                 t,
  Precision* const NOALIAS                     Q
) {
  constexpr double AdiabaticIndex     = 4.0 / 3.0;
  constexpr int    NumberOfValues     = Shortcuts::gij + 6;
  constexpr double Density            = 1.;
  constexpr double Pressure           = 1.;
  constexpr double WaveAmplitude      = 1.;
  constexpr double B0                 = 1.;
  constexpr double SpecificEnthalpy   = 1.0 + AdiabaticIndex / (AdiabaticIndex - 1.) * Pressure / Density;
  constexpr double Denominator        = Density * SpecificEnthalpy + B0 * B0 * (1.0 + WaveAmplitude * WaveAmplitude);
  constexpr double AmplitudeRatio     = 2.0 * WaveAmplitude * B0 * B0 / Denominator;
  const double     speedFactor        = 0.5 * (1.0 + std::sqrt(1.0 - AmplitudeRatio * AmplitudeRatio));
  const double     alfvenSpeedSquared = B0 * B0 / (Denominator * speedFactor);
  const double     alfvenSpeed        = std::sqrt(alfvenSpeedSquared);

  double V[NumberOfValues];

  V[Shortcuts::rho] = Density;

  V[Shortcuts::B + 0] = B0;
  V[Shortcuts::B + 1] = WaveAmplitude * B0 * std::cos(x[0] - alfvenSpeed * t);
  V[Shortcuts::B + 2] = WaveAmplitude * B0 * std::sin(x[0] - alfvenSpeed * t);

  V[Shortcuts::vel + 0] = 0.0;
  V[Shortcuts::vel + 1] = -alfvenSpeed * V[Shortcuts::B + 1] / B0;
  V[Shortcuts::vel + 2] = -alfvenSpeed * V[Shortcuts::B + 2] / B0;
  V[Shortcuts::E]       = Pressure;

  V[Shortcuts::psi]       = 0.;
  V[Shortcuts::lapse]     = 1.0;
  V[Shortcuts::shift + 0] = 0.;
  V[Shortcuts::shift + 1] = 0.;
  V[Shortcuts::shift + 2] = 0.;

  V[Shortcuts::gij + 0] = 1.;
  V[Shortcuts::gij + 1] = 0.;
  V[Shortcuts::gij + 2] = 0.;
  V[Shortcuts::gij + 3] = 1.;
  V[Shortcuts::gij + 4] = 0.;
  V[Shortcuts::gij + 5] = 1.;

  examples::grmhd::convertPrimitiveToConserved<Shortcuts>(Q, V);
}

INLINE_METHOD GPU_CALLABLE_METHOD double
examples::grmhd::AlfvenWave::maxEigenvalue(
  const ComputePrecision* const NOALIAS                         Q,
  [[maybe_unused]] const tarch::la::Vector<DIMENSIONS, double>& x,
  [[maybe_unused]] const tarch::la::Vector<DIMENSIONS, double>& h,
  [[maybe_unused]] const double                                 t,
  [[maybe_unused]] const double                                 dt,
  const int                                                     normal,
  [[maybe_unused]] const RuntimeParameters&                     parameters
) {
  return examples::grmhd::getMaxEigenvalue<Shortcuts>(Q, normal);
}

INLINE_METHOD GPU_CALLABLE_METHOD void
examples::grmhd::AlfvenWave::flux(
  const ComputePrecision* const NOALIAS                         Q,
  [[maybe_unused]] const tarch::la::Vector<DIMENSIONS, double>& x,
  [[maybe_unused]] const tarch::la::Vector<DIMENSIONS, double>& h,
  [[maybe_unused]] const double                                 t,
  [[maybe_unused]] const double                                 dt,
  const int                                                     normal,
  ComputePrecision* const NOALIAS                               F,
  [[maybe_unused]] const RuntimeParameters&                     parameters
) {
  examples::grmhd::computeFlux<Shortcuts>(Q, normal, F);
}

INLINE_METHOD GPU_CALLABLE_METHOD void
examples::grmhd::AlfvenWave::nonconservativeProduct(
  const ComputePrecision* const NOALIAS                         Q,
  const ComputePrecision* const NOALIAS                         deltaQ,
  [[maybe_unused]] const tarch::la::Vector<DIMENSIONS, double>& x,
  [[maybe_unused]] const tarch::la::Vector<DIMENSIONS, double>& h,
  [[maybe_unused]] const double                                 t,
  [[maybe_unused]] const double                                 dt,
  const int                                                     normal,
  ComputePrecision* const NOALIAS                               BTimesDeltaQ,
  [[maybe_unused]] const RuntimeParameters&                     parameters
) {
  examples::grmhd::computeNonconservativeProduct<Shortcuts>(Q, deltaQ, normal, BTimesDeltaQ);
}

INLINE_METHOD GPU_CALLABLE_METHOD ::exahype2::RefinementCommand
examples::grmhd::AlfvenWave::refinementCriterion(
  const StoragePrecision* const NOALIAS                         Q,
  [[maybe_unused]] const tarch::la::Vector<DIMENSIONS, double>& x,
  [[maybe_unused]] const tarch::la::Vector<DIMENSIONS, double>& h,
  [[maybe_unused]] const double                                 t,
  const RuntimeParameters&                                      parameters
) {
  return examples::grmhd::getRefinementCommand<Shortcuts>(
    Q,
    getNodesInUnitInterval(),
    NumberOfUnknowns + NumberOfAuxiliaryVariables,
    parameters.detailTolerance
  );
}

INLINE_METHOD void
examples::grmhd::AlfvenWave::initialCondition(
  StoragePrecision* const NOALIAS                               Q,
  const tarch::la::Vector<DIMENSIONS, double>&                  x,
  [[maybe_unused]] const tarch::la::Vector<DIMENSIONS, double>& h,
  [[maybe_unused]] const RuntimeParameters&                     parameters
) {
  examples::grmhd::writeAlfvenWave<Shortcuts>(x, 0.0, Q);
}

INLINE_METHOD GPU_CALLABLE_METHOD void
examples::grmhd::AlfvenWave::analyticalSolution(
  const tarch::la::Vector<DIMENSIONS, double>& x,
  const double                                 t,
  [[maybe_unused]] const double                dt,
  [[maybe_unused]] const double* const         Q,
  double* const                                solution,
  [[maybe_unused]] const RuntimeParameters&    parameters
) {
  examples::grmhd::writeAlfvenWave<Shortcuts>(x, t, solution);
}
