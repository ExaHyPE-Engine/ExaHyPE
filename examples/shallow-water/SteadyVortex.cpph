#include "examples/shallow-water/ShallowWater.h"

namespace examples::shallowwater {
  template <class Shortcuts, typename Precision>
  INLINE_METHOD GPU_CALLABLE_METHOD void writeSteadyVortex(
    const tarch::la::Vector<DIMENSIONS, double>& x,
    double                                       gravity,
    Precision* NOALIAS                           Q
  );
} // namespace examples::shallowwater

/**
 * Writes a steady vortex over a varying bathymetry into Q (Clain and Figueiredo,
 * https://doi.org/10.1016/j.compfluid.2016.11.013, section 4.4). The height reads the stored
 * bathymetry. The momentum reads the stored height.
 */
template <class Shortcuts, typename Precision>
INLINE_METHOD GPU_CALLABLE_METHOD void
examples::shallowwater::writeSteadyVortex(
  const tarch::la::Vector<DIMENSIONS, double>& x,
  const double                                 gravity,
  Precision* const NOALIAS                     Q
) {
  const double inverseOfFourGravities = 1 / (4 * gravity);
  const double radiusTerm             = (1 - x[0] * x[0] - x[1] * x[1]);
  Q[Shortcuts::b]                     = std::exp(radiusTerm / 2) / 5;
  Q[Shortcuts::h]                     = 1 - inverseOfFourGravities * std::exp(2 * radiusTerm) - Q[Shortcuts::b];
  Q[Shortcuts::hv + 0]                = x[1] * std::exp(radiusTerm) * Q[Shortcuts::h];
  Q[Shortcuts::hv + 1]                = -x[0] * std::exp(radiusTerm) * Q[Shortcuts::h];
}

INLINE_METHOD GPU_CALLABLE_METHOD double
examples::shallowwater::SteadyVortex::maxEigenvalue(
  const ComputePrecision* const NOALIAS                         Q,
  [[maybe_unused]] const tarch::la::Vector<DIMENSIONS, double>& x,
  [[maybe_unused]] const tarch::la::Vector<DIMENSIONS, double>& h,
  [[maybe_unused]] const double                                 t,
  [[maybe_unused]] const double                                 dt,
  const int                                                     normal,
  const RuntimeParameters&                                      parameters
) {
  return examples::shallowwater::getMaxEigenvalue<Shortcuts>(Q, normal, parameters.gravity, parameters.dryTolerance);
}

INLINE_METHOD GPU_CALLABLE_METHOD void
examples::shallowwater::SteadyVortex::flux(
  const ComputePrecision* const NOALIAS                         Q,
  [[maybe_unused]] const tarch::la::Vector<DIMENSIONS, double>& x,
  [[maybe_unused]] const tarch::la::Vector<DIMENSIONS, double>& h,
  [[maybe_unused]] const double                                 t,
  [[maybe_unused]] const double                                 dt,
  const int                                                     normal,
  ComputePrecision* const NOALIAS                               F,
  const RuntimeParameters&                                      parameters
) {
  examples::shallowwater::computeFlux<Shortcuts>(Q, normal, parameters.dryTolerance, F);
}

INLINE_METHOD GPU_CALLABLE_METHOD void
examples::shallowwater::SteadyVortex::nonconservativeProduct(
  const ComputePrecision* const NOALIAS                         Q,
  const ComputePrecision* const NOALIAS                         deltaQ,
  [[maybe_unused]] const tarch::la::Vector<DIMENSIONS, double>& x,
  [[maybe_unused]] const tarch::la::Vector<DIMENSIONS, double>& h,
  [[maybe_unused]] const double                                 t,
  [[maybe_unused]] const double                                 dt,
  const int                                                     normal,
  ComputePrecision* const NOALIAS                               BTimesDeltaQ,
  const RuntimeParameters&                                      parameters
) {
  examples::shallowwater::computeNonconservativeProduct<Shortcuts>(Q, deltaQ, normal, parameters.gravity, BTimesDeltaQ);
}

INLINE_METHOD GPU_CALLABLE_METHOD double
examples::shallowwater::SteadyVortex::solveRiemannProblem(
  const ComputePrecision* const NOALIAS                         QL,
  const ComputePrecision* const NOALIAS                         QR,
  [[maybe_unused]] const tarch::la::Vector<DIMENSIONS, double>& x,
  [[maybe_unused]] const tarch::la::Vector<DIMENSIONS, double>& h,
  [[maybe_unused]] const double                                 t,
  [[maybe_unused]] const double                                 dt,
  const int                                                     normal,
  [[maybe_unused]] const bool                                   isBoundaryFace,
  [[maybe_unused]] const int                                    faceIndex,
  ComputePrecision* const NOALIAS                               FL,
  ComputePrecision* const NOALIAS                               FR,
  const RuntimeParameters&                                      parameters
) {
  return examples::shallowwater::computeWellBalancedFlux<examples::shallowwater::SteadyVortex>(
    QL,
    QR,
    normal,
    parameters.gravity,
    parameters.dryTolerance,
    FL,
    FR
  );
}

INLINE_METHOD GPU_CALLABLE_METHOD ::exahype2::RefinementCommand
examples::shallowwater::SteadyVortex::refinementCriterion(
  const StoragePrecision* const NOALIAS                         Q,
  [[maybe_unused]] const tarch::la::Vector<DIMENSIONS, double>& x,
  [[maybe_unused]] const tarch::la::Vector<DIMENSIONS, double>& h,
  [[maybe_unused]] const double                                 t,
  const RuntimeParameters&                                      parameters
) {
  return examples::shallowwater::getRefinementCommand<Shortcuts>(
    Q,
    getNodesInUnitInterval(),
    NumberOfUnknowns + NumberOfAuxiliaryVariables,
    parameters.detailTolerance
  );
}

INLINE_METHOD void
examples::shallowwater::SteadyVortex::initialCondition(
  StoragePrecision* const NOALIAS                               Q,
  const tarch::la::Vector<DIMENSIONS, double>&                  x,
  [[maybe_unused]] const tarch::la::Vector<DIMENSIONS, double>& h,
  const RuntimeParameters&                                      parameters
) {
  examples::shallowwater::writeSteadyVortex<Shortcuts>(x, parameters.gravity, Q);
}

INLINE_METHOD GPU_CALLABLE_METHOD void
examples::shallowwater::SteadyVortex::boundaryConditions(
  [[maybe_unused]] const ComputePrecision* const NOALIAS        Qinside,
  ComputePrecision* const NOALIAS                               Qoutside,
  const tarch::la::Vector<DIMENSIONS, double>&                  x,
  [[maybe_unused]] const tarch::la::Vector<DIMENSIONS, double>& h,
  [[maybe_unused]] const double                                 t,
  [[maybe_unused]] const int                                    normal,
  const RuntimeParameters&                                      parameters
) {
  examples::shallowwater::writeSteadyVortex<Shortcuts>(x, parameters.gravity, Qoutside);
}

INLINE_METHOD GPU_CALLABLE_METHOD void
examples::shallowwater::SteadyVortex::analyticalSolution(
  const tarch::la::Vector<DIMENSIONS, double>& x,
  [[maybe_unused]] const double                t,
  [[maybe_unused]] const double                dt,
  [[maybe_unused]] const double* const         Q,
  double* const                                solution,
  const RuntimeParameters&                     parameters
) {
  examples::shallowwater::writeSteadyVortex<Shortcuts>(x, parameters.gravity, solution);
}
