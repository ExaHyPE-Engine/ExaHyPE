#include "exahype2/particles/Forces.h"
#include "tarch/Assertions.h"

INLINE_METHOD GPU_CALLABLE_METHOD double
examples::tracers::UniformFlow::maxEigenvalue(
  [[maybe_unused]] const ComputePrecision* const NOALIAS        Q,
  [[maybe_unused]] const tarch::la::Vector<DIMENSIONS, double>& x,
  [[maybe_unused]] const tarch::la::Vector<DIMENSIONS, double>& h,
  [[maybe_unused]] const double                                 t,
  [[maybe_unused]] const double                                 dt,
  const int                                                     normal,
  [[maybe_unused]] const RuntimeParameters&                     parameters
) {
  return FlowVelocity(normal);
}

INLINE_METHOD GPU_CALLABLE_METHOD void
examples::tracers::UniformFlow::flux(
  [[maybe_unused]] const ComputePrecision* const NOALIAS        Q,
  [[maybe_unused]] const tarch::la::Vector<DIMENSIONS, double>& x,
  [[maybe_unused]] const tarch::la::Vector<DIMENSIONS, double>& h,
  [[maybe_unused]] const double                                 t,
  [[maybe_unused]] const double                                 dt,
  [[maybe_unused]] const int                                    normal,
  ComputePrecision* const NOALIAS                               F,
  [[maybe_unused]] const RuntimeParameters&                     parameters
) {
  for (int unknown = 0; unknown < NumberOfUnknowns; unknown++) {
    F[unknown] = 0.0;
  }
}

INLINE_METHOD GPU_CALLABLE_METHOD ::exahype2::RefinementCommand
examples::tracers::UniformFlow::refinementCriterion(
  [[maybe_unused]] const StoragePrecision* const NOALIAS        Q,
  [[maybe_unused]] const tarch::la::Vector<DIMENSIONS, double>& x,
  [[maybe_unused]] const tarch::la::Vector<DIMENSIONS, double>& h,
  [[maybe_unused]] const double                                 t,
  [[maybe_unused]] const RuntimeParameters&                     parameters
) {
  return ::exahype2::RefinementCommand::Keep;
}

INLINE_METHOD void
examples::tracers::UniformFlow::initialCondition(
  StoragePrecision* const NOALIAS                               Q,
  [[maybe_unused]] const tarch::la::Vector<DIMENSIONS, double>& x,
  [[maybe_unused]] const tarch::la::Vector<DIMENSIONS, double>& h,
  [[maybe_unused]] const RuntimeParameters&                     parameters
) {
  Q[Shortcuts::rho] = 1.0;
  for (int d = 0; d < DIMENSIONS; d++) {
    Q[Shortcuts::v + d] = FlowVelocity(d);
  }
}

INLINE_METHOD void
examples::tracers::UniformFlow::analyticalSolution(
  const ::exahype2::particles::Particle* const particle,
  const double                                 t,
  [[maybe_unused]] const double                dt,
  double* const                                solution,
  [[maybe_unused]] const RuntimeParameters&    parameters
) {
  constexpr int StartPositionAttribute = ::exahype2::particles::ParticleRadiusAttribute + 1;
  constexpr int NumberOfData           = StartPositionAttribute + DIMENSIONS;
  ASSERTION(particle != nullptr);
  ASSERTION(t >= 0.0, t);
  for (int d = 0; d < DIMENSIONS; d++) {
    solution[d] = std::fmod(particle->getData(StartPositionAttribute + d) + FlowVelocity(d) * t, 1.0);
  }
  for (int entry = 0; entry < NumberOfData; entry++) {
    solution[DIMENSIONS + entry] = particle->getData(entry);
  }
  solution[DIMENSIONS + ::exahype2::particles::FluidDensityAttribute] = 1.0;
  for (int d = 0; d < DIMENSIONS; d++) {
    solution[DIMENSIONS + ::exahype2::particles::FluidVelocityAttribute + d]        = FlowVelocity(d);
    solution[DIMENSIONS + ::exahype2::particles::ParticleVelocityAttribute + d]     = FlowVelocity(d);
    solution[DIMENSIONS + ::exahype2::particles::ParticleAccelerationAttribute + d] = 0.0;
  }
}
