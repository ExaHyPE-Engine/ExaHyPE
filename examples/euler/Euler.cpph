#include "exahype2/MultiresolutionDetail.h"
#include "tarch/Assertions.h"
#include "tarch/la/ScalarOperations.h"
#include "tarch/la/Vector.h"

template <class Shortcuts, typename Precision>
INLINE_METHOD GPU_CALLABLE_METHOD double
examples::euler::getMomentumSquared(const Precision* const NOALIAS Q) {
  tarch::la::Vector<DIMENSIONS, double> momentum;
  for (int d = 0; d < DIMENSIONS; d++) {
    momentum(d) = Q[Shortcuts::rhoU + d];
  }
  return tarch::la::norm2Squared(momentum);
}

template <class Shortcuts, typename Precision>
INLINE_METHOD GPU_CALLABLE_METHOD double
examples::euler::getPressure(const Precision* const NOALIAS Q, const double gamma) {
  const double inverseDensity  = 1 / std::max<double>(Q[Shortcuts::rho], 1.0e-12);
  const double momentumSquared = examples::euler::getMomentumSquared<Shortcuts>(Q);
  const double internalEnergy =
    std::fma(-0.5 * inverseDensity, momentumSquared, static_cast<double>(Q[Shortcuts::rhoE]));
  return (gamma - 1) * internalEnergy;
}

template <class Shortcuts, typename Precision>
INLINE_METHOD GPU_CALLABLE_METHOD double
examples::euler::getMaxEigenvalue(const Precision* const NOALIAS Q, const int normal, const double gamma) {
  ASSERTION(normal >= 0 and normal < DIMENSIONS, normal);
  const double inverseDensity = 1 / std::max<double>(Q[Shortcuts::rho], 1.0e-12);
  const double pressure       = examples::euler::getPressure<Shortcuts>(Q, gamma);
  const double speedOfSound   = std::sqrt(std::abs(gamma * pressure * inverseDensity));
  const double normalVelocity = Q[Shortcuts::rhoU + normal] * inverseDensity;
  return std::fmax(std::abs(normalVelocity - speedOfSound), std::abs(normalVelocity + speedOfSound));
}

template <class Shortcuts, typename Precision>
INLINE_METHOD GPU_CALLABLE_METHOD void
examples::euler::computeFlux(
  const Precision* const NOALIAS Q,
  const int                      normal,
  const double                   gamma,
  Precision* const NOALIAS       F
) {
  ASSERTION(normal >= 0 and normal < DIMENSIONS, normal);
  const double inverseDensity = 1 / std::max<double>(Q[Shortcuts::rho], 1.0e-12);
  const double pressure       = examples::euler::getPressure<Shortcuts>(Q, gamma);
  const double normalMomentum = Q[Shortcuts::rhoU + normal];
  F[Shortcuts::rho]           = normalMomentum;
  for (int d = 0; d < DIMENSIONS; d++) {
    F[Shortcuts::rhoU + d] = tarch::la::productRoundedOnce(normalMomentum * Q[Shortcuts::rhoU + d], inverseDensity);
  }
  F[Shortcuts::rhoE] = tarch::la::productRoundedOnce(normalMomentum * (Q[Shortcuts::rhoE] + pressure), inverseDensity);
  F[Shortcuts::rhoU + normal] += pressure;
}

template <class Shortcuts, typename Precision, typename Nodes>
INLINE_METHOD GPU_CALLABLE_METHOD ::exahype2::RefinementCommand
examples::euler::getRefinementCommand(
  const Precision* const NOALIAS Q,
  const Nodes&                   nodes,
  const int                      numberOfValues,
  const double                   gamma,
  const double                   detailTolerance
) {
  ASSERTION(detailTolerance > 0.0, detailTolerance);
  return ::exahype2::refineOnDetail(
    Q,
    nodes,
    numberOfValues,
    detailTolerance,
    ::exahype2::DefaultCoarsenSafetyFactor,
    [](const Precision* const values) { return values[Shortcuts::rho]; },
    [gamma](const Precision* const values) {
      const double momentumSquared = examples::euler::getMomentumSquared<Shortcuts>(values);
      const double density         = std::max<double>(values[Shortcuts::rho], 1.0e-12);
      return std::max((gamma - 1.0) * (values[Shortcuts::rhoE] - 0.5 * momentumSquared / density), 1.0e-12);
    }
  );
}

template <typename Precision, typename Deviation>
INLINE_METHOD GPU_CALLABLE_METHOD ::exahype2::RefinementCommand
examples::euler::getRefinementCommandOfDeviation(
  const Precision* const NOALIAS Q,
  const int                      numberOfStates,
  const int                      numberOfValues,
  const double                   refineTolerance,
  const double                   eraseTolerance,
  const Deviation&               deviationOfState
) {
  ASSERTION(numberOfStates > 0, numberOfStates);
  ASSERTION(numberOfValues > 0, numberOfValues);
  ASSERTION(eraseTolerance >= 0.0 and eraseTolerance < refineTolerance, eraseTolerance, refineTolerance);
  if (Q == nullptr) {
    return ::exahype2::RefinementCommand::Keep;
  }
  double largestDeviation = 0.0;
  for (int state = 0; state < numberOfStates; state++) {
    largestDeviation = std::max(largestDeviation, deviationOfState(Q + state * numberOfValues));
  }
  if (largestDeviation > refineTolerance) {
    return ::exahype2::RefinementCommand::Refine;
  }
  if (largestDeviation < eraseTolerance) {
    return ::exahype2::RefinementCommand::Erase;
  }
  return ::exahype2::RefinementCommand::Keep;
}

template <class Shortcuts, typename Precision>
INLINE_METHOD GPU_CALLABLE_METHOD bool
examples::euler::isPhysicallyAdmissible(
  const Precision* const NOALIAS Q,
  const int                      numberOfStates,
  const int                      numberOfValues,
  const double                   gamma
) {
  ASSERTION(numberOfStates > 0, numberOfStates);
  const Precision* values = Q;
  for (int state = 0; state < numberOfStates; ++state, values += numberOfValues) {
    for (int value = 0; value < numberOfValues; ++value) {
      if (not std::isfinite(values[value])) {
        return false;
      }
    }
    const double density = values[Shortcuts::rho];
    const double energy  = values[Shortcuts::rhoE];
    // Densities near the vacuum threshold can cross it through last-bit
    // differences. Keeping them on the finite-volume scheme prevents a
    // one-sided status change from seeding asymmetry.
    if (density <= 1.0e-12 or energy <= 1.0e-12) {
      return false;
    }
    const double momentumSquared = examples::euler::getMomentumSquared<Shortcuts>(values);
    const double pressure        = (gamma - 1.0) * (energy - 0.5 * momentumSquared / density);
    if (not std::isfinite(pressure) or pressure <= 1.0e-12) {
      return false;
    }
  }
  return true;
}

template <class Shortcuts, typename Precision>
INLINE_METHOD GPU_CALLABLE_METHOD void
examples::euler::mapDmpObservables(
  Precision* const NOALIAS       observables,
  const Precision* const NOALIAS Q,
  const double                   gamma
) {
  constexpr double DensityFloor    = 1.0e-12;
  const double     density         = Q[Shortcuts::rho];
  const double     inverseDensity  = 1.0 / std::max(density, DensityFloor);
  const double     momentumSquared = examples::euler::getMomentumSquared<Shortcuts>(Q);
  observables[0]                   = density;
  for (int d = 0; d < DIMENSIONS; ++d) {
    observables[1 + d] = Q[Shortcuts::rhoU + d] * inverseDensity;
  }
  observables[1 + DIMENSIONS] = (gamma - 1.0) * (Q[Shortcuts::rhoE] - 0.5 * inverseDensity * momentumSquared);
}

template <class Shortcuts, typename Precision>
INLINE_METHOD GPU_CALLABLE_METHOD void
examples::euler::reflectAtWall(
  const Precision* const NOALIAS Qinside,
  Precision* const NOALIAS       Qoutside,
  const int                      normal
) {
  ASSERTION(normal >= 0 and normal < DIMENSIONS, normal);
  Qoutside[Shortcuts::rho] = Qinside[Shortcuts::rho];
  for (int d = 0; d < DIMENSIONS; d++) {
    Qoutside[Shortcuts::rhoU + d] = Qinside[Shortcuts::rhoU + d];
  }
  Qoutside[Shortcuts::rhoU + normal] = -Qinside[Shortcuts::rhoU + normal];
  Qoutside[Shortcuts::rhoE]          = Qinside[Shortcuts::rhoE];
}
