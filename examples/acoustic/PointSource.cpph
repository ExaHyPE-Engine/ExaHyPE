#include "examples/acoustic/Acoustic.h"

namespace examples::acoustic {
  template <class Shortcuts, typename Precision>
  INLINE_METHOD void writeRest(Precision* NOALIAS Q);

  template <class Shortcuts, typename Precision>
  INLINE_METHOD GPU_CALLABLE_METHOD void writeSourceForce(double t, Precision* NOALIAS forceVector);
} // namespace examples::acoustic

template <class Shortcuts, typename Precision>
INLINE_METHOD void
examples::acoustic::writeRest(Precision* const NOALIAS Q) {
  Q[Shortcuts::p] = 0.0;
  for (int d = 0; d < DIMENSIONS; d++) {
    Q[Shortcuts::u + d] = 0.0;
  }
}

template <class Shortcuts, typename Precision>
INLINE_METHOD GPU_CALLABLE_METHOD void
examples::acoustic::writeSourceForce(const double t, Precision* const NOALIAS forceVector) {
  constexpr double SourcePeakTime   = 0.1;
  constexpr double SourcePulseWidth = 0.03;
  for (int d = 0; d < DIMENSIONS; d++) {
    forceVector[Shortcuts::u + d] = 0.0;
  }
  forceVector[Shortcuts::p] =
    std::exp(-(t - SourcePeakTime) * (t - SourcePeakTime) / (2.0 * SourcePulseWidth * SourcePulseWidth));
}

INLINE_METHOD GPU_CALLABLE_METHOD double
examples::acoustic::PointSource::maxEigenvalue(
  [[maybe_unused]] const ComputePrecision* const NOALIAS        Q,
  [[maybe_unused]] const tarch::la::Vector<DIMENSIONS, double>& x,
  [[maybe_unused]] const tarch::la::Vector<DIMENSIONS, double>& h,
  [[maybe_unused]] const double                                 t,
  [[maybe_unused]] const double                                 dt,
  [[maybe_unused]] const int                                    normal,
  const RuntimeParameters&                                      parameters
) {
  return parameters.waveSpeed;
}

INLINE_METHOD GPU_CALLABLE_METHOD void
examples::acoustic::PointSource::flux(
  const ComputePrecision* const NOALIAS                         Q,
  [[maybe_unused]] const tarch::la::Vector<DIMENSIONS, double>& x,
  [[maybe_unused]] const tarch::la::Vector<DIMENSIONS, double>& h,
  [[maybe_unused]] const double                                 t,
  [[maybe_unused]] const double                                 dt,
  const int                                                     normal,
  ComputePrecision* const NOALIAS                               F,
  const RuntimeParameters&                                      parameters
) {
  examples::acoustic::computeFlux<Shortcuts>(Q, normal, parameters.density, parameters.waveSpeed, F);
}

INLINE_METHOD GPU_CALLABLE_METHOD ::exahype2::RefinementCommand
examples::acoustic::PointSource::refinementCriterion(
  const StoragePrecision* const NOALIAS        Q,
  const tarch::la::Vector<DIMENSIONS, double>& x,
  const tarch::la::Vector<DIMENSIONS, double>& h,
  const double                                 t,
  const RuntimeParameters&                     parameters
) {
  if (parameters.staticRefinement) {
    return examples::acoustic::getRefinementCommandOfDisc(x, h);
  }
  if (examples::acoustic::isNearFiringSource(x, h, t)) {
    return ::exahype2::RefinementCommand::Refine;
  }
  return examples::acoustic::getRefinementCommand<Shortcuts>(
    Q,
    getNodesInUnitInterval(),
    NumberOfUnknowns + NumberOfAuxiliaryVariables,
    parameters.density,
    parameters.waveSpeed,
    parameters.detailTolerance
  );
}

INLINE_METHOD void
examples::acoustic::PointSource::initialCondition(
  StoragePrecision* const NOALIAS                               Q,
  [[maybe_unused]] const tarch::la::Vector<DIMENSIONS, double>& x,
  [[maybe_unused]] const tarch::la::Vector<DIMENSIONS, double>& h,
  [[maybe_unused]] const RuntimeParameters&                     parameters
) {
  examples::acoustic::writeRest<Shortcuts>(Q);
}

INLINE_METHOD GPU_CALLABLE_METHOD void
examples::acoustic::PointSource::boundaryConditions(
  const ComputePrecision* const NOALIAS                         Qinside,
  ComputePrecision* const NOALIAS                               Qoutside,
  [[maybe_unused]] const tarch::la::Vector<DIMENSIONS, double>& x,
  [[maybe_unused]] const tarch::la::Vector<DIMENSIONS, double>& h,
  [[maybe_unused]] const double                                 t,
  const int                                                     normal,
  [[maybe_unused]] const RuntimeParameters&                     parameters
) {
  examples::acoustic::reflectAtWall<Shortcuts>(Qinside, Qoutside, normal);
}

INLINE_METHOD GPU_CALLABLE_METHOD void
examples::acoustic::PointSource::pointSource(
  [[maybe_unused]] const ComputePrecision* const NOALIAS Q,
  [[maybe_unused]] const double* const                   x,
  const double                                           t,
  [[maybe_unused]] const double                          dt,
  ComputePrecision* const NOALIAS                        forceVector,
  [[maybe_unused]] const int                             n,
  [[maybe_unused]] const RuntimeParameters&              parameters
) {
  examples::acoustic::writeSourceForce<Shortcuts>(t, forceVector);
}

INLINE_METHOD void
examples::acoustic::PointSource::initPointSourceLocations(
  double                                    location[NumberOfPointSources][DIMENSIONS],
  [[maybe_unused]] const RuntimeParameters& parameters
) {
  for (int d = 0; d < DIMENSIONS; d++) {
    location[0][d] = -0.7;
  }
}
