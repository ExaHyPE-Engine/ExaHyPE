#include "exahype2/MultiresolutionDetail.h"
#include "tarch/Assertions.h"

template <class Shortcuts, typename Precision>
INLINE_METHOD GPU_CALLABLE_METHOD void
examples::acoustic::computeFlux(
  const Precision* const NOALIAS Q,
  const int                      normal,
  const double                   density,
  const double                   waveSpeed,
  Precision* const NOALIAS       F
) {
  ASSERTION(normal >= 0 and normal < DIMENSIONS, normal);
  ASSERTION(density > 0.0, density);
  const double bulkModulus = density * waveSpeed * waveSpeed;
  F[Shortcuts::p]          = bulkModulus * Q[Shortcuts::u + normal];
  for (int d = 0; d < DIMENSIONS; d++) {
    F[Shortcuts::u + d] = 0.0;
  }
  F[Shortcuts::u + normal] = (1.0 / density) * Q[Shortcuts::p];
}

template <class Shortcuts, typename Precision, typename Nodes>
INLINE_METHOD GPU_CALLABLE_METHOD ::exahype2::RefinementCommand
examples::acoustic::getRefinementCommand(
  const Precision* const NOALIAS Q,
  const Nodes&                   nodes,
  const int                      numberOfValues,
  const double                   density,
  const double                   waveSpeed,
  const double                   detailTolerance
) {
  ASSERTION(detailTolerance > 0.0, detailTolerance);
  const double acousticImpedance = density * waveSpeed;
  return ::exahype2::refineOnDetail(
    Q,
    nodes,
    numberOfValues,
    detailTolerance,
    ::exahype2::DefaultCoarsenSafetyFactor,
    [](const Precision* const values) { return 1.0 + values[Shortcuts::p]; },
    [acousticImpedance](const Precision* const values) {
      tarch::la::Vector<DIMENSIONS, double> velocity;
      for (int d = 0; d < DIMENSIONS; d++) {
        velocity(d) = values[Shortcuts::u + d];
      }
      return 1.0 + acousticImpedance * tarch::la::norm2(velocity);
    }
  );
}

TARGET_DECLARE
INLINE_METHOD GPU_CALLABLE_METHOD ::exahype2::RefinementCommand
examples::acoustic::getRefinementCommandOfFront(
  const tarch::la::Vector<DIMENSIONS, double>& x,
  const tarch::la::Vector<DIMENSIONS, double>& h,
  const double                                 t,
  const double                                 startRadius,
  const bool                                   cellStoresData
) {
  constexpr double                            MaxRadius  = DIMENSIONS == 3 ? 7.5 : 5.0;
  constexpr double                            GrowthRate = 1.5;
  constexpr double                            BandWidth  = 0.05;
  const tarch::la::Vector<DIMENSIONS, double> centre(5.0);

  const double frontRadius = std::min(MaxRadius, startRadius + GrowthRate * t);
  const double innerRadius = std::max(0.0, frontRadius - BandWidth);
  const double radius      = tarch::la::norm2(x - centre);
  const double cellReach   = 0.5 * tarch::la::norm2(h);

  auto result = ::exahype2::RefinementCommand::Keep;
  if (radius - cellReach <= frontRadius and radius + cellReach >= innerRadius) {
    result = ::exahype2::RefinementCommand::Refine;
  } else if (cellStoresData and radius + cellReach < innerRadius) {
    result = ::exahype2::RefinementCommand::Erase;
  }
  return result;
}

INLINE_METHOD GPU_CALLABLE_METHOD ::exahype2::RefinementCommand
examples::acoustic::getRefinementCommandOfDisc(
  const tarch::la::Vector<DIMENSIONS, double>& x,
  const tarch::la::Vector<DIMENSIONS, double>& h
) {
  constexpr double                            RefinedRadius = 0.35;
  const tarch::la::Vector<DIMENSIONS, double> centre(-0.7);
  const double                                cellReach = 0.5 * tarch::la::norm2(h);

  auto result = ::exahype2::RefinementCommand::Keep;
  if (tarch::la::norm2(x - centre) - cellReach < RefinedRadius) {
    result = ::exahype2::RefinementCommand::Refine;
  }
  return result;
}

INLINE_METHOD GPU_CALLABLE_METHOD bool
examples::acoustic::isNearFiringSource(
  const tarch::la::Vector<DIMENSIONS, double>& x,
  const tarch::la::Vector<DIMENSIONS, double>& h,
  const double                                 t
) {
  constexpr double                            SourcePeakTime   = 0.1;
  constexpr double                            SourcePulseWidth = 0.03;
  const tarch::la::Vector<DIMENSIONS, double> sourceLocation(-0.7);
  return t < SourcePeakTime + 5.0 * SourcePulseWidth
    and tarch::la::norm2(x - sourceLocation) < 0.2 + tarch::la::norm2(h);
}
TARGET_DECLARE_END

template <class Shortcuts, typename Precision>
INLINE_METHOD GPU_CALLABLE_METHOD void
examples::acoustic::reflectAtWall(
  const Precision* const NOALIAS Qinside,
  Precision* const NOALIAS       Qoutside,
  const int                      normal
) {
  ASSERTION(normal >= 0 and normal < DIMENSIONS, normal);
  Qoutside[Shortcuts::p] = Qinside[Shortcuts::p];
  for (int d = 0; d < DIMENSIONS; d++) {
    Qoutside[Shortcuts::u + d] = Qinside[Shortcuts::u + d];
  }
  Qoutside[Shortcuts::u + normal] = -Qinside[Shortcuts::u + normal];
}
