#include "examples/navier-stokes/NavierStokes.h"

INLINE_METHOD GPU_CALLABLE_METHOD double
examples::navierstokes::TwoBubbles::maxEigenvalue(
  const ComputePrecision* const NOALIAS                         Q,
  [[maybe_unused]] const tarch::la::Vector<DIMENSIONS, double>& x,
  const tarch::la::Vector<DIMENSIONS, double>&                  h,
  [[maybe_unused]] const double                                 t,
  [[maybe_unused]] const double                                 dt,
  const int                                                     normal,
  const RuntimeParameters&                                      parameters
) {
  return examples::navierstokes::getMaxEigenvalue<examples::navierstokes::TwoBubbles>(Q, h, normal, parameters);
}

INLINE_METHOD GPU_CALLABLE_METHOD void
examples::navierstokes::TwoBubbles::flux(
  const ComputePrecision* const NOALIAS                         Q,
  const ComputePrecision* const NOALIAS                         deltaQ[DIMENSIONS],
  [[maybe_unused]] const tarch::la::Vector<DIMENSIONS, double>& x,
  [[maybe_unused]] const tarch::la::Vector<DIMENSIONS, double>& h,
  [[maybe_unused]] const double                                 t,
  [[maybe_unused]] const double                                 dt,
  const int                                                     normal,
  ComputePrecision* const NOALIAS                               F,
  const RuntimeParameters&                                      parameters
) {
  examples::navierstokes::computeFlux<examples::navierstokes::TwoBubbles>(Q, deltaQ, normal, parameters, F);
}

INLINE_METHOD GPU_CALLABLE_METHOD double
examples::navierstokes::TwoBubbles::solveRiemannProblem(
  const ComputePrecision* const NOALIAS                         QL,
  const ComputePrecision* const NOALIAS                         QR,
  [[maybe_unused]] const tarch::la::Vector<DIMENSIONS, double>& x,
  const tarch::la::Vector<DIMENSIONS, double>&                  h,
  [[maybe_unused]] const double                                 t,
  [[maybe_unused]] const double                                 dt,
  const int                                                     normal,
  [[maybe_unused]] const bool                                   isBoundaryFace,
  [[maybe_unused]] const int                                    faceIndex,
  ComputePrecision* const NOALIAS                               FL,
  ComputePrecision* const NOALIAS                               FR,
  const RuntimeParameters&                                      parameters
) {
  return examples::navierstokes::computeRusanovFlux<examples::navierstokes::TwoBubbles>(
    QL,
    QR,
    h,
    normal,
    parameters,
    FL,
    FR
  );
}

INLINE_METHOD GPU_CALLABLE_METHOD ::exahype2::RefinementCommand
examples::navierstokes::TwoBubbles::refinementCriterion(
  const StoragePrecision* const NOALIAS                         Q,
  [[maybe_unused]] const tarch::la::Vector<DIMENSIONS, double>& x,
  [[maybe_unused]] const tarch::la::Vector<DIMENSIONS, double>& h,
  [[maybe_unused]] const double                                 t,
  const RuntimeParameters&                                      parameters
) {
  return examples::navierstokes::getRefinementCommandOfBubbles<examples::navierstokes::TwoBubbles>(Q, parameters);
}

INLINE_METHOD void
examples::navierstokes::TwoBubbles::initialCondition(
  StoragePrecision* const NOALIAS                               Q,
  const tarch::la::Vector<DIMENSIONS, double>&                  x,
  [[maybe_unused]] const tarch::la::Vector<DIMENSIONS, double>& h,
  const RuntimeParameters&                                      parameters
) {
  examples::navierstokes::writeAtmosphere<examples::navierstokes::TwoBubbles>(
    x,
    examples::navierstokes::getTwoBubblesPerturbation(x),
    parameters,
    Q
  );
}

INLINE_METHOD GPU_CALLABLE_METHOD void
examples::navierstokes::TwoBubbles::boundaryConditions(
  const ComputePrecision* const NOALIAS                         Qinside,
  ComputePrecision* const NOALIAS                               Qoutside,
  const tarch::la::Vector<DIMENSIONS, double>&                  x,
  [[maybe_unused]] const tarch::la::Vector<DIMENSIONS, double>& h,
  [[maybe_unused]] const double                                 t,
  const int                                                     normal,
  const RuntimeParameters&                                      parameters
) {
  examples::navierstokes::writeWallState<examples::navierstokes::TwoBubbles>(Qinside, x, normal, parameters, Qoutside);
}

INLINE_METHOD GPU_CALLABLE_METHOD void
examples::navierstokes::TwoBubbles::sourceTerm(
  const ComputePrecision* const NOALIAS                         Q,
  [[maybe_unused]] const tarch::la::Vector<DIMENSIONS, double>& x,
  [[maybe_unused]] const tarch::la::Vector<DIMENSIONS, double>& h,
  [[maybe_unused]] const double                                 t,
  [[maybe_unused]] const double                                 dt,
  ComputePrecision* const NOALIAS                               S,
  const RuntimeParameters&                                      parameters
) {
  examples::navierstokes::computeGravitySource<examples::navierstokes::TwoBubbles>(Q, parameters, S);
}
