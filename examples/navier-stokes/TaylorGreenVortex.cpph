#include "examples/navier-stokes/NavierStokes.h"

namespace examples::navierstokes {
  template <class Solver, typename Precision>
  INLINE_METHOD GPU_CALLABLE_METHOD void writeTaylorGreenVortex(
    const tarch::la::Vector<DIMENSIONS, double>& x,
    double                                       t,
    const typename Solver::RuntimeParameters&    parameters,
    Precision* NOALIAS                           Q
  );
} // namespace examples::navierstokes

/**
 * Writes the Taylor-Green vortex at the time t into Q (Taylor and Green,
 * https://doi.org/10.1098/rspa.1937.0036). The viscosity damps the vortex.
 */
template <class Solver, typename Precision>
INLINE_METHOD GPU_CALLABLE_METHOD void
examples::navierstokes::writeTaylorGreenVortex(
  const tarch::la::Vector<DIMENSIONS, double>& x,
  const double                                 t,
  const typename Solver::RuntimeParameters&    parameters,
  Precision* const NOALIAS                     Q
) {
  using Shortcuts          = typename Solver::Shortcuts;
  const double decayFactor = std::exp(-2 * parameters.referenceViscosity * t);
  const double rho         = 1;
  Q[Shortcuts::rho]        = rho;
  Q[Shortcuts::j + 0]      = std::sin(x[0]) * std::cos(x[1]) * decayFactor;
  Q[Shortcuts::j + 1]      = -1 * std::cos(x[0]) * std::sin(x[1]) * decayFactor;
  for (int d = 2; d < DIMENSIONS; d++) {
    Q[Shortcuts::j + d] = 0.0;
  }
  const double meanPressure = 100. / parameters.gamma;
  const double pressure =
    meanPressure + ((rho * decayFactor * decayFactor) / 4) * (std::cos(2 * x[0]) + std::cos(2 * x[1]));
  Q[Shortcuts::E] = examples::navierstokes::getEnergy<Solver>(pressure, rho, &Q[Shortcuts::j], 0.0, parameters);
}

INLINE_METHOD GPU_CALLABLE_METHOD double
examples::navierstokes::TaylorGreenVortex::maxEigenvalue(
  const ComputePrecision* const NOALIAS                         Q,
  [[maybe_unused]] const tarch::la::Vector<DIMENSIONS, double>& x,
  const tarch::la::Vector<DIMENSIONS, double>&                  h,
  [[maybe_unused]] const double                                 t,
  [[maybe_unused]] const double                                 dt,
  const int                                                     normal,
  const RuntimeParameters&                                      parameters
) {
  return examples::navierstokes::getMaxEigenvalue<examples::navierstokes::TaylorGreenVortex>(Q, h, normal, parameters);
}

INLINE_METHOD GPU_CALLABLE_METHOD void
examples::navierstokes::TaylorGreenVortex::flux(
  const ComputePrecision* const NOALIAS                         Q,
  const ComputePrecision* const NOALIAS                         deltaQ[DIMENSIONS],
  [[maybe_unused]] const tarch::la::Vector<DIMENSIONS, double>& x,
  [[maybe_unused]] const tarch::la::Vector<DIMENSIONS, double>& h,
  [[maybe_unused]] const double                                 t,
  [[maybe_unused]] const double                                 dt,
  const int                                                     normal,
  ComputePrecision* const NOALIAS                               F,
  const RuntimeParameters&                                      parameters
) {
  examples::navierstokes::computeFlux<examples::navierstokes::TaylorGreenVortex>(Q, deltaQ, normal, parameters, F);
}

INLINE_METHOD GPU_CALLABLE_METHOD double
examples::navierstokes::TaylorGreenVortex::solveRiemannProblem(
  const ComputePrecision* const NOALIAS                         QL,
  const ComputePrecision* const NOALIAS                         QR,
  [[maybe_unused]] const tarch::la::Vector<DIMENSIONS, double>& x,
  const tarch::la::Vector<DIMENSIONS, double>&                  h,
  [[maybe_unused]] const double                                 t,
  [[maybe_unused]] const double                                 dt,
  const int                                                     normal,
  [[maybe_unused]] const bool                                   isBoundaryFace,
  [[maybe_unused]] const int                                    faceIndex,
  ComputePrecision* const NOALIAS                               FL,
  ComputePrecision* const NOALIAS                               FR,
  const RuntimeParameters&                                      parameters
) {
  return examples::navierstokes::computeRusanovFlux<examples::navierstokes::TaylorGreenVortex>(
    QL,
    QR,
    h,
    normal,
    parameters,
    FL,
    FR
  );
}

INLINE_METHOD GPU_CALLABLE_METHOD ::exahype2::RefinementCommand
examples::navierstokes::TaylorGreenVortex::refinementCriterion(
  const StoragePrecision* const NOALIAS                         Q,
  [[maybe_unused]] const tarch::la::Vector<DIMENSIONS, double>& x,
  [[maybe_unused]] const tarch::la::Vector<DIMENSIONS, double>& h,
  [[maybe_unused]] const double                                 t,
  const RuntimeParameters&                                      parameters
) {
  return examples::navierstokes::getRefinementCommand<examples::navierstokes::TaylorGreenVortex>(Q, parameters);
}

INLINE_METHOD void
examples::navierstokes::TaylorGreenVortex::initialCondition(
  StoragePrecision* const NOALIAS                               Q,
  const tarch::la::Vector<DIMENSIONS, double>&                  x,
  [[maybe_unused]] const tarch::la::Vector<DIMENSIONS, double>& h,
  const RuntimeParameters&                                      parameters
) {
  examples::navierstokes::writeTaylorGreenVortex<examples::navierstokes::TaylorGreenVortex>(x, 0.0, parameters, Q);
}

INLINE_METHOD GPU_CALLABLE_METHOD void
examples::navierstokes::TaylorGreenVortex::analyticalSolution(
  const tarch::la::Vector<DIMENSIONS, double>& x,
  const double                                 t,
  [[maybe_unused]] const double                dt,
  [[maybe_unused]] const double* const         Q,
  double* const                                solution,
  const RuntimeParameters&                     parameters
) {
  examples::navierstokes::writeTaylorGreenVortex<examples::navierstokes::TaylorGreenVortex>(x, t, parameters, solution);
}
