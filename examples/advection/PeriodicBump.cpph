#include "examples/advection/Advection.h"
#include "tarch/Assertions.h"

namespace examples::advection {
  template <class Shortcuts, typename Precision>
  INLINE_METHOD GPU_CALLABLE_METHOD void writePeriodicBump(
    const tarch::la::Vector<DIMENSIONS, double>& x,
    double                                       t,
    double                                       radius,
    bool                                         smooth,
    Precision* NOALIAS                           Q
  );
} // namespace examples::advection

template <class Shortcuts, typename Precision>
INLINE_METHOD GPU_CALLABLE_METHOD void
examples::advection::writePeriodicBump(
  const tarch::la::Vector<DIMENSIONS, double>& x,
  const double                                 t,
  const double                                 radius,
  const bool                                   smooth,
  Precision* const NOALIAS                     Q
) {
  ASSERTION(t >= 0.0, t);
  tarch::la::Vector<DIMENSIONS, double> offsetFromCentre;
  for (int d = 0; d < DIMENSIONS; d++) {
    const double travelled = x[d] - t;
    offsetFromCentre[d]    = travelled - std::floor(travelled) - 0.5;
  }
  Q[Shortcuts::q] = examples::advection::getBump(offsetFromCentre, radius, smooth);
}

INLINE_METHOD GPU_CALLABLE_METHOD double
examples::advection::PeriodicBump::maxEigenvalue(
  [[maybe_unused]] const ComputePrecision* const NOALIAS        Q,
  [[maybe_unused]] const tarch::la::Vector<DIMENSIONS, double>& x,
  [[maybe_unused]] const tarch::la::Vector<DIMENSIONS, double>& h,
  [[maybe_unused]] const double                                 t,
  [[maybe_unused]] const double                                 dt,
  [[maybe_unused]] const int                                    normal,
  [[maybe_unused]] const RuntimeParameters&                     parameters
) {
  return 1.0;
}

INLINE_METHOD GPU_CALLABLE_METHOD void
examples::advection::PeriodicBump::flux(
  const ComputePrecision* const NOALIAS                         Q,
  [[maybe_unused]] const tarch::la::Vector<DIMENSIONS, double>& x,
  [[maybe_unused]] const tarch::la::Vector<DIMENSIONS, double>& h,
  [[maybe_unused]] const double                                 t,
  [[maybe_unused]] const double                                 dt,
  [[maybe_unused]] const int                                    normal,
  ComputePrecision* const NOALIAS                               F,
  [[maybe_unused]] const RuntimeParameters&                     parameters
) {
  examples::advection::computeDiagonalFlux<Shortcuts>(Q, F);
}

INLINE_METHOD GPU_CALLABLE_METHOD ::exahype2::RefinementCommand
examples::advection::PeriodicBump::refinementCriterion(
  const StoragePrecision* const NOALIAS                         Q,
  [[maybe_unused]] const tarch::la::Vector<DIMENSIONS, double>& x,
  [[maybe_unused]] const tarch::la::Vector<DIMENSIONS, double>& h,
  [[maybe_unused]] const double                                 t,
  const RuntimeParameters&                                      parameters
) {
  return examples::advection::getRefinementCommand<Shortcuts>(
    Q,
    getNodesInUnitInterval(),
    NumberOfUnknowns + NumberOfAuxiliaryVariables,
    parameters.detailTolerance
  );
}

INLINE_METHOD void
examples::advection::PeriodicBump::initialCondition(
  StoragePrecision* const NOALIAS                               Q,
  const tarch::la::Vector<DIMENSIONS, double>&                  x,
  [[maybe_unused]] const tarch::la::Vector<DIMENSIONS, double>& h,
  const RuntimeParameters&                                      parameters
) {
  examples::advection::writePeriodicBump<Shortcuts>(x, 0.0, parameters.bumpRadius, parameters.smoothBump, Q);
}

INLINE_METHOD GPU_CALLABLE_METHOD void
examples::advection::PeriodicBump::analyticalSolution(
  const tarch::la::Vector<DIMENSIONS, double>& x,
  const double                                 t,
  [[maybe_unused]] const double                dt,
  [[maybe_unused]] const double* const         Q,
  double* const                                solution,
  const RuntimeParameters&                     parameters
) {
  examples::advection::writePeriodicBump<Shortcuts>(x, t, parameters.bumpRadius, parameters.smoothBump, solution);
}
