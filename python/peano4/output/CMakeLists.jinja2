cmake_minimum_required(VERSION 3.27)

{% if CXX is defined and CXX != "" -%}
set(CMAKE_CXX_COMPILER {{CXX}})
{% endif -%}

{% if FC is defined and FC != "" -%}
set(CMAKE_Fortran_COMPILER {{FC}})
{% endif -%}

project({{EXECUTABLENAME}}
  LANGUAGES
    C
    CXX
{% if FC is defined and FC != "" -%}
    Fortran
{% endif -%}
)

set(CMAKE_C_STANDARD 17 CACHE STRING "")
set(CMAKE_C_STANDARD_REQUIRED TRUE)
set(CMAKE_C_EXTENSIONS OFF)

set(CMAKE_CXX_STANDARD 20 CACHE STRING "")
set(CMAKE_CXX_STANDARD_REQUIRED TRUE)
set(CMAKE_CXX_EXTENSIONS OFF)
set(CMAKE_CXX_VISIBILITY_PRESET hidden)
set(CMAKE_CXX_VISIBILITY_INLINES_HIDDEN YES)

set(CMAKE_EXPORT_COMPILE_COMMANDS ON)
set(CMAKE_POSITION_INDEPENDENT_CODE ON CACHE INTERNAL "")

file(WRITE "${PROJECT_BINARY_DIR}/.gitignore" "*")

list(APPEND CMAKE_PREFIX_PATH {{CMAKE_BUILD_DIR}})
find_package(Peano CONFIG REQUIRED)

set(CMAKE_RUNTIME_OUTPUT_DIRECTORY ${CMAKE_CURRENT_SOURCE_DIR})
set(CMAKE_LIBRARY_OUTPUT_DIRECTORY ${CMAKE_CURRENT_SOURCE_DIR})
set(CMAKE_ARCHIVE_OUTPUT_DIRECTORY ${CMAKE_CURRENT_SOURCE_DIR})

list(APPEND H_HEADERS {% for item in H_HEADERS -%} {{item+" "}} {%- endfor %})
list(APPEND CXX_SOURCES {% for item in CXX_SOURCES -%} {{item+" "}} {%- endfor %})
list(APPEND FORTRAN_SOURCES {% for item in FORTRAN_SOURCES -%} {{item+" "}} {%- endfor %})

list(APPEND GENERATED_H_HEADERS {% for item in GENERATED_H_HEADERS -%} {{item+" "}} {%- endfor %})
list(APPEND GENERATED_CXX_SOURCES {% for item in GENERATED_CXX_SOURCES -%} {{item+" "}} {%- endfor %})
list(APPEND GENERATED_FORTRAN_SOURCES {% for item in GENERATED_FORTRAN_SOURCES -%} {{item+" "}} {%- endfor %})

list(APPEND GENERATED_LDFLAGS
{% for flag in LDFLAGS.split() if flag.startswith('-l') or flag.startswith('-L') %}
  {{ flag }}
{% endfor %}
)

list(APPEND GENERATED_CXXFLAGS
{% for flag in CXXFLAGS.split() if flag.startswith('-D') %}
  {{ flag }}
{% endfor %}
)

list(APPEND GENERATED_INCLUDE_DIRS
{% for flag in CXXFLAGS.split() if flag.startswith('-I') %}
  ${CMAKE_CURRENT_SOURCE_DIR}/{{ flag[2:] }}
{% endfor %}
)

list(APPEND SOURCES
  ${H_HEADERS}
  ${GENERATED_H_HEADERS}
  ${CXX_SOURCES}
  ${GENERATED_CXX_SOURCES}
  ${FORTRAN_SOURCES}
  ${GENERATED_FORTRAN_SOURCES}
)

string(TOLOWER "{{MODE}}" mode_lower)

{% if GPU == "cuda" %}
string(REGEX MATCH "[0-9]+$" CUDA_ARCH "{{GPU_ARCH}}")
message(STATUS "Using CUDA_ARCH=${CUDA_ARCH}")

set(CMAKE_CUDA_HOST_COMPILER "${CMAKE_CXX_COMPILER}")
enable_language(CUDA)

set(CMAKE_CUDA_ARCHITECTURES "${CUDA_ARCH}" CACHE STRING "" FORCE)

foreach(src IN LISTS GENERATED_CXX_SOURCES)
  if(${src} MATCHES "kernels/.*Fused\\.[^.]+$")
    message(STATUS "Setting CUDA language for file: ${src}")
    set_source_files_properties(${src} PROPERTIES LANGUAGE CUDA)
  endif()
endforeach()
{% endif %}

add_executable({{EXECUTABLENAME}})
target_sources({{EXECUTABLENAME}} PRIVATE ${SOURCES})
target_link_libraries({{EXECUTABLENAME}} PRIVATE Peano::PeanoOptions ${GENERATED_LDFLAGS})
target_include_directories({{EXECUTABLENAME}} PRIVATE ${CMAKE_SOURCE_DIR} ${GENERATED_INCLUDE_DIRS})
target_compile_definitions({{EXECUTABLENAME}} PRIVATE ${GENERATED_CXXFLAGS} TARGET_DEVICE={{TARGET_DEVICE}})

set(CMAKE_BUILD_TYPE "" CACHE INTERNAL "")

include(CheckIPOSupported)
check_ipo_supported(RESULT IPO_SUPPORTED OUTPUT IPO_ERROR)
if(IPO_SUPPORTED)
  message(STATUS "IPO/LTO enabled")
  set_target_properties({{EXECUTABLENAME}} PROPERTIES
    INTERPROCEDURAL_OPTIMIZATION TRUE
  )
endif()

{% if GPU == "cuda" %}
set_target_properties({{EXECUTABLENAME}} PROPERTIES
  POSITION_INDEPENDENT_CODE ON
  CUDA_SEPARABLE_COMPILATION OFF
  CUDA_RESOLVE_DEVICE_SYMBOLS OFF
  CUDA_ARCHITECTURES "${CUDA_ARCH}"
)
{% endif %}

{% if ACPP_TARGETS is defined and ACPP_TARGETS != "" %}
set(ACPP_TARGETS {{ACPP_TARGETS}} CACHE STRING "")
set(ACPP_DEBUG_LEVEL {{ACPP_DEBUG_LEVEL}} CACHE STRING "")
set(CMAKE_PREFIX_PATH {{ACPP_DIR}})
find_package(AdaptiveCpp CONFIG REQUIRED)
add_sycl_to_target(TARGET {{EXECUTABLENAME}} SOURCES ${SOURCES})
{% endif %}

{% for lib in LIBS.split() if lib.startswith('-L') %}
target_link_libraries({{EXECUTABLENAME}} PRIVATE {{ lib[2:] }})
{% endfor %}

target_link_libraries({{EXECUTABLENAME}} PRIVATE Peano::Peano4{{MODE}}{{DIMENSIONS}}d)

if(TARGET Peano::ToolboxLoadBalancing{{MODE}}{{DIMENSIONS}}d)
  target_link_libraries({{EXECUTABLENAME}} PRIVATE Peano::ToolboxLoadBalancing{{MODE}}{{DIMENSIONS}}d)
endif()

if(TARGET Peano::ToolboxBlockStructured{{MODE}}{{DIMENSIONS}}d)
  target_link_libraries({{EXECUTABLENAME}} PRIVATE Peano::ToolboxBlockStructured{{MODE}}{{DIMENSIONS}}d)
endif()

if(TARGET Peano::ToolboxParticles{{MODE}}{{DIMENSIONS}}d)
  target_link_libraries({{EXECUTABLENAME}} PRIVATE Peano::ToolboxParticles{{MODE}}{{DIMENSIONS}}d)
endif()

if(TARGET Peano::ToolboxCurvi{{MODE}})
  target_link_libraries({{EXECUTABLENAME}} PRIVATE Peano::ToolboxCurvi{{MODE}})
endif()

if(TARGET Peano::ExaHyPE2{{MODE}}{{DIMENSIONS}}d)
  target_link_libraries({{EXECUTABLENAME}} PRIVATE Peano::ExaHyPE2{{MODE}}{{DIMENSIONS}}d)
endif()
