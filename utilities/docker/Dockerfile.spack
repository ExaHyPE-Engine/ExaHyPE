ARG IMAGE_PREFIX=peanoframework
ARG IMAGE_TAG=latest

FROM ${IMAGE_PREFIX}/base:${IMAGE_TAG}

RUN wget https://github.com/spack/spack/releases/download/v1.2.2/spack-1.2.2.tar.gz -O /opt/spack.tar.gz && \
mkdir -p /opt/spack && \
tar -xzf /opt/spack.tar.gz -C /opt/spack --strip-components=1 && \
rm /opt/spack.tar.gz

RUN echo ". /opt/spack/share/spack/setup-env.sh" >> /etc/bash.bashrc

CMD ["/bin/bash"]
