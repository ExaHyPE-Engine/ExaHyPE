ARG IMAGE_PREFIX=ghcr.io/exahype-engine
ARG EXAHYPE_TAG=latest

FROM ${IMAGE_PREFIX}/exahype:${EXAHYPE_TAG}

COPY tutorials/ /exahype2/tutorials

WORKDIR /exahype2/tutorials

EXPOSE 8888

CMD ["bash", "-lc", ". /etc/profile.d/exahype2.sh && jupyter lab --ip=0.0.0.0 --port=8888 --no-browser --allow-root --ServerApp.root_dir=/exahype2/tutorials --ServerApp.token='' --ServerApp.password=''"]
