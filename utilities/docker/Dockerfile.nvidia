# syntax=docker/dockerfile:1
ARG IMAGE_PREFIX=ghcr.io/exahype-engine
ARG IMAGE_TAG=latest

FROM ${IMAGE_PREFIX}/spack:${IMAGE_TAG} AS builder

ARG SPACK_BUILDCACHE

WORKDIR /opt/spack-environment

COPY utilities/spack/compilers/nvidia/spack.yaml spack.yaml

RUN --mount=type=secret,id=spack_buildcache_user,env=SPACK_BUILDCACHE_USER \
    --mount=type=secret,id=spack_buildcache_token,env=SPACK_BUILDCACHE_TOKEN \
    . /opt/spack/share/spack/setup-env.sh && \
    if [ -n "${SPACK_BUILDCACHE}" ] && [ -n "${SPACK_BUILDCACHE_TOKEN}" ]; then \
      spack mirror add --scope site --unsigned --autopush --oci-username-variable SPACK_BUILDCACHE_USER \
        --oci-password-variable SPACK_BUILDCACHE_TOKEN buildcache "${SPACK_BUILDCACHE}"; \
    fi && \
    spack env activate . && \
    spack compiler find && \
    spack external find curl cmake ccache git ninja && \
    spack concretize && \
    spack install --fail-fast nvhpc && \
    spack install --fail-fast --concurrent-packages 1 && \
    spack gc -y && \
    spack clean -a

RUN . /opt/spack/share/spack/setup-env.sh && spack env activate --sh -d . > activate.sh

RUN { \
      echo '#!/bin/sh' \
      && echo '.' /opt/spack-environment/activate.sh \
      && echo 'exec "$@"'; \
    } > /entrypoint.sh \
&& chmod a+x /entrypoint.sh \
&& ln -s /opt/views/view /opt/view

FROM ${IMAGE_PREFIX}/base:${IMAGE_TAG}

COPY --from=builder /opt/spack-environment /opt/spack-environment
COPY --from=builder /opt/software /opt/software
COPY --from=builder /opt/views /opt/views
COPY --from=builder /entrypoint.sh /entrypoint.sh

# The MPI launcher prterun of the NVIDIA SDK links libnl-route-3.
RUN apt-get update && apt-get install -y --no-install-recommends libnl-route-3-200 && rm -rf /var/lib/apt/lists/*

COPY requirements.txt requirements.txt
RUN . /entrypoint.sh && pip install -r requirements.txt && rm requirements.txt

ENTRYPOINT ["/entrypoint.sh"]
CMD ["/bin/bash"]
